module

public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Basis
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.Weight.Basis
public import TauCeti.Algebra.Module.IntegralOrbit
import TauCeti.Algebra.Lie.Basis.Cartan
import TauCeti.LinearAlgebra.Eigenspace.Binomial

/-!
# The Kostant orbit of a weight vector

Let `b` be a `LieAlgebra.Basis` of a rational Lie algebra `L` and let `U_ℤ = b.kostantForm` be the
subring of `U(L)` generated by the divided powers `eᵢ⁽ⁿ⁾`, `fᵢ⁽ⁿ⁾` and the binomial coefficients
`(hᵢ choose n)`. Let `ρ` be a representation of `U(L)` on a rational vector space `V`, and let
`v ∈ V` be a weight vector of integral weight. No highest-weight condition is needed here: the
generators of the Kostant form preserve the span of the integral weight vectors, so the whole
orbit `U_ℤ · v` consists of sums of weight vectors of integral weight, and its weight sublattices
form an internal direct sum.

## Main results

* `LieAlgebra.Basis.orbitOfRep_kostantForm_le_iSup_jointWeightSpace`: the orbit lies in the span
  of the integral joint weight spaces.
* `LieAlgebra.Basis.isInternal_weightSublattice_orbitOfRep`: the weight sublattices of the orbit
  form an internal direct sum.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Chapter 2, Corollary 1 to Theorem 2.
-/

public section

namespace LieAlgebra.Basis

open Set TauCeti.UniversalEnvelopingAlgebra

variable {ι L : Type*} [Finite ι] [LieRing L] [LieAlgebra ℚ L]
  {H : _root_.LieSubalgebra ℚ L} (b : _root_.LieAlgebra.Basis ι H)
variable {V : Type*} [AddCommGroup V] [Module ℚ V]
  (ρ : _root_.UniversalEnvelopingAlgebra ℚ L →ₐ[ℚ] Module.End ℚ V)

attribute [local instance] TauCeti.moduleNNRat
attribute [local instance 100] LieRing.ofAssociativeRing

variable {b ρ}
variable {v : V} {wt : ι → ℤ}

variable (b) in
/-- **The Kostant orbit of a weight vector has integral weights.** Every element of the orbit is a
sum of weight vectors of integral weight; no highest-weight condition is needed, since the Kostant
form is generated by divided powers of root vectors and binomials in the Cartan vectors, which
preserve the span of the weight vectors. This is the weight hypothesis of
`TauCeti.UniversalEnvelopingAlgebra.kostantWeightBasis`. -/
theorem orbitOfRep_kostantForm_le_iSup_jointWeightSpace
    (hv : IsCartanWeightVector b.h ρ wt v) :
    Subring.orbitOfRep b.kostantForm ρ {v} ≤
      (⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ).restrictScalars ℤ := by
  have stable : ∀ T : Module.End ℚ V,
      (∀ μ, ∀ y ∈ jointWeightSpace b.h ρ μ, T y ∈ ⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ) →
      ∀ y ∈ (⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ), T y ∈ ⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ :=
    fun T hT y hy =>
      (iSup_le (fun μ => fun y hy => hT μ y hy) :
        (⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ) ≤
          (⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ).comap T) hy
  refine (Subring.orbitOfRep_le_iff _ _ _ _).2 fun u hu x hx => ?_
  rw [mem_singleton_iff.1 hx]
  rw [kostantForm_def] at hu
  refine kostantForm_apply_mem _ _ ρ
    ((⨆ μ : ι → ℤ, jointWeightSpace b.h ρ μ).restrictScalars ℤ) (fun i n y hy => ?_)
    (fun j n y hy => ?_) u hu
    (Submodule.mem_iSup_of_mem wt ((mem_jointWeightSpace_iff b.h ρ).2 hv))
  · refine stable _ (fun μ y hy => ?_) y hy
    have h := IsCartanWeightVector.integralDividedPower b.rootGenerator (b.lie_h_rootGenerator i)
      ((mem_jointWeightSpace_iff b.h ρ).1 hy) n
    rw [Module.End.smul_def, ← TauCeti.Associative.map_dividedPower] at h
    exact Submodule.mem_iSup_of_mem _ ((mem_jointWeightSpace_iff b.h ρ).2 h)
  · refine stable _ (fun μ y hy => ?_) y hy
    rw [Ring.map_choose, TauCeti.ringChoose_end_apply_of_apply_eq_smul
      ((isCartanWeightVector_iff b.h ρ).1 ((mem_jointWeightSpace_iff b.h ρ).1 hy) j) n]
    exact Submodule.mem_iSup_of_mem μ (Submodule.smul_mem _ _ hy)

variable (b) in
/-- The weight sublattices of the Kostant orbit of a weight vector form an internal direct
sum. -/
theorem isInternal_weightSublattice_orbitOfRep [DecidableEq (ι → ℤ)]
    (hv : IsCartanWeightVector b.h ρ wt v) :
    DirectSum.IsInternal
      (weightSublattice b.h ρ (Subring.orbitOfRep b.kostantForm ρ {v}).toAddSubgroup) := by
  apply isInternal_weightSublattice b.rootGenerator b.h ρ
  · intro u hu x hx
    rw [← b.kostantForm_def] at hu
    exact Subring.apply_mem_orbitOfRep_of_mem _ _ _ hu hx
  · intro x
    exact b.orbitOfRep_kostantForm_le_iSup_jointWeightSpace hv x.property

end LieAlgebra.Basis
