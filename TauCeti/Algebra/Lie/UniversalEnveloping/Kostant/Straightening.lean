module

public import TauCeti.Algebra.WordFiltration.Ordered
public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.MixedBasis

/-!
# Conditional integral straightening for mixed PBW monomials

For a rational Lie basis with designated Cartan coordinates, the single-coordinate
multiplication laws for divided powers and binomial coefficients have integral coefficients
and preserve total degree. Thus lower-degree exchange relations between distinct coordinates
suffice to identify the existing mixed PBW lattice with the Kostant form generated by those
coordinates. The exchange relations are explicit hypotheses; no Chevalley straightening
identity is assumed to follow from an arbitrary choice of Lie basis.

This applies the weighted word argument to `Module.Basis.pbwKostantBasis_apply` and uses
`TauCeti.Associative.mul_dividedPower` and `TauCeti.ringChoose_mul_ringChoose` for compression.

## References

* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.
-/

public section

namespace Module.Basis

open TauCeti TauCeti.Associative TauCeti.UniversalEnvelopingAlgebra

attribute [local instance] TauCeti.moduleNNRat

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {r : ℕ} (b : Basis (Fin r) ℚ L)

local notation "U" => _root_.UniversalEnvelopingAlgebra ℚ L

/-- A single factor in a mixed Kostant monomial: a binomial on a marked coordinate,
and a divided power on every other coordinate. -/
noncomputable def pbwKostantFactor (c : Finset (Fin r)) (i : Fin r) (n : ℕ) : U :=
  if i ∈ c then Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i)) n
  else dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i))

/-- Marked coordinates contribute binomial coefficients. -/
@[simp]
theorem pbwKostantFactor_of_mem (c : Finset (Fin r)) {i : Fin r} (hi : i ∈ c) (n : ℕ) :
    b.pbwKostantFactor c i n = Ring.choose (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i)) n := by
  simp only [pbwKostantFactor, hi, ↓reduceIte]

/-- Unmarked coordinates contribute divided powers. -/
@[simp]
theorem pbwKostantFactor_of_not_mem (c : Finset (Fin r)) {i : Fin r} (hi : i ∉ c) (n : ℕ) :
    b.pbwKostantFactor c i n = dividedPower n (_root_.UniversalEnvelopingAlgebra.ι ℚ (b i)) := by
  simp only [pbwKostantFactor, hi, ↓reduceIte]

/-- The zero-exponent factor is the identity at every coordinate. -/
@[simp]
theorem pbwKostantFactor_zero (c : Finset (Fin r)) (i : Fin r) :
    b.pbwKostantFactor c i 0 = 1 := by
  simp [pbwKostantFactor]

/-- Multiplication at one coordinate has integral coefficients and does not increase the
sum of the input exponents. -/
theorem mul_pbwKostantFactor_mem_span (c : Finset (Fin r)) (i : Fin r) (m n : ℕ) :
    b.pbwKostantFactor c i m * b.pbwKostantFactor c i n ∈
      Submodule.span ℤ {x | ∃ k ≤ m + n, b.pbwKostantFactor c i k = x} := by
  by_cases hi : i ∈ c
  · simp only [pbwKostantFactor_of_mem b c hi]
    rw [ringChoose_mul_ringChoose]
    apply Submodule.sum_mem
    intro p hp
    apply (Submodule.span ℤ _).nsmul_mem
    refine Submodule.subset_span ⟨m + p.1, ?_, rfl⟩
    have h := Finset.mem_antidiagonal.mp hp
    omega
  · simp only [pbwKostantFactor_of_not_mem b c hi]
    rw [mul_dividedPower]
    apply (Submodule.span ℤ _).nsmul_mem
    exact Submodule.subset_span ⟨m + n, le_rfl, rfl⟩

/-- The mixed factors are exactly the native root and Cartan generators. -/
theorem range_pbwKostantFactor (c : Finset (Fin r)) :
    (Set.range fun p : Fin r × ℕ => b.pbwKostantFactor c p.1 p.2) =
      kostantRootGenerators (fun i : {i // i ∉ c} => b i) ∪
        kostantCartanGenerators (fun i : {i // i ∈ c} => b i) := by
  ext x
  simp only [Set.mem_range, Prod.exists, Set.mem_union,
    mem_kostantRootGenerators_iff, mem_kostantCartanGenerators_iff]
  constructor
  · rintro ⟨i, n, rfl⟩
    by_cases hi : i ∈ c
    · exact Or.inr ⟨⟨i, hi⟩, n, (pbwKostantFactor_of_mem b c hi n).symm⟩
    · exact Or.inl ⟨⟨i, hi⟩, n, (pbwKostantFactor_of_not_mem b c hi n).symm⟩
  · rintro (⟨i, n, rfl⟩ | ⟨i, n, rfl⟩)
    · exact ⟨i, n, pbwKostantFactor_of_not_mem b c i.property n⟩
    · exact ⟨i, n, pbwKostantFactor_of_mem b c i.property n⟩

/-- Conditional bounded integral straightening for mixed PBW monomials. Only exchanges
between distinct coordinates remain hypotheses; the single-coordinate laws are proved. -/
theorem weightedWordSpan_pbwKostantFactor (c : Finset (Fin r))
    (hswap : ∀ i j, i < j → ∀ m n,
      b.pbwKostantFactor c j m * b.pbwKostantFactor c i n -
        b.pbwKostantFactor c i n * b.pbwKostantFactor c j m ∈
      weightedWordSpanLT (fun p : Fin r × ℕ => b.pbwKostantFactor c p.1 p.2)
        Prod.snd (m + n)) (d : ℕ) :
    weightedWordSpan (fun p : Fin r × ℕ => b.pbwKostantFactor c p.1 p.2) Prod.snd d =
      Submodule.span ℤ {x | ∃ a : Fin r → ℕ, ∑ i, a i ≤ d ∧ b.pbwKostantBasis c a = x} := by
  simpa only [orderedFactorSpan_def, pbwKostantFactor, pbwKostantBasis_apply] using
    weightedWordSpan_eq_orderedFactorSpan (b.pbwKostantFactor c)
      (pbwKostantFactor_zero b c) hswap (mul_pbwKostantFactor_mem_span b c) d

/-- Lower-degree exchanges identify the mixed PBW lattice with the integral module of the
native Kostant subring. Rational PBW independence already supplies its integral basis. -/
theorem pbwKostantLattice_eq_kostantForm (c : Finset (Fin r))
    (hswap : ∀ i j, i < j → ∀ m n,
      b.pbwKostantFactor c j m * b.pbwKostantFactor c i n -
        b.pbwKostantFactor c i n * b.pbwKostantFactor c j m ∈
      weightedWordSpanLT (fun p : Fin r × ℕ => b.pbwKostantFactor c p.1 p.2)
        Prod.snd (m + n)) :
    b.pbwKostantLattice c =
      (kostantForm (fun i : {i // i ∉ c} => b i)
        (fun i : {i // i ∈ c} => b i)).toAddSubgroup.toIntSubmodule := by
  have h := span_orderedFactor_eq_subringClosure (b.pbwKostantFactor c)
    (pbwKostantFactor_zero b c) hswap (mul_pbwKostantFactor_mem_span b c)
  rw [range_pbwKostantFactor] at h
  have hp : (fun a : Fin r → ℕ => (List.ofFn fun i => b.pbwKostantFactor c i (a i)).prod) =
      (b.pbwKostantBasis c : (Fin r → ℕ) → U) := by
    funext a
    simpa only [pbwKostantFactor] using (b.pbwKostantBasis_apply c a).symm
  rw [hp] at h
  simpa only [pbwKostantLattice_def, kostantForm_def] using h

end Module.Basis

namespace TauCeti.Associative

/-- A single divided-power coordinate satisfies the bounded straightening criterion. -/
example {B : Type*} [Ring B] [Algebra ℚ B] (x : B) (d : ℕ) :
    weightedWordSpan (fun p : Fin 1 × ℕ => dividedPower p.2 x) Prod.snd d =
      Submodule.span ℤ {y | ∃ k ≤ d, dividedPower k x = y} := by
  have hsame (_ : Fin 1) (m n : ℕ) : dividedPower m x * dividedPower n x ∈
      Submodule.span ℤ {y | ∃ k ≤ m + n, dividedPower k x = y} := by
    rw [mul_dividedPower]
    apply (Submodule.span ℤ _).nsmul_mem
    exact Submodule.subset_span ⟨m + n, le_rfl, rfl⟩
  have h := weightedWordSpan_eq_orderedFactorSpan (fun _ : Fin 1 => fun n => dividedPower n x)
    (by simp) (by intro i j hij; omega)
    hsame d
  rw [h, orderedFactorSpan_def]
  congr 1
  ext y
  simp only [Set.mem_ofPred_eq, Fin.sum_univ_one, List.ofFn_succ, List.ofFn_zero,
    List.prod_cons, List.prod_nil, mul_one]
  exact ⟨fun ⟨a, ha, he⟩ => ⟨a 0, ha, he⟩,
    fun ⟨k, hk, he⟩ => ⟨fun _ => k, hk, he⟩⟩

end TauCeti.Associative
