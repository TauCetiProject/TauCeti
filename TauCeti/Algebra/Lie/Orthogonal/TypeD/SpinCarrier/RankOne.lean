/-!
# Rank-one integration in the type-D spin carrier

The opposite numbered simple-root operators on the full spin lattice integrate to an explicit
map from `SL₂` into the invertible spin matrices over every commutative ring. The upper and lower
transvections recover the positive and negative root parameters. Over a field its image lies in
the spin carrier and is exactly the subgroup generated by those two root families.

This supplies rank-one root-group maps without dividing by two in the value ring. The identities
are established on the integral lattice before changing coefficients. No identification of the
spin carrier with an independently pinned simply connected group scheme is asserted.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.

The construction uses `TauCeti.Sl2.squareZeroSL2Hom`; the field-valued range argument follows
the transvection-induction argument in `TauCeti.Algebra.Lie.E7.Minuscule.RankOne.Basic`.
-/

public section

open scoped MatrixGroups
open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.TypeDSpinCarrier

noncomputable section

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance] HasUniqueDiv.of_module_rat

variable (n : ℕ) (hn : 4 ≤ n)

local notation "rootGen" => TauCeti.serreRootGenerator (CartanMatrix.D n)
local notation "cartan" => TauCeti.serreH ℚ (CartanMatrix.D n)
local notation "op" => kostantRootOperator rootGen cartan (rep n hn)
  (Submodule.toAddSubgroup (lattice n)) (rep_kostantForm_mem_lattice n hn)

private theorem integral_rankOne_relations (i : Fin n) :
    rootIntMatrix n hn (.inl i) * rootIntMatrix n hn (.inl i) = 0 ∧
    rootIntMatrix n hn (.inr i) * rootIntMatrix n hn (.inr i) = 0 ∧
    rootIntMatrix n hn (.inl i) * rootIntMatrix n hn (.inr i) *
        rootIntMatrix n hn (.inl i) = rootIntMatrix n hn (.inl i) ∧
    rootIntMatrix n hn (.inr i) * rootIntMatrix n hn (.inl i) *
        rootIntMatrix n hn (.inr i) = rootIntMatrix n hn (.inr i) := by
  let E := rep n hn (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inl i)))
  let F := rep n hn (_root_.UniversalEnvelopingAlgebra.ι ℚ (rootGen (.inr i)))
  have hEE : E * E = 0 := by
    rw [← sq]
    exact (polarization n).typeDSpinRep_rootGenerator_sq (polarizationBasis n) hn (.inl i)
  have hFF : F * F = 0 := by
    rw [← sq]
    exact (polarization n).typeDSpinRep_rootGenerator_sq (polarizationBasis n) hn (.inr i)
  have ht := isSl2Triple_rep_rootGenerator n hn i
  have hEF := Sl2.e_mul_f_mul_e_of_mul_self_eq_zero
    (IsSMulRegular.nat_of_hasUniqueDiv (by decide : (2 : ℕ) ≠ 0)) hEE
    ht.lie_e_f ht.lie_h_e_nsmul
  have hFE := Sl2.f_mul_e_mul_f_of_mul_self_eq_zero
    (IsSMulRegular.nat_of_hasUniqueDiv (by decide : (2 : ℕ) ≠ 0)) hFF
    ht.lie_e_f ht.lie_h_f_nsmul
  have hoperators : op (.inl i) * op (.inl i) = 0 ∧
      op (.inr i) * op (.inr i) = 0 ∧
      op (.inl i) * op (.inr i) * op (.inl i) = op (.inl i) ∧
      op (.inr i) * op (.inl i) * op (.inr i) = op (.inr i) := by
    refine ⟨?_, ?_, ?_, ?_⟩
    all_goals
      apply LinearMap.ext
      intro v
      apply Subtype.ext
      simp only [mul_apply_eq_comp, coe_kostantRootOperator_apply,
        LinearMap.zero_apply, ZeroMemClass.coe_zero]
    · exact congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W)) hEE
    · exact congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W)) hFF
    · exact congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W)) hEF
    · exact congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W)) hFE
  simpa only [rootIntMatrix_eq_toMatrix, ← LinearMap.toMatrix_mul,
    map_zero] using
    And.intro (congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n)) hoperators.1)
      (And.intro (congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n)) hoperators.2.1)
        (And.intro (congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n))
          hoperators.2.2.1)
          (congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n)) hoperators.2.2.2)))

private theorem rankOne_relations (i : Fin n) (R : Type*) [CommRing R] :
    let E := (rootIntMatrix n hn (.inl i)).map (Int.cast : ℤ → R)
    let F := (rootIntMatrix n hn (.inr i)).map (Int.cast : ℤ → R)
    E * E = 0 ∧ F * F = 0 ∧ E * F * E = E ∧ F * E * F = F := by
  obtain ⟨hEE, hFF, hEF, hFE⟩ := integral_rankOne_relations n hn i
  refine ⟨?_, ?_, ?_, ?_⟩
  all_goals
    simp only [← Matrix.map_mul_intCast]
  · rw [hEE, Matrix.map_zero _ (Int.cast_zero (R := R))]
  · rw [hFF, Matrix.map_zero _ (Int.cast_zero (R := R))]
  · rw [hEF]
  · rw [hFE]

private theorem integral_rankOne_projections (i : Fin n) :
    rootIntMatrix n hn (.inl i) * rootIntMatrix n hn (.inr i) =
        Matrix.diagonal (fun a ↦ if basisWeight n a i = 1 then 1 else 0) ∧
    rootIntMatrix n hn (.inr i) * rootIntMatrix n hn (.inl i) =
        Matrix.diagonal (fun a ↦ if basisWeight n a i = -1 then 1 else 0) := by
  let E := rootIntMatrix n hn (.inl i)
  let F := rootIntMatrix n hn (.inr i)
  let T : Matrix (Fin (dimension n)) (Fin (dimension n)) ℤ ≃ₐ[ℤ]
      Module.End ℤ (Fin (dimension n) → ℤ) := Matrix.toLinAlgEquiv'
  obtain ⟨hEE, hFF, hEF, hFE⟩ := integral_rankOne_relations n hn i
  have hH : T E * T F - T F * T E =
      T (Matrix.diagonal (fun a ↦ basisWeight n a i)) := by
    rw [← map_mul, ← map_mul, ← map_sub]
    exact congrArg T (lie_rootIntMatrix_inl_inr n hn i)
  have hcol (a : Fin (dimension n)) := Sl2.mul_apply_of_eq_zsmul
    (by simpa only [map_mul, map_zero] using congrArg T hEE)
    (by simpa only [map_mul, map_zero] using congrArg T hFF)
    (by simpa only [map_mul] using congrArg T hEF)
    (by simpa only [map_mul] using congrArg T hFE) hH
    (v := Pi.single a 1) (m := basisWeight n a i)
    (by
      ext b
      by_cases hab : b = a <;>
        simp [T, Matrix.toLinAlgEquiv'_apply, Matrix.mulVec_diagonal, hab])
    (by intro h; have := congrFun h a; simp at this)
  constructor <;> ext r a
  all_goals
    rcases hcol a with ⟨hw, hp, hq⟩ | ⟨hw, hp, hq⟩ | ⟨hw, hp, hq⟩
    all_goals
      have hp' := congrFun hp r
      have hq' := congrFun hq r
      simp only [← map_mul, T, Matrix.toLinAlgEquiv'_apply,
        Matrix.mulVec_single_one, Matrix.col_apply, Pi.single_apply, Pi.zero_apply] at hp' hq'
      simp only [Matrix.diagonal_apply]
      grind

/-- The numbered opposite-root pair integrated into invertible spin matrices. This formula
works over arbitrary commutative rings, with no assertion of carrier membership yet. -/
def rankOneMatrixHom (i : Fin n) (R : Type*) [CommRing R] :
    SL(2, R) →* GL (Fin (dimension n)) R :=
  Sl2.squareZeroSL2Hom
    ((rootIntMatrix n hn (.inl i)).map (Int.cast : ℤ → R))
    ((rootIntMatrix n hn (.inr i)).map (Int.cast : ℤ → R))
    (rankOne_relations n hn i R).1 (rankOne_relations n hn i R).2.1
    (rankOne_relations n hn i R).2.2.1 (rankOne_relations n hn i R).2.2.2

/-- The integrated spin matrix is given by the four entries of the `SL₂` element. -/
theorem coe_rankOneMatrixHom (i : Fin n) (R : Type*) [CommRing R] (g : SL(2, R)) :
    (rankOneMatrixHom n hn i R g : Matrix (Fin (dimension n)) (Fin (dimension n)) R) =
      let E := (rootIntMatrix n hn (.inl i)).map (Int.cast : ℤ → R)
      let F := (rootIntMatrix n hn (.inr i)).map (Int.cast : ℤ → R)
      1 + (g 0 0 - 1) • (E * F) + g 0 1 • E + g 1 0 • F + (g 1 1 - 1) • (F * E) := by
  exact Sl2.coe_squareZeroSL2Hom _ _ _ _ _ _ g

/-- The upper transvection recovers the numbered positive root subgroup, with unchanged
parameter, over every commutative ring. -/
@[simp]
theorem rankOneMatrixHom_upper_transvection (i : Fin n) (R : Type*) [CommRing R] (t : R) :
    rankOneMatrixHom n hn i R (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
      (rootSubgroupPoints n hn (.inl i) R (Multiplicative.ofAdd t) : GL (Fin (dimension n)) R) := by
  apply Units.ext
  rw [rankOneMatrixHom, Sl2.coe_squareZeroSL2Hom_upper,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd]

/-- The lower transvection recovers the numbered negative root subgroup, with unchanged
parameter, over every commutative ring. -/
@[simp]
theorem rankOneMatrixHom_lower_transvection (i : Fin n) (R : Type*) [CommRing R] (t : R) :
    rankOneMatrixHom n hn i R (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
      (rootSubgroupPoints n hn (.inr i) R (Multiplicative.ofAdd t) : GL (Fin (dimension n)) R) := by
  apply Units.ext
  rw [rankOneMatrixHom, Sl2.coe_squareZeroSL2Hom_lower,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd]

/-- The diagonal of the rank-one copy is the numbered simple coroot of the spin weight torus,
including over nonreduced rings and in characteristic two. -/
@[simp]
theorem rankOneMatrixHom_diag2nUnit (i : Fin n) (R : Type*) [CommRing R] (u : Rˣ) :
    rankOneMatrixHom n hn i R (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        (weightTorusPoints n hn R (Pi.mulSingle i u) : GL (Fin (dimension n)) R) := by
  apply Units.ext
  rw [rankOneMatrixHom, Sl2.coe_squareZeroSL2Hom_diagonal,
    ← Matrix.map_mul_intCast, ← Matrix.map_mul_intCast]
  obtain ⟨hp, hq⟩ := integral_rankOne_projections n hn i
  rw [hp, hq, coe_weightTorusPoints, kostantTorusMatrix_apply, diagGL_coe]
  ext a b
  rw [Matrix.diagonal_map (Int.cast_zero (R := R)),
    Matrix.diagonal_map (Int.cast_zero (R := R))]
  simp only [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, Matrix.one_apply,
    Matrix.diagonal_apply, torusCharacter_mulSingle]
  by_cases hab : a = b
  · subst b
    rcases DynkinType.typeDSpinWeight_apply_eq_neg_one_or_eq_zero_or_eq_one
      (signSet n a) i with hw | hw | hw
    all_goals
      -- The carrier weights are the spin weights of its enumerated sign sets.
      have hw' : basisWeight n a i = _ := hw
      simp only [hw', ite_true]
      norm_num
  · simp only [hab, ite_false, mul_zero, add_zero]

variable (K : Type*) [Field K] (i : Fin n)

private theorem rankOneMatrixHom_mem_of_root_mem {H : Subgroup (GL (Fin (dimension n)) K)}
    (hpos : ∀ t, (rootSubgroupPoints n hn (.inl i) K (Multiplicative.ofAdd t) :
      GL (Fin (dimension n)) K) ∈ H)
    (hneg : ∀ t, (rootSubgroupPoints n hn (.inr i) K (Multiplicative.ofAdd t) :
      GL (Fin (dimension n)) K) ∈ H) (g : SL(2, K)) :
    rankOneMatrixHom n hn i K g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [rankOneMatrixHom_upper_transvection]; exact hpos t
    · rw [rankOneMatrixHom_lower_transvection]; exact hneg t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- The integrated rank-one matrices lie in the full-weight spin carrier over a field. -/
theorem rankOneMatrixHom_mem_points (g : SL(2, K)) :
    rankOneMatrixHom n hn i K g ∈ points n hn K :=
  rankOneMatrixHom_mem_of_root_mem n hn K i
    (fun t ↦ (rootSubgroupPoints n hn (.inl i) K (Multiplicative.ofAdd t)).property)
    (fun t ↦ (rootSubgroupPoints n hn (.inr i) K (Multiplicative.ofAdd t)).property) g

/-- The numbered rank-one map into the full-weight type-D spin carrier over a field. -/
def rankOnePoints : SL(2, K) →* points n hn K :=
  (rankOneMatrixHom n hn i K).codRestrict _ (rankOneMatrixHom_mem_points n hn K i)

/-- Including the carrier-valued rank-one map into invertible matrices gives `rankOneMatrixHom`. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints n hn K i g : GL (Fin (dimension n)) K) = rankOneMatrixHom n hn i K g :=
  (rfl)

/-- The upper transvection maps to the positive simple-root point. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints n hn K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints n hn (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneMatrixHom_upper_transvection]

/-- The lower transvection maps to the negative simple-root point. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints n hn K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints n hn (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneMatrixHom_lower_transvection]

/-- The diagonal of the rank-one map is the numbered coroot in the carrier. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints n hn K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints n hn K (Pi.mulSingle i u) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneMatrixHom_diag2nUnit]

/-- The rank-one image is exactly the subgroup generated by the opposite root families. -/
theorem range_rankOnePoints :
    (rankOnePoints n hn K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints n hn (.inl i) K) ∪
        Set.range (rootSubgroupPoints n hn (.inr i) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points n hn K).subtype_injective,
      Subgroup.subtype_apply, coe_rankOnePoints]
    exact rankOneMatrixHom_mem_of_root_mem n hn K i
      (fun t ↦ Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_left _ (Set.mem_range_self _)), rfl⟩)
      (fun t ↦ Subgroup.mem_map.mpr ⟨_,
        Subgroup.subset_closure (Set.mem_union_right _ (Set.mem_range_self _)), rfl⟩) g
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), by rw [rankOnePoints_upper_transvection, ofAdd_toAdd]⟩
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), by rw [rankOnePoints_lower_transvection, ofAdd_toAdd]⟩

end

end TauCeti.TypeDSpinCarrier
