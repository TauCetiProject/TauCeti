module

public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Generated.Basic

/-!
# Arbitrary scalar extension of the generated type-D spin subgroup

The subgroup generated by the numbered root subgroups and the weight torus after scalar
extension is a closed subgroup of the scalar extension of the generated subgroup. On coordinate
algebras this gives a canonical surjection, characterized by its square with the ambient general
linear coordinate maps. The comparison preserves every generator and agrees with the existing
isomorphism for free extensions.

No flatness assumption is made, so the comparison includes reduction of the integral model modulo
a prime. It does not assert an isomorphism for arbitrary extensions, or identify the generated
subgroup with the specialized integral spin carrier or with a pinned simply connected group.

## Main declarations

* `TauCeti.TypeDSpinCarrier.map_baseChangeHopfIdeal_generatedDefiningIdeal_le`: containment of
  the transported defining ideals.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeMap`: the surjective
  coordinate comparison, with its ambient square, uniqueness and generator compatibility.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.

The generator compatibility argument follows the free-extension construction in
`TauCeti.Algebra.Lie.E7.Minuscule.Generated.RelativeBaseChange`.
-/

public section

namespace TauCeti.TypeDSpinCarrier

open CategoryTheory

universe v w

variable (n : ℕ) (hn : 4 ≤ n)
variable (k : Type v) (K : Type max v w) [CommRing k] [CommRing K] [Algebra k K]

/-- The group generated after scalar extension lies in the scalar extension of the generated
spin group. This inclusion of defining ideals requires no freeness or flatness. -/
theorem map_baseChangeHopfIdeal_generatedDefiningIdeal_le :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (generatedDefiningIdeal n hn k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom ≤
      generatedDefiningIdeal n hn K := by
  rw [generatedDefiningIdeal_def, generatedDefiningIdeal_def]
  have h := HopfIdeal.map_mono
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom
    (CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal_le
      (K := K) (generatorCoordinateMap n hn k))
  rw [CommHopfAlgCat.map_commonKernelHopfIdeal,
    ← CommHopfAlgCat.commonKernelHopfIdeal_comp_of_injective
      (fun j ↦ (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).inv ≫
        CommHopfAlgCat.baseChangeMap (generatorCoordinateMap n hn k j))
      (fun j ↦ (generatorCoordinateAlgebraBaseChangeIso n k K j).hom)
      (fun j ↦ (ConcreteCategory.bijective_of_isIso
        (generatorCoordinateAlgebraBaseChangeIso n k K j).hom).1),
    funext (generatorCoordinateMap_baseChange n hn k K)] at h
  exact h

private theorem baseChange_generatedDefiningIdeal_le_ker :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (generatedDefiningIdeal n hn k)).toIdeal ≤
      RingHom.ker ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        generatedCoordinateMap n hn K).hom.toAlgHom.toRingHom := by
  intro x hx
  have hmem := (map_baseChangeHopfIdeal_generatedDefiningIdeal_le n hn k K)
    (HopfIdeal.mem_map_of_mem
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom hx)
  have hker : (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom x ∈
      RingHom.ker (generatedCoordinateMap n hn K).hom := by
    rwa [generatedCoordinateMap_ker]
  rw [RingHom.mem_ker]
  simpa [_root_.CommHopfAlgCat.hom_comp] using RingHom.mem_ker.mp hker

/-- The canonical coordinate map from scalar extension of the generated spin group to the group
generated over the extension ring. Contravariantly, it is a closed subgroup inclusion. -/
noncomputable def generatedCoordinateHopfAlgebraBaseChangeMap :
    CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra n hn k) ⟶
      generatedCoordinateHopfAlgebra n hn K :=
  (eqToIso (congrArg (CommHopfAlgCat.baseChange (K := K))
    (generatedCoordinateHopfAlgebra_def n hn k))).hom ≫
  (CommHopfAlgCat.quotientBaseChangeIso (K := K) (generatedDefiningIdeal n hn k)).inv ≫
  CommHopfAlgCat.liftQuotient _
    ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
      generatedCoordinateMap n hn K) (baseChange_generatedDefiningIdeal_le_ker n hn k K)

/-- The coordinate comparison respects the ambient general-linear coordinate maps. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeMap :
    CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap n hn k) ≫
        generatedCoordinateHopfAlgebraBaseChangeMap n hn k K =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        generatedCoordinateMap n hn K := by
  have hbase :
      CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap n hn k) ≫
          (eqToIso (congrArg (CommHopfAlgCat.baseChange (K := K))
            (generatedCoordinateHopfAlgebra_def n hn k))).hom =
        CommHopfAlgCat.baseChangeMap (K := K)
          (CommHopfAlgCat.mkQuotient _ (generatedDefiningIdeal n hn k)) := by
    let F := CommHopfAlgCat.baseChangeFunctor (k := k) (K := K)
    calc
      _ = F.map (generatedCoordinateMap n hn k) ≫
          F.map (eqToIso (generatedCoordinateHopfAlgebra_def n hn k)).hom := by
        rw [CommHopfAlgCat.baseChangeFunctor_map]
        congr 1
        exact (eqToHom_map F (generatedCoordinateHopfAlgebra_def n hn k)).symm
      _ = F.map (generatedCoordinateMap n hn k ≫
          (eqToIso (generatedCoordinateHopfAlgebra_def n hn k)).hom) :=
        (F.map_comp _ _).symm
      _ = _ := by
        rw [eqToIso.hom, generatedCoordinateMap_comp_eqToHom,
          CommHopfAlgCat.baseChangeFunctor_map]
  rw [generatedCoordinateHopfAlgebraBaseChangeMap, ← Category.assoc, hbase]
  -- The inverse quotient comparison turns the base-changed projection into the new quotient
  -- projection; its defining square is the public quotient base-change equation.
  have hquot :
      CommHopfAlgCat.baseChangeMap (K := K)
          (CommHopfAlgCat.mkQuotient _ (generatedDefiningIdeal n hn k)) ≫
        (CommHopfAlgCat.quotientBaseChangeIso (K := K) (generatedDefiningIdeal n hn k)).inv =
      CommHopfAlgCat.mkQuotient _
        (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (generatedDefiningIdeal n hn k)) := by
    exact (Iso.comp_inv_eq _).mpr
      (CommHopfAlgCat.mkQuotient_comp_quotientBaseChangeIso_hom
        (K := K) (generatedDefiningIdeal n hn k)).symm
  rw [← Category.assoc, hquot, CommHopfAlgCat.mkQuotient_comp_liftQuotient]

private instance baseChangeGeneratedCoordinateMap_epi :
    Epi (CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap n hn k)) :=
  ConcreteCategory.epi_of_surjective _
    (CommHopfAlgCat.baseChangeMap_surjective _ (generatedCoordinateMap_surjective n hn k))

/-- The ambient coordinate square uniquely determines the comparison. -/
theorem generatedCoordinateHopfAlgebraBaseChangeMap_unique
    (f : CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra n hn k) ⟶
      generatedCoordinateHopfAlgebra n hn K)
    (hf : CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap n hn k) ≫ f =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        generatedCoordinateMap n hn K) :
    f = generatedCoordinateHopfAlgebraBaseChangeMap n hn k K := by
  apply (cancel_epi (CommHopfAlgCat.baseChangeMap (K := K)
    (generatedCoordinateMap n hn k))).mp
  rw [hf, baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeMap]

/-- The comparison is surjective on coordinate algebras, hence a closed immersion of groups
in the contravariant direction. -/
theorem generatedCoordinateHopfAlgebraBaseChangeMap_surjective :
    Function.Surjective (generatedCoordinateHopfAlgebraBaseChangeMap n hn k K).hom := by
  have hsurj : Function.Surjective
      ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        generatedCoordinateMap n hn K).hom :=
    (generatedCoordinateMap_surjective n hn K).comp
      (ConcreteCategory.bijective_of_isIso
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom).2
  have hcomp := congrArg (fun f ↦ f.hom)
    (baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeMap
      n hn k K)
  rw [← hcomp, _root_.CommHopfAlgCat.hom_comp, BialgHom.coe_comp] at hsurj
  exact hsurj.of_comp

/-- Every numbered root subgroup and the weight torus commute with the comparison. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_generatedCoordinateLift_comp_generatorCoordinateAlgebraBaseChangeIso_hom
    (j : (Fin n ⊕ Fin n) ⊕ Unit) :
    CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateLift n hn k j) ≫
        (generatorCoordinateAlgebraBaseChangeIso n k K j).hom =
      generatedCoordinateHopfAlgebraBaseChangeMap n hn k K ≫
        generatedCoordinateLift n hn K j := by
  apply (cancel_epi (CommHopfAlgCat.baseChangeMap (K := K)
    (generatedCoordinateMap n hn k))).mp
  rw [baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeMap_assoc,
    generatedCoordinateMap_comp_generatedCoordinateLift]
  rw [← Category.assoc, ← (CommHopfAlgCat.baseChangeFunctor (K := K)).map_comp,
    generatedCoordinateMap_comp_generatedCoordinateLift]
  exact (Iso.inv_comp_eq
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n))).mp
      (generatorCoordinateMap_baseChange n hn k K j)

/-- For free extensions the canonical comparison is the existing base-change isomorphism. -/
theorem generatedCoordinateHopfAlgebraBaseChangeMap_eq_iso_hom [Module.Free k K] :
    generatedCoordinateHopfAlgebraBaseChangeMap n hn k K =
      (generatedCoordinateHopfAlgebraBaseChangeIso n hn k K).hom :=
  (generatedCoordinateHopfAlgebraBaseChangeMap_unique n hn k K _
    (baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom
      n hn k K)).symm

end TauCeti.TypeDSpinCarrier
