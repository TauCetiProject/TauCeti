module

public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.BaseChange

/-!
# The subgroup generated by the type-Dₙ spin roots and weight torus

For `4 ≤ n`, the `2n` numbered simple-root subgroups and the rank-`n` weight torus of the
full-weight type-`Dₙ` spin carrier are morphisms into `GL_(2^n)` over any commutative ring. The
closed subgroup they generate is cut out by the largest Hopf ideal killed by all of them, that
is by the common kernel of their coordinate maps.

This file names that ideal and the resulting coordinate Hopf algebra. Every coordinate morphism
killing the ideal factors uniquely through the quotient, including each generator. The quotient
lies inside the base change of the integral carrier. Generation also commutes with free base
change: extending the subgroup generated over `k` to a free `k`-algebra `K` gives the subgroup
generated over `K`. In particular, this identifies its geometric fibres over fields.

Equality of the generated subgroup with the base change of the integral carrier is not asserted:
extra equations can appear after specialization to a non-flat base. Nor is the generated subgroup
identified with a pinned simply connected group scheme of type `Dₙ`.

## Main declarations

* `TauCeti.TypeDSpinCarrier.generatedDefiningIdeal`: the common kernel of the generator
  coordinate maps.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateHopfAlgebra`: the coordinate Hopf algebra of the
  generated closed subgroup.

## Main results

* `TauCeti.TypeDSpinCarrier.le_generatedDefiningIdeal_iff`: a Hopf ideal lies below the
  generated subgroup's defining ideal exactly when every generator coordinate map kills it.
* `TauCeti.TypeDSpinCarrier.baseChangeDefiningIdeal_le_generatedDefiningIdeal`: the base-changed
  integral carrier contains the generated subgroup.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateMap`: the quotient coordinate map.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateDesc` and
  `TauCeti.TypeDSpinCarrier.generatedCoordinateDesc_unique`: every coordinate morphism killing
  the defining ideal factors uniquely through the generated subgroup.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeIso`: free scalar extension
  of the subgroup generated over `k` is the subgroup generated over `K`.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateLift` and
  `TauCeti.TypeDSpinCarrier.generatedCoordinateLift_unique`: each generator factors uniquely
  through the generated subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

namespace TauCeti.TypeDSpinCarrier

open CategoryTheory

universe v w

variable (n : ℕ) (hn : 4 ≤ n) (A : Type v) [CommRing A]

-- The declaration structure follows the sibling generated-subgroup API of
-- `TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Basic`; the quotient descent API follows
-- `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Basic`.
/-- The defining ideal of the subgroup generated by the numbered root subgroups and the weight
torus of the type-`Dₙ` spin carrier. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (dimension n)) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap n hn A)

/-- The generated subgroup is defined by the common kernel of its generator maps. -/
@[simp]
theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal n hn A =
      CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap n hn A) := by
  simp [generatedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when all generator
coordinate maps kill it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (dimension n))) :
    J ≤ generatedDefiningIdeal n hn A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap n hn A j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap n hn A) J

/-- The base-changed integral carrier contains the generated subgroup. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal n hn A ≤ generatedDefiningIdeal n hn A := by
  rw [generatedDefiningIdeal_def]
  exact baseChangeDefiningIdeal_le_commonKernel n hn A

/-- The coordinate Hopf algebra of the subgroup generated by the numbered root subgroups and the
weight torus of the type-`Dₙ` spin carrier. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
    (generatedDefiningIdeal n hn A)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra n hn A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
        (generatedDefiningIdeal n hn A) := by
  simp [generatedCoordinateHopfAlgebra]

/-- The quotient coordinate map for the generated subgroup's closed immersion into `GL_(2^n)`.
-/
noncomputable def generatedCoordinateMap :
    GeneralLinear.coordinateHopfAlgebra A (dimension n) ⟶
      generatedCoordinateHopfAlgebra n hn A :=
  CommHopfAlgCat.mkQuotient _ _

/-- The generated subgroup's coordinate map is surjective. -/
theorem generatedCoordinateMap_surjective :
    Function.Surjective (generatedCoordinateMap n hn A).hom :=
  CommHopfAlgCat.mkQuotient_surjective _ _

/-- The kernel of the generated coordinate map is its defining ideal. -/
@[simp] theorem generatedCoordinateMap_ker :
    RingHom.ker (generatedCoordinateMap n hn A).hom =
      (generatedDefiningIdeal n hn A).toIdeal :=
  CommHopfAlgCat.mkQuotient_ker _ _

/-- A coordinate morphism out of `GL_(2^n)` killing the generated subgroup's defining ideal,
factored through the generated subgroup. -/
noncomputable def generatedCoordinateDesc {B : CommHopfAlgCat A}
    (f : GeneralLinear.coordinateHopfAlgebra A (dimension n) ⟶ B)
    (hf : (generatedDefiningIdeal n hn A).toIdeal ≤ RingHom.ker f.hom.toAlgHom.toRingHom) :
    generatedCoordinateHopfAlgebra n hn A ⟶ B :=
  CommHopfAlgCat.liftQuotient (generatedDefiningIdeal n hn A) f hf

/-- Composing the quotient coordinate map with the descent of `f` recovers `f`. -/
@[reassoc (attr := simp)]
theorem generatedCoordinateMap_comp_generatedCoordinateDesc {B : CommHopfAlgCat A}
    (f : GeneralLinear.coordinateHopfAlgebra A (dimension n) ⟶ B)
    (hf : (generatedDefiningIdeal n hn A).toIdeal ≤ RingHom.ker f.hom.toAlgHom.toRingHom) :
    generatedCoordinateMap n hn A ≫ generatedCoordinateDesc n hn A f hf = f :=
  CommHopfAlgCat.mkQuotient_comp_liftQuotient _ _ _

/-- The descent morphism is the unique factorization through the generated subgroup. -/
theorem generatedCoordinateDesc_unique {B : CommHopfAlgCat A}
    (f : GeneralLinear.coordinateHopfAlgebra A (dimension n) ⟶ B)
    (hf : (generatedDefiningIdeal n hn A).toIdeal ≤ RingHom.ker f.hom.toAlgHom.toRingHom)
    (g : generatedCoordinateHopfAlgebra n hn A ⟶ B)
    (hg : generatedCoordinateMap n hn A ≫ g = f) :
    g = generatedCoordinateDesc n hn A f hf :=
  CommHopfAlgCat.liftQuotient_unique _ _ _ g hg

/-- The `j`th generator coordinate map factored through the generated subgroup. -/
noncomputable def generatedCoordinateLift (j : Sum (Fin n ⊕ Fin n) Unit) :
    generatedCoordinateHopfAlgebra n hn A ⟶ generatorCoordinateAlgebra n A j :=
  generatedCoordinateDesc n hn A (generatorCoordinateMap n hn A j)
    ((le_generatedDefiningIdeal_iff n hn A _).mp le_rfl j)

/-- Composing the quotient map with the generator lift recovers the generator. -/
@[reassoc (attr := simp)]
theorem generatedCoordinateMap_comp_generatedCoordinateLift (j : Sum (Fin n ⊕ Fin n) Unit) :
    generatedCoordinateMap n hn A ≫ generatedCoordinateLift n hn A j =
      generatorCoordinateMap n hn A j :=
  generatedCoordinateMap_comp_generatedCoordinateDesc n hn A (generatorCoordinateMap n hn A j)
    ((le_generatedDefiningIdeal_iff n hn A _).mp le_rfl j)

/-- The generator lift is the unique factorization through the generated subgroup. -/
theorem generatedCoordinateLift_unique (j : Sum (Fin n ⊕ Fin n) Unit)
    (g : generatedCoordinateHopfAlgebra n hn A ⟶ generatorCoordinateAlgebra n A j)
    (hg : generatedCoordinateMap n hn A ≫ g = generatorCoordinateMap n hn A j) :
    g = generatedCoordinateLift n hn A j :=
  generatedCoordinateDesc_unique n hn A (generatorCoordinateMap n hn A j)
    ((le_generatedDefiningIdeal_iff n hn A _).mp le_rfl j) g hg

/-- The generated subgroup has finite-type coordinate algebra. -/
instance : Algebra.FiniteType A (generatedCoordinateHopfAlgebra n hn A) := by
  rw [generatedCoordinateHopfAlgebra_def]
  infer_instance

-- The scalar-extension argument follows the type-B generated spin subgroup in
-- `TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Basic` (PR #12899).
section BaseChange

variable (k : Type v) (K : Type max v w) [CommRing k] [CommRing K] [Algebra k K]

/-- The coordinate Hopf algebras of the generators over `K` are the scalar extensions of those
over `k`. -/
private noncomputable def generatorCoordinateAlgebraBaseChangeIso :
    ∀ j, CommHopfAlgCat.baseChange (K := K) (generatorCoordinateAlgebra n k j) ≅
      generatorCoordinateAlgebra n K j
  | .inl _ => AdditiveGroup.coordinateHopfAlgebraBaseChangeIso k K
  | .inr _ => _root_.CommHopfAlgCat.isoMk
      (TauCeti.MonoidAlgebra.scalarTensorBialgEquiv k K
        (G := SplitTorus.characterGroup (Fin n)))

/-- Each generator over `K` is the scalar extension of the corresponding generator over `k`, read
through the coordinate identifications of `GL_(2^n)` and of the generator's domain. -/
private theorem generatorCoordinateMap_baseChange (j : (Fin n ⊕ Fin n) ⊕ Unit) :
    ((GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).inv ≫
        CommHopfAlgCat.baseChangeMap (generatorCoordinateMap n hn k j)) ≫
        (generatorCoordinateAlgebraBaseChangeIso n k K j).hom =
      generatorCoordinateMap n hn K j := by
  rcases j with j | _
  · rw [Category.assoc, generatorCoordinateMap_inl, generatorCoordinateMap_inl]
    exact
      UniversalEnvelopingAlgebra.kostantRootSubgroupBaseChangePresentationCoordinateMap_baseChange
        _ _ _ _ _ _ _ k K j
  · rw [Category.assoc, generatorCoordinateMap_inr, generatorCoordinateMap_inr]
    exact GeneralLinear.weightTorusBaseChangeCoordinateMap_baseChange ℤ k K _

/-- **Generation commutes with free base change.** For `K` free over `k`, for instance a field
extension, the base change of the defining ideal of the subgroup generated over `k`, transported
into the coordinate Hopf algebra of `GL_(2^n)` over `K`, is the defining ideal of the subgroup
generated over `K`. -/
theorem map_baseChangeHopfIdeal_generatedDefiningIdeal [Module.Free k K] :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (generatedDefiningIdeal n hn k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom =
      generatedDefiningIdeal n hn K := by
  rw [generatedDefiningIdeal_def, generatedDefiningIdeal_def,
    CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal,
    CommHopfAlgCat.map_commonKernelHopfIdeal, ← funext (generatorCoordinateMap_baseChange n hn k K),
    CommHopfAlgCat.commonKernelHopfIdeal_comp_of_injective _ _ fun j ↦
      (ConcreteCategory.bijective_of_isIso (generatorCoordinateAlgebraBaseChangeIso n k K j).hom).1]

-- Within this module `generatedCoordinateHopfAlgebra` and `generatedCoordinateMap` unfold to the
-- quotient by `generatedDefiningIdeal` and its quotient map, so the generic quotient base-change
-- isomorphism and its compatibility lemma apply to them directly.
/-- For `K` free over `k`, scalar extension of the subgroup generated over `k` by the type-`Dₙ`
spin root subgroups and weight torus is the subgroup generated over `K`. -/
noncomputable def generatedCoordinateHopfAlgebraBaseChangeIso [Module.Free k K] :
    CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra n hn k) ≅
      generatedCoordinateHopfAlgebra n hn K :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq (generatedDefiningIdeal n hn k)
    (generatedDefiningIdeal n hn K)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n))
    (map_baseChangeHopfIdeal_generatedDefiningIdeal n hn k K)

/-- The base-change identification of the generated subgroups is compatible with their closed
immersions into `GL_(2^n)`. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom
    [Module.Free k K] :
    CommHopfAlgCat.baseChangeMap (K := K) (generatedCoordinateMap n hn k) ≫
        (generatedCoordinateHopfAlgebraBaseChangeIso n hn k K).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        generatedCoordinateMap n hn K :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _
    (map_baseChangeHopfIdeal_generatedDefiningIdeal n hn k K)

end BaseChange

end TauCeti.TypeDSpinCarrier
