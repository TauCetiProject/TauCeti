module

public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.BaseChange

/-!
# The subgroup generated by the type-Dₙ spin roots and weight torus

For `4 ≤ n`, the `2n` numbered simple-root subgroups and the rank-`n` weight torus of the
full-weight type-`Dₙ` spin carrier are morphisms into `GL_(2^n)` over any commutative ring. The
closed subgroup they generate is cut out by the largest Hopf ideal killed by all of them, that
is by the common kernel of their coordinate maps.

This file names that ideal and the resulting coordinate Hopf algebra, and records the two facts a
consumer needs about them: each generator factors uniquely through the quotient, and the quotient
lies inside the base change of the integral carrier.

Equality of the generated subgroup with the base change of the integral carrier is not asserted:
extra equations can appear after specialization to a non-flat base. Nor is the generated subgroup
identified with a pinned simply connected group scheme of type `Dₙ`.

## Main declarations

* `TauCeti.TypeDSpinCarrier.generatedDefiningIdeal`: the common kernel of the generator
  coordinate maps.
* `TauCeti.TypeDSpinCarrier.generatedCoordinateHopfAlgebra`: the coordinate Hopf algebra of the
  generated closed subgroup.

## Main results

* `TauCeti.TypeDSpinCarrier.le_generatedDefiningIdeal_iff`: a Hopf ideal lies below the
  generated subgroup's defining ideal exactly when every generator coordinate map kills it.
* `TauCeti.TypeDSpinCarrier.baseChangeDefiningIdeal_le_generatedDefiningIdeal`: the base-changed
  integral carrier contains the generated subgroup.
* `TauCeti.TypeDSpinCarrier.existsUnique_generatorCoordinateMap_factor`: each generator factors
  uniquely through the generated subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.

The declaration structure follows the sibling generated-subgroup API of
`TauCeti.Algebra.Lie.E6.DoubledMinuscule.Generated.Basic`.
-/

public section

namespace TauCeti.TypeDSpinCarrier

open CategoryTheory

universe v

variable (n : ℕ) (hn : 4 ≤ n) (A : Type v) [CommRing A]

/-- The defining ideal of the subgroup generated by the numbered root subgroups and the weight
torus of the type-`Dₙ` spin carrier. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (dimension n)) :=
  CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap n hn A)

/-- The generated subgroup is defined by the common kernel of its generator maps. -/
@[simp]
theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal n hn A =
      CommHopfAlgCat.commonKernelHopfIdeal (generatorCoordinateMap n hn A) := by
  simp [generatedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when all generator
coordinate maps kill it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal A (GeneralLinear.coordinateHopfAlgebra A (dimension n))) :
    J ≤ generatedDefiningIdeal n hn A ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (generatorCoordinateMap n hn A j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (generatorCoordinateMap n hn A) J

/-- The base-changed integral carrier contains the generated subgroup. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal n hn A ≤ generatedDefiningIdeal n hn A := by
  rw [generatedDefiningIdeal_def]
  exact baseChangeDefiningIdeal_le_commonKernel n hn A

/-- The coordinate Hopf algebra of the subgroup generated by the numbered root subgroups and the
weight torus of the type-`Dₙ` spin carrier. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat A :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
    (generatedDefiningIdeal n hn A)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra n hn A =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
        (generatedDefiningIdeal n hn A) := by
  simp [generatedCoordinateHopfAlgebra]

/-- Each generator factors uniquely through the generated subgroup's coordinate quotient. -/
theorem existsUnique_generatorCoordinateMap_factor (j : Sum (Fin n ⊕ Fin n) Unit) :
    ∃! g : CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
        (generatedDefiningIdeal n hn A) ⟶ generatorCoordinateAlgebra n A j,
      CommHopfAlgCat.mkQuotient (GeneralLinear.coordinateHopfAlgebra A (dimension n))
        (generatedDefiningIdeal n hn A) ≫ g = generatorCoordinateMap n hn A j := by
  rw [generatedDefiningIdeal_def]
  refine ⟨CommHopfAlgCat.commonKernelLift (generatorCoordinateMap n hn A) j, ?_, ?_⟩
  · exact CommHopfAlgCat.mkQuotient_comp_commonKernelLift (generatorCoordinateMap n hn A) j
  · intro g hg
    exact CommHopfAlgCat.commonKernelLift_unique (generatorCoordinateMap n hn A) j g hg

end TauCeti.TypeDSpinCarrier
