module

public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Generated.StandardComodule
public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Faithful

/-!
# Triviality of the generated type-D spin subgroup's unipotent radical

Over an algebraically closed field, the subgroup of `GL_(2^n)` generated by the numbered
spin root subgroups and weight torus has no nontrivial normal smooth unipotent closed subgroup.
Its full spin representation is faithful and completely reducible, and its coordinate algebra
is reduced because the generators are reduced. No reducedness hypothesis remains.

This is a statement about the subgroup generated over the field. Transferring it to the
specialization of the integral toral closure requires an identification of those two subgroup
schemes, which is not asserted here.

## Main results

* `TauCeti.TypeDSpinCarrier.eq_augmentation_generated_of_isNormal_of_smoothUnipotent`: every
  normal smooth unipotent closed subgroup is trivial.
* `TauCeti.TypeDSpinCarrier.unipotentRadicalDefiningIdeal_generated_eq_augmentation`: the
  generated spin subgroup's unipotent radical is trivial.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.

The elimination argument follows
`TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.UnipotentRadical`, using the generic
faithful-comodule theorem. The generated-subgroup specialization follows
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.UnipotentRadical`.
-/

public section

namespace TauCeti.TypeDSpinCarrier

universe u

noncomputable section

variable (n : ℕ) (hn : 4 ≤ n) (k : Type u) [Field k] [IsAlgClosed k]

attribute [local instance] generatedStandardComodule

/-- Every normal smooth unipotent closed subgroup of the type-D spin subgroup generated over
an algebraically closed field is trivial. -/
theorem eq_augmentation_generated_of_isNormal_of_smoothUnipotent
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra n hn k)) (hI : I.IsNormal)
    (hU : smoothUnipotentCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.quotient
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n hn k)) I)) :
    I = HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra n hn k) := by
  let _ := isReduced_generatedCoordinateHopfAlgebra n hn k
  exact HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful k
    (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n hn k))
    (Fin (dimension n) → k) (isCompletelyReducible_generatedStandardComodule n hn k)
    (isFaithful_generatedStandardComodule n hn k) I hI hU

/-- The unipotent radical of the type-D spin subgroup generated over an algebraically closed
field is trivial. -/
theorem unipotentRadicalDefiningIdeal_generated_eq_augmentation :
    FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n hn k)) =
      HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra n hn k) := by
  let _ := isReduced_generatedCoordinateHopfAlgebra n hn k
  exact FiniteTypeCommHopfAlgCat.unipotentRadicalDefiningIdeal_eq_augmentation_of_isFaithful k
    (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n hn k))
    (Fin (dimension n) → k) (isCompletelyReducible_generatedStandardComodule n hn k)
    (isFaithful_generatedStandardComodule n hn k)

end

end TauCeti.TypeDSpinCarrier
