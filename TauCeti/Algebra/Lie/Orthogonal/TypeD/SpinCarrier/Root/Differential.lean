module

public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.Differential
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Tangent
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Tangent
public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.BaseChange
public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.ClosedRootSubgroup
public import TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.IntegralMatrix
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent

/-!
# Integral root differentials of the type-D spin carrier

The `2n` numbered root-subgroup differentials of the integral full-weight type-`Dₙ` spin carrier
send the additive unit tangent vector to the integral matrix of the represented root generator.
Each differential is injective, and its image is the line generated by that normalized vector,
with values in every commutative ring, including nonreduced rings. Coefficient change preserves
the normalization.

These are the equations that compare the root parametrizations of the carrier with the root
vectors of a pinning. Nothing here asserts that these lines exhaust the adjoint weight spaces,
that the weight torus is maximal, or that the carrier has a Borel subgroup or a pinning; nor is
the carrier identified with an independently pinned simply connected group scheme of type `Dₙ`.

## Main results

* `TauCeti.TypeDSpinCarrier.rootSubgroupIntegralCoordinateMap_surjective`: every numbered integral
  root-subgroup coordinate map is surjective.
* `TauCeti.TypeDSpinCarrier.tangentMatrix_derivationComp_rootSubgroup`: the differential of a
  numbered root subgroup is the tangent parameter times the integral root matrix.
* `TauCeti.TypeDSpinCarrier.rootVector`: the normalized root vector, with
  `TauCeti.TypeDSpinCarrier.tangentMatrix_rootVector` and
  `TauCeti.TypeDSpinCarrier.range_derivationCompLieHom_rootSubgroup_eq_span`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a and §21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1–2.

The matrix calculation is the general Kostant root-subgroup tangent theorem of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent`; the root-vector
interface follows the doubled `E₆` carrier in
`TauCeti.Algebra.Lie.E6.DoubledMinuscule.Root.Differential`.
-/

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.TypeDSpinCarrier

universe v

noncomputable section

-- Use the algebra-induced integer module consistently for the counit coefficient synonyms.
attribute [local instance high] Algebra.toModule

variable (n : ℕ) (hn : 4 ≤ n) {B : Type v} [CommRing B]

/-- Every numbered integral root-subgroup coordinate map is surjective. In particular, its
differential is injective over every coefficient algebra. -/
theorem rootSubgroupIntegralCoordinateMap_surjective (k : Fin n ⊕ Fin n) :
    Function.Surjective (rootSubgroupIntegralCoordinateMap n hn k).hom := by
  have h := (rootSubgroupCoordinateMap_surjective n hn k).comp
    (CommHopfAlgCat.mkQuotient_surjective _ _)
  rw [← BialgHom.coe_comp, ← CommHopfAlgCat.hom_comp,
    mkQuotient_comp_kostantRootSubgroupToralCoordinateMap,
    ← mkQuotient_comp_rootSubgroupIntegralCoordinateMap] at h
  exact Function.Surjective.of_comp h

/-- The differential of a numbered integral root subgroup is its integral root matrix multiplied
by the additive tangent parameter, over every coefficient ring. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem tangentMatrix_derivationComp_rootSubgroup (k : Fin n ⊕ Fin n)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    GeneralLinear.tangentMatrix (dimension n)
        (HopfIdeal.quotientLieHom (B := B) (definingIdeal n hn)
          (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n hn k).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d • (rootIntMatrix n hn k).map (Int.cast : ℤ → B) := by
  have hcomp : (rootSubgroupIntegralCoordinateMap n hn k).hom.comp
      (Bialgebra.Quotient.mkBialgHom (definingIdeal n hn).toIdeal) =
      (kostantRootSubgroupCoordinateMap
        (TauCeti.serreRootGenerator (CartanMatrix.D n))
        (TauCeti.serreH ℚ (CartanMatrix.D n)) (rep n hn) (lattice n).toAddSubgroup
        (rep_kostantForm_mem_lattice n hn) k (isNilpotent_rep_rootGenerator n hn k)
        (latticeBasis n)).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← CommHopfAlgCat.hom_comp,
      mkQuotient_comp_rootSubgroupIntegralCoordinateMap]
  rw [HopfIdeal.quotientLieHom_apply, ← LinearMap.comp_apply, ← derivationComp_comp, hcomp]
  simpa only [rootIntMatrix_eq_toMatrix, algebraMap_int_eq, Int.coe_castRingHom] using
    tangentMatrix_derivationComp_kostantRootSubgroupCoordinateMap
      (TauCeti.serreRootGenerator (CartanMatrix.D n))
      (TauCeti.serreH ℚ (CartanMatrix.D n)) (rep n hn) (lattice n).toAddSubgroup
      (rep_kostantForm_mem_lattice n hn) k (isNilpotent_rep_rootGenerator n hn k)
      (latticeBasis n) d

/-- Every numbered integral root-subgroup differential is injective, including when its
coefficient ring has nilpotents. -/
theorem derivationComp_rootSubgroup_injective (k : Fin n ⊕ Fin n) :
    Function.Injective
      (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n hn k).hom) :=
  derivationComp_injective_of_surjective _ (rootSubgroupIntegralCoordinateMap_surjective n hn k)

/-- The normalized root vector of the integral type-`Dₙ` spin carrier, with values in `B`, is the
image of the additive unit tangent vector under its numbered root-subgroup differential. -/
def rootVector (k : Fin n ⊕ Fin n) :
    Derivation ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (dimension n) ⧸
        (definingIdeal n hn).toIdeal)
      (Bialgebra.CounitAlgebra ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (dimension n) ⧸
        (definingIdeal n hn).toIdeal) B) :=
  derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n hn k).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1)

/-- The normalized root vector is the differential of the numbered root subgroup at the additive
unit tangent vector. -/
theorem rootVector_def (k : Fin n ⊕ Fin n) :
    rootVector n hn (B := B) k =
      derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n hn k).hom
        ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1) := by
  rw [rootVector]

/-- The matrix of a normalized root vector is its integral root matrix. -/
@[simp]
theorem tangentMatrix_rootVector (k : Fin n ⊕ Fin n) :
    GeneralLinear.tangentMatrix (dimension n)
        (HopfIdeal.quotientLieHom (B := B) (definingIdeal n hn) (rootVector n hn (B := B) k)) =
      (rootIntMatrix n hn k).map (Int.cast : ℤ → B) := by
  rw [rootVector_def, tangentMatrix_derivationComp_rootSubgroup, LinearEquiv.apply_symm_apply,
    one_smul]

/-- The differential with additive parameter `c` is `c` times the normalized root vector. -/
theorem derivationComp_rootSubgroup_eq_smul_rootVector (k : Fin n ⊕ Fin n)
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n hn k).hom d =
      AdditiveGroup.gaTangentLinearEquiv d • rootVector n hn (B := B) k :=
  AdditiveGroup.derivationComp_eq_smul _ d

/-- Coefficient change preserves the normalized integral root vector. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem mapValue_rootVector {C : Type*} [CommRing C] (φ : B →ₐ[ℤ] C) (k : Fin n ⊕ Fin n) :
    Derivation.mapValue φ (rootVector n hn (B := B) k) = rootVector n hn (B := C) k :=
  AdditiveGroup.mapValue_derivationComp_gaTangentLinearEquiv_symm_one φ _

/-- The image of each root-subgroup differential is precisely its normalized root line. -/
theorem range_derivationCompLieHom_rootSubgroup_eq_span (k : Fin n ⊕ Fin n) :
    (derivationCompLieHom (B := B)
        (rootSubgroupIntegralCoordinateMap n hn k).hom).range.toSubmodule =
      B ∙ rootVector n hn (B := B) k :=
  AdditiveGroup.range_derivationCompLieHom_eq_span B _

/-- A normalized root vector is nonzero over every nontrivial coefficient ring.
Use this directly: simplification changes the inherited integer module in the zero derivation
before this statement can match. -/
theorem rootVector_ne_zero [Nontrivial B] (k : Fin n ⊕ Fin n) :
    rootVector n hn (B := B) k ≠ 0 :=
  AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_rootSubgroup_injective n hn (B := B) k)

end

end TauCeti.TypeDSpinCarrier
