module

public import TauCeti.Algebra.Lie.Orthogonal.TypeD.GraphAutomorphism
import TauCeti.Algebra.Lie.Orthogonal.Basic

/-!
# Coordinates for the type-D graph involution

The two equal coordinates in the chosen hyperbolic pair give the norm-two line
of the native odd orthogonal form. The remaining pairs retain their coordinates.
Inclusion and averaging projection split this space from the anti-invariant line.
These rectangular matrices supply the coordinate maps for restriction and extension
of fixed orthogonal operators.
-/

public section

open Matrix LieAlgebra.Orthogonal

namespace TauCeti

variable {I : Type*} [DecidableEq I] (c : I) (A : Type*) [CommRing A]

/-- Include the native odd coordinates by repeating the distinguished coordinate. -/
def typeDGraphInclusion : Matrix (I ⊕ I) (Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c}) A :=
  Matrix.of fun s ↦
    match s with
    | .inl i => if hi : i = c then Pi.single (.inl ()) 1
        else Pi.single (.inr (.inl ⟨i, hi⟩)) 1
    | .inr i => if hi : i = c then Pi.single (.inl ()) 1
        else Pi.single (.inr (.inr ⟨i, hi⟩)) 1

/-- The anti-invariant line is generated by the difference of the chosen coordinates. -/
def typeDGraphAntiInclusion : Matrix (I ⊕ I) Unit A :=
  Matrix.of fun s _ ↦
    ((Pi.single (Sum.inl c) 1 : I ⊕ I → A) -
      (Pi.single (Sum.inr c) 1 : I ⊕ I → A)) s

/-- The inclusion row at either chosen coordinate reads the norm-two coordinate. -/
@[simp]
theorem typeDGraphInclusion_inl_self :
    typeDGraphInclusion c A (.inl c) = Pi.single (.inl ()) 1 := by
  ext j
  simp [typeDGraphInclusion]

/-- The negative coordinate of the chosen pair reads the same norm-two coordinate. -/
@[simp]
theorem typeDGraphInclusion_inr_self :
    typeDGraphInclusion c A (.inr c) = Pi.single (.inl ()) 1 := by
  ext j
  simp [typeDGraphInclusion]

/-- Outside the chosen pair, inclusion reads the corresponding positive coordinate. -/
@[simp]
theorem typeDGraphInclusion_inl_of_ne {i : I} (hi : i ≠ c) :
    typeDGraphInclusion c A (.inl i) = Pi.single (.inr (.inl ⟨i, hi⟩)) 1 := by
  ext j
  simp [typeDGraphInclusion, hi]

/-- Outside the chosen pair, inclusion reads the corresponding negative coordinate. -/
@[simp]
theorem typeDGraphInclusion_inr_of_ne {i : I} (hi : i ≠ c) :
    typeDGraphInclusion c A (.inr i) = Pi.single (.inr (.inr ⟨i, hi⟩)) 1 := by
  ext j
  simp [typeDGraphInclusion, hi]

/-- The anti-invariant line has entry `1` at the chosen positive coordinate, `-1` at the chosen
negative coordinate, and `0` elsewhere. -/
@[simp]
theorem typeDGraphAntiInclusion_apply (s : I ⊕ I) (u : Unit) :
    typeDGraphAntiInclusion c A s u =
      ((Pi.single (Sum.inl c) 1 : I ⊕ I → A) - (Pi.single (Sum.inr c) 1 : I ⊕ I → A)) s :=
  (rfl)

/-- The anti-invariant line has its original coefficient at the chosen positive coordinate. -/
@[simp]
theorem typeDGraphAntiInclusion_mulVec_inl_self (x : Unit → A) :
    (typeDGraphAntiInclusion c A *ᵥ x) (.inl c) = x () := by
  simp [Matrix.mulVec, dotProduct]

/-- The chosen negative coordinate has the opposite coefficient. -/
@[simp]
theorem typeDGraphAntiInclusion_mulVec_inr_self (x : Unit → A) :
    (typeDGraphAntiInclusion c A *ᵥ x) (.inr c) = -x () := by
  simp [Matrix.mulVec, dotProduct]

/-- The anti-invariant line vanishes at every other positive coordinate. -/
@[simp]
theorem typeDGraphAntiInclusion_mulVec_inl_of_ne (x : Unit → A) {i : I} (hi : i ≠ c) :
    (typeDGraphAntiInclusion c A *ᵥ x) (.inl i) = 0 := by
  simp [Matrix.mulVec, dotProduct, hi]

/-- The anti-invariant line vanishes at every other negative coordinate. -/
@[simp]
theorem typeDGraphAntiInclusion_mulVec_inr_of_ne (x : Unit → A) {i : I} (hi : i ≠ c) :
    (typeDGraphAntiInclusion c A *ᵥ x) (.inr i) = 0 := by
  simp [Matrix.mulVec, dotProduct, hi]

private theorem typeDGraphInclusion_transpose_zero :
    (typeDGraphInclusion c A)ᵀ (.inl ()) =
      (Pi.single (Sum.inl c) 1 : I ⊕ I → A) + Pi.single (Sum.inr c) 1 := by
  ext (i | i) <;> by_cases hi : i = c <;>
    simp [Matrix.transpose_apply, typeDGraphInclusion, hi]

private theorem typeDGraphInclusion_transpose_inl (j : {i : I // i ≠ c}) :
    (typeDGraphInclusion c A)ᵀ (.inr (.inl j)) = Pi.single (.inl j.1) 1 := by
  have hj := j.property
  ext (i | i) <;> by_cases hi : i = c <;>
    simp_all [Matrix.transpose_apply, typeDGraphInclusion, Pi.single_apply, Subtype.ext_iff,
      eq_comm]

private theorem typeDGraphInclusion_transpose_inr (j : {i : I // i ≠ c}) :
    (typeDGraphInclusion c A)ᵀ (.inr (.inr j)) = Pi.single (.inr j.1) 1 := by
  have hj := j.property
  ext (i | i) <;> by_cases hi : i = c <;>
    simp_all [Matrix.transpose_apply, typeDGraphInclusion, Pi.single_apply, Subtype.ext_iff,
      eq_comm]

private theorem typeDGraphAntiInclusion_transpose_apply (u : Unit) :
    (typeDGraphAntiInclusion c A)ᵀ u =
      (Pi.single (Sum.inl c) 1 : I ⊕ I → A) - Pi.single (Sum.inr c) 1 := by
  ext s
  rw [Matrix.transpose_apply, typeDGraphAntiInclusion_apply]

variable [Fintype I]

/-- Transpose inclusion sums the two chosen coordinates. -/
@[simp]
theorem typeDGraphInclusion_transpose_mulVec_zero (x : I ⊕ I → A) :
    ((typeDGraphInclusion c A)ᵀ *ᵥ x) (.inl ()) = x (.inl c) + x (.inr c) := by
  simp only [Matrix.mulVec, typeDGraphInclusion_transpose_zero, add_dotProduct,
    single_dotProduct, one_mul]

/-- Transpose inclusion reads the remaining positive coordinates. -/
@[simp]
theorem typeDGraphInclusion_transpose_mulVec_inl (x : I ⊕ I → A)
    (i : {i : I // i ≠ c}) :
    ((typeDGraphInclusion c A)ᵀ *ᵥ x) (.inr (.inl i)) = x (.inl i.1) := by
  simp only [Matrix.mulVec, typeDGraphInclusion_transpose_inl, single_dotProduct, one_mul]

/-- Transpose inclusion reads the remaining negative coordinates. -/
@[simp]
theorem typeDGraphInclusion_transpose_mulVec_inr (x : I ⊕ I → A)
    (i : {i : I // i ≠ c}) :
    ((typeDGraphInclusion c A)ᵀ *ᵥ x) (.inr (.inr i)) = x (.inr i.1) := by
  simp only [Matrix.mulVec, typeDGraphInclusion_transpose_inr, single_dotProduct, one_mul]

/-- Transpose anti-inclusion takes the difference of the chosen coordinates. -/
@[simp]
theorem typeDGraphAntiInclusion_transpose_mulVec (x : I ⊕ I → A) :
    ((typeDGraphAntiInclusion c A)ᵀ *ᵥ x) () = x (.inl c) - x (.inr c) := by
  simp only [Matrix.mulVec, typeDGraphAntiInclusion_transpose_apply, sub_dotProduct,
    single_dotProduct, one_mul]

/-- Inclusion repeats the norm-two coordinate at the chosen positive coordinate. -/
@[simp]
theorem typeDGraphInclusion_mulVec_inl_self
    (x : Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c} → A) :
    (typeDGraphInclusion c A *ᵥ x) (.inl c) = x (.inl ()) := by
  simp [Matrix.mulVec, typeDGraphInclusion_inl_self, single_dotProduct]

/-- Inclusion repeats the norm-two coordinate at the chosen negative coordinate. -/
@[simp]
theorem typeDGraphInclusion_mulVec_inr_self
    (x : Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c} → A) :
    (typeDGraphInclusion c A *ᵥ x) (.inr c) = x (.inl ()) := by
  simp [Matrix.mulVec, typeDGraphInclusion_inr_self, single_dotProduct]

/-- Inclusion preserves positive coordinates outside the chosen pair. -/
@[simp]
theorem typeDGraphInclusion_mulVec_inl_of_ne
    (x : Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c} → A) {i : I} (hi : i ≠ c) :
    (typeDGraphInclusion c A *ᵥ x) (.inl i) = x (.inr (.inl ⟨i, hi⟩)) := by
  simp [Matrix.mulVec, typeDGraphInclusion_inl_of_ne, hi, single_dotProduct]

/-- Inclusion preserves negative coordinates outside the chosen pair. -/
@[simp]
theorem typeDGraphInclusion_mulVec_inr_of_ne
    (x : Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c} → A) {i : I} (hi : i ≠ c) :
    (typeDGraphInclusion c A *ᵥ x) (.inr i) = x (.inr (.inr ⟨i, hi⟩)) := by
  simp [Matrix.mulVec, typeDGraphInclusion_inr_of_ne, hi, single_dotProduct]

/-- The included odd coordinates are fixed by the graph permutation. -/
@[simp]
theorem typeDGraphMatrix_mul_inclusion :
    typeDGraphMatrix c A * typeDGraphInclusion c A = typeDGraphInclusion c A := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec]
  ext (i | i)
  · by_cases hi : i = c
    · subst i
      simp [-Matrix.mulVec_mulVec]
    · simp [-Matrix.mulVec_mulVec, hi]
  · by_cases hi : i = c
    · subst i
      simp [-Matrix.mulVec_mulVec]
    · simp [-Matrix.mulVec_mulVec, hi]

/-- The graph permutation negates the distinguished difference line. -/
@[simp]
theorem typeDGraphMatrix_mul_antiInclusion :
    typeDGraphMatrix c A * typeDGraphAntiInclusion c A = -typeDGraphAntiInclusion c A := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec, Matrix.neg_mulVec]
  ext (i | i)
  · by_cases hi : i = c
    · subst i
      simp [-Matrix.mulVec_mulVec]
    · simp [-Matrix.mulVec_mulVec, hi]
  · by_cases hi : i = c
    · subst i
      simp [-Matrix.mulVec_mulVec]
    · simp [-Matrix.mulVec_mulVec, hi]

/-- Inclusion pulls the native even orthogonal form back to the native odd form. -/
@[simp]
theorem typeDGraphInclusion_gram :
    (typeDGraphInclusion c A)ᵀ * JD I A * typeDGraphInclusion c A =
      JB {i : I // i ≠ c} A := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  simp only [← Matrix.mulVec_mulVec]
  ext (u | (i | i))
  · cases u
    simp [-Matrix.mulVec_mulVec, JD, JB, Matrix.fromBlocks_mulVec,
      Matrix.smul_mulVec, ← two_mul]
  · simp [-Matrix.mulVec_mulVec, JD, JB, Matrix.fromBlocks_mulVec, i.property]
  · simp [-Matrix.mulVec_mulVec, JD, JB, Matrix.fromBlocks_mulVec, i.property]

/-- The invariant coordinates and the anti-invariant line are orthogonal. -/
@[simp]
theorem typeDGraphInclusion_gram_antiInclusion :
    (typeDGraphInclusion c A)ᵀ * JD I A * typeDGraphAntiInclusion c A = 0 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  simp only [← Matrix.mulVec_mulVec, Matrix.zero_mulVec]
  ext (u | (i | i))
  · cases u
    simp [-Matrix.mulVec_mulVec, JD, Matrix.fromBlocks_mulVec]
  · simp [-Matrix.mulVec_mulVec, JD, Matrix.fromBlocks_mulVec, i.property]
  · simp [-Matrix.mulVec_mulVec, JD, Matrix.fromBlocks_mulVec, i.property]

/-- The distinguished difference line has coefficient minus two. -/
@[simp]
theorem typeDGraphAntiInclusion_gram :
    (typeDGraphAntiInclusion c A)ᵀ * JD I A * typeDGraphAntiInclusion c A =
      (-2 : A) • (1 : Matrix Unit Unit A) := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  simp only [← Matrix.mulVec_mulVec]
  ext u
  cases u
  simp [-Matrix.mulVec_mulVec, JD, Matrix.fromBlocks_mulVec, Matrix.neg_mulVec,
    Matrix.smul_mulVec, two_mul, sub_eq_add_neg]

variable [Invertible (2 : A)]

/-- Average the chosen coordinates and retain every remaining hyperbolic pair. -/
def typeDGraphProjection : Matrix (Unit ⊕ {i : I // i ≠ c} ⊕ {i : I // i ≠ c}) (I ⊕ I) A :=
  Matrix.of fun s ↦
    match s with
    | .inl _ => ⅟(2 : A) • (Pi.single (.inl c) 1 + Pi.single (.inr c) 1)
    | .inr (.inl i) => Pi.single (.inl i.1) 1
    | .inr (.inr i) => Pi.single (.inr i.1) 1

/-- Read half the difference of the two chosen coordinates. -/
def typeDGraphAntiProjection : Matrix Unit (I ⊕ I) A :=
  ⅟(2 : A) • (typeDGraphAntiInclusion c A)ᵀ

omit [Fintype I] in
/-- The distinguished row of the projection averages the two chosen coordinates. -/
@[simp]
theorem typeDGraphProjection_zero :
    typeDGraphProjection c A (.inl ()) =
      ⅟(2 : A) • ((Pi.single (Sum.inl c) 1 : I ⊕ I → A) + Pi.single (Sum.inr c) 1) :=
  (rfl)

omit [Fintype I] in
/-- The projection row of a remaining positive coordinate reads that coordinate. -/
@[simp]
theorem typeDGraphProjection_inl (i : {i : I // i ≠ c}) :
    typeDGraphProjection c A (.inr (.inl i)) = Pi.single (.inl i.1) 1 :=
  (rfl)

omit [Fintype I] in
/-- The projection row of a remaining negative coordinate reads that coordinate. -/
@[simp]
theorem typeDGraphProjection_inr (i : {i : I // i ≠ c}) :
    typeDGraphProjection c A (.inr (.inr i)) = Pi.single (.inr i.1) 1 :=
  (rfl)

omit [Fintype I] in
/-- The anti-invariant projection takes half the difference of the two chosen coordinates. -/
@[simp]
theorem typeDGraphAntiProjection_apply (u : Unit) :
    typeDGraphAntiProjection c A u =
      ⅟(2 : A) • ((Pi.single (Sum.inl c) 1 : I ⊕ I → A) - Pi.single (Sum.inr c) 1) :=
  (rfl)

/-- The distinguished projected coordinate is the average of the chosen pair. -/
@[simp]
theorem typeDGraphProjection_mulVec_zero (x : I ⊕ I → A) :
    (typeDGraphProjection c A *ᵥ x) (.inl ()) =
      ⅟(2 : A) * (x (.inl c) + x (.inr c)) := by
  simp only [Matrix.mulVec, typeDGraphProjection_zero, smul_dotProduct, add_dotProduct,
    single_dotProduct, one_mul, smul_eq_mul]

/-- Projection retains positive coordinates outside the chosen pair. -/
@[simp]
theorem typeDGraphProjection_mulVec_inl (x : I ⊕ I → A) (i : {i : I // i ≠ c}) :
    (typeDGraphProjection c A *ᵥ x) (.inr (.inl i)) = x (.inl i.1) := by
  simp only [Matrix.mulVec, typeDGraphProjection_inl, single_dotProduct, one_mul]

/-- Projection retains negative coordinates outside the chosen pair. -/
@[simp]
theorem typeDGraphProjection_mulVec_inr (x : I ⊕ I → A) (i : {i : I // i ≠ c}) :
    (typeDGraphProjection c A *ᵥ x) (.inr (.inr i)) = x (.inr i.1) := by
  simp only [Matrix.mulVec, typeDGraphProjection_inr, single_dotProduct, one_mul]

/-- The anti-invariant coefficient is half the difference of the chosen pair. -/
@[simp]
theorem typeDGraphAntiProjection_mulVec (x : I ⊕ I → A) :
    (typeDGraphAntiProjection c A *ᵥ x) () =
      ⅟(2 : A) * (x (.inl c) - x (.inr c)) := by
  simp only [Matrix.mulVec, typeDGraphAntiProjection_apply, smul_dotProduct, sub_dotProduct,
    single_dotProduct, one_mul, smul_eq_mul]

/-- Projection is a left inverse to inclusion. -/
@[simp]
theorem typeDGraphProjection_mul_inclusion :
    typeDGraphProjection c A * typeDGraphInclusion c A = 1 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec, Matrix.one_mulVec]
  ext (u | (i | i))
  · cases u
    simp [← two_mul, ← mul_assoc]
  · simp [i.property]
  · simp [i.property]

/-- Projection kills the anti-invariant line. -/
@[simp]
theorem typeDGraphProjection_mul_antiInclusion :
    typeDGraphProjection c A * typeDGraphAntiInclusion c A = 0 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec, Matrix.zero_mulVec]
  ext (u | (i | i))
  · cases u
    simp
  · simp [i.property]
  · simp [i.property]

/-- The anti-invariant projection kills the included odd coordinates. -/
@[simp]
theorem typeDGraphAntiProjection_mul_inclusion :
    typeDGraphAntiProjection c A * typeDGraphInclusion c A = 0 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec, Matrix.zero_mulVec]
  ext u
  cases u
  simp

/-- The anti-invariant coefficient recovers its original scalar. -/
@[simp]
theorem typeDGraphAntiProjection_mul_antiInclusion :
    typeDGraphAntiProjection c A * typeDGraphAntiInclusion c A = 1 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  rw [← Matrix.mulVec_mulVec, Matrix.one_mulVec]
  ext u
  cases u
  simp [← two_mul, ← mul_assoc]

/-- The invariant coordinates and anti-invariant line reconstruct every vector. -/
theorem typeDGraphInclusion_mul_projection_add :
    typeDGraphInclusion c A * typeDGraphProjection c A +
      typeDGraphAntiInclusion c A * typeDGraphAntiProjection c A = 1 := by
  apply Matrix.ext_iff_mulVec.mpr
  intro x
  simp only [Matrix.add_mulVec, ← Matrix.mulVec_mulVec, Matrix.one_mulVec]
  ext (i | i)
  · by_cases hi : i = c
    · subst i
      simp only [Pi.add_apply, typeDGraphInclusion_mulVec_inl_self,
        typeDGraphProjection_mulVec_zero, typeDGraphAntiInclusion_mulVec_inl_self,
        typeDGraphAntiProjection_mulVec]
      calc
        _ = ⅟(2 : A) * 2 * x (.inl c) := by ring
        _ = x (.inl c) := by rw [invOf_mul_self, one_mul]
    · simp [-Matrix.mulVec_mulVec, hi]
  · by_cases hi : i = c
    · subst i
      simp only [Pi.add_apply, typeDGraphInclusion_mulVec_inr_self,
        typeDGraphProjection_mulVec_zero, typeDGraphAntiInclusion_mulVec_inr_self,
        typeDGraphAntiProjection_mulVec]
      calc
        _ = ⅟(2 : A) * 2 * x (.inr c) := by ring
        _ = x (.inr c) := by rw [invOf_mul_self, one_mul]
    · simp [-Matrix.mulVec_mulVec, hi]

/-- A matrix with rows indexed by `I ⊕ I` is the sum of its parts through the invariant
coordinates and through the anti-invariant line. -/
theorem typeDGraphInclusion_mul_projection_mul_add {n : Type*} (M : Matrix (I ⊕ I) n A) :
    typeDGraphInclusion c A * (typeDGraphProjection c A * M) +
      typeDGraphAntiInclusion c A * (typeDGraphAntiProjection c A * M) = M := by
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, ← Matrix.add_mul,
    typeDGraphInclusion_mul_projection_add, Matrix.one_mul]

/-- The transposed splitting: a matrix with rows indexed by `I ⊕ I` is recovered from its
pairings with the invariant coordinates and with the anti-invariant line. -/
theorem typeDGraphProjection_transpose_mul_inclusion_transpose_mul_add {n : Type*}
    (M : Matrix (I ⊕ I) n A) :
    (typeDGraphProjection c A)ᵀ * ((typeDGraphInclusion c A)ᵀ * M) +
      (typeDGraphAntiProjection c A)ᵀ * ((typeDGraphAntiInclusion c A)ᵀ * M) = M := by
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, ← Matrix.add_mul, ← Matrix.transpose_mul,
    ← Matrix.transpose_mul, ← Matrix.transpose_add, typeDGraphInclusion_mul_projection_add,
    Matrix.transpose_one, Matrix.one_mul]

private theorem typeDGraphMatrix_eq_inclusion_mul_projection_sub :
    typeDGraphMatrix c A = typeDGraphInclusion c A * typeDGraphProjection c A -
      typeDGraphAntiInclusion c A * typeDGraphAntiProjection c A := by
  calc
    _ = typeDGraphMatrix c A * (typeDGraphInclusion c A * typeDGraphProjection c A +
        typeDGraphAntiInclusion c A * typeDGraphAntiProjection c A) := by
      rw [typeDGraphInclusion_mul_projection_add, Matrix.mul_one]
    _ = _ := by
      simp only [Matrix.mul_add, ← Matrix.mul_assoc, typeDGraphMatrix_mul_inclusion,
        typeDGraphMatrix_mul_antiInclusion, Matrix.neg_mul, sub_eq_add_neg]

/-- Averaging projection is unchanged by the graph permutation. -/
@[simp]
theorem typeDGraphProjection_mul_graphMatrix :
    typeDGraphProjection c A * typeDGraphMatrix c A = typeDGraphProjection c A := by
  rw [typeDGraphMatrix_eq_inclusion_mul_projection_sub]
  simp [Matrix.mul_sub, ← Matrix.mul_assoc]

/-- The difference projection changes sign under the graph permutation. -/
@[simp]
theorem typeDGraphAntiProjection_mul_graphMatrix :
    typeDGraphAntiProjection c A * typeDGraphMatrix c A = -typeDGraphAntiProjection c A := by
  rw [typeDGraphMatrix_eq_inclusion_mul_projection_sub]
  simp [Matrix.mul_sub, ← Matrix.mul_assoc]

/-- Inclusion after projection is the averaging projector of the graph involution. -/
theorem typeDGraphInclusion_mul_projection :
    typeDGraphInclusion c A * typeDGraphProjection c A =
      ⅟(2 : A) • (1 + typeDGraphMatrix c A) := by
  have hsum : 1 + typeDGraphMatrix c A =
      (2 : A) • (typeDGraphInclusion c A * typeDGraphProjection c A) := by
    rw [← typeDGraphInclusion_mul_projection_add c A,
      typeDGraphMatrix_eq_inclusion_mul_projection_sub, two_smul A]
    abel
  rw [hsum, smul_smul, invOf_mul_self, one_smul]

omit [Fintype I] in
/-- The complementary projector extracts the anti-invariant line. -/
theorem typeDGraphAntiInclusion_mul_antiProjection :
    typeDGraphAntiInclusion c A * typeDGraphAntiProjection c A =
      ⅟(2 : A) • (1 - typeDGraphMatrix c A) := by
  ext (i | i) (j | j) <;> by_cases hi : i = c <;> by_cases hj : j = c <;>
    simp_all [Matrix.mul_apply, typeDGraphMatrix_apply, Matrix.one_apply, Pi.single_apply,
      eq_comm]

/-- Inclusion and projection intertwine the native even and odd orthogonal forms. -/
theorem typeDGraphInclusion_form_transport :
    JD I A * typeDGraphInclusion c A =
      (typeDGraphProjection c A)ᵀ * JB {i : I // i ≠ c} A := by
  have hcross : (typeDGraphAntiInclusion c A)ᵀ * JD I A * typeDGraphInclusion c A = 0 := by
    simpa only [Matrix.transpose_mul, Matrix.transpose_transpose, isSymm_JD.eq,
      ← Matrix.mul_assoc, Matrix.transpose_zero] using
      congrArg Matrix.transpose (typeDGraphInclusion_gram_antiInclusion c A)
  calc
    _ = (typeDGraphProjection c A)ᵀ *
          ((typeDGraphInclusion c A)ᵀ * JD I A * typeDGraphInclusion c A) +
        (typeDGraphAntiProjection c A)ᵀ *
          ((typeDGraphAntiInclusion c A)ᵀ * JD I A * typeDGraphInclusion c A) := by
      simpa only [Matrix.mul_assoc] using
        (typeDGraphProjection_transpose_mul_inclusion_transpose_mul_add c A
          (JD I A * typeDGraphInclusion c A)).symm
    _ = _ := by rw [typeDGraphInclusion_gram, hcross, Matrix.mul_zero, add_zero]

end TauCeti
