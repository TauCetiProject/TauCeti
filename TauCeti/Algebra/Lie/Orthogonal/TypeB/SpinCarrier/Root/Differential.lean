module

public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.Differential
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Tangent
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.Tangent
public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.BaseChange
public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.IntegralMatrix
import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent

/-!
# Integral root differentials of the type-B spin carrier

The `2(n + 1)` numbered root-subgroup differentials of the integral full-weight type-`Bₙ₊₁` spin
carrier send the additive unit tangent vector to the integral matrix of the represented root
generator. Each differential is injective, and its image is the line generated by that normalized
vector, with values in every commutative ring, including nonreduced rings. Coefficient change
preserves the normalization.

These are the equations that compare the root parametrizations of the carrier with the root
vectors of a pinning. Nothing here asserts that these lines exhaust the adjoint weight spaces,
that the weight torus is maximal, or that the carrier has a Borel subgroup or a pinning; nor is
the carrier identified with an independently pinned simply connected group scheme of type
`Bₙ₊₁`.

## Main results

* `TauCeti.TypeBSpinCarrier.tangentMatrix_derivationComp_rootSubgroup`: the differential of a
  numbered root subgroup is the tangent parameter times the integral root matrix.
* `TauCeti.TypeBSpinCarrier.rootVector`: the normalized root vector, with
  `TauCeti.TypeBSpinCarrier.tangentMatrix_rootVector` and
  `TauCeti.TypeBSpinCarrier.range_derivationCompLieHom_rootSubgroup_eq_span`.

## References

* J. S. Milne, *Algebraic Groups* (2017), §10.a and §21.1.
* B. Conrad, *Reductive Group Schemes* (2014), §5.1.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1–2.
-/

-- The matrix calculation is the general Kostant root-subgroup tangent theorem of
-- `TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Tangent`; the root-vector
-- interface follows the type-`D` spin carrier in
-- `TauCeti.Algebra.Lie.Orthogonal.TypeD.SpinCarrier.Root.Differential`.

public section

open TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.TypeBSpinCarrier

universe v

noncomputable section

-- Use the algebra-induced integer module consistently for the counit coefficient synonyms.
attribute [local instance high] Algebra.toModule

variable (n : ℕ) {B : Type v} [CommRing B]

/-- The differential of a numbered integral root subgroup is its integral root matrix multiplied
by the additive tangent parameter, over every coefficient ring. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem tangentMatrix_derivationComp_rootSubgroup (k : Fin (n + 1) ⊕ Fin (n + 1))
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    GeneralLinear.tangentMatrix (dimension n)
        (HopfIdeal.quotientLieHom (B := B) (definingIdeal n)
          (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n k).hom d)) =
      AdditiveGroup.gaTangentLinearEquiv d • (rootIntMatrix n k).map (Int.cast : ℤ → B) := by
  have hcomp : (rootSubgroupIntegralCoordinateMap n k).hom.comp
      (Bialgebra.Quotient.mkBialgHom (definingIdeal n).toIdeal) =
      (kostantRootSubgroupCoordinateMap
        (TauCeti.typeBSimpleRootGeneratorFamily (K := ℚ))
        (TauCeti.typeBSimpleCorootGenerator (K := ℚ)) (rep n) (lattice n).toAddSubgroup
        (rep_kostantForm_mem_lattice n) k (isNilpotent_rep_rootGenerator n k)
        (latticeBasis n)).hom := by
    rw [← CommHopfAlgCat.hom_mkQuotient, ← CommHopfAlgCat.hom_comp,
      mkQuotient_comp_rootSubgroupIntegralCoordinateMap]
  rw [HopfIdeal.quotientLieHom_apply, ← LinearMap.comp_apply, ← derivationComp_comp, hcomp]
  simpa only [rootIntMatrix_eq_toMatrix, algebraMap_int_eq, Int.coe_castRingHom] using
    tangentMatrix_derivationComp_kostantRootSubgroupCoordinateMap
      (TauCeti.typeBSimpleRootGeneratorFamily (K := ℚ))
      (TauCeti.typeBSimpleCorootGenerator (K := ℚ)) (rep n) (lattice n).toAddSubgroup
      (rep_kostantForm_mem_lattice n) k (isNilpotent_rep_rootGenerator n k)
      (latticeBasis n) d

/-- Every numbered integral root-subgroup differential is injective, including when its
coefficient ring has nilpotents. -/
theorem derivationComp_rootSubgroup_injective (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    Function.Injective
      (derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n k).hom) :=
  derivationComp_injective_of_surjective _ (rootSubgroupIntegralCoordinateMap_surjective n k)

/-- The normalized root vector of the integral type-`Bₙ₊₁` spin carrier, with values in `B`, is
the image of the additive unit tangent vector under its numbered root-subgroup differential. -/
def rootVector (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    Derivation ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (dimension n) ⧸
        (definingIdeal n).toIdeal)
      (Bialgebra.CounitAlgebra ℤ (GeneralLinear.coordinateHopfAlgebra ℤ (dimension n) ⧸
        (definingIdeal n).toIdeal) B) :=
  derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n k).hom
    ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1)

/-- The normalized root vector is the differential of the numbered root subgroup at the additive
unit tangent vector. -/
theorem rootVector_def (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    rootVector n (B := B) k =
      derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n k).hom
        ((AdditiveGroup.gaTangentLinearEquiv (R := ℤ) (B := B)).symm 1) := by
  rw [rootVector]

/-- The matrix of a normalized root vector is its integral root matrix. -/
@[simp]
theorem tangentMatrix_rootVector (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    GeneralLinear.tangentMatrix (dimension n)
        (HopfIdeal.quotientLieHom (B := B) (definingIdeal n) (rootVector n (B := B) k)) =
      (rootIntMatrix n k).map (Int.cast : ℤ → B) := by
  rw [rootVector_def, tangentMatrix_derivationComp_rootSubgroup, LinearEquiv.apply_symm_apply,
    one_smul]

/-- The differential with additive parameter `c` is `c` times the normalized root vector. -/
theorem derivationComp_rootSubgroup_eq_smul_rootVector (k : Fin (n + 1) ⊕ Fin (n + 1))
    (d : Derivation ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ)
      (Bialgebra.CounitAlgebra ℤ (AdditiveGroup.coordinateHopfAlgebra ℤ) B)) :
    derivationComp (B := B) (rootSubgroupIntegralCoordinateMap n k).hom d =
      AdditiveGroup.gaTangentLinearEquiv d • rootVector n (B := B) k :=
  AdditiveGroup.derivationComp_eq_smul _ d

/-- Coefficient change preserves the normalized integral root vector. -/
-- Match before simplification changes the counit-indexed integer module structure.
@[simp↓]
theorem mapValue_rootVector {C : Type*} [CommRing C] (φ : B →ₐ[ℤ] C)
    (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    Derivation.mapValue φ (rootVector n (B := B) k) = rootVector n (B := C) k :=
  AdditiveGroup.mapValue_derivationComp_gaTangentLinearEquiv_symm_one φ _

/-- The image of each root-subgroup differential is precisely its normalized root line. -/
theorem range_derivationCompLieHom_rootSubgroup_eq_span (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    (derivationCompLieHom (B := B)
        (rootSubgroupIntegralCoordinateMap n k).hom).range.toSubmodule =
      B ∙ rootVector n (B := B) k :=
  AdditiveGroup.range_derivationCompLieHom_eq_span B _

/-- A normalized root vector is nonzero over every nontrivial coefficient ring. -/
theorem rootVector_ne_zero [Nontrivial B] (k : Fin (n + 1) ⊕ Fin (n + 1)) :
    rootVector n (B := B) k ≠ 0 :=
  -- Use the lemma directly: simplification changes the inherited integer module in the zero
  -- derivation before the statement can match.
  AdditiveGroup.derivationComp_gaTangentLinearEquiv_symm_one_ne_zero _
    (derivationComp_rootSubgroup_injective n (B := B) k)

end

end TauCeti.TypeBSpinCarrier
