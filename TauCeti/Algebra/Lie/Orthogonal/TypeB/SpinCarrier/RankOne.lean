module

public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.IntegralMatrix
public import TauCeti.Algebra.Lie.Sl2.Integration
import TauCeti.Algebra.Lie.Sl2.SquareZero
import Mathlib.LinearAlgebra.Matrix.Integer

/-!
# Rank-one maps in the type-B spin carrier

Each numbered opposite simple-root pair on the full-weight spin module integrates to an
explicit map from `SL₂` into the general linear group. The construction uses the square-zero
root operators and their integral matrix-unit relations, so its matrix formula and its two
root-parameter and simple-coroot equations hold over every commutative ring, including in
characteristic two. Over a field the map lands in the spin carrier, and its image is exactly
the subgroup generated by the two numbered root families.

The field hypothesis is used only for generation of `SL₂` by transvections; no arbitrary-ring
carrier containment or identification with an independently pinned group scheme is asserted.

## Main declarations

* `rankOneMatrix`: the matrix-valued map over a commutative ring.
* `rankOneMatrix_diag2nUnit`: the diagonal maps to the numbered simple-coroot value.
* `rankOnePoints`: its corestriction to the spin carrier over a field.
* `range_rankOnePoints`: the image is the subgroup generated by the opposite root families.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.

The construction uses `TauCeti.Sl2.squareZeroSL2Hom` and the endpoint projection calculation
from `TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Torus.SquareZeroCoroot`.
The transvection-generation argument follows `TauCeti.Algebra.Lie.E7.Minuscule.RankOne`.
-/

public section

open scoped MatrixGroups

namespace TauCeti.TypeBSpinCarrier

open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

noncomputable section

variable (n : ℕ)

private abbrev rootAction (j : Fin (n + 1) ⊕ Fin (n + 1)) :=
  rep n (_root_.UniversalEnvelopingAlgebra.ι ℚ (TauCeti.typeBSimpleRootGeneratorFamily j))

-- Compute the endpoint identities over ℚ, then restrict to the invariant lattice before
-- reducing coefficients. In particular no division by two occurs in the value ring.
private theorem rootAction_endpoint_relations (i : Fin (n + 1)) :
    rootAction n (.inl i) * rootAction n (.inr i) * rootAction n (.inl i) =
        rootAction n (.inl i) ∧
      rootAction n (.inr i) * rootAction n (.inl i) * rootAction n (.inr i) =
        rootAction n (.inr i) := by
  let := HasUniqueDiv.of_module_rat
    (Module.End ℚ (ExteriorAlgebra ℚ (polarization n).W))
  have t := isSl2Triple_rep_rootGenerator n i
  constructor
  · exact Sl2.e_mul_f_mul_e_of_mul_self_eq_zero
      (IsSMulRegular.nat_of_hasUniqueDiv (by decide : (2 : ℕ) ≠ 0))
      (by simpa only [pow_two] using pow_two_rep_rootGenerator_eq_zero n (.inl i))
      (by simpa only [LieRing.of_associative_ring_bracket] using t.lie_e_f)
      (by simpa only [LieRing.of_associative_ring_bracket] using t.lie_h_e_nsmul)
  · exact Sl2.f_mul_e_mul_f_of_mul_self_eq_zero
      (IsSMulRegular.nat_of_hasUniqueDiv (by decide : (2 : ℕ) ≠ 0))
      (by simpa only [pow_two] using pow_two_rep_rootGenerator_eq_zero n (.inr i))
      (by simpa only [LieRing.of_associative_ring_bracket] using t.lie_e_f)
      (by simpa only [LieRing.of_associative_ring_bracket] using t.lie_h_f_nsmul)

private abbrev rootOp (j : Fin (n + 1) ⊕ Fin (n + 1)) :=
  kostantRootOperator
    (TauCeti.typeBSimpleRootGeneratorFamily (K := ℚ))
    (TauCeti.typeBSimpleCorootGenerator (K := ℚ)) (rep n) (lattice n).toAddSubgroup
    (rep_kostantForm_mem_lattice n) j

private theorem rootOp_mul_self (j : Fin (n + 1) ⊕ Fin (n + 1)) :
    rootOp n j * rootOp n j = 0 := by
  have h := pow_two_rep_rootGenerator_eq_zero n j
  rw [pow_two] at h
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  simpa only [rootOp, mul_apply_eq_comp, coe_kostantRootOperator_apply,
    LinearMap.zero_apply, ZeroMemClass.coe_zero] using congrArg (fun f ↦ f (v : _)) h

private theorem rootIntMatrix_mul_self (j : Fin (n + 1) ⊕ Fin (n + 1)) :
    rootIntMatrix n j * rootIntMatrix n j = 0 := by
  simpa only [rootIntMatrix_eq_toMatrix, LinearMap.toMatrix_mul, rootOp,
    map_zero] using
    congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n)) (rootOp_mul_self n j)

private theorem rootOp_inl_mul_inr_mul_inl (i : Fin (n + 1)) :
    rootOp n (.inl i) * rootOp n (.inr i) * rootOp n (.inl i) = rootOp n (.inl i) := by
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  simpa only [rootOp, rootAction, mul_apply_eq_comp, coe_kostantRootOperator_apply] using
    congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W))
      (rootAction_endpoint_relations n i).1

private theorem rootOp_inr_mul_inl_mul_inr (i : Fin (n + 1)) :
    rootOp n (.inr i) * rootOp n (.inl i) * rootOp n (.inr i) = rootOp n (.inr i) := by
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  simpa only [rootOp, rootAction, mul_apply_eq_comp, coe_kostantRootOperator_apply] using
    congrArg (fun f ↦ f (v : ExteriorAlgebra ℚ (polarization n).W))
      (rootAction_endpoint_relations n i).2

private theorem rootIntMatrix_inl_mul_inr_mul_inl (i : Fin (n + 1)) :
    rootIntMatrix n (.inl i) * rootIntMatrix n (.inr i) * rootIntMatrix n (.inl i) =
      rootIntMatrix n (.inl i) := by
  simpa only [rootIntMatrix_eq_toMatrix, LinearMap.toMatrix_mul, rootOp] using
    congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n))
      (rootOp_inl_mul_inr_mul_inl n i)

private theorem rootIntMatrix_inr_mul_inl_mul_inr (i : Fin (n + 1)) :
    rootIntMatrix n (.inr i) * rootIntMatrix n (.inl i) * rootIntMatrix n (.inr i) =
      rootIntMatrix n (.inr i) := by
  simpa only [rootIntMatrix_eq_toMatrix, LinearMap.toMatrix_mul, rootOp] using
    congrArg (LinearMap.toMatrix (latticeBasis n) (latticeBasis n))
      (rootOp_inr_mul_inl_mul_inr n i)

private theorem rootAction_endpoint_projections_apply (i : Fin (n + 1))
    (a : Fin (dimension n)) :
    (rootAction n (.inl i) * rootAction n (.inr i)) (latticeBasis n a :
        ExteriorAlgebra ℚ (polarization n).W) =
        (if basisWeight n a i = 1 then (latticeBasis n a :
          ExteriorAlgebra ℚ (polarization n).W) else 0) ∧
      (rootAction n (.inr i) * rootAction n (.inl i)) (latticeBasis n a :
        ExteriorAlgebra ℚ (polarization n).W) =
        (if basisWeight n a i = -1 then (latticeBasis n a :
          ExteriorAlgebra ℚ (polarization n).W) else 0) := by
  let := HasUniqueDiv.of_module_rat (ExteriorAlgebra ℚ (polarization n).W)
  have t := isSl2Triple_rep_rootGenerator n i
  have hw := (isCartanWeightVector_iff
    (TauCeti.typeBSimpleCorootGenerator (K := ℚ)) (rep n)).1
      (isCartanWeightVector_latticeBasis n a) i
  have hv : ((latticeBasis n a : (lattice n).toAddSubgroup) :
      ExteriorAlgebra ℚ (polarization n).W) ≠ 0 := by
    simpa only [ne_eq, ZeroMemClass.coe_eq_zero] using (latticeBasis n).ne_zero a
  rcases Sl2.mul_apply_of_eq_zsmul
      (by simpa only [pow_two] using pow_two_rep_rootGenerator_eq_zero n (.inl i))
      (by simpa only [pow_two] using pow_two_rep_rootGenerator_eq_zero n (.inr i))
      (rootAction_endpoint_relations n i).1 (rootAction_endpoint_relations n i).2
      (by simpa only [LieRing.of_associative_ring_bracket] using t.lie_e_f)
      (by simpa only [Int.cast_smul_eq_zsmul] using hw) hv with
    ⟨hm, hP, hQ⟩ | ⟨hm, hP, hQ⟩ | ⟨hm, hP, hQ⟩
  all_goals
    simp only [hm, Int.reduceEq, ↓reduceIte]
    exact ⟨hP, hQ⟩

private theorem rootOp_endpoint_projections_apply (i : Fin (n + 1))
    (a : Fin (dimension n)) :
    (rootOp n (.inl i) * rootOp n (.inr i)) (latticeBasis n a) =
        (if basisWeight n a i = 1 then latticeBasis n a else 0) ∧
      (rootOp n (.inr i) * rootOp n (.inl i)) (latticeBasis n a) =
        (if basisWeight n a i = -1 then latticeBasis n a else 0) := by
  constructor <;> apply Subtype.ext
  · simpa only [rootOp, rootAction, mul_apply_eq_comp, coe_kostantRootOperator_apply,
      apply_ite, ZeroMemClass.coe_zero] using (rootAction_endpoint_projections_apply n i a).1
  · simpa only [rootOp, rootAction, mul_apply_eq_comp, coe_kostantRootOperator_apply,
      apply_ite, ZeroMemClass.coe_zero] using (rootAction_endpoint_projections_apply n i a).2

private theorem rootIntMatrix_endpoint_projections (i : Fin (n + 1)) :
    rootIntMatrix n (.inl i) * rootIntMatrix n (.inr i) =
        Matrix.diagonal (fun a ↦ if basisWeight n a i = 1 then 1 else 0) ∧
      rootIntMatrix n (.inr i) * rootIntMatrix n (.inl i) =
        Matrix.diagonal (fun a ↦ if basisWeight n a i = -1 then 1 else 0) := by
  constructor
  all_goals
    simp only [rootIntMatrix_eq_toMatrix, ← LinearMap.toMatrix_mul]
    ext a b
    simp only [LinearMap.toMatrix_apply, Matrix.diagonal_apply]
    have hP := (rootOp_endpoint_projections_apply n i b).1
    have hQ := (rootOp_endpoint_projections_apply n i b).2
    simp only [rootOp] at hP hQ
    simp only [hP, hQ, apply_ite, map_zero, Module.Basis.repr_self]
    clear hP hQ
    split_ifs <;> simp_all

variable (A : Type*) [CommRing A] (i : Fin (n + 1))

/-- The explicit rank-one action on the spin module at node `i`, over an arbitrary commutative
ring. Its root operators are the reductions of the integral spin matrices. -/
def rankOneMatrix : SL(2, A) →* GL (Fin (dimension n)) A :=
  Sl2.squareZeroSL2Hom
    ((rootIntMatrix n (.inl i)).map (Int.cast : ℤ → A))
    ((rootIntMatrix n (.inr i)).map (Int.cast : ℤ → A))
    (by rw [← Matrix.map_mul_intCast, rootIntMatrix_mul_self]; simp)
    (by rw [← Matrix.map_mul_intCast, rootIntMatrix_mul_self]; simp)
    (by rw [← Matrix.map_mul_intCast, ← Matrix.map_mul_intCast,
      rootIntMatrix_inl_mul_inr_mul_inl])
    (by rw [← Matrix.map_mul_intCast, ← Matrix.map_mul_intCast,
      rootIntMatrix_inr_mul_inl_mul_inr])

/-- The four-entry formula for the rank-one action. It is the identity off the two endpoint
idempotents `EF` and `FE`. -/
theorem coe_rankOneMatrix (g : SL(2, A)) :
    (rankOneMatrix n A i g : Matrix (Fin (dimension n)) (Fin (dimension n)) A) =
      1 + (g 0 0 - 1) •
          ((rootIntMatrix n (.inl i)).map (Int.cast : ℤ → A) *
            (rootIntMatrix n (.inr i)).map (Int.cast : ℤ → A)) +
        g 0 1 • (rootIntMatrix n (.inl i)).map (Int.cast : ℤ → A) +
        g 1 0 • (rootIntMatrix n (.inr i)).map (Int.cast : ℤ → A) +
        (g 1 1 - 1) •
          ((rootIntMatrix n (.inr i)).map (Int.cast : ℤ → A) *
            (rootIntMatrix n (.inl i)).map (Int.cast : ℤ → A)) :=
  Sl2.coe_squareZeroSL2Hom _ _ _ _ _ _ g

/-- The upper transvection has the numbered positive-root parameter. -/
@[simp]
theorem rankOneMatrix_upper_transvection (t : A) :
    rankOneMatrix n A i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        (rootSubgroupPoints n (.inl i) A (Multiplicative.ofAdd t) :
          GL (Fin (dimension n)) A) := by
  apply Units.ext
  rw [rankOneMatrix, Sl2.coe_squareZeroSL2Hom_upper,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd]

/-- The lower transvection has the numbered negative-root parameter. -/
@[simp]
theorem rankOneMatrix_lower_transvection (t : A) :
    rankOneMatrix n A i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        (rootSubgroupPoints n (.inr i) A (Multiplicative.ofAdd t) :
          GL (Fin (dimension n)) A) := by
  apply Units.ext
  rw [rankOneMatrix, Sl2.coe_squareZeroSL2Hom_lower,
    coe_rootSubgroupPoints_eq_one_add_smul, toAdd_ofAdd]

/-- The diagonal of `SL₂` maps to the numbered simple-coroot value of the spin weight torus.
This equation holds before imposing any field hypothesis. -/
@[simp]
theorem rankOneMatrix_diag2nUnit (u : Aˣ) :
    rankOneMatrix n A i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) =
        (weightTorusPoints n A (Pi.mulSingle i u) : GL (Fin (dimension n)) A) := by
  apply Units.ext
  rw [rankOneMatrix, Sl2.coe_squareZeroSL2Hom_diagonal,
    ← Matrix.map_mul_intCast, ← Matrix.map_mul_intCast,
    (rootIntMatrix_endpoint_projections n i).1, (rootIntMatrix_endpoint_projections n i).2,
    coe_weightTorusPoints, kostantTorusMatrix_apply, diagGL_coe]
  ext a b
  simp only [Matrix.diagonal_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.one_apply, Matrix.map_apply]
  by_cases hab : a = b
  · subst b
    rw [torusCharacter_mulSingle]
    rcases DynkinType.typeBSpinWeight_apply_eq_neg_one_or_eq_zero_or_eq_one
      (signSet n a) i with h | h | h <;>
      simp_all [basisWeight]
  · simp [hab]

variable (K : Type*) [Field K]

private theorem rankOneMatrix_mem_of_root_mem {H : Subgroup (GL (Fin (dimension n)) K)}
    (hinl : ∀ t : K, (rootSubgroupPoints n (.inl i) K (Multiplicative.ofAdd t) :
      GL (Fin (dimension n)) K) ∈ H)
    (hinr : ∀ t : K, (rootSubgroupPoints n (.inr i) K (Multiplicative.ofAdd t) :
      GL (Fin (dimension n)) K) ∈ H)
    (g : SL(2, K)) : rankOneMatrix n K i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [rankOneMatrix_upper_transvection]; exact hinl t
    · rw [rankOneMatrix_lower_transvection]; exact hinr t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using H.mul_mem hg hh

/-- Over a field, the rank-one action lands in the type-B spin carrier. -/
def rankOnePoints : SL(2, K) →* points n K :=
  (rankOneMatrix n K i).codRestrict (points n K)
    (rankOneMatrix_mem_of_root_mem n i K
      (fun t ↦ (rootSubgroupPoints n (.inl i) K (Multiplicative.ofAdd t)).property)
      (fun t ↦ (rootSubgroupPoints n (.inr i) K (Multiplicative.ofAdd t)).property))

/-- The carrier-valued rank-one map has the explicit matrix action as its underlying matrix. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints n i K g : GL (Fin (dimension n)) K) = rankOneMatrix n K i g :=
  (rfl)

/-- The upper transvection maps to the positive-root point with its original parameter. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints n i K (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
        rootSubgroupPoints n (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneMatrix_upper_transvection n K i t

/-- The lower transvection maps to the negative-root point with its original parameter. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints n i K (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
        rootSubgroupPoints n (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  exact rankOneMatrix_lower_transvection n K i t

/-- The diagonal maps to the simple-coroot point with its original unit parameter. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints n i K (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints n K (Pi.mulSingle i u) := by
  apply Subtype.ext
  exact rankOneMatrix_diag2nUnit n K i u

/-- The image of the rank-one map is exactly the subgroup generated by the two opposite
numbered root families. -/
theorem range_rankOnePoints :
    (rankOnePoints n i K).range =
      (rootSubgroupPoints n (.inl i) K).range ⊔ (rootSubgroupPoints n (.inr i) K).range := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points n K).subtype_injective,
      Subgroup.subtype_apply, coe_rankOnePoints]
    apply rankOneMatrix_mem_of_root_mem n i K
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.mem_sup_left ⟨_, rfl⟩, rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.mem_sup_right ⟨_, rfl⟩, rfl⟩
  · apply sup_le
    · rintro _ ⟨t, rfl⟩
      exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), by simp⟩
    · rintro _ ⟨t, rfl⟩
      exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), by simp⟩

end

end TauCeti.TypeBSpinCarrier
