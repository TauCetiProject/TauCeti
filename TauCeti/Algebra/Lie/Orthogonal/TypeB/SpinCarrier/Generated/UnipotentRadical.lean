module

public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.StandardComodule
public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Smooth
public import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.Faithful
import TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.BaseChange

/-!
# Normal smooth unipotent subgroups of the generated type-Bₙ₊₁ spin subgroup

Over a field, the subgroup of `GL_(2^(n+1))` generated by the numbered type-`Bₙ₊₁` spin root
subgroups and weight torus has no nontrivial normal smooth unipotent closed subgroup. Since every
candidate for the unipotent radical is such a subgroup, its unipotent radical is trivial. Over an
algebraically closed field, its faithful simple spin representation supplies the
representation-theoretic input, and its coordinate algebra is reduced because its generators are
reduced. Generation commutes with field extension, so the general case follows by extending
scalars to an algebraic closure and descending the equality of Hopf ideals. Unlike the
corresponding statement for the specialization of the integral carrier, no reducedness hypothesis
remains.

Together with the smoothness and geometric connectedness of the same subgroup, this gives every
ingredient of reductivity for the generated subgroup. The result concerns the subgroup generated
over the field, not the base change of the integral spin carrier; an identification of those two
subgroup schemes is needed to transfer it to that carrier.

## Main results

* `TauCeti.TypeBSpinCarrier.eq_augmentation_generated_of_isNormal_of_smoothUnipotent`: every
  normal smooth unipotent closed subgroup of the generated subgroup is trivial.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.
* J. C. Jantzen, *Representations of Algebraic Groups*, I.2 and II.2.

The argument follows the generated type-`E₆` minuscule subgroup in
`TauCeti.Algebra.Lie.E6.Minuscule.Generated.UnipotentRadical`, using the generic
faithful-comodule elimination theorem and the generic descent along field extensions in
`TauCeti.Algebra.AlgebraicGroup.Unipotent.Radical.BaseChange`.
-/

public section

namespace TauCeti.TypeBSpinCarrier

universe u

noncomputable section

variable (n : ℕ) (k : Type u) [Field k]

attribute [local instance] generatedStandardComodule

/-- Every normal smooth unipotent closed subgroup of the subgroup generated over a field by the
type-`Bₙ₊₁` spin root subgroups and weight torus is trivial.

The conclusion is stated contravariantly: the subgroup's defining Hopf ideal is the augmentation
ideal of the generated subgroup's coordinate algebra. -/
theorem eq_augmentation_generated_of_isNormal_of_smoothUnipotent
    (I : HopfIdeal k (generatedCoordinateHopfAlgebra n k)) (hI : I.IsNormal)
    (hU : smoothUnipotentCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.quotient
        (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n k)) I)) :
    I = HopfIdeal.augmentation k (generatedCoordinateHopfAlgebra n k) := by
  let K := AlgebraicClosure k
  let _ := isReduced_generatedCoordinateHopfAlgebra n K
  refine HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_baseChange K
    (H := FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n k))
    (fun J hJ hUJ ↦ ?_) I hI hU
  exact HopfIdeal.eq_augmentation_of_isNormal_of_smoothUnipotent_of_isFaithful_of_iso K
    (FiniteTypeCommHopfAlgCat.of K (generatedCoordinateHopfAlgebra n K)) (Fin (dimension n) → K)
    _ (generatedCoordinateHopfAlgebraBaseChangeIso n k K).symm
    Comodule.isCompletelyReducible_of_isSimpleOrder (isFaithful_generatedStandardComodule n K)
    J hJ hUJ

end

end TauCeti.TypeBSpinCarrier
