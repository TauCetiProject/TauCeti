module

public import TauCeti.Algebra.AlgebraicGroup.Connected.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.Reductive.Basic
public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Connected
public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.UnipotentRadical
import Mathlib.RingTheory.Etale.Descent

/-!
# Reductivity of the generated type-Bₙ₊₁ spin subgroup

Over every field `k`, the closed subgroup of `GL_(2^(n+1))` generated by the numbered type-`Bₙ₊₁`
spin root subgroups and the weight torus is reductive: it is smooth and geometrically connected,
and after extension to an algebraic closure it has no nontrivial connected normal smooth
unipotent closed subgroup.

Since generation commutes with field extension
(`TauCeti.TypeBSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeIso`), the geometric fibre is
the subgroup generated over the algebraic closure. Over an algebraically closed field that
subgroup is smooth, connected, and its faithful simple spin representation eliminates every
normal smooth unipotent closed subgroup. Smoothness and geometric connectedness then descend to
`k`.

The result concerns the subgroup generated over `k`, not the base change of the integral spin
carrier, which contains it. Nor is the generated subgroup identified with the pinned simply
connected group scheme of type `Bₙ₊₁`; constructions on it transfer to that group only along such
an identification.

## Main results

* `TauCeti.TypeBSpinCarrier.reductiveCommHopfAlgProperty_generatedCoordinateHopfAlgebra`: the
  generated type-`Bₙ₊₁` spin subgroup is reductive over every field.

## References

* J. S. Milne, *Algebraic Groups* (2017), §2.h and Chapter 19.
* J. E. Humphreys, *Linear Algebraic Groups*, §§19 and 26.

The argument follows the short-root type-`G₂` carrier in
`TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Reductive`.
-/

public section

open CategoryTheory
open scoped TensorProduct

namespace TauCeti.TypeBSpinCarrier

universe u

variable (n : ℕ) (k : Type u) [Field k]

/-- **The generated type-`Bₙ₊₁` spin subgroup is reductive over every field.** The closed subgroup
of `GL_(2^(n+1))` generated over `k` by the numbered spin root subgroups and the weight torus is
smooth and geometrically connected, with no nontrivial connected normal smooth unipotent closed
subgroup after extension to an algebraic closure. -/
theorem reductiveCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    reductiveCommHopfAlgProperty k
      (FiniteTypeCommHopfAlgCat.of k (generatedCoordinateHopfAlgebra n k)) := by
  let K := AlgebraicClosure k
  let e := generatedCoordinateHopfAlgebraBaseChangeIso.{u, u} n k K
  have hsmooth : smoothCommHopfAlgProperty K
      (CommHopfAlgCat.baseChange (K := K) (generatedCoordinateHopfAlgebra n k)) :=
    (smoothCommHopfAlgProperty K).prop_of_iso e.symm
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra n K)
  -- `baseChange` bundles the tensor product; `coe_of` identifies its underlying algebra.
  let _ : Algebra.Smooth K (K ⊗[k] generatedCoordinateHopfAlgebra n k) := by
    simpa only [CommHopfAlgCat.baseChange, _root_.CommHopfAlgCat.coe_of] using
      (smoothCommHopfAlgProperty_iff _).mp hsmooth
  exact reductiveCommHopfAlgProperty_of_geometricFiber_iso k _
    (FiniteTypeCommHopfAlgCat.of K (generatedCoordinateHopfAlgebra n K))
    (Algebra.Smooth.of_smooth_tensorProduct_of_faithfullyFlat
      (R := k) (S := generatedCoordinateHopfAlgebra n k) K)
    (geometricallyConnectedCommHopfAlgProperty.of_baseChange k K _
      ((geometricallyConnectedCommHopfAlgProperty K).prop_of_iso e.symm
        (geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra n K)))
    (ObjectProperty.isoMk _ e)
    (eq_augmentation_generated_of_isNormal_of_smoothUnipotent n K)

end TauCeti.TypeBSpinCarrier
