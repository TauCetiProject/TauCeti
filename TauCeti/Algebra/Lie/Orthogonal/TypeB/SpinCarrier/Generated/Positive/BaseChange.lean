module

public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Positive.Basic

/-!
# Free base change of the generated positive spin subgroup

The closed subgroup generated by the positive numbered type-B spin root subgroups and the
weight torus commutes with free scalar extension, including every field extension. Its
coordinate-algebra comparison respects both the ambient general-linear inclusion and the
inclusion into the full generated spin carrier. In particular, its defining ideal inside the
full carrier transports to the defining ideal of the positive subgroup generated over the
extension. This identifies the positive subgroup on geometric fibres for Borel recognition.

Freeness is needed for base change of the common-kernel Hopf ideal. The result concerns
generation over each ground ring; it does not identify these groups with specializations of
the integral toral closure.

## References

* B. Conrad, *Reductive Group Schemes*, §1.
* J. E. Humphreys, *Linear Algebraic Groups*, §§26–28.

The construction follows the positive Geck comparison in
`SimplyConnectedRootDatum.GeckLattice.Positive.Generated.BaseChange`,
using the full spin-carrier generator comparisons in `Generated.Basic` and the common-kernel
and quotient-transport constructions in `TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange`.
-/

public section

open CategoryTheory

namespace TauCeti.TypeBSpinCarrier.Generated.Positive

universe v w

noncomputable section

variable (n : ℕ) (k : Type v) (K : Type max v w)
  [CommRing k] [CommRing K] [Algebra k K] [Module.Free k K]

/-- Free scalar extension carries the positive generated defining ideal onto its counterpart
over the extension ring, through the ambient general-linear comparison. -/
theorem map_baseChangeHopfIdeal_definingIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (definingIdeal n k)).map
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom.hom =
      definingIdeal n K := by
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_commonKernelHopfIdeal
    (generator n k) (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n))
    (fun j ↦ TypeBSpinCarrier.generatorCoordinateAlgebraBaseChangeIso n k K (match j with
      | .inl i => .inl (.inl i)
      | .inr u => .inr u))
    (generator n K)
  rintro (i | u)
  · simpa only [generator_inl] using
      TypeBSpinCarrier.generatorCoordinateMap_baseChange n k K (.inl (.inl i))
  · cases u
    simpa only [generator_inr] using
      TypeBSpinCarrier.generatorCoordinateMap_baseChange n k K (.inr ())

/-- The scalar extension of the positive generated coordinate Hopf algebra is the coordinate
Hopf algebra of the positive subgroup generated over the extension ring. -/
def coordinateHopfAlgebraBaseChangeIso :
    CommHopfAlgCat.baseChange (K := K) (coordinateHopfAlgebra n k) ≅
      coordinateHopfAlgebra n K :=
  CommHopfAlgCat.quotientBaseChangeIsoOfMapEq (definingIdeal n k) (definingIdeal n K)
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n))
    (map_baseChangeHopfIdeal_definingIdeal n k K)

/-- The positive-subgroup comparison respects the closed inclusions into the general linear
group. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_mkQuotient_comp_baseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K)
        (CommHopfAlgCat.mkQuotient _ (definingIdeal n k)) ≫
        (coordinateHopfAlgebraBaseChangeIso n k K).hom =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso k K (dimension n)).hom ≫
        CommHopfAlgCat.mkQuotient _ (definingIdeal n K) :=
  CommHopfAlgCat.baseChangeMap_mkQuotient_comp_quotientBaseChangeIsoOfMapEq_hom _ _ _
    (map_baseChangeHopfIdeal_definingIdeal n k K)

/-- The positive-subgroup comparison respects restriction of coordinates from the full
generated spin carrier. -/
@[reassoc (attr := simp)]
theorem baseChangeMap_restriction_comp_baseChangeIso_hom :
    CommHopfAlgCat.baseChangeMap (K := K) (restriction n k) ≫
        (coordinateHopfAlgebraBaseChangeIso n k K).hom =
      (TypeBSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeIso n k K).hom ≫
        restriction n K := by
  let _ : Epi (CommHopfAlgCat.baseChangeMap (K := K)
      (TypeBSpinCarrier.generatedCoordinateMap n k)) :=
    ConcreteCategory.epi_of_surjective _ (CommHopfAlgCat.baseChangeMap_surjective
      (TypeBSpinCarrier.generatedCoordinateMap n k)
      (TypeBSpinCarrier.generatedCoordinateMap_surjective n k))
  apply (cancel_epi (CommHopfAlgCat.baseChangeMap (K := K)
    (TypeBSpinCarrier.generatedCoordinateMap n k))).mp
  rw [← Category.assoc, ← (CommHopfAlgCat.baseChangeFunctor (K := K)).map_comp,
    generatedCoordinateMap_comp_restriction,
    baseChangeMap_mkQuotient_comp_baseChangeIso_hom,
    ← Category.assoc,
    baseChangeMap_generatedCoordinateMap_comp_generatedCoordinateHopfAlgebraBaseChangeIso_hom,
    Category.assoc, generatedCoordinateMap_comp_restriction]

/-- The positive subgroup's intrinsic defining ideal commutes with free scalar extension,
through the comparison of full generated spin carriers. -/
theorem map_baseChangeHopfIdeal_carrierDefiningIdeal :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := K) (carrierDefiningIdeal n k)).map
        (TypeBSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeIso n k K).hom.hom =
      carrierDefiningIdeal n K := by
  rw [← kerOfSurjective_restriction, ← kerOfSurjective_restriction]
  apply CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective
    (TypeBSpinCarrier.generatedCoordinateHopfAlgebraBaseChangeIso n k K)
    (coordinateHopfAlgebraBaseChangeIso n k K)
    (restriction_surjective n k) (restriction_surjective n K)
  rw [baseChangeMap_restriction_comp_baseChangeIso_hom, Iso.inv_hom_id_assoc]

end

end TauCeti.TypeBSpinCarrier.Generated.Positive
