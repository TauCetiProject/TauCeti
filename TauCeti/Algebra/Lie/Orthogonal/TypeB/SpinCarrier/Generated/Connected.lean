module

public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.Connected.Generated
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# Connectedness of the generated type-Bₙ₊₁ spin subgroup

The numbered simple-root subgroups and the weight torus of the full-weight type-`Bₙ₊₁` spin
carrier have connected prime spectra over a field, the affine line and a split torus. Over an
algebraically closed field the subgroup they generate is therefore geometrically connected.

Connectedness is one of the two geometric inputs, smoothness being the other, to recognizing this
explicit carrier as a split reductive group of type `Bₙ₊₁`. The result concerns the generated
subgroup; it says nothing about the base change of the integral carrier, which contains it.

## References

* J. S. Milne, *Algebraic Groups* (2017), Propositions 2.37 and 2.48.
* R. Steinberg, *Lectures on Chevalley Groups*, §3.
-/

public section

namespace TauCeti.TypeBSpinCarrier

open CategoryTheory

universe v

variable (n : ℕ) (k : Type v) [Field k]

-- The argument follows the sibling connectedness proofs for the other explicit Chevalley
-- carriers, such as `TauCeti.Algebra.Lie.E7.Minuscule.Generated.Connected`.
private theorem connectedSpace_generatorCoordinateAlgebra :
    ∀ j, ConnectedSpace (PrimeSpectrum (generatorCoordinateAlgebra n k j)) := by
  intro j
  cases j with
  | inl _ => exact AdditiveGroup.connectedSpace_primeSpectrum_coordinateHopfAlgebra k
  | inr _ =>
    exact DiagonalizableGroup.connectedSpace_primeSpectrum_coordinateRing k
      (SplitTorus.characterGroup (Fin (n + 1)))

/-- The subgroup generated by the numbered type-`Bₙ₊₁` spin root subgroups and weight torus is
geometrically connected over an algebraically closed field. -/
theorem geometricallyConnectedCommHopfAlgProperty_generatedCoordinateHopfAlgebra
    [IsAlgClosed k] :
    geometricallyConnectedCommHopfAlgProperty k (generatedCoordinateHopfAlgebra n k) := by
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.geometricallyConnectedCommHopfAlgProperty_commonKernelQuotient
    (generatorCoordinateMap n k) (connectedSpace_generatorCoordinateAlgebra n k)

end TauCeti.TypeBSpinCarrier
