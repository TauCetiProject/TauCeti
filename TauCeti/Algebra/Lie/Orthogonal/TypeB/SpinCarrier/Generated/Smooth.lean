module

public import TauCeti.Algebra.Lie.Orthogonal.TypeB.SpinCarrier.Generated.Basic
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.GeometricallyReduced
import TauCeti.RingTheory.Smooth.GeometricallyReduced
import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.SmoothConnected

/-!
# Smoothness of the generated type-Bₙ₊₁ spin subgroup

The numbered simple-root subgroups and the weight torus of the full-weight type-`Bₙ₊₁` spin
carrier have geometrically reduced coordinate algebras over every field. The finite-type subgroup
they generate is therefore smooth and has reduced coordinate algebra.

Smoothness is one of the two geometric inputs, connectedness being the other, to recognizing this
explicit carrier as a split reductive group of type `Bₙ₊₁`. The result concerns the generated
subgroup; it says nothing about the base change of the integral carrier, which contains it.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26--27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.
-/

public section

namespace TauCeti.TypeBSpinCarrier

open CategoryTheory

universe v

variable (n : ℕ) (k : Type v) [Field k]

-- The argument follows the sibling smoothness proofs for the other explicit Chevalley
-- carriers, such as `TauCeti.Algebra.Lie.E7.Minuscule.Generated.Smooth`.
private theorem isGeometricallyReduced_generatorCoordinateAlgebra :
    ∀ j, Algebra.IsGeometricallyReduced k (generatorCoordinateAlgebra n k j) := by
  intro j
  cases j with
  | inl _ => exact isGeometricallyReduced_of_smooth k _
  | inr _ =>
      exact (DiagonalizableGroup.geometricallyReduced_coordinateRing k
        (SplitTorus.characterGroup (Fin (n + 1)))).isGeometricallyReduced

/-- The subgroup generated by the numbered type-`Bₙ₊₁` spin root subgroups and weight torus is
smooth over every field. -/
theorem smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra :
    smoothCommHopfAlgProperty k (generatedCoordinateHopfAlgebra n k) := by
  let : ∀ j, Algebra.IsGeometricallyReduced k (generatorCoordinateAlgebra n k j) :=
    isGeometricallyReduced_generatorCoordinateAlgebra n k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact
    CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal_of_geometricallyReduced
      (generatorCoordinateMap n k)

/-- The subgroup generated by the numbered type-`Bₙ₊₁` spin root subgroups and weight torus has
reduced coordinate algebra over every field. -/
theorem isReduced_generatedCoordinateHopfAlgebra :
    IsReduced (generatedCoordinateHopfAlgebra n k) := by
  let _ : Algebra.Smooth k (generatedCoordinateHopfAlgebra n k) :=
    (smoothCommHopfAlgProperty_iff _).mp
      (smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra n k)
  exact isReduced_of_smooth k _

end TauCeti.TypeBSpinCarrier
