/-!
# The symplectic Lie algebra generated by transvections

Let `B` be an alternating bilinear form on a module `V`. For `δ : V`, the endomorphism

`N(δ) = (B.flip δ).smulRight δ : x ↦ B x δ • δ`

is skew-adjoint for `B` and squares to zero, so `1 + c • N(δ)` is the symplectic transvection
`LinearMap.transvection (c • B.flip δ) δ`
(`LinearMap.BilinForm.transvection_smul_flip_eq_one_add`), with logarithm `c • N(δ)`. These are
the elements of the symplectic Lie algebra `skewAdjointLieSubalgebra B` that the local monodromy
of a family acquiring an ordinary double point contributes, by the Picard–Lefschetz formula.

The main theorem, `LinearMap.BilinForm.lieSpan_smulRight_flip_eq_skewAdjointLieSubalgebra`, is a
lemma of Deligne: if `B` is nondegenerate on a finite-dimensional vector space `V` and `V` is an
irreducible module for the Lie algebra generated by a family `N(δ i)`, then that Lie algebra is
the whole of `skewAdjointLieSubalgebra B`. The proof works over every field, including those of
characteristic two.

The argument follows Deligne's, with the bracket formula below in place of his conjugation by
the transvections `exp (t • N(δ))`. It runs through the subspaces `U` of `V` with `N(u)` in the
generated Lie algebra `𝔏` for every `u ∈ U`. The bracket `⁅N(a), N(b)⁆` is `B b a` times the
polarization `x ↦ B x b • a + B x a • b` (`LinearMap.BilinForm.lie_smulRight_flip`), so if `U` is
such a subspace, `N(b) ∈ 𝔏` and `B u b ≠ 0` for some `u ∈ U`, then `U ⊔ K ∙ b` is again such a
subspace. A maximal such `U` is therefore stable under every generator `N(δ i)`: either
`δ i ⊥ U`, and `N(δ i)` kills `U`, or `δ i ∈ U`. Irreducibility forces `U = V`, and the `N(v)`
for `v ∈ V` span the skew-adjoint endomorphisms
(`LinearMap.BilinForm.span_smulRight_flip_eq_skewAdjointSubmodule`).

## Main results

* `LinearMap.BilinForm.transvection_smul_flip_eq_one_add`: the transvection
  `LinearMap.transvection (c • B.flip δ) δ` is `1 + c • N(δ)`.
* `LinearMap.BilinForm.smulRight_flip_mem_skewAdjointSubmodule`: `N(δ)` is skew-adjoint.
* `LinearMap.BilinForm.smulRight_flip_mul_self`: `N(δ) * N(δ) = 0`.
* `LinearMap.BilinForm.smulRight_flip_smul`: `N(t • δ) = (t * t) • N(δ)`.
* `LinearMap.BilinForm.smulRight_flip_add`: `N(a + b)` is `N(a) + N(b)` plus the polarization
  `x ↦ B x b • a + B x a • b`.
* `LinearMap.BilinForm.lie_smulRight_flip`: the bracket of `N(a)` and `N(b)`.
* `LinearMap.BilinForm.span_smulRight_flip_eq_skewAdjointSubmodule`: for a nondegenerate form on
  a finite-dimensional space, the `N(v)` span the skew-adjoint endomorphisms.
* `LinearMap.BilinForm.lieSpan_smulRight_flip_eq_skewAdjointLieSubalgebra`: a family of `N(δ i)`
  generating a Lie algebra for which `V` is irreducible generates `skewAdjointLieSubalgebra B`.

## References

* P. Deligne, *La conjecture de Weil. I*, Publ. Math. IHÉS 43 (1974), Lemme (5.11) and its proof,
  pp. 293–294.
-/

public section

namespace LinearMap.BilinForm

open LinearMap (BilinForm)
open Submodule

attribute [local instance 100] LieRing.ofAssociativeRing

section CommSemiring

variable {R M : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] {B : BilinForm R M}

/-- The transvection `x ↦ x + c * B x δ • δ` is `1 + c • N(δ)`, where `N(δ)` is the endomorphism
`x ↦ B x δ • δ`. -/
theorem transvection_smul_flip_eq_one_add (c : R) (δ : M) :
    LinearMap.transvection (c • B.flip δ) δ = 1 + c • (B.flip δ).smulRight δ := by
  ext x
  simp [LinearMap.transvection.apply, smul_smul]

end CommSemiring

section CommRing

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {B : BilinForm R M}

/-- For an alternating form `B`, the endomorphism `x ↦ B x δ • δ` is skew-adjoint for `B`. -/
theorem smulRight_flip_mem_skewAdjointSubmodule (hB : B.IsAlt) (δ : M) :
    (B.flip δ).smulRight δ ∈ B.skewAdjointSubmodule := by
  rw [mem_skewAdjointSubmodule]
  intro x y
  simp [← hB.neg_eq y δ, mul_comm]

/-- For an alternating form `B`, the endomorphism `x ↦ B x δ • δ` squares to zero. -/
theorem smulRight_flip_mul_self (hB : B.IsAlt) (δ : M) :
    (B.flip δ).smulRight δ * (B.flip δ).smulRight δ = 0 := by
  ext x
  simp [hB.self_eq_zero δ]

/-- The bracket of `x ↦ B x a • a` and `x ↦ B x b • b`, for an alternating form `B`, is `B b a`
times the polarization `x ↦ B x b • a + B x a • b`. -/
theorem lie_smulRight_flip (hB : B.IsAlt) (a b : M) :
    ⁅(B.flip a).smulRight a, (B.flip b).smulRight b⁆ =
      B b a • ((B.flip b).smulRight a + (B.flip a).smulRight b) := by
  ext x
  simp [LieRing.of_associative_ring_bracket, ← hB.neg_eq b a, smul_smul, mul_comm, sub_eq_add_neg]

/-- The endomorphism `x ↦ B x δ • δ` is homogeneous of degree two in `δ`. -/
theorem smulRight_flip_smul (t : R) (δ : M) :
    (B.flip (t • δ)).smulRight (t • δ) = (t * t) • (B.flip δ).smulRight δ := by
  ext x
  simp only [smulRight_apply, flip_apply, map_smul, LinearMap.smul_apply]
  module

/-- The endomorphism `x ↦ B x δ • δ` is quadratic in `δ`: the value at a sum is the sum of the
values plus the polarization `x ↦ B x b • a + B x a • b`. -/
theorem smulRight_flip_add (a b : M) :
    (B.flip (a + b)).smulRight (a + b) = (B.flip a).smulRight a + (B.flip b).smulRight b +
      ((B.flip b).smulRight a + (B.flip a).smulRight b) := by
  ext x
  simp [add_smul, smul_add]
  abel

/-- The polarization `x ↦ B x b • a + B x a • b` lies in every submodule containing all the
endomorphisms `x ↦ B x δ • δ`. -/
private theorem polarization_mem {S : Submodule R (Module.End R M)}
    (hS : ∀ δ, (B.flip δ).smulRight δ ∈ S) (a b : M) :
    (B.flip b).smulRight a + (B.flip a).smulRight b ∈ S := by
  have h := sub_mem (sub_mem (hS (a + b)) (hS a)) (hS b)
  rw [smulRight_flip_add] at h
  convert h using 1
  abel

/-- A symmetric combination `∑ i ∈ s, ∑ j ∈ s, m i j • (x ↦ B x (f j) • f i)` lies in every
submodule containing all the endomorphisms `x ↦ B x δ • δ`. -/
private theorem sum_sum_smul_smulRight_flip_mem {S : Submodule R (Module.End R M)}
    (hS : ∀ δ, (B.flip δ).smulRight δ ∈ S) {ι : Type*} (f : ι → M)
    (m : ι → ι → R) (hm : ∀ i j, m i j = m j i) (s : Finset ι) :
    ∑ i ∈ s, ∑ j ∈ s, m i j • (B.flip (f j)).smulRight (f i) ∈ S := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert k s hk ih =>
    simp only [Finset.sum_insert hk]
    -- Split off the row and column of the new index `k`; they pair up into polarizations.
    have hrow : m k k • (B.flip (f k)).smulRight (f k) +
        ∑ j ∈ s, m k j • (B.flip (f j)).smulRight (f k) +
        ∑ i ∈ s, m i k • (B.flip (f k)).smulRight (f i) ∈ S := by
      rw [add_assoc (m k k • _), ← Finset.sum_add_distrib]
      refine add_mem (smul_mem _ _ (hS _)) (sum_mem fun j _ ↦ ?_)
      rw [hm j k, ← smul_add]
      exact smul_mem _ _ (polarization_mem hS _ _)
    rw [Finset.sum_add_distrib, ← add_assoc]
    exact add_mem hrow ih

end CommRing

section Field

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {B : BilinForm K V}

/-- For a nondegenerate alternating form `B` on a finite-dimensional vector space, the
endomorphisms `x ↦ B x δ • δ` span the skew-adjoint endomorphisms. This holds in every
characteristic. -/
theorem span_smulRight_flip_eq_skewAdjointSubmodule [FiniteDimensional K V] (hB : B.IsAlt)
    (hnd : B.Nondegenerate) :
    span K (Set.range fun δ ↦ (B.flip δ).smulRight δ) = B.skewAdjointSubmodule := by
  classical
  refine le_antisymm (span_le.2 ?_) fun X hX ↦ ?_
  · rintro _ ⟨δ, rfl⟩
    exact smulRight_flip_mem_skewAdjointSubmodule hB δ
  rw [mem_skewAdjointSubmodule] at hX
  let b := Module.finBasis K V
  -- Expand `X` in the basis `b` and its `B`-dual basis; the coefficients form a symmetric matrix.
  have hcoord (i) (y : V) : B (B.dualBasis hnd b i) y = b.repr y i := by
    conv_lhs => rw [← b.sum_repr y]
    simp only [map_sum, map_smul, apply_dualBasis_left, smul_eq_mul, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  have hexp : X = ∑ i, ∑ j,
      B (B.dualBasis hnd b i) (X (B.dualBasis hnd b j)) • (B.flip (b j)).smulRight (b i) := by
    ext x
    conv_lhs => rw [← (B.dualBasis hnd b).sum_repr x]
    simp only [dualBasis_repr_apply, map_sum, map_smul, LinearMap.sum_apply,
      LinearMap.smul_apply, smulRight_apply, flip_apply, hcoord]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    simp_rw [smul_comm _ (B x (b j)), ← Finset.smul_sum, b.sum_repr]
  rw [hexp]
  refine sum_sum_smul_smulRight_flip_mem (fun δ ↦ subset_span (Set.mem_range_self δ)) b _
    (fun i j ↦ ?_) _
  rw [← hB.neg_eq, hX, Pi.neg_apply, map_neg, neg_neg]

/-- If `L` contains `x ↦ B x a • a` and `x ↦ B x b • b` with `B a b ≠ 0`, then it contains their
polarization `x ↦ B x b • a + B x a • b`. -/
private theorem polarization_mem_of_ne_zero (hB : B.IsAlt) {L : LieSubalgebra K (Module.End K V)}
    {a b : V} (ha : (B.flip a).smulRight a ∈ L) (hb : (B.flip b).smulRight b ∈ L)
    (hab : B a b ≠ 0) : (B.flip b).smulRight a + (B.flip a).smulRight b ∈ L := by
  have hba : B b a ≠ 0 := by rwa [← hB.neg_eq, neg_ne_zero]
  have h := L.smul_mem (B b a)⁻¹ (L.lie_mem ha hb)
  rwa [lie_smulRight_flip hB, inv_smul_smul₀ hba] at h

/-- Let `U` be a subspace with `x ↦ B x u • u` in `L` for all `u ∈ U`. If `L` also contains
`x ↦ B x b • b`, and `b` pairs nontrivially with some vector of `U`, then the same holds for every
vector of `U ⊔ K ∙ b`. -/
private theorem smulRight_flip_mem_of_mem_sup (hB : B.IsAlt)
    {L : LieSubalgebra K (Module.End K V)} {U : Submodule K V}
    (hU : ∀ u ∈ U, (B.flip u).smulRight u ∈ L) {b : V} (hb : (B.flip b).smulRight b ∈ L)
    {u₀ : V} (hu₀ : u₀ ∈ U) (h₀ : B u₀ b ≠ 0) :
    ∀ x ∈ U ⊔ K ∙ b, (B.flip x).smulRight x ∈ L := by
  intro x hx
  obtain ⟨u, hu, y, hy, rfl⟩ := mem_sup.1 hx
  obtain ⟨t, rfl⟩ := mem_span_singleton.1 hy
  have hub : (B.flip b).smulRight u + (B.flip u).smulRight b ∈ L := by
    by_cases hub : B u b = 0
    · -- Shift `u` by `u₀` to make the pairing with `b` nonzero, then subtract.
      have h := sub_mem
        (polarization_mem_of_ne_zero hB (hU _ (add_mem hu hu₀)) hb (by simpa [hub] using h₀))
        (polarization_mem_of_ne_zero hB (hU _ hu₀) hb h₀)
      convert h using 1
      ext z
      simp only [smulRight_apply, flip_apply, map_add, LinearMap.add_apply, LinearMap.sub_apply]
      module
    · exact polarization_mem_of_ne_zero hB (hU _ hu) hb hub
  rw [smulRight_flip_add, smulRight_flip_smul]
  refine add_mem (add_mem (hU _ hu) (L.smul_mem _ hb)) ?_
  convert L.smul_mem t hub using 1
  ext z
  simp only [smulRight_apply, flip_apply, map_smul, LinearMap.add_apply, LinearMap.smul_apply]
  module

/-- A Lie algebra of endomorphisms for which `V` is irreducible is nonzero when `V` carries a
nondegenerate alternating form: otherwise every line would be a submodule, while `V` has
dimension at least two. -/
private theorem exists_ne_zero_of_isIrreducible (hB : B.IsAlt) (hnd : B.Nondegenerate)
    (L : LieSubalgebra K (Module.End K V)) (hirr : LieModule.IsIrreducible K L V) :
    ∃ Y ∈ L, Y ≠ 0 := by
  by_contra! hL
  have := LieModule.nontrivial_of_isIrreducible K L V
  obtain ⟨v, hv⟩ := exists_ne (0 : V)
  obtain ⟨w, hw⟩ : ∃ w, B v w ≠ 0 := by
    by_contra! h
    exact hv (hnd.1 v h)
  -- The line `K ∙ v` is an `L`-submodule, since every element of `L` is zero.
  rcases hirr.eq_bot_or_eq_top (⟨K ∙ v, fun {Y} {u} _ ↦ by simp [hL Y Y.property]⟩ :
      LieSubmodule K L V) with h | h
  · exact hv (span_singleton_eq_bot.1 (LieSubmodule.mk_eq_bot_iff.1 h))
  · have hw' : w ∈ K ∙ v := by
      rw [LieSubmodule.mk_eq_top_iff.1 h]
      exact mem_top
    obtain ⟨c, rfl⟩ := mem_span_singleton.1 hw'
    simp [hB.self_eq_zero v] at hw

/-- **Deligne's lemma on the symplectic Lie algebra generated by transvections.**
Let `B` be a nondegenerate alternating form on a finite-dimensional vector space `V` and `δ` a
family of vectors. If `V` is an irreducible module for the Lie algebra generated by the
endomorphisms `x ↦ B x (δ i) • δ i`, then that Lie algebra is the whole Lie algebra
`skewAdjointLieSubalgebra B` of skew-adjoint endomorphisms. -/
theorem lieSpan_smulRight_flip_eq_skewAdjointLieSubalgebra [FiniteDimensional K V]
    (hB : B.IsAlt) (hnd : B.Nondegenerate) {ι : Type*} (δ : ι → V)
    (hirr : LieModule.IsIrreducible K (LieSubalgebra.lieSpan K (Module.End K V)
      (Set.range fun i ↦ (B.flip (δ i)).smulRight (δ i))) V) :
    LieSubalgebra.lieSpan K (Module.End K V)
      (Set.range fun i ↦ (B.flip (δ i)).smulRight (δ i)) = skewAdjointLieSubalgebra B := by
  set L := LieSubalgebra.lieSpan K (Module.End K V)
    (Set.range fun i ↦ (B.flip (δ i)).smulRight (δ i))
  have hδ (i : ι) : (B.flip (δ i)).smulRight (δ i) ∈ L := LieSubalgebra.subset_lieSpan ⟨i, rfl⟩
  refine le_antisymm (LieSubalgebra.lieSpan_le.2 ?_) fun X hX ↦ ?_
  · rintro _ ⟨i, rfl⟩
    exact smulRight_flip_mem_skewAdjointSubmodule hB (δ i)
  -- It suffices that `L` contains every `x ↦ B x v • v`, as these span the skew-adjoint maps.
  suffices hall : ∀ v, (B.flip v).smulRight v ∈ L by
    have hX' : X ∈ span K (Set.range fun v ↦ (B.flip v).smulRight v) := by
      rwa [span_smulRight_flip_eq_skewAdjointSubmodule hB hnd]
    exact (span_le (p := L.toSubmodule)).2 (by rintro _ ⟨v, rfl⟩; exact hall v) hX'
  -- Take a maximal subspace `U` with `x ↦ B x u • u` in `L` for every `u ∈ U`.
  obtain ⟨U, hU, hmax⟩ := exists_maximal_of_wellFoundedGT
    (fun U : Submodule K V ↦ ∀ u ∈ U, (B.flip u).smulRight u ∈ L) ⟨⊥, by simp⟩
  -- Each generator either kills `U` or lies in it, so `U` is stable under the generators.
  have hgen (i : ι) (u : V) (hu : u ∈ U) : (B.flip (δ i)).smulRight (δ i) u ∈ U := by
    rw [smulRight_apply, flip_apply]
    by_cases h : B u (δ i) = 0
    · simp [h]
    · exact smul_mem _ _ (hmax (smulRight_flip_mem_of_mem_sup hB hU (hδ i) hu h) le_sup_left
        (mem_sup_right (mem_span_singleton_self _)))
  have hstab (Y : Module.End K V) (hY : Y ∈ L) (u : V) (hu : u ∈ U) : Y u ∈ U := by
    induction hY using LieSubalgebra.lieSpan_induction generalizing u with
    | mem _ h => obtain ⟨i, rfl⟩ := h; exact hgen i u hu
    | zero => simp
    | add _ _ _ _ h₁ h₂ => exact add_mem (h₁ u hu) (h₂ u hu)
    | smul a _ _ h => exact smul_mem _ a (h u hu)
    | lie _ _ _ _ h₁ h₂ =>
      rw [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
        mul_apply_eq_comp]
      exact sub_mem (h₁ _ (h₂ u hu)) (h₂ _ (h₁ u hu))
  -- So `U` is an `L`-submodule; it is not zero, as then every `δ i` would vanish.
  rcases hirr.eq_bot_or_eq_top (⟨U, fun {Y} {u} hu ↦ hstab Y Y.property u hu⟩ :
      LieSubmodule K L V) with hbot | htop
  · have hU0 : U = ⊥ := LieSubmodule.mk_eq_bot_iff.1 hbot
    obtain ⟨Y, hY, hY0⟩ := exists_ne_zero_of_isIrreducible hB hnd L hirr
    refine absurd ((LieSubalgebra.mem_bot (R := K) Y).1 ((LieSubalgebra.lieSpan_le.2 ?_) hY)) hY0
    rintro _ ⟨i, rfl⟩
    have hline : ∀ x ∈ K ∙ δ i, (B.flip x).smulRight x ∈ L := by
      intro x hx
      obtain ⟨t, rfl⟩ := mem_span_singleton.1 hx
      rw [smulRight_flip_smul]
      exact L.smul_mem _ (hδ i)
    have h0 : δ i = 0 := by
      simpa [hU0] using hmax hline (by simp [hU0]) (mem_span_singleton_self (δ i))
    simp [h0]
  · intro v
    exact hU v (by simp [LieSubmodule.mk_eq_top_iff.1 htop])

end Field

end LinearMap.BilinForm
