module

public import TauCeti.Algebra.Lie.G2.ShortRoot.CrossProduct.Basic
public import TauCeti.LinearAlgebra.Matrix.Triangular

/-!
# Upper-unitriangular automorphisms of the type-G₂ cross product

When multiplication by two is injective, the upper-unitriangular matrices preserving the
seven-dimensional cross product admit an explicit six-parameter polynomial normal form.
The parameters are entries at positions `(0,1)`, `(1,2)`, `(0,2)`, `(3,6)`, `(0,4)`, and
`(0,5)`. In particular, equality can be tested on these six entries alone. The normal forms are
closed under multiplication, by an explicit polynomial group law valid over every commutative
ring, and each has an explicit normal-form inverse.

This is the coordinate calculation for identifying the positive unipotent subgroup of the
short-root carrier. It applies over rings with zero divisors and over nonreduced algebras
of characteristic three. No identification with a subgroup generated by root elements is
asserted here.

The cross-product normalization and weight basis are those of
`TauCeti.Algebra.Lie.G2.ShortRoot.CrossProduct.Basic` and Bourbaki,
*Lie Groups and Lie Algebras, Chapters 4--6*, Plate IX. For the positive-subgroup
interpretation, see J. E. Humphreys, *Linear Algebraic Groups*, §§26--28.
-/

public section

open Matrix

namespace TauCeti.G2ShortRoot

variable {R : Type*} [CommRing R]

/-- The six-parameter upper-unitriangular matrix preserving the short-root `G₂` cross product.
The parameters `a,b,c,d,e,f` are its entries at `(0,1)`, `(1,2)`, `(0,2)`, `(3,6)`, `(0,4)`,
and `(0,5)`, respectively. -/
def crossUnipotentMatrix (a b c d e f : R) : Matrix (Fin 7) (Fin 7) R :=
  !![1, a, c, 2 * d, e, f, a * f - c * e + d ^ 2;
    0, 1, b, 2 * a * b - 2 * c, a ^ 2 * b - a * c - d,
      a * b * c - c ^ 2 - b * d, a * b * d - c * d - b * e + f;
    0, 0, 1, 2 * a, a ^ 2, a * c - d, a * d - e;
    0, 0, 0, 1, a, c, d;
    0, 0, 0, 0, 1, b, a * b - c;
    0, 0, 0, 0, 0, 1, a;
    0, 0, 0, 0, 0, 0, 1]

/-- The entry table of the six-parameter normal form. -/
theorem crossUnipotentMatrix_def (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f =
      !![1, a, c, 2 * d, e, f, a * f - c * e + d ^ 2;
        0, 1, b, 2 * a * b - 2 * c, a ^ 2 * b - a * c - d,
          a * b * c - c ^ 2 - b * d, a * b * d - c * d - b * e + f;
        0, 0, 1, 2 * a, a ^ 2, a * c - d, a * d - e;
        0, 0, 0, 1, a, c, d;
        0, 0, 0, 0, 1, b, a * b - c;
        0, 0, 0, 0, 0, 1, a;
        0, 0, 0, 0, 0, 0, 1] :=
  (rfl)

@[simp] theorem crossUnipotentMatrix_zero_one (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 0 1 = a := (rfl)

@[simp] theorem crossUnipotentMatrix_one_two (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 1 2 = b := (rfl)

@[simp] theorem crossUnipotentMatrix_zero_two (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 0 2 = c := (rfl)

@[simp] theorem crossUnipotentMatrix_three_six (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 3 6 = d := (rfl)

@[simp] theorem crossUnipotentMatrix_zero_four (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 0 4 = e := (rfl)

@[simp] theorem crossUnipotentMatrix_zero_five (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f 0 5 = f := (rfl)

/-- The normal form with all parameters zero is the identity matrix. -/
@[simp]
theorem crossUnipotentMatrix_zero :
    crossUnipotentMatrix (0 : R) 0 0 0 0 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [crossUnipotentMatrix_def]

/-- **The group law of the normal forms.** The product of two normal forms is the normal form of
explicit polynomials in their parameters, over every commutative ring. -/
@[simp]
theorem crossUnipotentMatrix_mul_crossUnipotentMatrix (a b c d e f a' b' c' d' e' f' : R) :
    crossUnipotentMatrix a b c d e f * crossUnipotentMatrix a' b' c' d' e' f' =
      crossUnipotentMatrix (a + a') (b + b') (c + c' + a * b')
        (d + d' + a * a' * b' - a * c' + c * a')
        (e + e' + a * a' ^ 2 * b' - a * a' * c' - a * d' + c * a' ^ 2 + 2 * d * a')
        (f + f' + a * a' * b' * c' - a * b' * d' - a * c' ^ 2 + c * a' * c' - c * d' +
          2 * d * c' + e * b') := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, Matrix.mul_apply, Fin.sum_univ_seven] <;> ring

/-- A normal form has an explicit right inverse, the normal form of polynomials in its
parameters. -/
theorem crossUnipotentMatrix_mul_crossUnipotentMatrix_eq_one (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f *
        crossUnipotentMatrix (-a) (-b) (a * b - c) (-d) (a * d - e)
          (-a * b * d + b * e + c * d - f) = 1 := by
  rw [crossUnipotentMatrix_mul_crossUnipotentMatrix, ← crossUnipotentMatrix_zero]
  congr 1 <;> ring

/-- Every parameter tuple gives an upper-unitriangular matrix. -/
@[simp]
theorem isUpperUnitriangular_crossUnipotentMatrix (a b c d e f : R) :
    (crossUnipotentMatrix a b c d e f).IsUpperUnitriangular := by
  rw [isUpperUnitriangular_def]
  constructor
  · intro i j hji
    fin_cases i <;> fin_cases j <;> simp_all [crossUnipotentMatrix_def]
  · intro i
    fin_cases i <;> simp [crossUnipotentMatrix_def]

-- Check the seven basis-vector identities separately so coordinate normalization stays
-- within the default elaboration limits.
private theorem crossUnipotentMatrix_cross_zero (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 0).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 0 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_one (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 1).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 1 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_two (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 2).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 2 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_three (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 3).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 3 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_four (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 4).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 4 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_five (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 5).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 5 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

private theorem crossUnipotentMatrix_cross_six (a b c d e f : R) :
    crossUnipotentMatrix a b c d e f * (crossOperator 6).map (Int.cast : ℤ → R) =
      (∑ l, crossUnipotentMatrix a b c d e f l 6 •
        (crossOperator l).map (Int.cast : ℤ → R)) * crossUnipotentMatrix a b c d e f := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, crossOperator_def, Matrix.mul_apply,
      Fin.sum_univ_seven] <;> ring

/-- Every parameter tuple preserves the cross product, over any commutative ring. -/
@[simp]
theorem preservesG2Cross_crossUnipotentMatrix (a b c d e f : R) :
    PreservesG2Cross (crossUnipotentMatrix a b c d e f) := by
  rw [preservesG2Cross_def]
  intro k
  fin_cases k
  · exact crossUnipotentMatrix_cross_zero _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_one _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_two _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_three _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_four _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_five _ _ _ _ _ _
  · exact crossUnipotentMatrix_cross_six _ _ _ _ _ _

private theorem cross_entry {g : Matrix (Fin 7) (Fin 7) R} (h : PreservesG2Cross g)
    (k i j : Fin 7) :
    ∑ l, g i l * (crossOperator k l j : R) =
      ∑ l, (∑ a, g a k * (crossOperator a i l : R)) * g l j := by
  have he := congrFun (congrFun ((preservesG2Cross_def g).mp h k) i) j
  simpa only [Matrix.mul_apply, Matrix.map_apply, Matrix.sum_apply,
    Matrix.smul_apply, smul_eq_mul] using he

-- Share the tensor-table and triangular normalization across the entry-elimination steps.
local macro "normalize_cross_entry" he:ident " using " hu:term ", " hz:term : tactic =>
  `(tactic| simp [($hu).apply_diag, ($hz), crossOperator_def, Fin.sum_univ_seven] at $he:ident)

-- First eliminate the lower rows using cross products with the first two basis vectors.
private theorem cross_lower_entries (h2 : IsRegular (2 : R))
    {g : Matrix (Fin 7) (Fin 7) R} (hu : g.IsUpperUnitriangular) (h : PreservesG2Cross g) :
    g 3 4 = g 0 1 ∧ g 3 5 = g 0 2 ∧ g 0 3 = 2 * g 3 6 ∧ g 4 5 = g 1 2 ∧
      g 2 3 = 2 * g 0 1 ∧ g 5 6 = g 0 1 ∧ g 2 4 = (g 0 1) ^ 2 ∧
      g 2 5 = g 0 1 * g 0 2 - g 3 6 ∧ g 2 6 = g 0 1 * g 3 6 - g 0 4 := by
  have hz (i j : Fin 7) (hji : j < i) : g i j = 0 := hu.isUpperTriangular hji
  have h34 : g 3 4 = g 0 1 := by
    have he := cross_entry h 0 0 4
    normalize_cross_entry he using hu, hz
    apply h2.left
    linear_combination -he
  have h35 : g 3 5 = g 0 2 := by
    have he := cross_entry h 0 0 5
    normalize_cross_entry he using hu, hz
    apply h2.left
    linear_combination -he
  have h03 : g 0 3 = 2 * g 3 6 := by
    have he := cross_entry h 0 0 6
    simpa [hu.apply_diag, hz, crossOperator_def, Fin.sum_univ_seven] using he
  have h45 : g 4 5 = g 1 2 := by
    have he := cross_entry h 0 1 5
    normalize_cross_entry he using hu, hz
    apply h2.left
    linear_combination -he
  have h23 : g 2 3 = 2 * g 0 1 := by
    have he := cross_entry h 1 0 3
    normalize_cross_entry he using hu, hz
    apply h2.left
    linear_combination -he
  have h56 : g 5 6 = g 0 1 := by
    have he := cross_entry h 0 2 6
    normalize_cross_entry he using hu, hz
    simp only [h23] at he
    apply h2.left
    linear_combination -he
  have h24 : g 2 4 = (g 0 1) ^ 2 := by
    have he := cross_entry h 1 0 4
    normalize_cross_entry he using hu, hz
    simp only [h34] at he
    apply h2.left
    linear_combination -he
  have h25 : g 2 5 = g 0 1 * g 0 2 - g 3 6 := by
    have he := cross_entry h 1 0 5
    normalize_cross_entry he using hu, hz
    simp only [h03, h35] at he
    apply h2.left
    linear_combination -he
  have h26 : g 2 6 = g 0 1 * g 3 6 - g 0 4 := by
    have he := cross_entry h 1 0 6
    normalize_cross_entry he using hu, hz
    apply h2.left
    linear_combination -he
  exact ⟨h34, h35, h03, h45, h23, h56, h24, h25, h26⟩

-- The remaining cross-product identities determine the top two rows and entry (4,6).
private theorem cross_upper_entries (h2 : IsRegular (2 : R))
    {g : Matrix (Fin 7) (Fin 7) R} (hu : g.IsUpperUnitriangular) (h : PreservesG2Cross g) :
    g 1 3 = 2 * g 0 1 * g 1 2 - 2 * g 0 2 ∧
      g 4 6 = g 0 1 * g 1 2 - g 0 2 ∧
      g 1 4 = (g 0 1) ^ 2 * g 1 2 - g 0 1 * g 0 2 - g 3 6 ∧
      g 1 5 = g 0 1 * g 1 2 * g 0 2 - (g 0 2) ^ 2 - g 1 2 * g 3 6 ∧
      g 1 6 = g 0 1 * g 1 2 * g 3 6 - g 0 2 * g 3 6 - g 1 2 * g 0 4 + g 0 5 ∧
      g 0 6 = g 0 1 * g 0 5 - g 0 2 * g 0 4 + (g 3 6) ^ 2 := by
  have hz (i j : Fin 7) (hji : j < i) : g i j = 0 := hu.isUpperTriangular hji
  obtain ⟨h34, h35, h03, h45, h23, h56, h24, h25, h26⟩ := cross_lower_entries h2 hu h
  have h13 : g 1 3 = 2 * g 0 1 * g 1 2 - 2 * g 0 2 := by
    have he := cross_entry h 1 1 5
    normalize_cross_entry he using hu, hz
    simp only [h35, h45] at he
    linear_combination -he
  have h46 : g 4 6 = g 0 1 * g 1 2 - g 0 2 := by
    have he := cross_entry h 0 1 6
    normalize_cross_entry he using hu, hz
    simp only [h13] at he
    apply h2.left
    linear_combination -he
  have h14 : g 1 4 = (g 0 1) ^ 2 * g 1 2 - g 0 1 * g 0 2 - g 3 6 := by
    have he := cross_entry h 1 1 6
    normalize_cross_entry he using hu, hz
    simp only [h46] at he
    apply h2.left
    linear_combination -he
  have h15 : g 1 5 = g 0 1 * g 1 2 * g 0 2 - (g 0 2) ^ 2 - g 1 2 * g 3 6 := by
    have he := cross_entry h 2 0 5
    normalize_cross_entry he using hu, hz
    simp only [h25, h35] at he
    apply h2.left
    linear_combination he
  have h16 : g 1 6 = g 0 1 * g 1 2 * g 3 6 - g 0 2 * g 3 6 - g 1 2 * g 0 4 + g 0 5 := by
    have he := cross_entry h 2 0 6
    normalize_cross_entry he using hu, hz
    simp only [h26] at he
    apply h2.left
    linear_combination he
  have h06 : g 0 6 = g 0 1 * g 0 5 - g 0 2 * g 0 4 + (g 3 6) ^ 2 := by
    have he := cross_entry h 3 0 6
    normalize_cross_entry he using hu, hz
    simp only [h03, h13, h23, h16, h26] at he
    apply h2.left
    apply h2.left
    linear_combination -he
  exact ⟨h13, h46, h14, h15, h16, h06⟩

/-- An upper-unitriangular cross-product automorphism is the normal form of its six selected
entries, provided multiplication by two is injective. -/
theorem eq_crossUnipotentMatrix_of_preservesG2Cross (h2 : IsRegular (2 : R))
    {g : Matrix (Fin 7) (Fin 7) R} (hu : g.IsUpperUnitriangular)
    (h : PreservesG2Cross g) :
    g = crossUnipotentMatrix (g 0 1) (g 1 2) (g 0 2) (g 3 6) (g 0 4) (g 0 5) := by
  have hz (i j : Fin 7) (hji : j < i) : g i j = 0 := hu.isUpperTriangular hji
  obtain ⟨h34, h35, h03, h45, h23, h56, h24, h25, h26⟩ := cross_lower_entries h2 hu h
  obtain ⟨h13, h46, h14, h15, h16, h06⟩ := cross_upper_entries h2 hu h
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [crossUnipotentMatrix_def, hu.apply_diag, hz,
      h03, h13, h14, h15, h16, h23, h24, h25, h26, h34, h35, h45, h46, h56, h06]

/-- Among upper-unitriangular matrices, cross-product preservation is exactly the
six-parameter normal form. -/
theorem preservesG2Cross_iff_eq_crossUnipotentMatrix (h2 : IsRegular (2 : R))
    {g : Matrix (Fin 7) (Fin 7) R} (hu : g.IsUpperUnitriangular) :
    PreservesG2Cross g ↔
      g = crossUnipotentMatrix (g 0 1) (g 1 2) (g 0 2) (g 3 6) (g 0 4) (g 0 5) := by
  constructor
  · exact eq_crossUnipotentMatrix_of_preservesG2Cross h2 hu
  · intro hg
    rw [hg]
    exact preservesG2Cross_crossUnipotentMatrix _ _ _ _ _ _

/-- The normal form has unique parameters, even when two is not regular. -/
@[simp]
theorem crossUnipotentMatrix_inj {a b c d e f a' b' c' d' e' f' : R} :
    crossUnipotentMatrix a b c d e f = crossUnipotentMatrix a' b' c' d' e' f' ↔
      a = a' ∧ b = b' ∧ c = c' ∧ d = d' ∧ e = e' ∧ f = f' := by
  constructor
  · intro h
    have hp := congrArg (fun M : Matrix (Fin 7) (Fin 7) R ↦
      (M 0 1, M 1 2, M 0 2, M 3 6, M 0 4, M 0 5)) h
    simpa only [crossUnipotentMatrix_zero_one, crossUnipotentMatrix_one_two,
      crossUnipotentMatrix_zero_two, crossUnipotentMatrix_three_six,
      crossUnipotentMatrix_zero_four, crossUnipotentMatrix_zero_five, Prod.mk.injEq] using hp
  · rintro ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩
    rfl

/-- Equality of upper-unitriangular cross-product automorphisms can be tested on six entries,
provided multiplication by two is injective. -/
theorem _root_.Matrix.PreservesG2Cross.eq_iff_of_isUpperUnitriangular
    {g g' : Matrix (Fin 7) (Fin 7) R} (h : PreservesG2Cross g) (h' : PreservesG2Cross g')
    (h2 : IsRegular (2 : R)) (hu : g.IsUpperUnitriangular) (hu' : g'.IsUpperUnitriangular) :
    g = g' ↔ g 0 1 = g' 0 1 ∧ g 1 2 = g' 1 2 ∧ g 0 2 = g' 0 2 ∧
      g 3 6 = g' 3 6 ∧ g 0 4 = g' 0 4 ∧ g 0 5 = g' 0 5 := by
  conv_lhs =>
    rw [eq_crossUnipotentMatrix_of_preservesG2Cross h2 hu h,
      eq_crossUnipotentMatrix_of_preservesG2Cross h2 hu' h']
  exact crossUnipotentMatrix_inj

end TauCeti.G2ShortRoot
