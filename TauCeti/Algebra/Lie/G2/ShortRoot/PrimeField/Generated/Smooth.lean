module

public import TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Carrier
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.HopfIdeal.CommonKernel.Reduced
public import TauCeti.Algebra.AlgebraicGroup.AdditiveGroup.CoordinateBaseChange
public import TauCeti.Algebra.AlgebraicGroup.DiagonalizableGroup.BaseChange
public import TauCeti.Algebra.AlgebraicGroup.GeneralLinear.Coordinate.BaseChange

/-!
# Smoothness of the generated short-root type-G2 subgroup after scalar extension

The short-root type-`G₂` carrier over `𝔽₃` is generated by four numbered root subgroups and
its rank-two weight torus. After extending the coordinate maps to an algebraically closed
characteristic-three field, their common-kernel quotient is reduced and hence smooth. The scalar
extension of the prime-field carrier contains this generated subgroup.

The containment need not be an equality merely from the common-kernel construction. Identifying
the scalar extension of the prime-field carrier with the generated subgroup, and then recognizing
it as the pinned simply connected group scheme of type `G₂`, are separate questions.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§26–27.
* J. S. Milne, *Algebraic Groups* (2017), §2.h.

The interface follows the generated-subgroup smoothness construction for the type-`E₇`
minuscule carrier in `TauCeti.Algebra.Lie.E7.Minuscule.Generated.Smooth`.
-/

public section

open CategoryTheory

namespace TauCeti.G2ShortRoot.PrimeField

universe u

section Construction

variable (k : Type u) [CommRing k] [Algebra (ZMod 3) k]

/-- The scalar extensions of the coordinate Hopf algebras of the numbered root subgroups and
weight torus. -/
noncomputable abbrev baseChangeGeneratorCodomain :
    (Fin 2 ⊕ Fin 2) ⊕ Unit → CommHopfAlgCat k := fun j ↦
  CommHopfAlgCat.baseChange (K := k) (generatorCodomain j)

/-- The root-subgroup and torus coordinate maps after scalar extension to `k`, with the ambient
coordinate algebra identified with `O(GL₇/k)`. -/
noncomputable def baseChangeGenerator :
    ∀ j, GeneralLinear.coordinateHopfAlgebra k 7 ⟶ baseChangeGeneratorCodomain k j :=
  fun j ↦ (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv ≫
    CommHopfAlgCat.baseChangeMap (K := k) (generator j)

/-- A scalar-extended generator is the base change of the corresponding prime-field coordinate
map, transported across the canonical coordinate-algebra identification for `GL₇`. -/
theorem baseChangeGenerator_def (j : (Fin 2 ⊕ Fin 2) ⊕ Unit) :
    baseChangeGenerator k j =
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv ≫
        CommHopfAlgCat.baseChangeMap (K := k) (generator j) := by
  rw [baseChangeGenerator]

/-- The defining ideal of the subgroup generated by the scalar-extended numbered root subgroups
and weight torus. -/
noncomputable def generatedDefiningIdeal :
    HopfIdeal k (GeneralLinear.coordinateHopfAlgebra k 7) :=
  CommHopfAlgCat.commonKernelHopfIdeal (baseChangeGenerator k)

/-- The generated subgroup is defined by the common kernel of the scalar-extended generator
maps. -/
@[simp]
theorem generatedDefiningIdeal_def :
    generatedDefiningIdeal k =
      CommHopfAlgCat.commonKernelHopfIdeal (baseChangeGenerator k) := by
  simp [generatedDefiningIdeal]

/-- A Hopf ideal lies below the generated subgroup's defining ideal exactly when every
scalar-extended generator coordinate map kills it. -/
theorem le_generatedDefiningIdeal_iff
    (J : HopfIdeal k (GeneralLinear.coordinateHopfAlgebra k 7)) :
    J ≤ generatedDefiningIdeal k ↔
      ∀ j, J.toIdeal ≤ RingHom.ker
        (baseChangeGenerator k j).hom.toAlgHom.toRingHom := by
  rw [generatedDefiningIdeal_def]
  exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (baseChangeGenerator k) J

/-- The defining ideal of the prime-field carrier, transported into `O(GL₇/k)`. -/
noncomputable def baseChangeDefiningIdeal :
    HopfIdeal k (GeneralLinear.coordinateHopfAlgebra k 7) :=
  (CommHopfAlgCat.baseChangeHopfIdeal (K := k) definingIdeal).comapOfSurjective
    (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv.hom
    (ConcreteCategory.bijective_of_isIso
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv).2

/-- The transported defining ideal is the inverse image of the scalar extension of the
prime-field ideal under the canonical coordinate-algebra identification for `GL₇`. -/
theorem baseChangeDefiningIdeal_def :
    baseChangeDefiningIdeal k =
      (CommHopfAlgCat.baseChangeHopfIdeal (K := k) definingIdeal).comapOfSurjective
        (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv.hom
        (ConcreteCategory.bijective_of_isIso
          (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv).2 := by
  rw [baseChangeDefiningIdeal]

/-- The scalar extension of the prime-field carrier contains the subgroup generated by the
scalar-extended root subgroups and torus. -/
theorem baseChangeDefiningIdeal_le_generatedDefiningIdeal :
    baseChangeDefiningIdeal k ≤ generatedDefiningIdeal k := by
  rw [le_generatedDefiningIdeal_iff]
  intro j x hx
  -- Kernel membership is phrased through the underlying ring homomorphism: turn it into an
  -- equation, peel the bialgebra-to-algebra-to-ring-hom coercions, and split the composition
  -- defining `baseChangeGenerator` into its two factors.
  rw [RingHom.mem_ker, baseChangeGenerator, CommHopfAlgCat.hom_comp, BialgHom.comp_toAlgHom,
    AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, AlgHom.comp_apply]
  have hx' :
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv.hom x ∈
        CommHopfAlgCat.baseChangeHopfIdeal (K := k) definingIdeal :=
    HopfIdeal.mem_comapOfSurjective.mp hx
  rw [definingIdeal_def] at hx'
  have hcommon :
      (GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7).inv.hom x ∈
        CommHopfAlgCat.commonKernelHopfIdeal
          (fun i ↦ CommHopfAlgCat.baseChangeMap (K := k) (generator i)) :=
    CommHopfAlgCat.baseChangeHopfIdeal_commonKernelHopfIdeal_le generator hx'
  exact RingHom.mem_ker.mp
    (CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
      (fun i ↦ CommHopfAlgCat.baseChangeMap (K := k) (generator i)) j hcommon)

/-- The coordinate Hopf algebra of the subgroup generated after scalar extension. -/
noncomputable def generatedCoordinateHopfAlgebra : CommHopfAlgCat k :=
  CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra k 7)
    (generatedDefiningIdeal k)

/-- The generated subgroup has the quotient coordinate Hopf algebra of its defining ideal. -/
@[simp]
theorem generatedCoordinateHopfAlgebra_def :
    generatedCoordinateHopfAlgebra k =
      CommHopfAlgCat.quotient (GeneralLinear.coordinateHopfAlgebra k 7)
        (generatedDefiningIdeal k) := by
  simp [generatedCoordinateHopfAlgebra]

end Construction

variable (k : Type u) [Field k] [Algebra (ZMod 3) k]

private theorem isReduced_baseChangeGeneratorCodomain :
    ∀ j, IsReduced (baseChangeGeneratorCodomain k j) := by
  rintro (j | u)
  · let e := AdditiveGroup.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k
    exact isReduced_of_injective e.hom.hom.toAlgHom.toRingHom
      (ConcreteCategory.bijective_of_isIso e.hom).1
  · rcases u with ⟨⟩
    let e := DiagonalizableGroup.baseChangeCoordinateHopfAlgebraIso
      (ZMod 3) k (SplitTorus.characterGroup (Fin 2))
    exact isReduced_of_injective e.hom.hom.toAlgHom.toRingHom
      (ConcreteCategory.bijective_of_isIso e.hom).1

/-- The subgroup generated after scalar extension has reduced coordinate algebra over an
algebraically closed field. -/
theorem isReduced_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    IsReduced (generatedCoordinateHopfAlgebra k) := by
  let : ∀ j, IsReduced (baseChangeGeneratorCodomain k j) :=
    isReduced_baseChangeGeneratorCodomain k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.isReduced_quotient_commonKernelHopfIdeal (baseChangeGenerator k)

/-- The subgroup generated after scalar extension is smooth over an algebraically closed field. -/
theorem smoothCommHopfAlgProperty_generatedCoordinateHopfAlgebra [IsAlgClosed k] :
    smoothCommHopfAlgProperty k (generatedCoordinateHopfAlgebra k) := by
  let : ∀ j, IsReduced (baseChangeGeneratorCodomain k j) :=
    isReduced_baseChangeGeneratorCodomain k
  rw [generatedCoordinateHopfAlgebra_def, generatedDefiningIdeal_def]
  exact CommHopfAlgCat.smoothCommHopfAlgProperty_quotient_commonKernelHopfIdeal
    (baseChangeGenerator k)

end TauCeti.G2ShortRoot.PrimeField
