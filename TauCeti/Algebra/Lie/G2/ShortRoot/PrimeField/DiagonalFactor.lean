module

public import TauCeti.Algebra.Lie.G2.ShortRoot.CrossProduct.UpperTriangular
public import TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.TorusCentralizer
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperTriangular.Basic

/-!
# The torus factor of an upper-triangular short-root G₂ point

Over every commutative `𝔽₃`-algebra, the diagonal of an upper-triangular point of the
short-root carrier belongs to its rank-two weight torus. There is therefore a unique
torus parameter `s` such that `g * (weightTorusPoints s)⁻¹` is upper unitriangular.
Both factors remain points of the carrier, including over nonreduced value algebras.

This separates the diagonal part of the carrier's upper-triangular intersection from
its unipotent part. Identifying that unipotent part with the subgroup generated by
positive roots is a further assertion, not a consequence of the factorization alone.

The argument combines the filtered cross-product equations with
`TauCeti.G2ShortRoot.preservesG2Cross_diagonal_iff`. The latter uses the short-root
weight table in Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plate IX.
The torus and unipotent factorization is the usual triangular decomposition; see
J. E. Humphreys, *Linear Algebraic Groups*, §§17 and 21.
-/

public section

open Matrix

namespace TauCeti.G2ShortRoot.PrimeField

variable {A : Type*} [CommRing A] [Algebra (ZMod 3) A]

/-- The diagonal of an upper-triangular carrier point is the diagonal of a unique point of
its rank-two weight torus. No reducedness or field hypothesis on the value algebra is needed. -/
theorem existsUnique_torusCharacter_eq_diagonal (g : points A)
    (htri : ((g : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A).IsUpperTriangular) :
    ∃! s : Fin 2 → Aˣ, ∀ i,
      (torusCharacter s (weight i) : A) = (g : GL (Fin 7) A) i i := by
  let d := UpperTriangularGroup.diag
    (⟨(g : GL (Fin 7) A), UpperTriangularGroup.mem_iff.mpr htri⟩ : upperTriangularGroup (Fin 7) A)
  have hcross : PreservesG2Cross (diagonal fun i ↦ (d i : A)) := by
    simp only [d, UpperTriangularGroup.diag_apply_val]
    exact preservesG2Cross_diagonal_of_isUpperTriangular htri
      (preservesG2Cross_of_mem_points g.property)
  have h2 : IsUnit (2 : A) := by
    have h : IsUnit ((algebraMap (ZMod 3) A) 2) :=
      ((ZMod.isUnit_iff_coprime 2 3).mpr (by decide)).map
        (algebraMap (ZMod 3) A).toMonoidHom
    rwa [map_ofNat] at h
  obtain ⟨s, hs⟩ := (preservesG2Cross_diagonal_iff h2.isRegular d).mp hcross
  refine ⟨s, ?_, ?_⟩
  · intro i
    rw [← hs i]
    exact UpperTriangularGroup.diag_apply_val _ i
  · intro t ht
    apply eq_of_span_eq_top_of_torusCharacter_eq span_range_weight_eq_top
    intro i
    apply Units.ext
    rw [ht i]
    exact (UpperTriangularGroup.diag_apply_val
      (⟨(g : GL (Fin 7) A), UpperTriangularGroup.mem_iff.mpr htri⟩ :
        upperTriangularGroup (Fin 7) A) i).symm.trans (congrArg Units.val (hs i))

/-- Removing a proposed weight-torus factor from an upper-triangular carrier point gives an
upper-unitriangular point exactly when their diagonals agree. -/
theorem isUpperUnitriangular_mul_inv_weightTorusPoints_iff (g : points A)
    (htri : ((g : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A).IsUpperTriangular)
    (s : Fin 2 → Aˣ) :
    (((g * (weightTorusPoints A s)⁻¹ : points A) : GL (Fin 7) A) :
        Matrix (Fin 7) (Fin 7) A).IsUpperUnitriangular ↔
      ∀ i, (torusCharacter s (weight i) : A) = (g : GL (Fin 7) A) i i := by
  let b : upperTriangularGroup (Fin 7) A :=
    ⟨(g : GL (Fin 7) A), UpperTriangularGroup.mem_iff.mpr htri⟩
  have htorus : (weightTorusPoints A s : GL (Fin 7) A) =
      diagGL (fun i ↦ torusCharacter s (weight i)) := by
    apply Units.ext
    rw [coe_weightTorusPoints, IntegralToralClosure.coe_weightTorusPoints_eq_diagonal,
      diagGL_coe]
  rw [Subgroup.coe_mul, Subgroup.coe_inv, htorus, ← UpperUnitriangularGroup.mem_iff]
  rw [UpperTriangularGroup.mul_inv_diagGL_mem_upperUnitriangularGroup_iff b]
  constructor
  · intro h i
    rw [← congrFun h i]
    exact UpperTriangularGroup.diag_apply_val b i
  · intro h
    funext i
    apply Units.ext
    exact (UpperTriangularGroup.diag_apply_val b i).trans (h i).symm

/-- Every upper-triangular short-root carrier point has a unique weight-torus factor whose
removal on the right leaves an upper-unitriangular carrier point. -/
theorem existsUnique_weightTorusPoints_isUpperUnitriangular (g : points A)
    (htri : ((g : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A).IsUpperTriangular) :
    ∃! s : Fin 2 → Aˣ,
      (((g * (weightTorusPoints A s)⁻¹ : points A) : GL (Fin 7) A) :
        Matrix (Fin 7) (Fin 7) A).IsUpperUnitriangular := by
  obtain ⟨s, hs, huniq⟩ := existsUnique_torusCharacter_eq_diagonal g htri
  refine ⟨s, (isUpperUnitriangular_mul_inv_weightTorusPoints_iff g htri s).mpr hs, ?_⟩
  intro t ht
  exact huniq t ((isUpperUnitriangular_mul_inv_weightTorusPoints_iff g htri t).mp ht)

end TauCeti.G2ShortRoot.PrimeField
