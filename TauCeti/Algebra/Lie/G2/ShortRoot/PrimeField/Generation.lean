public import TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Generated.Torus

/-!
# Generation of the short-root type-G2 carrier over 𝔽₃ by root subgroups

The short-root type-`G₂` carrier over the prime field `𝔽₃` is the closed subgroup scheme of `GL₇`
generated by the reductions of four numbered simple root-subgroup coordinate maps *and* of the
rank-two weight-torus coordinate map of the integral toral closure. This file proves that the
torus generator is redundant: the defining Hopf ideal over `𝔽₃` is already the largest one killed
by the four reduced root-subgroup maps, so the carrier is the subgroup scheme generated over `𝔽₃`
by its numbered simple root subgroups alone, and a morphism out of it is determined by its
restrictions to them, with no hypothesis on the torus.

Over `ℤ` this is
`TauCeti.G2ShortRoot.IntegralToralClosure.definingIdeal_eq_kostantGeneratedDefiningIdeal`. That
statement is an equality of integral Hopf ideals and does not transfer along a base change
which is not known to be flat, so it does not by itself say anything about the ideal generated
afresh over `𝔽₃`; the argument has to be replayed there. What does transfer is the pointwise input,
`TauCeti.G2ShortRoot.weightTorusSubgroup_le_elementarySubgroup`, which holds over every commutative
ring and hence over the coordinate ring of the split torus over `𝔽₃`.

The carrier is not identified with the pinned simply connected group scheme of type `G₂`, and
constructions on it transfer to that group scheme only along such an identification, once one is
proved.

## Main results

* `TauCeti.G2ShortRoot.PrimeField.definingIdeal_eq_commonKernelHopfIdeal_rootSubgroup`: the
  defining Hopf ideal over `𝔽₃` is the largest one killed by the four reduced root-subgroup maps.
* `TauCeti.G2ShortRoot.PrimeField.groupScheme_eq_rootSubgroupGeneratedGroupScheme` and
  `TauCeti.G2ShortRoot.PrimeField.points_eq_rootSubgroupGeneratedPointsSubgroup`: the carrier and
  its matrix-valued points are those of the subgroup scheme generated by the root subgroups alone.
* `TauCeti.G2ShortRoot.PrimeField.groupScheme_hom_ext_of_rootSubgroup`: a morphism out of the
  carrier is determined by its restrictions to the four numbered simple root subgroups. Compare
  `TauCeti.G2ShortRoot.PrimeField.groupScheme_hom_ext`, where the weight torus is a second
  hypothesis because a generator of the presentation is in general independent.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, Section 3.
* R. W. Carter, *Simple Groups of Lie Type*, Sections 6.4 and 7.1.

The statements and their order follow the integral companion
`TauCeti.Algebra.Lie.G2.ShortRoot.IntegralToralClosure.Generation`; the scheme-theoretic step is the
generic one of
`TauCeti.Algebra.Lie.UniversalEnveloping.Kostant.RootSubgroup.Scheme.Generated.Torus`.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.G2ShortRoot

open TauCeti.DynkinType
open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

universe v

local notation "CM" => CartanMatrix.G₂
local notation "rootGen" => TauCeti.serreRootGenerator CM
local notation "cartanGen" => TauCeti.serreH ℚ CM

namespace PrimeField

/-- Every represented root-subgroup matrix over an `𝔽₃`-algebra is a point of the subgroup scheme
generated over `𝔽₃` by the four reduced root-subgroup coordinate maps alone. -/
private theorem kostantRootSubgroupMatrix_mem_rootSubgroupGeneratedPointsSubgroup
    (B : Type) [CommRing B] [Algebra (ZMod 3) B] (k : Fin 2 ⊕ Fin 2)
    (q : HopfAlgebra.points
      (R := ℤ) (H := AdditiveGroup.coordinateHopfAlgebra ℤ) (CommAlgCat.of ℤ B)) :
    kostantRootSubgroupMatrix rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k) latticeBasis q ∈
      TauCeti.GeneralLinear.generatedPointsSubgroup 7 (fun k => generator (.inl k)) B := by
  set u := AdditiveGroup.gaPointsMulEquiv (R := ℤ) (A := B) q with hu
  set q' := (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := B)).symm u with hq'
  have hq'param : AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := B) q' = u := by
    rw [hq', MulEquiv.apply_symm_apply]
  have hmatrix : kostantRootSubgroupMatrix rootGen cartanGen rep lattice.toAddSubgroup
      rep_kostantForm_mem_lattice k (isNilpotent_rep_serreRootGenerator k) latticeBasis q =
      TauCeti.GeneralLinear.pointsMulEquiv 7
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app
          (CommAlgCat.of (ZMod 3) B) q') := by
    rw [← coe_rootSubgroupPoints_gaPointsMulEquiv k B q', hq'param, coe_rootSubgroupPoints,
      IntegralToralClosure.coe_rootSubgroupPoints_eq_kostantRootSubgroupMatrix, hu,
      MulEquiv.symm_apply_apply]
  rw [hmatrix]
  exact TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup 7
    (fun k => generator (.inl k)) k B q'

/-- **The short-root type-`G₂` carrier over `𝔽₃` is cut out by its four numbered simple root
subgroups alone.** The reduced weight torus is a redundant generator: the defining Hopf ideal is
already the largest Hopf ideal of `O(GL₇/𝔽₃)` killed by the four reduced root-subgroup coordinate
maps. -/
theorem definingIdeal_eq_commonKernelHopfIdeal_rootSubgroup :
    definingIdeal = CommHopfAlgCat.commonKernelHopfIdeal (fun k => generator (.inl k)) := by
  rw [definingIdeal_def]
  refine le_antisymm ?_ ?_
  · rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
    exact fun k => CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker generator (.inl k)
  · rw [CommHopfAlgCat.le_commonKernelHopfIdeal_iff]
    rintro (k | ⟨⟩)
    · exact CommHopfAlgCat.commonKernelHopfIdeal_toIdeal_le_ker
        (fun k => generator (.inl k)) k
    · rw [generator_inr]
      exact commonKernelHopfIdeal_toIdeal_le_weightTorusBaseChange_ker
        rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
        isNilpotent_rep_serreRootGenerator latticeBasis weight (ZMod 3)
        (fun k => generator (.inl k))
        (fun k q => kostantRootSubgroupMatrix_mem_rootSubgroupGeneratedPointsSubgroup _ k q)
        (weightTorusSubgroup_le_elementarySubgroup _)

/-- The short-root type-`G₂` carrier over `𝔽₃` is the subgroup scheme of `GL₇` generated by its
four numbered simple root subgroups. -/
theorem groupScheme_eq_rootSubgroupGeneratedGroupScheme :
    groupScheme =
      TauCeti.GeneralLinear.generatedGroupScheme 7 (fun k => generator (.inl k)) := by
  rw [groupScheme_def, definingIdeal_eq_commonKernelHopfIdeal_rootSubgroup,
    TauCeti.GeneralLinear.generatedGroupScheme_def]

/-- The matrix-valued points of the carrier over `𝔽₃` are the points of the subgroup scheme
generated by its four numbered simple root subgroups. -/
theorem points_eq_rootSubgroupGeneratedPointsSubgroup (B : Type v) [CommRing B]
    [Algebra (ZMod 3) B] :
    points B = TauCeti.GeneralLinear.generatedPointsSubgroup 7
      (fun k => generator (.inl k)) B := by
  rw [points_eq_hopfIdealPointsSubgroup, definingIdeal_eq_commonKernelHopfIdeal_rootSubgroup,
    TauCeti.GeneralLinear.generatedPointsSubgroup_def]

/-- **Two morphisms from the carrier over `𝔽₃` to an affine group scheme presented as `hopfSpec Y`
agree as soon as they agree on all four numbered simple root subgroups.** Compare
`TauCeti.G2ShortRoot.PrimeField.groupScheme_hom_ext`, where agreement on the weight torus is a
second hypothesis because a generator of a presentation is in general independent of the others. -/
theorem groupScheme_hom_ext_of_rootSubgroup {Y : _root_.CommHopfAlgCat.{0} (ZMod 3)}
    (f g : groupScheme ⟶ (hopfSpec (CommRingCat.of (ZMod 3))).obj (Opposite.op Y))
    (hroot : ∀ k, rootSubgroup k ≫ f = rootSubgroup k ≫ g) : f = g := by
  apply (cancel_epi (eqToHom groupScheme_eq_commonKernelSpec.symm)).1
  refine CommHopfAlgCat.hom_ext_of_preimage_unop_eq _ _ ?_
  refine CommHopfAlgCat.hom_ext_of_le_iff_forall_toIdeal_le_ker
    (p := fun k => generator (.inl k)) (fun J => ?_)
    (c := fun k => CommHopfAlgCat.commonKernelLift generator (.inl k))
    (fun k => CommHopfAlgCat.mkQuotient_comp_commonKernelLift generator (.inl k)) _ _ fun k => ?_
  · rw [← definingIdeal_def, definingIdeal_eq_commonKernelHopfIdeal_rootSubgroup]
    exact CommHopfAlgCat.le_commonKernelHopfIdeal_iff (fun k => generator (.inl k)) J
  · refine CommHopfAlgCat.preimage_unop_comp_eq_of_hopfSpec_map_comp_eq _ _ _ ?_
    have hk := hroot k
    -- The two presentations of the carrier differ by `eqToHom`s between the same objects, which
    -- reassociate and collapse into the single transport the goal carries.
    rw [rootSubgroup_def, TauCeti.GeneralLinear.generatorToGeneratedGroupScheme_def] at hk
    simp only [Category.assoc, eqToHom_trans] at hk
    exact (cancel_epi (eqToHom (AdditiveGroup.groupScheme_def (ZMod 3)))).1 hk

end PrimeField

end TauCeti.G2ShortRoot
