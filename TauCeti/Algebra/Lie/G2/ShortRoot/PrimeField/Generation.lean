/-!
# Generation of the short-root type-G2 carrier over `𝔽₃` by root subgroups

The short-root type-`G₂` carrier over `𝔽₃` is the closed subgroup scheme of `GL₇` over `𝔽₃`
generated by the reductions of the four numbered positive and negative simple root subgroups and
of the rank-two weight torus of the integral toral closure. This file proves that the torus is
redundant: the carrier is already the subgroup scheme generated over `𝔽₃` by the four root
subgroups alone.

On points the statement is inherited from `ℤ`. A reduced generator is, as a matrix, the
corresponding point of the integral carrier, and over every commutative ring the integral weight
torus lies in the elementary subgroup generated by the integral root subgroups
(`TauCeti.G2ShortRoot.weightTorusSubgroup_le_elementarySubgroup`). So over every `𝔽₃`-algebra a
weight-torus point of the carrier is a product of its root-subgroup points. Testing this on the
universal point of the torus shows that the reduced torus kills the Hopf ideal cut out by the
reduced root subgroups, which is the scheme-theoretic statement.

This is an equality of subgroup schemes generated over `𝔽₃`, each with its maximal defining ideal
there; it does not compare the carrier with the base change of the integral one beyond the
containment already recorded. Its use is rigidity: a homomorphism out of the carrier is determined
by the four root subgroups, with no condition on the torus, so an endomorphism such as the special
isogeny in characteristic three is pinned by its equations on the numbered simple root subgroups
alone.

## Main results

* `TauCeti.G2ShortRoot.PrimeField.weightTorusPoints_range_le_closure_rootSubgroupPoints`: over
  every `𝔽₃`-algebra the weight torus lies in the subgroup generated by the four root subgroups.
* `TauCeti.G2ShortRoot.PrimeField.definingIdeal_eq_commonKernelHopfIdeal_generator_inl` and
  `TauCeti.G2ShortRoot.PrimeField.groupScheme_eq_generatedGroupScheme_generator_inl`: the carrier
  is cut out by the root subgroups alone.
* `TauCeti.G2ShortRoot.PrimeField.points_eq_generatedPointsSubgroup_generator_inl`: the same
  statement on matrix-valued points.
* `TauCeti.G2ShortRoot.PrimeField.groupScheme_hom_ext_of_rootSubgroup`: homomorphisms out of the
  carrier agreeing on the four root subgroups are equal.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, §§6.4 and 7.1.

The argument follows the integral statement in
`TauCeti.Algebra.Lie.G2.ShortRoot.IntegralToralClosure.Generation`.
-/

public section

open AlgebraicGeometry CategoryTheory

namespace TauCeti.G2ShortRoot

open TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing
attribute [local instance high] Algebra.toModule

universe v

local notation "CM" => CartanMatrix.G₂
local notation "rootGen" => TauCeti.serreRootGenerator CM
local notation "cartanGen" => TauCeti.serreH ℚ CM

namespace PrimeField

/-- **The weight torus of the carrier over `𝔽₃` is generated by its root subgroups**: over every
`𝔽₃`-algebra, each weight-torus point is a product of points of the four numbered positive and
negative simple root subgroups. -/
theorem weightTorusPoints_range_le_closure_rootSubgroupPoints (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] :
    (weightTorusPoints A).range ≤ Subgroup.closure (⋃ k, Set.range (rootSubgroupPoints k A)) := by
  rintro _ ⟨s, rfl⟩
  set C := Subgroup.closure (⋃ k, Set.range (rootSubgroupPoints k A))
  -- In `GL₇(A)`, the integral elementary subgroup lies in the image of `C`, because each
  -- integral root-subgroup matrix is the matrix of a root-subgroup point of the carrier.
  have hle : (kostantElementarySubgroup rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator (CommAlgCat.of ℤ A)).map
        (Units.map (LinearMap.toMatrixAlgEquiv (latticeBasis.baseChange A)).toMulEquiv) ≤
      C.map (points A).subtype := by
    refine map_kostantElementarySubgroup_le_of_matrix_mem rootGen cartanGen rep
      lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
      latticeBasis A fun k q ↦ ⟨rootSubgroupPoints k A (AdditiveGroup.gaPointsMulEquiv q),
        Subgroup.subset_closure (Set.mem_iUnion.2 ⟨k, _, rfl⟩), ?_⟩
    rw [Subgroup.coe_subtype, coe_rootSubgroupPoints,
      IntegralToralClosure.coe_rootSubgroupPoints_eq_kostantRootSubgroupMatrix,
      MulEquiv.symm_apply_apply]
  have hs : kostantTorusPoints lattice.toAddSubgroup latticeBasis weight A s ∈
      kostantElementarySubgroup rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator (CommAlgCat.of ℤ A) := by
    apply weightTorusSubgroup_le_elementarySubgroup
    rw [kostantTorusSubgroup_eq_range]
    exact ⟨s, rfl⟩
  obtain ⟨c, hc, hcs⟩ := hle ⟨_, hs, rfl⟩
  have hceq : c = weightTorusPoints A s := by
    apply Subtype.ext
    rw [coe_weightTorusPoints, IntegralToralClosure.coe_weightTorusPoints,
      ← basisMatrix_kostantTorusPoints, ← hcs, Subgroup.coe_subtype]
  rw [← hceq]
  exact hc

/-- Every point of the reduced weight-torus generator is a point of the subgroup scheme generated
by the four reduced root-subgroup generators. -/
private theorem pointsMulEquiv_mapPointsFunctor_generator_inr_mem (A : Type) [CommRing A]
    [Algebra (ZMod 3) A]
    (p : HopfAlgebra.points (R := ZMod 3) (H := generatorCodomain (.inr ()))
      (CommAlgCat.of (ZMod 3) A)) :
    GeneralLinear.pointsMulEquiv 7
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app
          (CommAlgCat.of (ZMod 3) A) p) ∈
      GeneralLinear.generatedPointsSubgroup 7 (fun k ↦ generator (.inl k)) A := by
  have hC : Subgroup.closure (⋃ k, Set.range (rootSubgroupPoints k A)) ≤
      (GeneralLinear.generatedPointsSubgroup 7 (fun k ↦ generator (.inl k)) A).comap
        (points A).subtype := by
    rw [Subgroup.closure_le]
    rintro _ ⟨_, ⟨k, rfl⟩, u, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.coe_subtype,
      ← MulEquiv.apply_symm_apply (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := A)) u,
      coe_rootSubgroupPoints_gaPointsMulEquiv]
    exact GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup 7
      (fun k ↦ generator (.inl k)) k A _
  rw [← coe_weightTorusPoints_pointsMulEquiv]
  exact hC (weightTorusPoints_range_le_closure_rootSubgroupPoints A ⟨_, rfl⟩)

/-- The reduced weight-torus generator kills the defining ideal of the subgroup scheme generated by
the four reduced root-subgroup generators. -/
private theorem commonKernelHopfIdeal_generator_inl_toIdeal_le_ker :
    (CommHopfAlgCat.commonKernelHopfIdeal fun k ↦ generator (.inl k)).toIdeal ≤
      RingHom.ker (generator (.inr ())).hom.toAlgHom.toRingHom :=
  GeneralLinear.commonKernelHopfIdeal_toIdeal_le_ker_of_mapPointsFunctor_mem 7 _ _
    pointsMulEquiv_mapPointsFunctor_generator_inr_mem

/-- **The carrier over `𝔽₃` is cut out by its root subgroups alone**: adjoining the weight torus
to the four reduced root-subgroup generators does not change the defining Hopf ideal. -/
theorem definingIdeal_eq_commonKernelHopfIdeal_generator_inl :
    definingIdeal = CommHopfAlgCat.commonKernelHopfIdeal (fun k ↦ generator (.inl k)) := by
  rw [definingIdeal_def]
  exact CommHopfAlgCat.commonKernelHopfIdeal_eq_of_toIdeal_le_ker generator
    fun ⟨⟩ ↦ commonKernelHopfIdeal_generator_inl_toIdeal_le_ker

/-- **The short-root type-`G₂` carrier over `𝔽₃` is generated by its four numbered root
subgroups.** -/
theorem groupScheme_eq_generatedGroupScheme_generator_inl :
    groupScheme = GeneralLinear.generatedGroupScheme 7 (fun k ↦ generator (.inl k)) := by
  rw [groupScheme_eq_generatedGroupScheme]
  exact GeneralLinear.generatedGroupScheme_eq_of_toIdeal_le_ker 7 generator
    fun ⟨⟩ ↦ commonKernelHopfIdeal_generator_inl_toIdeal_le_ker

/-- The points of the carrier over `𝔽₃` are the points of the subgroup scheme generated by the
four reduced root subgroups. -/
theorem points_eq_generatedPointsSubgroup_generator_inl (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] :
    points A = GeneralLinear.generatedPointsSubgroup 7 (fun k ↦ generator (.inl k)) A := by
  rw [points_eq_hopfIdealPointsSubgroup, definingIdeal_eq_commonKernelHopfIdeal_generator_inl,
    GeneralLinear.generatedPointsSubgroup_def]

/-- **Rigidity on the root subgroups alone.** Two morphisms from the carrier over `𝔽₃` to an
affine group scheme presented as `hopfSpec Y` agree when they agree on all four numbered simple
root subgroups. Compare `TauCeti.G2ShortRoot.PrimeField.groupScheme_hom_ext`, which also asks for
agreement on the weight torus. -/
@[ext high]
theorem groupScheme_hom_ext_of_rootSubgroup {Y : _root_.CommHopfAlgCat.{0} (ZMod 3)}
    (f g : groupScheme ⟶ (hopfSpec (CommRingCat.of (ZMod 3))).obj (Opposite.op Y))
    (hroot : ∀ k, rootSubgroup k ≫ f = rootSubgroup k ≫ g) : f = g := by
  apply (cancel_epi (eqToHom groupScheme_eq_generatedGroupScheme.symm)).1
  refine GeneralLinear.generatedGroupScheme_hom_ext_of_toIdeal_le_ker 7 generator
    (fun ⟨⟩ ↦ commonKernelHopfIdeal_generator_inl_toIdeal_le_ker) _ _ fun k ↦ ?_
  have hk := hroot k
  rw [rootSubgroup_def, Category.assoc, Category.assoc] at hk
  exact (cancel_epi (eqToHom (AdditiveGroup.groupScheme_def (ZMod 3)))).1 hk

end PrimeField

end TauCeti.G2ShortRoot
