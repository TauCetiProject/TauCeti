module

public import TauCeti.Algebra.Lie.G2.ShortRoot.IntegralToralClosure.RankOne
public import TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.PointsFunctor

/-!
# Rank-one maps into the characteristic-three short-root G₂ carrier

Over a field of characteristic three, the ring-level rank-one maps of
`TauCeti.Algebra.Lie.G2.ShortRoot.IntegralToralClosure.RankOne` land in the short-root G₂
carrier generated over 𝔽₃. Their images are precisely the subgroups generated by the corresponding
opposite simple-root families. This constructs the rank-one groups with their prescribed parameters;
it does not identify the carrier with an independently pinned simply connected group.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3.
* R. W. Carter, *Simple Groups of Lie Type*, §6.4.
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plate IX.

The carrier containment and exact-image argument follow
`TauCeti.Algebra.Lie.E7.Minuscule.RankOne`, using Mathlib's SL₂ transvection induction.
-/

public section

open scoped Matrix MatrixGroups

namespace TauCeti.G2ShortRoot.PrimeField

variable (K : Type*) [Field K] [Algebra (ZMod 3) K] (i : Fin 2)

private theorem rankOneGL_mem_of_rootSubgroupPoints_mem {H : Subgroup (GL (Fin 7) K)}
    (hpos : ∀ t : K, (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) :
      GL (Fin 7) K) ∈ H)
    (hneg : ∀ t : K, (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) :
      GL (Fin 7) K) ∈ H) (g : SL(2, K)) : rankOneGL K i g ∈ H := by
  induction g using Matrix.SL2.transvection_induction with
  | htransvec a b hab t =>
    fin_cases a <;> fin_cases b
    · exact (hab rfl).elim
    · rw [rankOneGL_upper_transvection, ← coe_rootSubgroupPoints]
      exact hpos t
    · rw [rankOneGL_lower_transvection, ← coe_rootSubgroupPoints]
      exact hneg t
    · exact (hab rfl).elim
  | hmul g h hg hh => simpa only [map_mul] using mul_mem hg hh

/-- The numbered SL₂ map into the characteristic-three short-root carrier. The image consists
of products of the two opposite simple-root parameter families. -/
noncomputable def rankOnePoints : SL(2, K) →* points K :=
  (rankOneGL K i).codRestrict (points K)
    (rankOneGL_mem_of_rootSubgroupPoints_mem K i
      (fun t => (rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t)).property)
      (fun t => (rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t)).property))

/-- The carrier-valued rank-one map has the explicit polynomial matrix action. -/
@[simp]
theorem coe_rankOnePoints (g : SL(2, K)) :
    (rankOnePoints K i g : GL (Fin 7) K) = rankOneGL K i g := by
  rw [rankOnePoints, MonoidHom.codRestrict_apply]

/-- The rank-one map into the carrier is faithful, also in characteristic three. -/
theorem rankOnePoints_injective : Function.Injective (rankOnePoints K i) := by
  rw [rankOnePoints, MonoidHom.injective_codRestrict]
  exact rankOneGL_injective i

/-- Upper transvections map to the numbered positive-root points with unchanged parameters. -/
@[simp]
theorem rankOnePoints_upper_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 2) ≠ 1) t) =
      rootSubgroupPoints (.inl i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneGL_upper_transvection, coe_rootSubgroupPoints]

/-- Lower transvections map to the numbered negative-root points with unchanged parameters. -/
@[simp]
theorem rankOnePoints_lower_transvection (t : K) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 2) ≠ 0) t) =
      rootSubgroupPoints (.inr i) K (Multiplicative.ofAdd t) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneGL_lower_transvection, coe_rootSubgroupPoints]

/-- The diagonal of the numbered SL₂ maps to the corresponding simple-coroot value. -/
@[simp]
theorem rankOnePoints_diag2nUnit (u : Kˣ) :
    rankOnePoints K i (Matrix.SpecialLinearGroup.diag2nUnit
      (by decide : (0 : Fin 2) ≠ 1) u) = weightTorusPoints K (Pi.mulSingle i u) := by
  apply Subtype.ext
  rw [coe_rankOnePoints, rankOneGL_diag2nUnit, coe_weightTorusPoints]

/-- The image is exactly the subgroup generated by the two opposite simple-root families.
No assertion about generation of the full G₂ carrier is part of this rank-one statement. -/
theorem range_rankOnePoints :
    (rankOnePoints K i).range = Subgroup.closure
      (Set.range (rootSubgroupPoints (.inl i) K) ∪
        Set.range (rootSubgroupPoints (.inr i) K)) := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← Subgroup.mem_map_iff_mem (points K).subtype_injective, Subgroup.subtype_apply,
      coe_rankOnePoints]
    apply rankOneGL_mem_of_rootSubgroupPoints_mem K i
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_left _ (Set.mem_range_self (Multiplicative.ofAdd t))), rfl⟩
    · intro t
      exact Subgroup.mem_map.mpr ⟨_, Subgroup.subset_closure
        (Set.mem_union_right _ (Set.mem_range_self (Multiplicative.ofAdd t))), rfl⟩
  · rw [Subgroup.closure_le]
    rintro _ (⟨t, rfl⟩ | ⟨t, rfl⟩)
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 2) ≠ 1)
        (Multiplicative.toAdd t), by simp⟩
    · exact ⟨Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0)
        (Multiplicative.toAdd t), by simp⟩

end TauCeti.G2ShortRoot.PrimeField
