/-!
# The positive short-root G₂ subgroup is a Borel subgroup

The positive subgroup of the short-root type-`G₂` carrier over `𝔽₃`, generated by the two positive
numbered simple-root subgroups and the weight torus, is a Borel subgroup of the carrier: it is
smooth over `𝔽₃`, and on every geometric fiber it is maximal among smooth, connected, solvable
closed subgroups.

Over an algebraically closed field `k` of characteristic three, let `B` be such a subgroup of the
scalar-extended carrier containing the positive subgroup. Lie--Kolchin, together with the rigidity
of the positive subgroup's invariant flags, puts `B` inside the upper-triangular subgroup of `GL₇`
(`upperTriangular_le_comapOfSurjective_of_isBorelCandidate_of_le`). The universal point of `B`,
valued in its coordinate algebra `k[B]`, is therefore an upper-triangular carrier point. Over
every `𝔽₃`-algebra containing an element `λ` with `λ³ - λ` a unit, such points are exactly the
points of the positive subgroup (`points_inf_upperTriangularGroup_eq`), and `k` supplies such an
element. So the universal point of `B` lies in the positive subgroup, which is the reverse
containment of subgroup schemes. Testing the universal point rather than rational points makes
this identification of the carrier's upper-triangular intersection with the positive subgroup
scheme-theoretic, over every such `𝔽₃`-algebra.

The transport from the scalar extension back to `𝔽₃`, through
`HopfIdeal.IsBorelOverAlgClosed.of_map_eq` and
`CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective`, follows the general-linear Borel argument
in `TauCeti.Algebra.AlgebraicGroup.GeneralLinear.UpperTriangular.Borel` and the type-`E₆`
base-change comparison in `TauCeti.Algebra.Lie.E6.Minuscule.Generated.Positive.BaseChange`.

## Main declarations

* `TauCeti.G2ShortRoot.PrimeField.Positive.generatedPositiveDefiningIdeal_le_of_upperTriangular_le`:
  over a commutative `𝔽₃`-algebra containing `λ` with `λ³ - λ` a unit, a closed subgroup of the
  scalar-extended carrier lying in the upper-triangular subgroup of `GL₇` lies in the positive
  subgroup.
* `TauCeti.G2ShortRoot.PrimeField.Positive.isBorelCandidate_generatedPositiveDefiningIdeal`: the
  scalar-extended positive subgroup is a Borel candidate of the scalar-extended carrier.
* `TauCeti.G2ShortRoot.PrimeField.Positive.isBorelOverAlgClosed_generatedPositiveDefiningIdeal`:
  over an algebraically closed field of characteristic three it is a Borel subgroup.
* `TauCeti.G2ShortRoot.PrimeField.Positive.map_baseChangeHopfIdeal_positiveDefiningIdeal`: the
  scalar extension of the positive ideal is the positive ideal of the scalar-extended carrier.
* `TauCeti.G2ShortRoot.PrimeField.isBorelOver_positiveDefiningIdeal`: the positive subgroup is a
  Borel subgroup of the carrier over `𝔽₃`, smooth with Borel geometric fibers.
* `TauCeti.G2ShortRoot.PrimeField.isBorel_positiveDefiningIdeal`: in particular it is a Borel
  subgroup over the field `𝔽₃`.

## References

* J. E. Humphreys, *Linear Algebraic Groups*, §§21–22 and 26.
* J. S. Milne, *Algebraic Groups* (2017), Theorem 16.30 and §17.a.
* B. Conrad, *Reductive Group Schemes* (2014), §5.2.
-/

public section

open CategoryTheory WithConv

namespace TauCeti.G2ShortRoot.PrimeField

noncomputable section

universe u

namespace Positive

section ScalarExtension

variable (k : Type u) [Field k] [Algebra (ZMod 3) k]

/-- The scalar-extended positive subgroup is a Borel candidate of the scalar-extended carrier: it
is smooth, geometrically connected and geometrically solvable. -/
theorem isBorelCandidate_generatedPositiveDefiningIdeal :
    HopfIdeal.IsBorelCandidate k (finiteTypeGeneratedCoordinateHopfAlgebra k)
      (generatedPositiveDefiningIdeal k) := by
  rw [generatedPositiveDefiningIdeal_def]
  -- The quotient is the scalar extension of the positive subgroup's coordinate algebra.
  let e := CommHopfAlgCat.Hom.quotientKerOfSurjectiveIso (generatedPositiveRestriction k)
    (generatedPositiveRestriction_surjective k)
  refine HopfIdeal.IsBorelCandidate.mk ?_ ?_ ?_
  · exact (smoothCommHopfAlgProperty k).prop_of_iso e.symm
      ((smoothCommHopfAlgProperty_iff _).mpr inferInstance)
  · exact (geometricallyConnectedCommHopfAlgProperty k).prop_of_iso e.symm
      (geometricallyConnectedCommHopfAlgProperty.baseChange (ZMod 3) k _
        geometricallyConnected_coordinateHopfAlgebra)
  · exact (geometricallySolvablePointsCommHopfAlgProperty k).prop_of_iso e.symm
      (geometricallySolvablePointsCommHopfAlgProperty.baseChange _
        geometricallySolvablePoints_coordinateHopfAlgebra)

end ScalarExtension

section Intersection

variable (k : Type u) [CommRing k] [Algebra (ZMod 3) k]

/-- **Closed subgroups of the upper-triangular carrier lie in the positive subgroup**,
scheme-theoretically: over a commutative `𝔽₃`-algebra containing an element `λ` with `λ³ - λ` a
unit, every closed subgroup of the scalar-extended carrier lying in the upper-triangular subgroup
of `GL₇` lies in the positive subgroup. In Hopf ideals the containment is reversed. -/
theorem generatedPositiveDefiningIdeal_le_of_upperTriangular_le {l : k}
    (hl : IsUnit (l ^ 3 - l)) (J : HopfIdeal k (generatedCoordinateHopfAlgebra k))
    (hJ : GeneralLinear.UpperTriangular.definingHopfIdeal k 7 ≤
      J.comapOfSurjective (generatedCoordinateMap k).hom (generatedCoordinateMap_surjective k)) :
    generatedPositiveDefiningIdeal k ≤ J := by
  let Q := CommHopfAlgCat.quotient (generatedCoordinateHopfAlgebra k) J
  let _ : Algebra (ZMod 3) Q := Algebra.compHom Q (algebraMap (ZMod 3) k)
  let _ : IsScalarTower (ZMod 3) k Q := IsScalarTower.of_algebraMap_eq' rfl
  let eGL := GeneralLinear.coordinateHopfAlgebraBaseChangeIso (ZMod 3) k 7
  -- The universal point of the candidate, read in `O(GL₇/k)` and then over `𝔽₃`.
  let χ : GeneralLinear.coordinateHopfAlgebra k 7 ⟶ Q :=
    generatedCoordinateMap k ≫ CommHopfAlgCat.mkQuotient _ J
  let p : HopfAlgebra.points (R := ZMod 3) (H := GeneralLinear.coordinateHopfAlgebra (ZMod 3) 7)
      (CommAlgCat.of (ZMod 3) Q) :=
    (AlgHom.baseChangePointsMulEquiv (k := ZMod 3) (K := k) (R := Q)).symm
      (toConv (eGL.hom ≫ χ).hom.toAlgHom)
  -- Membership of `p` in a subgroup cut out over `𝔽₃` is vanishing of `χ` on the base change.
  have hmem (I : HopfIdeal (ZMod 3) (GeneralLinear.coordinateHopfAlgebra (ZMod 3) 7)) :
      p ∈ CommHopfAlgCat.quotientPointsSubgroup _ I (CommAlgCat.of (ZMod 3) Q) ↔
        ∀ y ∈ CommHopfAlgCat.baseChangeHopfIdeal (K := k) I, χ.hom (eGL.hom.hom y) = 0 := by
    rw [CommHopfAlgCat.mem_quotientPointsSubgroup_iff_baseChangePointsMulEquiv_mem (K := k),
      MulEquiv.apply_symm_apply, CommHopfAlgCat.mem_quotientPointsSubgroup_iff]
    simp only [BialgHom.coe_toAlgHom, _root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply]
  -- `p` is a carrier point, since `χ` kills the generated defining ideal.
  have hcarrier : p ∈ CommHopfAlgCat.quotientPointsSubgroup _ PrimeField.definingIdeal
      (CommAlgCat.of (ZMod 3) Q) := by
    refine (hmem _).mpr fun y hy ↦ ?_
    have hy' : eGL.hom.hom y ∈ generatedDefiningIdeal k := by
      rw [← baseChangeDefiningIdeal_eq_generatedDefiningIdeal, baseChangeDefiningIdeal_def,
        HopfIdeal.mem_comapOfSurjective]
      exact (_root_.CommHopfAlgCat.inv_hom_apply eGL y).symm ▸ hy
    have h0 : (generatedCoordinateMap k).hom (eGL.hom.hom y) = 0 := by
      rw [← RingHom.mem_ker, generatedCoordinateMap_ker]
      exact hy'
    simp only [χ, _root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply, h0, map_zero]
  -- `p` is upper triangular, since the candidate lies in the upper-triangular subgroup.
  have hupper : p ∈ CommHopfAlgCat.quotientPointsSubgroup _
      (GeneralLinear.UpperTriangular.definingHopfIdeal (ZMod 3) 7)
      (CommAlgCat.of (ZMod 3) Q) := by
    refine (hmem _).mpr fun y hy ↦ ?_
    have hy' : eGL.hom.hom y ∈ GeneralLinear.UpperTriangular.definingHopfIdeal k 7 := by
      rw [← GeneralLinear.UpperTriangular.map_baseChangeHopfIdeal_definingHopfIdeal (ZMod 3) k]
      exact HopfIdeal.mem_map_of_mem _ hy
    have hJy := HopfIdeal.mem_comapOfSurjective.mp (hJ hy')
    simp only [χ, _root_.CommHopfAlgCat.hom_comp, BialgHom.comp_apply]
    exact (CommHopfAlgCat.mkQuotient_eq_zero_iff _ _ _).mpr hJy
  -- Hence `p` is a point of the positive subgroup.
  have hunit : IsUnit ((algebraMap k Q l) ^ 3 - algebraMap k Q l) := by
    rw [← map_pow, ← map_sub]
    exact hl.map _
  have hpos : GeneralLinear.pointsMulEquiv 7 p ∈
      GeneralLinear.hopfIdealPointsSubgroup 7 definingIdeal Q := by
    rw [← points_inf_upperTriangularGroup_eq hunit, points_eq_hopfIdealPointsSubgroup,
      ← GeneralLinear.UpperTriangular.hopfIdealPointsSubgroup_eq (ZMod 3)]
    exact Subgroup.mem_inf.mpr
      ⟨GeneralLinear.pointsMulEquiv_mem_hopfIdealPointsSubgroup 7 _ Q p hcarrier,
        GeneralLinear.pointsMulEquiv_mem_hopfIdealPointsSubgroup 7 _ Q p hupper⟩
  rw [GeneralLinear.mem_hopfIdealPointsSubgroup_iff, MulEquiv.symm_apply_apply,
    ← CommHopfAlgCat.mem_quotientPointsSubgroup_iff, hmem] at hpos
  -- Vanishing on the base-changed positive ideal is the reverse containment.
  intro x hx
  obtain ⟨z, rfl⟩ := generatedCoordinateMap_surjective k x
  have hz : z ∈ (generatedPositiveDefiningIdeal k).comapOfSurjective (generatedCoordinateMap k).hom
      (generatedCoordinateMap_surjective k) := HopfIdeal.mem_comapOfSurjective.mpr hx
  rw [comapOfSurjective_generatedPositiveDefiningIdeal_eq_ker_standardCoordinateMap,
    HopfIdeal.mem_kerOfSurjective, standardCoordinateMap_def, CommHopfAlgCat.comp_apply,
    ← CommHopfAlgCat.mem_baseChangeHopfIdeal_iff] at hz
  have hχ := hpos _ hz
  rw [CommHopfAlgCat.hom_inv_apply] at hχ
  exact (CommHopfAlgCat.mkQuotient_eq_zero_iff _ _ _).mp hχ

end Intersection

section AlgebraicallyClosed

variable (k : Type u) [Field k] [Algebra (ZMod 3) k] [IsAlgClosed k]

/-- **The scalar-extended positive subgroup is a Borel subgroup** over every algebraically closed
field of characteristic three: it is maximal among smooth, connected, solvable closed subgroups of
the scalar-extended carrier. -/
theorem isBorelOverAlgClosed_generatedPositiveDefiningIdeal :
    HopfIdeal.IsBorelOverAlgClosed k (finiteTypeGeneratedCoordinateHopfAlgebra k)
      (generatedPositiveDefiningIdeal k) := by
  refine (HopfIdeal.isBorelOverAlgClosed_iff _ _ _).mpr ⟨inferInstance,
    isBorelCandidate_generatedPositiveDefiningIdeal k,
    fun J hJ hle ↦ ?_⟩
  -- `k` is infinite, so it has an element `λ ∉ {0, 1, -1}`, and then `λ³ - λ` is nonzero.
  classical
  obtain ⟨l, hl⟩ := Infinite.exists_notMem_finset ({0, 1, -1} : Finset k)
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hl
  have hl3 : l ^ 3 - l ≠ 0 := by
    rw [show l ^ 3 - l = l * (l - 1) * (l + 1) by ring]
    exact mul_ne_zero (mul_ne_zero hl.1 (sub_ne_zero.mpr hl.2.1))
      (by rw [ne_eq, add_eq_zero_iff_eq_neg]; exact hl.2.2)
  exact generatedPositiveDefiningIdeal_le_of_upperTriangular_le k (Ne.isUnit hl3) J
    (upperTriangular_le_comapOfSurjective_of_isBorelCandidate_of_le k J hJ hle)

end AlgebraicallyClosed

/-- The scalar extension of the positive subgroup's ideal is the positive ideal of the
scalar-extended carrier, through the identification of that carrier with the generated
subgroup. -/
@[simp]
theorem map_baseChangeHopfIdeal_positiveDefiningIdeal (k : Type u) [CommRing k]
    [Algebra (ZMod 3) k] :
    (CommHopfAlgCat.baseChangeHopfIdeal (K := k) positiveDefiningIdeal).map
        (coordinateHopfAlgebraGeneratedIso k).hom.hom =
      generatedPositiveDefiningIdeal k := by
  rw [positiveDefiningIdeal_def, generatedPositiveDefiningIdeal_def]
  exact CommHopfAlgCat.map_baseChangeHopfIdeal_kerOfSurjective
    (coordinateHopfAlgebraGeneratedIso k) (Iso.refl _) _
    (generatedPositiveRestriction_surjective k)
    (by rw [generatedPositiveRestriction_def, Iso.refl_hom, Category.comp_id])

end Positive

/-- **The positive subgroup is a Borel subgroup of the short-root G₂ carrier over `𝔽₃`**: it is
smooth over `𝔽₃`, and on every geometric fiber it is maximal among smooth, connected, solvable
closed subgroups. -/
theorem isBorelOver_positiveDefiningIdeal :
    HopfIdeal.IsBorelOver (ZMod 3) carrierAlgebra positiveDefiningIdeal := by
  refine HopfIdeal.IsBorelOver.mk ?_ fun k _ _ _ ↦ ?_
  · exact (smoothCommHopfAlgProperty_iff _).mp isBorelCandidate_positiveDefiningIdeal.smooth
  · let e : FiniteTypeCommHopfAlgCat.baseChange (K := k) finiteTypeCarrierAlgebra ≅
        finiteTypeGeneratedCoordinateHopfAlgebra k :=
      ObjectProperty.isoMk _ (coordinateHopfAlgebraGeneratedIso k)
    exact HopfIdeal.IsBorelOverAlgClosed.of_map_eq e
      (Positive.map_baseChangeHopfIdeal_positiveDefiningIdeal k)
      (Positive.isBorelOverAlgClosed_generatedPositiveDefiningIdeal k)

/-- **The positive subgroup is a Borel subgroup of the short-root G₂ carrier** over the field
`𝔽₃`. -/
theorem isBorel_positiveDefiningIdeal :
    HopfIdeal.IsBorel (ZMod 3) carrierAlgebra positiveDefiningIdeal :=
  isBorelOver_positiveDefiningIdeal.isBorel

end

end TauCeti.G2ShortRoot.PrimeField
