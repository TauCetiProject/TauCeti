module

public import TauCeti.Algebra.Lie.G2.ShortRoot.CrossProduct.Unitriangular
public import TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.DiagonalFactor
public import TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Positive.Borel.Candidate
public import TauCeti.LinearAlgebra.Matrix.GeneralLinearGroup.UpperUnitriangular.Basic

/-!
# Upper-triangular points of the short-root G₂ carrier

Let `A` be a commutative `𝔽₃`-algebra containing an element `λ` for which `λ³ - λ` is a unit,
for instance a field of characteristic three other than `𝔽₃`. This file proves that the
upper-unitriangular points of the short-root type-`G₂` carrier over `A` form exactly the
subgroup generated by the two positive simple-root subgroups `x_{α₁}` and `x_{α₂}`, and that its
upper-triangular points form exactly the subgroup generated by these together with the weight
torus.

An upper-unitriangular carrier point preserves the cross product, so it is the six-parameter
normal form `TauCeti.G2ShortRoot.crossUnipotentMatrix a b c d e f`, whose parameters sit at the
root positions of `α₁`, `α₂`, `α₁ + α₂`, `2α₁ + α₂`, `3α₁ + α₂` and `3α₁ + 2α₂`. The simple
root points are the normal forms at `(t, 0, 0, 0, 0, 0)` and `(0, t, 0, 0, 0, 0)`. Their
commutator is

```text
[x_{α₁}(t), x_{α₂}(u)] = N(0, 0, t u, -t² u, t³ u, -t³ u²),
```

and conjugating it by the simple root points isolates the parameters of `2α₁ + α₂` and of
`3α₁ + 2α₂`. In characteristic three the commutator relations do not produce the long root
`3α₁ + α₂` on its own, since its parameter `t³ u` is tied to the parameter `t u` of `α₁ + α₂`.
The quotient of the commutators at `(λ, u)` and `(1, λ u)` separates the two, leaving
`(λ³ - λ) u` in the `3α₁ + α₂` coordinate, and this is where the hypothesis on `λ` enters.
Over `𝔽₃` itself every element satisfies `λ³ = λ`, and a finite computation outside Lean shows
that there the simple root points generate a subgroup of index three in the group of the `3⁶`
upper-unitriangular normal forms.

The upper-triangular statement then follows from the diagonal factorization
`TauCeti.G2ShortRoot.PrimeField.existsUnique_weightTorusPoints_isUpperUnitriangular`.

The positive subgroup scheme of the carrier is generated by the same root subgroups and weight
torus, so the upper-triangular carrier points are exactly its points. Over an algebraically closed
field, a Borel candidate containing it is upper triangular by the overgroup theorem of
`TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Positive.CarrierOvergroup`, so the identification
here is the pointwise input for the Borel maximality of the positive subgroup in
`TauCeti.Algebra.Lie.G2.ShortRoot.PrimeField.Positive.Borel.Basic`. No identification of the carrier
with an independently pinned group scheme is asserted here.

## Main results

* `TauCeti.G2ShortRoot.PrimeField.coe_rootSubgroupPoints_inl_zero_eq_crossUnipotentMatrix` and
  `TauCeti.G2ShortRoot.PrimeField.coe_rootSubgroupPoints_inl_one_eq_crossUnipotentMatrix`: the
  positive simple root points in normal form.
* `TauCeti.G2ShortRoot.PrimeField.comap_upperUnitriangularGroup_eq_closure`: the
  upper-unitriangular carrier points are generated by the positive simple root points.
* `TauCeti.G2ShortRoot.PrimeField.comap_upperTriangularGroup_eq_closure`: the upper-triangular
  carrier points are generated by the positive simple root points and the weight torus.
* `TauCeti.G2ShortRoot.PrimeField.points_inf_upperTriangularGroup_eq`: the upper-triangular
  carrier points are the points of the positive subgroup.

## References

* R. Steinberg, *Lectures on Chevalley Groups*, §3 (generation of the unipotent radical by root
  subgroups and the commutator relations).
* R. W. Carter, *Simple Groups of Lie Type*, §5.2 (Chevalley's commutator formula).
* N. Bourbaki, *Lie Groups and Lie Algebras, Chapters 4--6*, Plate IX.
-/

public section

open Matrix

namespace TauCeti.G2ShortRoot.PrimeField

variable {A : Type*} [CommRing A] [Algebra (ZMod 3) A]

/-- The positive short simple-root point `x_{α₁}(t)` is the normal form with parameters
`(t, 0, 0, 0, 0, 0)`. -/
theorem coe_rootSubgroupPoints_inl_zero_eq_crossUnipotentMatrix (t : A) :
    ((rootSubgroupPoints (.inl 0) A (Multiplicative.ofAdd t) : GL (Fin 7) A) :
      Matrix (Fin 7) (Fin 7) A) = crossUnipotentMatrix t 0 0 0 0 0 := by
  rw [coe_rootSubgroupPoints, IntegralToralClosure.coe_rootSubgroupPoints_inl_zero,
    crossUnipotentMatrix_def]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- The positive long simple-root point `x_{α₂}(t)` is the normal form with parameters
`(0, t, 0, 0, 0, 0)`. -/
theorem coe_rootSubgroupPoints_inl_one_eq_crossUnipotentMatrix (t : A) :
    ((rootSubgroupPoints (.inl 1) A (Multiplicative.ofAdd t) : GL (Fin 7) A) :
      Matrix (Fin 7) (Fin 7) A) = crossUnipotentMatrix 0 t 0 0 0 0 := by
  rw [coe_rootSubgroupPoints, IntegralToralClosure.coe_rootSubgroupPoints_inl_one,
    crossUnipotentMatrix_def]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-! ## Normal forms realized by positive root words -/

/-- The normal form with the given parameters is the matrix of a carrier point in the subgroup
generated by the positive simple-root points. -/
private def IsPositiveWord (a b c d e f : A) : Prop :=
  ∃ h ∈ Subgroup.closure (⋃ i : Fin 2, Set.range (rootSubgroupPoints (.inl i) A)),
    ((h : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A) = crossUnipotentMatrix a b c d e f

private theorem isPositiveWord_short (t : A) : IsPositiveWord t 0 0 0 0 0 :=
  ⟨rootSubgroupPoints (.inl 0) A (Multiplicative.ofAdd t),
    Subgroup.subset_closure (Set.mem_iUnion.2 ⟨0, Set.mem_range_self _⟩),
    coe_rootSubgroupPoints_inl_zero_eq_crossUnipotentMatrix t⟩

private theorem isPositiveWord_long (t : A) : IsPositiveWord 0 t 0 0 0 0 :=
  ⟨rootSubgroupPoints (.inl 1) A (Multiplicative.ofAdd t),
    Subgroup.subset_closure (Set.mem_iUnion.2 ⟨1, Set.mem_range_self _⟩),
    coe_rootSubgroupPoints_inl_one_eq_crossUnipotentMatrix t⟩

private theorem IsPositiveWord.of_eq {a b c d e f a' b' c' d' e' f' : A}
    (h : IsPositiveWord a b c d e f) (ha : a = a') (hb : b = b') (hc : c = c') (hd : d = d')
    (he : e = e') (hf : f = f') : IsPositiveWord a' b' c' d' e' f' := by
  subst ha hb hc hd he hf
  exact h

private theorem IsPositiveWord.mul {a b c d e f a' b' c' d' e' f' : A}
    (h : IsPositiveWord a b c d e f) (h' : IsPositiveWord a' b' c' d' e' f') :
    IsPositiveWord (a + a') (b + b') (c + c' + a * b') (d + d' + a * a' * b' - a * c' + c * a')
      (e + e' + a * a' ^ 2 * b' - a * a' * c' - a * d' + c * a' ^ 2 + 2 * d * a')
      (f + f' + a * a' * b' * c' - a * b' * d' - a * c' ^ 2 + c * a' * c' - c * d' +
        2 * d * c' + e * b') := by
  obtain ⟨g, hg, hgM⟩ := h
  obtain ⟨g', hg', hg'M⟩ := h'
  refine ⟨g * g', mul_mem hg hg', ?_⟩
  rw [Subgroup.coe_mul, Units.val_mul, hgM, hg'M, crossUnipotentMatrix_mul_crossUnipotentMatrix]

private theorem IsPositiveWord.inv {a b c d e f : A} (h : IsPositiveWord a b c d e f) :
    IsPositiveWord (-a) (-b) (a * b - c) (-d) (a * d - e) (-a * b * d + b * e + c * d - f) := by
  obtain ⟨g, hg, hgM⟩ := h
  refine ⟨g⁻¹, inv_mem hg, ?_⟩
  rw [Subgroup.coe_inv]
  exact Units.inv_eq_of_mul_eq_one_right
    (by rw [hgM, crossUnipotentMatrix_mul_crossUnipotentMatrix_eq_one])

private theorem three_eq_zero : (3 : A) = 0 := by
  have h := map_natCast (algebraMap (ZMod 3) A) 3
  rwa [ZMod.natCast_self, map_zero, Nat.cast_ofNat, eq_comm] at h

/-- The commutator `[x_{α₁}(t), x_{α₂}(u)]`, in normal form. -/
private theorem isPositiveWord_commutator (t u : A) :
    IsPositiveWord 0 0 (t * u) (-t ^ 2 * u) (t ^ 3 * u) (-t ^ 3 * u ^ 2) :=
  ((((isPositiveWord_short t).mul (isPositiveWord_long u)).mul (isPositiveWord_short (-t))).mul
    (isPositiveWord_long (-u))).of_eq (by ring) (by ring) (by ring) (by ring) (by ring) (by ring)

/-- The root element of `2α₁ + α₂`: conjugating `[x_{α₁}(1), x_{α₂}(1)]` by `x_{α₁}(s)` moves
it by `x_{2α₁+α₂}(s)` in characteristic three. -/
private theorem isPositiveWord_twoShortAddLong (s : A) : IsPositiveWord 0 0 0 s 0 0 := by
  have hC := isPositiveWord_commutator (A := A) 1 1
  exact ((((isPositiveWord_short s).mul hC).mul (isPositiveWord_short (-s))).mul hC.inv).of_eq
    (by ring) (by ring) (by ring) (by linear_combination (-s) * three_eq_zero (A := A))
    (by linear_combination (s ^ 2 + s) * three_eq_zero (A := A))
    (by linear_combination s * three_eq_zero (A := A))

/-- The root element of `3α₁ + 2α₂`: conjugating `[x_{α₁}(1), x_{α₂}(1)]` by `x_{α₂}(-s)` moves
it by `x_{3α₁+2α₂}(s)`. -/
private theorem isPositiveWord_threeShortAddTwoLong (s : A) : IsPositiveWord 0 0 0 0 0 s := by
  have hC := isPositiveWord_commutator (A := A) 1 1
  exact ((((isPositiveWord_long (-s)).mul hC).mul (isPositiveWord_long s)).mul hC.inv).of_eq
    (by ring) (by ring) (by ring) (by ring) (by ring) (by ring)

/-- The root element of `3α₁ + α₂`, separated from that of `α₁ + α₂` by the quotient of the
commutators at `(λ, u)` and `(1, λ u)`, with `u = x / (λ³ - λ)`. -/
private theorem isPositiveWord_threeShortAddLong {l m : A} (hlm : m * (l ^ 3 - l) = 1) (x : A) :
    IsPositiveWord 0 0 0 0 x 0 := by
  have hP := (isPositiveWord_commutator l (x * m)).mul
    (isPositiveWord_commutator 1 (l * (x * m))).inv
  exact (((isPositiveWord_twoShortAddLong (-(l * (x * m) - l ^ 2 * (x * m)))).mul hP).mul
    (isPositiveWord_threeShortAddTwoLong (-(l ^ 3 * (x * m) ^ 2 - l ^ 2 * (x * m) ^ 2)))).of_eq
    (by ring) (by ring) (by ring) (by ring) (by linear_combination x * hlm) (by ring)

/-- The root element of `α₁ + α₂`, from `[x_{α₁}(1), x_{α₂}(c)]` after removing its components
along the higher roots. -/
private theorem isPositiveWord_shortAddLong {l m : A} (hlm : m * (l ^ 3 - l) = 1) (c : A) :
    IsPositiveWord 0 0 c 0 0 0 :=
  ((((isPositiveWord_commutator 1 c).mul (isPositiveWord_twoShortAddLong c)).mul
    (isPositiveWord_threeShortAddLong hlm (-c))).mul
      (isPositiveWord_threeShortAddTwoLong (-c ^ 2))).of_eq
    (by ring) (by ring) (by ring) (by ring) (by ring)
    (by linear_combination (-c ^ 2) * three_eq_zero (A := A))

/-- Every normal form is realized by a positive root word. -/
private theorem isPositiveWord {l m : A} (hlm : m * (l ^ 3 - l) = 1) (a b c d e f : A) :
    IsPositiveWord a b c d e f := by
  have hN : ∀ c d e f : A, IsPositiveWord 0 0 c d e f := fun c d e f ↦
    ((((isPositiveWord_shortAddLong hlm c).mul (isPositiveWord_twoShortAddLong d)).mul
      (isPositiveWord_threeShortAddLong hlm e)).mul
        (isPositiveWord_threeShortAddTwoLong (f + c * d))).of_eq
      (by ring) (by ring) (by ring) (by ring) (by ring) (by ring)
  exact (((isPositiveWord_short a).mul (isPositiveWord_long b)).mul
    (hN (c - a * b) (d - a ^ 2 * b + a * c) (e - a ^ 3 * b + a ^ 2 * c + a * d)
      (f - a ^ 2 * b * c + a * b * d + a * c ^ 2))).of_eq
    (by ring) (by ring) (by ring) (by ring) (by ring) (by ring)

/-! ## The upper-triangular carrier points -/

private theorem mem_closure_of_isUpperUnitriangular {l : A} (hl : IsUnit (l ^ 3 - l))
    (g : points A)
    (hg : ((g : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A).IsUpperUnitriangular) :
    g ∈ Subgroup.closure (⋃ i : Fin 2, Set.range (rootSubgroupPoints (.inl i) A)) := by
  have h2 : IsRegular (2 : A) := by
    have h2_eq : (2 : A) = -1 := by linear_combination three_eq_zero (A := A)
    rw [h2_eq]
    exact isUnit_one.neg.isRegular
  have hg' := eq_crossUnipotentMatrix_of_preservesG2Cross h2 hg
    (preservesG2Cross_of_mem_points g.property)
  set M : Matrix (Fin 7) (Fin 7) A := ((g : GL (Fin 7) A) : Matrix (Fin 7) (Fin 7) A)
  obtain ⟨h, hh, hhg⟩ := isPositiveWord hl.val_inv_mul (M 0 1) (M 1 2) (M 0 2) (M 3 6) (M 0 4)
    (M 0 5)
  have hgh : g = h := Subtype.ext (Units.ext (hg'.trans hhg.symm))
  rwa [hgh]

/-- **The upper-unitriangular carrier points are generated by the positive simple root points**,
over every commutative `𝔽₃`-algebra containing an element `λ` with `λ³ - λ` a unit. -/
theorem comap_upperUnitriangularGroup_eq_closure {l : A} (hl : IsUnit (l ^ 3 - l)) :
    (upperUnitriangularGroup (Fin 7) A).comap (points A).subtype =
      Subgroup.closure (⋃ i : Fin 2, Set.range (rootSubgroupPoints (.inl i) A)) := by
  refine le_antisymm (fun g hg ↦ mem_closure_of_isUpperUnitriangular hl g
    (UpperUnitriangularGroup.mem_iff.mp hg)) ((Subgroup.closure_le _).2 ?_)
  rintro _ ⟨_, ⟨i, rfl⟩, t, rfl⟩
  rw [SetLike.mem_coe, Subgroup.mem_comap, UpperUnitriangularGroup.mem_iff, Subgroup.subtype_apply,
    ← ofAdd_toAdd t]
  fin_cases i
  · rw [Fin.zero_eta, coe_rootSubgroupPoints_inl_zero_eq_crossUnipotentMatrix]
    exact isUpperUnitriangular_crossUnipotentMatrix _ _ _ _ _ _
  · rw [Fin.mk_one, coe_rootSubgroupPoints_inl_one_eq_crossUnipotentMatrix]
    exact isUpperUnitriangular_crossUnipotentMatrix _ _ _ _ _ _

/-- **The upper-triangular carrier points are generated by the positive simple root points and
the weight torus**, over every commutative `𝔽₃`-algebra containing an element `λ` with `λ³ - λ`
a unit. -/
theorem comap_upperTriangularGroup_eq_closure {l : A} (hl : IsUnit (l ^ 3 - l)) :
    (upperTriangularGroup (Fin 7) A).comap (points A).subtype =
      Subgroup.closure ((⋃ i : Fin 2, Set.range (rootSubgroupPoints (.inl i) A)) ∪
        Set.range (weightTorusPoints A)) := by
  apply le_antisymm
  · intro g hg
    obtain ⟨s, hs, -⟩ :=
      existsUnique_weightTorusPoints_isUpperUnitriangular g (UpperTriangularGroup.mem_iff.mp hg)
    have hu := mem_closure_of_isUpperUnitriangular hl _ hs
    rw [← inv_mul_cancel_right g (weightTorusPoints A s)]
    exact mul_mem (Subgroup.closure_mono Set.subset_union_left hu)
      (Subgroup.subset_closure (Set.subset_union_right (Set.mem_range_self s)))
  · rw [Subgroup.closure_le]
    rintro _ (⟨_, ⟨i, rfl⟩, t, rfl⟩ | ⟨s, rfl⟩)
    · exact UpperTriangularGroup.mem_iff.mpr (isUpperTriangular_rootSubgroupPoints_inl i A t)
    · exact UpperTriangularGroup.mem_iff.mpr (isUpperTriangular_weightTorusPoints A s)

/-- **The upper-triangular carrier points are the points of the positive subgroup**, over every
commutative `𝔽₃`-algebra containing an element `λ` with `λ³ - λ` a unit. -/
theorem points_inf_upperTriangularGroup_eq {l : A} (hl : IsUnit (l ^ 3 - l)) :
    points A ⊓ upperTriangularGroup (Fin 7) A =
      GeneralLinear.hopfIdealPointsSubgroup 7 Positive.definingIdeal A := by
  apply le_antisymm
  · intro g hg'
    obtain ⟨hg, hgu⟩ := Subgroup.mem_inf.mp hg'
    have hclosure : Subgroup.closure ((⋃ i : Fin 2, Set.range (rootSubgroupPoints (.inl i) A)) ∪
        Set.range (weightTorusPoints A)) ≤
        (GeneralLinear.hopfIdealPointsSubgroup 7 Positive.definingIdeal A).comap
          (points A).subtype := by
      rw [Subgroup.closure_le, ← GeneralLinear.generatedPointsSubgroup_def]
      rintro _ (⟨_, ⟨i, rfl⟩, t, rfl⟩ | ⟨s, rfl⟩)
      · rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.subtype_apply,
          ← (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := A)).apply_symm_apply t,
          coe_rootSubgroupPoints_gaPointsMulEquiv, ← Positive.generator_inl]
        exact GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup 7
          Positive.generator (.inl i) A _
      · rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.subtype_apply,
          ← (SplitTorus.pointsMulEquiv (R := ZMod 3) (A := CommAlgCat.of (ZMod 3) A)
            (σ := Fin 2)).apply_symm_apply s,
          coe_weightTorusPoints_pointsMulEquiv, ← Positive.generator_inr]
        exact GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup 7
          Positive.generator (.inr ()) A _
    have hmem : (⟨g, hg⟩ : points A) ∈
        (upperTriangularGroup (Fin 7) A).comap (points A).subtype := Subgroup.mem_comap.mpr hgu
    rw [comap_upperTriangularGroup_eq_closure hl] at hmem
    exact hclosure hmem
  · intro g hg
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · rw [points_eq_hopfIdealPointsSubgroup, definingIdeal_def]
      exact GeneralLinear.hopfIdealPointsSubgroup_le_of_le 7 Positive.carrierDefiningIdeal_le A hg
    · rw [← GeneralLinear.UpperTriangular.hopfIdealPointsSubgroup_eq (ZMod 3)]
      exact GeneralLinear.hopfIdealPointsSubgroup_le_of_le 7
        Positive.upperTriangular_le_definingIdeal A hg

end TauCeti.G2ShortRoot.PrimeField
