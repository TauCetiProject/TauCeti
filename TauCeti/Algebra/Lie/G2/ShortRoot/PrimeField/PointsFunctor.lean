/-! ## Matrix-valued points -/

/-- The matrix-valued points of the short-root type-`G₂` carrier over `𝔽₃`. -/
noncomputable def points (A : Type v) [CommRing A] [Algebra (ZMod 3) A] :
    Subgroup (_root_.Matrix.GeneralLinearGroup (Fin 7) A) :=
  TauCeti.GeneralLinear.generatedPointsSubgroup 7 generator A

/-- The points of the carrier are the points of the subgroup scheme generated by the reduced
generators. -/
theorem points_def (A : Type v) [CommRing A] [Algebra (ZMod 3) A] :
    points A = TauCeti.GeneralLinear.generatedPointsSubgroup 7 generator A := by
  rw [points]

/-- The points of the carrier are cut out by its defining Hopf ideal. -/
theorem points_eq_hopfIdealPointsSubgroup (A : Type v) [CommRing A] [Algebra (ZMod 3) A] :
    points A = TauCeti.GeneralLinear.hopfIdealPointsSubgroup 7 definingIdeal A := by
  rw [points, TauCeti.GeneralLinear.generatedPointsSubgroup_def, definingIdeal_def]

/-- A matrix is a point of the carrier exactly when its associated convolution point kills the
carrier's defining Hopf ideal. -/
@[simp]
theorem mem_points_iff (A : Type v) [CommRing A] [Algebra (ZMod 3) A]
    (g : _root_.Matrix.GeneralLinearGroup (Fin 7) A) :
    g ∈ points A ↔ ∀ x ∈ definingIdeal,
      ((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 3) 7).symm g).ofConv x = 0 := by
  rw [points_eq_hopfIdealPointsSubgroup]
  exact TauCeti.GeneralLinear.mem_hopfIdealPointsSubgroup_iff 7 definingIdeal A g

/-- **Every point of the carrier is a point of the base change of the integral short-root toral
closure.** -/
theorem points_le_baseChangePresentationPoints (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] :
    points A ≤ TauCeti.GeneralLinear.hopfIdealPointsSubgroup 7
      (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
        rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis weight
        (ZMod 3)) A := by
  rw [points_eq_hopfIdealPointsSubgroup]
  exact TauCeti.GeneralLinear.hopfIdealPointsSubgroup_le_of_le 7
    baseChangePresentationIdeal_le_definingIdeal A

/-- The parametrized numbered simple root subgroup inside the points of the carrier. -/
noncomputable def rootSubgroupPoints (k : Fin 2 ⊕ Fin 2) (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] : Multiplicative A →* points A :=
  MonoidHom.codRestrict
    (((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 3) 7).toMonoidHom.comp
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app
          (CommAlgCat.of (ZMod 3) A)).hom).comp
      (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := A)).symm.toMonoidHom)
    (points A)
    fun _ => TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup
      7 generator (.inl k) A _

/-- A numbered simple-root point of the carrier is the image of the corresponding point of `𝔾ₐ`
under the generating coordinate map. -/
theorem coe_rootSubgroupPoints_gaPointsMulEquiv (k : Fin 2 ⊕ Fin 2) (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A]
    (q : HopfAlgebra.points (R := ZMod 3)
      (H := AdditiveGroup.coordinateHopfAlgebra (ZMod 3)) (CommAlgCat.of (ZMod 3) A)) :
    (rootSubgroupPoints k A (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) q) :
        _root_.Matrix.GeneralLinearGroup (Fin 7) A) =
      TauCeti.GeneralLinear.pointsMulEquiv 7
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app
          (CommAlgCat.of (ZMod 3) A) q) := by
  rw [rootSubgroupPoints]
  exact congrArg _ (congrArg _ (MulEquiv.symm_apply_apply _ q))

/-- **A numbered simple-root point of the carrier is the corresponding point of the integral
short-root toral closure**, as a matrix. -/
@[simp]
theorem coe_rootSubgroupPoints (k : Fin 2 ⊕ Fin 2) (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] (u : Multiplicative A) :
    (rootSubgroupPoints k A u : _root_.Matrix.GeneralLinearGroup (Fin 7) A) =
      (IntegralToralClosure.rootSubgroupPoints k A u :
        _root_.Matrix.GeneralLinearGroup (Fin 7) A) := by
  set q : HopfAlgebra.points (R := ZMod 3)
      (H := AdditiveGroup.coordinateHopfAlgebra (ZMod 3)) (CommAlgCat.of (ZMod 3) A) :=
    (AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := A)).symm u with hqdef
  have hu : AdditiveGroup.gaPointsMulEquiv (R := ZMod 3) (A := A) q = u := by
    rw [hqdef, MulEquiv.apply_symm_apply]
  have hq := pointsMulEquiv_kostantRootSubgroupToralBaseChangeCoordinateMap rootGen cartanGen
    rep lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
    latticeBasis weight (ZMod 3) IntegralToralClosure.definingIdeal_def k
    (CommAlgCat.of (ZMod 3) A) q
  rw [hu] at hq
  have hcomp :
      (CommHopfAlgCat.mapPointsFunctor (generator (.inl k))).app (CommAlgCat.of (ZMod 3) A) q =
        CommHopfAlgCat.quotientPointsHom
          (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 3) 7)
          (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
            rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis weight
            (ZMod 3))
          (CommAlgCat.of (ZMod 3) A)
          ((CommHopfAlgCat.mapPointsFunctor
            (kostantRootSubgroupToralBaseChangePresentationCoordinateMap rootGen cartanGen rep
              lattice.toAddSubgroup rep_kostantForm_mem_lattice
              isNilpotent_rep_serreRootGenerator latticeBasis weight (ZMod 3) k)).app
            (CommAlgCat.of (ZMod 3) A) q) := by
    apply CommHopfAlgCat.mapPointsFunctor_eq_quotientPointsHom_of_mkQuotient_comp
    rw [generator_inl]
    exact mkQuotient_comp_kostantRootSubgroupToralBaseChangePresentationCoordinateMap
      rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
      isNilpotent_rep_serreRootGenerator latticeBasis weight (ZMod 3) k
  rw [IntegralToralClosure.coe_rootSubgroupPoints_eq_kostantRootSubgroupMatrix, ← hq, ← hcomp,
    ← coe_rootSubgroupPoints_gaPointsMulEquiv k A q, hu]

/-- The split weight torus inside the points of the carrier. -/
noncomputable def weightTorusPoints (A : Type v) [CommRing A] [Algebra (ZMod 3) A] :
    (Fin 2 → Aˣ) →* points A :=
  MonoidHom.codRestrict
    (((TauCeti.GeneralLinear.pointsMulEquiv (R := ZMod 3) 7).toMonoidHom.comp
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app
          (CommAlgCat.of (ZMod 3) A)).hom).comp
      (SplitTorus.pointsMulEquiv (R := ZMod 3) (A := CommAlgCat.of (ZMod 3) A)
        (σ := Fin 2)).symm.toMonoidHom)
    (points A)
    fun _ => TauCeti.GeneralLinear.pointsMulEquiv_mapPointsFunctor_mem_generatedPointsSubgroup
      7 generator (.inr ()) A _

/-- A weight-torus point of the carrier is the image of the corresponding point of the split torus
under the generating coordinate map. -/
theorem coe_weightTorusPoints_pointsMulEquiv (A : Type v) [CommRing A] [Algebra (ZMod 3) A]
    (q : HopfAlgebra.points (R := ZMod 3)
      (H := (DiagonalizableGroup.coordinateRing (ZMod 3)
        (SplitTorus.characterGroup (Fin 2))).obj) (CommAlgCat.of (ZMod 3) A)) :
    (weightTorusPoints A (SplitTorus.pointsMulEquiv q) :
        _root_.Matrix.GeneralLinearGroup (Fin 7) A) =
      TauCeti.GeneralLinear.pointsMulEquiv 7
        ((CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app
          (CommAlgCat.of (ZMod 3) A) q) := by
  rw [weightTorusPoints]
  exact congrArg _ (congrArg _ (MulEquiv.symm_apply_apply _ q))

/-- **A weight-torus point of the carrier is the corresponding point of the integral short-root
toral closure**, as a matrix. -/
@[simp]
theorem coe_weightTorusPoints (A : Type v) [CommRing A] [Algebra (ZMod 3) A] (s : Fin 2 → Aˣ) :
    (weightTorusPoints A s : _root_.Matrix.GeneralLinearGroup (Fin 7) A) =
      (IntegralToralClosure.weightTorusPoints A s :
        _root_.Matrix.GeneralLinearGroup (Fin 7) A) := by
  set q : HopfAlgebra.points (R := ZMod 3)
      (H := (DiagonalizableGroup.coordinateRing (ZMod 3)
        (SplitTorus.characterGroup (Fin 2))).obj) (CommAlgCat.of (ZMod 3) A) :=
    (SplitTorus.pointsMulEquiv (R := ZMod 3) (A := CommAlgCat.of (ZMod 3) A)
      (σ := Fin 2)).symm s with hqdef
  have hs : SplitTorus.pointsMulEquiv q = s := by
    rw [hqdef, MulEquiv.apply_symm_apply]
  have hq := pointsMulEquiv_kostantWeightTorusToralBaseChangeCoordinateMap rootGen cartanGen
    rep lattice.toAddSubgroup rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator
    latticeBasis weight (ZMod 3) IntegralToralClosure.definingIdeal_def
    (CommAlgCat.of (ZMod 3) A) q
  rw [hs] at hq
  have hcomp :
      (CommHopfAlgCat.mapPointsFunctor (generator (.inr ()))).app (CommAlgCat.of (ZMod 3) A) q =
        CommHopfAlgCat.quotientPointsHom
          (TauCeti.GeneralLinear.coordinateHopfAlgebra (ZMod 3) 7)
          (kostantToralBaseChangePresentationIdeal rootGen cartanGen rep lattice.toAddSubgroup
            rep_kostantForm_mem_lattice isNilpotent_rep_serreRootGenerator latticeBasis weight
            (ZMod 3))
          (CommAlgCat.of (ZMod 3) A)
          ((CommHopfAlgCat.mapPointsFunctor
            (kostantWeightTorusToralBaseChangePresentationCoordinateMap rootGen cartanGen rep
              lattice.toAddSubgroup rep_kostantForm_mem_lattice
              isNilpotent_rep_serreRootGenerator latticeBasis weight (ZMod 3))).app
            (CommAlgCat.of (ZMod 3) A) q) := by
    apply CommHopfAlgCat.mapPointsFunctor_eq_quotientPointsHom_of_mkQuotient_comp
    rw [generator_inr]
    exact mkQuotient_comp_kostantWeightTorusToralBaseChangePresentationCoordinateMap
      rootGen cartanGen rep lattice.toAddSubgroup rep_kostantForm_mem_lattice
      isNilpotent_rep_serreRootGenerator latticeBasis weight (ZMod 3)
  rw [IntegralToralClosure.coe_weightTorusPoints, ← hq, ← hcomp,
    ← coe_weightTorusPoints_pointsMulEquiv A q, hs]

/-- **The pinning equation on matrix-valued points of the carrier**: conjugation by a point `s` of
the weight torus rescales the parameter of each numbered simple root subgroup by the corresponding
type-`G₂` root character evaluated at `s`. -/
@[simp]
theorem weightTorusPoints_conj_rootSubgroupPoints (k : Fin 2 ⊕ Fin 2) (A : Type v) [CommRing A]
    [Algebra (ZMod 3) A] (s : Fin 2 → Aˣ) (u : Multiplicative A) :
    weightTorusPoints A s * rootSubgroupPoints k A u * (weightTorusPoints A s)⁻¹ =
      rootSubgroupPoints k A
        (Multiplicative.ofAdd
          ((TauCeti.torusCharacter s (rootWeight k) : A) * Multiplicative.toAdd u)) := by
  apply Subtype.ext
  have hint := congrArg Subtype.val
    (IntegralToralClosure.weightTorusPoints_conj_rootSubgroupPoints k A s u)
  simpa only [Subgroup.coe_mul, Subgroup.coe_inv, coe_weightTorusPoints,
    coe_rootSubgroupPoints] using hint

/-! ## Functoriality -/

/-- The map on the points of the carrier induced by a homomorphism of `𝔽₃`-algebras. -/
noncomputable def pointsMap {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    [Algebra (ZMod 3) A] [Algebra (ZMod 3) B] (f : A →ₐ[ZMod 3] B) : points A →* points B :=
  TauCeti.GeneralLinear.mapHopfIdealPointsSubgroupCongr 7 definingIdeal
    (points_eq_hopfIdealPointsSubgroup A) (points_eq_hopfIdealPointsSubgroup B) f

/-- The induced map on points applies the algebra homomorphism entrywise. -/
@[simp]
theorem coe_pointsMap {A : Type v} {B : Type w} [CommRing A] [CommRing B] [Algebra (ZMod 3) A]
    [Algebra (ZMod 3) B] (f : A →ₐ[ZMod 3] B) (g : points A) :
    (pointsMap f g : _root_.Matrix.GeneralLinearGroup (Fin 7) B) =
      _root_.Matrix.GeneralLinearGroup.map (f : A →+* B) g :=
  TauCeti.GeneralLinear.coe_mapHopfIdealPointsSubgroupCongr 7 definingIdeal
    (points_eq_hopfIdealPointsSubgroup A) (points_eq_hopfIdealPointsSubgroup B) f g

/-- The identity algebra homomorphism induces the identity on carrier points. -/
@[simp]
theorem pointsMap_id {A : Type v} [CommRing A] [Algebra (ZMod 3) A] :
    pointsMap (AlgHom.id (ZMod 3) A) = MonoidHom.id _ :=
  TauCeti.GeneralLinear.mapHopfIdealPointsSubgroupCongr_id 7 definingIdeal
    (points_eq_hopfIdealPointsSubgroup A)

/-- The induced maps on carrier points compose. -/
@[simp]
theorem pointsMap_comp {A : Type u} {B : Type v} {C : Type w}
    [CommRing A] [CommRing B] [CommRing C]
    [Algebra (ZMod 3) A] [Algebra (ZMod 3) B] [Algebra (ZMod 3) C]
    (f : A →ₐ[ZMod 3] B) (g : B →ₐ[ZMod 3] C) :
    pointsMap (g.comp f) = (pointsMap g).comp (pointsMap f) :=
  TauCeti.GeneralLinear.mapHopfIdealPointsSubgroupCongr_comp 7 definingIdeal
    (points_eq_hopfIdealPointsSubgroup A) (points_eq_hopfIdealPointsSubgroup B)
    (points_eq_hopfIdealPointsSubgroup C) f g

/-- An injective algebra homomorphism induces an injective map on carrier points. -/
theorem pointsMap_injective {A : Type v} {B : Type w} [CommRing A] [CommRing B]
    [Algebra (ZMod 3) A] [Algebra (ZMod 3) B] {f : A →ₐ[ZMod 3] B}
    (hf : Function.Injective f) : Function.Injective (pointsMap f) :=
  TauCeti.GeneralLinear.mapHopfIdealPointsSubgroupCongr_injective 7 definingIdeal
    (points_eq_hopfIdealPointsSubgroup A) (points_eq_hopfIdealPointsSubgroup B) hf

/-- The induced map carries a numbered root-subgroup parameter along the algebra homomorphism. -/
@[simp]
theorem pointsMap_rootSubgroupPoints {A : Type v} {B : Type w}
    [CommRing A] [CommRing B] [Algebra (ZMod 3) A] [Algebra (ZMod 3) B]
    (f : A →ₐ[ZMod 3] B) (k : Fin 2 ⊕ Fin 2) (u : Multiplicative A) :
    pointsMap f (rootSubgroupPoints k A u) =
      rootSubgroupPoints k B (Multiplicative.ofAdd (f (Multiplicative.toAdd u))) := by
  apply Subtype.ext
  rw [coe_pointsMap, coe_rootSubgroupPoints, coe_rootSubgroupPoints,
    IntegralToralClosure.coe_rootSubgroupPoints_eq_kostantRootSubgroupMatrix,
    IntegralToralClosure.coe_rootSubgroupPoints_eq_kostantRootSubgroupMatrix,
    map_kostantRootSubgroupMatrix, AdditiveGroup.mapValue_gaPointsMulEquiv_symm_apply,
    RingHom.toIntAlgHom_apply, RingHom.coe_coe]

/-- The induced map carries a weight-torus point coordinatewise along the algebra
homomorphism. -/
@[simp]
theorem pointsMap_weightTorusPoints {A : Type v} {B : Type w}
    [CommRing A] [CommRing B] [Algebra (ZMod 3) A] [Algebra (ZMod 3) B]
    (f : A →ₐ[ZMod 3] B) (s : Fin 2 → Aˣ) :
    pointsMap f (weightTorusPoints A s) =
      weightTorusPoints B fun i ↦ Units.map (f : A →* B) (s i) := by
  apply Subtype.ext
  rw [coe_pointsMap, coe_weightTorusPoints, coe_weightTorusPoints,
    IntegralToralClosure.coe_weightTorusPoints, IntegralToralClosure.coe_weightTorusPoints]
  exact map_kostantTorusMatrix (M := lattice.toAddSubgroup) (b := latticeBasis)
    (wt := weight) (f : A →+* B) s

end PrimeField

end TauCeti.G2ShortRoot
