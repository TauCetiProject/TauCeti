/-!
# Basic infrastructure for Lie modules

This file supplies general constructions for Lie modules that are missing from Mathlib.

## Main definitions

* `TauCeti.LieModuleEquiv.ofBijective`: a bijective morphism of Lie modules is an equivalence.
* `TauCeti.LieModuleEquiv.restrictLie`: an equivalence of Lie modules over a Lie algebra, read as
  one over a Lie subalgebra.
* `TauCeti.LieModuleEquiv.congrRight` and `TauCeti.LieModuleEquiv.congrLeft`: postcomposition and
  precomposition with an equivalence of Lie modules, as linear equivalences of morphism spaces.
* `TauCeti.lieAnnihilator`: the Lie subalgebra of elements annihilating a vector in a Lie
  module.
* `LieHom.lieIdealComap`: a Lie homomorphism restricted to the preimage of a Lie ideal, as a
  Lie homomorphism into that ideal.

## Main results

* `LieModule.isIrreducible_compLieHom_of_eq_bot_or_eq_top`: an underlying-submodule dichotomy for
  a representation implies irreducibility of the induced Lie module.
* `Module.Basis.repr_lie_eq_sum`: a Lie bracket coordinate is a weighted sum of bracket columns.

* `TauCeti.LieModuleHom.instModuleFinite`: the morphism space is finitely generated when its
  source is finitely generated and its target is Noetherian over the base ring.
* `TauCeti.lieSpan_le_lieAnnihilator`: a vector annihilated by a generating set is annihilated by
  the Lie subalgebra it generates.
* `TauCeti.mem_lieAnnihilator`: membership in `lieAnnihilator R L v` is equivalent to vanishing
  of the Lie action on `v`.
* `LieAlgebra.ad_eq_toEnd`: the adjoint action is the action `toEnd R L L` of `L` on itself.
* `LieModule.toEnd_eq_zero_of_isTrivial` and `LieAlgebra.ad_eq_zero_of_isLieAbelian`: on a
  trivial Lie module, in particular in an abelian Lie algebra, every element acts by zero.
* `LieHom.map_ad_pow`: a Lie homomorphism carries `(ad x) ^ n y` to `(ad (f x)) ^ n (f y)`.
* `LieHom.isNilpotent_ad_of_surjective`: adjoint nilpotence descends along a surjective
  Lie homomorphism.
* `LieHom.lieIdealComap_injective`: the restriction of an injective Lie homomorphism to the
  preimage of a Lie ideal is injective.
* `LieSubmodule.lie_iSup`: bracketing with a Lie ideal distributes over suprema of Lie submodules.
* `TauCeti.ad_pow_succ_apply`: an additional adjoint action can be applied to the argument.
* `TauCeti.ad_neg_pow_apply_eq_zero`: negating the acting element preserves adjoint vanishing.
* `LieSubalgebra.engel_neg`: negating the acting element preserves the Engel subalgebra.
* `TauCeti.ad_pow_apply_eq_ad_pow_apply`: iterating the adjoint action gives the same element
  whichever base ring the Lie algebra is read over.
* `TauCeti.left_ne_zero_of_lie_eq_smul`: an element acting on a nonzero vector by a nonzero
  scalar is nonzero.
* `TauCeti.left_ne_zero_of_lie_eq_nsmul`: the same for a nonzero natural multiple, in
  characteristic zero.
* `TauCeti.isTrivial_of_forall_lie_eq_zero_of_lieSpan_eq_top`: a Lie module generated by
  a vector annihilated by the Lie algebra is trivial.
-/

public section

namespace LieModule

universe u v w

attribute [local instance 100] LieRing.ofAssociativeRing

variable {R : Type u} [CommRing R] {L : Type v} [LieRing L] [LieAlgebra R L]
  {M : Type w} [AddCommGroup M] [Module R M] [Nontrivial M]

/-- A dichotomy for the underlying submodules invariant under a representation makes the module
obtained by pulling back the endomorphism action along that representation irreducible. -/
theorem isIrreducible_compLieHom_of_eq_bot_or_eq_top (f : L →ₗ⁅R⁆ Module.End R M)
    (h : ∀ N : Submodule R M, (∀ x, N.map (f x) ≤ N) → N = ⊥ ∨ N = ⊤) :
    letI : LieRingModule L M := LieRingModule.compLieHom _ f
    letI : LieModule R L M := LieModule.compLieHom _ f
    IsIrreducible R L M := by
  let _ : LieRingModule L M := LieRingModule.compLieHom _ f
  let _ : LieModule R L M := LieModule.compLieHom _ f
  refine IsIrreducible.mk fun N hN => ?_
  rw [← LieSubmodule.toSubmodule_eq_top]
  refine (h N.toSubmodule ?_).resolve_left ?_
  · intro x
    rintro _ ⟨m, hm, rfl⟩
    have hm' := N.lie_mem (x := x) hm
    rw [LieRingModule.compLieHom_apply, Module.End.lie_apply] at hm'
    exact (LieSubmodule.mem_carrier (N := N)).mp hm'
  · exact fun hbot => hN ((LieSubmodule.toSubmodule_eq_bot N).mp hbot)

end LieModule

/-- The adjoint action `ad R L` is by definition the action `LieModule.toEnd R L L` of `L` on
itself. Rewriting with this lemma moves results about Lie modules to the adjoint action. -/
theorem LieAlgebra.ad_eq_toEnd (R L : Type*) [CommRing R] [LieRing L] [LieAlgebra R L] :
    LieAlgebra.ad R L = LieModule.toEnd R L L :=
  rfl

/-- On a trivial Lie module every element of the Lie algebra acts by zero. -/
@[simp]
theorem LieModule.toEnd_eq_zero_of_isTrivial {R L M : Type*} [CommRing R] [LieRing L]
    [LieAlgebra R L] [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]
    [LieModule.IsTrivial L M] (x : L) : LieModule.toEnd R L M x = 0 :=
  LinearMap.ext fun m ↦ by rw [LieModule.toEnd_apply_apply, trivial_lie_zero, LinearMap.zero_apply]

/-- In an abelian Lie algebra the adjoint action of every element vanishes. -/
@[simp]
theorem LieAlgebra.ad_eq_zero_of_isLieAbelian {R L : Type*} [CommRing R] [LieRing L]
    [LieAlgebra R L] [IsLieAbelian L] (x : L) : LieAlgebra.ad R L x = 0 :=
  LieModule.toEnd_eq_zero_of_isTrivial x

namespace TauCeti

universe u v w w₁ w₂

section LieModule

variable {R : Type u} {L : Type v} {M : Type w}
variable [CommRing R] [LieRing L] [AddCommGroup M] [Module R M] [LieRingModule L M]

namespace LieModuleEquiv

variable {N : Type w₁} [AddCommGroup N] [Module R N] [LieRingModule L N]

/-- A bijective morphism of Lie modules is an equivalence of Lie modules. This is the Lie module
analogue of `LieEquiv.ofBijective`. -/
noncomputable def ofBijective (f : M →ₗ⁅R,L⁆ N) (hf : Function.Bijective f) : M ≃ₗ⁅R,L⁆ N :=
  { LinearEquiv.ofBijective (f : M →ₗ[R] N) hf with
    toFun := f
    map_lie' := f.map_lie _ _ }

@[simp]
theorem ofBijective_apply (f : M →ₗ⁅R,L⁆ N) (hf : Function.Bijective f) (m : M) :
    ofBijective f hf m = f m := by
  -- `LieModuleEquiv` has no projection lemma exposing the underlying `LinearEquiv`, so reveal that
  -- representation boundary before applying the corresponding linear-equivalence interface lemma.
  change (LinearEquiv.ofBijective (f : M →ₗ[R] N) hf) m = f m
  exact LinearEquiv.ofBijective_apply _ _

/-- **An equivalence of `L`-modules is an equivalence of `L'`-modules** for a Lie subalgebra
`L' ≤ L`, with the same underlying map. This is Mathlib's `LieModuleHom.restrictLie` for
equivalences. -/
noncomputable def restrictLie [LieAlgebra R L] (e : M ≃ₗ⁅R,L⁆ N) (L' : LieSubalgebra R L) :
    M ≃ₗ⁅R,L'⁆ N :=
  ofBijective ((e : M →ₗ⁅R,L⁆ N).restrictLie L') ⟨e.injective, e.surjective⟩

@[simp]
theorem coe_restrictLie [LieAlgebra R L] (e : M ≃ₗ⁅R,L⁆ N) (L' : LieSubalgebra R L) :
    ⇑(restrictLie e L') = e := by
  funext m
  refine (ofBijective_apply ((e : M →ₗ⁅R,L⁆ N).restrictLie L') _ m).trans ?_
  rw [LieModuleHom.coe_restrictLie]
  rfl

section CongrRight

variable {P : Type w₂} [AddCommGroup P] [Module R P] [LieRingModule L P]
variable [LieAlgebra R L] [LieModule R L N] [LieModule R L P]

/-- **Postcomposition with an equivalence of Lie modules**, as an `R`-linear equivalence
`(M →ₗ⁅R,L⁆ N) ≃ₗ[R] (M →ₗ⁅R,L⁆ P)` of morphism spaces. This is the Lie-module analogue of
`LinearEquiv.congrRight`, which is unavailable here because a `LieModuleHom` is not a
`LinearMap`. -/
def congrRight (e : N ≃ₗ⁅R,L⁆ P) : (M →ₗ⁅R,L⁆ N) ≃ₗ[R] (M →ₗ⁅R,L⁆ P) where
  toFun f := (e : N →ₗ⁅R,L⁆ P).comp f
  invFun g := (e.symm : P →ₗ⁅R,L⁆ N).comp g
  map_add' _ _ := by ext m; simp
  map_smul' _ _ := by ext m; simp
  left_inv f := by ext m; simp
  right_inv g := by ext m; simp

@[simp]
theorem congrRight_apply (e : N ≃ₗ⁅R,L⁆ P) (f : M →ₗ⁅R,L⁆ N) (m : M) :
    congrRight (M := M) e f m = e (f m) := by
  rfl

@[simp]
theorem congrRight_symm_apply (e : N ≃ₗ⁅R,L⁆ P) (g : M →ₗ⁅R,L⁆ P) (m : M) :
    (congrRight (M := M) e).symm g m = e.symm (g m) := by
  rfl

end CongrRight

section CongrLeft

variable {P : Type w₂} [AddCommGroup P] [Module R P] [LieRingModule L P]
variable [LieAlgebra R L] [LieModule R L P]

/-- **Precomposition with an equivalence of Lie modules**, as an `R`-linear equivalence
`(M →ₗ⁅R,L⁆ P) ≃ₗ[R] (N →ₗ⁅R,L⁆ P)` of morphism spaces. This is the source-variable companion of
`TauCeti.LieModuleEquiv.congrRight`. -/
def congrLeft (e : M ≃ₗ⁅R,L⁆ N) : (M →ₗ⁅R,L⁆ P) ≃ₗ[R] (N →ₗ⁅R,L⁆ P) where
  toFun f := f.comp (e.symm : N →ₗ⁅R,L⁆ M)
  invFun g := g.comp (e : M →ₗ⁅R,L⁆ N)
  map_add' _ _ := by ext n; simp
  map_smul' _ _ := by ext n; simp
  left_inv f := by ext m; simp
  right_inv g := by ext n; simp

@[simp]
theorem congrLeft_apply (e : M ≃ₗ⁅R,L⁆ N) (f : M →ₗ⁅R,L⁆ P) (n : N) :
    congrLeft (P := P) e f n = f (e.symm n) := by
  rfl

@[simp]
theorem congrLeft_symm_apply (e : M ≃ₗ⁅R,L⁆ N) (g : N →ₗ⁅R,L⁆ P) (m : M) :
    (congrLeft (P := P) e).symm g m = g (e m) := by
  rfl

end CongrLeft

end LieModuleEquiv

/-- An element of `L` acting on a nonzero vector by a nonzero scalar is itself nonzero. -/
theorem left_ne_zero_of_lie_eq_smul [NoZeroSMulDivisors R M] {x : L} {m : M} {t : R}
    (hx : ⁅x, m⁆ = t • m) (ht : t ≠ 0) (hm : m ≠ 0) : x ≠ 0 := by
  rintro rfl
  rw [zero_lie] at hx
  exact hm ((eq_zero_or_eq_zero_of_smul_eq_zero hx.symm).resolve_left ht)

variable (R) in
/-- Over a ring of characteristic zero, an element of `L` acting on a nonzero vector by a nonzero
natural multiple is itself nonzero. -/
theorem left_ne_zero_of_lie_eq_nsmul [CharZero R] [NoZeroSMulDivisors R M] {x : L} {m : M}
    {n : ℕ} (hx : ⁅x, m⁆ = n • m) (hn : n ≠ 0) (hm : m ≠ 0) : x ≠ 0 :=
  left_ne_zero_of_lie_eq_smul (t := (n : R)) (by rw [hx, Nat.cast_smul_eq_nsmul])
    (Nat.cast_ne_zero.mpr hn) hm

variable [LieAlgebra R L]

/-- Bracketing with a Lie ideal distributes over suprema of Lie submodules. -/
theorem _root_.LieSubmodule.lie_iSup {ι : Type*} (I : LieIdeal R L)
    (N : ι → LieSubmodule R L M) : ⁅I, ⨆ i, N i⁆ = ⨆ i, ⁅I, N i⁆ := by
  refine le_antisymm ?_ (iSup_le fun i ↦ LieSubmodule.mono_lie_right _ (le_iSup N i))
  rw [LieSubmodule.lie_le_iff]
  intro x hx m hm
  refine LieSubmodule.iSup_induction N (motive := fun y ↦ ⁅x, y⁆ ∈ ⨆ i, ⁅I, N i⁆) hm
    (fun i y hy ↦ ?_) (by simp) (fun y z hy hz ↦ ?_)
  · exact LieSubmodule.mem_iSup_of_mem i (LieSubmodule.lie_mem_lie hx hy)
  · rw [lie_add]
    exact add_mem hy hz

variable [LieModule R L M]

section Annihilator

variable (R L)

/-- The elements of `L` annihilating a fixed vector `v` form a Lie subalgebra: the bracket is
linear in its left argument, and the Leibniz rule `lie_lie` closes the set under brackets. -/
def lieAnnihilator (v : M) : LieSubalgebra R L where
  carrier := {x : L | ⁅x, v⁆ = 0}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq] at hx hy ⊢
    rw [add_lie, hx, hy, add_zero]
  zero_mem' := by
    simp only [Set.mem_ofPred_eq]
    rw [zero_lie]
  smul_mem' c x hx := by
    simp only [Set.mem_ofPred_eq] at hx ⊢
    rw [smul_lie, hx, smul_zero]
  lie_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq] at hx hy ⊢
    rw [lie_lie, hx, hy, lie_zero, lie_zero, sub_zero]

/-- Membership in the annihilator of a vector is exactly vanishing of the Lie action. -/
@[simp]
theorem mem_lieAnnihilator {v : M} {x : L} :
    x ∈ lieAnnihilator R L v ↔ ⁅x, v⁆ = 0 :=
  Iff.rfl

/-- **A vector annihilated by a set of Lie elements is annihilated by the Lie subalgebra that set
generates.** The annihilator is a Lie subalgebra, so the universal property of `lieSpan` promotes
vanishing on a generating set to vanishing on the whole span. -/
theorem lieSpan_le_lieAnnihilator {s : Set L} {v : M} (hs : ∀ x ∈ s, ⁅x, v⁆ = 0) :
    LieSubalgebra.lieSpan R L s ≤ lieAnnihilator R L v :=
  LieSubalgebra.lieSpan_le.mpr fun x hx => (mem_lieAnnihilator R L).mpr (hs x hx)

end Annihilator

/-- A Lie module generated by a vector annihilated by every element of the Lie algebra is
trivial. -/
theorem isTrivial_of_forall_lie_eq_zero_of_lieSpan_eq_top {v : M}
    (h : ∀ x : L, ⁅x, v⁆ = 0) (hgen : LieSubmodule.lieSpan R L {v} = ⊤) :
    _root_.LieModule.IsTrivial L M := by
  refine (_root_.LieModule.isTrivial_iff_max_triv_eq_top
    (R := R) (L := L) (M := M)).mpr ?_
  apply eq_top_iff.mpr
  rw [← hgen, LieSubmodule.lieSpan_le]
  exact Set.singleton_subset_iff.mpr
    ((_root_.LieModule.mem_maxTrivSubmodule R L M v).mpr h)

end LieModule

namespace LieModuleHom

/-! ### Morphism spaces of Lie modules -/

/-- When the source is finitely generated and the target is Noetherian as modules over the base
ring, their space of Lie module morphisms is finitely generated over that ring. In particular,
the morphism space of two finite-dimensional Lie modules over a field is finite-dimensional. -/
instance instModuleFinite {R : Type u} {L : Type v} {M : Type w} {N : Type w₁}
    [CommRing R] [LieRing L] [LieAlgebra R L]
    [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [LieRingModule L N] [LieModule R L N]
    [IsNoetherian R N] :
    Module.Finite R (M →ₗ⁅R,L⁆ N) :=
  Module.Finite.equiv (LieModule.maxTrivLinearMapEquivLieModuleHom (R := R) (L := L)
    (M := M) (N := N))

end LieModuleHom

/-- **The adjoint action does not depend on the base ring.** A Lie algebra over two commutative
rings has one bracket, so iterating `ad` over either ring gives the same element. This reads a
higher Serre relation proved over `ℤ` as the relation asked of a Lie algebra over `ℚ`. -/
theorem ad_pow_apply_eq_ad_pow_apply {L : Type*} [LieRing L] (R S : Type*) [CommRing R]
    [CommRing S] [LieAlgebra R L] [LieAlgebra S L] (x y : L) (k : ℕ) :
    (LieAlgebra.ad R L x ^ k) y = (LieAlgebra.ad S L x ^ k) y := by
  induction k generalizing y with
  | zero => simp
  | succ k ih =>
      simp only [pow_succ, Module.End.mul_apply, LieAlgebra.ad_apply]
      exact ih ⁅x, y⁆

section Adjoint

variable {R L L' : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [LieRing L'] [LieAlgebra R L']

/-- An additional adjoint action can be applied to the argument before the preceding powers. -/
theorem ad_pow_succ_apply (x y : L) (n : ℕ) :
    (LieAlgebra.ad R L x ^ (n + 1)) y = (LieAlgebra.ad R L x ^ n) ⁅x, y⁆ := by
  rw [pow_succ, Module.End.mul_apply, LieAlgebra.ad_apply]

/-- If the `n`-fold adjoint action of `x` annihilates `y`, then so does that of `-x`. -/
theorem ad_neg_pow_apply_eq_zero {x y : L} {n : ℕ} (h : (LieAlgebra.ad R L x ^ n) y = 0) :
    (LieAlgebra.ad R L (-x) ^ n) y = 0 := by
  have hneg : LieAlgebra.ad R L (-x) = (-1 : R) • LieAlgebra.ad R L x := by
    rw [map_neg, neg_smul, one_smul]
  rw [hneg, smul_pow, LinearMap.smul_apply, h, smul_zero]

/-- The Engel subalgebra of `-x` is that of `x`: the powers of `ad (-x)` are those of `ad x` up to
sign. -/
@[simp]
theorem _root_.LieSubalgebra.engel_neg (x : L) :
    LieSubalgebra.engel R (-x) = LieSubalgebra.engel R x := by
  ext y
  simp only [LieSubalgebra.mem_engel_iff]
  refine ⟨fun ⟨n, hn⟩ => ⟨n, ?_⟩, fun ⟨n, hn⟩ => ⟨n, ad_neg_pow_apply_eq_zero hn⟩⟩
  simpa using ad_neg_pow_apply_eq_zero hn

/-- **A Lie homomorphism carries the iterated adjoint action.** `f ((ad x) ^ n y)` is
`(ad (f x)) ^ n (f y)`; relations of the form `(ad x) ^ n y = 0`, such as
Serre's, are transported along a homomorphism by this. -/
@[simp]
theorem _root_.LieHom.map_ad_pow (f : L →ₗ⁅R⁆ L') (x : L) (n : ℕ) (y : L) :
    f ((LieAlgebra.ad R L x ^ n) y) = (LieAlgebra.ad R L' (f x) ^ n) (f y) := by
  induction n generalizing y with
  | zero => simp
  | succ n ih =>
    simp only [pow_succ, Module.End.mul_apply, LieAlgebra.ad_apply] at ih ⊢
    rw [ih, f.map_lie]

/-- Adjoint nilpotence descends along a surjective Lie homomorphism. In particular it descends
to a quotient by any Lie ideal, without a finiteness or characteristic hypothesis. -/
theorem _root_.LieHom.isNilpotent_ad_of_surjective
    (f : L →ₗ⁅R⁆ L') (hf : Function.Surjective f) {x : L}
    (hx : IsNilpotent (LieAlgebra.ad R L x)) :
    IsNilpotent (LieAlgebra.ad R L' (f x)) := by
  obtain ⟨n, hn⟩ := hx
  refine ⟨n, LinearMap.ext fun y ↦ ?_⟩
  obtain ⟨z, rfl⟩ := hf y
  rw [← f.map_ad_pow, hn]
  simp

variable (f : L →ₗ⁅R⁆ L') (I : LieIdeal R L')

/-- The restriction of a Lie homomorphism `f` to the preimage of a Lie ideal `I`, as a Lie
homomorphism into `I`. This is the Lie analogue of `LinearMap.submoduleComap`. -/
def _root_.LieHom.lieIdealComap : I.comap f →ₗ⁅R⁆ I where
  toFun x := ⟨f x, LieIdeal.mem_comap.mp x.property⟩
  map_add' _ _ := Subtype.ext (map_add f _ _)
  map_smul' _ _ := Subtype.ext (map_smul f _ _)
  map_lie' := Subtype.ext (f.map_lie _ _)

@[simp]
theorem _root_.LieHom.coe_lieIdealComap_apply (x : I.comap f) :
    (f.lieIdealComap I x : L') = f x := by
  rfl

/-- The restriction of an injective Lie homomorphism to the preimage of a Lie ideal is
injective. -/
theorem _root_.LieHom.lieIdealComap_injective (hf : Function.Injective f) :
    Function.Injective (f.lieIdealComap I) := fun x y h ↦
  Subtype.ext (hf (by simpa using congrArg Subtype.val h))

end Adjoint

end TauCeti

namespace Module.Basis

/-- A bracket coordinate is the sum of the bracket columns weighted by the first argument's
basis coordinates. -/
theorem repr_lie_eq_sum {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    [Fintype ι] (b : Basis ι R L) (X Y : L) (k : ι) :
    b.repr ⁅X, Y⁆ k = ∑ i : ι, b.repr X i * b.repr ⁅b i, Y⁆ k := by
  classical
  conv_lhs => rw [← b.sum_repr X]
  rw [sum_lie]
  simp [smul_lie, map_sum, map_smul, Finsupp.coe_finsetSum, Finset.sum_apply,
    smul_eq_mul]

end Module.Basis
