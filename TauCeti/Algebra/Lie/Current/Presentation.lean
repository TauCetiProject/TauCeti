module

public import TauCeti.Algebra.Category.ModuleCat.Smooth.Presentation
public import TauCeti.Algebra.Lie.Current.LeftIdeal

/-!
# Congruence-quotient presentations of finitely generated smooth modules

Let `U` be the enveloping algebra of a residue central extension at a fixed central value,
and let `I_N` be the left ideal generated by currents of order at least `N`. Every finitely
generated smooth `U`-module is a quotient of a finite sum of copies of `U ⧸ I_N`, for one
positive `N`. Conversely such quotients are smooth, since the congruence quotients are smooth.

The presentation uses a common cutoff only for the finite generating family: it does not
assert that `I_N` annihilates the whole module. This is the algebraic presentation needed to
descend congruence-group actions from induced modules. No group action is constructed here.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §1.3 and §2.1.2.
-/

public section

noncomputable section

namespace TauCeti.CurrentAlgebra

open TauCeti.UniversalEnvelopingAlgebra
open LieAlgebra.ofTwoCocycle (centralElement)

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "U" => CentralQuotient R (centralElement c) a

/-- Every finitely generated smooth level module is a quotient of finitely many copies of
`U / I_N` at one positive order `N`. This includes central value zero and the zero module. -/
theorem exists_surjective_pi_orderQuotient {M : ModuleCat U} [Module.Finite U M]
    (hM : smoothModules (orderLeftIdeal Φ hΦ hΦs a) M) :
    ∃ (N : ℤ), 0 < N ∧ ∃ (n : ℕ)
      (f : (Fin n → U ⧸ orderLeftIdeal Φ hΦ hΦs a N) →ₗ[U] M),
      Function.Surjective f := by
  let J (n : ℕ) := orderLeftIdeal Φ hΦ hΦs a ((n : ℤ) + 1)
  have hJ : Antitone J := fun n m h ↦ orderLeftIdeal_antitone Φ hΦ hΦs a (by omega)
  have hMJ : smoothModules J M := smoothModules_le_of_forall_exists_le
    (J := orderLeftIdeal Φ hΦ hΦs a) (J' := J)
    (fun N ↦ ⟨N.toNat, orderLeftIdeal_antitone Φ hΦ hΦs a (by omega)⟩) M hM
  obtain ⟨N, n, f, hf⟩ :=
    exists_surjective_pi_quotient_of_smoothModules hJ.directed_ge hMJ
  exact ⟨(N : ℤ) + 1, by omega, n, f, hf⟩

/-- Smoothness of a finitely generated level module is equivalent to admitting a
finite-sum congruence-quotient presentation at a positive order. -/
theorem smoothModules_iff_exists_surjective_pi_orderQuotient {M : ModuleCat U}
    [Module.Finite U M] :
    smoothModules (orderLeftIdeal Φ hΦ hΦs a) M ↔
      ∃ (N : ℤ), 0 < N ∧ ∃ (n : ℕ)
        (f : (Fin n → U ⧸ orderLeftIdeal Φ hΦ hΦs a N) →ₗ[U] M),
        Function.Surjective f := by
  refine ⟨exists_surjective_pi_orderQuotient Φ hΦ hΦs a, ?_⟩
  rintro ⟨N, -, n, f, hf⟩
  exact (smoothModules_iff_exists_surjective_pi_quotient
    (orderLeftIdeal_antitone Φ hΦ hΦs a).directed_ge
    (smoothModules_quotient_orderLeftIdeal Φ hΦ hΦs a)).mpr ⟨N, n, f, hf⟩

end TauCeti.CurrentAlgebra
