module

public import TauCeti.Algebra.Category.ModuleCat.Tower.Summation
public import TauCeti.Algebra.Lie.Current.CompletedDerivation
public import TauCeti.Algebra.Lie.Current.ExtendedAffine.LeftIdeal

/-!
# The completed enveloping algebra of the extended affine algebra at a fixed level

Let `ĝ = L((t)) ⊕ R K` be the residue central extension of an invariant symmetric form `Φ`, let
`ĝ' = ĝ ⋊ R d` be the extended affine algebra adjoining `d = t d/dt`, let `U = U(ĝ) / (ι K - a)`
and `U' = U(ĝ') / (ι K - a)` be their level enveloping algebras, and let `I_n = U · ι(a_n)` and
`I'_n = U' · ι(a_n)` be the left ideals generated by currents of order at least `n`. This file
constructs the **completed extended enveloping algebra**

`Û' = lim_n U' / I'_n`

(`TauCeti.CurrentAlgebra.ExtendedCompletedEnveloping`) as a complete Hausdorff left-linearly
topologized `R`-algebra, and relates it to the completed enveloping algebra `Û = lim_n U / I_n`:

* **Ring and topological structure.** By the right-shift estimate `I'_m b ⊆ I'_n`, the inverse limit
  carries the multiplication `TauCeti.ModuleTower.limRing`, making `Û'` a topological `R`-algebra
  whose open left ideals `ker (Û' → U' / I'_n)`
  (`TauCeti.CurrentAlgebra.completedExtendedOrderLeftIdeal`) form a neighborhood basis of `0`.
* **Closed uniform embedding of `Û` into `Û'`.** Since `U ∩ I'_n = I_n`, the inclusion `U → U'`
  extends to a continuous `R`-algebra morphism `Û →ₐ[R] Û'`
  (`TauCeti.CurrentAlgebra.completedToExtended`) pulling `ker π'_n` back to `ker π_n`, so it is an
  injective uniform and closed embedding over every commutative ring and at every level `a`.
* **The completed degree element `d̂`.** The image `d̂` of `d` in `Û'`
  (`TauCeti.CurrentAlgebra.completedDegreeElement`) preserves every `ker π'_n` under right
  multiplication, acts on the image of `Û` by the completed degree derivation
  `[d̂, i(x)] = i(t x')`
  (`TauCeti.CurrentAlgebra.completedDegreeElement_mul_completedToExtended_sub_mul`), and together
  with the image of `Û` topologically generates `Û'`.
* **Completed extended level comparison.** For `Ψ = k • Φ`, the extended level comparison lifts to a
  topological `R`-algebra isomorphism `Û'(Ψ, 1) ≃ₐ[R] Û'(Φ, k)` fixing `d̂` and intertwining
  `levelCompletedEnvelopingEquiv` (`TauCeti.CurrentAlgebra.extendedLevelCompletedEnvelopingEquiv`),
  for every `k` including `k = 0`.
* **Unique `d̂`-series expansion.** Reading off the `j`-th left `d`-coefficient at each stage gives
  a continuous `R`-linear coordinate map `completedDegreeCoeff j : Û' →ₗ[R] Û` such that for every
  `w ∈ Û'`, `completedDegreeCoeff j w → 0` as `j → ∞` and
  `w = ∑' j, completedToExtended (completedDegreeCoeff j w) * d̂ ^ j`
  (`TauCeti.CurrentAlgebra.tsum_completedDegreeCoeff_mul_completedDegreeElement_pow`).

## Main definitions

* `TauCeti.CurrentAlgebra.extendedOrderQuotientTower`: the tower of left-module quotients
  `U' / I'_n`.
* `TauCeti.CurrentAlgebra.ExtendedCompletedEnveloping`: the completed extended enveloping algebra
  `Û' = lim_n U' / I'_n`.
* `TauCeti.CurrentAlgebra.toExtendedCompletedEnveloping`: the canonical algebra map `U' →ₐ[R] Û'`.
* `TauCeti.CurrentAlgebra.completedExtendedOrderLeftIdeal`: the open left ideal
  `ker (Û' → U' / I'_n)`.
* `TauCeti.CurrentAlgebra.completedToExtended`: the continuous embedding `Û →ₐ[R] Û'`.
* `TauCeti.CurrentAlgebra.completedDegreeElement`: the adjoined degree element `d̂ ∈ Û'`.
* `TauCeti.CurrentAlgebra.completedDegreeCoeff`: the continuous `j`-th `d̂`-coordinate `Û' →ₗ[R] Û`.
* `TauCeti.CurrentAlgebra.extendedLevelCompletedEnvelopingEquiv`: the completed level comparison for
  `Û'`.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §4.3.2, for the completed enveloping
  algebra of the extended affine Lie algebra and its expansion in powers of the degree operator.
-/

public section

noncomputable section

open Filter Topology TauCeti.UniversalEnvelopingAlgebra
open scoped LaurentSeries
open LieAlgebra.ofTwoCocycle (centralElement envelopingι)

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

section Completion

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "UK" => CentralQuotient R (centralElement c) a
local notation "UK'" =>
  CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement c)) a

/-- The tower `U' / I'_0 ← U' / I'_1 ← U' / I'_2 ← ⋯` of quotients of `U(ĝ') / (ι K - a)` by the
left ideals of high-order currents. -/
abbrev extendedOrderQuotientTower : ModuleTower UK' :=
  ModuleTower.quotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)

/-- **The completed extended enveloping algebra** `Û' = lim_n U' / I'_n` of the extended affine
algebra `ĝ' = ĝ ⋊ R d` at the central value `a`. -/
abbrev ExtendedCompletedEnveloping : Type _ :=
  (extendedOrderQuotientTower Φ hΦ hΦs a).lim

/-- The kernel of `U' → Û'` is the intersection of all the left ideals `I'_N`. -/
theorem ker_toLimQuotients_extendedOrderLeftIdeal :
    LinearMap.ker
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)) =
      ⨅ N : ℤ, extendedOrderLeftIdeal Φ hΦ hΦs a N := by
  rw [ModuleTower.ker_toLimQuotients, iInf_extendedOrderLeftIdeal_natCast]

instance : Ring (ExtendedCompletedEnveloping Φ hΦ hΦs a) :=
  ModuleTower.limRing (exists_forall_mul_mem_extendedOrderLeftIdeal_natCast Φ hΦ hΦs a)

instance : Algebra R (ExtendedCompletedEnveloping Φ hΦ hΦs a) where
  smul r x := algebraMap R UK' r • x
  algebraMap :=
    { toFun r := ModuleTower.toLimQuotients _ _ (algebraMap R UK' r)
      map_one' := congrArg (ModuleTower.toLimQuotients _ _) (map_one _)
      map_mul' r s := (congrArg (ModuleTower.toLimQuotients _ _) (map_mul _ r s)).trans
        (ModuleTower.toLimQuotients_mul
          (exists_forall_mul_mem_extendedOrderLeftIdeal_natCast Φ hΦ hΦs a) _ _)
      map_zero' := by rw [map_zero, map_zero]
      map_add' r s := by rw [map_add, map_add] }
  commutes' r x := (ModuleTower.smul_eq_limMul _ _ x).symm.trans
    (ModuleTower.limMul_toLimQuotients_of_commute _ (fun b ↦ Algebra.commute_algebraMap_right r b)
      x).symm
  smul_def' r x := ModuleTower.smul_eq_limMul _ _ x

instance : IsScalarTower R UK' (ExtendedCompletedEnveloping Φ hΦ hΦs a) :=
  .of_algebraMap_smul fun _ _ ↦ rfl

/-- **The canonical algebra map** `U' →ₐ[R] Û'` into the completed extended enveloping algebra. -/
def toExtendedCompletedEnveloping : UK' →ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs a :=
  { ModuleTower.toLimRingHom
      (exists_forall_mul_mem_extendedOrderLeftIdeal_natCast Φ hΦ hΦs a) with
    commutes' r := congrFun (ModuleTower.coe_toLimRingHom _) (algebraMap R UK' r) }

/-- The underlying function of `toExtendedCompletedEnveloping` is `ModuleTower.toLimQuotients`. -/
@[simp]
theorem coe_toExtendedCompletedEnveloping :
    ⇑(toExtendedCompletedEnveloping Φ hΦ hΦs a) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) :=
  ModuleTower.coe_toLimRingHom _

/-- The canonical map `U' → Û'` has dense range. -/
theorem denseRange_toExtendedCompletedEnveloping :
    DenseRange (toExtendedCompletedEnveloping Φ hΦ hΦs a) := by
  simpa only [coe_toExtendedCompletedEnveloping] using
    ModuleTower.denseRange_toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)

variable {Φ hΦ hΦs a}

/-- Projecting `toExtendedCompletedEnveloping b` to stage `n` yields its coset modulo `I'_n`. -/
theorem limπ_toExtendedCompletedEnveloping (n : ℕ) (b : UK') :
    (extendedOrderQuotientTower Φ hΦ hΦs a).limπ n (toExtendedCompletedEnveloping Φ hΦ hΦs a b) =
      ModuleTower.quotientsπ _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n b := by
  rw [coe_toExtendedCompletedEnveloping, ← LinearMap.comp_apply,
    ModuleTower.limπ_comp_toLimQuotients]

variable (Φ hΦ hΦs a)

/-- **The kernel of the stage projection** `Û' → U' / I'_n`, an open and closed left ideal of
`Û'`. -/
def completedExtendedOrderLeftIdeal (n : ℕ) :
    Submodule (ExtendedCompletedEnveloping Φ hΦ hΦs a)
      (ExtendedCompletedEnveloping Φ hΦ hΦs a) where
  carrier := LinearMap.ker ((extendedOrderQuotientTower Φ hΦ hΦs a).limπ n)
  add_mem' := add_mem
  zero_mem' := zero_mem _
  smul_mem' x _ hy := ModuleTower.limπ_limMul_eq_zero _ x hy

variable {Φ hΦ hΦs a}

/-- Membership in `completedExtendedOrderLeftIdeal n` means vanishing under the `n`-th stage
projection. -/
@[simp]
theorem mem_completedExtendedOrderLeftIdeal {n : ℕ}
    {x : ExtendedCompletedEnveloping Φ hΦ hΦs a} :
    x ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n ↔
      (extendedOrderQuotientTower Φ hΦ hΦs a).limπ n x = 0 :=
  Iff.rfl

/-- `toExtendedCompletedEnveloping` pulls `completedExtendedOrderLeftIdeal n` back to `I'_n`. -/
theorem toExtendedCompletedEnveloping_mem_completedExtendedOrderLeftIdeal_iff {n : ℕ} {b : UK'} :
    toExtendedCompletedEnveloping Φ hΦ hΦs a b ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n ↔
      b ∈ extendedOrderLeftIdeal Φ hΦ hΦs a n := by
  simp only [coe_toExtendedCompletedEnveloping, mem_completedExtendedOrderLeftIdeal,
    ModuleTower.limπ_apply, ModuleTower.coe_toLimQuotients_apply,
    ModuleTower.quotientsπ_eq_zero_iff]

/-- The right-shift estimate for the open left ideals of `Û'`. -/
theorem exists_forall_mul_mem_completedExtendedOrderLeftIdeal
    (y : ExtendedCompletedEnveloping Φ hΦ hΦs a) (n : ℕ) :
    ∃ m, ∀ x ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a m,
      x * y ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n :=
  ModuleTower.exists_forall_limπ_limMul_eq_zero _ y n

variable (Φ hΦ hΦs a)

/-- The open left ideals `completedExtendedOrderLeftIdeal n` form a neighborhood basis of `0` in
`Û'`. -/
theorem hasBasis_nhds_zero_completedExtendedOrderLeftIdeal :
    (𝓝 (0 : ExtendedCompletedEnveloping Φ hΦ hΦs a)).HasBasis (fun _ : ℕ ↦ True) fun n ↦
      (completedExtendedOrderLeftIdeal Φ hΦ hΦs a n :
        Set (ExtendedCompletedEnveloping Φ hΦ hΦs a)) :=
  (extendedOrderQuotientTower Φ hΦ hΦs a).hasBasis_nhds_zero

instance :
    IsLinearTopology (ExtendedCompletedEnveloping Φ hΦ hΦs a)
      (ExtendedCompletedEnveloping Φ hΦ hΦs a) :=
  .mk_of_hasBasis _ (hasBasis_nhds_zero_completedExtendedOrderLeftIdeal Φ hΦ hΦs a)

instance : IsTopologicalRing (ExtendedCompletedEnveloping Φ hΦ hΦs a) where
  continuous_mul := ModuleTower.continuous_limMul _

/-- Every `completedExtendedOrderLeftIdeal n` is closed in `Û'`. -/
theorem isClosed_completedExtendedOrderLeftIdeal (n : ℕ) :
    IsClosed
      (completedExtendedOrderLeftIdeal Φ hΦ hΦs a n :
        Set (ExtendedCompletedEnveloping Φ hΦ hΦs a)) :=
  (extendedOrderQuotientTower Φ hΦ hΦs a).isClosed_ker_limπ n

/-- Every `completedExtendedOrderLeftIdeal n` is open in `Û'`. -/
theorem isOpen_completedExtendedOrderLeftIdeal (n : ℕ) :
    IsOpen
      (completedExtendedOrderLeftIdeal Φ hΦ hΦs a n :
        Set (ExtendedCompletedEnveloping Φ hΦ hΦs a)) :=
  (extendedOrderQuotientTower Φ hΦ hΦs a).isOpen_ker_limπ n

/-! ### Embedding of `Û` and the completed degree element -/

private theorem orderLeftIdeal_le_comap_toExtendedEnveloping (n : ℕ) :
    orderLeftIdeal Φ hΦ hΦs a n ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap
        (toExtendedEnveloping Φ hΦ hΦs a).toRingHom.toSemilinearMap := by
  intro x hx
  rw [Submodule.mem_comap, RingHom.coe_toSemilinearMap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  exact toExtendedEnveloping_mem_extendedOrderLeftIdeal hx

private def completedToExtendedFun :
    CompletedEnveloping Φ hΦ hΦs a → ExtendedCompletedEnveloping Φ hΦ hΦs a :=
  ⇑(ModuleTower.limQuotientsMap (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
    (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
    (toExtendedEnveloping Φ hΦ hΦs a).toRingHom.toSemilinearMap
    (fun n ↦ ⟨n, orderLeftIdeal_le_comap_toExtendedEnveloping Φ hΦ hΦs a n⟩))

private theorem completedToExtendedFun_toCompletedEnveloping (x : UK) :
    completedToExtendedFun Φ hΦ hΦs a (toCompletedEnveloping Φ hΦ hΦs a x) =
      toExtendedCompletedEnveloping Φ hΦ hΦs a (toExtendedEnveloping Φ hΦ hΦs a x) := by
  rw [completedToExtendedFun, coe_toCompletedEnveloping, coe_toExtendedCompletedEnveloping,
    ModuleTower.limQuotientsMap_toLimQuotients]
  rfl

private theorem continuous_completedToExtendedFun :
    Continuous (completedToExtendedFun Φ hΦ hΦs a) :=
  ModuleTower.continuous_limQuotientsMap _ _ _ _

private theorem completedToExtendedFun_zero :
    completedToExtendedFun Φ hΦ hΦs a 0 = 0 := by
  rw [completedToExtendedFun]
  exact map_zero _

private theorem completedToExtendedFun_add (x y : CompletedEnveloping Φ hΦ hΦs a) :
    completedToExtendedFun Φ hΦ hΦs a (x + y) =
      completedToExtendedFun Φ hΦ hΦs a x + completedToExtendedFun Φ hΦ hΦs a y := by
  rw [completedToExtendedFun]
  exact map_add _ x y

private theorem completedToExtendedFun_one :
    completedToExtendedFun Φ hΦ hΦs a 1 = 1 := by
  rw [← map_one (toCompletedEnveloping Φ hΦ hΦs a),
    completedToExtendedFun_toCompletedEnveloping, map_one, map_one]

private theorem completedToExtendedFun_mul (x y : CompletedEnveloping Φ hΦ hΦs a) :
    completedToExtendedFun Φ hΦ hΦs a (x * y) =
      completedToExtendedFun Φ hΦ hΦs a x * completedToExtendedFun Φ hΦ hΦs a y := by
  have hf := continuous_completedToExtendedFun Φ hΦ hΦs a
  induction x, y using (denseRange_toCompletedEnveloping Φ hΦ hΦs a).induction_on₂ with
  | hp =>
    exact isClosed_eq (hf.comp continuous_mul) (continuous_mul.comp (hf.prodMap hf))
  | h b₁ b₂ =>
    calc
      completedToExtendedFun Φ hΦ hΦs a
          (toCompletedEnveloping Φ hΦ hΦs a b₁ * toCompletedEnveloping Φ hΦ hΦs a b₂)
        = completedToExtendedFun Φ hΦ hΦs a (toCompletedEnveloping Φ hΦ hΦs a (b₁ * b₂)) :=
          congrArg (completedToExtendedFun Φ hΦ hΦs a)
            (map_mul (toCompletedEnveloping Φ hΦ hΦs a) b₁ b₂).symm
      _ = toExtendedCompletedEnveloping Φ hΦ hΦs a
            (toExtendedEnveloping Φ hΦ hΦs a (b₁ * b₂)) :=
          completedToExtendedFun_toCompletedEnveloping Φ hΦ hΦs a (b₁ * b₂)
      _ = toExtendedCompletedEnveloping Φ hΦ hΦs a (toExtendedEnveloping Φ hΦ hΦs a b₁) *
            toExtendedCompletedEnveloping Φ hΦ hΦs a (toExtendedEnveloping Φ hΦ hΦs a b₂) := by
          rw [map_mul, map_mul]
      _ = completedToExtendedFun Φ hΦ hΦs a (toCompletedEnveloping Φ hΦ hΦs a b₁) *
            completedToExtendedFun Φ hΦ hΦs a (toCompletedEnveloping Φ hΦ hΦs a b₂) :=
          congrArg₂ (· * ·)
            (completedToExtendedFun_toCompletedEnveloping Φ hΦ hΦs a b₁).symm
            (completedToExtendedFun_toCompletedEnveloping Φ hΦ hΦs a b₂).symm

private theorem completedToExtendedFun_algebraMap (r : R) :
    completedToExtendedFun Φ hΦ hΦs a (algebraMap R (CompletedEnveloping Φ hΦ hΦs a) r) =
      algebraMap R (ExtendedCompletedEnveloping Φ hΦ hΦs a) r := by
  rw [← (toCompletedEnveloping Φ hΦ hΦs a).commutes r,
    completedToExtendedFun_toCompletedEnveloping, (toExtendedEnveloping Φ hΦ hΦs a).commutes r,
    (toExtendedCompletedEnveloping Φ hΦ hΦs a).commutes r]

/-- **The canonical continuous algebra map** `Û →ₐ[R] Û'` extending `U → U'`. -/
def completedToExtended :
    CompletedEnveloping Φ hΦ hΦs a →ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs a where
  toFun := completedToExtendedFun Φ hΦ hΦs a
  map_one' := completedToExtendedFun_one Φ hΦ hΦs a
  map_mul' := completedToExtendedFun_mul Φ hΦ hΦs a
  map_zero' := completedToExtendedFun_zero Φ hΦ hΦs a
  map_add' := completedToExtendedFun_add Φ hΦ hΦs a
  commutes' := completedToExtendedFun_algebraMap Φ hΦ hΦs a

/-- `completedToExtended` intertwines `ModuleTower.toLimQuotients` with `toExtendedEnveloping`. -/
@[simp]
theorem completedToExtended_toLimQuotients (x : UK) :
    completedToExtended Φ hΦ hΦs a
        (ModuleTower.toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
        (toExtendedEnveloping Φ hΦ hΦs a x) :=
  ModuleTower.limQuotientsMap_toLimQuotients _ _ _ _ x

/-- `completedToExtended` extends `toExtendedEnveloping` along `toCompletedEnveloping`. -/
theorem completedToExtended_toCompletedEnveloping (x : UK) :
    completedToExtended Φ hΦ hΦs a (toCompletedEnveloping Φ hΦ hΦs a x) =
      toExtendedCompletedEnveloping Φ hΦ hΦs a (toExtendedEnveloping Φ hΦ hΦs a x) :=
  completedToExtendedFun_toCompletedEnveloping Φ hΦ hΦs a x

/-- `completedToExtended : Û → Û'` is continuous. -/
theorem continuous_completedToExtended : Continuous (completedToExtended Φ hΦ hΦs a) :=
  continuous_completedToExtendedFun Φ hΦ hΦs a

variable {Φ hΦ hΦs a} in
/-- `completedToExtended` pulls the `n`-th stage kernel of `Û'` back to the `n`-th stage kernel of
`Û`. -/
theorem completedToExtended_mem_completedExtendedOrderLeftIdeal_iff {n : ℕ}
    {x : CompletedEnveloping Φ hΦ hΦs a} :
    completedToExtended Φ hΦ hΦs a x ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n ↔
      x ∈ completedOrderLeftIdeal Φ hΦ hΦs a n := by
  obtain ⟨b, hb⟩ := ModuleTower.quotientsπ_surjective _ _ n
    ((orderQuotientTower Φ hΦ hΦs a).limπ n x)
  have hπ : (extendedOrderQuotientTower Φ hΦ hΦs a).limπ n (completedToExtended Φ hΦ hΦs a x) =
      ModuleTower.quotientsπ _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n
        (toExtendedEnveloping Φ hΦ hΦs a b) :=
    ModuleTower.limπ_limQuotientsMap _ _ _ _
      (orderLeftIdeal_le_comap_toExtendedEnveloping Φ hΦ hΦs a n) hb
  rw [mem_completedExtendedOrderLeftIdeal, mem_completedOrderLeftIdeal, hπ, ← hb,
    ModuleTower.quotientsπ_eq_zero_iff, ModuleTower.quotientsπ_eq_zero_iff,
    toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff]

/-- **The completed degree element** `d̂ ∈ Û'`, image of `d = t d/dt`. -/
def completedDegreeElement : ExtendedCompletedEnveloping Φ hΦ hΦs a :=
  toExtendedCompletedEnveloping Φ hΦ hΦs a (CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs))

variable {Φ hΦ hΦs a} in
/-- **Right multiplication by `d̂` preserves every stage kernel of `Û'`.** -/
theorem mul_completedDegreeElement_mem_completedExtendedOrderLeftIdeal {n : ℕ}
    {w : ExtendedCompletedEnveloping Φ hΦ hΦs a}
    (hw : w ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n) :
    w * completedDegreeElement Φ hΦ hΦs a ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n := by
  rw [mem_completedExtendedOrderLeftIdeal] at hw ⊢
  change (extendedOrderQuotientTower Φ hΦ hΦs a).limπ n
    (ModuleTower.limMul (exists_forall_mul_mem_extendedOrderLeftIdeal_natCast Φ hΦ hΦs a) w
      (toExtendedCompletedEnveloping Φ hΦ hΦs a
        (CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs)))) = 0
  rw [ModuleTower.limπ_limMul, limπ_toExtendedCompletedEnveloping,
    ModuleTower.limSmul_quotientsπ
      (exists_forall_mul_mem_extendedOrderLeftIdeal_natCast Φ hΦ hΦs a) (m := n)
      (fun _ hc' ↦ mul_ι_degreeElement_mem_extendedOrderLeftIdeal hc') (b := 0)
      (by rw [map_zero, hw]),
    zero_mul, map_zero]

variable {Φ hΦ hΦs a} in
/-- Right multiplication by `d̂ᵐ` preserves every stage kernel of `Û'`. -/
theorem mul_completedDegreeElement_pow_mem_completedExtendedOrderLeftIdeal {n : ℕ}
    {w : ExtendedCompletedEnveloping Φ hΦ hΦs a}
    (hw : w ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n) (m : ℕ) :
    w * completedDegreeElement Φ hΦ hΦs a ^ m ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n := by
  induction m with
  | zero => simpa using hw
  | succ m ih =>
    rw [pow_succ, ← mul_assoc]
    exact mul_completedDegreeElement_mem_completedExtendedOrderLeftIdeal ih

/-- **Inner derivation by `d̂` restricts on `Û` to the completed degree derivation**:
`d̂ * i(x) - i(x) * d̂ = i(t x')` for all `x ∈ Û`. -/
theorem completedDegreeElement_mul_completedToExtended_sub_mul
    (x : CompletedEnveloping Φ hΦ hΦs a) :
    completedDegreeElement Φ hΦ hΦs a * completedToExtended Φ hΦ hΦs a x -
        completedToExtended Φ hΦ hΦs a x * completedDegreeElement Φ hΦ hΦs a =
      completedToExtended Φ hΦ hΦs a
        ((vectorFieldCompletedEnvelopingDerivation Φ hΦ hΦs a (HahnSeries.single 1 1) :
          Module.End R (CompletedEnveloping Φ hΦ hΦs a)) x) := by
  have hi := continuous_completedToExtended Φ hΦ hΦs a
  have hδ := continuous_vectorFieldCompletedEnvelopingDerivation Φ hΦ hΦs a (HahnSeries.single 1 1)
  induction x using (denseRange_toCompletedEnveloping Φ hΦ hΦs a).induction_on with
  | hp =>
    exact isClosed_eq ((continuous_const.mul hi).sub (hi.mul continuous_const)) (hi.comp hδ)
  | ih b =>
    rw [completedToExtended_toCompletedEnveloping, completedDegreeElement, ← map_mul, ← map_mul,
      ← map_sub, ι_degreeElement_mul_sub_mul, coe_toCompletedEnveloping,
      vectorFieldCompletedEnvelopingDerivation_toLimQuotients,
      completedToExtended_toCompletedEnveloping]

/-- `U'` is generated as an `R`-algebra by `d` and the image of `U`. -/
theorem adjoin_insert_ι_degreeElement_range_toExtendedEnveloping :
    Algebra.adjoin R
        (insert (CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs))
          (Set.range (toExtendedEnveloping Φ hΦ hΦs a))) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  let e := extendedEnvelopingOreEquiv Φ hΦ hΦs a
  rw [← e.symm_apply_apply x, ← OreExtension.sum_monomial_eq (e x), map_sum]
  refine sum_mem fun n _ ↦ ?_
  rw [extendedEnvelopingOreEquiv_symm_monomial]
  exact mul_mem (Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨_, rfl⟩))
    (pow_mem (Algebra.subset_adjoin (Set.mem_insert _ _)) n)

/-- **Topological generation of `Û'`.** The image of `Û` together with `d̂` topologically generates
`Û'`. -/
theorem topologicalClosure_adjoin_insert_completedDegreeElement_range_completedToExtended :
    (Algebra.adjoin R
        (insert (completedDegreeElement Φ hΦ hΦs a)
          (Set.range (completedToExtended Φ hΦ hΦs a)))).topologicalClosure = ⊤ := by
  have hle : (toExtendedCompletedEnveloping Φ hΦ hΦs a).range ≤
      Algebra.adjoin R
        (insert (completedDegreeElement Φ hΦ hΦs a)
          (Set.range (completedToExtended Φ hΦ hΦs a))) := by
    rw [← Algebra.map_top, ← adjoin_insert_ι_degreeElement_range_toExtendedEnveloping Φ hΦ hΦs a,
      AlgHom.map_adjoin]
    refine Algebra.adjoin_mono ?_
    intro x hx
    rcases hx with ⟨_, rfl | ⟨b, rfl⟩, rfl⟩
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _
        ⟨toCompletedEnveloping Φ hΦ hΦs a b, completedToExtended_toCompletedEnveloping Φ hΦ hΦs a b⟩
  rw [eq_top_iff]
  have htop : (toExtendedCompletedEnveloping Φ hΦ hΦs a).range.topologicalClosure = ⊤ := by
    rw [SetLike.ext'_iff]
    simpa using (denseRange_toExtendedCompletedEnveloping Φ hΦ hΦs a).closure_range
  exact htop ▸ Subalgebra.topologicalClosure_mono hle

/-! ### Left `d̂`-coefficient extraction and series expansion -/

/-- Auxiliary stagewise extraction of the `j`-th left `d`-coefficient modulo `I_n`. -/
private def stageDegreeCoeff (j n : ℕ)
    (q : (extendedOrderQuotientTower Φ hΦ hΦs a).obj (Opposite.op n)) :
    (orderQuotientTower Φ hΦ hΦs a).obj (Opposite.op n) :=
  ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n
    ((extendedEnvelopingOreEquiv Φ hΦ hΦs a
      (ModuleTower.quotientsπ_surjective _ _ n q).choose).coeff j)

private theorem stageDegreeCoeff_quotientsπ (j n : ℕ) (x : UK') :
    stageDegreeCoeff Φ hΦ hΦs a j n
        (ModuleTower.quotientsπ _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n x) =
      ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n
        ((extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff j) := by
  let q := ModuleTower.quotientsπ _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n x
  have hy : ModuleTower.quotientsπ _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n
      (ModuleTower.quotientsπ_surjective _ _ n q).choose = q :=
    (ModuleTower.quotientsπ_surjective _ _ n q).choose_spec
  rw [ModuleTower.quotientsπ_eq_quotientsπ_iff, mem_extendedOrderLeftIdeal_iff_coeff] at hy
  rw [stageDegreeCoeff, ModuleTower.quotientsπ_eq_quotientsπ_iff, ← OreExtension.coeff_sub,
    ← map_sub]
  exact hy j

private theorem stageDegreeCoeff_add (j n : ℕ)
    (q₁ q₂ : (extendedOrderQuotientTower Φ hΦ hΦs a).obj (Opposite.op n)) :
    stageDegreeCoeff Φ hΦ hΦs a j n (q₁ + q₂) =
      stageDegreeCoeff Φ hΦ hΦs a j n q₁ + stageDegreeCoeff Φ hΦ hΦs a j n q₂ := by
  obtain ⟨x₁, rfl⟩ := ModuleTower.quotientsπ_surjective _ _ n q₁
  obtain ⟨x₂, rfl⟩ := ModuleTower.quotientsπ_surjective _ _ n q₂
  rw [← map_add, stageDegreeCoeff_quotientsπ, stageDegreeCoeff_quotientsπ,
    stageDegreeCoeff_quotientsπ, map_add, OreExtension.coeff_add, map_add]

private theorem stageDegreeCoeff_algebraMap_smul (j n : ℕ) (r : R)
    (q : (extendedOrderQuotientTower Φ hΦ hΦs a).obj (Opposite.op n)) :
    stageDegreeCoeff Φ hΦ hΦs a j n (algebraMap R UK' r • q) =
      algebraMap R UK r • stageDegreeCoeff Φ hΦ hΦs a j n q := by
  obtain ⟨x, rfl⟩ := ModuleTower.quotientsπ_surjective _ _ n q
  have hsmul : algebraMap R UK' r = toExtendedEnveloping Φ hΦ hΦs a (algebraMap R UK r) :=
    ((toExtendedEnveloping Φ hΦ hΦs a).commutes r).symm
  rw [← map_smul, smul_eq_mul, hsmul, stageDegreeCoeff_quotientsπ, stageDegreeCoeff_quotientsπ,
    map_mul, extendedEnvelopingOreEquiv_toExtendedEnveloping, OreExtension.coeff_C_mul,
    ← smul_eq_mul, map_smul]

private theorem transition_stageDegreeCoeff (j n : ℕ)
    (q : (extendedOrderQuotientTower Φ hΦ hΦs a).obj (Opposite.op (n + 1))) :
    (orderQuotientTower Φ hΦ hΦs a).transition n (stageDegreeCoeff Φ hΦ hΦs a j (n + 1) q) =
      stageDegreeCoeff Φ hΦ hΦs a j n ((extendedOrderQuotientTower Φ hΦ hΦs a).transition n q) := by
  obtain ⟨x, rfl⟩ := ModuleTower.quotientsπ_surjective _ _ (n + 1) q
  rw [stageDegreeCoeff_quotientsπ, ModuleTower.transition_quotientsπ,
    ModuleTower.transition_quotientsπ, stageDegreeCoeff_quotientsπ]

private theorem eq_zero_iff_forall_stageDegreeCoeff (n : ℕ)
    (q : (extendedOrderQuotientTower Φ hΦ hΦs a).obj (Opposite.op n)) :
    q = 0 ↔ ∀ j, stageDegreeCoeff Φ hΦ hΦs a j n q = 0 := by
  obtain ⟨x, rfl⟩ := ModuleTower.quotientsπ_surjective _ _ n q
  simp only [stageDegreeCoeff_quotientsπ, ModuleTower.quotientsπ_eq_zero_iff,
    mem_extendedOrderLeftIdeal_iff_coeff]

private def completedDegreeCoeffAux (j : ℕ)
    (w : ExtendedCompletedEnveloping Φ hΦ hΦs a) :
    CompletedEnveloping Φ hΦ hΦs a :=
  ⟨fun n ↦ stageDegreeCoeff Φ hΦ hΦs a j n
      ((extendedOrderQuotientTower Φ hΦ hΦs a).limπ n w),
    (orderQuotientTower Φ hΦ hΦs a).mem_lim.2 fun n ↦ by
      rw [transition_stageDegreeCoeff, ← LinearMap.comp_apply,
        ModuleTower.transition_comp_limπ]⟩

private theorem limπ_completedDegreeCoeffAux (j n : ℕ)
    (w : ExtendedCompletedEnveloping Φ hΦ hΦs a) :
    (orderQuotientTower Φ hΦ hΦs a).limπ n (completedDegreeCoeffAux Φ hΦ hΦs a j w) =
      stageDegreeCoeff Φ hΦ hΦs a j n ((extendedOrderQuotientTower Φ hΦ hΦs a).limπ n w) :=
  (orderQuotientTower Φ hΦ hΦs a).limπ_apply n _

/-- **The `j`-th completed `d̂`-coefficient** `Û' →ₗ[R] Û`, reading off the `j`-th left
`d`-coefficient compatibly across all stage quotients. -/
def completedDegreeCoeff (j : ℕ) :
    ExtendedCompletedEnveloping Φ hΦ hΦs a →ₗ[R] CompletedEnveloping Φ hΦ hΦs a where
  toFun := completedDegreeCoeffAux Φ hΦ hΦs a j
  map_add' w₁ w₂ := ModuleTower.lim_ext _ fun n ↦ by
    simp only [map_add, limπ_completedDegreeCoeffAux, stageDegreeCoeff_add]
  map_smul' r w := ModuleTower.lim_ext _ fun n ↦ by
    rw [RingHom.id_apply, ← algebraMap_smul UK' r w,
      ← algebraMap_smul UK r (completedDegreeCoeffAux Φ hΦ hΦs a j w), map_smul,
      limπ_completedDegreeCoeffAux, limπ_completedDegreeCoeffAux, map_smul,
      stageDegreeCoeff_algebraMap_smul]

private theorem limπ_completedDegreeCoeff (j n : ℕ)
    (w : ExtendedCompletedEnveloping Φ hΦ hΦs a) :
    (orderQuotientTower Φ hΦ hΦs a).limπ n (completedDegreeCoeff Φ hΦ hΦs a j w) =
      stageDegreeCoeff Φ hΦ hΦs a j n ((extendedOrderQuotientTower Φ hΦ hΦs a).limπ n w) :=
  limπ_completedDegreeCoeffAux Φ hΦ hΦs a j n w

/-- `completedDegreeCoeff j` acts on `ModuleTower.toLimQuotients` by extracting the `j`-th Ore
coefficient. -/
@[simp]
theorem completedDegreeCoeff_toLimQuotients (j : ℕ) (x : UK') :
    completedDegreeCoeff Φ hΦ hΦs a j
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) x) =
      ModuleTower.toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
        ((extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff j) := by
  refine ModuleTower.lim_ext _ fun n ↦ ?_
  rw [limπ_completedDegreeCoeff, ← coe_toExtendedCompletedEnveloping,
    limπ_toExtendedCompletedEnveloping, stageDegreeCoeff_quotientsπ,
    ← coe_toCompletedEnveloping, limπ_toCompletedEnveloping]

/-- `completedDegreeCoeff j` acts on `toExtendedCompletedEnveloping` by extracting the `j`-th Ore
coefficient. -/
theorem completedDegreeCoeff_toExtendedCompletedEnveloping (j : ℕ) (x : UK') :
    completedDegreeCoeff Φ hΦ hΦs a j (toExtendedCompletedEnveloping Φ hΦ hΦs a x) =
      toCompletedEnveloping Φ hΦ hΦs a ((extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff j) := by
  rw [coe_toExtendedCompletedEnveloping, coe_toCompletedEnveloping,
    completedDegreeCoeff_toLimQuotients]

variable {Φ hΦ hΦs a} in
/-- An element of `Û'` lies in the `n`-th stage kernel if and only if each of its completed
`d̂`-coefficients lies in the `n`-th stage kernel of `Û`. -/
theorem mem_completedExtendedOrderLeftIdeal_iff_forall_completedDegreeCoeff {n : ℕ}
    {w : ExtendedCompletedEnveloping Φ hΦ hΦs a} :
    w ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n ↔
      ∀ j, completedDegreeCoeff Φ hΦ hΦs a j w ∈ completedOrderLeftIdeal Φ hΦ hΦs a n := by
  simp only [mem_completedExtendedOrderLeftIdeal, eq_zero_iff_forall_stageDegreeCoeff,
    mem_completedOrderLeftIdeal, limπ_completedDegreeCoeff]

/-- Two elements of `Û'` are equal when all their completed `d̂`-coefficients agree. -/
theorem ext_completedDegreeCoeff {w₁ w₂ : ExtendedCompletedEnveloping Φ hΦ hΦs a}
    (h : ∀ j, completedDegreeCoeff Φ hΦ hΦs a j w₁ = completedDegreeCoeff Φ hΦ hΦs a j w₂) :
    w₁ = w₂ := by
  rw [← sub_eq_zero]
  refine ModuleTower.lim_ext _ fun n ↦ ?_
  rw [map_zero, ← mem_completedExtendedOrderLeftIdeal,
    mem_completedExtendedOrderLeftIdeal_iff_forall_completedDegreeCoeff]
  intro j
  rw [map_sub, h j, sub_self]
  exact zero_mem _

/-- Every coordinate map `completedDegreeCoeff j : Û' → Û` is continuous. -/
theorem continuous_completedDegreeCoeff (j : ℕ) :
    Continuous (completedDegreeCoeff Φ hΦ hΦs a j) := by
  refine continuous_of_tendsto_nhds_zero (completedDegreeCoeff Φ hΦ hΦs a j)
    (((hasBasis_nhds_zero_completedExtendedOrderLeftIdeal Φ hΦ hΦs a).tendsto_iff
      (hasBasis_nhds_zero_completedOrderLeftIdeal Φ hΦ hΦs a)).2 fun n _ ↦ ?_)
  exact ⟨n, trivial, fun w hw ↦
    (mem_completedExtendedOrderLeftIdeal_iff_forall_completedDegreeCoeff.1 hw) j⟩

/-- `completedDegreeCoeff j` extracts `u` from `i(u) * d̂ ^ k` when `k = j` and `0` otherwise. -/
@[simp]
theorem completedDegreeCoeff_completedToExtended_mul_pow (j k : ℕ)
    (u : CompletedEnveloping Φ hΦ hΦs a) :
    completedDegreeCoeff Φ hΦ hΦs a j
        (completedToExtended Φ hΦ hΦs a u * completedDegreeElement Φ hΦ hΦs a ^ k) =
      if k = j then u else 0 := by
  have hc := continuous_completedDegreeCoeff Φ hΦ hΦs a j
  have hi := continuous_completedToExtended Φ hΦ hΦs a
  have hrhs : Continuous fun u : CompletedEnveloping Φ hΦ hΦs a ↦ if k = j then u else 0 := by
    by_cases hkj : k = j <;> simp [hkj, continuous_id', continuous_const]
  induction u using (denseRange_toCompletedEnveloping Φ hΦ hΦs a).induction_on with
  | hp => exact isClosed_eq (hc.comp (hi.mul continuous_const)) hrhs
  | ih b =>
    rw [completedToExtended_toCompletedEnveloping, completedDegreeElement, ← map_pow, ← map_mul,
      ← extendedEnvelopingOreEquiv_symm_monomial,
      completedDegreeCoeff_toExtendedCompletedEnveloping, AlgEquiv.apply_symm_apply,
      OreExtension.coeff_monomial]
    by_cases hkj : k = j <;> simp [hkj]

/-- The `0`-th `d̂`-coordinate of `completedToExtended u` is `u`. -/
@[simp]
theorem completedDegreeCoeff_zero_completedToExtended (u : CompletedEnveloping Φ hΦ hΦs a) :
    completedDegreeCoeff Φ hΦ hΦs a 0 (completedToExtended Φ hΦ hΦs a u) = u := by
  simpa using completedDegreeCoeff_completedToExtended_mul_pow Φ hΦ hΦs a 0 0 u

/-- `completedDegreeCoeff 0` is a left inverse to `completedToExtended`. -/
theorem leftInverse_completedDegreeCoeff_zero_completedToExtended :
    Function.LeftInverse (completedDegreeCoeff Φ hΦ hΦs a 0) (completedToExtended Φ hΦ hΦs a) :=
  completedDegreeCoeff_zero_completedToExtended Φ hΦ hΦs a

/-- **`Û` embeds injectively into `Û'`**, over every commutative ring and at every level `a`. -/
theorem completedToExtended_injective : Function.Injective (completedToExtended Φ hΦ hΦs a) :=
  (leftInverse_completedDegreeCoeff_zero_completedToExtended Φ hΦ hΦs a).injective

/-- **`completedToExtended : Û → Û'` is a closed embedding.** -/
theorem isClosedEmbedding_completedToExtended :
    IsClosedEmbedding (completedToExtended Φ hΦ hΦs a) :=
  (leftInverse_completedDegreeCoeff_zero_completedToExtended Φ hΦ hΦs a).isClosedEmbedding
    (continuous_completedDegreeCoeff Φ hΦ hΦs a 0) (continuous_completedToExtended Φ hΦ hΦs a)

/-- **`completedToExtended : Û → Û'` is a uniform embedding.** -/
theorem isUniformEmbedding_completedToExtended :
    IsUniformEmbedding (completedToExtended Φ hΦ hΦs a) :=
  AddMonoidHom.isUniformEmbedding_of_isEmbedding
    (f := (completedToExtended Φ hΦ hΦs a).toAddMonoidHom)
    (isClosedEmbedding_completedToExtended Φ hΦ hΦs a).isEmbedding

/-- **The completed `d̂`-coefficients of every element of `Û'` tend to `0`.** -/
theorem tendsto_completedDegreeCoeff_atTop (w : ExtendedCompletedEnveloping Φ hΦ hΦs a) :
    Tendsto (fun j ↦ completedDegreeCoeff Φ hΦ hΦs a j w) atTop (𝓝 0) := by
  rw [ModuleTower.tendsto_nhds_iff]
  intro n
  obtain ⟨x, hx⟩ := ModuleTower.quotientsπ_surjective _ _ n
    ((extendedOrderQuotientTower Φ hΦ hΦs a).limπ n w)
  let s := (extendedEnvelopingOreEquiv Φ hΦ hΦs a x).toFinsupp.support
  refine eventually_atTop.2 ⟨s.sup id + 1, fun j hj ↦ ?_⟩
  have hjs : j ∉ s := fun hmem ↦ by
    have hle : j ≤ s.sup id := Finset.le_sup (f := id) hmem
    omega
  have hcoeff : (extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff j = 0 := by
    rw [OreExtension.coeff_def]
    exact Classical.not_not.1 (mt Finsupp.mem_support_iff.2 hjs)
  rw [map_zero, limπ_completedDegreeCoeff, ← hx, stageDegreeCoeff_quotientsπ, hcoeff, map_zero]

/-- For any sequence `u : ℕ → Û` tending to `0`, the series
`∑ j, completedToExtended (u j) * d̂ ^ j` converges in `Û'`. -/
theorem summable_completedToExtended_mul_completedDegreeElement_pow
    {u : ℕ → CompletedEnveloping Φ hΦ hΦs a} (hu : Tendsto u atTop (𝓝 0)) :
    Summable fun j ↦
      completedToExtended Φ hΦ hΦs a (u j) * completedDegreeElement Φ hΦ hΦs a ^ j := by
  rw [ModuleTower.summable_iff_forall_eventually_limπ_eq_zero]
  intro n
  rw [Nat.cofinite_eq_atTop]
  have hmem := ((hasBasis_nhds_zero_completedOrderLeftIdeal Φ hΦ hΦs a).tendsto_right_iff.1 hu)
    n trivial
  filter_upwards [hmem] with j hj
  rw [← mem_completedExtendedOrderLeftIdeal]
  exact mul_completedDegreeElement_pow_mem_completedExtendedOrderLeftIdeal
    (completedToExtended_mem_completedExtendedOrderLeftIdeal_iff.2 hj) j

/-- Extracting the `j`-th `d̂`-coordinate of a convergent `d̂`-power series returns its `j`-th
coefficient. -/
@[simp]
theorem completedDegreeCoeff_tsum_completedToExtended_mul_completedDegreeElement_pow
    {u : ℕ → CompletedEnveloping Φ hΦ hΦs a} (hu : Tendsto u atTop (𝓝 0)) (j : ℕ) :
    completedDegreeCoeff Φ hΦ hΦs a j
        (∑' k, completedToExtended Φ hΦ hΦs a (u k) * completedDegreeElement Φ hΦ hΦs a ^ k) =
      u j := by
  have hs := summable_completedToExtended_mul_completedDegreeElement_pow Φ hΦ hΦs a hu
  have hmap := (hs.hasSum.map (completedDegreeCoeff Φ hΦ hΦs a j).toAddMonoidHom
    (continuous_completedDegreeCoeff Φ hΦ hΦs a j)).tsum_eq
  simpa only [LinearMap.toAddMonoidHom_coe, Function.comp_apply,
    completedDegreeCoeff_completedToExtended_mul_pow, tsum_ite_eq] using hmap.symm

/-- **Every element of `Û'` is the sum of its `d̂`-power series.** -/
@[simp]
theorem tsum_completedDegreeCoeff_mul_completedDegreeElement_pow
    (w : ExtendedCompletedEnveloping Φ hΦ hΦs a) :
    (∑' j, completedToExtended Φ hΦ hΦs a (completedDegreeCoeff Φ hΦ hΦs a j w) *
        completedDegreeElement Φ hΦ hΦs a ^ j) = w := by
  refine ext_completedDegreeCoeff Φ hΦ hΦs a fun j ↦ ?_
  exact completedDegreeCoeff_tsum_completedToExtended_mul_completedDegreeElement_pow Φ hΦ hΦs a
    (tendsto_completedDegreeCoeff_atTop Φ hΦ hΦs a w) j

end Completion

/-! ### Injectivity of `U' → Û'` over a field -/

section Field

variable {K : Type*} [Field K] [LieAlgebra K L]
  (Φ : LinearMap.BilinForm K L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : K)

/-- Over a field, the canonical map `U(ĝ') / (ι K - a) → Û'` is injective at every level `a`. -/
theorem toExtendedCompletedEnveloping_injective :
    Function.Injective (toExtendedCompletedEnveloping Φ hΦ hΦs a) := by
  rw [coe_toExtendedCompletedEnveloping, ModuleTower.toLimQuotients_injective_iff,
    iInf_extendedOrderLeftIdeal_natCast, iInf_extendedOrderLeftIdeal]

end Field

/-! ### Functoriality and the completed extended level comparison -/

section Map

variable {Φ Ψ : LinearMap.BilinForm R L} {hΦ : Φ.lieInvariant L} {hΦs : Φ.IsSymm}
  {hΨ : Ψ.lieInvariant L} {hΨs : Ψ.IsSymm} {a b : R}

local notation "cΦ" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "cΨ" => twoCocycleOfBilinear R L Ψ hΨ hΨs
local notation "UK'Ψ" =>
  CentralQuotient R (toExtendedResidueExtension Ψ hΨ hΨs (centralElement cΨ)) b
local notation "UK'Φ" =>
  CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement cΦ)) a

private def extendedCompletedEnvelopingMapFun (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    ExtendedCompletedEnveloping Ψ hΨ hΨs b → ExtendedCompletedEnveloping Φ hΦ hΦs a :=
  ⇑(ModuleTower.limQuotientsMap
    (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs b)
    (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
    g.toRingHom.toSemilinearMap hg)

private theorem extendedCompletedEnvelopingMapFun_toExtendedCompletedEnveloping
    (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) (x : UK'Ψ) :
    extendedCompletedEnvelopingMapFun g hg (toExtendedCompletedEnveloping Ψ hΨ hΨs b x) =
      toExtendedCompletedEnveloping Φ hΦ hΦs a (g x) := by
  rw [extendedCompletedEnvelopingMapFun, coe_toExtendedCompletedEnveloping,
    coe_toExtendedCompletedEnveloping, ModuleTower.limQuotientsMap_toLimQuotients]
  rfl

private theorem continuous_extendedCompletedEnvelopingMapFun (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    Continuous (extendedCompletedEnvelopingMapFun g hg) :=
  ModuleTower.continuous_limQuotientsMap _ _ _ _

private theorem extendedCompletedEnvelopingMapFun_zero (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    extendedCompletedEnvelopingMapFun g hg 0 = 0 := by
  rw [extendedCompletedEnvelopingMapFun]
  exact map_zero _

private theorem extendedCompletedEnvelopingMapFun_add (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    (x y : ExtendedCompletedEnveloping Ψ hΨ hΨs b) :
    extendedCompletedEnvelopingMapFun g hg (x + y) =
      extendedCompletedEnvelopingMapFun g hg x + extendedCompletedEnvelopingMapFun g hg y := by
  rw [extendedCompletedEnvelopingMapFun]
  exact map_add _ x y

private theorem extendedCompletedEnvelopingMapFun_one (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    extendedCompletedEnvelopingMapFun g hg 1 = 1 := by
  rw [← map_one (toExtendedCompletedEnveloping Ψ hΨ hΨs b),
    extendedCompletedEnvelopingMapFun_toExtendedCompletedEnveloping, map_one, map_one]

private theorem extendedCompletedEnvelopingMapFun_mul (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    (x y : ExtendedCompletedEnveloping Ψ hΨ hΨs b) :
    extendedCompletedEnvelopingMapFun g hg (x * y) =
      extendedCompletedEnvelopingMapFun g hg x * extendedCompletedEnvelopingMapFun g hg y :=
  ModuleTower.limQuotientsMap_limMul _ _ _ _ _ x y

private theorem extendedCompletedEnvelopingMapFun_algebraMap (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) (r : R) :
    extendedCompletedEnvelopingMapFun g hg
        (algebraMap R (ExtendedCompletedEnveloping Ψ hΨ hΨs b) r) =
      algebraMap R (ExtendedCompletedEnveloping Φ hΦ hΦs a) r := by
  rw [← (toExtendedCompletedEnveloping Ψ hΨ hΨs b).commutes r,
    extendedCompletedEnvelopingMapFun_toExtendedCompletedEnveloping, g.commutes r,
    (toExtendedCompletedEnveloping Φ hΦ hΦs a).commutes r]

/-- **Functoriality of the completed extended enveloping algebra.** An `R`-algebra morphism
`g : U'_Ψ →ₐ[R] U'_Φ` continuous for the left-ideal topologies `I'_n` extends uniquely to a
continuous `R`-algebra morphism `Û'_Ψ →ₐ[R] Û'_Φ`. -/
def extendedCompletedEnvelopingMap (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    ExtendedCompletedEnveloping Ψ hΨ hΨs b →ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs a where
  toFun := extendedCompletedEnvelopingMapFun g hg
  map_one' := extendedCompletedEnvelopingMapFun_one g hg
  map_mul' := extendedCompletedEnvelopingMapFun_mul g hg
  map_zero' := extendedCompletedEnvelopingMapFun_zero g hg
  map_add' := extendedCompletedEnvelopingMapFun_add g hg
  commutes' := extendedCompletedEnvelopingMapFun_algebraMap g hg

/-- `extendedCompletedEnvelopingMap` extends `g` on `ModuleTower.toLimQuotients`. -/
@[simp]
theorem extendedCompletedEnvelopingMap_toLimQuotients (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) (x : UK'Ψ) :
    extendedCompletedEnvelopingMap g hg
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs b) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) (g x) :=
  ModuleTower.limQuotientsMap_toLimQuotients _ _ _ _ x

/-- `extendedCompletedEnvelopingMap g hg` is continuous. -/
theorem continuous_extendedCompletedEnvelopingMap (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap) :
    Continuous (extendedCompletedEnvelopingMap g hg) :=
  continuous_extendedCompletedEnvelopingMapFun g hg

/-- Uniqueness of the continuous algebra extension `extendedCompletedEnvelopingMap g hg`. -/
theorem eq_extendedCompletedEnvelopingMap (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    {φ : ExtendedCompletedEnveloping Ψ hΨ hΨs b →ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs a}
    (hφ : Continuous φ)
    (h : ∀ x, φ (toExtendedCompletedEnveloping Ψ hΨ hΨs b x) =
      toExtendedCompletedEnveloping Φ hΦ hΦs a (g x)) :
    φ = extendedCompletedEnvelopingMap g hg :=
  DFunLike.coe_injective (ModuleTower.eq_limQuotientsMap
    (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs b)
    (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
    g.toRingHom.toSemilinearMap hg hφ fun x ↦ by
      have hx := h x
      rw [coe_toExtendedCompletedEnveloping, coe_toExtendedCompletedEnveloping] at hx
      exact hx)

/-- `extendedCompletedEnvelopingMap` maps stage kernels according to `hm`. -/
theorem extendedCompletedEnvelopingMap_mem_completedExtendedOrderLeftIdeal
    (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    {n m : ℕ}
    (hm : extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    {w : ExtendedCompletedEnveloping Ψ hΨ hΨs b}
    (hw : w ∈ completedExtendedOrderLeftIdeal Ψ hΨ hΨs b m) :
    extendedCompletedEnvelopingMap g hg w ∈ completedExtendedOrderLeftIdeal Φ hΦ hΦs a n := by
  rw [mem_completedExtendedOrderLeftIdeal] at hw ⊢
  change (extendedOrderQuotientTower Φ hΦ hΦs a).limπ n
    (ModuleTower.limQuotientsMap _ _ g.toRingHom.toSemilinearMap hg w) = 0
  rw [ModuleTower.limπ_limQuotientsMap _ _ _ _ hm (b := 0) (by rw [map_zero, hw]),
    map_zero, map_zero]

private theorem extendedCompletedEnvelopingMap_comp_eq_id
    (g : UK'Ψ →ₐ[R] UK'Φ)
    (hg : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap g.toRingHom.toSemilinearMap)
    (g' : UK'Φ →ₐ[R] UK'Ψ)
    (hg' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap g'.toRingHom.toSemilinearMap)
    (h : ∀ x, g (g' x) = x) :
    (extendedCompletedEnvelopingMap g hg).comp (extendedCompletedEnvelopingMap g' hg') =
      AlgHom.id R (ExtendedCompletedEnveloping Φ hΦ hΦs a) := by
  have hid : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap (AlgHom.id R UK'Φ).toRingHom.toSemilinearMap :=
    fun n ↦ ⟨n, fun x hx ↦ by
      rw [Submodule.mem_comap, RingHom.coe_toSemilinearMap, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, AlgHom.id_apply]
      exact hx⟩
  have h1 : AlgHom.id R (ExtendedCompletedEnveloping Φ hΦ hΦs a) =
      extendedCompletedEnvelopingMap (AlgHom.id R UK'Φ) hid :=
    eq_extendedCompletedEnvelopingMap (AlgHom.id R UK'Φ) hid continuous_id fun _ ↦ rfl
  rw [h1]
  exact eq_extendedCompletedEnvelopingMap (AlgHom.id R UK'Φ) hid
    ((continuous_extendedCompletedEnvelopingMap g hg).comp
      (continuous_extendedCompletedEnvelopingMap g' hg'))
    fun x ↦ by
      rw [AlgHom.comp_apply, AlgHom.id_apply, coe_toExtendedCompletedEnveloping,
        extendedCompletedEnvelopingMap_toLimQuotients,
        extendedCompletedEnvelopingMap_toLimQuotients, h]

/-- **Isomorphisms of completed extended enveloping algebras.** An `R`-algebra isomorphism
bicontinuous for the left-ideal topologies `I'_n` extends to a topological `R`-algebra isomorphism
of the completions. -/
def extendedCompletedEnvelopingEquiv (e : UK'Ψ ≃ₐ[R] UK'Φ)
    (he : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap e.toAlgHom.toRingHom.toSemilinearMap)
    (he' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap e.symm.toAlgHom.toRingHom.toSemilinearMap) :
    ExtendedCompletedEnveloping Ψ hΨ hΨs b ≃ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs a :=
  AlgEquiv.ofAlgHom
    (extendedCompletedEnvelopingMap e.toAlgHom he)
    (extendedCompletedEnvelopingMap e.symm.toAlgHom he')
    (extendedCompletedEnvelopingMap_comp_eq_id _ he _ he' e.apply_symm_apply)
    (extendedCompletedEnvelopingMap_comp_eq_id _ he' _ he e.symm_apply_apply)

/-- `extendedCompletedEnvelopingEquiv` extends `e` on `ModuleTower.toLimQuotients`. -/
@[simp]
theorem extendedCompletedEnvelopingEquiv_toLimQuotients (e : UK'Ψ ≃ₐ[R] UK'Φ)
    (he : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap e.toAlgHom.toRingHom.toSemilinearMap)
    (he' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap e.symm.toAlgHom.toRingHom.toSemilinearMap)
    (x : UK'Ψ) :
    extendedCompletedEnvelopingEquiv e he he'
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs b) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) (e x) :=
  extendedCompletedEnvelopingMap_toLimQuotients e.toAlgHom he x

/-- The inverse of `extendedCompletedEnvelopingEquiv` extends `e.symm` on
`ModuleTower.toLimQuotients`. -/
@[simp]
theorem extendedCompletedEnvelopingEquiv_symm_toLimQuotients (e : UK'Ψ ≃ₐ[R] UK'Φ)
    (he : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap e.toAlgHom.toRingHom.toSemilinearMap)
    (he' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap e.symm.toAlgHom.toRingHom.toSemilinearMap)
    (x : UK'Φ) :
    (extendedCompletedEnvelopingEquiv e he he').symm
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs a) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs b)
        (e.symm x) :=
  extendedCompletedEnvelopingMap_toLimQuotients e.symm.toAlgHom he' x

/-- `extendedCompletedEnvelopingEquiv e he he'` is continuous. -/
theorem continuous_extendedCompletedEnvelopingEquiv (e : UK'Ψ ≃ₐ[R] UK'Φ)
    (he : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap e.toAlgHom.toRingHom.toSemilinearMap)
    (he' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap e.symm.toAlgHom.toRingHom.toSemilinearMap) :
    Continuous (extendedCompletedEnvelopingEquiv e he he') :=
  continuous_extendedCompletedEnvelopingMap e.toAlgHom he

/-- The inverse of `extendedCompletedEnvelopingEquiv e he he'` is continuous. -/
theorem continuous_extendedCompletedEnvelopingEquiv_symm (e : UK'Ψ ≃ₐ[R] UK'Φ)
    (he : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Ψ hΨ hΨs b m ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs a n).comap e.toAlgHom.toRingHom.toSemilinearMap)
    (he' : ∀ n : ℕ, ∃ m : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a m ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs b n).comap e.symm.toAlgHom.toRingHom.toSemilinearMap) :
    Continuous (extendedCompletedEnvelopingEquiv e he he').symm :=
  continuous_extendedCompletedEnvelopingMap e.symm.toAlgHom he'

end Map

section Level

variable {Φ Ψ : LinearMap.BilinForm R L} (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)
  (hΨ : Ψ.lieInvariant L) (hΨs : Ψ.IsSymm) {k : R}

local notation "cΦ" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "cΨ" => twoCocycleOfBilinear R L Ψ hΨ hΨs
local notation "UK'Ψ" =>
  CentralQuotient R (toExtendedResidueExtension Ψ hΨ hΨs (centralElement cΨ)) 1
local notation "UK'Φ" =>
  CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement cΦ)) k

private theorem extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv
    (h : Ψ = k • Φ) (n : ℕ) :
    extendedOrderLeftIdeal Ψ hΨ hΨs 1 n ≤
      (extendedOrderLeftIdeal Φ hΦ hΦs k n).comap
        (extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h).toAlgHom.toRingHom.toSemilinearMap := by
  intro x hx
  rw [Submodule.mem_comap, RingHom.coe_toSemilinearMap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  exact (extendedLevelEnvelopingEquiv_mem_extendedOrderLeftIdeal_iff h).2 hx

private theorem extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv_symm
    (h : Ψ = k • Φ) (n : ℕ) :
    extendedOrderLeftIdeal Φ hΦ hΦs k n ≤
      (extendedOrderLeftIdeal Ψ hΨ hΨs 1 n).comap
        (extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm.toAlgHom.toRingHom.toSemilinearMap := by
  intro x hx
  rw [Submodule.mem_comap, RingHom.coe_toSemilinearMap, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  change (extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm x ∈ _
  rw [← extendedLevelEnvelopingEquiv_mem_extendedOrderLeftIdeal_iff h, AlgEquiv.apply_symm_apply]
  exact hx

/-- **The completed level comparison for the extended affine algebra.** If `Ψ = k • Φ`, the
extended level comparison `extendedLevelEnvelopingEquiv` extends to a topological `R`-algebra
isomorphism between the completed extended enveloping algebras at `(Ψ, 1)` and `(Φ, k)`, for every
`k` including `k = 0`. -/
def extendedLevelCompletedEnvelopingEquiv (h : Ψ = k • Φ) :
    ExtendedCompletedEnveloping Ψ hΨ hΨs 1 ≃ₐ[R] ExtendedCompletedEnveloping Φ hΦ hΦs k :=
  extendedCompletedEnvelopingEquiv (extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h)
    (fun n ↦ ⟨n, extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h n⟩)
    (fun n ↦
      ⟨n, extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv_symm hΦ hΦs hΨ hΨs h n⟩)

/-- `extendedLevelCompletedEnvelopingEquiv` extends `extendedLevelEnvelopingEquiv` on
`ModuleTower.toLimQuotients`. -/
@[simp]
theorem extendedLevelCompletedEnvelopingEquiv_toLimQuotients (h : Ψ = k • Φ) (x : UK'Ψ) :
    extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs 1) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs k)
        (extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h x) :=
  extendedCompletedEnvelopingEquiv_toLimQuotients _ _ _ x

/-- The inverse of `extendedLevelCompletedEnvelopingEquiv` extends
`(extendedLevelEnvelopingEquiv ...).symm` on `ModuleTower.toLimQuotients`. -/
@[simp]
theorem extendedLevelCompletedEnvelopingEquiv_symm_toLimQuotients (h : Ψ = k • Φ) (x : UK'Φ) :
    (extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm
        (ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Φ hΦ hΦs k) x) =
      ModuleTower.toLimQuotients _ (extendedOrderLeftIdeal_natCast_antitone Ψ hΨ hΨs 1)
        ((extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm x) :=
  extendedCompletedEnvelopingEquiv_symm_toLimQuotients _ _ _ x

/-- `extendedLevelCompletedEnvelopingEquiv` is continuous. -/
theorem continuous_extendedLevelCompletedEnvelopingEquiv (h : Ψ = k • Φ) :
    Continuous (extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h) :=
  continuous_extendedCompletedEnvelopingEquiv _ _ _

/-- The inverse of `extendedLevelCompletedEnvelopingEquiv` is continuous. -/
theorem continuous_extendedLevelCompletedEnvelopingEquiv_symm (h : Ψ = k • Φ) :
    Continuous (extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm :=
  continuous_extendedCompletedEnvelopingEquiv_symm _ _ _

/-- The completed extended level comparison extends `levelCompletedEnvelopingEquiv` along
`completedToExtended`. -/
@[simp]
theorem extendedLevelCompletedEnvelopingEquiv_completedToExtended (h : Ψ = k • Φ)
    (x : CompletedEnveloping Ψ hΨ hΨs 1) :
    extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h (completedToExtended Ψ hΨ hΨs 1 x) =
      completedToExtended Φ hΦ hΦs k (levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h x) := by
  have hc := continuous_extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h
  induction x using (denseRange_toCompletedEnveloping Ψ hΨ hΨs 1).induction_on with
  | hp =>
    exact isClosed_eq (hc.comp (continuous_completedToExtended Ψ hΨ hΨs 1))
      ((continuous_completedToExtended Φ hΦ hΦs k).comp
        (continuous_levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h))
  | ih b =>
    rw [completedToExtended_toCompletedEnveloping, coe_toCompletedEnveloping,
      coe_toExtendedCompletedEnveloping, extendedLevelCompletedEnvelopingEquiv_toLimQuotients,
      levelCompletedEnvelopingEquiv_toLimQuotients, completedToExtended_toLimQuotients,
      extendedLevelEnvelopingEquiv_toExtendedEnveloping]

/-- The completed extended level comparison fixes `d̂`. -/
@[simp]
theorem extendedLevelCompletedEnvelopingEquiv_completedDegreeElement (h : Ψ = k • Φ) :
    extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h
        (completedDegreeElement Ψ hΨ hΨs 1) =
      completedDegreeElement Φ hΦ hΦs k := by
  simp [completedDegreeElement]

variable {hΨ hΨs} in
/-- The completed extended level comparison matches the stage kernels `ker π'_n`. -/
theorem extendedLevelCompletedEnvelopingEquiv_mem_completedExtendedOrderLeftIdeal_iff
    (h : Ψ = k • Φ) {n : ℕ} {w : ExtendedCompletedEnveloping Ψ hΨ hΨs 1} :
    extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h w ∈
        completedExtendedOrderLeftIdeal Φ hΦ hΦs k n ↔
      w ∈ completedExtendedOrderLeftIdeal Ψ hΨ hΨs 1 n := by
  refine ⟨fun hw ↦ ?_,
    extendedCompletedEnvelopingMap_mem_completedExtendedOrderLeftIdeal _ _
      (extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h n)⟩
  rw [← (extendedLevelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm_apply_apply w]
  exact extendedCompletedEnvelopingMap_mem_completedExtendedOrderLeftIdeal _ _
    (extendedOrderLeftIdeal_le_comap_extendedLevelEnvelopingEquiv_symm hΦ hΦs hΨ hΨs h n) hw

end Level

end TauCeti.CurrentAlgebra
