module

public import TauCeti.Algebra.Lie.Current.ExtendedAffine.Basic
public import TauCeti.Algebra.Lie.Current.LeftIdeal
public import TauCeti.Algebra.OreExtension.LeftIdeal

/-!
# Left ideals of high-order currents in the extended affine enveloping algebra

Let `ĝ = L((t)) ⊕ R K` be the residue central extension of an invariant symmetric form `Φ`, let
`ĝ' = ĝ ⋊ R d` be the extended affine algebra adjoining the degree derivation `d = t d/dt`, and let
`U = U(ĝ) / (ι K - a)` and `U' = U(ĝ') / (ι K - a)` be their level enveloping algebras. For an
integer `N`, this file studies the left ideal

`I'_N = U' · ι(a_N)`

of `U'` generated by the currents of order at least `N`
(`TauCeti.CurrentAlgebra.extendedOrderLeftIdeal`).

Because `U' ≃ U[X; d]` is the differential operator ring over `U` associated to the degree
derivation (`TauCeti.CurrentAlgebra.extendedEnvelopingOreEquiv`) and `d = t d/dt` has order `1`,
each left ideal `I_N = U · ι(a_N)` of `U` is `d`-invariant. Applying
`TauCeti.OreExtension.span_image_C_eq_coeffLeftIdeal`, an element `x = ∑_j u_j d^j` of `U'` lies in
`I'_N` if and only if each left coefficient `u_j` lies in `I_N`
(`TauCeti.CurrentAlgebra.mem_extendedOrderLeftIdeal_iff_coeff`). From this decomposition:

* the inclusion `U → U'` pulls `I'_N` back to `I_N`
  (`TauCeti.CurrentAlgebra.toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff`);
* right multiplication by `d` preserves every `I'_N` without shifting `N`
  (`TauCeti.CurrentAlgebra.mul_ι_degreeElement_mem_extendedOrderLeftIdeal`);
* the right-shift estimate holds in `U'`
  (`TauCeti.CurrentAlgebra.exists_forall_mul_mem_extendedOrderLeftIdeal`), so every quotient
  `U' / I'_N` is smooth (`TauCeti.CurrentAlgebra.smoothModules_quotient_extendedOrderLeftIdeal`);
* reading off left `d`-coefficients identifies `U' / I'_N` with `ℕ →₀ (U / I_N)` compatibly with
  left multiplication by `U` and quotient transitions
  (`TauCeti.CurrentAlgebra.extendedOrderQuotientFinsuppEquiv`);
* the extended level comparison matches `I'_N` at all levels including zero
  (`TauCeti.CurrentAlgebra.extendedLevelEnvelopingEquiv_mem_extendedOrderLeftIdeal_iff`);
* over a field, the left ideals `I'_N` separate points (`⋂_N I'_N = 0`,
  `TauCeti.CurrentAlgebra.iInf_extendedOrderLeftIdeal`) and are proper for `N ≥ 0`
  (`TauCeti.CurrentAlgebra.extendedOrderLeftIdeal_ne_top`).

## Main definitions

* `TauCeti.CurrentAlgebra.extendedOrderLeftIdeal`: the left ideal `I'_N = U' · ι(a_N)` of
  `U(ĝ') / (ι K - a)`.
* `TauCeti.CurrentAlgebra.extendedOrderQuotientFinsuppEquiv`: the `R`-linear decomposition
  `(U' ⧸ I'_N) ≃ₗ[R] (ℕ →₀ (U ⧸ I_N))` induced by left `d`-coefficients.

## Main results

* `TauCeti.CurrentAlgebra.mem_extendedOrderLeftIdeal_iff_coeff`: `x ∈ I'_N` if and only if all left
  `d`-coefficients of `x` lie in `I_N`.
* `TauCeti.CurrentAlgebra.toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff`: `U ∩ I'_N = I_N`.
* `TauCeti.CurrentAlgebra.mul_ι_degreeElement_mem_extendedOrderLeftIdeal`: `I'_N · d ⊆ I'_N`.
* `TauCeti.CurrentAlgebra.exists_forall_mul_mem_extendedOrderLeftIdeal`: the right-shift estimate
  `∀ b N, ∃ M, I'_M b ⊆ I'_N` in `U'`.
* `TauCeti.CurrentAlgebra.extendedLevelEnvelopingEquiv_mem_extendedOrderLeftIdeal_iff`: the extended
  level comparison preserves `I'_N`.
* `TauCeti.CurrentAlgebra.iInf_extendedOrderLeftIdeal`: over a field, `⋂_N I'_N = ⊥`.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §4.3.2, for the left-ideal neighborhoods
  of zero in the extended enveloping algebra generated by positive current modes and their
  interaction with the degree operator.
-/

public section

noncomputable section

open scoped LaurentSeries
open HahnSeries LieAlgebra TauCeti.UniversalEnvelopingAlgebra
open LieAlgebra.ofTwoCocycle (centralElement envelopingι)

attribute [local instance 1100] HahnSeries.instAlgebra
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.CurrentAlgebra

universe v

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "C" => currentAlgebra R L

section LeftIdeal

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "UK" => CentralQuotient R (centralElement c) a
local notation "UK'" =>
  CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement c)) a
local notation "dU" => vectorFieldEnvelopingDerivation Φ hΦ hΦs a (single 1 1)
local notation "δU" => derivationLieAlgebra.toSigmaDerivation dU

/-- The degree derivation `t d/dt` preserves every left ideal `I_N` of `U(ĝ) / (ι K - a)`. -/
theorem mapsTo_degreeDerivation_orderLeftIdeal (N : ℤ) :
    Set.MapsTo δU (orderLeftIdeal Φ hΦ hΦs a N) (orderLeftIdeal Φ hΦ hΦs a N) := by
  intro x hx
  rw [derivationLieAlgebra.coe_toSigmaDerivation]
  exact vectorFieldEnvelopingDerivation_mem_orderLeftIdeal Φ hΦ hΦs a orderTop_single_le hx

/-- **The left ideal `I'_N` of `U(ĝ') / (ι K - a)` generated by the currents of order at least
`N`**, viewed as a submodule of the left regular `U'`-module. -/
def extendedOrderLeftIdeal (N : ℤ) : Submodule UK' UK' :=
  Submodule.span UK' (toExtendedEnveloping Φ hΦ hΦs a '' (envelopingι c a '' orderSubmodule R L N))

/-- Definitional unfolding of `extendedOrderLeftIdeal`. -/
theorem extendedOrderLeftIdeal_def (N : ℤ) :
    extendedOrderLeftIdeal Φ hΦ hΦs a N =
      Submodule.span UK'
        (toExtendedEnveloping Φ hΦ hΦs a '' (envelopingι c a '' orderSubmodule R L N)) :=
  (rfl)

variable {Φ hΦ hΦs a}

/-- A current generator of order at least `N` lies in `I'_N`. -/
theorem toExtendedEnveloping_envelopingι_mem_extendedOrderLeftIdeal {N : ℤ} {u : C}
    (hu : u ∈ orderSubmodule R L N) :
    toExtendedEnveloping Φ hΦ hΦs a (envelopingι c a u) ∈
      extendedOrderLeftIdeal Φ hΦ hΦs a N :=
  Submodule.subset_span ⟨_, ⟨u, hu, rfl⟩, rfl⟩

/-- `I'_N` is contained in a left ideal of `U'` exactly when all current generators of order at
least `N` belong to it. -/
theorem extendedOrderLeftIdeal_le_iff {N : ℤ} {I : Submodule UK' UK'} :
    extendedOrderLeftIdeal Φ hΦ hΦs a N ≤ I ↔
      ∀ u ∈ orderSubmodule R L N, toExtendedEnveloping Φ hΦ hΦs a (envelopingι c a u) ∈ I := by
  rw [extendedOrderLeftIdeal_def, Submodule.span_le, Set.image_subset_iff, Set.image_subset_iff]
  rfl

/-- **Left-coefficient characterization of `I'_N`.** Under the Ore isomorphism `U' ≃ U[X; d]`, an
element of `U'` belongs to `I'_N` if and only if each of its left `d`-coefficients lies in `I_N`. -/
theorem mem_extendedOrderLeftIdeal_iff_coeff {N : ℤ} {x : UK'} :
    x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N ↔
      ∀ n, (extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff n ∈ orderLeftIdeal Φ hΦ hΦs a N := by
  let e := extendedEnvelopingOreEquiv Φ hΦ hΦs a
  let hσ := OreExtension.mapsTo_id (k := R) (orderLeftIdeal Φ hΦ hΦs a N)
  let hδ := mapsTo_degreeDerivation_orderLeftIdeal Φ hΦ hΦs a N
  rw [← OreExtension.mem_coeffLeftIdeal_iff (hσ := hσ) (hδ := hδ)]
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · rw [extendedOrderLeftIdeal_def] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨_, ⟨u, hu, rfl⟩, rfl⟩ := hy
      rw [extendedEnvelopingOreEquiv_toExtendedEnveloping, OreExtension.C_mem_coeffLeftIdeal_iff]
      exact envelopingι_mem_orderLeftIdeal hu
    | zero => simp
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
    | smul y z _ hz =>
      rw [smul_eq_mul, map_mul]
      exact Submodule.smul_mem _ (e y) hz
  · rw [← OreExtension.span_image_C_eq_coeffLeftIdeal _ hδ, orderLeftIdeal_def,
      OreExtension.span_image_C_span] at hx
    have hsymm : ∀ q ∈ Submodule.span (OreExtension (AlgHom.id R UK) δU)
        ((OreExtension.C (σ := AlgHom.id R UK) (δ := δU)) ''
          (envelopingι c a '' orderSubmodule R L N)),
        e.symm q ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N := by
      intro q hq
      induction hq using Submodule.span_induction with
      | mem p hp =>
        obtain ⟨_, ⟨u, hu, rfl⟩, rfl⟩ := hp
        have hC : e.symm (OreExtension.C (envelopingι c a u)) =
            toExtendedEnveloping Φ hΦ hΦs a (envelopingι c a u) := by
          rw [AlgEquiv.symm_apply_eq]
          exact (extendedEnvelopingOreEquiv_toExtendedEnveloping Φ hΦ hΦs a _).symm
        rw [hC]
        exact toExtendedEnveloping_envelopingι_mem_extendedOrderLeftIdeal hu
      | zero => simp
      | add p q _ _ hp hq =>
        rw [map_add]
        exact add_mem hp hq
      | smul q p _ hp =>
        rw [smul_eq_mul, map_mul]
        exact Submodule.smul_mem _ (e.symm q) hp
    simpa [e] using hsymm (e x) hx

/-- **Contraction of `I'_N` to `U`.** An element of `U` maps into `I'_N` if and only if it belongs
to `I_N`. -/
@[simp]
theorem toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff {N : ℤ} {x : UK} :
    toExtendedEnveloping Φ hΦ hΦs a x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N ↔
      x ∈ orderLeftIdeal Φ hΦ hΦs a N := by
  let hσ := OreExtension.mapsTo_id (k := R) (orderLeftIdeal Φ hΦ hΦs a N)
  let hδ := mapsTo_degreeDerivation_orderLeftIdeal Φ hΦ hΦs a N
  rw [mem_extendedOrderLeftIdeal_iff_coeff,
    ← OreExtension.mem_coeffLeftIdeal_iff (hσ := hσ) (hδ := hδ),
    extendedEnvelopingOreEquiv_toExtendedEnveloping, OreExtension.C_mem_coeffLeftIdeal_iff]

/-- `toExtendedEnveloping` sends `I_N` into `I'_N`. -/
theorem toExtendedEnveloping_mem_extendedOrderLeftIdeal {N : ℤ} {x : UK}
    (hx : x ∈ orderLeftIdeal Φ hΦ hΦs a N) :
    toExtendedEnveloping Φ hΦ hΦs a x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N :=
  toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff.2 hx

/-- **Right multiplication by `d` preserves `I'_N` without shifting `N`.** -/
theorem mul_ι_degreeElement_mem_extendedOrderLeftIdeal {N : ℤ} {x : UK'}
    (hx : x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N) :
    x * CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs) ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N := by
  let hσ := OreExtension.mapsTo_id (k := R) (orderLeftIdeal Φ hΦ hΦs a N)
  let hδ := mapsTo_degreeDerivation_orderLeftIdeal Φ hΦ hΦs a N
  rw [mem_extendedOrderLeftIdeal_iff_coeff,
    ← OreExtension.mem_coeffLeftIdeal_iff (hσ := hσ) (hδ := hδ)] at hx ⊢
  rw [map_mul, extendedEnvelopingOreEquiv_ι_degreeElement]
  exact OreExtension.mul_X_mem_coeffLeftIdeal hx

/-- Right multiplication by any power `dᵐ` preserves `I'_N`. -/
theorem mul_ι_degreeElement_pow_mem_extendedOrderLeftIdeal {N : ℤ} {x : UK'}
    (hx : x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N) (m : ℕ) :
    x * CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs) ^ m ∈
      extendedOrderLeftIdeal Φ hΦ hΦs a N := by
  induction m with
  | zero => simpa using hx
  | succ m ih =>
    rw [pow_succ, ← mul_assoc]
    exact mul_ι_degreeElement_mem_extendedOrderLeftIdeal ih

variable (Φ hΦ hΦs a)

/-- The left ideals `I'_N` decrease as `N` grows. -/
theorem extendedOrderLeftIdeal_antitone : Antitone (extendedOrderLeftIdeal Φ hΦ hΦs a) :=
  fun _ _ h _ hx ↦ mem_extendedOrderLeftIdeal_iff_coeff.2 fun n ↦
    orderLeftIdeal_antitone Φ hΦ hΦs a h (mem_extendedOrderLeftIdeal_iff_coeff.1 hx n)

/-- The left ideals `I'_n` of natural orders decrease as `n` grows. -/
theorem extendedOrderLeftIdeal_natCast_antitone :
    Antitone fun n : ℕ ↦ extendedOrderLeftIdeal Φ hΦ hΦs a n :=
  (extendedOrderLeftIdeal_antitone Φ hΦ hΦs a).comp_monotone Nat.mono_cast

/-- The left ideals `I'_n` of natural orders have the same intersection as all the `I'_N`. -/
theorem iInf_extendedOrderLeftIdeal_natCast :
    ⨅ n : ℕ, extendedOrderLeftIdeal Φ hΦ hΦs a n =
      ⨅ N : ℤ, extendedOrderLeftIdeal Φ hΦ hΦs a N := by
  refine le_antisymm (le_iInf fun N ↦ ?_) (le_iInf fun n ↦ iInf_le _ _)
  exact (iInf_le _ N.toNat).trans
    (extendedOrderLeftIdeal_antitone Φ hΦ hΦs a (Int.self_le_toNat N))

/-- **The right-shift estimate in `U(ĝ') / (ι K - a)`.** For every `b ∈ U'` and every `N` there is
`M` with `I'_M b ⊆ I'_N`. -/
theorem exists_forall_mul_mem_extendedOrderLeftIdeal (b : UK') (N : ℤ) :
    ∃ M : ℤ, ∀ x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a M,
      x * b ∈ extendedOrderLeftIdeal Φ hΦ hΦs a N := by
  let e := extendedEnvelopingOreEquiv Φ hΦ hΦs a
  obtain ⟨M, hM⟩ := OreExtension.exists_forall_mul_mem_coeffLeftIdeal
    (orderLeftIdeal_antitone Φ hΦ hΦs a).directed_ge
    (mapsTo_degreeDerivation_orderLeftIdeal Φ hΦ hΦs a)
    (exists_forall_mul_mem_orderLeftIdeal Φ hΦ hΦs a) (e b) N
  refine ⟨M, fun x hx ↦ ?_⟩
  rw [mem_extendedOrderLeftIdeal_iff_coeff] at hx ⊢
  intro n
  have hmul := OreExtension.mem_coeffLeftIdeal_iff.1
    (hM (e x) (OreExtension.mem_coeffLeftIdeal_iff.2 hx)) n
  rwa [← map_mul] at hmul

/-- The right-shift estimate for natural orders in `U(ĝ') / (ι K - a)`. -/
theorem exists_forall_mul_mem_extendedOrderLeftIdeal_natCast (b : UK') (n : ℕ) :
    ∃ m : ℕ, ∀ x ∈ extendedOrderLeftIdeal Φ hΦ hΦs a m,
      x * b ∈ extendedOrderLeftIdeal Φ hΦ hΦs a n := by
  obtain ⟨M, hM⟩ := exists_forall_mul_mem_extendedOrderLeftIdeal Φ hΦ hΦs a b n
  exact ⟨M.toNat, fun x hx ↦
    hM x (extendedOrderLeftIdeal_antitone Φ hΦ hΦs a (Int.self_le_toNat M) hx)⟩

/-- Smoothness for the left ideals `I'_n` of natural orders coincides with smoothness for all
`I'_N`. -/
theorem smoothModules_extendedOrderLeftIdeal_natCast :
    smoothModules.{v} (fun n : ℕ ↦ extendedOrderLeftIdeal Φ hΦ hΦs a n) =
      smoothModules (extendedOrderLeftIdeal Φ hΦ hΦs a) :=
  le_antisymm (smoothModules_le_of_forall_exists_le fun n ↦ ⟨n, le_rfl⟩)
    (smoothModules_le_of_forall_exists_le fun N ↦
      ⟨N.toNat, extendedOrderLeftIdeal_antitone Φ hΦ hΦs a (Int.self_le_toNat N)⟩)

/-- **Each quotient `U' / I'_N` is smooth** for the family of left ideals `I'_M`. -/
theorem smoothModules_quotient_extendedOrderLeftIdeal (N : ℤ) :
    smoothModules (extendedOrderLeftIdeal Φ hΦ hΦs a)
      (ModuleCat.of UK' (UK' ⧸ extendedOrderLeftIdeal Φ hΦ hΦs a N)) := by
  refine smoothModules_iff.2 fun m ↦ ?_
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  obtain ⟨M, hM⟩ := exists_forall_mul_mem_extendedOrderLeftIdeal Φ hΦ hΦs a b N
  refine ⟨M, fun x hx ↦ ?_⟩
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, Submodule.Quotient.mk_eq_zero]
  exact hM x hx

end LeftIdeal

/-! ### Left-coefficient decomposition of the stage quotients -/

section Quotient

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "UK" => CentralQuotient R (centralElement c) a
local notation "UK'" =>
  CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement c)) a

/-- The `R`-linear map `U' →ₗ[R] ℕ →₀ (U ⧸ I_N)` reading off left `d`-coefficients modulo `I_N`. -/
def toExtendedOrderQuotientFinsupp (N : ℤ) :
    UK' →ₗ[R] (ℕ →₀ (UK ⧸ orderLeftIdeal Φ hΦ hΦs a N)) :=
  ((OreExtension.toQuotientFinsupp (orderLeftIdeal Φ hΦ hΦs a N)).restrictScalars R).comp
    (extendedEnvelopingOreEquiv Φ hΦ hΦs a).toLinearMap

/-- `toExtendedOrderQuotientFinsupp` reads off the `j`-th Ore coefficient modulo `I_N`. -/
@[simp]
theorem toExtendedOrderQuotientFinsupp_apply (N : ℤ) (x : UK') (j : ℕ) :
    toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N x j =
      (orderLeftIdeal Φ hΦ hΦs a N).mkQ ((extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff j) := by
  simp [toExtendedOrderQuotientFinsupp]

/-- `toExtendedOrderQuotientFinsupp` is surjective. -/
theorem toExtendedOrderQuotientFinsupp_surjective (N : ℤ) :
    Function.Surjective (toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N) :=
  (OreExtension.toQuotientFinsupp_surjective _).comp
    (extendedEnvelopingOreEquiv Φ hΦ hΦs a).surjective

/-- The kernel of `toExtendedOrderQuotientFinsupp` is `I'_N` restricted to `R`-scalars. -/
@[simp]
theorem ker_toExtendedOrderQuotientFinsupp (N : ℤ) :
    LinearMap.ker (toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N) =
      (extendedOrderLeftIdeal Φ hΦ hΦs a N).restrictScalars R := by
  ext x
  simp [LinearMap.mem_ker, Finsupp.ext_iff, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    mem_extendedOrderLeftIdeal_iff_coeff]

/-- **Stage quotient decomposition.** Reading off left `d`-coefficients modulo `I_N` identifies
`U' ⧸ I'_N` `R`-linearly with `ℕ →₀ (U ⧸ I_N)`. -/
def extendedOrderQuotientFinsuppEquiv (N : ℤ) :
    (UK' ⧸ extendedOrderLeftIdeal Φ hΦ hΦs a N) ≃ₗ[R]
      (ℕ →₀ (UK ⧸ orderLeftIdeal Φ hΦ hΦs a N)) :=
  ((Submodule.Quotient.restrictScalarsEquiv R (extendedOrderLeftIdeal Φ hΦ hΦs a N)).symm.trans
    (Submodule.quotEquivOfEq _ _ (ker_toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N).symm)).trans
      ((toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N).quotKerEquivOfSurjective
        (toExtendedOrderQuotientFinsupp_surjective Φ hΦ hΦs a N))

/-- `extendedOrderQuotientFinsuppEquiv` acts on quotient classes by
`toExtendedOrderQuotientFinsupp`. -/
@[simp]
theorem extendedOrderQuotientFinsuppEquiv_mk (N : ℤ) (x : UK') :
    extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a N (Submodule.Quotient.mk x) =
      toExtendedOrderQuotientFinsupp Φ hΦ hΦs a N x := by
  simp [extendedOrderQuotientFinsuppEquiv]

/-- The inverse of `extendedOrderQuotientFinsuppEquiv` sends `Finsupp.single j [u]` to `[u dʲ]`. -/
@[simp]
theorem extendedOrderQuotientFinsuppEquiv_symm_single (N : ℤ) (j : ℕ) (u : UK) :
    (extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a N).symm
        (Finsupp.single j (Submodule.Quotient.mk u)) =
      Submodule.Quotient.mk
        (toExtendedEnveloping Φ hΦ hΦs a u *
          CentralQuotient.ι _ a (degreeElement Φ hΦ hΦs) ^ j) := by
  rw [LinearEquiv.symm_apply_eq, extendedOrderQuotientFinsuppEquiv_mk]
  ext n
  rw [toExtendedOrderQuotientFinsupp_apply, ← extendedEnvelopingOreEquiv_symm_monomial,
    AlgEquiv.apply_symm_apply, ← OreExtension.toQuotientFinsupp_apply,
    OreExtension.toQuotientFinsupp_monomial, Submodule.mkQ_apply]

/-- The decomposition `(U' ⧸ I'_N) ≃ₗ[R] ℕ →₀ (U ⧸ I_N)` is compatible with left multiplication
by elements of `U`. -/
@[simp]
theorem extendedOrderQuotientFinsuppEquiv_toExtendedEnveloping_smul (N : ℤ) (u : UK)
    (q : UK' ⧸ extendedOrderLeftIdeal Φ hΦ hΦs a N) (j : ℕ) :
    extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a N (toExtendedEnveloping Φ hΦ hΦs a u • q) j =
      u • extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a N q j := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, extendedOrderQuotientFinsuppEquiv_mk,
    extendedOrderQuotientFinsuppEquiv_mk, toExtendedOrderQuotientFinsupp_apply,
    toExtendedOrderQuotientFinsupp_apply, map_mul, extendedEnvelopingOreEquiv_toExtendedEnveloping,
    OreExtension.coeff_C_mul, ← smul_eq_mul, map_smul]

/-- The stage quotient decompositions commute with the transition maps `Submodule.factor`. -/
@[simp]
theorem extendedOrderQuotientFinsuppEquiv_factor_apply {M N : ℤ} (h : N ≤ M)
    (q : UK' ⧸ extendedOrderLeftIdeal Φ hΦ hΦs a M) (j : ℕ) :
    extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a N
        (Submodule.factor (extendedOrderLeftIdeal_antitone Φ hΦ hΦs a h) q) j =
      Submodule.factor (orderLeftIdeal_antitone Φ hΦ hΦs a h)
        (extendedOrderQuotientFinsuppEquiv Φ hΦ hΦs a M q j) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  simp

end Quotient

/-! ### Separation over a field -/

section Separation

variable {K : Type*} [Field K] [LieAlgebra K L]
  (Φ : LinearMap.BilinForm K L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : K)

/-- **PBW separation of the left ideals `I'_N`.** Over a field, the left ideals `I'_N` of
`U(ĝ') / (ι K - a)` intersect in zero, for every central value `a`, including `a = 0`. -/
@[simp]
theorem iInf_extendedOrderLeftIdeal : ⨅ N : ℤ, extendedOrderLeftIdeal Φ hΦ hΦs a N = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  refine (injective_iff_map_eq_zero (extendedEnvelopingOreEquiv Φ hΦ hΦs a)).1
    (extendedEnvelopingOreEquiv Φ hΦ hΦs a).injective x ?_
  ext n
  have hn : (extendedEnvelopingOreEquiv Φ hΦ hΦs a x).coeff n ∈
      ⨅ N : ℤ, orderLeftIdeal Φ hΦ hΦs a N :=
    (Submodule.mem_iInf _).2 fun N ↦
      mem_extendedOrderLeftIdeal_iff_coeff.1 ((Submodule.mem_iInf _).1 hx N) n
  rw [iInf_orderLeftIdeal, Submodule.mem_bot] at hn
  simpa using hn

/-- At nonnegative order over a field, the left ideals `I'_N` are proper at every central value. -/
theorem extendedOrderLeftIdeal_ne_top {N : ℤ} (hN : 0 ≤ N) :
    extendedOrderLeftIdeal Φ hΦ hΦs a N ≠ ⊤ := by
  intro h
  apply orderLeftIdeal_ne_top Φ hΦ hΦs a hN
  rw [eq_top_iff]
  intro x _
  rw [← toExtendedEnveloping_mem_extendedOrderLeftIdeal_iff (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs), h]
  exact Submodule.mem_top

end Separation

/-! ### Functoriality and level comparison -/

section Map

variable {Φ Ψ : LinearMap.BilinForm R L} {hΦ : Φ.lieInvariant L} {hΦs : Φ.IsSymm}
  {hΨ : Ψ.lieInvariant L} {hΨs : Ψ.IsSymm} {a b : R}

local notation "cΦ" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "cΨ" => twoCocycleOfBilinear R L Ψ hΨ hΨs

/-- An algebra morphism between extended level enveloping algebras which sends the current
generators of order at least `N` into `I'_N'` sends the whole left ideal `I'_N` into `I'_N'`. -/
theorem extendedOrderLeftIdeal_le_comap
    {g : CentralQuotient R (toExtendedResidueExtension Ψ hΨ hΨs (centralElement cΨ)) b →ₐ[R]
      CentralQuotient R (toExtendedResidueExtension Φ hΦ hΦs (centralElement cΦ)) a} {N N' : ℤ}
    (hg : ∀ u ∈ orderSubmodule R L N,
      g (toExtendedEnveloping Ψ hΨ hΨs b (envelopingι cΨ b u)) ∈
        extendedOrderLeftIdeal Φ hΦ hΦs a N') :
    extendedOrderLeftIdeal Ψ hΨ hΨs b N ≤
      Ideal.comap g (extendedOrderLeftIdeal Φ hΦ hΦs a N') :=
  extendedOrderLeftIdeal_le_iff.2 hg

/-- **The extended level comparison matches the left ideals `I'_N`.** If `Ψ = k • Φ`, the
isomorphism `extendedLevelEnvelopingEquiv` carries each `I'_N` onto `I'_N`, for every `k`,
including `k = 0`. -/
@[simp]
theorem extendedLevelEnvelopingEquiv_mem_extendedOrderLeftIdeal_iff {k : R} (h : Ψ = k • Φ)
    {N : ℤ} {x : CentralQuotient R (toExtendedResidueExtension Ψ hΨ hΨs (centralElement cΨ)) 1} :
    extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h x ∈ extendedOrderLeftIdeal Φ hΦ hΦs k N ↔
      x ∈ extendedOrderLeftIdeal Ψ hΨ hΨs 1 N := by
  let e := extendedLevelEnvelopingEquiv hΦ hΦs hΨ hΨs h
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · simpa [e] using extendedOrderLeftIdeal_le_comap (g := e.symm.toAlgHom)
      (fun u hu ↦ by simpa [e] using envelopingι_mem_orderLeftIdeal hu) hx
  · exact extendedOrderLeftIdeal_le_comap (g := e.toAlgHom)
      (fun u hu ↦ by simpa [e] using envelopingι_mem_orderLeftIdeal hu) hx

end Map

end TauCeti.CurrentAlgebra
