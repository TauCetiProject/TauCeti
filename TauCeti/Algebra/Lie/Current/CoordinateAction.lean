module

public import TauCeti.Algebra.Lie.Current.LeftIdeal
public import TauCeti.Algebra.Lie.Current.Substitution
public import TauCeti.Algebra.Lie.Extension

/-!
# Coordinate changes on residue central extensions and their enveloping algebras

Substitution by a formal coordinate preserves the residue cocycle, so it lifts to a Lie
automorphism of the native `LieAlgebra.ofTwoCocycle` extension, acting by substitution on
currents and fixing the central coordinate. This includes the zero form and needs no
finite-dimensionality or characteristic assumption.

Formal coordinates compose contravariantly under substitution. The actual algebra
automorphisms of `K⟦X⟧`, with their usual multiplication by composition, therefore act
covariantly on the extension. The constructions here are algebraic.

The lift uses `LieAlgebra.ofTwoCocycle.mapEquiv` with the current substitution equivalence
and the identity on the trivial coefficient module.

Since the lift of `σ` fixes the central element `K`, it preserves the relation `ι K - a`, so it
induces an algebra automorphism of the enveloping algebra `U = U(ĝ) / (ι K - a)` of the extension
`ĝ` at every central value `a`, including `a = 0`
(`TauCeti.CurrentAlgebra.coordinateEnvelopingAut`). This applies the functoriality
`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient.mapEquiv` to the Lie automorphism of `ĝ`. On
the current generators it is substitution, `σ̂ (ι u) = ι (u(σ X))`, and the lifts form a group
homomorphism, so the lift of `σ * τ` is the composite of the lifts of `σ` and `τ`. Substitution
preserves the order of currents, so each lift preserves every left ideal `I_N = U · ι(a_N)`
generated by the currents of order at least `N`
(`TauCeti.CurrentAlgebra.coordinateEnvelopingAut_mem_orderLeftIdeal_iff`); these order estimates
are what is needed to pass the lifts to the quotients `U / I_N` and to the completed enveloping
algebra `lim_N U / I_N`. The lifts commute with the level comparison
`TauCeti.CurrentAlgebra.levelEnvelopingEquiv` between `U(ĝ_Ψ) / (ι K - 1)` and
`U(ĝ_Φ) / (ι K - k)` for `Ψ = k • Φ`
(`TauCeti.CurrentAlgebra.levelEnvelopingEquiv_coordinateEnvelopingAut`).

## Main definitions

* `TauCeti.CurrentAlgebra.coordinateExtensionLieEquiv`: the lift of a power-series algebra
  automorphism to the residue central extension.
* `TauCeti.CurrentAlgebra.coordinateEnvelopingAut`: the group homomorphism from the algebra
  automorphisms of `K⟦X⟧` to the algebra automorphisms of `U(ĝ) / (ι K - a)`.

## Main results

* `TauCeti.CurrentAlgebra.coordinateExtensionLieEquiv_mul_apply`: the lifts to the extension
  compose covariantly.
* `TauCeti.CurrentAlgebra.coordinateEnvelopingAut_envelopingι`: the lift to the enveloping algebra
  substitutes in the current generators.
* `TauCeti.CurrentAlgebra.coordinateEnvelopingAut_mem_orderLeftIdeal_iff`: the lift preserves each
  left ideal `I_N`.
* `TauCeti.CurrentAlgebra.levelEnvelopingEquiv_coordinateEnvelopingAut`: the lift commutes with
  the level comparison.

## References

* V. G. Kac, *Infinite-Dimensional Lie Algebras*, 3rd ed., Chapter 7, for the
  coordinate-invariant residue extension of current algebras.
* E. Frenkel, *Langlands Correspondence for Loop Groups*, for the action of the group `Aut O` of
  coordinate changes on the affine Kac--Moody algebra and its enveloping algebras at fixed level.
-/

public section

noncomputable section

open scoped LaurentSeries
open PowerSeries LieAlgebra TauCeti.UniversalEnvelopingAlgebra

namespace TauCeti.CurrentAlgebra

variable {K L : Type*} [Field K] [LieRing L] [LieAlgebra K L]
variable (Φ : LinearMap.BilinForm K L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)

local notation "cΦ" => twoCocycleOfBilinear K L Φ hΦ hΦs
local notation "EΦ" => _root_.LieAlgebra.ofTwoCocycle cΦ

/-- The lift of a power-series algebra automorphism to the residue central extension.
It fixes the central coordinate and substitutes the image of `X` in the current. -/
def coordinateExtensionLieEquiv (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) : EΦ ≃ₗ⁅K⁆ EΦ :=
  _root_.LieAlgebra.ofTwoCocycle.mapEquiv cΦ (substLieEquiv (FormalCoordinate.ofAlgEquiv σ))
    (LinearEquiv.refl K _) cΦ fun u v ↦ by simp

/-- In product coordinates the lift substitutes the current and fixes the scalar. -/
@[simp]
theorem coordinateExtensionLieEquiv_ofProd (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧)
    (u : currentAlgebra K L) (a : TrivialLieModule K (currentAlgebra K L) K) :
    coordinateExtensionLieEquiv Φ hΦ hΦs σ (_root_.LieAlgebra.ofProd cΦ (u, a)) =
      _root_.LieAlgebra.ofProd cΦ (substLieEquiv (FormalCoordinate.ofAlgEquiv σ) u, a) := by
  simp [coordinateExtensionLieEquiv]

/-- Product coordinates of a transformed extension element. -/
@[simp]
theorem ofProd_symm_coordinateExtensionLieEquiv (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (z : EΦ) :
    (_root_.LieAlgebra.ofProd cΦ).symm (coordinateExtensionLieEquiv Φ hΦ hΦs σ z) =
      (substLieEquiv (FormalCoordinate.ofAlgEquiv σ) ((_root_.LieAlgebra.ofProd cΦ).symm z).1,
        ((_root_.LieAlgebra.ofProd cΦ).symm z).2) := by
  simp [coordinateExtensionLieEquiv]

/-- The lifted coordinate change lies over substitution on currents. -/
theorem proj_coordinateExtensionLieEquiv (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (z : EΦ) :
    _root_.LieAlgebra.ofTwoCocycle.proj cΦ (coordinateExtensionLieEquiv Φ hΦ hΦs σ z) =
      substLieEquiv (FormalCoordinate.ofAlgEquiv σ)
        (_root_.LieAlgebra.ofTwoCocycle.proj cΦ z) := by
  simp

/-- Every element of the distinguished central summand, in particular its generator, is fixed. -/
theorem coordinateExtensionLieEquiv_central (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧)
    (a : TrivialLieModule K (currentAlgebra K L) K) :
    coordinateExtensionLieEquiv Φ hΦ hΦs σ (_root_.LieAlgebra.ofProd cΦ (0, a)) =
      _root_.LieAlgebra.ofProd cΦ (0, a) := by
  simp

/-- The lift of a power-series algebra automorphism to the residue central extension fixes the
central element `K`. -/
@[simp]
theorem coordinateExtensionLieEquiv_centralElement (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) :
    coordinateExtensionLieEquiv Φ hΦ hΦs σ (centralElement Φ hΦ hΦs) = centralElement Φ hΦ hΦs :=
  (ofProd _).symm.injective (by simp)

/-- The identity power-series automorphism acts identically on the residue extension. -/
@[simp]
theorem coordinateExtensionLieEquiv_one (z : EΦ) :
    coordinateExtensionLieEquiv Φ hΦ hΦs (1 : K⟦X⟧ ≃ₐ[K] K⟦X⟧) z = z := by
  have h := (FormalCoordinate.substAlgEquivMulEquiv K).symm.map_one
  apply (_root_.LieAlgebra.ofProd cΦ).symm.injective
  simp only [FormalCoordinate.substAlgEquivMulEquiv_symm_apply, MulOpposite.unop_one] at h
  simp [h]

/-- With the usual product `σ * τ = σ ∘ τ`, lifted coordinate changes compose in that order.
-/
theorem coordinateExtensionLieEquiv_mul_apply (σ τ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (z : EΦ) :
    coordinateExtensionLieEquiv Φ hΦ hΦs (σ * τ) z =
      coordinateExtensionLieEquiv Φ hΦ hΦs σ
        (coordinateExtensionLieEquiv Φ hΦ hΦs τ z) := by
  have h := (FormalCoordinate.substAlgEquivMulEquiv K).symm.map_mul
    (MulOpposite.op τ) (MulOpposite.op σ)
  simp only [FormalCoordinate.substAlgEquivMulEquiv_symm_apply, MulOpposite.unop_mul,
    MulOpposite.unop_op] at h
  apply (_root_.LieAlgebra.ofProd cΦ).symm.injective
  simp [h, substLieEquiv_mul_apply]

/-- The inverse power-series automorphism induces the inverse automorphism of the extension. -/
theorem coordinateExtensionLieEquiv_symm (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) :
    (coordinateExtensionLieEquiv Φ hΦ hΦs σ).symm =
      coordinateExtensionLieEquiv Φ hΦ hΦs σ⁻¹ := by
  apply LieEquiv.ext
  intro z
  apply (coordinateExtensionLieEquiv Φ hΦ hΦs σ).injective
  simp only [LieEquiv.coe_toLieHom]
  rw [LieEquiv.apply_symm_apply, ← coordinateExtensionLieEquiv_mul_apply, mul_inv_cancel,
    coordinateExtensionLieEquiv_one]

section Aut

variable (a : K)

local notation "UK" => CentralQuotient K (centralElement Φ hΦ hΦs) a

/-- **Coordinate changes on the level enveloping algebra.** An algebra automorphism `σ` of `K⟦X⟧`
induces the algebra automorphism of `U(ĝ) / (ι K - a)` which substitutes `σ X` in the current
generators; these lifts form a group homomorphism for the product `σ * τ = σ ∘ τ`. -/
def coordinateEnvelopingAut : (K⟦X⟧ ≃ₐ[K] K⟦X⟧) →* (UK ≃ₐ[K] UK) where
  toFun σ := CentralQuotient.mapEquiv (coordinateExtensionLieEquiv Φ hΦ hΦs σ)
    (coordinateExtensionLieEquiv_centralElement Φ hΦ hΦs σ)
  map_one' := AlgEquiv.coe_toAlgHom_injective <| CentralQuotient.algHom_ext fun x ↦ by simp
  map_mul' σ τ := AlgEquiv.coe_toAlgHom_injective <| CentralQuotient.algHom_ext fun x ↦ by
    simp [coordinateExtensionLieEquiv_mul_apply]

/-- The lift acts on the canonical image of the extension through the Lie automorphism
`coordinateExtensionLieEquiv`. -/
@[simp]
theorem coordinateEnvelopingAut_ι (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (x : EΦ) :
    coordinateEnvelopingAut Φ hΦ hΦs a σ (CentralQuotient.ι (centralElement Φ hΦ hΦs) a x) =
      CentralQuotient.ι (centralElement Φ hΦ hΦs) a (coordinateExtensionLieEquiv Φ hΦ hΦs σ x) :=
  CentralQuotient.mapEquiv_ι _ _ x

/-- **The lift substitutes in the current generators:** `σ̂ (ι u) = ι (u(σ X))`. -/
@[simp]
theorem coordinateEnvelopingAut_envelopingι (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (u : currentAlgebra K L) :
    coordinateEnvelopingAut Φ hΦ hΦs a σ (envelopingι Φ hΦ hΦs a u) =
      envelopingι Φ hΦ hΦs a (substLieEquiv (FormalCoordinate.ofAlgEquiv σ) u) := by
  rw [envelopingι_apply, coordinateEnvelopingAut_ι, coordinateExtensionLieEquiv_ofProd,
    envelopingι_apply]

variable {Φ hΦ hΦs a}

/-- The lift carries `I_N` into itself. -/
private theorem coordinateEnvelopingAut_mem_orderLeftIdeal (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) {N : ℤ} {x : UK}
    (hx : x ∈ orderLeftIdeal Φ hΦ hΦs a N) :
    coordinateEnvelopingAut Φ hΦ hΦs a σ x ∈ orderLeftIdeal Φ hΦ hΦs a N :=
  orderLeftIdeal_le_comap (g := (coordinateEnvelopingAut Φ hΦ hΦs a σ).toAlgHom)
    (fun u hu ↦ by
      simpa using envelopingι_mem_orderLeftIdeal (substLieEquiv_mem_orderSubmodule _ hu)) hx

/-- **Coordinate changes preserve the left ideals.** The lift of `σ` carries each left ideal
`I_N = U · ι(a_N)` onto itself. -/
@[simp]
theorem coordinateEnvelopingAut_mem_orderLeftIdeal_iff (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) {N : ℤ} {x : UK} :
    coordinateEnvelopingAut Φ hΦ hΦs a σ x ∈ orderLeftIdeal Φ hΦ hΦs a N ↔
      x ∈ orderLeftIdeal Φ hΦ hΦs a N := by
  refine ⟨fun hx ↦ ?_, coordinateEnvelopingAut_mem_orderLeftIdeal σ⟩
  simpa [← AlgEquiv.mul_apply, ← map_mul] using coordinateEnvelopingAut_mem_orderLeftIdeal σ⁻¹ hx

end Aut

section Level

variable {Φ} {Ψ : LinearMap.BilinForm K L} (hΨ : Ψ.lieInvariant L) (hΨs : Ψ.IsSymm) {k : K}

/-- **Coordinate changes commute with the level comparison.** If `Ψ = k • Φ`, the isomorphism
`levelEnvelopingEquiv` from `U(ĝ_Ψ) / (ι K - 1)` to `U(ĝ_Φ) / (ι K - k)` intertwines the lifts of
every power-series algebra automorphism, for every `k`, including `k = 0`. -/
theorem levelEnvelopingEquiv_coordinateEnvelopingAut (h : Ψ = k • Φ) (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧)
    (x : CentralQuotient K (centralElement Ψ hΨ hΨs) 1) :
    levelEnvelopingEquiv hΦ hΦs hΨ hΨs h (coordinateEnvelopingAut Ψ hΨ hΨs 1 σ x) =
      coordinateEnvelopingAut Φ hΦ hΦs k σ (levelEnvelopingEquiv hΦ hΦs hΨ hΨs h x) :=
  AlgHom.congr_fun (algHom_ext_envelopingι Ψ hΨ hΨs 1
    (g₁ := (levelEnvelopingEquiv hΦ hΦs hΨ hΨs h).toAlgHom.comp
      (coordinateEnvelopingAut Ψ hΨ hΨs 1 σ).toAlgHom)
    (g₂ := (coordinateEnvelopingAut Φ hΦ hΦs k σ).toAlgHom.comp
      (levelEnvelopingEquiv hΦ hΦs hΨ hΨs h).toAlgHom) fun u ↦ by simp) x

end Level

end TauCeti.CurrentAlgebra
