module

public import TauCeti.Algebra.Lie.Current.Completion
public import TauCeti.Algebra.Category.ModuleCat.Tower.Summation

/-!
# Normally ordered modes in the completed enveloping algebra

Let `U = U(ĝ) / (ι K - a)` be the enveloping algebra at the central value `a` of the residue
central extension of an invariant symmetric form `Φ` on a Lie algebra `L`, and let
`Û = lim_N U / I_N` be its completion along the left ideals `I_N` generated by the currents of
order at least `N` (`TauCeti.CurrentAlgebra.CompletedEnveloping`). For `x : L` write `xₘ` for the
current generator of the mode `x ⊗ tᵐ`. The normally ordered product of the current fields
`J^x(z) = ∑ₘ xₘ z^{-m-1}` and `J^y(z)` has the modes

`:x y:_n = ∑_{m < 0} xₘ y_{n-m} + ∑_{m ≥ 0} y_{n-m} xₘ`,

which put the negative modes of `x` to the left and its nonnegative modes to the right
(`TauCeti.CurrentAlgebra.normalOrderedMode`). These infinite sums do not converge in `U`, but they
converge in `Û`: modulo `I_N`, every summand with `m ≥ N` lies in `I_N` because its right factor
`xₘ` does, and every summand with `m < 0` and `n - m ≥ N` lies in `I_N` because its right factor
`y_{n-m}` does. So the coordinate of `:x y:_n` in `U / I_N` is the class of the finite sum over
`min (n + 1 - N) 0 ≤ m < N` (`TauCeti.CurrentAlgebra.limπ_normalOrderedMode`), and on a vector of a
smooth module killed by `I_N` the mode `:x y:_n` acts by this finite sum
(`TauCeti.CurrentAlgebra.limSmul_normalOrderedMode`). No finiteness of `L` and no condition on `Φ`
or on `a` is needed; in particular this includes the critical level.

The same argument applies when the summands are ordered at any other cut `p`, putting `xₘ` on the
left exactly for `m < p` (`TauCeti.CurrentAlgebra.normalOrderedSummand`). Moving the cut from `0`
to `p` changes the sum by the finitely many commutators `[xₘ, y_{n-m}]` with `m` between `0` and
`p` (`TauCeti.CurrentAlgebra.tsum_normalOrderedSummand`). This reindexing identity is the form in
which normally ordered products are compared after shifting mode indices, as in the computation of
commutators of currents with quadratic Sugawara modes.

The modes `:x y:_n` are bilinear in `x` and `y`, and the completed level comparison
`TauCeti.CurrentAlgebra.levelCompletedEnvelopingEquiv`, which is the identity on currents, carries
the modes of `Û(ĝ_Ψ)` at central value `1` to those of `Û(ĝ_Φ)` at central value `k` when
`Ψ = k • Φ` (`TauCeti.CurrentAlgebra.levelCompletedEnvelopingEquiv_normalOrderedMode`).

## Main definitions

* `TauCeti.CurrentAlgebra.normalOrderedSummand`: the summands `xₘ y_{n-m}` or `y_{n-m} xₘ`,
  ordered at a cut `p`.
* `TauCeti.CurrentAlgebra.normalOrderedMode`: the normally ordered modes `:x y:_n` in `Û`, as a
  bilinear map.

## Main results

* `TauCeti.CurrentAlgebra.hasSum_normalOrderedMode`: `:x y:_n` is the sum of its normally ordered
  summands.
* `TauCeti.CurrentAlgebra.summable_normalOrderedSummand`: the summands ordered at any cut form a
  summable family.
* `TauCeti.CurrentAlgebra.limπ_normalOrderedMode`: its coordinates are finite sums.
* `TauCeti.CurrentAlgebra.limSmul_normalOrderedMode`: its action on a smooth vector is a finite
  sum.
* `TauCeti.CurrentAlgebra.tsum_normalOrderedSummand`: moving the cut of the normal ordering.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the completed
  enveloping algebra, and §2.2 for the normally ordered quadratic Segal--Sugawara modes in it.
* E. Frenkel, D. Ben-Zvi, *Vertex Algebras and Algebraic Curves*, 2nd ed., §2.2 and §2.5.10, for
  normally ordered products of current fields.
* V. Kac, *Vertex Algebras for Beginners*, 2nd ed., §2.3.
-/

public section

noncomputable section

open scoped TensorProduct
open TauCeti.UniversalEnvelopingAlgebra
open LieAlgebra.ofTwoCocycle (centralElement envelopingι)

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

section NormalOrder

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "UK" => CentralQuotient R (centralElement (twoCocycleOfBilinear R L Φ hΦ hΦs)) a

/-- The current generator of the mode `x ⊗ tᵐ`. -/
local notation "ι[" x ", " m "]" =>
  envelopingι (twoCocycleOfBilinear R L Φ hΦ hΦs) a (HahnSeries.single m (1 : R) ⊗ₜ[R] x)

/-- The summand of index `m` of the mode `:x y:_n`, normally ordered at the cut `p`: it is
`xₘ y_{n-m}` if `m < p` and `y_{n-m} xₘ` if `p ≤ m`, where `xₘ` is the current generator of the
mode `x ⊗ tᵐ`. The usual normal ordering is the cut `p = 0`, which puts the negative modes of `x`
to the left. The summand is bilinear in `x` and `y`. -/
def normalOrderedSummand (p n m : ℤ) : L →ₗ[R] L →ₗ[R] UK :=
  LinearMap.mk₂ R (fun x y ↦ if m < p then ι[x, m] * ι[y, n - m] else ι[y, n - m] * ι[x, m])
    (fun x x' y ↦ by split_ifs <;> simp [TensorProduct.tmul_add, add_mul, mul_add])
    (fun r x y ↦ by split_ifs <;> simp [TensorProduct.tmul_smul])
    (fun x y y' ↦ by split_ifs <;> simp [TensorProduct.tmul_add, add_mul, mul_add])
    (fun r x y ↦ by split_ifs <;> simp [TensorProduct.tmul_smul])

variable {Φ hΦ hΦs a}

/-- The normally ordered summand is `xₘ y_{n-m}` below the cut and `y_{n-m} xₘ` at or above it. -/
theorem normalOrderedSummand_apply (p n m : ℤ) (x y : L) :
    normalOrderedSummand Φ hΦ hΦs a p n m x y =
      if m < p then ι[x, m] * ι[y, n - m] else ι[y, n - m] * ι[x, m] :=
  LinearMap.mk₂_apply ..

/-- Below the cut, the mode of `x` stands on the left. -/
theorem normalOrderedSummand_of_lt {p n m : ℤ} (h : m < p) (x y : L) :
    normalOrderedSummand Φ hΦ hΦs a p n m x y = ι[x, m] * ι[y, n - m] := by
  simp [normalOrderedSummand_apply, h]

/-- At or above the cut, the mode of `x` stands on the right. -/
theorem normalOrderedSummand_of_le {p n m : ℤ} (h : p ≤ m) (x y : L) :
    normalOrderedSummand Φ hΦ hΦs a p n m x y = ι[y, n - m] * ι[x, m] := by
  simp [normalOrderedSummand_apply, not_lt.2 h]

/-- Outside the finite window `min (n + 1 - N) p ≤ m < max N p`, the summand lies in `I_N`: for
large `m` its right factor `xₘ` has order at least `N`, and for small `m` its right factor
`y_{n-m}` does. -/
private theorem normalOrderedSummand_mem_orderLeftIdeal {p n m N : ℤ}
    (h : m ∉ Finset.Ico (min (n + 1 - N) p) (max N p)) (x y : L) :
    normalOrderedSummand Φ hΦ hΦs a p n m x y ∈ orderLeftIdeal Φ hΦ hΦs a N := by
  rw [Finset.mem_Ico, not_and_or, not_le, not_lt] at h
  rcases lt_or_ge m p with hm | hm
  · rw [normalOrderedSummand_of_lt hm]
    exact (orderLeftIdeal Φ hΦ hΦs a N).smul_mem _
      (envelopingι_mem_orderLeftIdeal (single_tmul_mem_orderSubmodule R L (by omega) 1 y))
  · rw [normalOrderedSummand_of_le hm]
    exact (orderLeftIdeal Φ hΦ hΦs a N).smul_mem _
      (envelopingι_mem_orderLeftIdeal (single_tmul_mem_orderSubmodule R L (by omega) 1 x))

variable (Φ hΦ hΦs a) in
/-- The normally ordered summands at any cut form a summable family in the completion: modulo
each `I_N`, all summands outside a finite window vanish. -/
theorem summable_normalOrderedSummand (p n : ℤ) (x y : L) :
    Summable fun m ↦
      toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a p n m x y) := by
  refine (ModuleTower.summable_iff_forall_eventually_limπ_eq_zero _ _).2 fun N ↦ ?_
  refine Filter.eventually_cofinite.2 <|
    (Finset.Ico (min (n + 1 - N) p) (max (N : ℤ) p)).finite_toSet.subset fun m hm ↦ ?_
  by_contra h
  apply hm
  rw [limπ_toCompletedEnveloping, ModuleTower.quotientsπ_eq_zero_iff]
  exact normalOrderedSummand_mem_orderLeftIdeal h x y

/-- The coordinate in `U / I_N` of the sum of the normally ordered summands at a cut `p` is the
class of the finite sum over the window `min (n + 1 - N) p ≤ m < max N p`. -/
private theorem limπ_tsum_normalOrderedSummand (p n : ℤ) (x y : L) (N : ℕ) :
    (orderQuotientTower Φ hΦ hΦs a).limπ N
        (∑' m, toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a p n m x y)) =
      ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) N
        (∑ m ∈ Finset.Ico (min (n + 1 - N) p) (max (N : ℤ) p),
          normalOrderedSummand Φ hΦ hΦs a p n m x y) := by
  rw [ModuleTower.limπ_tsum_eq_sum _ (summable_normalOrderedSummand Φ hΦ hΦs a p n x y) N
    (Finset.Ico (min (n + 1 - N) p) (max (N : ℤ) p)) fun m hm ↦ ?_, map_sum]
  · simp only [limπ_toCompletedEnveloping]
  · rw [limπ_toCompletedEnveloping, ModuleTower.quotientsπ_eq_zero_iff]
    exact normalOrderedSummand_mem_orderLeftIdeal hm x y

variable (Φ hΦ hΦs a)

/-- **The normally ordered modes** `:x y:_n = ∑_{m < 0} xₘ y_{n-m} + ∑_{m ≥ 0} y_{n-m} xₘ` of the
normally ordered product of the current fields `J^x(z)` and `J^y(z)`, as elements of the completed
enveloping algebra `Û = lim_N U / I_N`, where `xₘ` is the current generator of the mode `x ⊗ tᵐ`.
The series converges because all but finitely many of its summands lie in each `I_N`
(`TauCeti.CurrentAlgebra.hasSum_normalOrderedMode`). The mode is bilinear in `x` and `y`. -/
def normalOrderedMode (n : ℤ) : L →ₗ[R] L →ₗ[R] CompletedEnveloping Φ hΦ hΦs a :=
  LinearMap.mk₂ R
    (fun x y ↦ ∑' m, toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a 0 n m x y))
    (fun x x' y ↦ by
      simp only [map_add, LinearMap.add_apply]
      exact (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y).tsum_add
        (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x' y))
    (fun r x y ↦ by
      simp only [map_smul, LinearMap.smul_apply]
      simp only [Algebra.smul_def]
      exact (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y).tsum_mul_left _)
    (fun x y y' ↦ by
      simp only [map_add]
      exact (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y).tsum_add
        (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y'))
    (fun r x y ↦ by
      simp only [map_smul]
      simp only [Algebra.smul_def]
      exact (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y).tsum_mul_left _)

variable {Φ hΦ hΦs a}

/-- The normally ordered mode `:x y:_n` is the sum of its summands ordered at the cut `0`. -/
theorem normalOrderedMode_apply (n : ℤ) (x y : L) :
    normalOrderedMode Φ hΦ hΦs a n x y =
      ∑' m, toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a 0 n m x y) :=
  LinearMap.mk₂_apply ..

/-- **Convergence of the normally ordered modes.** The mode `:x y:_n` is the sum in `Û` of its
summands `xₘ y_{n-m}` for `m < 0` and `y_{n-m} xₘ` for `m ≥ 0`. -/
theorem hasSum_normalOrderedMode (n : ℤ) (x y : L) :
    HasSum (fun m ↦ toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a 0 n m x y))
      (normalOrderedMode Φ hΦ hΦs a n x y) :=
  by rw [normalOrderedMode_apply]; exact (summable_normalOrderedSummand Φ hΦ hΦs a 0 n x y).hasSum

/-- **The coordinates of the normally ordered modes are finite sums.** Modulo `I_N`, the mode
`:x y:_n` is represented by its summands with `min (n + 1 - N) 0 ≤ m < N`. -/
theorem limπ_normalOrderedMode (n : ℤ) (x y : L) (N : ℕ) :
    (orderQuotientTower Φ hΦ hΦs a).limπ N (normalOrderedMode Φ hΦ hΦs a n x y) =
      ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) N
        (∑ m ∈ Finset.Ico (min (n + 1 - N) 0) N, normalOrderedSummand Φ hΦ hΦs a 0 n m x y) := by
  have h := limπ_tsum_normalOrderedSummand (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) 0 n x y N
  rwa [max_eq_left (Nat.cast_nonneg N), ← normalOrderedMode_apply] at h

/-- **The action of a normally ordered mode on a smooth vector is a finite sum.** On a vector `v`
of a smooth module killed by `I_N`, the mode `:x y:_n` acts by its summands with
`min (n + 1 - N) 0 ≤ m < N`. -/
theorem limSmul_normalOrderedMode {M : ModuleCat UK}
    (hM : smoothModules (fun n : ℕ ↦ orderLeftIdeal Φ hΦ hΦs a n) M) (n : ℤ) (x y : L) {v : M}
    {N : ℕ} (hv : ∀ c ∈ orderLeftIdeal Φ hΦ hΦs a N, c • v = 0) :
    ModuleTower.limSmul hM (normalOrderedMode Φ hΦ hΦs a n x y) v =
      ∑ m ∈ Finset.Ico (min (n + 1 - N) 0) N, normalOrderedSummand Φ hΦ hΦs a 0 n m x y • v := by
  rw [ModuleTower.limSmul_eq_smul hM _ hv (limπ_normalOrderedMode n x y N).symm, Finset.sum_smul]

/-- The summands at the cut `p` differ from those at the cut `0` by the commutator
`[xₘ, y_{n-m}]` when `0 ≤ m < p`, and by its negative when `p ≤ m < 0`. -/
private theorem normalOrderedSummand_eq_add_sub (p n m : ℤ) (x y : L) :
    normalOrderedSummand Φ hΦ hΦs a p n m x y =
      normalOrderedSummand Φ hΦ hΦs a 0 n m x y +
        (if m ∈ Finset.Ico 0 p then ι[x, m] * ι[y, n - m] - ι[y, n - m] * ι[x, m] else 0) -
        (if m ∈ Finset.Ico p 0 then ι[x, m] * ι[y, n - m] - ι[y, n - m] * ι[x, m] else 0) := by
  simp only [normalOrderedSummand_apply, Finset.mem_Ico]
  split_ifs <;> first | omega | abel

/-- **Moving the cut of the normal ordering.** If the summands of `:x y:_n` are ordered at the cut
`p` instead of `0`, putting `xₘ` on the left exactly when `m < p`, the series still converges in
`Û` (`TauCeti.CurrentAlgebra.summable_normalOrderedSummand`), and its sum differs from `:x y:_n`
by the commutators `[xₘ, y_{n-m}]` for `0 ≤ m < p`, minus those for `p ≤ m < 0`. At most one of
these two finite sums is nonempty. -/
theorem tsum_normalOrderedSummand (p n : ℤ) (x y : L) :
    ∑' m, toCompletedEnveloping Φ hΦ hΦs a (normalOrderedSummand Φ hΦ hΦs a p n m x y) =
      normalOrderedMode Φ hΦ hΦs a n x y + toCompletedEnveloping Φ hΦ hΦs a
        (∑ m ∈ Finset.Ico 0 p, (ι[x, m] * ι[y, n - m] - ι[y, n - m] * ι[x, m]) -
          ∑ m ∈ Finset.Ico p 0, (ι[x, m] * ι[y, n - m] - ι[y, n - m] * ι[x, m])) := by
  -- A family supported in a finite set `s` and given there by `f` sums to the finite sum of `f`.
  have hs (s : Finset ℤ) (f : ℤ → UK) :
      HasSum (fun m ↦ toCompletedEnveloping Φ hΦ hΦs a (if m ∈ s then f m else 0))
        (toCompletedEnveloping Φ hΦ hΦs a (∑ m ∈ s, f m)) := by
    have h : HasSum (fun m ↦ toCompletedEnveloping Φ hΦ hΦs a (if m ∈ s then f m else 0))
        (∑ m ∈ s, toCompletedEnveloping Φ hΦ hΦs a (if m ∈ s then f m else 0)) :=
      hasSum_sum_of_ne_finset_zero fun m hm ↦ by simp [hm]
    rwa [← map_sum, Finset.sum_ite_mem, Finset.inter_self] at h
  refine HasSum.tsum_eq ?_
  simp only [normalOrderedSummand_eq_add_sub p n, map_add, map_sub, ← add_sub_assoc]
  exact ((hasSum_normalOrderedMode n x y).add (hs _ _)).sub (hs _ _)

end NormalOrder

/-! ### The completed level comparison -/

section Level

variable {Φ Ψ : LinearMap.BilinForm R L} (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)
  (hΨ : Ψ.lieInvariant L) (hΨs : Ψ.IsSymm) {k : R}

/-- The level comparison, being the identity on currents, preserves the normally ordered
summands. -/
private theorem levelEnvelopingEquiv_normalOrderedSummand (h : Ψ = k • Φ) (p n m : ℤ) (x y : L) :
    levelEnvelopingEquiv hΦ hΦs hΨ hΨs h (normalOrderedSummand Ψ hΨ hΨs 1 p n m x y) =
      normalOrderedSummand Φ hΦ hΦs k p n m x y := by
  simp only [normalOrderedSummand_apply]
  split_ifs <;> simp

/-- **The completed level comparison preserves normally ordered modes.** If `Ψ = k • Φ`, the
completed level comparison from `Û(ĝ_Ψ)` at central value `1` to `Û(ĝ_Φ)` at central value `k`
sends `:x y:_n` to `:x y:_n`, for every `k`, including `k = 0`. -/
@[simp]
theorem levelCompletedEnvelopingEquiv_normalOrderedMode (h : Ψ = k • Φ) (n : ℤ) (x y : L) :
    levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h (normalOrderedMode Ψ hΨ hΨs 1 n x y) =
      normalOrderedMode Φ hΦ hΦs k n x y := by
  refine ((hasSum_normalOrderedMode n x y).map (levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h)
    (continuous_levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h)).unique ?_
  convert hasSum_normalOrderedMode (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := k) n x y using 2
  simp [levelEnvelopingEquiv_normalOrderedSummand]

end Level

end TauCeti.CurrentAlgebra
