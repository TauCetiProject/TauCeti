/-!
# Enveloping algebras of residue central extensions at a fixed level

For an invariant symmetric bilinear form `Φ` on a Lie algebra `L` over a commutative ring `R`, the
residue central extension `ĝ = L((t)) ⊕ R K` of the formal currents `L((t)) = R⸨X⸩ ⊗[R] L` is
Mathlib's `LieAlgebra.ofTwoCocycle` of the residue cocycle
`TauCeti.CurrentAlgebra.twoCocycleOfBilinear`. Its central element is
`K = TauCeti.CurrentAlgebra.centralElement`. For a scalar `a`, this file studies the quotient
`U(ĝ) / (ι K - a)` of its universal enveloping algebra, the algebra
`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient R K a`, whose modules are the representations
of `ĝ` on which `K` acts by `a`. At `a = 1` this is the level enveloping algebra `U_κ` of the form
`κ = -Φ`; the affine convention `c_κ = -κ(x, y) Res(f dg)` for the cocycle is the residue cocycle
of `Φ = -κ`.

The algebra is generated by the images `TauCeti.CurrentAlgebra.envelopingι c a u` of the
currents `u`, where `c` is the residue cocycle, subject to the commutator relations

`[u, v] = ⁅u, v⁆ + a Res(u dv)`,

where `Res(u dv)` is the residue pairing of `Φ`. The generators, the commutator relations
`[u, v] = ⁅u, v⁆ + a c(u, v)`, generation and extensionality are stated for the central extension
of any Lie algebra by any 2-cocycle `c` with trivial coefficients in `R`, so that they serve the
formal and the polynomial residue extensions alike. For the formal residue cocycle, the
commutator relations characterise the algebra; this is the universal property
`TauCeti.CurrentAlgebra.liftOfCurrents`. Over a field, the Poincaré--Birkhoff--Witt theorem shows
that the currents embed (`TauCeti.CurrentAlgebra.envelopingι_injective`), for every value of `a`,
including `a = 0`.

Changing the level is the same as changing the value of `K`: if `Ψ = k • Φ`, the identity on
currents gives an algebra isomorphism from `U(ĝ_Ψ) / (ι K - 1)` to `U(ĝ_Φ) / (ι K - k)`
(`TauCeti.CurrentAlgebra.levelEnvelopingEquiv`). This holds for every `k`, including `k = 0`,
where the left side is the level-one enveloping algebra of the split extension of the zero form and
the right side sets `K` to zero in the extension of `Φ`. This is an isomorphism of algebras, not of
Lie algebras: the level rescaling `TauCeti.CurrentAlgebra.levelHom` sends `K` to `k • K` rather
than to `K`.

## Main definitions

* `TauCeti.CurrentAlgebra.envelopingι`: the current generators of `U(ĝ) / (ι K - a)`.
* `TauCeti.CurrentAlgebra.liftOfCurrents`: the universal property in terms of currents.
* `TauCeti.CurrentAlgebra.envelopingAction`: the action of the currents on a module over
  `U(ĝ) / (ι K - a)`.
* `TauCeti.CurrentAlgebra.levelEnvelopingEquiv`: the level comparison isomorphism.

## Main results

* `TauCeti.CurrentAlgebra.envelopingι_mul_sub_mul`: the commutator relations.
* `TauCeti.CurrentAlgebra.envelopingAction_mul_sub_mul`: the commutator relations for the action
  of the currents on a module.
* `TauCeti.CurrentAlgebra.adjoin_range_envelopingι`: the currents generate the algebra.
* `TauCeti.CurrentAlgebra.algHom_ext_envelopingι`: algebra morphisms are determined on currents.
* `TauCeti.CurrentAlgebra.derivation_ext_envelopingι`: derivations are determined on currents.
* `TauCeti.CurrentAlgebra.envelopingι_injective`: over a field, the currents embed.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1, for the completed enveloping algebra
  of an affine Kac--Moody algebra at a fixed level, built from this quotient.
* V. G. Kac, *Infinite-Dimensional Lie Algebras*, 3rd ed., Chapter 7, for the affine central
  extension of a loop algebra and its level.
-/

public section

noncomputable section

open scoped LaurentSeries
open LieAlgebra LieModule.Cohomology TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 1100] HahnSeries.instAlgebra
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "C" => currentAlgebra R L
local notation "Z" => TrivialLieModule R C R

section Generators

variable {L' : Type*} [LieRing L'] [LieAlgebra R L']
  (c : twoCocycle R L' (TrivialLieModule R L' R)) (a : R)

local notation "UE" => CentralQuotient R (centralElement c) a

/-- The generators of the enveloping algebra at the central value `a` of the central extension of
`L'` by a 2-cocycle `c` with trivial coefficients in `R`: the image of `u` is the class of
`ι (u, 0)` in `U(ofTwoCocycle c) / (ι K - a)`. For the residue cocycle of formal or polynomial
currents these are the current generators. -/
def envelopingι : L' →ₗ[R] UE :=
  (CentralQuotient.ι (centralElement c) a).toLinearMap ∘ₗ
    (ofProdLinearEquiv c).toLinearMap ∘ₗ LinearMap.inl R L' (TrivialLieModule R L' R)

/-- The generator of `u` is the image of `(u, 0)`. -/
theorem envelopingι_apply (u : L') :
    envelopingι c a u = CentralQuotient.ι (centralElement c) a (ofProd c (u, 0)) := by
  simp [envelopingι, coe_ofProdLinearEquiv]

/-- The image of an element of the extension is that of its first coordinate plus `a` times its
central coordinate. -/
@[simp]
theorem ι_ofProd (u : L') (z : TrivialLieModule R L' R) :
    CentralQuotient.ι (centralElement c) a (ofProd c (u, z)) =
      envelopingι c a u + algebraMap R UE (a * TrivialLieModule.equiv R L' R z) := by
  rw [ofProd_eq_add_smul_centralElement c, map_add, map_smul, CentralQuotient.ι_self,
    Algebra.smul_def, ← map_mul, mul_comm, envelopingι_apply]

/-- **The commutator relations.** The generators satisfy `[u, v] = ⁅u, v⁆ + a c(u, v)`. -/
theorem envelopingι_mul_sub_mul (u v : L') :
    envelopingι c a u * envelopingι c a v - envelopingι c a v * envelopingι c a u =
      envelopingι c a ⁅u, v⁆ + algebraMap R UE (a * TrivialLieModule.equiv R L' R
        ((c : twoCochain R L' (TrivialLieModule R L' R)) u v)) := by
  have h := (CentralQuotient.ι (centralElement c) a).map_lie (ofProd c (u, 0)) (ofProd c (v, 0))
  rw [LieRing.of_associative_ring_bracket] at h
  rw [envelopingι_apply, envelopingι_apply, ← h, bracket_ofTwoCocycle]
  simp [trivial_lie_zero]

/-- The generators generate `U(ofTwoCocycle c) / (ι K - a)` as an `R`-algebra. -/
theorem adjoin_range_envelopingι : Algebra.adjoin R (Set.range (envelopingι c a)) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨x, rfl⟩ := CentralQuotient.mk_surjective (centralElement c) a x
  induction x using UniversalEnvelopingAlgebra.induction_ι with
  | ι e =>
    obtain ⟨⟨u, z⟩, rfl⟩ := (ofProd c).surjective e
    rw [← CentralQuotient.ι_apply, ι_ofProd]
    exact add_mem (Algebra.subset_adjoin ⟨u, rfl⟩) (Subalgebra.algebraMap_mem _ _)
  | algebraMap r => simpa only [AlgHom.commutes] using Subalgebra.algebraMap_mem _ r
  | add x y hx hy => simpa only [map_add] using add_mem hx hy
  | mul x y hx hy => simpa only [map_mul] using mul_mem hx hy

variable {A : Type*} [Ring A] [Algebra R A]

/-- Algebra morphisms out of `U(ofTwoCocycle c) / (ι K - a)` are determined by their values on the
generators. -/
theorem algHom_ext_envelopingι {g₁ g₂ : UE →ₐ[R] A}
    (h : ∀ u, g₁ (envelopingι c a u) = g₂ (envelopingι c a u)) : g₁ = g₂ := by
  ext v
  obtain ⟨⟨u, z⟩, rfl⟩ := (ofProd c).surjective v
  rw [ι_ofProd, map_add, map_add, h, AlgHom.commutes, AlgHom.commutes]

/-- **A derivation of `U(ofTwoCocycle c) / (ι K - a)` is determined by its values on the
generators.** -/
theorem derivation_ext_envelopingι {D₁ D₂ : derivationLieAlgebra R UE}
    (h : ∀ u : L', (D₁ : Module.End R UE) (envelopingι c a u) =
      (D₂ : Module.End R UE) (envelopingι c a u)) : D₁ = D₂ := by
  -- The elements on which `D₁` and `D₂` agree contain the scalars and are closed under sums and
  -- products, and the generators generate the algebra.
  refine derivationLieAlgebra.ext fun x ↦ ?_
  have hx : x ∈ Algebra.adjoin R (Set.range (envelopingι c a)) := by
    rw [adjoin_range_envelopingι]
    exact Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨u, rfl⟩ := hx
    exact h u
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, map_smul, map_smul,
      derivationLieAlgebra.apply_one_eq_zero, derivationLieAlgebra.apply_one_eq_zero]
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | mul x y _ _ hx hy => rw [derivationLieAlgebra.leibniz, derivationLieAlgebra.leibniz, hx, hy]

end Generators

section Lift

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "E" => ofTwoCocycle c
local notation "UK" => CentralQuotient R (centralElement c) a

variable {A : Type*} [Ring A] [Algebra R A]

/-- The linear map from the extension sending `(u, z)` to `f u + a z`. -/
private def extensionLinearMap (f : C →ₗ[R] A) : E →ₗ[R] A :=
  (f ∘ₗ LinearMap.fst R C Z + a • (Algebra.linearMap R A ∘ₗ
    (TrivialLieModule.equiv R C R).toLinearMap ∘ₗ LinearMap.snd R C Z)) ∘ₗ
      (ofProdLinearEquiv c).symm.toLinearMap

private theorem extensionLinearMap_ofProd (f : C →ₗ[R] A) (u : C) (z : Z) :
    extensionLinearMap Φ hΦ hΦs a f (ofProd c (u, z)) =
      f u + algebraMap R A (a * TrivialLieModule.equiv R C R z) := by
  simp [extensionLinearMap, coe_ofProdLinearEquiv_symm, Algebra.smul_def]

/-- The Lie algebra morphism from the extension sending `(u, z)` to `f u + a z`, for `f`
satisfying the commutator relations. -/
private def extensionHom (f : C →ₗ[R] A)
    (hf : ∀ u v, f u * f v - f v * f u = f ⁅u, v⁆ + algebraMap R A (a * residuePairing R L Φ u v)) :
    E →ₗ⁅R⁆ A where
  toLinearMap := extensionLinearMap Φ hΦ hΦs a f
  map_lie' := fun {x y} ↦ by
    -- Shifting by scalars does not change commutators.
    have hshift (x y : A) (p q : R) : (x + algebraMap R A p) * (y + algebraMap R A q) -
        (y + algebraMap R A q) * (x + algebraMap R A p) = x * y - y * x := by
      simp only [add_mul, mul_add, Algebra.commutes p y, Algebra.commutes q x, ← map_mul,
        mul_comm p q]
      abel
    obtain ⟨⟨u, z⟩, rfl⟩ := (ofProd c).surjective x
    obtain ⟨⟨v, w⟩, rfl⟩ := (ofProd c).surjective y
    simp only [AddHom.toFun_eq_coe, LinearMap.coe_toAddHom, bracket_ofTwoCocycle,
      Equiv.symm_apply_apply, extensionLinearMap_ofProd, LieRing.of_associative_ring_bracket,
      hshift, hf]
    simp [trivial_lie_zero]

/-- **The universal property in terms of currents.** A linear map `f` from the currents to an
associative algebra satisfying the commutator relations `[f u, f v] = f ⁅u, v⁆ + a Res(u dv)`
extends to an algebra morphism from `U(ĝ) / (ι K - a)`. -/
def liftOfCurrents (f : C →ₗ[R] A)
    (hf : ∀ u v, f u * f v - f v * f u = f ⁅u, v⁆ + algebraMap R A (a * residuePairing R L Φ u v)) :
    UK →ₐ[R] A :=
  CentralQuotient.lift (extensionHom Φ hΦ hΦs a f hf) <| by
    rw [← (ofProd c).apply_symm_apply (centralElement c), ofProd_symm_centralElement]
    exact (extensionLinearMap_ofProd Φ hΦ hΦs a f 0 _).trans (by simp)

/-- The lift sends the current generator of `u` to `f u`. -/
@[simp]
theorem liftOfCurrents_envelopingι (f : C →ₗ[R] A)
    (hf : ∀ u v, f u * f v - f v * f u = f ⁅u, v⁆ + algebraMap R A (a * residuePairing R L Φ u v))
    (u : C) : liftOfCurrents Φ hΦ hΦs a f hf (envelopingι c a u) = f u := by
  rw [envelopingι_apply, liftOfCurrents, CentralQuotient.lift_ι]
  exact (extensionLinearMap_ofProd Φ hΦ hΦs a f u 0).trans (by simp)

end Lift

section Action

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)
  {M : Type*} [AddCommGroup M] [Module R M]
  [Module (CentralQuotient R (centralElement (twoCocycleOfBilinear R L Φ hΦ hΦs)) a) M]
  [IsScalarTower R (CentralQuotient R (centralElement (twoCocycleOfBilinear R L Φ hΦ hΦs)) a) M]

local notation "c" => twoCocycleOfBilinear R L Φ hΦ hΦs

/-- The action of the currents on a module over `U(ĝ) / (ι K - a)`: `u` acts by its current
generator. -/
def envelopingAction : C →ₗ[R] Module.End R M :=
  (Algebra.lsmul R R M).toLinearMap ∘ₗ envelopingι c a

/-- A current acts by its current generator. -/
@[simp]
theorem envelopingAction_apply (u : C) (m : M) :
    envelopingAction (M := M) Φ hΦ hΦs a u m = envelopingι c a u • m :=
  (rfl)

/-- The action of the currents on a module over `U(ĝ) / (ι K - a)` satisfies the commutator
relations `[u, v] = ⁅u, v⁆ + a Res(u dv)`. -/
theorem envelopingAction_mul_sub_mul (u v : C) :
    envelopingAction (M := M) Φ hΦ hΦs a u * envelopingAction Φ hΦ hΦs a v -
        envelopingAction Φ hΦ hΦs a v * envelopingAction Φ hΦ hΦs a u =
      envelopingAction Φ hΦ hΦs a ⁅u, v⁆ +
        algebraMap R (Module.End R M) (a * residuePairing R L Φ u v) := by
  have h := congrArg (Algebra.lsmul R R M) (envelopingι_mul_sub_mul c a u v)
  rw [twoCocycleOfBilinear_coe, twoCochainOfBilinear_apply_apply,
    LinearEquiv.apply_symm_apply] at h
  simp only [map_sub, map_mul, map_add, AlgHom.commutes] at h
  simpa only [envelopingAction, LinearMap.coe_comp, Function.comp_apply,
    AlgHom.toLinearMap_apply, map_mul] using h

end Action

section Field

variable {K : Type*} [Field K] [LieAlgebra K L]
  (Φ : LinearMap.BilinForm K L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)

local notation "cK" => twoCocycleOfBilinear K L Φ hΦ hΦs

/-- **The currents embed.** Over a field, for every central value `a`, including `a = 0`, the map
from the currents to their generators in `U(ĝ) / (ι K - a)` is injective. -/
theorem envelopingι_injective (a : K) : Function.Injective (envelopingι cK a) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro u hu
  obtain ⟨r, hr, -⟩ := (CentralQuotient.ι_eq_algebraMap_iff (centralElement_mem_center cK)
    (centralElement_ne_zero cK) (c := a) (x := ofProd _ (u, 0)) (a := 0)).1
      (by rw [← envelopingι_apply, hu, map_zero])
  simpa using congrArg (fun v ↦ ((ofProd _).symm v).1) hr

end Field

section Level

variable {Φ Ψ : LinearMap.BilinForm R L} (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)
  (hΨ : Ψ.lieInvariant L) (hΨs : Ψ.IsSymm) {k : R}

local notation "cΦ" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "cΨ" => twoCocycleOfBilinear R L Ψ hΨ hΨs

/-- **Level comparison.** If `Ψ = k • Φ`, the identity on currents is an algebra isomorphism from
the level-one enveloping algebra `U(ĝ_Ψ) / (ι K - 1)` of `Ψ` to `U(ĝ_Φ) / (ι K - k)`. This holds
for every `k`, including `k = 0`. -/
def levelEnvelopingEquiv (h : Ψ = k • Φ) :
    CentralQuotient R (centralElement cΨ) 1 ≃ₐ[R]
      CentralQuotient R (centralElement cΦ) k :=
  AlgEquiv.ofAlgHom
    (liftOfCurrents Ψ hΨ hΨs 1 (envelopingι cΦ k) fun u v ↦ by
      subst h
      rw [envelopingι_mul_sub_mul, twoCocycleOfBilinear_coe, twoCochainOfBilinear_apply_apply,
        LinearEquiv.apply_symm_apply, residuePairing_smul, one_mul, LinearMap.smul_apply,
        LinearMap.smul_apply, smul_eq_mul])
    (liftOfCurrents Φ hΦ hΦs k (envelopingι cΨ 1) fun u v ↦ by
      subst h
      rw [envelopingι_mul_sub_mul, twoCocycleOfBilinear_coe, twoCochainOfBilinear_apply_apply,
        LinearEquiv.apply_symm_apply, residuePairing_smul, one_mul, LinearMap.smul_apply,
        LinearMap.smul_apply, smul_eq_mul])
    (algHom_ext_envelopingι cΦ k fun u ↦ by simp)
    (algHom_ext_envelopingι cΨ 1 fun u ↦ by simp)

/-- The level comparison is the identity on currents. -/
@[simp]
theorem levelEnvelopingEquiv_envelopingι (h : Ψ = k • Φ) (u : C) :
    levelEnvelopingEquiv hΦ hΦs hΨ hΨs h (envelopingι cΨ 1 u) = envelopingι cΦ k u := by
  simp [levelEnvelopingEquiv]

/-- The inverse level comparison is the identity on currents. -/
@[simp]
theorem levelEnvelopingEquiv_symm_envelopingι (h : Ψ = k • Φ) (u : C) :
    (levelEnvelopingEquiv hΦ hΦs hΨ hΨs h).symm (envelopingι cΦ k u) =
      envelopingι cΨ 1 u := by
  simp [levelEnvelopingEquiv]

end Level

end TauCeti.CurrentAlgebra
