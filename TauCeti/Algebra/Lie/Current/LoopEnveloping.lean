public import TauCeti.Algebra.Lie.Current.LeftIdeal
public import TauCeti.Algebra.Lie.Current.SmoothAction

/-!
# Polynomial and formal currents in level enveloping algebras

Let `ĝ_pol = L[t, t⁻¹] ⊕ R K` be the residue central extension of the polynomial loop algebra by
Mathlib's residue cocycle `LieAlgebra.LoopAlgebra.twoCocycleOfBilinear` of an invariant symmetric
form `Φ`, and `ĝ = L((t)) ⊕ R K` that of the formal currents. For a central value `a`, write
`U_pol = U(ĝ_pol) / (ι K - a)` and `U = U(ĝ) / (ι K - a)` for their enveloping algebras at `a`
(`TauCeti.UniversalEnvelopingAlgebra.CentralQuotient`). The polynomial embedding
`TauCeti.CurrentAlgebra.ofLoopExtension` induces an algebra morphism `U_pol → U`
(`TauCeti.CurrentAlgebra.loopEnvelopingHom`), sending the polynomial current generator
`LieAlgebra.ofTwoCocycle.envelopingι cP a p` of `p`, for Mathlib's residue cocycle `cP`, to the
current generator of `p` viewed as a formal current
(`TauCeti.CurrentAlgebra.loopEnvelopingHom_envelopingι`).

For an integer `N` let `I_N^pol ⊆ U_pol` be the left ideal generated by the polynomial currents of
order at least `N` (`TauCeti.CurrentAlgebra.loopOrderLeftIdeal`), and `I_N ⊆ U` the left ideal
generated by the formal currents of order at least `N` (`TauCeti.CurrentAlgebra.orderLeftIdeal`).
The main result is that the polynomial and formal stages agree:

`U_pol / I_N^pol ≃ U / I_N`

through the map induced by `U_pol → U` (`TauCeti.CurrentAlgebra.loopOrderQuotientMap_bijective`),
compatibly with the transition maps between stages
(`TauCeti.CurrentAlgebra.factor_loopOrderQuotientMap`). Equivalently, the preimage of `I_N` in
`U_pol` is `I_N^pol` (`TauCeti.CurrentAlgebra.comap_loopEnvelopingHom_orderLeftIdeal`), and every
element of `U` is congruent modulo `I_N` to the image of an element of `U_pol`
(`TauCeti.CurrentAlgebra.exists_sub_loopEnvelopingHom_mem_orderLeftIdeal`), although `U_pol → U`
is far from surjective. These stagewise isomorphisms are the input for identifying the completions
`lim_N U_pol / I_N^pol` and `lim_N U / I_N` of the two enveloping algebras.

Surjectivity uses the right-shift estimate in `U`: a formal current `u` agrees with its polynomial
truncation below `M` up to a current of order at least `M`, and `I_M b ⊆ I_N` for `M` large. For
injectivity, the polynomial right-shift estimate
(`TauCeti.CurrentAlgebra.exists_forall_mul_mem_loopOrderLeftIdeal`) shows that the action of the
polynomial currents on `U_pol / I_N^pol` is smooth, so it extends by finite truncation
(`TauCeti.CurrentAlgebra.extendExtensionLieHom`) to an action of `ĝ` in which `K` still acts by `a`.
Hence `U_pol / I_N^pol` is a `U`-module. The orbit map of the class of `1` kills `I_N`, and it is a
left inverse of the induced map `U_pol / I_N^pol → U / I_N`. No finiteness of `L` and no PBW theorem
are used; as for Mathlib's polynomial residue cocycle, `R` is additively torsion-free.

## Main definitions

* `TauCeti.CurrentAlgebra.loopEnvelopingHom`: the algebra morphism `U_pol → U`.
* `TauCeti.CurrentAlgebra.loopOrderLeftIdeal`: the left ideal `I_N^pol` of `U_pol`.
* `TauCeti.CurrentAlgebra.extendEnvelopingAction`: extension of a smooth polynomial level action.
* `TauCeti.CurrentAlgebra.loopOrderQuotientMap`: the induced semilinear map
  `U_pol / I_N^pol → U / I_N`.

## Main results

* `TauCeti.CurrentAlgebra.exists_forall_mul_mem_loopOrderLeftIdeal`: the polynomial right-shift
  estimate `∀ b N, ∃ M, I_M^pol b ⊆ I_N^pol`.
* `TauCeti.CurrentAlgebra.comap_loopEnvelopingHom_orderLeftIdeal`: the preimage of `I_N` is
  `I_N^pol`.
* `TauCeti.CurrentAlgebra.loopOrderQuotientMap_bijective`: `U_pol / I_N^pol → U / I_N` is bijective.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the left ideals
  `I_N` and the completion `lim_N U / I_N` of the enveloping algebra of an affine Kac--Moody algebra
  at a fixed level.
-/

public section

noncomputable section

open scoped LaurentSeries
open LieAlgebra LieModule.Cohomology TauCeti.UniversalEnvelopingAlgebra
open LieAlgebra.ofTwoCocycle (centralElement envelopingι envelopingι_apply envelopingι_mul_sub_mul
  adjoin_range_envelopingι)

attribute [local instance 1100] HahnSeries.instAlgebra
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [HasUniqueDiv R] [LieRing L] [LieAlgebra R L]

local notation "P" => LieAlgebra.loopAlgebra R ℤ L
local notation "ZP" => TrivialLieModule R P R

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "cP" => LieAlgebra.LoopAlgebra.twoCocycleOfBilinear R ℤ L Φ hΦ hΦs
local notation "cΦ" => twoCocycleOfBilinear R L Φ hΦ hΦs
local notation "UP" => CentralQuotient R (centralElement cP) a
local notation "UK" => CentralQuotient R (centralElement cΦ) a

section Hom

/-- The algebra morphism `U(ĝ_pol) / (ι K - a) → U(ĝ) / (ι K - a)` induced by the embedding
`ofLoopExtension` of the polynomial residue central extension into the formal one. -/
def loopEnvelopingHom : UP →ₐ[R] UK :=
  CentralQuotient.map (ofLoopExtension Φ hΦ hΦs) (ofLoopExtension_centralElement Φ hΦ hΦs)

/-- The morphism `U_pol → U` sends the polynomial current generator of `p` to the current generator
of `p` viewed as a formal current. -/
@[simp]
theorem loopEnvelopingHom_envelopingι (p : P) :
    loopEnvelopingHom Φ hΦ hΦs a (envelopingι cP a p) = envelopingι cΦ a (ofLoop R L p) := by
  rw [loopEnvelopingHom, envelopingι_apply, CentralQuotient.map_ι, ofLoopExtension_ofProd,
    envelopingι_apply, map_zero, map_zero]

end Hom

section LeftIdeal

/-- The left ideal `I_N^pol` of `U(ĝ_pol) / (ι K - a)` generated by the polynomial currents of order
at least `N`, as a submodule of the left regular module. -/
def loopOrderLeftIdeal (N : ℤ) : Submodule UP UP :=
  Submodule.span UP (envelopingι cP a '' {p | ofLoop R L p ∈ orderSubmodule R L N})

/-- The left ideal `I_N^pol` is spanned by the polynomial current generators of order at least
`N`. -/
theorem loopOrderLeftIdeal_def (N : ℤ) : loopOrderLeftIdeal Φ hΦ hΦs a N =
    Submodule.span UP (envelopingι cP a '' {p | ofLoop R L p ∈ orderSubmodule R L N}) :=
  (rfl)

variable {Φ hΦ hΦs a}

/-- The polynomial current generator of a polynomial current of order at least `N` lies in
`I_N^pol`. -/
theorem envelopingι_mem_loopOrderLeftIdeal {N : ℤ} {p : P}
    (hp : ofLoop R L p ∈ orderSubmodule R L N) :
    envelopingι cP a p ∈ loopOrderLeftIdeal Φ hΦ hΦs a N :=
  Submodule.subset_span ⟨p, hp, rfl⟩

/-- `I_N^pol` is contained in a left ideal exactly when the polynomial currents of order at least
`N` are. -/
theorem loopOrderLeftIdeal_le_iff {N : ℤ} {I : Submodule UP UP} :
    loopOrderLeftIdeal Φ hΦ hΦs a N ≤ I ↔
      ∀ p : P, ofLoop R L p ∈ orderSubmodule R L N → envelopingι cP a p ∈ I := by
  rw [loopOrderLeftIdeal_def, Submodule.span_le, Set.image_subset_iff]
  rfl

variable (Φ hΦ hΦs a) in
/-- The left ideals `I_N^pol` decrease as `N` grows. -/
theorem loopOrderLeftIdeal_antitone : Antitone (loopOrderLeftIdeal Φ hΦ hΦs a) := fun _ _ h ↦
  loopOrderLeftIdeal_le_iff.2 fun _ hp ↦
    envelopingι_mem_loopOrderLeftIdeal (orderSubmodule_antitone R L h hp)

/-- The product of the polynomial current generators of a current `q` of order at least `M` and a
current `p` of order at least `k`, in this order, lies in `I_N^pol` when `N ≤ M`, `N ≤ M + k` and
`0 < M + k`. -/
private theorem envelopingι_mul_envelopingι_mem_loopOrderLeftIdeal {M N k : ℤ} {p q : P}
    (hq : ofLoop R L q ∈ orderSubmodule R L M) (hp : ofLoop R L p ∈ orderSubmodule R L k)
    (hNM : N ≤ M) (hNk : N ≤ M + k) (hk : 0 < M + k) :
    envelopingι cP a q * envelopingι cP a p ∈ loopOrderLeftIdeal Φ hΦ hΦs a N := by
  -- The residue term `Res(q dp)` vanishes.
  have h : TrivialLieModule.equiv R P R ((cP : twoCochain R P ZP) q p) = 0 := by
    simpa using residuePairing_eq_zero_of_mem_orderSubmodule R L Φ hq hp hk
  rw [← sub_add_cancel (envelopingι cP a q * _) (envelopingι cP a p * _),
    envelopingι_mul_sub_mul, h, mul_zero, map_zero, add_zero]
  refine add_mem (envelopingι_mem_loopOrderLeftIdeal ?_) ?_
  · rw [LieHom.map_lie]
    exact orderSubmodule_antitone R L hNk (lie_mem_orderSubmodule R L hq hp)
  · exact (loopOrderLeftIdeal Φ hΦ hΦs a N).smul_mem _
      (envelopingι_mem_loopOrderLeftIdeal (orderSubmodule_antitone R L hNM hq))

variable (Φ hΦ hΦs a) in
/-- **The polynomial right-shift estimate.** For every `b ∈ U(ĝ_pol) / (ι K - a)` and every `N`
there is `M` with `I_M^pol b ⊆ I_N^pol`. -/
theorem exists_forall_mul_mem_loopOrderLeftIdeal (b : UP) (N : ℤ) :
    ∃ M : ℤ, ∀ x ∈ loopOrderLeftIdeal Φ hΦ hΦs a M, x * b ∈ loopOrderLeftIdeal Φ hΦ hΦs a N := by
  refine exists_forall_mul_mem_of_adjoin_eq_top
    (loopOrderLeftIdeal_antitone Φ hΦ hΦs a).directed_ge (adjoin_range_envelopingι cP a) ?_ b N
  rintro _ ⟨p, rfl⟩ N
  obtain ⟨k, hp⟩ := exists_mem_orderSubmodule R L (ofLoop R L p)
  refine ⟨max N (max (N - k) (1 - k)), fun x hx ↦ ?_⟩
  -- The elements whose right multiple by `p` lies in `I_N^pol` form a left ideal.
  refine (loopOrderLeftIdeal_le_iff (I := (loopOrderLeftIdeal Φ hΦ hΦs a N).comap
    (LinearMap.toSpanSingleton UP UP (envelopingι cP a p)))).2 (fun q hq ↦ ?_) hx
  exact envelopingι_mul_envelopingι_mem_loopOrderLeftIdeal hq hp (by omega) (by omega)
    (by omega)

/-- The morphism `U_pol → U` carries `I_N^pol` into `I_N`. -/
theorem loopOrderLeftIdeal_le_comap (N : ℤ) :
    loopOrderLeftIdeal Φ hΦ hΦs a N ≤
      Ideal.comap (loopEnvelopingHom Φ hΦ hΦs a) (orderLeftIdeal Φ hΦ hΦs a N) :=
  loopOrderLeftIdeal_le_iff.2 fun p hp ↦ by
    simpa using envelopingι_mem_orderLeftIdeal (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) hp

end LeftIdeal

/-- Polynomial smoothness is vanishing of the polynomial currents above a vectorwise cutoff. -/
theorem smoothModules_loopOrderLeftIdeal_iff {M : ModuleCat.{v} UP} :
    smoothModules (loopOrderLeftIdeal Φ hΦ hΦs a) M ↔
      ∀ m : M, ∃ N : ℤ, ∀ p : P,
        ofLoop R L p ∈ orderSubmodule R L N → envelopingι cP a p • m = 0 := by
  rw [smoothModules_iff]
  refine forall_congr' fun m ↦ exists_congr fun N ↦ ⟨fun h p hp ↦
    h _ (envelopingι_mem_loopOrderLeftIdeal hp), fun h x hx ↦ ?_⟩
  exact (loopOrderLeftIdeal_le_iff (I := LinearMap.ker
    (LinearMap.toSpanSingleton UP M m))).2 h hx

/-- Polynomial smoothness is precisely vectorwise vanishing of all sufficiently high modes. -/
theorem smoothModules_loopOrderLeftIdeal_iff_modes {M : ModuleCat.{v} UP} :
    smoothModules (loopOrderLeftIdeal Φ hΦ hΦs a) M ↔
      ∀ m : M, ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ x : L,
        envelopingι cP a (AddMonoidAlgebra.single n 1 ⊗ₜ x) • m = 0 := by
  let := Module.restrictScalars R UP M
  let := IsScalarTower.restrictScalars R UP M
  rw [smoothModules_loopOrderLeftIdeal_iff]
  simpa only [isLoopSmooth_iff_modes, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
    Algebra.lsmul_apply] using (isLoopSmooth_iff (ρ := (Algebra.lsmul R R M).toLinearMap ∘ₗ
      envelopingι cP a)).symm

section ExtendAction

variable {M : Type*} [AddCommGroup M] [Module R M]
  [Module (CentralQuotient R (centralElement
    (LieAlgebra.LoopAlgebra.twoCocycleOfBilinear R ℤ L Φ hΦ hΦs)) a) M]
  [IsScalarTower R (CentralQuotient R (centralElement
    (LieAlgebra.LoopAlgebra.twoCocycleOfBilinear R ℤ L Φ hΦ hΦs)) a) M]

local notation "ρ" => LieHom.comp (AlgHom.toLieHom (Algebra.lsmul R R M))
  (CentralQuotient.ι (centralElement cP) a)

/-- A smooth polynomial level action extends to the formal level enveloping algebra.
The given scalar action and scalar tower on `M` are preserved. -/
def extendEnvelopingAction
    (hM : IsLoopSmooth ((ρ).toLinearMap ∘ₗ
      LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP)) :
    UK →ₐ[R] Module.End R M :=
  CentralQuotient.lift (extendExtensionLieHom ρ hM) <| by
    rw [← ofLoopExtension_centralElement Φ hΦ hΦs, ← LieHom.comp_apply,
      extendExtensionLieHom_comp_ofLoopExtension, LieHom.comp_apply,
      CentralQuotient.ι_self, AlgHom.toLieHom_apply, AlgHom.commutes]

/-- The extended level action agrees with the polynomial action on all polynomial
enveloping-algebra elements. -/
@[simp]
theorem extendEnvelopingAction_loopEnvelopingHom
    (hM : IsLoopSmooth ((ρ).toLinearMap ∘ₗ
      LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP)) (x : UP) :
    extendEnvelopingAction Φ hΦ hΦs a hM (loopEnvelopingHom Φ hΦ hΦs a x) =
      Algebra.lsmul R R M x := by
  suffices h : (extendEnvelopingAction Φ hΦ hΦs a hM).comp
      (loopEnvelopingHom Φ hΦ hΦs a) = Algebra.lsmul R R M from AlgHom.congr_fun h x
  refine CentralQuotient.algHom_ext fun e ↦ ?_
  rw [AlgHom.comp_apply, loopEnvelopingHom, CentralQuotient.map_ι, extendEnvelopingAction,
    CentralQuotient.lift_ι, ← LieHom.comp_apply,
    extendExtensionLieHom_comp_ofLoopExtension, LieHom.comp_apply, AlgHom.toLieHom_apply]

/-- On a formal current generator, the extended enveloping action is finite-truncation
extension of the polynomial current action. -/
theorem extendEnvelopingAction_envelopingι
    (hM : IsLoopSmooth ((ρ).toLinearMap ∘ₗ
      LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP))
    (u : currentAlgebra R L) :
    extendEnvelopingAction Φ hΦ hΦs a hM (envelopingι cΦ a u) =
      extendAction ((ρ).toLinearMap ∘ₗ
        LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP) hM u := by
  rw [envelopingι_apply, extendEnvelopingAction, CentralQuotient.lift_ι,
    ← LieHom.coe_toLinearMap, toLinearMap_extendExtensionLieHom,
    extendExtensionAction_ofProd]
  simp [← Prod.zero_eq_mk]

end ExtendAction

section Comparison

variable {Φ hΦ hΦs a}

variable (Φ hΦ hΦs a) in
/-- **Polynomial elements are dense modulo `I_N`.** Every element of `U(ĝ) / (ι K - a)` is
congruent modulo `I_N` to the image of an element of `U(ĝ_pol) / (ι K - a)`. -/
theorem exists_sub_loopEnvelopingHom_mem_orderLeftIdeal (b : UK) (N : ℤ) :
    ∃ x : UP, b - loopEnvelopingHom Φ hΦ hΦs a x ∈ orderLeftIdeal Φ hΦ hΦs a N := by
  have hb : b ∈ Algebra.adjoin R (Set.range (envelopingι cΦ a)) :=
    adjoin_range_envelopingι cΦ a ▸ Algebra.mem_top
  induction hb using Algebra.adjoin_induction generalizing N with
  | mem b hb =>
    -- A current agrees with its truncation below `N` up to a current of order at least `N`.
    obtain ⟨u, rfl⟩ := hb
    refine ⟨envelopingι cP a (trunc R L N u), ?_⟩
    rw [loopEnvelopingHom_envelopingι, ← map_sub, ← neg_sub, map_neg]
    exact neg_mem (envelopingι_mem_orderLeftIdeal (ofLoop_trunc_sub_mem_orderSubmodule R L N u))
  | algebraMap r => exact ⟨algebraMap R UP r, by simp⟩
  | add b c _ _ hb hc =>
    obtain ⟨x, hx⟩ := hb N
    obtain ⟨y, hy⟩ := hc N
    exact ⟨x + y, by simpa [add_sub_add_comm] using add_mem hx hy⟩
  | mul b c _ _ hb hc =>
    -- `b c - x y = b (c - y) + (b - x) y`, and `I_M y ⊆ I_N` for `M` large.
    obtain ⟨y, hy⟩ := hc N
    obtain ⟨M, hM⟩ := exists_forall_mul_mem_orderLeftIdeal Φ hΦ hΦs a
      (loopEnvelopingHom Φ hΦ hΦs a y) N
    obtain ⟨x, hx⟩ := hb M
    refine ⟨x * y, ?_⟩
    have h : b * c - loopEnvelopingHom Φ hΦ hΦs a (x * y) =
        b * (c - loopEnvelopingHom Φ hΦ hΦs a y) +
          (b - loopEnvelopingHom Φ hΦ hΦs a x) * loopEnvelopingHom Φ hΦ hΦs a y := by
      rw [map_mul, mul_sub, sub_mul]
      abel
    rw [h]
    exact add_mem ((orderLeftIdeal Φ hΦ hΦs a N).smul_mem b hy) (hM _ hx)

/-- The representation of `U(ĝ_pol) / (ι K - a)` on `U_pol / I_N^pol` by left multiplication,
as a representation of the polynomial residue central extension. -/
private abbrev quotientLieHom (N : ℤ) :
    ofTwoCocycle cP →ₗ⁅R⁆ Module.End R (UP ⧸ loopOrderLeftIdeal Φ hΦ hΦs a N) :=
  (Algebra.lsmul R R (UP ⧸ loopOrderLeftIdeal Φ hΦ hΦs a N)).toLieHom.comp
    (CentralQuotient.ι (centralElement cP) a)

/-- A polynomial current acts on `U_pol / I_N^pol` by left multiplication with its generator. -/
private theorem quotientLieHom_current_mk (N : ℤ) (p : P) (b : UP) :
    ((quotientLieHom (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) N).toLinearMap ∘ₗ
      LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP) p
      (Submodule.Quotient.mk b) = Submodule.Quotient.mk (envelopingι cP a p * b) := by
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.inl_apply,
    coe_ofProdLinearEquiv, LieHom.coe_toLinearMap]
  rw [envelopingι_apply, ← smul_eq_mul, Submodule.Quotient.mk_smul, quotientLieHom,
    LieHom.comp_apply, AlgHom.toLieHom_apply, Algebra.lsmul_apply]

/-- The action of the polynomial currents on `U_pol / I_N^pol` is smooth, by the polynomial
right-shift estimate. -/
private theorem isLoopSmooth_quotientLieHom (N : ℤ) :
    IsLoopSmooth ((quotientLieHom (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) N).toLinearMap ∘ₗ
      LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP) := by
  refine isLoopSmooth_iff.2 fun m ↦ ?_
  obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  obtain ⟨M, hM⟩ := exists_forall_mul_mem_loopOrderLeftIdeal Φ hΦ hΦs a b N
  refine ⟨M, fun p hp ↦ ?_⟩
  rw [quotientLieHom_current_mk, Submodule.Quotient.mk_eq_zero]
  exact hM _ (envelopingι_mem_loopOrderLeftIdeal hp)

/-- The action of `U(ĝ) / (ι K - a)` on `U_pol / I_N^pol` extending the action of `U_pol` by
finite truncation of formal currents. -/
private def quotientAction (N : ℤ) :
    UK →ₐ[R] Module.End R (UP ⧸ loopOrderLeftIdeal Φ hΦ hΦs a N) :=
  extendEnvelopingAction Φ hΦ hΦs a (isLoopSmooth_quotientLieHom N)

/-- On the image of `U_pol`, the extended action is the action of `U_pol`. -/
private theorem quotientAction_loopEnvelopingHom (N : ℤ) (x : UP) :
    quotientAction (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) N (loopEnvelopingHom Φ hΦ hΦs a x) =
      Algebra.lsmul R R _ x := by
  exact extendEnvelopingAction_loopEnvelopingHom Φ hΦ hΦs a _ x

/-- The formal currents of order at least `N` kill the class of `1` in `U_pol / I_N^pol`, so the
whole left ideal `I_N` does. -/
private theorem quotientAction_apply_mk_one {N : ℤ} {y : UK}
    (hy : y ∈ orderLeftIdeal Φ hΦ hΦs a N) :
    quotientAction (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) N y
      (Submodule.Quotient.mk 1) = 0 := by
  rw [orderLeftIdeal_def] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
    -- Such a current acts through its truncation below `N`, which is zero.
    obtain ⟨u, hu, rfl⟩ := hy
    have hN (n : ℤ) (hn : N ≤ n) (x : L) :
        ((quotientLieHom (Φ := Φ) (hΦ := hΦ) (hΦs := hΦs) (a := a) N).toLinearMap ∘ₗ
          LinearEquiv.toLinearMap (ofProdLinearEquiv cP) ∘ₗ LinearMap.inl R P ZP)
            (AddMonoidAlgebra.single n 1 ⊗ₜ x) (Submodule.Quotient.mk 1) = 0 := by
      rw [quotientLieHom_current_mk, mul_one, Submodule.Quotient.mk_eq_zero]
      exact envelopingι_mem_loopOrderLeftIdeal
        (orderSubmodule_antitone R L hn (ofLoop_single_tmul_mem_orderSubmodule R L n x))
    dsimp only [quotientLieHom] at hN
    rw [quotientAction, extendEnvelopingAction_envelopingι,
      extendAction_apply_of_forall _ _ hN, trunc_eq_zero_of_mem_orderSubmodule R L hu]
    simp
  | zero => simp
  | add y z _ _ hy hz => simp [hy, hz]
  | smul r y _ hy => simp [mul_apply_eq_comp, hy]

/-- **The preimage of `I_N` in `U_pol` is `I_N^pol`.** An element of `U(ĝ_pol) / (ι K - a)` lies in
`I_N^pol` exactly when its image in `U(ĝ) / (ι K - a)` lies in `I_N`. -/
@[simp]
theorem loopEnvelopingHom_mem_orderLeftIdeal_iff {N : ℤ} {x : UP} :
    loopEnvelopingHom Φ hΦ hΦs a x ∈ orderLeftIdeal Φ hΦ hΦs a N ↔
      x ∈ loopOrderLeftIdeal Φ hΦ hΦs a N := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ loopOrderLeftIdeal_le_comap N hx⟩
  have h := quotientAction_apply_mk_one hx
  rwa [quotientAction_loopEnvelopingHom, Algebra.lsmul_apply, ← Submodule.Quotient.mk_smul,
    smul_eq_mul, mul_one, Submodule.Quotient.mk_eq_zero] at h

variable (Φ hΦ hΦs a) in
/-- **The preimage of `I_N` in `U_pol` is `I_N^pol`.** -/
theorem comap_loopEnvelopingHom_orderLeftIdeal (N : ℤ) :
    Ideal.comap (loopEnvelopingHom Φ hΦ hΦs a) (orderLeftIdeal Φ hΦ hΦs a N) =
      loopOrderLeftIdeal Φ hΦ hΦs a N :=
  Submodule.ext fun _ ↦ loopEnvelopingHom_mem_orderLeftIdeal_iff

variable (Φ hΦ hΦs a) in
/-- The map `U_pol / I_N^pol → U / I_N` induced by `U_pol → U`. It is semilinear along
`U_pol → U`. -/
def loopOrderQuotientMap (N : ℤ) :
    UP ⧸ loopOrderLeftIdeal Φ hΦ hΦs a N →ₛₗ[(loopEnvelopingHom Φ hΦ hΦs a).toRingHom]
      UK ⧸ orderLeftIdeal Φ hΦ hΦs a N :=
  Submodule.mapQ _ _ (loopEnvelopingHom Φ hΦ hΦs a).toRingHom.toSemilinearMap fun _ hx ↦
    loopOrderLeftIdeal_le_comap N hx

/-- The map `U_pol / I_N^pol → U / I_N` sends the class of `x` to the class of its image. -/
@[simp]
theorem loopOrderQuotientMap_mk (N : ℤ) (x : UP) :
    loopOrderQuotientMap Φ hΦ hΦs a N (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (loopEnvelopingHom Φ hΦ hΦs a x) :=
  (rfl)

/-- **The polynomial and formal stages agree.** The map `U_pol / I_N^pol → U / I_N` induced by
`U_pol → U` is bijective. -/
theorem loopOrderQuotientMap_bijective (N : ℤ) :
    Function.Bijective (loopOrderQuotientMap Φ hΦ hΦs a N) := by
  refine ⟨fun x y hxy ↦ ?_, fun z ↦ ?_⟩
  · obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [loopOrderQuotientMap_mk, loopOrderQuotientMap_mk, Submodule.Quotient.eq, ← map_sub,
      loopEnvelopingHom_mem_orderLeftIdeal_iff] at hxy
    exact (Submodule.Quotient.eq _).2 hxy
  · obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    obtain ⟨x, hx⟩ := exists_sub_loopEnvelopingHom_mem_orderLeftIdeal Φ hΦ hΦs a b N
    refine ⟨Submodule.Quotient.mk x, ?_⟩
    rw [loopOrderQuotientMap_mk, Submodule.Quotient.eq, ← neg_mem_iff, neg_sub]
    exact hx

/-- The comparison maps commute with the transition maps `U_pol / I_M^pol → U_pol / I_N^pol` and
`U / I_M → U / I_N` for `N ≤ M`. -/
theorem factor_loopOrderQuotientMap {M N : ℤ} (h : N ≤ M)
    (x : UP ⧸ loopOrderLeftIdeal Φ hΦ hΦs a M) :
    Submodule.factor (orderLeftIdeal_antitone Φ hΦ hΦs a h) (loopOrderQuotientMap Φ hΦ hΦs a M x) =
      loopOrderQuotientMap Φ hΦ hΦs a N
        (Submodule.factor (loopOrderLeftIdeal_antitone Φ hΦ hΦs a h) x) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rfl

end Comparison

