module

public import TauCeti.Algebra.Category.ModuleCat.Tower.Quotient
public import TauCeti.Algebra.Lie.Current.LeftIdeal

/-!
# The completed enveloping algebra of a residue central extension at a fixed level

Let `ĝ = L((t)) ⊕ R K` be the residue central extension of an invariant symmetric form `Φ`, let
`U = U(ĝ) / (ι K - a)` be its enveloping algebra at the central value `a`, and let
`I_N = U · ι(L ⊗ tᴺ R[[t]])` be the left ideals of high-order currents
(`TauCeti.CurrentAlgebra.orderLeftIdeal`). The *completed enveloping algebra*

`Û = lim_N U / I_N`

is the limit of the tower of left `U`-modules `Q_N = U / I_N` (`N ≥ 0`), with the quotient maps
`Q_M → Q_N` as transitions (`TauCeti.CurrentAlgebra.orderQuotientTower`), that is, the module of
compatible families `(b_N)` with `b_N ∈ Q_N`. Since the `I_N` are only left ideals, `Û` is here a
left `U`-module. The orders `N ≥ 0` are cofinal among all integers, so including `Q_0` does not
change the limit.

The general theory of quotient towers in `TauCeti.Algebra.Category.ModuleCat.Tower.Quotient` gives
`Û` the inverse limit topology of the discrete modules `Q_N`, for which it is complete and
Hausdorff, the kernels of the projections `Û → Q_N` form a basis of neighbourhoods of zero, `U`
acts continuously, and the canonical map `U → Û` (`TauCeti.ModuleTower.toLim`) has dense range and
kernel `⋂_N I_N`.

The basic example of an element of `Û` which does not come from `U` is a series
`∑_N P_N ι(u_N)` with `P_N ∈ U` arbitrary and `u_N` a current of order at least `N`, for instance
the mode `A_N ⊗ t^N` of an element `A_N ∈ L`: its `N`-th term lies in `I_N`, so the series
converges, and its image in `Q_n` is the finite partial sum over `N < n`
(`TauCeti.CurrentAlgebra.limπ_tsum_mul_envelopingι`). No norm or other bound on the `P_N` is
needed. Hence such a series acts on every vector of a smooth module through a finite partial sum.

## Main definitions

* `TauCeti.CurrentAlgebra.orderQuotientTower`: the tower of left `U`-modules `U / I_N`.
* `TauCeti.CurrentAlgebra.CompletedEnveloping`: its limit `Û = lim_N U / I_N`.

## Main results

* `TauCeti.CurrentAlgebra.summable_mul_envelopingι`: the series `∑_N P_N ι(u_N)` converges in
  `Û` when `u_N` has order at least `N`.
* `TauCeti.CurrentAlgebra.limπ_tsum_mul_envelopingι`: its image in `U / I_n` is the partial sum
  over `N < n`.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the completion
  `lim_N U / I_N` of the enveloping algebra of an affine Kac--Moody algebra at a fixed level, and
  the series `P₀ + ∑_{N ≥ 1} P_N A_N ⊗ t^N` as an example of its elements.
-/

public section

noncomputable section

open scoped LaurentSeries
open LieAlgebra TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 1100] HahnSeries.instAlgebra
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "C" => currentAlgebra R L

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "UK" => CentralQuotient R (centralElement Φ hΦ hΦs) a

/-- The left ideals `I_N`, `N ≥ 0`, decrease as `N` grows. -/
theorem antitone_orderLeftIdeal_natCast :
    Antitone fun N : ℕ ↦ orderLeftIdeal Φ hΦ hΦs a N :=
  fun _ _ h ↦ orderLeftIdeal_antitone Φ hΦ hΦs a (Int.ofNat_le.2 h)

/-- The tower `U / I_0 ← U / I_1 ← U / I_2 ← ⋯` of left modules over the enveloping algebra
`U = U(ĝ) / (ι K - a)`, where `I_N` is the left ideal generated by the currents of order at least
`N`, with the quotient maps as transitions. -/
abbrev orderQuotientTower : ModuleTower UK :=
  ModuleTower.quotient _ (antitone_orderLeftIdeal_natCast Φ hΦ hΦs a)

/-- The **completed enveloping algebra** `Û = lim_N U / I_N` of the residue central extension of
`Φ` at the central value `a`: the left `U`-module of compatible families of classes modulo the left
ideals `I_N` of high-order currents, with its inverse limit topology. -/
abbrev CompletedEnveloping : Type _ :=
  (orderQuotientTower Φ hΦ hΦs a).lim

/-- The canonical map `U → Û` from the enveloping algebra to its completion. -/
abbrev toCompletedEnveloping : UK →ₗ[UK] CompletedEnveloping Φ hΦ hΦs a :=
  ModuleTower.toLim _ (antitone_orderLeftIdeal_natCast Φ hΦ hΦs a)

variable {Φ hΦ hΦs a}

/-- **The high-order series converge.** If `u_N` is a current of order at least `N` for every `N`,
then for arbitrary `P_N ∈ U` the series `∑_N P_N ι(u_N)` converges in the completed enveloping
algebra. -/
theorem summable_mul_envelopingι (P : ℕ → UK) {u : ℕ → C}
    (hu : ∀ N : ℕ, u N ∈ orderSubmodule R L N) :
    Summable fun N ↦ toCompletedEnveloping Φ hΦ hΦs a (P N * envelopingι Φ hΦ hΦs a (u N)) :=
  ModuleTower.summable_toLim _ _ fun N ↦
    (orderLeftIdeal Φ hΦ hΦs a N).smul_mem (P N) (envelopingι_mem_orderLeftIdeal (hu N))

/-- The sum of a high-order series `∑_N P_N ι(u_N)`, with `u_N` of order at least `N`, projects to
the class of the partial sum over `N < n` in `U / I_n`. -/
theorem limπ_tsum_mul_envelopingι (P : ℕ → UK) {u : ℕ → C}
    (hu : ∀ N : ℕ, u N ∈ orderSubmodule R L N) (n : ℕ) :
    (orderQuotientTower Φ hΦ hΦs a).limπ n
        (∑' N, toCompletedEnveloping Φ hΦ hΦs a (P N * envelopingι Φ hΦ hΦs a (u N))) =
      ModuleTower.quotientπ _ (antitone_orderLeftIdeal_natCast Φ hΦ hΦs a) n
        (∑ N ∈ Finset.range n, P N * envelopingι Φ hΦ hΦs a (u N)) :=
  ModuleTower.limπ_tsum_toLim _ _ (fun N ↦
    (orderLeftIdeal Φ hΦ hΦs a N).smul_mem (P N) (envelopingι_mem_orderLeftIdeal (hu N))) n

/-- **The source example.** For arbitrary `P_N ∈ U` and `A_N ∈ L`, the series
`∑_N P_N ι(A_N ⊗ t^N)` converges in the completed enveloping algebra. -/
theorem summable_mul_envelopingι_mode (P : ℕ → UK) (A : ℕ → L) :
    Summable fun N : ℕ ↦ toCompletedEnveloping Φ hΦ hΦs a
      (P N * envelopingι Φ hΦ hΦs a (ofLoop R L (AddMonoidAlgebra.single (N : ℤ) 1 ⊗ₜ A N))) :=
  summable_mul_envelopingι P fun N ↦ ofLoop_single_tmul_mem_orderSubmodule R L N (A N)

end TauCeti.CurrentAlgebra
