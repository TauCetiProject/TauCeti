module

public import Mathlib.CategoryTheory.ObjectProperty.Equivalence
public import TauCeti.Algebra.Category.ModuleCat.Tower.SmoothEquivalence
public import TauCeti.Algebra.Lie.Current.Completion

/-!
# Smooth modules over a level enveloping algebra are modules over its completion

Let `ĝ = L((t)) ⊕ R K` be the residue central extension of an invariant symmetric form `Φ`, let
`U = U(ĝ) / (ι K - a)` be its enveloping algebra at the central value `a`, let
`I_N = U · ι(a_N)` be the left ideal generated by the currents of order at least `N`
(`TauCeti.CurrentAlgebra.orderLeftIdeal`), and let `Û = lim_n U / I_n` be the completed enveloping
algebra (`TauCeti.CurrentAlgebra.CompletedEnveloping`). A `U`-module is smooth when every vector is
killed by all currents of some order (`TauCeti.CurrentAlgebra.smoothModules_orderLeftIdeal_iff`);
at `a = 1` these are the smooth `ĝ`-modules on which `K` acts by `1`.

This file proves that the smooth `U`-modules are the same as the discrete `Û`-modules, those on
which every orbit map `x ↦ x • m` of `Û` is continuous for the discrete topology on the module
(`TauCeti.CurrentAlgebra.smoothModulesEquivalence`). It is the equivalence
`TauCeti.ModuleTower.smoothModulesEquivalence` for the left ideals `I_n` of natural orders, which
satisfy the right-shift estimate `I_m b ⊆ I_n`. Smoothness for the left ideals of natural orders is
the same as smoothness for all the `I_N`
(`TauCeti.CurrentAlgebra.smoothModules_orderLeftIdeal_natCast`), since the natural numbers are
cofinal among the orders.

The functor extends the action of `U` to `Û` without changing the underlying abelian group, a point
of `Û` acting on a vector killed by `I_n` as a representative of its `n`-th coordinate
(`TauCeti.CurrentAlgebra.smoothModulesEquivalence_functor_obj_smul`). Its inverse restricts the
action of `Û` along the canonical map `U → Û`
(`TauCeti.CurrentAlgebra.smoothModulesEquivalence_inverse_obj_smul`). Everything holds over any
commutative ring and for every central value `a`, including `a = 0`, without finiteness of `L`.

## Main definitions

* `TauCeti.CurrentAlgebra.smoothModulesEquivalence`: smooth `U`-modules are equivalent to
  discrete `Û`-modules.

## Main results

* `TauCeti.CurrentAlgebra.smoothModulesEquivalence_functor_obj_smul`: the action of `Û` on the
  image of a smooth module.
* `TauCeti.CurrentAlgebra.smoothModulesEquivalence_inverse_obj_smul`: the action of `U` on the
  restriction of a discrete `Û`-module.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the equivalence
  between smooth modules over an affine Kac--Moody algebra at a fixed level and discrete modules
  over its completed enveloping algebra.
-/

public section

noncomputable section

open CategoryTheory TauCeti.UniversalEnvelopingAlgebra


namespace TauCeti.CurrentAlgebra

universe v

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

/-- **Smooth modules over a level enveloping algebra are the discrete modules over its
completion.** The category of `U(ĝ) / (ι K - a)`-modules on which every vector is killed by the
currents of some order is equivalent to the category of discrete modules over the completed
enveloping algebra `Û = lim_n U / I_n`. The functor extends the action of `U` to `Û` on the same
underlying abelian group, and its inverse restricts the action along `U → Û`. -/
@[expose]
def smoothModulesEquivalence :
    (smoothModules.{v} (orderLeftIdeal Φ hΦ hΦs a)).FullSubcategory ≌
      (discreteModules.{v} (CompletedEnveloping Φ hΦ hΦs a)).FullSubcategory :=
  (CategoryTheory.Equivalence.congrFullSubcategory CategoryTheory.Equivalence.refl
    (smoothModules_orderLeftIdeal_natCast Φ hΦ hΦs a)).trans
    (ModuleTower.smoothModulesEquivalence (exists_forall_mul_mem_orderLeftIdeal_natCast Φ hΦ hΦs a))

variable {Φ hΦ hΦs a}

/-- The completed enveloping algebra acts on the image of a smooth module through
`TauCeti.ModuleTower.limSmul`: a point acts on a vector killed by `I_n` as any representative of its
`n`-th coordinate (`TauCeti.ModuleTower.limSmul_eq_smul`). -/
theorem smoothModulesEquivalence_functor_obj_smul
    (M : (smoothModules.{v} (orderLeftIdeal Φ hΦ hΦs a)).FullSubcategory)
    (x : CompletedEnveloping Φ hΦ hΦs a)
    (m : ((smoothModulesEquivalence Φ hΦ hΦs a).functor.obj M).obj) :
    x • m = ModuleTower.limSmul ((smoothModules_orderLeftIdeal_natCast Φ hΦ hΦs a).ge _ M.property)
      x m :=
  (rfl)

/-- The level enveloping algebra acts on the restriction of a discrete module over its completion
through the canonical map `U → Û`. -/
theorem smoothModulesEquivalence_inverse_obj_smul
    (M : (discreteModules.{v} (CompletedEnveloping Φ hΦ hΦs a)).FullSubcategory)
    (b : CentralQuotient R (centralElement Φ hΦ hΦs) a)
    (m : ((smoothModulesEquivalence Φ hΦ hΦs a).inverse.obj M).obj) :
    b • m = toCompletedEnveloping Φ hΦ hΦs a b • show M.obj from m := by
  rw [coe_toCompletedEnveloping]
  exact ModuleTower.discreteModulesToSmooth_obj_smul
    (exists_forall_mul_mem_orderLeftIdeal_natCast Φ hΦ hΦs a) M b m

end TauCeti.CurrentAlgebra
