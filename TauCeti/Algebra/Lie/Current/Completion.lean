module

public import TauCeti.Algebra.Lie.Current.LeftIdeal
public import TauCeti.Topology.Algebra.Module.QuotientLimit

/-!
# The completed enveloping algebra of a residue central extension

Let `ĝ = L((t)) ⊕ R K` be the residue central extension of an invariant symmetric form `Φ`, let
`U = U(ĝ) / (ι K - a)` be its enveloping algebra at the central value `a`, and let
`I_N = U · ι(a_N)` be the left ideal generated by the currents of order at least `N`
(`TauCeti.CurrentAlgebra.orderLeftIdeal`). The *completed enveloping algebra* is the inverse limit

`Û = lim_N U / I_N`

of the left `U`-modules `U / I_N` (`TauCeti.CurrentAlgebra.completedEnveloping`), an instance of
the inverse limit `TauCeti.QuotientLimit` of quotient modules. At `a = 1` this is the completion
`Û_κ` of the level enveloping algebra of the form `κ = -Φ`. Since `I_N` is only a left ideal,
`U / I_N` is not a ring, and `Û` is constructed here as a left `U`-module; it is not an inverse
limit of rings.

From the general theory of `TauCeti.QuotientLimit`, `Û` is a complete Hausdorff left `U`-module
whose coordinate topology is linear, the projections `U / I_N ← Û` are surjective, and the
canonical map `TauCeti.QuotientLimit.of` from `U` has dense range
(`TauCeti.QuotientLimit.denseRange_of` applied to
`TauCeti.CurrentAlgebra.orderLeftIdeal_antitone`) with kernel `⨅ N, I_N`
(`TauCeti.QuotientLimit.ker_of`). The positive orders suffice for the neighbourhoods of zero
(`TauCeti.CurrentAlgebra.hasBasis_nhds_zero_completedEnveloping`).

Series converge in `Û` as soon as their terms lie in deeper and deeper left ideals, with no bound
on their coefficients. In particular, for arbitrary `P_N ∈ U` and `A_N ∈ L`, the series
`∑_N P_N · (A_N ⊗ tᴺ)` converges in `Û`, since its `N`-th term lies in `I_N`
(`TauCeti.CurrentAlgebra.summable_mul_envelopingι_single_tmul`).

## Main definitions

* `TauCeti.CurrentAlgebra.completedEnveloping`: the completed enveloping algebra
  `lim_N U / I_N`, as a left `U`-module.

## Main results

* `TauCeti.CurrentAlgebra.hasBasis_nhds_zero_completedEnveloping`: the kernels of the projections
  onto `U / I_N` for `N > 0` form a basis of neighbourhoods of zero.
* `TauCeti.CurrentAlgebra.summable_mul_envelopingι`: series whose terms are multiples of currents
  of orders tending to infinity converge.
* `TauCeti.CurrentAlgebra.summable_mul_envelopingι_single_tmul`: the series
  `∑_N P_N · (A_N ⊗ tᴺ)` converges.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the completion
  `lim_N U / I_N` of the enveloping algebra of an affine Kac--Moody algebra at a fixed level and
  the convergence of its series.
-/

public section

noncomputable section

open Filter Topology
open scoped LaurentSeries TensorProduct
open LieAlgebra TauCeti.UniversalEnvelopingAlgebra

attribute [local instance 1100] HahnSeries.instAlgebra
attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti.CurrentAlgebra

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

local notation "C" => currentAlgebra R L

variable (Φ : LinearMap.BilinForm R L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : R)

local notation "UK" => CentralQuotient R (centralElement Φ hΦ hΦs) a

/-- The completed enveloping algebra `lim_N U / I_N` of `U = U(ĝ) / (ι K - a)`, the inverse limit
of the quotients of the left regular `U`-module by the left ideals `I_N` generated by the currents
of order at least `N`. It is a left `U`-module with the coordinate topology. -/
abbrev completedEnveloping : Type _ :=
  QuotientLimit (orderLeftIdeal Φ hΦ hΦs a)

/-- The kernels of the projections of the completed enveloping algebra onto the quotients `U / I_N`
with `N > 0` form a basis of neighbourhoods of zero. -/
theorem hasBasis_nhds_zero_completedEnveloping :
    (𝓝 (0 : completedEnveloping Φ hΦ hΦs a)).HasBasis (fun N : ℤ ↦ 0 < N)
      fun N ↦ (LinearMap.ker (QuotientLimit.eval (orderLeftIdeal Φ hΦ hΦs a) N) :
        Set (completedEnveloping Φ hΦ hΦs a)) := by
  have h := (QuotientLimit.hasBasis_nhds_zero (orderLeftIdeal_antitone Φ hΦ hΦs a)).restrict
    (q := fun N : ℤ ↦ 0 < N) fun N _ ↦ ⟨max N 1, trivial, by omega, fun x hx ↦ by
      simpa using QuotientLimit.eval_eq_of_le (orderLeftIdeal_antitone Φ hΦ hΦs a)
        (le_max_left N 1) (y := 0) (by simpa using hx)⟩
  simpa using h

variable {Φ hΦ hΦs a}

/-- A series in the completed enveloping algebra whose terms are left multiples `P i · u i` of
currents `u i` of orders `n i` tending to infinity converges, whatever the coefficients `P i ∈ U`.
-/
theorem summable_mul_envelopingι {α : Type*} {n : α → ℤ} (hn : Tendsto n cofinite atTop)
    (P : α → UK) {u : α → C} (hu : ∀ i, u i ∈ orderSubmodule R L (n i)) :
    Summable fun i ↦
      QuotientLimit.of (orderLeftIdeal Φ hΦ hΦs a) (P i * envelopingι Φ hΦ hΦs a (u i)) :=
  QuotientLimit.summable_of fun N ↦ (tendsto_atTop.mp hn N).mono fun i hi ↦
    (orderLeftIdeal Φ hΦ hΦs a N).smul_mem (P i)
      (envelopingι_mem_orderLeftIdeal (orderSubmodule_antitone R L hi (hu i)))

/-- For arbitrary `P_N ∈ U` and `A_N ∈ L`, the series `∑_N P_N · (A_N ⊗ tᴺ)` converges in the
completed enveloping algebra: its `N`-th term lies in `I_N`. -/
theorem summable_mul_envelopingι_single_tmul (P : ℕ → UK) (A : ℕ → L) :
    Summable fun N : ℕ ↦ QuotientLimit.of (orderLeftIdeal Φ hΦ hΦs a)
      (P N * envelopingι Φ hΦ hΦs a (HahnSeries.single (N : ℤ) (1 : R) ⊗ₜ A N)) :=
  summable_mul_envelopingι (n := fun N : ℕ ↦ (N : ℤ))
    ((tendsto_atTop_atTop.mpr fun N ↦ ⟨N.toNat, fun n hn ↦ by omega⟩).mono_left
      Nat.cofinite_eq_atTop.le) P
    fun N ↦ tmul_mem_orderSubmodule R L N HahnSeries.orderTop_single_le (A N)

end TauCeti.CurrentAlgebra
