module

public import TauCeti.Algebra.Lie.Current.Completion
public import TauCeti.Algebra.Lie.Current.CoordinateAction

/-!
# Coordinate changes on the completed enveloping algebra

Let `ĝ` be the residue central extension of the formal currents `L((t)) = K⸨X⸩ ⊗[K] L` of an
invariant symmetric form `Φ` over a field `K`, with central element `K`. Let
`U = U(ĝ) / (ι K - a)` be its enveloping algebra at the central value `a`, and let
`Û = lim_N U / I_N` be its completion along the left ideals `I_N = U · ι(a_N)` generated by the
currents of order at least `N` (`TauCeti.CurrentAlgebra.CompletedEnveloping`).

An algebra automorphism `σ` of `K⟦X⟧` acts on `U` by the algebra automorphism
`TauCeti.CurrentAlgebra.coordinateEnvelopingAut`, which substitutes `σ X` in the current
generators. Substitution preserves the order of currents, so this automorphism and its inverse
carry every `I_N` onto itself. This file extends it to the completion: `σ` acts on `Û` by an
algebra automorphism which is a homeomorphism
(`TauCeti.CurrentAlgebra.coordinateCompletedEnvelopingAut`).

* **Generators.** On the image of `U` in `Û` it is the action on `U`
  (`TauCeti.CurrentAlgebra.coordinateCompletedEnvelopingAut_toLimQuotients`); in particular it
  substitutes `σ X` in the image of every current. Its `n`-th coordinate is computed from any
  representative of the `n`-th coordinate of its argument
  (`TauCeti.CurrentAlgebra.limπ_coordinateCompletedEnvelopingAut`).
* **Group law.** The lifts form a group homomorphism from the automorphism group of `K⟦X⟧`, with
  its usual product `σ * τ = σ ∘ τ`, to the algebra automorphisms of `Û`. The inverse of the lift
  of `σ` is the lift of `σ⁻¹` (`TauCeti.CurrentAlgebra.coordinateCompletedEnvelopingAut_symm`), so
  it is also continuous.
* **Uniqueness.** A continuous algebra endomorphism of `Û` which substitutes `σ X` in the image of
  every current is the lift of `σ` (`TauCeti.CurrentAlgebra.eq_coordinateCompletedEnvelopingAut`).
  It is enough to check the currents because they generate `U`, and `U` has dense image in `Û`.
* **Left ideals.** The lift carries the kernel of each projection `Û → U / I_n` onto itself
  (`TauCeti.CurrentAlgebra.coordinateCompletedEnvelopingAut_mem_completedOrderLeftIdeal_iff`).
* **Levels.** If `Ψ = k • Φ`, the completed level comparison
  `TauCeti.CurrentAlgebra.levelCompletedEnvelopingEquiv`, from the completion of
  `U(ĝ_Ψ) / (ι K - 1)` to that of `U(ĝ_Φ) / (ι K - k)`, intertwines the lifts, for every `k`,
  including `k = 0`
  (`TauCeti.CurrentAlgebra.levelCompletedEnvelopingEquiv_coordinateCompletedEnvelopingAut`).

Every statement holds for every central value `a`, including `a = 0`, and needs no
finite-dimensionality of `L`.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the completion
  `lim_N U / I_N`, and for the action of the group `Aut O` of coordinate changes on the affine
  Kac--Moody algebra and its completed enveloping algebras.
-/

public section

noncomputable section

open scoped LaurentSeries
open PowerSeries TauCeti.UniversalEnvelopingAlgebra
open LieAlgebra.ofTwoCocycle (centralElement envelopingι algHom_ext_envelopingι)

namespace TauCeti.CurrentAlgebra

variable {K L : Type*} [Field K] [LieRing L] [LieAlgebra K L]

section Aut

variable (Φ : LinearMap.BilinForm K L) (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm) (a : K)

local notation "c" => twoCocycleOfBilinear K L Φ hΦ hΦs
local notation "UK" => CentralQuotient K (centralElement c) a

/-- The lift of a coordinate change to `U` carries the currents of order `n` into `I_n`. -/
private theorem coordinateEnvelopingAut_envelopingι_mem (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (n : ℕ) :
    ∀ u ∈ orderSubmodule K L n,
      coordinateEnvelopingAut Φ hΦ hΦs a σ (envelopingι c a u) ∈
        orderLeftIdeal Φ hΦ hΦs a n :=
  fun _ hu ↦ by
    rw [coordinateEnvelopingAut_envelopingι]
    exact envelopingι_mem_orderLeftIdeal (substLieEquiv_mem_orderSubmodule _ hu)

/-- The inverse of the lift of a coordinate change to `U` carries the currents of order `n` into
`I_n`. -/
private theorem coordinateEnvelopingAut_symm_envelopingι_mem (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (n : ℕ) :
    ∀ u ∈ orderSubmodule K L n,
      (coordinateEnvelopingAut Φ hΦ hΦs a σ).symm (envelopingι c a u) ∈
        orderLeftIdeal Φ hΦ hΦs a n :=
  fun _ hu ↦ (coordinateEnvelopingAut_mem_orderLeftIdeal_iff σ).mp
    (by
      rw [AlgEquiv.apply_symm_apply]
      exact envelopingι_mem_orderLeftIdeal hu)

/-- **Coordinate changes on the completed enveloping algebra.** An algebra automorphism `σ` of
`K⟦X⟧` acts on the completion `Û = lim_n U / I_n` of `U = U(ĝ) / (ι K - a)` by the continuous
extension of the automorphism `TauCeti.CurrentAlgebra.coordinateEnvelopingAut` of `U`, which
substitutes `σ X` in the current generators. These extensions form a group homomorphism for the
product `σ * τ = σ ∘ τ`, and each of them is a homeomorphism
(`TauCeti.CurrentAlgebra.continuous_coordinateCompletedEnvelopingAut`,
`TauCeti.CurrentAlgebra.coordinateCompletedEnvelopingAut_symm`). -/
def coordinateCompletedEnvelopingAut :
    (K⟦X⟧ ≃ₐ[K] K⟦X⟧) →* (CompletedEnveloping Φ hΦ hΦs a ≃ₐ[K] CompletedEnveloping Φ hΦ hΦs a) where
  toFun σ := completedEnvelopingEquiv (coordinateEnvelopingAut Φ hΦ hΦs a σ)
    (fun n ↦ ⟨n, coordinateEnvelopingAut_envelopingι_mem Φ hΦ hΦs a σ n⟩)
    (fun n ↦ ⟨n, coordinateEnvelopingAut_symm_envelopingι_mem Φ hΦ hΦs a σ n⟩)
  -- Both sides are continuous and agree on the dense image of `U`.
  map_one' := AlgEquiv.ext <| congrFun <|
    (ModuleTower.denseRange_toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)).equalizer
      (continuous_completedEnvelopingEquiv _ _ _) continuous_id (funext fun x ↦ by simp)
  map_mul' σ τ := AlgEquiv.ext <| congrFun <|
    (ModuleTower.denseRange_toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)).equalizer
      (continuous_completedEnvelopingEquiv _ _ _)
      ((continuous_completedEnvelopingEquiv _ _ _).comp (continuous_completedEnvelopingEquiv _ _ _))
      (funext fun x ↦ by simp)

/-- The lift of `σ` to the completion extends its lift to `U`, along the canonical map `U → Û`
(`TauCeti.CurrentAlgebra.toCompletedEnveloping`, in the simp normal form
`TauCeti.ModuleTower.toLimQuotients`). In particular it substitutes `σ X` in the image of every
current. -/
@[simp]
theorem coordinateCompletedEnvelopingAut_toLimQuotients (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (x : UK) :
    coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ
        (ModuleTower.toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) x) =
      ModuleTower.toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)
        (coordinateEnvelopingAut Φ hΦ hΦs a σ x) :=
  completedEnvelopingEquiv_toLimQuotients _ _ _ x

variable {Φ hΦ hΦs a}

/-- The coordinates of the lift of `σ`: the `n`-th coordinate of the image of `x` is the class of
`σ̂ y` for any representative `y` of the `n`-th coordinate of `x`. -/
theorem limπ_coordinateCompletedEnvelopingAut (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧)
    {x : CompletedEnveloping Φ hΦ hΦs a} {n : ℕ} {y : UK}
    (hy : ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n y =
      (orderQuotientTower Φ hΦ hΦs a).limπ n x) :
    (orderQuotientTower Φ hΦ hΦs a).limπ n (coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ x) =
      ModuleTower.quotientsπ _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a) n
        (coordinateEnvelopingAut Φ hΦ hΦs a σ y) :=
  have hg : ∀ m : ℕ, ∃ m' : ℕ, ∀ u ∈ orderSubmodule K L m',
      (coordinateEnvelopingAut Φ hΦ hΦs a σ : UK →ₐ[K] UK) (envelopingι c a u) ∈
        orderLeftIdeal Φ hΦ hΦs a m :=
    fun m ↦ ⟨m, coordinateEnvelopingAut_envelopingι_mem Φ hΦ hΦs a σ m⟩
  -- The lift of `σ` is by definition the extension `completedEnvelopingEquiv` of its lift to `U`.
  (congrArg _ (AlgHom.congr_fun (completedEnvelopingEquiv_toAlgHom _ _ _) x)).trans
    (limπ_completedEnvelopingMap _ hg (coordinateEnvelopingAut_envelopingι_mem Φ hΦ hΦs a σ n) hy)

theorem continuous_coordinateCompletedEnvelopingAut (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) :
    Continuous (coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ) :=
  continuous_completedEnvelopingEquiv _ _ _

/-- The inverse of the lift of `σ` to the completion is the lift of `σ⁻¹`. -/
theorem coordinateCompletedEnvelopingAut_symm (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) :
    (coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ).symm =
      coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ⁻¹ := by
  rw [map_inv, AlgEquiv.aut_inv]

/-- **Coordinate changes preserve the completed left ideals.** The lift of `σ` carries the kernel
of the projection `Û → U / I_n` onto itself. -/
theorem coordinateCompletedEnvelopingAut_mem_completedOrderLeftIdeal_iff (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧)
    {n : ℕ} {x : CompletedEnveloping Φ hΦ hΦs a} :
    coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ x ∈ completedOrderLeftIdeal Φ hΦ hΦs a n ↔
      x ∈ completedOrderLeftIdeal Φ hΦ hΦs a n :=
  completedEnvelopingEquiv_mem_completedOrderLeftIdeal_iff _ _ _
    (coordinateEnvelopingAut_envelopingι_mem Φ hΦ hΦs a σ n)
    (coordinateEnvelopingAut_symm_envelopingι_mem Φ hΦ hΦs a σ n)

/-- **Uniqueness of the lift.** A continuous algebra endomorphism of the completion which
substitutes `σ X` in the image of every current is the lift of `σ`. -/
theorem eq_coordinateCompletedEnvelopingAut {σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧}
    {φ : CompletedEnveloping Φ hΦ hΦs a →ₐ[K] CompletedEnveloping Φ hΦ hΦs a} (hφ : Continuous φ)
    (h : ∀ u : currentAlgebra K L,
      φ (toCompletedEnveloping Φ hΦ hΦs a (envelopingι c a u)) =
        toCompletedEnveloping Φ hΦ hΦs a
          (envelopingι c a (substLieEquiv (FormalCoordinate.ofAlgEquiv σ) u))) :
    φ = (coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ : _ →ₐ[K] _) := by
  -- The two algebra maps `U → Û` obtained by composing with `U → Û` agree on the generators.
  have hU := algHom_ext_envelopingι c a
    (g₁ := φ.comp (toCompletedEnveloping Φ hΦ hΦs a))
    (g₂ := (coordinateCompletedEnvelopingAut Φ hΦ hΦs a σ : _ →ₐ[K] _).comp
      (toCompletedEnveloping Φ hΦ hΦs a)) fun u ↦ by simpa using h u
  exact AlgHom.ext <| congrFun <|
    (ModuleTower.denseRange_toLimQuotients _ (orderLeftIdeal_natCast_antitone Φ hΦ hΦs a)).equalizer
      hφ (continuous_coordinateCompletedEnvelopingAut σ)
      (funext fun x ↦ by simpa using AlgHom.congr_fun hU x)

end Aut

section Level

variable {Φ Ψ : LinearMap.BilinForm K L} (hΦ : Φ.lieInvariant L) (hΦs : Φ.IsSymm)
  (hΨ : Ψ.lieInvariant L) (hΨs : Ψ.IsSymm) {k : K}

/-- **Coordinate changes commute with the completed level comparison.** If `Ψ = k • Φ`, the
isomorphism `TauCeti.CurrentAlgebra.levelCompletedEnvelopingEquiv` from the completion of
`U(ĝ_Ψ) / (ι K - 1)` to the completion of `U(ĝ_Φ) / (ι K - k)` intertwines the lifts of every
power-series algebra automorphism, for every `k`, including `k = 0`. -/
theorem levelCompletedEnvelopingEquiv_coordinateCompletedEnvelopingAut (h : Ψ = k • Φ)
    (σ : K⟦X⟧ ≃ₐ[K] K⟦X⟧) (x : CompletedEnveloping Ψ hΨ hΨs 1) :
    levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h
        (coordinateCompletedEnvelopingAut Ψ hΨ hΨs 1 σ x) =
      coordinateCompletedEnvelopingAut Φ hΦ hΦs k σ
        (levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h x) :=
  congrFun ((ModuleTower.denseRange_toLimQuotients _
    (orderLeftIdeal_natCast_antitone Ψ hΨ hΨs 1)).equalizer
      ((continuous_levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h).comp
        (continuous_coordinateCompletedEnvelopingAut σ))
      ((continuous_coordinateCompletedEnvelopingAut σ).comp
        (continuous_levelCompletedEnvelopingEquiv hΦ hΦs hΨ hΨs h))
      (funext fun y ↦ by simp [levelEnvelopingEquiv_coordinateEnvelopingAut])) x

end Level

end TauCeti.CurrentAlgebra
