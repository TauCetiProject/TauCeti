module

public import TauCeti.Algebra.Lie.Sl2.Classification
public import TauCeti.Algebra.Lie.Sl2.Spectrum
-- Non-public: `TauCeti.exists_isInternal_isIrreducible` and
-- `TauCeti.finrank_eq_sum_finrank_of_isInternal` appear only inside proofs, never in the type of
-- an exported declaration.
import TauCeti.Algebra.Lie.Submodule.Decomposition
import TauCeti.LinearAlgebra.Dimension.DirectSum

/-!
# Every finite-dimensional `sl₂`-module is a direct sum of the `V(n)`

`TauCeti/Algebra/Lie/Sl2/Spectrum.lean` proves that over *any* field of characteristic zero, the
Cartan element of an `sl₂` triple acts diagonalizably with integer eigenvalues on every
finite-dimensional module. Every nonzero finite-dimensional module therefore contains an
`h`-eigenvector, which `TauCeti.exists_hasPrimitiveVectorWith_pow_toEnd_e` raises to a primitive
vector of natural weight. This removes the algebraic-closure and triangularizability hypotheses from
both inputs of the `sl₂` decomposition:

* **Complete reducibility** (`TauCeti.exists_isCompl_of_toLieSubalgebra_eq_top_of_charZero`,
  `TauCeti.exists_isCompl_sl_fin_two_of_charZero`): every Lie submodule of a finite-dimensional
  module over a Lie algebra generated by an `sl₂` triple has a complement over any field of
  characteristic zero.
* **Classification of irreducibles**
  (`TauCeti.Sl2Std.existsUnique_nonempty_lieModuleEquiv_of_charZero`): the finite-dimensional
  irreducibles over `LieAlgebra.SpecialLinear.sl (Fin 2) K` are the standard modules
  `TauCeti.Sl2Std K n = V(n)`.

Joining the two via `TauCeti.exists_isInternal_isIrreducible` yields the decomposition itself:
every finite-dimensional `sl (Fin 2) K`-module over a field of characteristic zero is an internal
direct sum of standard modules `V(nᵢ)`.

## Main results

* `TauCeti.exists_hasPrimitiveVectorWith_of_charZero`: every nonzero finite-dimensional module over
  an `sl₂` triple in characteristic zero carries a primitive vector of natural weight.
* `TauCeti.exists_isCompl_of_toLieSubalgebra_eq_top_of_charZero` and
  `TauCeti.exists_isCompl_sl_fin_two_of_charZero`: complete reducibility over any field of
  characteristic zero.
* `TauCeti.Sl2Std.existsUnique_nonempty_lieModuleEquiv_of_charZero`: classification of
  finite-dimensional irreducibles over any field of characteristic zero.
* `TauCeti.Sl2Std.exists_isInternal_lieModuleEquiv`: **every finite-dimensional `sl₂`-module is
  `⨁ V(nᵢ)`**, over any field of characteristic zero.
* `TauCeti.Sl2Std.finrank_eq_sum`: the dimension of the module is `∑ᵢ (nᵢ + 1)`.

## References

* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §6.3 and §7.2.
-/

public section

namespace TauCeti

open LieModule Module

universe v

section CharZero

variable {K : Type*} [Field K] [CharZero K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {h e f : L}

variable (M : Type v) [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M] in
/-- **Existence of a primitive vector over any field of characteristic zero.** On a nonzero
finite-dimensional module over an `sl₂` triple, the eigenspaces of `h` span the module
(`TauCeti.iSup_eigenspace_toEnd_eq_top`), so some eigenspace is nonzero; raising any nonzero
eigenvector produces a primitive vector of natural weight. -/
theorem exists_hasPrimitiveVectorWith_of_charZero [FiniteDimensional K M] [Nontrivial M]
    (t : IsSl2Triple h e f) :
    ∃ (w : M) (n : ℕ), t.HasPrimitiveVectorWith w (n : K) := by
  have hne : (⨆ μ : K, (toEnd K L M h).eigenspace μ) ≠ ⊥ := by
    rw [iSup_eigenspace_toEnd_eq_top (M := M) t]
    exact top_ne_bot
  obtain ⟨μ, hμ⟩ : ∃ μ : K, (toEnd K L M h).eigenspace μ ≠ ⊥ := by
    by_contra! hbot
    exact hne (iSup_eq_bot.mpr hbot)
  obtain ⟨m, hm, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hμ
  obtain ⟨k, P⟩ := exists_hasPrimitiveVectorWith_pow_toEnd_e t
    (Module.End.mem_eigenspace_iff.mp hm) hm0
  obtain ⟨n, hn⟩ := P.exists_nat
  exact ⟨_, n, hn ▸ P⟩

private theorem sl2Casimir_injective_of_charZero {t : IsSl2Triple h e f}
    (htop : t.toLieSubalgebra K = ⊤) {M : Type v} [AddCommGroup M] [Module K M]
    [LieRingModule L M] [LieModule K L M] [FiniteDimensional K M] [LieModule.IsIrreducible K L M]
    (hact : ∃ (x : L) (v : M), ⁅x, v⁆ ≠ 0) :
    Function.Injective (sl2Casimir K h e f M) := by
  have : Nontrivial M := LieModule.nontrivial_of_isIrreducible K L M
  obtain ⟨w, n, P⟩ := exists_hasPrimitiveVectorWith_of_charZero (K := K) M t
  have hn : n ≠ 0 := by
    rintro rfl
    obtain ⟨x, v, hv⟩ := hact
    exact hv (lie_eq_zero_of_hasPrimitiveVectorWith_zero htop (by simpa using P) x v)
  have hw : sl2Casimir K h e f M w ≠ 0 := by
    rw [sl2Casimir_apply_of_hasPrimitiveVectorWith P]
    exact smul_ne_zero (sl2CasimirScalar_ne_zero hn) P.ne_zero
  have hker : (sl2CasimirHom t htop M).ker = ⊥ := by
    refine (IsSimpleOrder.eq_bot_or_eq_top _).resolve_right fun hcon ↦ hw ?_
    have : w ∈ (sl2CasimirHom t htop M).ker := hcon ▸ LieSubmodule.mem_top w
    simpa using this
  intro a b hab
  exact (LieModuleHom.ker_eq_bot _).1 hker (by simpa using hab)

/-- The Casimir step for complete reducibility over an arbitrary field of characteristic zero. -/
theorem hasInvariantOutsideIrreducible_of_toLieSubalgebra_eq_top_of_charZero
    {t : IsSl2Triple h e f} (htop : t.toLieSubalgebra K = ⊤) :
    HasInvariantOutsideIrreducible.{v} K L := by
  intro M _ _ _ _ _ N hN htriv hact hirr
  have hactN : ∃ (x : L) (z : N), ⁅x, z⁆ ≠ 0 := by
    by_contra hcon
    push Not at hcon
    obtain ⟨x, m, hm⟩ := hact
    refine hm (lie_eq_zero_of_lie_lie_eq_zero htop (fun y z w ↦ ?_) x m)
    have hval := congrArg (Subtype.val : N → M) (hcon y ⟨⁅z, w⁆, htriv z w⟩)
    rw [LieSubmodule.coe_bracket] at hval
    simpa using hval
  have hinjN := sl2Casimir_injective_of_charZero (M := N) htop hactN
  have hinj : ∀ w : M, w ∈ N → sl2Casimir K h e f M w = 0 → w = 0 := by
    intro w hw hw0
    have hz : (⟨w, hw⟩ : N) = 0 := by
      refine hinjN (Subtype.ext ?_)
      rw [coe_sl2Casimir_lieSubmodule]
      simpa using hw0
    exact congrArg Subtype.val hz
  have hrange : ∀ m : M, sl2Casimir K h e f M m ∈ N := fun m ↦ by
    rw [sl2Casimir_apply]
    exact N.add_mem (N.add_mem (N.lie_mem (htriv f m)) (N.lie_mem (htriv e m)))
      (N.smul_mem _ (N.lie_mem (htriv h m)))
  have hnotinj : ¬ Function.Injective (sl2Casimir K h e f M) := fun hi ↦ by
    refine hN ((LieSubmodule.toSubmodule_inj _ _).1 ?_)
    rw [LieSubmodule.top_toSubmodule, eq_top_iff]
    intro m _
    obtain ⟨w, rfl⟩ := LinearMap.injective_iff_surjective.1 hi m
    exact hrange w
  obtain ⟨v, hvmem, hv0⟩ := (Submodule.ne_bot_iff _).1
    (fun hc ↦ hnotinj (LinearMap.ker_eq_bot.1 hc))
  have hv : sl2Casimir K h e f M v = 0 := hvmem
  refine ⟨v, fun hc ↦ hv0 (hinj v hc hv), fun x ↦ hinj _ (htriv x v) ?_⟩
  rw [← lie_sl2Casimir t (htop ▸ LieSubalgebra.mem_top x) v, hv, lie_zero]

/-- **Complete reducibility for `sl₂` over any field of characteristic zero.** Every Lie submodule
of a finite-dimensional module over a Lie algebra generated by an `sl₂` triple has a complement. -/
theorem exists_isCompl_of_toLieSubalgebra_eq_top_of_charZero {t : IsSl2Triple h e f}
    (htop : t.toLieSubalgebra K = ⊤) {M : Type v} [AddCommGroup M] [Module K M]
    [LieRingModule L M] [LieModule K L M] [FiniteDimensional K M] (N : LieSubmodule K L M) :
    ∃ N' : LieSubmodule K L M, IsCompl N N' :=
  HasInvariantOutsideIrreducible.exists_isCompl
    (hasInvariantOutsideIrreducible_of_toLieSubalgebra_eq_top_of_charZero htop) N

/-- **Complete reducibility for `sl (Fin 2) K` over any field of characteristic zero.** -/
theorem exists_isCompl_sl_fin_two_of_charZero {M : Type v} [AddCommGroup M] [Module K M]
    [LieRingModule (LieAlgebra.SpecialLinear.sl (Fin 2) K) M]
    [LieModule K (LieAlgebra.SpecialLinear.sl (Fin 2) K) M] [FiniteDimensional K M]
    (N : LieSubmodule K (LieAlgebra.SpecialLinear.sl (Fin 2) K) M) :
    ∃ N' : LieSubmodule K (LieAlgebra.SpecialLinear.sl (Fin 2) K) M, IsCompl N N' :=
  exists_isCompl_of_toLieSubalgebra_eq_top_of_charZero
    (t := isSl2Triple_single (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1))
    (toLieSubalgebra_isSl2Triple_single_eq_top (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1)) N

end CharZero

namespace Sl2Std

open LieAlgebra

variable {K : Type*} [Field K] [CharZero K]
variable {M : Type*} [AddCommGroup M] [Module K M]
  [LieRingModule (SpecialLinear.sl (Fin 2) K) M] [LieModule K (SpecialLinear.sl (Fin 2) K) M]
  [FiniteDimensional K M]

variable (M) in
/-- **Classification of finite-dimensional irreducible `sl₂`-modules over any field of
characteristic zero.** Every finite-dimensional irreducible `sl (Fin 2) K`-module is isomorphic to
`Sl2Std K n = V(n)` for a unique natural number `n`, without any triangularizability or algebraic
closure assumption on `K`. -/
theorem existsUnique_nonempty_lieModuleEquiv_of_charZero
    [LieModule.IsIrreducible K (SpecialLinear.sl (Fin 2) K) M] :
    ∃! n : ℕ, Nonempty (M ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K n) := by
  have htop := toLieSubalgebra_isSl2Triple_single_eq_top (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1)
  have : Nontrivial M :=
    LieModule.nontrivial_of_isIrreducible K (SpecialLinear.sl (Fin 2) K) M
  have := (isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  obtain ⟨w, n, P⟩ := exists_hasPrimitiveVectorWith_of_charZero (K := K) M
    (isSl2Triple_single (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1))
  refine ⟨n, ⟨lieModuleEquivOfEqTop htop (lieModuleEquiv P)⟩, fun n' ⟨ψ⟩ ↦ ?_⟩
  exact eq_of_linearEquiv
    (ψ.symm.trans (lieModuleEquivOfEqTop htop (lieModuleEquiv P))).toLinearEquiv

variable (K M) in
/-- **Every finite-dimensional `sl₂`-module is `⨁ V(nᵢ)`.** Over any field of characteristic zero,
a finite-dimensional `LieAlgebra.SpecialLinear.sl (Fin 2) K`-module is the internal direct sum of a
finite family of Lie submodules, the `i`-th of which is equivalent to the standard irreducible
`V(nᵢ)`. The highest weights `nᵢ` are returned alongside the summands. -/
theorem exists_isInternal_lieModuleEquiv :
    ∃ (k : ℕ) (N : Fin k → LieSubmodule K (SpecialLinear.sl (Fin 2) K) M) (n : Fin k → ℕ),
      DirectSum.IsInternal (fun i ↦ (N i).toSubmodule) ∧
        ∀ i, Nonempty (N i ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K (n i)) := by
  have _i : ComplementedLattice (LieSubmodule K (SpecialLinear.sl (Fin 2) K) M) :=
    ⟨exists_isCompl_sl_fin_two_of_charZero⟩
  obtain ⟨k, N, hint, hirr⟩ := exists_isInternal_isIrreducible K (SpecialLinear.sl (Fin 2) K) M
  have hex : ∀ i, ∃ n : ℕ,
      Nonempty (N i ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K n) := fun i ↦
    have := hirr i
    (existsUnique_nonempty_lieModuleEquiv_of_charZero (M := N i)).exists
  choose n hn using hex
  exact ⟨k, N, n, hint, hn⟩

omit [CharZero K] [LieModule K (SpecialLinear.sl (Fin 2) K) M]
  [FiniteDimensional K M] in
/-- **The dimension of an `sl₂`-module from its decomposition.** If the module is the internal
direct sum of Lie submodules equivalent to `V(n₀), …, V(n_{k-1})`, its dimension is `∑ᵢ (nᵢ + 1)`,
each `V(nᵢ)` having dimension `nᵢ + 1`. -/
theorem finrank_eq_sum {k : ℕ} {N : Fin k → LieSubmodule K (SpecialLinear.sl (Fin 2) K) M}
    {n : Fin k → ℕ} (hint : DirectSum.IsInternal fun i ↦ (N i).toSubmodule)
    (hn : ∀ i, Nonempty (N i ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K (n i))) :
    finrank K M = ∑ i, (n i + 1) := by
  have hfin (i : Fin k) : Module.Finite K (N i).toSubmodule :=
    Module.Finite.equiv (hn i).some.toLinearEquiv.symm
  rw [finrank_eq_sum_finrank_of_isInternal hint]
  exact Finset.sum_congr rfl fun i _ ↦
    ((hn i).some.toLinearEquiv.finrank_eq).trans finrank_eq

end Sl2Std

end TauCeti
