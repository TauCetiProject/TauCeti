module

public import Mathlib.Algebra.Lie.Weights.RootSystem
public import Mathlib.LinearAlgebra.RootSystem.WeylGroup
public import TauCeti.Algebra.Lie.Sl2.Weyl.Automorphism

/-!
# The Weyl group acts on a Cartan subalgebra by inner automorphisms

Let `L` be a finite-dimensional Lie algebra with non-degenerate Killing form over a field `K` of
characteristic zero, and let `H` be a splitting Cartan subalgebra. The Cartan subalgebra is the
coweight space of the root system `LieAlgebra.IsKilling.rootSystem H`, so its Weyl group acts on
`H` through `RootPairing.Equiv.coweightEquiv`. This file proves that this action is realized by
inner automorphisms of `L`: every element of the Weyl group agrees on `H` with an element of the
group `TauCeti.intLieAlgebra K L` generated by the `exp (ad x)` with `ad x` nilpotent.

For a root `α` with `sl₂` triple `(α^∨, e, f)`, the Weyl automorphism
`exp (ad e) exp (-ad f) exp (ad e)` (`TauCeti.weylAut`) acts on `H` as the coreflection
`y ↦ y - α y • α^∨` (`IsSl2Triple.weylAut_apply_coe_of_mem_rootSpace`), since `y` acts on `e` by
`α y` and on `f` by `-α y`. The Weyl group is generated by the reflections, and its action on
coweights reverses products, so the realizing inner automorphism of a product is the product of
the realizing automorphisms of the factors in the opposite order.

This is how the Weyl group enters the conjugacy theory of `L`: an element of `H` and its Weyl
translates are conjugate under `Int(L)`, so, for instance, the neutral element of an `sl₂` triple
in `H` can be moved into the dominant chamber of a fixed base without leaving its conjugacy class.
The converse, that every inner automorphism normalizing `H` acts on `H` through the Weyl group, is
not proved here.

## Main results

* `IsSl2Triple.weylAut_apply_coe_of_mem_rootSpace`: the Weyl automorphism of the `sl₂` triple
  of a root acts on `H` as the coreflection of that root.
* `TauCeti.exists_mem_intLieAlgebra_forall_smul_eq_coweightEquiv`: every element of the Weyl group
  acts on `H` as some element of `Int(L)`.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §14.3.
-/

public section

namespace TauCeti

open LieAlgebra LieAlgebra.IsKilling LieModule LinearMap.GeneralLinearGroup

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]
  [FiniteDimensional K L] [IsKilling K L] {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  [IsTriangularizable K H L]

/-- **The Weyl automorphism of a root acts on the Cartan subalgebra as its coreflection.** For an
`sl₂` triple `(h, e, f)` with `e` in the root space of a root `α` and `f` in that of `-α`, the Weyl
automorphism `exp (ad e) exp (-ad f) exp (ad e)` sends `y ∈ H` to its coreflection
`y - α y • α^∨`. Only local nilpotence of `ad e` and `ad f` is asked for, as by
`TauCeti.weylAut`; the proofs `he` and `hf` are arbitrary. -/
theorem _root_.IsSl2Triple.weylAut_apply_coe_of_mem_rootSpace {i : H.root} {h e f : L}
    (t : IsSl2Triple h e f) (he : ∀ y, ∃ k, ((ad K L e) ^ k) y = 0)
    (hf : ∀ y, ∃ k, ((ad K L f) ^ k) y = 0) (heα : e ∈ rootSpace H (i : Weight K H L))
    (hfα : f ∈ rootSpace H (-(i : Weight K H L))) (y : H) :
    weylAut t he hf (y : L) = ((rootSystem H).coreflection i y : L) := by
  have hα : (i : Weight K H L).IsNonZero := (Finset.mem_filter.mp i.2).2
  have hye : ⁅(y : L), e⁆ = (i : Weight K H L) y • e := lie_eq_smul_of_mem_rootSpace heα y
  have hyf : ⁅(y : L), f⁆ = -((i : Weight K H L) y • f) := by
    simpa using lie_eq_smul_of_mem_rootSpace hfα y
  rw [weylAut_apply_of_lie_eq_smul he hf t hye hyf, t.h_eq_coroot hα heα hfα,
    RootPairing.coreflection_apply]
  simp

/-- **The Weyl group acts on the Cartan subalgebra by inner automorphisms.** Every element `w` of
the Weyl group of the root system of `H` agrees on `H`, through its action
`RootPairing.Equiv.coweightEquiv` on coweights, with an element of the group `Int(L)` of inner
automorphisms of `L`. -/
theorem exists_mem_intLieAlgebra_forall_smul_eq_coweightEquiv (w : (rootSystem H).weylGroup) :
    ∃ g ∈ intLieAlgebra K L, ∀ y : H,
      g • (y : L) = ((w : (rootSystem H).Aut).coweightEquiv y : L) := by
  suffices ∀ w ∈ (rootSystem H).weylGroup, ∃ g ∈ intLieAlgebra K L,
      ∀ y : H, g • (y : L) = (w.coweightEquiv y : L) from this w w.2
  intro w hw
  induction hw using RootPairing.weylGroup.induction with
  | mem i =>
    -- a reflection is realized by the Weyl automorphism of an `sl₂` triple of its root
    have hα : (i : Weight K H L).IsNonZero := (Finset.mem_filter.mp i.2).2
    obtain ⟨h, e, f, t, heα, hfα⟩ := exists_isSl2Triple_of_weight_isNonZero hα
    have he := isNilpotent_ad_of_mem_rootSpace H (χ := ⇑(i : Weight K H L)) hα heα
    have hf := isNilpotent_ad_of_mem_rootSpace H (χ := ⇑(-(i : Weight K H L))) hα.neg hfα
    refine ⟨_, t.ofLinearEquiv_weylAut_mem_intLieAlgebra he hf, fun y ↦ ?_⟩
    simpa using t.weylAut_apply_coe_of_mem_rootSpace he.exists_pow_apply_eq_zero
      hf.exists_pow_apply_eq_zero heα hfα y
  | one => exact ⟨1, one_mem _, fun y ↦ by simp⟩
  | mul x z _ _ hx hz =>
    -- the action on coweights reverses products
    obtain ⟨gx, hgx, hx⟩ := hx
    obtain ⟨gz, hgz, hz⟩ := hz
    refine ⟨gz * gx, mul_mem hgz hgx, fun y ↦ ?_⟩
    rw [mul_smul, hx, hz, RootPairing.Equiv.mul_eq_comp, RootPairing.Equiv.coweightEquiv_comp_toLin,
      LinearEquiv.trans_apply]

end TauCeti
