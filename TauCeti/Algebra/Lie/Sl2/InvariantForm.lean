module

public import TauCeti.Algebra.Lie.InvariantForm.Basic
public import TauCeti.Algebra.Lie.Sl2.Classification

/-!
# The symmetry of an invariant form on an irreducible `sl₂`-module

Let `t : IsSl2Triple h e f` be an `sl₂` triple in a Lie algebra `L` and let `m` be a primitive
vector of weight `n : ℕ` in an `L`-module `M`, with weight string `m, f • m, f² • m, …`. An
invariant bilinear form `B` on `M` (`B ⁅x, y⁆ z = -B y ⁅x, z⁆`) is pinned down on the weight
string by two facts.

* **Weights pair to zero.** The vector `fⁱ • m` has `h`-weight `n - 2i`, and invariance under `h`
  makes `B` vanish on a pair of weight vectors unless their weights add up to zero. So
  `B (fⁱ • m) (fʲ • m) = 0` unless `i + j = n`.
* **Moving `f` across.** Invariance under `f` moves the lowering operator from one side to the
  other at the cost of a sign: `B (fⁱ • m) (fʲ • m) = (-1) ^ i * B m (fⁱ⁺ʲ • m)`.

When `i + j = n`, the second fact writes `B (fⁱ • m) (fʲ • m)` and `B (fʲ • m) (fⁱ • m)` as
`(-1) ^ i` and `(-1) ^ j` times the same number `B m (fⁿ • m)`, and these signs differ by
`(-1) ^ (i + j) = (-1) ^ n`. By bilinearity, on the span of the weight string

`B y x = (-1) ^ n * B x y`.

If `M` is irreducible over the subalgebra of the triple the weight string spans `M`, so every
invariant form on `M` is symmetric when `n` is even and alternating when `n` is odd; a nonzero
invariant form is symmetric exactly when `n` is even. The weight string form, on the span of the
string inside a larger module, is the statement that applies to an `sl₂` triple inside a larger
Lie algebra, such as a principal triple of a semisimple Lie algebra.

Nonzero invariant forms exist. Over a field of characteristic zero, the dual of an irreducible
module with a primitive vector of weight `n` again has a primitive vector of weight `n`, the
coordinate functional of the bottom vector `fⁿ • m`. When the triple generates `L`, the weight
determines the irreducible module, so `M` is self-dual and carries a nonzero invariant form. For
`L = sl₂` and `M = V(n)` this is the rank-one case of the sign of the invariant form on an
irreducible highest weight module: the standard module `V(1)` carries a nonzero invariant form, and
every such form is alternating; the adjoint module `V(2)` carries one, and every such form is
symmetric.

## Main results

* `IsSl2Triple.HasPrimitiveVectorWith.apply_pow_toEnd_f_eq_zero`: two vectors of the weight string
  pair to zero unless their weights add up to zero.
* `IsSl2Triple.HasPrimitiveVectorWith.apply_pow_toEnd_f_swap`: on two vectors of the weight string
  of a primitive vector of weight `n : ℕ`, swapping the arguments of `B` multiplies by `(-1) ^ n`.
* `IsSl2Triple.HasPrimitiveVectorWith.apply_swap_of_mem_weightStringSubmodule`: the same on the
  whole span of the weight string.
* `IsSl2Triple.HasPrimitiveVectorWith.apply_swap`: for an irreducible module, the same on all of
  `M`, with the consequences `IsSl2Triple.HasPrimitiveVectorWith.isSymm_of_even` and
  `IsSl2Triple.HasPrimitiveVectorWith.isAlt_of_odd`.
* `IsSl2Triple.HasPrimitiveVectorWith.isSymm_iff_even` and
  `IsSl2Triple.HasPrimitiveVectorWith.isAlt_iff_odd`: a nonzero invariant form on an irreducible
  module is symmetric exactly when `n` is even, and alternating exactly when `n` is odd.
* `IsSl2Triple.HasPrimitiveVectorWith.dual`: the dual of an irreducible module has a primitive
  vector of the same weight.
* `IsSl2Triple.HasPrimitiveVectorWith.nonempty_lieModuleEquiv_dual` and
  `IsSl2Triple.HasPrimitiveVectorWith.exists_ne_zero_lieInvariant`: an irreducible module over a
  Lie algebra generated by an `sl₂` triple is self-dual, so it carries a nonzero invariant form.
* `TauCeti.Sl2Std.isSymm_iff_even`, `TauCeti.Sl2Std.isAlt_iff_odd` and
  `TauCeti.Sl2Std.exists_ne_zero_lieInvariant`: the same for the standard irreducible module
  `V(n)` of `sl (Fin 2) K`.

## References

* P. Etingof, *Lie Groups and Lie Algebras*, lecture notes, Example 32.13 and Proposition 32.14:
  the sign of an invariant form on `V(n)` and on an irreducible module of a simple Lie algebra.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §7.2, for the
  ladder basis of `V(n)`.
-/

public section

open LieModule

namespace IsSl2Triple.HasPrimitiveVectorWith

section CommRing

variable {K L M : Type*} [CommRing K] [LieRing L] [LieAlgebra K L] [AddCommGroup M] [Module K M]
  [LieRingModule L M] [LieModule K L M] {h e f : L} {t : IsSl2Triple h e f} {m : M}
  {B : LinearMap.BilinForm K M}

/-! ### The invariant form on the weight string -/

/-- **Vectors of the weight string pair to zero unless their weights add up to zero.** The vector
`fⁱ • m` has `h`-weight `μ - 2i`, and invariance under `h` gives
`2 (μ - (i + j)) * B (fⁱ • m) (fʲ • m) = 0`. -/
theorem apply_pow_toEnd_f_eq_zero [NoZeroDivisors K] [NeZero (2 : K)] {μ : K}
    (P : t.HasPrimitiveVectorWith m μ) (hB : B.lieInvariant L) {i j : ℕ}
    (hij : ((i + j : ℕ) : K) ≠ μ) :
    B ((toEnd K L M f ^ i) m) ((toEnd K L M f ^ j) m) = 0 := by
  have hinv := hB h ((toEnd K L M f ^ i) m) ((toEnd K L M f ^ j) m)
  rw [P.lie_h_pow_toEnd_f, P.lie_h_pow_toEnd_f, LinearMap.map_smul₂, LinearMap.map_smul,
    smul_eq_mul, smul_eq_mul] at hinv
  have hmul : (2 * (μ - ((i + j : ℕ) : K))) * B ((toEnd K L M f ^ i) m) ((toEnd K L M f ^ j) m)
      = 0 := by
    push_cast
    linear_combination hinv
  refine (mul_eq_zero.1 hmul).resolve_left ?_
  exact mul_ne_zero two_ne_zero (sub_ne_zero.2 (Ne.symm hij))

variable [IsDomain K] [CharZero K] {n : ℕ}

/-- **Swapping two vectors of the weight string multiplies an invariant form by `(-1) ^ n`**, for
a primitive vector of weight `n : ℕ`. Both values vanish unless `i + j = n`. When `i + j = n`,
moving the lowering operator across gives `B (fⁱ • m) (fʲ • m) = (-1) ^ i * B m (fⁿ • m)` and
`B (fʲ • m) (fⁱ • m) = (-1) ^ j * B m (fⁿ • m)`, and `(-1) ^ j = (-1) ^ n * (-1) ^ i`. -/
theorem apply_pow_toEnd_f_swap (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L)
    (i j : ℕ) :
    B ((toEnd K L M f ^ j) m) ((toEnd K L M f ^ i) m)
      = (-1) ^ n * B ((toEnd K L M f ^ i) m) ((toEnd K L M f ^ j) m) := by
  by_cases hij : i + j = n
  · subst hij
    have hsign : (-1 : K) ^ (i + j) * (-1) ^ i = (-1) ^ j := by
      rw [← pow_add, add_right_comm, ← two_mul, pow_add, pow_mul, neg_one_sq, one_pow, one_mul]
    rw [hB.apply_pow_toEnd, hB.apply_pow_toEnd, ← mul_apply_eq_comp, ← mul_apply_eq_comp,
      ← pow_add, ← pow_add, add_comm j i, ← mul_assoc, hsign]
  · have hne : ∀ a b : ℕ, a + b = i + j → ((a + b : ℕ) : K) ≠ (n : K) := fun a b hab ↦ by
      rw [hab]
      exact_mod_cast hij
    rw [P.apply_pow_toEnd_f_eq_zero hB (hne j i (add_comm j i)),
      P.apply_pow_toEnd_f_eq_zero hB (hne i j rfl), mul_zero]

/-- **Swapping two vectors of the span of the weight string multiplies an invariant form by
`(-1) ^ n`**, for a primitive vector of weight `n : ℕ`. This is the form used for an `sl₂` triple
inside a larger Lie algebra, where the weight string spans only part of the module. -/
theorem apply_swap_of_mem_weightStringSubmodule (P : t.HasPrimitiveVectorWith m (n : K))
    (hB : B.lieInvariant L) {x y : M} (hx : x ∈ TauCeti.weightStringSubmodule P)
    (hy : y ∈ TauCeti.weightStringSubmodule P) : B y x = (-1) ^ n * B x y := by
  rw [← LieSubmodule.mem_toSubmodule, TauCeti.weightStringSubmodule_toSubmodule] at hx hy
  induction hx, hy using Submodule.span_induction₂ with
  | mem_mem _ _ hx hy =>
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨j, rfl⟩ := hy
    exact P.apply_pow_toEnd_f_swap hB i j
  | zero_left => simp
  | zero_right => simp
  | add_left _ _ _ _ _ _ hxz hyz => simp [hxz, hyz, mul_add]
  | add_right _ _ _ _ _ _ hxy hxz => simp [hxy, hxz, mul_add]
  | smul_left r _ _ _ _ hxy => simp [hxy, mul_left_comm r]
  | smul_right r _ _ _ _ hxy => simp [hxy, mul_left_comm r]

/-! ### Irreducible modules -/

section Irreducible

variable [LieModule.IsIrreducible K (t.toLieSubalgebra K) M]

/-- **An invariant form on an irreducible module with a primitive vector of weight `n : ℕ`
satisfies `B y x = (-1) ^ n * B x y`**, irreducibility over the subalgebra of the triple making
the weight string span the module. -/
theorem apply_swap (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L) (x y : M) :
    B y x = (-1) ^ n * B x y :=
  P.apply_swap_of_mem_weightStringSubmodule hB
    (TauCeti.weightStringSubmodule_eq_top P ▸ LieSubmodule.mem_top x)
    (TauCeti.weightStringSubmodule_eq_top P ▸ LieSubmodule.mem_top y)

/-- An invariant form on an irreducible module with a primitive vector of even weight is
symmetric. -/
theorem isSymm_of_even (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L)
    (hn : Even n) : B.IsSymm :=
  LinearMap.BilinForm.isSymm_def.2 fun x y ↦ by rw [P.apply_swap hB y x, hn.neg_one_pow, one_mul]

/-- An invariant form on an irreducible module with a primitive vector of odd weight is
alternating. -/
theorem isAlt_of_odd (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L)
    (hn : Odd n) : B.IsAlt := fun x ↦ by
  have hx := P.apply_swap hB x x
  rw [hn.neg_one_pow, neg_one_mul] at hx
  exact CharZero.neg_eq_self_iff.1 hx.symm

/-- **A nonzero invariant form on an irreducible module with a primitive vector of weight `n : ℕ`
is symmetric exactly when `n` is even.** -/
theorem isSymm_iff_even (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L)
    (hB0 : B ≠ 0) : B.IsSymm ↔ Even n := by
  refine ⟨fun hs ↦ Nat.not_odd_iff_even.1 fun hn ↦ hB0 ?_, P.isSymm_of_even hB⟩
  ext x y
  have hneg := (P.isAlt_of_odd hB hn).neg_eq x y
  rw [← hs.eq x y] at hneg
  exact CharZero.neg_eq_self_iff.1 hneg

/-- **A nonzero invariant form on an irreducible module with a primitive vector of weight `n : ℕ`
is alternating exactly when `n` is odd.** -/
theorem isAlt_iff_odd (P : t.HasPrimitiveVectorWith m (n : K)) (hB : B.lieInvariant L)
    (hB0 : B ≠ 0) : B.IsAlt ↔ Odd n := by
  refine ⟨fun ha ↦ Nat.not_even_iff_odd.1 fun hn ↦ hB0 ?_, P.isAlt_of_odd hB⟩
  ext x y
  have hneg := ha.neg_eq x y
  rw [(P.isSymm_of_even hB hn).eq y x] at hneg
  exact CharZero.neg_eq_self_iff.1 hneg

end Irreducible

end CommRing

/-! ### Self-duality -/

section SelfDual

open Module (Dual)

variable {K L M : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [AddCommGroup M]
  [Module K M] [LieRingModule L M] [LieModule K L M] {h e f : L} {t : IsSl2Triple h e f} {m : M}
  {n : ℕ}

/-- **The dual of an irreducible `sl₂`-module has a primitive vector of the same weight**: the
coordinate functional of the bottom vector `fⁿ • m` of the ladder basis. The weight of `fⁿ • m`
is `-n`, so its coordinate functional has weight `n`, and the raising operator kills that
functional because no ladder vector is raised to the bottom. -/
theorem dual [LieModule.IsIrreducible K (t.toLieSubalgebra K) M]
    (P : t.HasPrimitiveVectorWith m (n : K)) :
    t.HasPrimitiveVectorWith
      ((TauCeti.basisOfHasPrimitiveVectorWith P).coord (Fin.last n)) (n : K) where
  ne_zero h0 := by
    have h1 := LinearMap.congr_fun h0 (TauCeti.basisOfHasPrimitiveVectorWith P (Fin.last n))
    rw [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_eq_same,
      LinearMap.zero_apply] at h1
    exact one_ne_zero h1
  lie_h := by
    refine (TauCeti.basisOfHasPrimitiveVectorWith P).ext fun i ↦ ?_
    rw [Module.Dual.lie_apply, TauCeti.lie_h_basisOfHasPrimitiveVectorWith, map_smul,
      LinearMap.smul_apply, Module.Basis.coord_apply, Module.Basis.repr_self]
    by_cases hi : i = Fin.last n
    · subst hi
      simp only [Finsupp.single_eq_same, Fin.val_last, smul_eq_mul]
      ring
    · simp [Finsupp.single_eq_of_ne (Ne.symm hi)]
  lie_e := by
    refine (TauCeti.basisOfHasPrimitiveVectorWith P).ext fun i ↦ ?_
    rw [Module.Dual.lie_apply, LinearMap.zero_apply, neg_eq_zero]
    cases i using Fin.cases with
    | zero => rw [TauCeti.lie_e_basisOfHasPrimitiveVectorWith_zero, map_zero]
    | succ j =>
      have hj : (⟨(j.castSucc : ℕ) + 1, by simp⟩ : Fin (n + 1)) = j.succ := Fin.ext (by simp)
      rw [← hj, TauCeti.lie_e_basisOfHasPrimitiveVectorWith, map_smul, Module.Basis.coord_apply,
        Module.Basis.repr_self, Finsupp.single_eq_of_ne (Fin.castSucc_lt_last j).ne', smul_zero]

/-- **An irreducible module over a Lie algebra generated by an `sl₂` triple is self-dual**: its
dual is irreducible with a primitive vector of the same weight, and the weight determines the
module. -/
theorem nonempty_lieModuleEquiv_dual (htop : t.toLieSubalgebra K = ⊤)
    [LieModule.IsIrreducible K L M] (P : t.HasPrimitiveVectorWith m (n : K)) :
    Nonempty (M ≃ₗ⁅K,L⁆ Dual K M) := by
  have := (TauCeti.isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  have := Module.Finite.of_basis (TauCeti.basisOfHasPrimitiveVectorWith P)
  have := TauCeti.LieModule.isIrreducible_dual (K := K) (L := L) (M := M)
  exact TauCeti.nonempty_lieModuleEquiv_of_hasPrimitiveVectorWith htop P P.dual

/-- **An irreducible module over a Lie algebra generated by an `sl₂` triple carries a nonzero
invariant bilinear form**, which by `IsSl2Triple.HasPrimitiveVectorWith.isSymm_iff_even` is
symmetric or alternating according to the parity of the weight. -/
theorem exists_ne_zero_lieInvariant (htop : t.toLieSubalgebra K = ⊤)
    [LieModule.IsIrreducible K L M] (P : t.HasPrimitiveVectorWith m (n : K)) :
    ∃ B : LinearMap.BilinForm K M, B ≠ 0 ∧ B.lieInvariant L := by
  have := (TauCeti.isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  have := Module.Finite.of_basis (TauCeti.basisOfHasPrimitiveVectorWith P)
  exact TauCeti.LieModule.exists_ne_zero_lieInvariant_iff_nonempty_lieModuleEquiv_dual.2
    (P.nonempty_lieModuleEquiv_dual htop)

end SelfDual

end IsSl2Triple.HasPrimitiveVectorWith

/-! ### The standard module `V(n)` -/

namespace TauCeti.Sl2Std

open LieAlgebra

variable {K : Type*} [Field K] [CharZero K] {n : ℕ}
  {B : LinearMap.BilinForm K (Sl2Std K n)}

/-- **A nonzero invariant form on `V(n)` is symmetric exactly when `n` is even.** -/
theorem isSymm_iff_even (hB : B.lieInvariant (SpecialLinear.sl (Fin 2) K)) (hB0 : B ≠ 0) :
    B.IsSymm ↔ Even n :=
  (hasPrimitiveVectorWith K n).isSymm_iff_even hB hB0

/-- **A nonzero invariant form on `V(n)` is alternating exactly when `n` is odd.** -/
theorem isAlt_iff_odd (hB : B.lieInvariant (SpecialLinear.sl (Fin 2) K)) (hB0 : B ≠ 0) :
    B.IsAlt ↔ Odd n :=
  (hasPrimitiveVectorWith K n).isAlt_iff_odd hB hB0

/-- **`V(n)` carries a nonzero invariant bilinear form**, symmetric when `n` is even and
alternating when `n` is odd (`TauCeti.Sl2Std.isSymm_iff_even`). -/
theorem exists_ne_zero_lieInvariant :
    ∃ B : LinearMap.BilinForm K (Sl2Std K n), B ≠ 0 ∧ B.lieInvariant (SpecialLinear.sl (Fin 2) K) :=
  (hasPrimitiveVectorWith K n).exists_ne_zero_lieInvariant
    (toLieSubalgebra_isSl2Triple_single_eq_top _)

end TauCeti.Sl2Std
