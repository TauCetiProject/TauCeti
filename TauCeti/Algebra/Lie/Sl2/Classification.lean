/-!
# The classification of the finite-dimensional irreducible `sl₂`-modules

`TauCeti/Algebra/Lie/Sl2/WeightString.lean` shows that a module carrying a primitive vector of
weight `n : ℕ` and irreducible over the subalgebra of an `sl₂` triple is determined by `n`, and
`TauCeti/Algebra/Lie/Sl2/Standard.lean` exhibits such a module, `TauCeti.Sl2Std K n = V(n)`, for
every `n`. What neither file supplies is the remaining half of the classification: that a
finite-dimensional irreducible module *has* a primitive vector at all. This file supplies it and
draws the classification, without any triangularizability or algebraic-closure hypothesis on the
coefficient ring.

First, `TauCeti.exists_hasPrimitiveVectorWith_pow_toEnd_e` raises any nonzero `h`-eigenvector up the
`h`-spectrum by `2` at a time until it dies, producing a primitive vector whose weight is a natural
number by `IsSl2Triple.HasPrimitiveVectorWith.exists_nat`. Extending scalars from a
characteristic-zero domain `K` to an algebraic closure `A` of its fraction field, the Cartan element
`h` acquires an eigenvalue on `A ⊗[K] M`, which raising shows is an integer `z : ℤ`. Flat base
change (`Module.End.eigenspace_baseChange_of_flat`) descends that nonvanishing integer eigenspace
back to `M`, providing an `h`-eigenvector in `M` itself (`TauCeti.exists_hasPrimitiveVectorWith`).

Note that no irreducibility is needed for the existence of a primitive vector: a nonzero
torsion-free Noetherian module over a characteristic-zero domain suffices. Irreducibility enters
only when the weight string of that vector is asked to be the whole module.

Both halves are stated for an arbitrary Lie algebra `L` generated by an `sl₂` triple, and then
specialized to `sl (Fin 2) K` with its standard triple, where they say that every
finite-dimensional irreducible module over a characteristic-zero field is `V(n)` for exactly one
`n`.

## Main results

* `TauCeti.exists_hasPrimitiveVectorWith_pow_toEnd_e`: **raising an eigenvector to a primitive
  vector.** Some power of the raising operator carries a nonzero `h`-eigenvector of weight `μ` to a
  primitive vector of weight `μ + 2k`.
* `TauCeti.exists_hasPrimitiveVectorWith`: **every nonzero torsion-free Noetherian module over an
  `sl₂` triple in characteristic zero has a primitive vector**, of weight a natural number, with no
  triangularizability assumption.
* `TauCeti.existsUnique_nat_hasPrimitiveVectorWith`: **the classification by highest weight.** A
  torsion-free Noetherian irreducible module over a Lie algebra generated by an `sl₂` triple in
  characteristic zero has exactly one highest weight `n : ℕ`, and
  `TauCeti.finrank_eq_of_hasPrimitiveVectorWith_of_eq_top` computes its dimension as `n + 1`.
* `TauCeti.nonempty_lieModuleEquiv_of_hasPrimitiveVectorWith`: **the highest weight determines the
  module**, now as an equivalence over the whole of `L` rather than over the subalgebra of the
  triple.
* `TauCeti.Sl2Std.existsUnique_nonempty_lieModuleEquiv`: **the classification for `sl (Fin 2) K`.**
  Over any field of characteristic zero, a finite-dimensional irreducible `sl (Fin 2) K`-module is
  equivalent to `V(n)` for exactly one `n : ℕ`.
* `TauCeti.Sl2Std.exists_eq_sub_two_mul_of_hasEigenvalue`: every weight of such a module is among
  `n, n - 2, …, -n`. That its weights are in particular integers holds for an arbitrary
  finite-dimensional module, irreducible or not, and is
  `TauCeti.exists_int_of_hasEigenvalue_slFinTwo` in
  `TauCeti/Algebra/Lie/Sl2/Spectrum.lean`.

## References

* [J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972],
  §7.2.
-/

public section

namespace TauCeti

open LieModule Module

/-! ### Existence of a primitive vector -/

section PrimitiveVector

variable {K : Type*} [CommRing K] [IsDomain K] [CharZero K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [IsTorsionFree K M] [IsNoetherian K M]
variable {h e f : L} {m : M} {μ : K}

/-- **Raising an eigenvector to a primitive vector.** If `m ≠ 0` is an `h`-eigenvector of weight
`μ`, then some power `eᵏ • m` is a primitive vector, of weight `μ + 2k`.

The raising operator shifts the weight by `2`, so if no power of `e` killed `m` the vectors
`m, e • m, e² • m, …` would be eigenvectors for the pairwise distinct weights `μ, μ + 2, μ + 4, …`,
hence linearly independent — impossible in a Noetherian module. The last nonzero vector of the
string is therefore killed by `e`, which is precisely primitivity. -/
theorem exists_hasPrimitiveVectorWith_pow_toEnd_e (t : IsSl2Triple h e f)
    (hm : ⁅h, m⁆ = μ • m) (hm0 : m ≠ 0) :
    ∃ k : ℕ, t.HasPrimitiveVectorWith ((toEnd K L M e ^ k) m) (μ + 2 * k) := by
  have hlie : ∀ n : ℕ, ⁅h, (toEnd K L M e ^ n) m⁆ = (μ + 2 * (n : K)) • (toEnd K L M e ^ n) m :=
    fun n ↦ t.lie_h_pow_toEnd_e hm n
  have hzero : ∃ k : ℕ, (toEnd K L M e ^ k) m = 0 := by
    by_contra! hne
    have hinj : Function.Injective fun n : ℕ ↦ μ + 2 * (n : K) := fun a b hab ↦ by
      simpa [add_right_inj, mul_eq_mul_left_iff, Nat.cast_inj] using hab
    have haux (n : ℕ) :
        (toEnd K L M h).HasEigenvector (μ + 2 * (n : K)) ((toEnd K L M e ^ n) m) :=
      ⟨Module.End.mem_eigenspace_iff.2 (by simpa using hlie n), hne n⟩
    have _i : Finite ℕ :=
      ((toEnd K L M h).eigenvectors_linearIndependent' _ hinj _ haux).finite
    exact not_finite ℕ
  obtain ⟨k, hk_ne, hk_zero⟩ := Nat.exists_not_and_succ_of_not_zero_of_exists hm0 hzero
  exact ⟨k, { ne_zero := hk_ne
              lie_h := hlie k
              lie_e := by rw [IsSl2Triple.lie_e_pow_toEnd_e k]; exact hk_zero }⟩

open scoped TensorProduct in
variable (M) in
/-- **Existence of a primitive vector.** Every nonzero torsion-free Noetherian module over an `sl₂`
triple in characteristic zero carries a primitive vector whose weight is a natural number, with no
triangularizability or algebraic-closure assumption on `K`.

Extending scalars to an algebraic closure `A` of `FractionRing K` produces an eigenvalue of `h` on
`A ⊗[K] M`, which raising pins to an integer `z : ℤ`; flat base change descends the corresponding
eigenspace back to `M`, and `TauCeti.exists_hasPrimitiveVectorWith_pow_toEnd_e` raises a nonzero
vector in it to a primitive vector. -/
theorem exists_hasPrimitiveVectorWith [Nontrivial M] (t : IsSl2Triple h e f) :
    ∃ (w : M) (n : ℕ), t.HasPrimitiveVectorWith w (n : K) := by
  let F := FractionRing K
  let A := AlgebraicClosure F
  have _ : CharZero F := charZero_of_injective_algebraMap (IsFractionRing.injective K F)
  have _ : CharZero A := charZero_of_injective_algebraMap (algebraMap F A).injective
  have _ : Module.Flat K F := IsLocalization.flat F (nonZeroDivisors K)
  have _ : Module.Flat K A := Module.Flat.trans K F A
  have _ : Nontrivial (A ⊗[K] M) := by
    obtain ⟨m₀, hm₀⟩ := exists_ne (0 : M)
    have hmF : (1 : F) ⊗ₜ[K] m₀ ≠ 0 := fun h0 ↦ by
      obtain ⟨s, hs⟩ := (IsLocalizedModule.eq_iff_exists (nonZeroDivisors K)
        (TensorProduct.mk K F M 1)).mp (h0.trans (map_zero (TensorProduct.mk K F M 1)).symm)
      rw [smul_zero, Submonoid.smul_def] at hs
      exact hm₀ ((smul_eq_zero.mp hs).resolve_left (mem_nonZeroDivisors_iff_ne_zero.mp s.2))
    have _ : Nontrivial (A ⊗[F] (F ⊗[K] M)) :=
      ⟨(1 : A) ⊗ₜ[F] ((1 : F) ⊗ₜ[K] m₀), 0, fun h0 ↦ hmF
        (Module.Flat.tensorProduct_mk_injective F (F ⊗[K] M) A (by simpa using h0))⟩
    exact (TensorProduct.AlgebraTensorModule.cancelBaseChange K F A A M).symm.toEquiv.nontrivial
  have heig : ∃ z : ℤ, (toEnd K L M h).eigenspace (z : K) ≠ ⊥ := by
    by_cases hh : ((1 : A) ⊗ₜ[K] h : A ⊗[K] L) = 0
    · refine ⟨0, fun hbot ↦ (top_ne_bot (α := Submodule A (A ⊗[K] M))) ?_⟩
      rw [Int.cast_zero] at hbot
      have hbc := (toEnd K L M h).eigenspace_baseChange_of_flat (A := A) (0 : K)
      rw [hbot, Submodule.baseChange_bot, map_zero, ← toEnd_baseChange, hh, map_zero,
        Module.End.eigenspace_zero, LinearMap.ker_zero] at hbc
      exact hbc
    · let tA : IsSl2Triple ((1 : A) ⊗ₜ[K] h) ((1 : A) ⊗ₜ[K] e) ((1 : A) ⊗ₜ[K] f) :=
        { h_ne_zero := hh
          lie_e_f := by simp [t.lie_e_f]
          lie_h_e_nsmul := by simp [t.lie_h_e_nsmul]
          lie_h_f_nsmul := by
            simp only [LieAlgebra.ExtendScalars.bracket_tmul, one_mul, t.lie_h_f_nsmul,
              TensorProduct.tmul_neg, TensorProduct.tmul_smul] }
      obtain ⟨μ, hμ⟩ := (toEnd A (A ⊗[K] L) (A ⊗[K] M) ((1 : A) ⊗ₜ[K] h)).exists_eigenvalue
      obtain ⟨v, hv, hv0⟩ := hμ.exists_hasEigenvector
      obtain ⟨k, P⟩ := exists_hasPrimitiveVectorWith_pow_toEnd_e tA
        (Module.End.mem_eigenspace_iff.mp hv) hv0
      obtain ⟨n, hn⟩ := P.exists_nat
      refine ⟨(n : ℤ) - 2 * k, fun hbot ↦ ?_⟩
      have hμeq : μ = algebraMap K A (((n : ℤ) - 2 * k : ℤ) : K) := by
        rw [map_intCast]; push_cast; linear_combination hn
      have hne : (toEnd A (A ⊗[K] L) (A ⊗[K] M) ((1 : A) ⊗ₜ[K] h)).eigenspace μ ≠ ⊥ :=
        Module.End.hasEigenvalue_iff.mp hμ
      rw [hμeq, toEnd_baseChange, Module.End.eigenspace_baseChange_of_flat, hbot,
        Submodule.baseChange_bot] at hne
      exact hne rfl
  obtain ⟨z, hz⟩ := heig
  obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hz
  obtain ⟨k, P⟩ := exists_hasPrimitiveVectorWith_pow_toEnd_e t
    (Module.End.mem_eigenspace_iff.mp hv) hv0
  obtain ⟨n, hn⟩ := P.exists_nat
  exact ⟨_, n, hn ▸ P⟩

end PrimitiveVector

/-! ### The classification over a Lie algebra generated by a triple -/

section Generated

variable {K : Type*} [CommRing K] [IsDomain K] [CharZero K]
variable {L : Type*} [LieRing L] [LieAlgebra K L]
variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [IsTorsionFree K M]
variable {h e f : L} {t : IsSl2Triple h e f} {m : M} {n : ℕ}

/-- **The rank of an irreducible with a given highest weight.** A module irreducible over a Lie
algebra generated by an `sl₂` triple, carrying a primitive vector of weight `n`, has rank `n + 1`.
This is `TauCeti.finrank_eq_of_hasPrimitiveVectorWith` with the irreducibility hypothesis moved
from the subalgebra of the triple to the whole algebra, which generates it. -/
theorem finrank_eq_of_hasPrimitiveVectorWith_of_eq_top (htop : t.toLieSubalgebra K = ⊤)
    [LieModule.IsIrreducible K L M] (P : t.HasPrimitiveVectorWith m (n : K)) :
    finrank K M = n + 1 :=
  have := (isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  finrank_eq_of_hasPrimitiveVectorWith P

variable {M' : Type*} [AddCommGroup M'] [Module K M'] [LieRingModule L M'] [LieModule K L M']
  [IsTorsionFree K M'] {m' : M'}

/-- **The highest weight determines the irreducible, over the whole algebra.** Two modules
irreducible over a Lie algebra generated by an `sl₂` triple, carrying primitive vectors of the same
weight `n`, are equivalent as `L`-modules.

`TauCeti.lieModuleEquivOfHasPrimitiveVectorWith` proves this over the subalgebra generated by the
triple, which is the correct hypothesis in general; when that subalgebra is everything,
`TauCeti.lieModuleEquivOfEqTop` upgrades the conclusion to the ambient algebra. -/
theorem nonempty_lieModuleEquiv_of_hasPrimitiveVectorWith (htop : t.toLieSubalgebra K = ⊤)
    [LieModule.IsIrreducible K L M] [LieModule.IsIrreducible K L M']
    (P : t.HasPrimitiveVectorWith m (n : K)) (P' : t.HasPrimitiveVectorWith m' (n : K)) :
    Nonempty (M ≃ₗ⁅K,L⁆ M') :=
  have := (isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  have := (isIrreducible_iff_of_eq_top (M := M') htop).2 inferInstance
  ⟨lieModuleEquivOfEqTop htop (lieModuleEquivOfHasPrimitiveVectorWith P P')⟩

variable (M) in
/-- **The classification by highest weight.** A torsion-free Noetherian irreducible module over a
Lie algebra generated by an `sl₂` triple in characteristic zero has exactly one highest weight, a
natural number: one exists by `TauCeti.exists_hasPrimitiveVectorWith`, and two would force two
values on the dimension of `M`.

Together with `TauCeti.finrank_eq_of_hasPrimitiveVectorWith_of_eq_top`,
`TauCeti.nonempty_lieModuleEquiv_of_hasPrimitiveVectorWith` and
`TauCeti.exists_isIrreducible_hasPrimitiveVectorWith` this is the classification: such an
irreducible has a highest weight `n : ℕ`, which determines it and gives it dimension `n + 1`, and
every natural number occurs as such a weight. -/
theorem existsUnique_nat_hasPrimitiveVectorWith (htop : t.toLieSubalgebra K = ⊤)
    [IsNoetherian K M] [LieModule.IsIrreducible K L M] :
    ∃! n : ℕ, ∃ w : M, t.HasPrimitiveVectorWith w (n : K) := by
  have : Nontrivial M := LieModule.nontrivial_of_isIrreducible K L M
  obtain ⟨w, n, P⟩ := exists_hasPrimitiveVectorWith (K := K) M t
  refine ⟨n, ⟨w, P⟩, fun n' ⟨w', P'⟩ ↦ ?_⟩
  have h₁ := finrank_eq_of_hasPrimitiveVectorWith_of_eq_top htop P
  have h₂ := finrank_eq_of_hasPrimitiveVectorWith_of_eq_top htop P'
  omega

end Generated

/-! ### The classification for `sl (Fin 2) K` -/

namespace Sl2Std

open LieAlgebra

variable {K : Type*} [Field K]
variable {M : Type*} [AddCommGroup M] [Module K M]
  [LieRingModule (SpecialLinear.sl (Fin 2) K) M]

/-- **`V(m)` and `V(n)` are not even linearly isomorphic unless `m = n`**, their dimensions being
`m + 1` and `n + 1`. -/
theorem eq_of_linearEquiv {m n : ℕ} (φ : Sl2Std K m ≃ₗ[K] Sl2Std K n) : m = n := by
  have hrank := φ.finrank_eq
  rw [finrank_eq, finrank_eq] at hrank
  omega

variable [LieModule K (SpecialLinear.sl (Fin 2) K) M]
variable {n : ℕ}

/-- **The weights of a module equivalent to `V(n)`.** An eigenvalue of the Cartan element
`h = E₀₀ - E₁₁` on such a module is one of `n, n - 2, …, -n`: the
equivalence carries an eigenvector to an eigenvector, and `TauCeti.Sl2Std.eigenspace_diag_eq_bot`
says `V(n)` has no other weights. -/
theorem exists_eq_sub_two_mul_of_hasEigenvalue
    (φ : M ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K n) {μ : K}
    (hμ : (toEnd K (SpecialLinear.sl (Fin 2) K) M (slFinTwoBasis K 2)).HasEigenvalue μ) :
    ∃ i : Fin (n + 1), μ = (n : K) - 2 * (i : ℕ) := by
  by_contra! hcon
  obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
  have hlie : ⁅slFinTwoBasis K 2, v⁆ = μ • v := by
    simpa using Module.End.mem_eigenspace_iff.1 hv.1
  have hφ : φ ⁅slFinTwoBasis K 2, v⁆ = ⁅slFinTwoBasis K 2, φ v⁆ := φ.map_lie _ v
  have hmem : φ v ∈ Module.End.eigenspace (diag K n) μ := by
    refine Module.End.mem_eigenspace_iff.2 ?_
    rw [← lie_slFinTwoBasis_two, ← hφ, hlie, map_smul]
  rw [eigenspace_diag_eq_bot hcon] at hmem
  exact hv.2 (EquivLike.injective φ (by rw [(Submodule.mem_bot K).1 hmem, map_zero]))

variable [CharZero K]

variable (M) in
/-- **The classification of the finite-dimensional irreducible `sl₂`-modules.** Over any field of
characteristic zero, a finite-dimensional irreducible `sl (Fin 2) K`-module is equivalent to the
standard module `V(n)` for exactly one `n : ℕ`, with no triangularizability or algebraic-closure
assumption on `K`.

The proof is the two halves meeting: `TauCeti.exists_hasPrimitiveVectorWith` produces a primitive
vector of weight `n`, and `TauCeti.Sl2Std.lieModuleEquiv` matches its weight string with that of
`V(n)`. Uniqueness of `n` is `TauCeti.Sl2Std.eq_of_linearEquiv`. -/
theorem existsUnique_nonempty_lieModuleEquiv [FiniteDimensional K M]
    [LieModule.IsIrreducible K (SpecialLinear.sl (Fin 2) K) M] :
    ∃! n : ℕ, Nonempty (M ≃ₗ⁅K,SpecialLinear.sl (Fin 2) K⁆ Sl2Std K n) := by
  have htop := toLieSubalgebra_isSl2Triple_single_eq_top (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1)
  have : Nontrivial M :=
    LieModule.nontrivial_of_isIrreducible K (SpecialLinear.sl (Fin 2) K) M
  have := (isIrreducible_iff_of_eq_top (M := M) htop).2 inferInstance
  obtain ⟨w, n, P⟩ := exists_hasPrimitiveVectorWith (K := K) M
    (isSl2Triple_single (R := K) (zero_ne_one : (0 : Fin 2) ≠ 1))
  refine ⟨n, ⟨lieModuleEquivOfEqTop htop (lieModuleEquiv P)⟩, fun n' ⟨ψ⟩ ↦ ?_⟩
  exact eq_of_linearEquiv
    (ψ.symm.trans (lieModuleEquivOfEqTop htop (lieModuleEquiv P))).toLinearEquiv

end Sl2Std

end TauCeti
