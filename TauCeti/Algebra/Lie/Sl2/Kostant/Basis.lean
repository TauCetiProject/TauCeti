module

public import TauCeti.Algebra.Lie.Sl2.Kostant.Span
public import TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Basis
public import TauCeti.RingTheory.Polynomial.BinomialBasis
public import TauCeti.RingTheory.DividedPowers.Basis
import Mathlib.LinearAlgebra.TensorProduct.Basis

/-!
# The integral PBW basis of the rank-one Kostant form

For a three-dimensional Lie algebra over `ℚ` with ordered basis `f, h, e`, the ordered
monomials `f⁽ᵃ⁾ (h choose b) e⁽ᶜ⁾` form a rational basis of its universal enveloping algebra.
When this basis satisfies the `sl₂` relations, these same monomials form an integral basis
of the Kostant form generated by the divided powers of `e, f` and the binomial coefficients
in `h`. In particular, every element of that form has a unique finite integral expansion.

The rational basis uses the PBW multiplication map from three polynomial factors. Replace
the outside monomial bases by divided powers and the middle basis by binomial polynomials.
The integral spanning theorem of `TauCeti.Algebra.Lie.Sl2.Kostant.Span` then identifies the
integral lattice, without assuming integral linear independence.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, 2nd ed., II.1.

The construction reuses the rational PBW basis and the univariate binomial polynomial basis
in `TauCeti.Algebra.Lie.UniversalEnveloping.PBW.Basis` and
`TauCeti.RingTheory.Polynomial.BinomialBasis`.
-/

public section

open scoped TensorProduct
open Polynomial Module

namespace TauCeti.Sl2

noncomputable section

attribute [local instance] TauCeti.moduleNNRat

private abbrev PolynomialFactors := (ℚ[X] ⊗[ℚ] ℚ[X]) ⊗[ℚ] ℚ[X]

private def polynomialMul {A : Type*} [Ring A] [Algebra ℚ A] (F H E : A) :
    PolynomialFactors →ₗ[ℚ] A :=
  (TensorProduct.lift (LinearMap.mul ℚ A)).comp
    (TensorProduct.map
      ((TensorProduct.lift (LinearMap.mul ℚ A)).comp
        (TensorProduct.map (aeval F).toLinearMap (aeval H).toLinearMap))
      (aeval E).toLinearMap)

private theorem polynomialMul_tmul {A : Type*} [Ring A] [Algebra ℚ A] (F H E : A)
    (p q r : ℚ[X]) :
    polynomialMul F H E ((p ⊗ₜ[ℚ] q) ⊗ₜ[ℚ] r) = aeval F p * aeval H q * aeval E r := by
  simp [polynomialMul]

private def exponentEquiv : ((ℕ × ℕ) × ℕ) ≃ (Fin 3 →₀ ℕ) where
  toFun p := Finsupp.equivFunOnFinite.symm ![p.1.1, p.1.2, p.2]
  invFun n := ((n 0, n 1), n 2)
  left_inv _ := by simp
  right_inv n := by
    ext i
    fin_cases i <;> simp

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L]

private theorem pbwBasis_exponent (b : Basis (Fin 3) ℚ L) (a d c : ℕ) :
    b.pbwBasis (exponentEquiv ((a, d), c)) =
      _root_.UniversalEnvelopingAlgebra.ι ℚ (b 0) ^ a *
        _root_.UniversalEnvelopingAlgebra.ι ℚ (b 1) ^ d *
          _root_.UniversalEnvelopingAlgebra.ι ℚ (b 2) ^ c := by
  simpa [exponentEquiv, List.finRange_succ, mul_assoc] using
    b.pbwBasis_eq_prod_pow_fin ![a, d, c]

private theorem polynomialMul_bijective (b : Basis (Fin 3) ℚ L) :
    Function.Bijective (polynomialMul
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2))) := by
  let B := ((basisMonomials ℚ).tensorProduct (basisMonomials ℚ)).tensorProduct
    (basisMonomials ℚ)
  let e := B.equiv b.pbwBasis exponentEquiv
  have he : e.toLinearMap = polynomialMul
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2)) := by
    apply B.ext
    rintro ⟨⟨a, d⟩, c⟩
    simp only [e, Basis.equiv_apply, LinearEquiv.coe_toLinearMap, pbwBasis_exponent]
    simp [B, Basis.tensorProduct_apply, polynomialMul_tmul, coe_basisMonomials,
      ← Polynomial.C_mul_X_pow_eq_monomial]
  exact he ▸ e.bijective

end

end TauCeti.Sl2

namespace Module.Basis

open TauCeti TauCeti.Sl2

noncomputable section

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L]

attribute [local instance] TauCeti.moduleNNRat

/-- The rational ordered Kostant basis attached to the ordered Lie basis `f, h, e`.
Its indices are `((a, b), c)`, the lowering, Cartan and raising exponents, respectively.
The rational basis does not require the `sl₂` bracket relations. -/
def orderedKostantBasis (b : Basis (Fin 3) ℚ L) :
    Basis ((ℕ × ℕ) × ℕ) ℚ (_root_.UniversalEnvelopingAlgebra ℚ L) :=
  (((dividedPowerPolynomialBasis.tensorProduct (binomialPolynomialBasis ℚ)).tensorProduct
    dividedPowerPolynomialBasis).map
      (LinearEquiv.ofBijective _ (polynomialMul_bijective b)))

/-- The ordered rational basis vector is `f⁽ᵃ⁾ (h choose b) e⁽ᶜ⁾`. -/
@[simp]
theorem orderedKostantBasis_apply (b : Basis (Fin 3) ℚ L) (p : (ℕ × ℕ) × ℕ) :
    orderedKostantBasis b p = orderedKostantMonomial
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0)) p.1.1 p.1.2 p.2 := by
  simp [orderedKostantBasis, Basis.tensorProduct_apply', LinearEquiv.ofBijective_apply,
    polynomialMul_tmul, orderedKostantMonomial_def,
    Ring.map_choose, Associative.map_dividedPower]

private theorem toAddSubgroup_kostantForm_eq_closure (b : Basis (Fin 3) ℚ L)
    (hef : ⁅b 2, b 0⁆ = b 1) (hhe : ⁅b 1, b 2⁆ = 2 • b 2)
    (hhf : ⁅b 1, b 0⁆ = -(2 • b 0)) :
    (TauCeti.UniversalEnvelopingAlgebra.kostantForm ![b 2, b 0] ![b 1]).toAddSubgroup =
      AddSubgroup.closure (Set.range (b.orderedKostantBasis)) := by
  rw [TauCeti.Sl2.toAddSubgroup_kostantForm hef hhe hhf]
  have hrange : Set.range (b.orderedKostantBasis) = orderedKostantMonomials
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2))
      (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0)) := by
    ext x
    simp only [Set.mem_range, orderedKostantBasis_apply, mem_orderedKostantMonomials_iff,
      Prod.exists]
  rw [hrange, orderedKostantSpan_def]

/-- The integral PBW basis of the rank-one Kostant form for an ordered `sl₂` basis `f, h, e`.
No finite-dimensional representation or integral PBW independence is assumed. -/
def kostantFormBasis (b : Basis (Fin 3) ℚ L)
    (hef : ⁅b 2, b 0⁆ = b 1) (hhe : ⁅b 1, b 2⁆ = 2 • b 2)
    (hhf : ⁅b 1, b 0⁆ = -(2 • b 0)) :
    Basis ((ℕ × ℕ) × ℕ) ℤ
      (TauCeti.UniversalEnvelopingAlgebra.kostantForm ![b 2, b 0] ![b 1]) :=
  b.orderedKostantBasis.addSubgroupOfClosure _
    (toAddSubgroup_kostantForm_eq_closure b hef hhe hhf)

/-- Each integral basis vector is the corresponding ordered divided-power/binomial monomial. -/
@[simp]
theorem coe_kostantFormBasis_apply (b : Basis (Fin 3) ℚ L)
    (hef : ⁅b 2, b 0⁆ = b 1) (hhe : ⁅b 1, b 2⁆ = 2 • b 2)
    (hhf : ⁅b 1, b 0⁆ = -(2 • b 0)) (p : (ℕ × ℕ) × ℕ) :
    (b.kostantFormBasis hef hhe hhf p : _root_.UniversalEnvelopingAlgebra ℚ L) =
      orderedKostantMonomial
        (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
        (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2))
        (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0)) p.1.1 p.1.2 p.2 := by
  exact (b.orderedKostantBasis.addSubgroupOfClosure_apply _ _ p).trans
    (orderedKostantBasis_apply b p)

/-- Membership in the rank-one Kostant form is equivalent to existence of a unique finite
integral expansion in its ordered monomials. -/
theorem mem_kostantForm_iff_existsUnique (b : Basis (Fin 3) ℚ L)
    (hef : ⁅b 2, b 0⁆ = b 1) (hhe : ⁅b 1, b 2⁆ = 2 • b 2)
    (hhf : ⁅b 1, b 0⁆ = -(2 • b 0)) (x : _root_.UniversalEnvelopingAlgebra ℚ L) :
    x ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm ![b 2, b 0] ![b 1] ↔
      ∃! a : ((ℕ × ℕ) × ℕ) →₀ ℤ,
        a.sum (fun p z ↦ z • orderedKostantMonomial
          (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 1))
          (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 2))
          (_root_.UniversalEnvelopingAlgebra.ι ℚ (b 0)) p.1.1 p.1.2 p.2) = x := by
  rw [← Subring.mem_toAddSubgroup, toAddSubgroup_kostantForm_eq_closure b hef hhe hhf,
    ← Submodule.span_int_eq_addSubgroupClosure, Submodule.mem_toAddSubgroup]
  simpa only [orderedKostantBasis_apply] using
    LinearIndependent.mem_span_range_iff_existsUnique
      (b.orderedKostantBasis.linearIndependent.restrict_scalars' ℤ) x

end

end Module.Basis
