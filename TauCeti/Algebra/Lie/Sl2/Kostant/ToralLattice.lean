module

public import TauCeti.Algebra.Lie.Sl2.Kostant.Span

/-!
# Ordered spanning with a rank-one toral lattice

Let the coroot be `dT` in a rank-one cocharacter lattice generated by `T`, and let
`α(T) = w`, so `dw = 2`. The relations are

```text
[E,F] = dT,   [T,E] = wE,   [T,F] = -wF.
```

This file proves that the integral form generated by root divided powers and binomial
coefficients in `T` is spanned by `F⁽ᵃ⁾ (T choose b) E⁽ᶜ⁾`. This includes both the
simply connected lattice (`d = 1`, `w = 2`) and the adjoint lattice (`d = 2`, `w = 1`).
The former uses the existing coroot-lattice spanning theorem. For the latter, the
straightening formula uses `2T`; Chu--Vandermonde puts its Cartan coefficients in the
integral span of binomial coefficients in `T`. Thus the toral lattice is retained rather
than replaced by the coroot lattice. No division by two in the integral form is involved.

The result holds in an arbitrary associative rational algebra, and is then applied to
the native universal enveloping algebra. It asserts spanning, not linear independence
or an identification with distributions of a group scheme.

## References

* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §26.2.
* J. C. Jantzen, *Representations of Algebraic Groups*, II.1.

The collection argument uses `TauCeti.Sl2.dividedPower_e_mul_dividedPower_f` and the
ordered-span interface of `TauCeti.Algebra.Lie.Sl2.Kostant.Span`.
-/

public section

namespace TauCeti.Sl2

open Finset Associative

attribute [local instance] TauCeti.moduleNNRat

variable {A : Type*} [Ring A] [Algebra ℚ A] {T E F : A}

private theorem adjoint_generator_mul_monomial_mem
    (hef : E * F - F * E = 2 • T) (hte : T * E - E * T = E)
    (htf : T * F - F * T = -F) {r : A} (hr : r ∈ kostantGenerators T E F)
    (a b c : ℕ) :
    r * orderedKostantMonomial T E F a b c ∈ orderedKostantSpan T E F := by
  have hte' : T * E = E * (T + (1 : A)) := by
    simpa only [mul_add, mul_one, add_comm] using sub_eq_iff_eq_add.mp hte
  have htf' : T * F = F * (T + (-1 : A)) := by
    simpa only [mul_add, mul_neg, mul_one, add_comm] using sub_eq_iff_eq_add.mp htf
  rcases mem_kostantGenerators_iff.mp hr with ⟨n, rfl⟩ | ⟨n, rfl⟩ | ⟨n, rfl⟩
  · rw [orderedKostantMonomial_def, ← mul_assoc, ← mul_assoc, mul_dividedPower]
    simpa only [smul_mul_assoc, orderedKostantMonomial_def] using
      (orderedKostantSpan T E F).nsmul_mem
        (orderedKostantMonomial_mem_orderedKostantSpan T E F (n + a) b c) _
  · rw [orderedKostantMonomial_def, ← mul_assoc, ← mul_assoc,
      ringChoose_mul_dividedPower n htf' (Commute.neg_left (Commute.one_left F)) a]
    have hshift : Ring.choose (T + a • (-1 : A)) n ∈ ringChooseSpan T := by
      simpa using ringChoose_add_intCast_mem_ringChooseSpan T (-(a : ℤ)) n
    simpa only [mul_assoc] using
      dividedPower_mul_mul_dividedPower_mem_orderedKostantSpan T E F a c
        (mul_mem_ringChooseSpan T hshift (ringChoose_mem_ringChooseSpan T b))
  · have hhe : (2 • T) * E - E * (2 • T) = 2 • E := by
      simpa only [smul_mul_assoc, mul_smul_comm, ← smul_sub] using congrArg (2 • ·) hte
    have hhf : (2 • T) * F - F * (2 • T) = -(2 • F) := by
      simp only [two_smul, add_mul, mul_add, add_sub_add_comm, htf, neg_add]
    rw [orderedKostantMonomial_def, ← mul_assoc, ← mul_assoc,
      dividedPower_e_mul_dividedPower_f hef hhe hhf, sum_mul, sum_mul]
    refine sum_mem fun k _ => ?_
    -- The coroot binomial is an integral combination of binomials in the full toral generator.
    have hmid : Ring.choose ((2 • T) - (n + a : ℕ) + (2 * k : ℕ)) k ∈
        ringChooseSpan T := by
      have h := ringChooseSpan_nsmul_le 2 T (ringChoose_add_intCast_mem_ringChooseSpan (2 • T)
        (((2 * k : ℕ) : ℤ) - ((n + a : ℕ) : ℤ)) k)
      simpa only [Int.cast_sub, Int.cast_natCast, add_sub_assoc, sub_add_eq_add_sub] using h
    have hshift : Ring.choose (T - (n - k) • (1 : A)) b ∈ ringChooseSpan T := by
      simpa using ringChoose_sub_intCast_mem_ringChooseSpan T (n - k : ℕ) b
    have hmove := dividedPower_mul_ringChoose b hte' (Commute.one_left E) (n - k)
    -- Move the remaining toral binomial left, then combine the two raising divided powers.
    simp only [mul_assoc]
    rw [← mul_assoc (dividedPower (n - k) E), hmove]
    simp only [← mul_assoc]
    rw [mul_assoc _ _ (dividedPower c E), mul_dividedPower]
    simpa only [mul_smul_comm, smul_mul_assoc, mul_assoc] using
      (orderedKostantSpan T E F).nsmul_mem
        (dividedPower_mul_mul_dividedPower_mem_orderedKostantSpan T E F (a - k)
          (n - k + c) (mul_mem_ringChooseSpan T hmid hshift)) _

private theorem toAddSubgroup_subringClosure_kostantGenerators_adjoint
    (hef : E * F - F * E = 2 • T) (hte : T * E - E * T = E)
    (htf : T * F - F * T = -F) :
    (Subring.closure (kostantGenerators T E F)).toAddSubgroup =
      orderedKostantSpan T E F := by
  rw [orderedKostantSpan_def]
  apply Subring.toAddSubgroup_closure_eq_of_one_mem_of_subset_of_left_mul_mem
  · rw [← orderedKostantSpan_def]
    exact one_mem_orderedKostantSpan T E F
  · rw [subringClosure_kostantGenerators_eq_subringClosure_orderedKostantMonomials]
    exact Subring.subset_closure
  · intro r hr s hs
    obtain ⟨a, b, c, rfl⟩ := mem_orderedKostantMonomials_iff.mp hs
    rw [← orderedKostantSpan_def]
    exact adjoint_generator_mul_monomial_mem hef hte htf hr a b c

/-- **Integral ordered spanning with a rank-one toral lattice.** For coroot `dT` and
integral root weight `w` with `dw = 2`, the generated integral form has ordered span
`F⁽ᵃ⁾ (T choose b) E⁽ᶜ⁾`, retaining binomials in the full toral lattice. -/
theorem toAddSubgroup_subringClosure_kostantGenerators_of_toral_lattice {d : ℕ} {w : ℤ}
    (hdw : (d : ℤ) * w = 2) (hef : E * F - F * E = d • T)
    (hte : T * E - E * T = w • E) (htf : T * F - F * T = -(w • F)) :
    (Subring.closure (kostantGenerators T E F)).toAddSubgroup =
      orderedKostantSpan T E F := by
  have hd : d ∣ 2 := by
    have : (d : ℤ) ∣ 2 := ⟨w, hdw.symm⟩
    exact_mod_cast this
  rcases (Nat.dvd_prime Nat.prime_two).mp hd with hd | hd
  · subst d
    have hw : w = 2 := by simpa using hdw
    subst w
    exact toAddSubgroup_subringClosure_kostantGenerators (by simpa using hef)
      (by simpa using hte) (by simpa using htf)
  · subst d
    have hw : w = 1 := by omega
    subst w
    exact toAddSubgroup_subringClosure_kostantGenerators_adjoint hef
      (by simpa using hte) (by simpa using htf)

/-- Membership in the integral form with a rank-one toral lattice is membership in the ordered
span with the full toral generator. -/
theorem mem_subringClosure_kostantGenerators_iff_of_toral_lattice {d : ℕ} {w : ℤ}
    (hdw : (d : ℤ) * w = 2) (hef : E * F - F * E = d • T)
    (hte : T * E - E * T = w • E) (htf : T * F - F * T = -(w • F)) {x : A} :
    x ∈ Subring.closure (kostantGenerators T E F) ↔ x ∈ orderedKostantSpan T E F := by
  rw [← Subring.mem_toAddSubgroup,
    toAddSubgroup_subringClosure_kostantGenerators_of_toral_lattice hdw hef hte htf]

section UniversalEnveloping

open _root_.UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable {L : Type*} [LieRing L] [LieAlgebra ℚ L] {t e f : L}

/-- The rank-one enveloping form with coroot `dt` and integral root weight `w`, where
`dw = 2`, is spanned over the integers by ordered lowering, toral-binomial and raising
monomials. The toral generator need not be the coroot. -/
theorem toAddSubgroup_kostantForm_of_toral_lattice {d : ℕ} {w : ℤ}
    (hdw : (d : ℤ) * w = 2) (hef : ⁅e, f⁆ = d • t)
    (hte : ⁅t, e⁆ = w • e) (htf : ⁅t, f⁆ = -(w • f)) :
    (TauCeti.UniversalEnvelopingAlgebra.kostantForm ![e, f] ![t]).toAddSubgroup =
      orderedKostantSpan (ι ℚ t) (ι ℚ e) (ι ℚ f) := by
  rw [kostantForm_eq_subringClosure_kostantGenerators,
    toAddSubgroup_subringClosure_kostantGenerators_of_toral_lattice hdw]
  · simpa only [LieRing.of_associative_ring_bracket, hef, map_nsmul] using
      ((ι ℚ).map_lie e f).symm
  · simpa only [LieRing.of_associative_ring_bracket, hte, map_zsmul] using
      ((ι ℚ).map_lie t e).symm
  · simpa only [LieRing.of_associative_ring_bracket, htf, map_neg, map_zsmul] using
      ((ι ℚ).map_lie t f).symm

/-- Membership in the rank-one enveloping form with a full toral lattice is membership in the
ordered lowering, toral-binomial and raising span. -/
theorem mem_kostantForm_iff_of_toral_lattice {d : ℕ} {w : ℤ}
    (hdw : (d : ℤ) * w = 2) (hef : ⁅e, f⁆ = d • t)
    (hte : ⁅t, e⁆ = w • e) (htf : ⁅t, f⁆ = -(w • f))
    {x : _root_.UniversalEnvelopingAlgebra ℚ L} :
    x ∈ TauCeti.UniversalEnvelopingAlgebra.kostantForm ![e, f] ![t] ↔
      x ∈ orderedKostantSpan (ι ℚ t) (ι ℚ e) (ι ℚ f) := by
  rw [← Subring.mem_toAddSubgroup, toAddSubgroup_kostantForm_of_toral_lattice hdw hef hte htf]

end UniversalEnveloping

end TauCeti.Sl2
