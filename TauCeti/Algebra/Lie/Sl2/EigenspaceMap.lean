/-!
# The raising and lowering operators between eigenspaces of the Cartan element

Let `t : IsSl2Triple h e f` be an `sl₂` triple in a Lie algebra `L` over a field `K` of
characteristic zero, and let `M` be a finite-dimensional `L`-module. Write `M_μ` for the
`μ`-eigenspace of `h`. The raising operator `e` maps `M_μ` into `M_(μ + 2)`
(`TauCeti.lie_mem_eigenspace_add_two`). This file proves that it maps `M_μ` **onto** `M_(μ + 2)`
as soon as `μ + 2` is not of the form `-n` with `n : ℕ`, and that it is injective on `M_μ` as soon
as `μ` is not a natural number. Dually, the lowering operator `f` maps `M_μ` onto `M_(μ - 2)` when
`μ - 2` is not a natural number, and is injective on `M_μ` when `μ` is not of the form `-n`.

In a decomposition of `M` into irreducible modules `V(n)`, with weights `n, n - 2, …, -n`, these are
the familiar statements that `e` is injective below the middle of each string and surjective above
it. The proofs here use no such decomposition and no algebraically closed field. Injectivity is
Mathlib's theorem that a primitive vector has a natural-number weight
(`IsSl2Triple.HasPrimitiveVectorWith.exists_nat`). Surjectivity comes from the decomposition
`M = e • M ⊕ ker f` (`IsSl2Triple.isCompl_range_toEnd_e_ker_toEnd_f`). Both summands are stable
under `h`, so the component in `ker f` of a vector of `M_(μ + 2)` also has weight `μ + 2`, and it
vanishes because `f` is injective on `M_(μ + 2)`. Applying the decomposition inside the sum of the
eigenspaces of `h`, which is a module for the subalgebra generated by the triple
(`TauCeti.eigenspaceSup`), writes the vector as `⁅e, x⁆` with `x` a sum of eigenvectors. The
independence of the eigenspaces then shows that only the `μ`-component of `x` contributes.

For the adjoint action, `h` grades `L` by its eigenspaces `L(μ)`. The case `μ = 0` is
`⁅e, L(0)⁆ = L(2)`, `IsSl2Triple.map_ad_e_eigenspace_zero`. It is the infinitesimal input to the
openness of the orbit of `e` in `L(2)` under a group with Lie algebra `L(0)`: the differential at
the identity of that orbit map is `x ↦ ⁅x, e⁆`.

## Main results

* `IsSl2Triple.disjoint_ker_toEnd_e_eigenspace` and
  `IsSl2Triple.disjoint_ker_toEnd_f_eigenspace`: injectivity of `e` and `f` on the eigenspaces.
* `IsSl2Triple.map_toEnd_e_eigenspace`: `e` maps `M_μ` onto `M_(μ + 2)` unless `μ + 2 = -n`.
* `IsSl2Triple.map_toEnd_f_eigenspace`: `f` maps `M_μ` onto `M_(μ - 2)` unless `μ - 2 = n`.
* `IsSl2Triple.map_ad_e_eigenspace_zero`: `⁅e, L(0)⁆ = L(2)` in the adjoint grading.

## References

* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold, 1993, §3.3–3.4, for the grading attached to an `sl₂` triple and the
  surjectivity of `ad e` from `L(0)` to `L(2)`.
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 7–9, Chapter VIII, §11, no. 1–2.
-/

public section

open LieModule LieAlgebra Module

namespace IsSl2Triple

/-! ### Injectivity -/

section Domain

variable {K L M : Type*} [CommRing K] [IsDomain K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [IsNoetherian K M] [IsTorsionFree K M] {h e f : L} {μ : K}

/-- **The raising operator is injective on the eigenspaces at weights outside `ℕ`.** A nonzero
vector of weight `μ` killed by `e` is a primitive vector, and the weight of a primitive vector is a
natural number. -/
theorem disjoint_ker_toEnd_e_eigenspace (t : IsSl2Triple h e f) (hμ : ∀ n : ℕ, μ ≠ n) :
    Disjoint (LinearMap.ker (toEnd K L M e)) ((toEnd K L M h).eigenspace μ) := by
  refine Submodule.disjoint_def.2 fun m hme hmh ↦ ?_
  by_contra hm
  have P : t.HasPrimitiveVectorWith m μ :=
    ⟨hm, by simpa using Module.End.mem_eigenspace_iff.1 hmh, by simpa using hme⟩
  obtain ⟨n, hn⟩ := P.exists_nat
  exact hμ n hn

/-- **The lowering operator is injective on the eigenspaces at weights outside `-ℕ`.** This is
`IsSl2Triple.disjoint_ker_toEnd_e_eigenspace` for the triple `(-h, f, e)`. -/
theorem disjoint_ker_toEnd_f_eigenspace (t : IsSl2Triple h e f) (hμ : ∀ n : ℕ, μ ≠ -n) :
    Disjoint (LinearMap.ker (toEnd K L M f)) ((toEnd K L M h).eigenspace μ) := by
  have := t.symm.disjoint_ker_toEnd_e_eigenspace (M := M) (μ := -μ)
    fun n hn ↦ hμ n (by rw [← hn, neg_neg])
  simpa using this

end Domain

/-! ### Surjectivity -/

section Field

variable {K L M : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M] [FiniteDimensional K M]
  {h e f : L} {μ : K}

/-- A vector `y` of weight `μ ∉ -ℕ` is `⁅e, x⁆` for some `x` in the sum of the eigenspaces of `h`.
The decomposition `W = e • W ⊕ ker f` of the sum `W` of the eigenspaces writes `y = ⁅e, x⁆ + z`.
Both summands are stable under `h`, so `z` has weight `μ`, and `f` is injective on `M_μ`. -/
private theorem exists_mem_iSup_eigenspace_lie_e_eq (t : IsSl2Triple h e f)
    (hμ : ∀ n : ℕ, μ ≠ -n) {y : M} (hy : y ∈ (toEnd K L M h).eigenspace μ) :
    ∃ x ∈ ⨆ ν : K, (toEnd K L M h).eigenspace ν, ⁅e, x⁆ = y := by
  have hy' : ⁅h, y⁆ = μ • y := by simpa using Module.End.mem_eigenspace_iff.1 hy
  -- Decompose `y` inside the sum `W` of the eigenspaces, a module for the triple's subalgebra.
  set W := TauCeti.eigenspaceSup (K := K) (M := M) t
  have hyW : y ∈ W := TauCeti.mem_eigenspaceSup_of_lie_h_eq_smul t hy'
  have hW : (⟨y, hyW⟩ : W) ∈
      LinearMap.range (toEnd K _ W (⟨e, t.e_mem_toLieSubalgebra⟩ : t.toLieSubalgebra K)) ⊔
        LinearMap.ker (toEnd K _ W (⟨f, t.f_mem_toLieSubalgebra⟩ : t.toLieSubalgebra K)) := by
    rw [t.isSl2Triple_restrict.isCompl_range_toEnd_e_ker_toEnd_f.sup_eq_top]
    exact Submodule.mem_top
  obtain ⟨-, ⟨x, rfl⟩, z, hz, hxz⟩ := Submodule.mem_sup.1 hW
  -- Push the decomposition down from `W` to `M`.
  replace hxz : ⁅e, (x : M)⁆ + (z : M) = y := by
    simpa using congrArg (fun w : W ↦ (w : M)) hxz
  replace hz : ⁅f, (z : M)⁆ = 0 := by
    simpa using congrArg (fun w : W ↦ (w : M)) (LinearMap.mem_ker.1 hz)
  -- `u = ⁅h, z⁆ - μ • z` lies in both `e • M` and `ker f`, so it vanishes.
  have hhe : ⁅h, e⁆ = (2 : K) • e := t.lie_h_e_smul K
  have hfh : ⁅f, h⁆ = (2 : K) • f := by rw [← lie_skew, t.lie_lie_smul_f K, neg_neg]
  have hu_range : ⁅h, (z : M)⁆ - μ • (z : M) ∈ LinearMap.range (toEnd K L M e) := by
    refine ⟨μ • (x : M) - ⁅h, (x : M)⁆ - (2 : K) • (x : M), ?_⟩
    rw [eq_sub_of_add_eq' hxz, toEnd_apply_apply]
    simp only [lie_sub, lie_smul, hy', leibniz_lie h e, hhe, smul_lie]
    module
  have hu_ker : ⁅h, (z : M)⁆ - μ • (z : M) ∈ LinearMap.ker (toEnd K L M f) := by
    rw [LinearMap.mem_ker, toEnd_apply_apply, lie_sub, lie_smul, leibniz_lie f h, hfh, smul_lie,
      hz]
    simp
  have hu : ⁅h, (z : M)⁆ = μ • (z : M) := sub_eq_zero.1 <|
    Submodule.disjoint_def.1 t.isCompl_range_toEnd_e_ker_toEnd_f.disjoint _ hu_range hu_ker
  -- So `z` is a vector of weight `μ` killed by `f`, hence `z = 0`.
  have hz0 : (z : M) = 0 := Submodule.disjoint_def.1 (t.disjoint_ker_toEnd_f_eigenspace hμ) _
    (LinearMap.mem_ker.2 (by simpa using hz)) (Module.End.mem_eigenspace_iff.2 (by simpa using hu))
  refine ⟨x, ?_, by rwa [hz0, add_zero] at hxz⟩
  rw [← TauCeti.eigenspaceSup_toSubmodule t]
  exact x.2

/-- **The raising operator maps `M_μ` onto `M_(μ + 2)`** unless `μ + 2` is of the form `-n` with
`n : ℕ`. In particular `e` maps `M_μ` onto `M_(μ + 2)` for every integer `μ ≥ -1`. -/
theorem map_toEnd_e_eigenspace (t : IsSl2Triple h e f) (hμ : ∀ n : ℕ, μ + 2 ≠ -n) :
    ((toEnd K L M h).eigenspace μ).map (toEnd K L M e) = (toEnd K L M h).eigenspace (μ + 2) := by
  have hle (ν : K) : ((toEnd K L M h).eigenspace ν).map (toEnd K L M e) ≤
      (toEnd K L M h).eigenspace (ν + 2) :=
    Submodule.map_le_iff_le_comap.2 fun v hv ↦ by
      rw [Submodule.mem_comap, toEnd_apply_apply]
      exact TauCeti.lie_mem_eigenspace_add_two t hv
  refine le_antisymm (hle μ) fun y hy ↦ ?_
  obtain ⟨x, hx, rfl⟩ := exists_mem_iSup_eigenspace_lie_e_eq t hμ hy
  -- The images `e • M_ν ≤ M_(ν + 2)` are independent, so only `ν = μ` contributes to `⁅e, x⁆`.
  rw [← TauCeti.biSup_inf_eigenspace_eq_self (toEnd K L M h)
    (fun ν ↦ ((toEnd K L M h).eigenspace ν).map (toEnd K L M e)) (· + 2) (fun ν _ ↦ hle ν)
    (Set.mem_univ μ) fun ν _ hν ↦ by simpa using hν]
  refine ⟨?_, hy⟩
  rw [iSup_univ, ← Submodule.map_iSup, ← toEnd_apply_apply (R := K)]
  exact Submodule.mem_map_of_mem hx

/-- **The lowering operator maps `M_μ` onto `M_(μ - 2)`** unless `μ - 2` is a natural number. This
is `IsSl2Triple.map_toEnd_e_eigenspace` for the triple `(-h, f, e)`. -/
theorem map_toEnd_f_eigenspace (t : IsSl2Triple h e f) (hμ : ∀ n : ℕ, μ - 2 ≠ n) :
    ((toEnd K L M h).eigenspace μ).map (toEnd K L M f) = (toEnd K L M h).eigenspace (μ - 2) := by
  have := t.symm.map_toEnd_e_eigenspace (M := M) (μ := -μ)
    fun n hn ↦ hμ n (by linear_combination -hn)
  have hneg : -μ + 2 = -(μ - 2) := by ring
  rw [map_neg, hneg] at this
  simpa using this

variable [FiniteDimensional K L]

/-- **`⁅e, L(0)⁆ = L(2)`.** For an `sl₂` triple `(h, e, f)` in a finite-dimensional Lie algebra over
a field of characteristic zero, `ad e` maps the `0`-eigenspace of `ad h` onto its `2`-eigenspace. -/
theorem map_ad_e_eigenspace_zero (t : IsSl2Triple h e f) :
    ((ad K L h).eigenspace 0).map (ad K L e) = (ad K L h).eigenspace 2 := by
  have h2 (n : ℕ) : (0 : K) + 2 ≠ -n := by
    rw [zero_add]
    exact_mod_cast (by omega : (2 : ℤ) ≠ -n)
  have := t.map_toEnd_e_eigenspace (K := K) (M := L) (μ := 0) h2
  rw [zero_add] at this
  -- `ad K L` is by definition the action `toEnd K L L` of `L` on itself.
  exact this

end Field

end IsSl2Triple
