/-!
# Freudenthal's recursion for `sl₂`

The rank-one evaluation of Freudenthal's multiplicity recursion
(`TauCeti.coeff_formalCharacter_eq_freudenthalRHS_div`). For `L = sl (Fin 2) K` with the diagonal
Cartan `H = TauCeti.slTwoDiagonalCartan K` and the positive base `TauCeti.slTwoPositiveBase K`,
weights are read in the coordinate `t = λ(h)` through `TauCeti.slTwoWeight`. In this coordinate:

* the invariant form is `⟨s, t⟩ = s t / 8`, because the Killing form has `κ(h, h) = 8`; so the
  simple root `α = 2` has `⟨α, α⟩ = 1/2`;
* the Weyl vector is `ρ = 1`;
* there is a single positive root, so Freudenthal's double sum at the weight `t` is the single
  string sum `∑_{j ≥ 1} dim M_{t + 2j} · (t + 2j) / 4`.

Running the recursion on a finite-dimensional module generated by a highest weight vector of
weight `n ∈ ℕ` then computes every multiplicity `dim M_{n - 2k}`, `0 ≤ k ≤ n`, from the top one:
if the `k` weights `n - 2k + 2j`, `1 ≤ j ≤ k`, above `n - 2k` have multiplicity `1` and the weights
above `n` have multiplicity `0`, the recursion reads

`dim M_{n - 2k} = 2 · (k (n + 1 - k) / 4) / (((n + 1)² - (n + 1 - 2k)²) / 8) = 1`,

the denominator `k (n + 1 - k) / 2` being nonzero exactly in the range `1 ≤ k ≤ n`. So Freudenthal
returns multiplicity `1` at each of the weights `n, n - 2, …, -n`, in agreement with the coordinate
computation of the character of `V(n)` (`TauCeti.Sl2Std.formalCharacter_eq_sum`).

## Main results

* `TauCeti.cartanEquivDual_slTwoCartanGenerator`: the Killing form identifies `h` with the
  weight `8`.
* `TauCeti.invForm_slTwoWeight`: `⟨s, t⟩ = s t / 8`.
* `TauCeti.freudenthalRHS_slTwoPositiveBase`: Freudenthal's double sum for `sl₂`.
* `TauCeti.finrank_genWeightSpace_slTwoWeight_eq_one_of_isHighestWeightVector`: Freudenthal's
  recursion gives multiplicity `1` at each weight `n - 2k`, `k ≤ n`, of a finite-dimensional module
  generated by a highest weight vector of weight `n`.
* `TauCeti.Sl2Std.finrank_genWeightSpace_slTwoWeight_eq_one`: the case of `V(n)`.

## References

* H. Freudenthal, *Zur Berechnung der Charaktere der halbeinfachen Lieschen Gruppen I*,
  Indag. Math. **16** (1954), 369--376.
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, GTM 9, §22.3.
-/

public section

open LieAlgebra LieModule Module

namespace TauCeti

variable {K : Type*} [Field K]

/-- `m • slTwoWeight t` is the weight `m t`. -/
private theorem nsmul_slTwoWeight (m : ℕ) (t : K) : m • slTwoWeight t = slTwoWeight (m * t) :=
  dual_ext_slTwoCartanGenerator <| by simp

/-- The `j`-th rung of the string of `α = 2` above the weight `t` is the weight `t + 2j`. -/
private theorem slTwoWeight_add_nsmul (t : K) (j : ℕ) :
    slTwoWeight t + j • slTwoWeight 2 = slTwoWeight (t + 2 * j) := by
  rw [nsmul_slTwoWeight, slTwoWeight_add, mul_comm]

/-- `∑_{j = 1}^{k} (a + 2j) = k a + k (k + 1)`. -/
private theorem sum_Icc_add_two_mul (a : K) (k : ℕ) :
    ∑ j ∈ Finset.Icc 1 k, (a + 2 * (j : K)) = k * a + k * (k + 1) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_Icc_succ_top (by omega), ih]
    push_cast
    ring

variable [CharZero K]

/-! ### The invariant form and the simple root -/

/-- **The Killing form identifies `h` with the weight `8`**: `κ(h, x) = 8 · x₀₀` on the diagonal
Cartan, since `κ(h, h) = 8`. -/
theorem cartanEquivDual_slTwoCartanGenerator :
    IsKilling.cartanEquivDual (slTwoDiagonalCartan K) (slTwoCartanGenerator K) =
      slTwoWeight 8 := by
  refine dual_ext_slTwoCartanGenerator ?_
  rw [cartanEquivDual_apply_apply_eq_killingForm, coe_slTwoCartanGenerator, ← slFinTwoBasis_two,
    killingForm_slFinTwoBasis, slTwoWeight_slTwoCartanGenerator]
  simp

/-- **The invariant form on the weights of `sl₂`** is `⟨s, t⟩ = s t / 8` in the coordinate
`t = λ(h)`. In particular the simple root, the weight `2`, has `⟨α, α⟩ = 1/2`. -/
@[simp]
theorem invForm_slTwoWeight (s t : K) :
    invForm (slTwoWeight s) (slTwoWeight t) = s * t / 8 := by
  have hs : slTwoWeight s =
      (s / 8) • IsKilling.cartanEquivDual (slTwoDiagonalCartan K) (slTwoCartanGenerator K) := by
    rw [cartanEquivDual_slTwoCartanGenerator]
    refine dual_ext_slTwoCartanGenerator ?_
    simp
  rw [hs, map_smul, LinearMap.smul_apply, invForm_cartanEquivDual_left,
    slTwoWeight_slTwoCartanGenerator, smul_eq_mul]
  ring

/-- The simple root of `sl₂`, as an element of the root system, is the weight `2`. -/
theorem rootSystem_root_slTwoRootIndex :
    (IsKilling.rootSystem (slTwoDiagonalCartan K)).root (slTwoRootIndex K) = slTwoWeight 2 := by
  rw [IsKilling.rootSystem_root_apply, coe_slTwoRootIndex, toLinear_slTwoRoot]

/-! ### Freudenthal's double sum -/

section Module

variable {M : Type*} [AddCommGroup M] [Module K M] [LieRingModule (SpecialLinear.sl (Fin 2) K) M]
  [LieModule K (SpecialLinear.sl (Fin 2) K) M]

/-- In a module generated by a highest weight vector of weight `n`, the weight `n + 2m` with
`m ≥ 1` does not occur. -/
private theorem genWeightSpace_slTwoWeight_add_eq_bot {n : ℕ} {v : M}
    (hv : IsHighestWeightVector (slTwoPositiveBase K) (slTwoWeight (n : K)) v)
    (hgen : LieSubmodule.lieSpan K (SpecialLinear.sl (Fin 2) K) {v} = ⊤) {m : ℕ} (hm : m ≠ 0) :
    genWeightSpace M ((slTwoWeight ((n : K) + 2 * m) : Dual K (slTwoDiagonalCartan K)) :
      slTwoDiagonalCartan K → K) = ⊥ := by
  by_contra hne
  have hcone :=
    sub_mem_posRootCone_of_genWeightSpace_ne_bot_of_isHighestWeightVector_of_lieSpan_eq_top
      hv hgen hne
  have hroot : m • slTwoWeight (2 : K) ∈
      posRootCone (IsKilling.rootSystem (slTwoDiagonalCartan K)) (slTwoPositiveBase K) := by
    rw [← rootSystem_root_slTwoRootIndex]
    exact AddSubmonoid.nsmul_mem _ (root_mem_posRootCone_of_mem_posRoots _ _
      (support_subset_posRoots _ _ slTwoRootIndex_mem_support)) m
  have hzero := eq_zero_of_add_eq_zero_of_mem_posRootCone _ _ hroot hcone <|
    dual_ext_slTwoCartanGenerator <| by simp; ring
  simpa [hm] using congr($hzero (slTwoCartanGenerator K))

variable [FiniteDimensional K M]

variable (M) in
/-- **Freudenthal's double sum for `sl₂`.** The simple root `α = 2` is the only positive root, so
at the weight `t` the double sum `TauCeti.freudenthalRHS` is the single string sum
`∑_{j ≥ 1} dim M_{t + 2j} · ⟨t + 2j, α⟩ = ∑_{j ≥ 1} dim M_{t + 2j} · (t + 2j) / 4`. -/
theorem freudenthalRHS_slTwoPositiveBase (t : K) :
    freudenthalRHS M (slTwoPositiveBase K) (slTwoWeight t) =
      ∑ j ∈ (weightString M (Weight.coe_toLinear_ne_zero_iff.mpr slTwoRoot_isNonZero)
          (slTwoWeight t)).erase 0,
        (finrank K (genWeightSpace M
            ((slTwoWeight (t + 2 * j) : Dual K (slTwoDiagonalCartan K)) :
              slTwoDiagonalCartan K → K)) : K) * ((t + 2 * j) / 4) := by
  have hroot : (((slTwoRootIndex K : Weight K (slTwoDiagonalCartan K)
      (SpecialLinear.sl (Fin 2) K)) : Dual K (slTwoDiagonalCartan K))) = slTwoWeight 2 :=
    rootSystem_root_slTwoRootIndex
  rw [freudenthalRHS_def, posRootsFinset_slTwoPositiveBase, Finset.sum_singleton]
  have hS : weightString M (Weight.coe_toLinear_ne_zero_iff.mpr
      ((slTwoDiagonalCartan K).isNonZero_coe_root (slTwoRootIndex K))) (slTwoWeight t) =
      weightString M (Weight.coe_toLinear_ne_zero_iff.mpr slTwoRoot_isNonZero)
        (slTwoWeight t) := by
    ext j
    simp only [mem_weightString_iff, hroot, toLinear_slTwoRoot]
  rw [hS]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [hroot, slTwoWeight_add_nsmul, invForm_slTwoWeight]
  ring

/-- **The string sum below the top weight.** In a module generated by a highest weight vector of
weight `n`, if the `k` weights `n - 2k + 2j`, `1 ≤ j ≤ k`, have multiplicity `1`, then Freudenthal's
double sum at `n - 2k` is `k (n + 1 - k) / 4`: the weights above `n` do not occur. -/
private theorem freudenthalRHS_slTwoWeight_sub_two_mul {n : ℕ} {v : M}
    (hv : IsHighestWeightVector (slTwoPositiveBase K) (slTwoWeight (n : K)) v)
    (hgen : LieSubmodule.lieSpan K (SpecialLinear.sl (Fin 2) K) {v} = ⊤) {k : ℕ}
    (hdim : ∀ j : ℕ, j ≠ 0 → j ≤ k → finrank K (genWeightSpace M
      ((slTwoWeight ((n : K) - 2 * k + 2 * j) : Dual K (slTwoDiagonalCartan K)) :
        slTwoDiagonalCartan K → K)) = 1) :
    freudenthalRHS M (slTwoPositiveBase K) (slTwoWeight ((n : K) - 2 * k)) =
      k * (n + 1 - k) / 4 := by
  rw [freudenthalRHS_slTwoPositiveBase M,
    Finset.sum_subset (s₂ := Finset.Icc 1 k) (fun j hj ↦ ?_) (fun j _ hj ↦ ?_)]
  · rw [Finset.sum_congr rfl fun j hj ↦ by
        rw [hdim j (by grind) (Finset.mem_Icc.mp hj).2, Nat.cast_one, one_mul, div_eq_mul_inv],
      ← Finset.sum_mul, sum_Icc_add_two_mul]
    ring
  · -- a rung `j > k` of the string would be a weight above the top weight `n`
    obtain ⟨hj0, hjS⟩ := Finset.mem_erase.mp hj
    refine Finset.mem_Icc.mpr ⟨Nat.one_le_iff_ne_zero.mpr hj0, ?_⟩
    by_contra hjk
    refine (mem_weightString_iff _ _).mp hjS ?_
    rw [toLinear_slTwoRoot, slTwoWeight_add_nsmul,
      show (n : K) - 2 * k + 2 * j = n + 2 * ((j - k : ℕ) : K) by
        rw [Nat.cast_sub (by omega)]; ring]
    exact genWeightSpace_slTwoWeight_add_eq_bot hv hgen (by omega)
  · rw [Finset.mem_erase, not_and, mem_weightString_iff, not_not, toLinear_slTwoRoot,
      slTwoWeight_add_nsmul] at hj
    rw [LieSubmodule.finrank_eq_zero_of_eq_bot (hj (by grind)), Nat.cast_zero, zero_mul]

/-! ### The recursion on a highest weight module -/

variable [IsAlgClosed K]

/-- **Freudenthal's recursion for `sl₂`.** In a finite-dimensional module generated by a highest
weight vector of weight `n ∈ ℕ`, each of the weights `n, n - 2, …, -n` has multiplicity `1`, as
computed by `TauCeti.coeff_formalCharacter_eq_freudenthalRHS_div` downwards from the top weight.
The bound `k ≤ n` cannot be dropped: the weight `-n - 2` does not occur. -/
theorem finrank_genWeightSpace_slTwoWeight_eq_one_of_isHighestWeightVector {n : ℕ} {v : M}
    (hv : IsHighestWeightVector (slTwoPositiveBase K) (slTwoWeight (n : K)) v)
    (hgen : LieSubmodule.lieSpan K (SpecialLinear.sl (Fin 2) K) {v} = ⊤) {k : ℕ} (hk : k ≤ n) :
    finrank K (genWeightSpace M ((slTwoWeight ((n : K) - 2 * k) :
      Dual K (slTwoDiagonalCartan K)) : slTwoDiagonalCartan K → K)) = 1 := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  rcases Nat.eq_zero_or_pos k with rfl | hk0
  · have h := formalCharacter_coeff_eq_one_of_isHighestWeightVector_of_lieSpan_eq_top hv hgen
    rw [formalCharacter_coeff] at h
    rw [Nat.cast_zero, mul_zero, sub_zero]
    exact_mod_cast h
  set mu : Dual K (slTwoDiagonalCartan K) := slTwoWeight ((n : K) - 2 * k) with hmu
  have hne : mu ≠ slTwoWeight (n : K) := by
    rw [hmu, Ne, slTwoWeight_inj, sub_eq_self, mul_eq_zero, Nat.cast_eq_zero]
    simp [hk0.ne']
  have hfreud := coeff_formalCharacter_eq_freudenthalRHS_div hv hgen hne
  rw [formalCharacter_coeff, Int.cast_natCast] at hfreud
  -- the multiplicities above `μ` up to the top weight are `1`, by induction
  have hdim (j : ℕ) (hj0 : j ≠ 0) (hjk : j ≤ k) : finrank K (genWeightSpace M
      ((slTwoWeight ((n : K) - 2 * k + 2 * j) : Dual K (slTwoDiagonalCartan K)) :
        slTwoDiagonalCartan K → K)) = 1 := by
    have h := ih (k - j) (by omega) (by omega)
    rw [Nat.cast_sub hjk] at h
    rw [show (n : K) - 2 * k + 2 * j = n - 2 * (k - j) by ring, h]
  have hsum := freudenthalRHS_slTwoWeight_sub_two_mul hv hgen hdim
  -- solve the recursion
  have hk1 : (k : K) ≠ 0 := Nat.cast_ne_zero.mpr hk0.ne'
  have hk2 : (n : K) + 1 - k ≠ 0 := by
    have h : ((n + 1 - k : ℕ) : K) = n + 1 - k := by
      rw [Nat.cast_sub (by omega)]
      push_cast
      ring
    exact h ▸ Nat.cast_ne_zero.mpr (by omega)
  rw [← hmu] at hsum
  rw [hsum, weylVector_slTwoPositiveBase, ← slTwoWeight_add, ← slTwoWeight_add,
    invForm_slTwoWeight, invForm_slTwoWeight,
    show ((n : K) + 1) * (n + 1) / 8 - (n - 2 * k + 1) * (n - 2 * k + 1) / 8 =
      k * (n + 1 - k) / 2 by ring] at hfreud
  have h1 : (finrank K (genWeightSpace M ((mu : Dual K (slTwoDiagonalCartan K)) :
      slTwoDiagonalCartan K → K)) : K) = 1 := by
    rw [hfreud]
    field_simp
    ring
  exact_mod_cast h1

end Module

/-- **Freudenthal's recursion on `V(n)`**: each of the weights `n, n - 2, …, -n` of `V(n)` has
multiplicity `1`. Freudenthal's recursion
`TauCeti.finrank_genWeightSpace_slTwoWeight_eq_one_of_isHighestWeightVector`, run from the highest
weight vector `v₀`, recovers the multiplicities read off from the coordinate basis in
`TauCeti.Sl2Std.formalCharacter_eq_sum`. -/
theorem Sl2Std.finrank_genWeightSpace_slTwoWeight_eq_one [IsAlgClosed K] {n k : ℕ} (hk : k ≤ n) :
    finrank K (genWeightSpace (Sl2Std K n) ((slTwoWeight ((n : K) - 2 * k) :
      Dual K (slTwoDiagonalCartan K)) : slTwoDiagonalCartan K → K)) = 1 :=
  finrank_genWeightSpace_slTwoWeight_eq_one_of_isHighestWeightVector
    Sl2Std.isHighestWeightVector_basis_zero
    (lieSpan_singleton_eq_top_of_ne_zero ((Sl2Std.basis K n).ne_zero 0)) hk

end TauCeti
