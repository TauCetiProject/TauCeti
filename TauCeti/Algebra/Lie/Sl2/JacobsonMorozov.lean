/-!
# The Jacobson–Morozov theorem and conjugacy of `sl₂` triples

Let `L` be a finite-dimensional Lie algebra over a field `K` of characteristic zero.

The **Jacobson–Morozov theorem** says that, when the Killing form of `L` is nondegenerate, every
nonzero `e ∈ L` with `ad e` nilpotent is the nilpositive element of an `sl₂` triple `(h, e, f)`.
It is assembled here from its two halves:
`TauCeti.exists_mem_range_ad_lie_eq_two_nsmul_of_isNilpotent_ad` finds `h ∈ [e, L]` with
`⁅h, e⁆ = 2 • e`, and Morozov's lemma
`TauCeti.existsUnique_isSl2Triple_of_isNilpotent_ad` completes `(h, e)` to a triple.

**Kostant's conjugacy theorem** says that the triple attached to `e` is unique up to the
unipotent part of the centralizer of `e`. Write `𝔲 = ker (ad e) ⊓ [e, L]`. Every `y ∈ 𝔲` has
nilpotent adjoint action (Jacobson's lemma, `TauCeti.isNilpotent_ad_lie_of_lie_lie_eq_zero`), so
`exp (ad y)` is an automorphism of `L` fixing `e`. If `(h, e, f)` and `(h', e, f')` are two triples,
then a product of such automorphisms carries the first to the second. Moreover the neutral
elements of the triples containing `e` are exactly the points of the affine space `h + 𝔲`.

## The argument

The proof runs along the filtration `𝔲ₖ = ker (ad e) ⊓ range ((ad e) ^ k)` of the centralizer of
`e`, which reaches `0` at the nilpotency index of `ad e`. It is compatible with brackets,
`⁅𝔲ᵢ, 𝔲ⱼ⁆ ⊆ 𝔲ᵢ₊ⱼ` (`TauCeti.lie_mem_ker_inf_range_pow_add`), by the Leibniz rule for powers of
the derivation `ad e`. By Morozov's eigenvalue analysis `ad h` acts on `𝔲ₖ / 𝔲ₖ₊₁` by the scalar
`k` (`TauCeti.lie_sub_smul_mem_ker_inf_range_pow_succ`). Hence if `h' - h = z ∈ 𝔲ₖ` with `k ≥ 1`,
then for `y = k⁻¹ • z` the automorphism `exp (ad y)` moves `h'` to a neutral element `h''` with
`h'' - h ∈ 𝔲ₖ₊₁`. A descending induction on `k` finishes the construction. The third elements
then correspond by the uniqueness half of Morozov's lemma.

## Main results

* `TauCeti.exists_isSl2Triple_of_isNilpotent_ad`: **the Jacobson–Morozov theorem**.
* `TauCeti.exists_isSl2Triple_iff`: in such a Lie algebra, `e` is the nilpositive element of an
  `sl₂` triple if and only if `e ≠ 0` and `ad e` is nilpotent.
* `TauCeti.lie_mem_ker_inf_range_pow_add`: the filtration of the centralizer of `e` is compatible
  with brackets.
* `TauCeti.isNilpotent_ad_lie_of_lie_lie_eq_zero`: Jacobson's lemma for the adjoint
  representation; in particular every element of `ker (ad e) ⊓ [e, L]` is `ad`-nilpotent.
* `IsSl2Triple.exists_isSl2Triple_iff_sub_mem`: the neutral elements of the triples containing
  `e` form the affine space `h + (ker (ad e) ⊓ [e, L])`.
* `IsSl2Triple.exists_lieEquiv_apply_eq`: **Kostant's conjugacy theorem**. Two triples with the
  same nilpositive element are conjugate by an automorphism in the subgroup generated by the
  `exp (ad y)` with `y ∈ ker (ad e) ⊓ [e, L]`.

## References

* N. Jacobson, *Lie Algebras*, Interscience, 1962, Chapter III, §11.
* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. **81** (1959), 973–1032.
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 7–9, Chapter VIII, §11.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold, 1993, §3.3 and §3.4.
-/

public section

open LieAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

namespace TauCeti

/-- A neutral element for a nonzero `e` is nonzero. -/
private theorem ne_zero_of_lie_eq_two_nsmul (K : Type*) {L : Type*} [Field K] [CharZero K]
    [LieRing L] [LieAlgebra K L] {h e : L} (hhe : ⁅h, e⁆ = 2 • e) (he0 : e ≠ 0) : h ≠ 0 := by
  rintro rfl
  rw [zero_lie, eq_comm, two_nsmul, ← two_smul K, smul_eq_zero] at hhe
  exact he0 (hhe.resolve_left two_ne_zero)

/-! ### The Jacobson–Morozov theorem -/

section JacobsonMorozov

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]
  [IsKilling K L]

/-- **The Jacobson–Morozov theorem.** In a finite-dimensional Lie algebra with nondegenerate
Killing form over a field of characteristic zero, every nonzero `ad`-nilpotent element `e` is the
nilpositive element of an `sl₂` triple `(h, e, f)`. -/
theorem exists_isSl2Triple_of_isNilpotent_ad {e : L} (he : IsNilpotent (ad K L e)) (he0 : e ≠ 0) :
    ∃ h f : L, IsSl2Triple h e f := by
  obtain ⟨h, hh, hhe⟩ := exists_mem_range_ad_lie_eq_two_nsmul_of_isNilpotent_ad he
  obtain ⟨f, hf, -⟩ := existsUnique_isSl2Triple_of_isNilpotent_ad he hhe hh
    (ne_zero_of_lie_eq_two_nsmul K hhe he0)
  exact ⟨h, f, hf⟩

/-- In a finite-dimensional Lie algebra with nondegenerate Killing form over a field of
characteristic zero, the nilpositive elements of `sl₂` triples are exactly the nonzero
`ad`-nilpotent elements. -/
theorem exists_isSl2Triple_iff {e : L} :
    (∃ h f : L, IsSl2Triple h e f) ↔ IsNilpotent (ad K L e) ∧ e ≠ 0 := by
  refine ⟨fun ⟨_, _, t⟩ => ⟨t.isNilpotent_toEnd_e (M := L), t.e_ne_zero⟩, fun ⟨he, he0⟩ =>
    exists_isSl2Triple_of_isNilpotent_ad he he0⟩

end JacobsonMorozov

/-! ### The filtration of the centralizer -/

section Filtration

/-- The filtration `ker (ad e) ⊓ range ((ad e) ^ k)` is decreasing. -/
private theorem ker_inf_range_pow_antitone {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    (e : L) : Antitone fun k : ℕ => LinearMap.ker (ad R L e) ⊓ LinearMap.range (ad R L e ^ k) :=
  fun _ _ hkl => inf_le_inf_left _ ((ad R L e).iterateRange.monotone hkl)

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]

/-- The filtration `ker (ad e) ⊓ range ((ad e) ^ k)` of the centralizer of `e` is compatible with
brackets: a bracket of an element of the `i`-th step with an element of the `j`-th step lies in the
`(i + j)`-th step. -/
theorem lie_mem_ker_inf_range_pow_add {e x y : L} {i j : ℕ}
    (hx : x ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ i))
    (hy : y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ j)) :
    ⁅x, y⁆ ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ (i + j)) := by
  obtain ⟨hxe, a, rfl⟩ := Submodule.mem_inf.mp hx
  obtain ⟨hye, b, rfl⟩ := Submodule.mem_inf.mp hy
  rw [LinearMap.mem_ker, ad_apply] at hxe hye
  refine Submodule.mem_inf.mpr ⟨LinearMap.mem_ker.mpr ?_, ((i + j).choose i : K)⁻¹ • ⁅a, b⁆, ?_⟩
  · rw [ad_apply, leibniz_lie, hxe, hye, zero_lie, lie_zero, add_zero]
  -- By the Leibniz rule, `(ad e) ^ (i + j)` sends `⁅a, b⁆` to a sum of brackets in which only
  -- `⁅(ad e) ^ i a, (ad e) ^ j b⁆` survives, since `(ad e) ^ (i + 1)` kills `a` and
  -- `(ad e) ^ (j + 1)` kills `b`.
  have hpow {c : L} {n : ℕ} (hc : ⁅e, (ad K L e ^ n) c⁆ = 0) {m : ℕ} (hm : n < m) :
      (ad K L e ^ m) c = 0 := by
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hm
    rw [show n + d + 1 = d + 1 + n by omega, pow_add, Module.End.mul_apply, pow_succ,
      Module.End.mul_apply, ad_apply, hc, map_zero]
  have hleib : (ad K L e ^ (i + j)) ⁅a, b⁆ =
      ((i + j).choose i : K) • ⁅(ad K L e ^ i) a, (ad K L e ^ j) b⁆ := by
    have hD : ⇑(LieDerivation.ad K L e) = ⇑(ad K L e) := funext fun c => by simp
    have := (LieDerivation.ad K L e).iterate_apply_lie (i + j) a b
    simp only [hD, ← Module.End.pow_apply] at this
    rw [this, Finset.sum_eq_single_of_mem (i, j) (Finset.mem_antidiagonal.2 rfl),
      Nat.cast_smul_eq_nsmul]
    rintro ⟨p, q⟩ hpq hne
    rw [Finset.mem_antidiagonal] at hpq
    rcases lt_or_ge i p with hip | hpi
    · rw [hpow hxe hip, zero_lie, smul_zero]
    · have hjq : j < q := by
        by_contra! hqj
        exact hne (Prod.ext (by omega) (by omega))
      rw [hpow hye hjq, lie_zero, smul_zero]
  rw [map_smul, hleib, smul_smul, inv_mul_cancel₀ (by exact_mod_cast (Nat.choose_pos
    (Nat.le_add_right i j)).ne'), one_smul]

variable [FiniteDimensional K L]

/-- **Jacobson's lemma** for the adjoint representation. In a finite-dimensional Lie algebra over
a field of characteristic zero, if `⁅e, ⁅e, a⁆⁆ = 0` then `ad ⁅e, a⁆` is nilpotent. In particular
every element of `ker (ad e) ⊓ [e, L]` is `ad`-nilpotent. -/
theorem isNilpotent_ad_lie_of_lie_lie_eq_zero {e a : L} (h : ⁅e, ⁅e, a⁆⁆ = 0) :
    IsNilpotent (ad K L ⁅e, a⁆) := by
  rw [LieHom.map_lie]
  refine LinearMap.isNilpotent_lie_of_lie_lie_eq_zero ?_
  rw [← LieHom.map_lie, ← LieHom.map_lie, h, map_zero]

/-- Every element of `ker (ad e) ⊓ [e, L]` is `ad`-nilpotent. -/
theorem isNilpotent_ad_of_mem_ker_inf_range {e y : L}
    (hy : y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e)) :
    IsNilpotent (ad K L y) := by
  obtain ⟨hye, a, rfl⟩ := Submodule.mem_inf.mp hy
  rw [LinearMap.mem_ker, ad_apply, ad_apply] at hye
  rw [ad_apply]
  exact isNilpotent_ad_lie_of_lie_lie_eq_zero hye

end Filtration

/-! ### Conjugacy of triples with a common nilpositive element -/

section Conjugacy

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]
  [LieAlgebra ℚ L]

omit [FiniteDimensional K L] in
/-- If `y` lies in the `k`-th step of the filtration of the centralizer of `e`, with `k ≥ 1`, and
`⁅y, v⁆` does too, then `exp (ad y) v = v + ⁅y, v⁆` up to the `2k`-th step. -/
private theorem expAd_apply_sub_sub_mem {e y v : L} {k : ℕ} (hy : IsNilpotent (ad K L y))
    (hyk : y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k))
    (hyv : ⁅y, v⁆ ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k)) :
    expAd y hy v - v - ⁅y, v⁆ ∈
      LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ (k + k)) := by
  set F := fun n : ℕ => LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ n)
  have hpow : ∀ m, (ad K L y ^ (m + 1)) v ∈ F k := by
    intro m
    induction m with
    | zero =>
      rw [zero_add, pow_one, ad_apply]
      exact hyv
    | succ m ih =>
      rw [pow_succ', Module.End.mul_apply, ad_apply]
      exact ker_inf_range_pow_antitone e (Nat.le_add_right k k)
        (lie_mem_ker_inf_range_pow_add hyk ih)
  have hpow₂ (m : ℕ) : (ad K L y ^ (m + 2)) v ∈ F (k + k) := by
    rw [pow_succ', Module.End.mul_apply, ad_apply]
    exact lie_mem_ker_inf_range_pow_add hyk (hpow m)
  obtain ⟨N, hN⟩ := id hy
  rw [expAd_apply_eq_sum hy (k := N + 2) (by rw [pow_add, hN, zero_mul, LinearMap.zero_apply]),
    Finset.sum_range_succ', Finset.sum_range_succ']
  simp only [Nat.factorial_zero, Nat.factorial_one, Nat.cast_one, inv_one, pow_zero, pow_one,
    one_smul, Module.End.one_apply, ad_apply, zero_add]
  rw [add_sub_cancel_right, add_sub_cancel_right]
  exact Submodule.sum_mem _ fun m _ => Submodule.smul_of_tower_mem _ _ (hpow₂ m)

variable {h e : L}

omit [FiniteDimensional K L] in
/-- One step of the descending induction: if `h + z` is another neutral element with `z` in the
`k`-th step of the filtration, `k ≥ 1`, then `exp (ad (k⁻¹ • z))` moves `h + z` to a neutral
element differing from `h` by an element of the `(k + 1)`-st step. -/
private theorem expAd_add_sub_mem (hhe : ⁅h, e⁆ = 2 • e) (hh : h ∈ LinearMap.range (ad K L e))
    {k : ℕ} (hk : 1 ≤ k) {z : L}
    (hz : z ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k))
    (hy : IsNilpotent (ad K L ((k : K)⁻¹ • z))) :
    expAd ((k : K)⁻¹ • z) hy (h + z) - h ∈
      LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ (k + 1)) := by
  set F := fun n : ℕ => LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ n)
  have hk0 : (k : K) ≠ 0 := by exact_mod_cast (by omega : k ≠ 0)
  -- `⁅h, z⁆ = k • z + w` with `w` one step deeper.
  have hw := lie_sub_smul_mem_ker_inf_range_pow_succ hhe hh hz
  set w := ⁅h, z⁆ - (k : K) • z
  have hyv : ⁅(k : K)⁻¹ • z, h + z⁆ = -z - (k : K)⁻¹ • w := by
    rw [smul_lie, lie_add, lie_self, add_zero, ← lie_skew, show ⁅h, z⁆ = (k : K) • z + w by
      simp [w], smul_neg, smul_add, smul_smul, inv_mul_cancel₀ hk0, one_smul, neg_add]
    abel
  have hyk : (k : K)⁻¹ • z ∈ F k := Submodule.smul_mem _ _ hz
  have hyvk : ⁅(k : K)⁻¹ • z, h + z⁆ ∈ F k := by
    rw [hyv]
    exact sub_mem (neg_mem hz)
      (Submodule.smul_mem _ _ (ker_inf_range_pow_antitone e k.le_succ hw))
  have hrest := ker_inf_range_pow_antitone e (by omega : k + 1 ≤ k + k)
    (expAd_apply_sub_sub_mem hy hyk hyvk)
  have heq : expAd ((k : K)⁻¹ • z) hy (h + z) - h =
      (expAd ((k : K)⁻¹ • z) hy (h + z) - (h + z) - ⁅(k : K)⁻¹ • z, h + z⁆) -
        (k : K)⁻¹ • w := by
    rw [hyv]
    abel
  rw [heq]
  exact sub_mem hrest (Submodule.smul_mem _ _ hw)

/-- The automorphisms `exp (ad y)` of `L` with `y ∈ ker (ad e) ⊓ [e, L]`, as linear automorphisms.
They generate the unipotent part of the centralizer of `e`. -/
private abbrev expAdSet (e : L) : Set (L ≃ₗ[K] L) :=
  {φ | ∃ y, ∃ hy : IsNilpotent (ad K L y),
    y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) ∧ (expAd y hy).toLinearEquiv = φ}

/-- The descending induction: every neutral element `h'` with `h' - h` in the `k`-th step of the
filtration, `k ≥ 1`, is the image of `h` under the subgroup generated by the `exp (ad y)`. -/
private theorem exists_lieEquiv_apply_eq_of_sub_mem (hhe : ⁅h, e⁆ = 2 • e)
    (hh : h ∈ LinearMap.range (ad K L e)) (he : IsNilpotent (ad K L e)) {k : ℕ} (hk : 1 ≤ k)
    {h' : L} (hh' : h' - h ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k)) :
    ∃ φ : L ≃ₗ⁅K⁆ L, φ.toLinearEquiv ∈ Subgroup.closure (expAdSet e) ∧ φ h = h' := by
  obtain ⟨N, hN⟩ := he
  suffices ∀ d k, N ≤ k + d → 1 ≤ k → ∀ h' : L,
      h' - h ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k) →
      ∃ φ : L ≃ₗ⁅K⁆ L, φ.toLinearEquiv ∈ Subgroup.closure (expAdSet e) ∧ φ h = h' from
    this N k (Nat.le_add_left N k) hk h' hh'
  intro d
  induction d with
  | zero =>
    -- The `k`-th step vanishes once `(ad e) ^ k = 0`.
    intro k hNk _ h' hh'
    rw [pow_eq_zero_of_le (by omega) hN, LinearMap.range_zero, inf_bot_eq,
      Submodule.mem_bot, sub_eq_zero] at hh'
    exact ⟨LieEquiv.refl, Subgroup.one_mem _, hh'.symm⟩
  | succ d ih =>
    intro k hNk hk h' hh'
    set z := h' - h
    have hyU : (k : K)⁻¹ • z ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) :=
      Submodule.smul_mem _ _ (ker_inf_range_pow_antitone e hk (pow_one (ad K L e) ▸ hh'))
    have hy := isNilpotent_ad_of_mem_ker_inf_range hyU
    obtain ⟨ψ, hψ, hψh⟩ := ih (k + 1) (by omega) (by omega) _
      (expAd_add_sub_mem hhe hh hk hh' hy)
    refine ⟨ψ.trans (expAd _ hy).symm, ?_, ?_⟩
    · have hmem : (expAd _ hy).toLinearEquiv ∈ Subgroup.closure (expAdSet e) :=
        Subgroup.subset_closure ⟨_, hy, hyU, rfl⟩
      convert Subgroup.mul_mem _ (Subgroup.inv_mem _ hmem) hψ using 1
      ext x
      rw [LinearEquiv.mul_apply, LinearEquiv.coe_inv, LinearEquiv.eq_symm_apply]
      simp
    · rw [LieEquiv.trans_apply, hψh, LieEquiv.symm_apply_eq, add_sub_cancel]

end Conjugacy

end TauCeti

namespace IsSl2Triple

open LieAlgebra TauCeti

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]
  {h e f : L}

/-- **The neutral elements attached to a nilpositive element.** Given an `sl₂` triple
`(h, e, f)` in a finite-dimensional Lie algebra over a field of characteristic zero, the elements
`h'` completing `e` to a triple `(h', e, f')` are exactly those of the affine space
`h + (ker (ad e) ⊓ [e, L])`. -/
theorem exists_isSl2Triple_iff_sub_mem (t : IsSl2Triple h e f) {h' : L} :
    (∃ f', IsSl2Triple h' e f') ↔
      h' - h ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) := by
  constructor
  · rintro ⟨f', t'⟩
    refine Submodule.mem_inf.mpr ⟨?_, f' - f, ?_⟩
    · rw [LinearMap.mem_ker, ad_apply, lie_sub, ← lie_skew, t'.lie_h_e_nsmul, ← lie_skew,
        t.lie_h_e_nsmul, sub_self]
    · rw [ad_apply, lie_sub, t'.lie_e_f, t.lie_e_f]
  · intro hmem
    obtain ⟨hker, hrange⟩ := Submodule.mem_inf.mp hmem
    rw [LinearMap.mem_ker, ad_apply] at hker
    have hhe : ⁅h', e⁆ = 2 • e := by
      rw [← sub_add_cancel h' h, add_lie, ← lie_skew, hker, neg_zero, zero_add, t.lie_h_e_nsmul]
    have hh : h' ∈ LinearMap.range (ad K L e) := by
      rw [← sub_add_cancel h' h]
      exact add_mem hrange ⟨f, by rw [ad_apply, t.lie_e_f]⟩
    obtain ⟨f', hf', -⟩ := existsUnique_isSl2Triple_of_isNilpotent_ad
      (t.isNilpotent_toEnd_e (K := K) (M := L)) hhe hh
      (ne_zero_of_lie_eq_two_nsmul K hhe t.e_ne_zero)
    exact ⟨f', hf'⟩

variable [LieAlgebra ℚ L]

/-- **Kostant's conjugacy theorem.** Two `sl₂` triples `(h, e, f)` and `(h', e, f')` with the same
nilpositive element in a finite-dimensional Lie algebra over a field of characteristic zero are
conjugate by an automorphism of `L` that fixes `e` and lies in the subgroup generated by the
automorphisms `exp (ad y)` with `y ∈ ker (ad e) ⊓ [e, L]`. -/
theorem exists_lieEquiv_apply_eq (t : IsSl2Triple h e f) {h' f' : L} (t' : IsSl2Triple h' e f') :
    ∃ φ : L ≃ₗ⁅K⁆ L,
      φ.toLinearEquiv ∈ Subgroup.closure {ψ | ∃ y, ∃ hy : IsNilpotent (ad K L y),
        y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) ∧
          (expAd y hy).toLinearEquiv = ψ} ∧
      φ e = e ∧ φ h = h' ∧ φ f = f' := by
  have he := t.isNilpotent_toEnd_e (K := K) (M := L)
  have hh : h ∈ LinearMap.range (ad K L e) := ⟨f, by rw [ad_apply, t.lie_e_f]⟩
  obtain ⟨φ, hφ, hφh⟩ := exists_lieEquiv_apply_eq_of_sub_mem t.lie_h_e_nsmul hh he le_rfl
    (by simpa using (t.exists_isSl2Triple_iff_sub_mem (K := K)).1 ⟨f', t'⟩)
  -- Every generator fixes `e`, hence so does the subgroup they generate.
  have hφe : φ e = e := by
    have : ∀ ψ ∈ Subgroup.closure (expAdSet (K := K) e), ψ e = e := by
      intro ψ hψ
      induction hψ using Subgroup.closure_induction with
      | mem ψ hψ =>
        obtain ⟨y, hy, hmem, rfl⟩ := hψ
        have hye := (Submodule.mem_inf.mp hmem).1
        rw [LinearMap.mem_ker, ad_apply, ← lie_skew, neg_eq_zero] at hye
        rw [LieEquiv.coe_toLinearEquiv]
        exact expAd_apply_of_lie_eq_zero hy hye
      | one => rfl
      | mul ψ₁ ψ₂ _ _ h₁ h₂ => rw [LinearEquiv.mul_apply, h₂, h₁]
      | inv ψ _ hψ => rw [LinearEquiv.coe_inv, LinearEquiv.symm_apply_eq, hψ]
    exact this _ hφ
  refine ⟨φ, hφ, hφe, hφh, ?_⟩
  -- `(h', e, φ f)` is a triple, so `φ f = f'` by the uniqueness half of Morozov's lemma.
  have hh' : h' ∈ LinearMap.range (ad K L e) := ⟨f', by rw [ad_apply, t'.lie_e_f]⟩
  obtain ⟨f'', -, huniq⟩ :=
    existsUnique_lie_eq_and_lie_eq_neg_two_nsmul he t'.lie_h_e_nsmul hh'
  have hφf : ⁅e, φ f⁆ = h' ∧ ⁅h', φ f⁆ = -(2 • φ f) := by
    constructor
    · conv_lhs => rw [← hφe]
      rw [← LieEquiv.map_lie, t.lie_e_f, hφh]
    · rw [← hφh, ← LieEquiv.map_lie, t.lie_h_f_nsmul, map_neg, map_nsmul]
  rw [huniq _ hφf, huniq _ ⟨t'.lie_e_f, t'.lie_h_f_nsmul⟩]

end IsSl2Triple
