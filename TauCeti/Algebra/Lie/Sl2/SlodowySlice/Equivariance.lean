module

public import TauCeti.Algebra.Lie.AdjointAction.ExpAdSubgroup
public import TauCeti.Algebra.Lie.AdjointAction.SymmetricInvariants
public import TauCeti.Algebra.Lie.Sl2.JacobsonMorozov
public import TauCeti.Algebra.Lie.Sl2.SlodowySlice.Basic
public import Mathlib.LinearAlgebra.AffineSpace.AffineSubspace.Basic

/-!
# Equivariance of the Slodowy slice and of its contracting action

Let `(h, e, f)` be an `sl₂` triple in a Lie algebra `L`, with Slodowy slice
`S(e, f) = e + ker (ad f)` (`TauCeti.slodowySlice`) and contracting action
`c • x = c ^ 2 • Ad (λ c⁻¹) x` (`IsSl2Triple.contractingAction`). This file shows that both are
natural in the triple.

* A Lie algebra homomorphism `φ` carries `S(e, f)` into `S(φ e, φ f)`
  (`LieHom.apply_mem_slodowySlice`), and a Lie algebra isomorphism carries it onto
  `S(φ e, φ f)` (`LieEquiv.map_slodowySlice`).
* A Lie algebra homomorphism intertwines the contracting actions of any two triples whose
  neutral elements correspond (`LieHom.map_contractingAction`), because it intertwines their
  grading automorphisms (`LieHom.map_gradingAut`). The contracting action depends on the
  triple only through `h`.

Applied to an automorphism `φ` of `L`, for instance the adjoint action `Ad g` of a point `g` of an
algebraic group with Lie algebra `L` (`Derivation.basePointsAdjointLieEquiv`), these say that
`Ad g` carries the slice of `(h, e, f)` to the slice of the conjugate triple, compatibly with the
contracting actions. In particular an automorphism fixing `h`, `e` and `f`, such as `Ad g` for `g`
in the triple centralizer `C_G(h, e, f)`, preserves `S(e, f)` and commutes with its contracting
action. The full centralizer of `e` is not claimed to preserve the slice. Infinitesimally, an
element `y` of the centralizer of `e` and `f` gives the vector field `x ↦ ⁅y, x⁆` tangent to
`S(e, f)` (`TauCeti.lie_mem_ker_ad_of_mem_slodowySlice`), and an element of the centralizer of `h`
commutes with the contracting action (`IsSl2Triple.contractingAction_lie_of_lie_eq_zero`).

**Change of triple.** Two `sl₂` triples `(h, e, f)` and `(h', e, f')` with the same nilpositive
element are conjugate by Kostant's theorem (`IsSl2Triple.exists_lieEquiv_apply_eq`), through an
automorphism in the subgroup generated by the `exp (ad y)` with `y ∈ ker (ad e) ⊓ [e, L]`. Such an
automorphism fixes `e`, carries `S(e, f)` onto `S(e, f')`, intertwines the two contracting actions
and, being inner, preserves every invariant polynomial function on `L`
(`IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq`). So the slice at `e`, its contracting action
and the restriction of the adjoint quotient to it do not depend on the triple through `e`, up to
this identification.

## Main results

* `LieHom.apply_mem_slodowySlice`, `LieEquiv.apply_mem_slodowySlice_iff`,
  `LieEquiv.map_slodowySlice`: transport of slices.
* `LieHom.map_contractingAction`: transport of the contracting action.
* `TauCeti.lie_mem_ker_ad_of_mem_slodowySlice`,
  `IsSl2Triple.contractingAction_lie_of_lie_eq_zero`: the infinitesimal triple centralizer acts
  on the slice, commuting with the contracting action.
* `IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq`: slices of triples with the same nilpositive
  element are identified by an inner automorphism fixing `e`, compatibly with the contracting
  actions and with the invariant polynomial functions.

## References

* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. 81 (1959), 973–1032, Theorem 3.6.
* P. Slodowy, *Simple Singularities and Simple Algebraic Groups*, Lecture Notes in Mathematics
  815, Springer, 1980, §7.4.
* W. L. Gan and V. Ginzburg, *Quantization of Slodowy slices*, Int. Math. Res. Not. 2002,
  no. 5, 243–255, §2.
-/

public section

open LieAlgebra LieModule Module TauCeti

/-! ### Transport of slices -/

section Slice

variable {R L L' : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [LieRing L']
  [LieAlgebra R L'] {e f x : L}

/-- **A Lie algebra homomorphism maps Slodowy slices into Slodowy slices**: if
`x ∈ e + ker (ad f)` then `φ x ∈ φ e + ker (ad (φ f))`. -/
theorem LieHom.apply_mem_slodowySlice (φ : L →ₗ⁅R⁆ L') (hx : x ∈ slodowySlice R e f) :
    φ x ∈ slodowySlice R (φ e) (φ f) := by
  rw [mem_slodowySlice] at hx ⊢
  rw [← map_sub, ← LieHom.map_lie, hx, map_zero]

/-- A Lie algebra isomorphism `φ` maps a point into `S(φ e, φ f)` exactly when the point lies in
`S(e, f)`. -/
theorem LieEquiv.apply_mem_slodowySlice_iff (φ : L ≃ₗ⁅R⁆ L') :
    φ x ∈ slodowySlice R (φ e) (φ f) ↔ x ∈ slodowySlice R e f := by
  simp only [mem_slodowySlice, ← map_sub, ← LieEquiv.map_lie, EmbeddingLike.map_eq_zero_iff]

/-- **A Lie algebra isomorphism carries the Slodowy slice `S(e, f)` onto `S(φ e, φ f)`.** -/
theorem LieEquiv.map_slodowySlice (φ : L ≃ₗ⁅R⁆ L') (e f : L) :
    (slodowySlice R e f).map (φ : L →ₗ[R] L').toAffineMap = slodowySlice R (φ e) (φ f) := by
  ext y
  rw [AffineSubspace.mem_map]
  refine ⟨?_, fun hy ↦ ⟨φ.symm y, ?_, φ.apply_symm_apply y⟩⟩
  · rintro ⟨x, hx, rfl⟩
    exact φ.apply_mem_slodowySlice_iff.2 hx
  · rwa [← φ.apply_mem_slodowySlice_iff, φ.apply_symm_apply]

end Slice

/-! ### Transport of the contracting action -/

section Contraction

variable {K L L' : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [LieRing L'] [LieAlgebra K L'] [FiniteDimensional K L'] {h e f : L}
  {h' e' f' : L'}

/-- **Lie algebra homomorphisms intertwine contracting actions.** If `φ` carries the neutral
element of the triple `(h, e, f)` to that of `(h', e', f')`, then
`φ (c • x) = c • φ x` for the two contracting actions. Only the neutral elements are matched: the
contracting action depends on the triple only through its neutral element. -/
theorem LieHom.map_contractingAction (φ : L →ₗ⁅K⁆ L') (t : IsSl2Triple h e f)
    (t' : IsSl2Triple h' e' f') (hφ : φ h = h') (c : Kˣ) (x : L) :
    φ (t.contractingAction c x) = t'.contractingAction c (φ x) := by
  subst hφ
  have hh := ad_eq_toEnd K L ▸ TauCeti.isInternal_eigenspace_toEnd_intCast (M := L) t
  have hh' := ad_eq_toEnd K L' ▸ TauCeti.isInternal_eigenspace_toEnd_intCast (M := L') t'
  rw [t.contractingAction_apply hh, t'.contractingAction_apply hh', map_smul,
    φ.map_gradingAut hh hh']

/-- **The infinitesimal triple centralizer commutes with the contracting action.** If `y`
commutes with the neutral element `h`, then `ad y` commutes with the contracting action of the
triple `(h, e, f)`. -/
theorem IsSl2Triple.contractingAction_lie_of_lie_eq_zero (t : IsSl2Triple h e f) {y : L}
    (hy : ⁅h, y⁆ = 0) (c : Kˣ) (x : L) :
    t.contractingAction c ⁅y, x⁆ = ⁅y, t.contractingAction c x⁆ := by
  have hh := ad_eq_toEnd K L ▸ TauCeti.isInternal_eigenspace_toEnd_intCast (M := L) t
  have hy0 : y ∈ (ad K L h).eigenspace ((0 : ℤ) : K) := by
    rw [Module.End.mem_eigenspace_iff, ad_apply, hy, Int.cast_zero, zero_smul]
  rw [t.contractingAction_apply hh, t.contractingAction_apply hh, LieEquiv.map_lie,
    gradingAut_apply_of_mem hh _ hy0, zpow_zero, Units.val_one, one_smul, lie_smul]

end Contraction

/-! ### The infinitesimal triple centralizer acts on the slice -/

/-- **The infinitesimal triple centralizer is tangent to the slice.** If `y` commutes with `e` and
`f`, then for every `x` in the Slodowy slice `e + ker (ad f)` the bracket `⁅y, x⁆` lies in its
direction `ker (ad f)`, so `x ↦ ⁅y, x⁆` is a vector field on the slice. By the Jacobi identity
such a `y` also commutes with `⁅e, f⁆`; for an `sl₂` triple `(h, e, f)` these `y` form the
centralizer of the triple. -/
theorem TauCeti.lie_mem_ker_ad_of_mem_slodowySlice {R L : Type*} [CommRing R] [LieRing L]
    [LieAlgebra R L] {e f x y : L} (hye : ⁅y, e⁆ = 0) (hyf : ⁅y, f⁆ = 0)
    (hx : x ∈ slodowySlice R e f) : ⁅y, x⁆ ∈ LinearMap.ker (ad R L f) := by
  have hfx : ⁅f, x⁆ = ⁅f, e⁆ := by
    rw [← sub_eq_zero, ← lie_sub]
    exact mem_slodowySlice.1 hx
  have hfy : ⁅f, y⁆ = 0 := by rw [← lie_skew, hyf, neg_zero]
  rw [LinearMap.mem_ker, ad_apply, leibniz_lie, hfy, zero_lie, zero_add, hfx, leibniz_lie, hyf,
    zero_lie, zero_add, hye, lie_zero]

/-! ### Change of triple with a fixed nilpositive element -/

section ChangeOfTriple

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]
  [LieAlgebra ℚ L] {h e f h' f' : L}

open LinearMap.GeneralLinearGroup SymmetricAlgebra TauCeti.SymmetricAlgebra in
/-- **Change of triple for the Slodowy slice.** For two `sl₂` triples `(h, e, f)` and
`(h', e, f')` with the same nilpositive element, there is an automorphism `φ` of `L` in Kostant's
subgroup `TauCeti.expAdSubgroup K e` such that

* `φ` fixes `e`, and carries `h` to `h'` and `f` to `f'`;
* `φ` carries the slice `S(e, f)` onto `S(e, f')`;
* `φ` intertwines the contracting actions of the two triples;
* `φ` preserves every invariant polynomial function `p ∈ S(L*)^L`, so it identifies the
  restrictions of the adjoint quotient to the two slices.
-/
theorem IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq (t : IsSl2Triple h e f)
    (t' : IsSl2Triple h' e f') :
    ∃ φ : L ≃ₗ⁅K⁆ L, φ.toLinearEquiv ∈ expAdSubgroup K e ∧ φ e = e ∧ φ h = h' ∧ φ f = f' ∧
      (slodowySlice K e f).map (φ : L →ₗ[K] L).toAffineMap = slodowySlice K e f' ∧
      (∀ (c : Kˣ) (x : L), φ (t.contractingAction c x) = t'.contractingAction c (φ x)) ∧
      ∀ p ∈ lieInvariants K L (Dual K L), ∀ x : L,
        lift (Dual.eval K L (φ x)) p = lift (Dual.eval K L x) p := by
  obtain ⟨φ, hφ, hφe, hφh, hφf⟩ := t.exists_lieEquiv_apply_eq (K := K) t'
  refine ⟨φ, hφ, hφe, hφh, hφf, ?_, φ.toLieHom.map_contractingAction t t' hφh, fun p hp x ↦ ?_⟩
  · rw [φ.map_slodowySlice, hφe, hφf]
  · -- Kostant's subgroup lies in the group `Int L` of inner automorphisms.
    have hint : (generalLinearEquiv K L).symm φ.toLinearEquiv ∈ intLieAlgebra K L :=
      map_expAdSubgroup_le_intLieAlgebra e ⟨φ.toLinearEquiv, hφ, rfl⟩
    have hg : (((generalLinearEquiv K L).symm φ.toLinearEquiv : LinearMap.GeneralLinearGroup K L) :
        L → L) = φ := by
      rw [← coeFn_generalLinearEquiv, MulEquiv.apply_symm_apply, LieEquiv.coe_toLinearEquiv]
    simpa [Units.smul_def, hg] using lift_eval_smul_of_mem_intLieAlgebra hint hp x

end ChangeOfTriple
