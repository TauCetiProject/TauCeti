module

public import TauCeti.Algebra.Lie.AdjointAction.ExpAdSubgroup
public import TauCeti.Algebra.Lie.AdjointAction.SymmetricInvariants
public import TauCeti.Algebra.Lie.Sl2.JacobsonMorozov
public import TauCeti.Algebra.Lie.Sl2.SlodowySlice.Basic

/-!
# Change of triple for the Slodowy slice

Let `(h, e, f)` be an `sl₂` triple in a Lie algebra `L`, with Slodowy slice
`S(e, f) = e + ker (ad f)` (`TauCeti.slodowySlice`). A Lie algebra isomorphism `φ` carries
`S(e, f)` onto `S(φ e, φ f)` (`LieEquiv.map_slodowySlice`) and intertwines the contracting
actions of two triples whose neutral elements correspond (`LieHom.map_contractingAction`).

Over a field of characteristic zero and for finite-dimensional `L`, two `sl₂` triples `(h, e, f)`
and `(h', e, f')` with the same nilpositive element are conjugate by Kostant's theorem
(`IsSl2Triple.exists_lieEquiv_apply_eq`), through an automorphism in the subgroup generated by the
`exp (ad y)` with `y ∈ ker (ad e) ⊓ [e, L]`. Such an automorphism fixes `e`, carries `S(e, f)`
onto `S(e, f')`, intertwines the two contracting actions `c • x = c ^ 2 • gradingAut c⁻¹ x` and,
being inner, preserves the evaluation of every Lie-invariant polynomial function `p ∈ S(L*)^L`
(`IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq`). So the slice at `e`, its contracting action
and the values of the invariant polynomial functions on it do not depend on the triple through
`e`, up to this identification.

## Main results

* `IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq`: slices of triples with the same nilpositive
  element are identified by an inner automorphism fixing `e`, compatibly with the contracting
  actions and with the evaluation of the invariant polynomial functions.

## References

* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. 81 (1959), 973–1032, Theorem 3.6.
* P. Slodowy, *Simple Singularities and Simple Algebraic Groups*, Lecture Notes in Mathematics
  815, Springer, 1980, §7.4.
* W. L. Gan and V. Ginzburg, *Quantization of Slodowy slices*, Int. Math. Res. Not. 2002,
  no. 5, 243–255, §2.
-/

public section

open LieAlgebra LieModule Module TauCeti

/-! ### Change of triple with a fixed nilpositive element -/

section ChangeOfTriple

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [FiniteDimensional K L]
  [LieAlgebra ℚ L] {h e f h' f' : L}

open LinearMap.GeneralLinearGroup SymmetricAlgebra TauCeti.SymmetricAlgebra in
/-- **Change of triple for the Slodowy slice.** For two `sl₂` triples `(h, e, f)` and
`(h', e, f')` with the same nilpositive element, there is an automorphism `φ` of `L` in Kostant's
subgroup `TauCeti.expAdSubgroup K e` such that

* `φ` fixes `e`, and carries `h` to `h'` and `f` to `f'`;
* `φ` carries the slice `S(e, f)` onto `S(e, f')`;
* `φ` intertwines the contracting actions of the two triples;
* `φ` preserves the evaluation of every Lie-invariant polynomial function `p ∈ S(L*)^L` on `L`,
  and hence on the two slices.
-/
theorem IsSl2Triple.exists_lieEquiv_map_slodowySlice_eq (t : IsSl2Triple h e f)
    (t' : IsSl2Triple h' e f') :
    ∃ φ : L ≃ₗ⁅K⁆ L, φ.toLinearEquiv ∈ expAdSubgroup K e ∧ φ e = e ∧ φ h = h' ∧ φ f = f' ∧
      (slodowySlice K e f).map (φ : L →ₗ[K] L).toAffineMap = slodowySlice K e f' ∧
      (∀ (c : Kˣ) (x : L), φ (t.contractingAction c x) = t'.contractingAction c (φ x)) ∧
      ∀ p ∈ lieInvariants K L (Dual K L), ∀ x : L,
        lift (Dual.eval K L (φ x)) p = lift (Dual.eval K L x) p := by
  obtain ⟨φ, hφ, hφe, hφh, hφf⟩ := t.exists_lieEquiv_apply_eq (K := K) t'
  refine ⟨φ, hφ, hφe, hφh, hφf, ?_, φ.toLieHom.map_contractingAction t t' hφh, fun p hp x ↦ ?_⟩
  · rw [φ.map_slodowySlice, hφe, hφf]
  · -- Kostant's subgroup lies in the group `Int L` of inner automorphisms.
    have hint : (generalLinearEquiv K L).symm φ.toLinearEquiv ∈ intLieAlgebra K L :=
      map_expAdSubgroup_le_intLieAlgebra e ⟨φ.toLinearEquiv, hφ, rfl⟩
    have hg : (((generalLinearEquiv K L).symm φ.toLinearEquiv : LinearMap.GeneralLinearGroup K L) :
        L → L) = φ := by
      rw [← coeFn_generalLinearEquiv, MulEquiv.apply_symm_apply, LieEquiv.coe_toLinearEquiv]
    simpa [Units.smul_def, hg] using lift_eval_smul_of_mem_intLieAlgebra hint hp x

end ChangeOfTriple
