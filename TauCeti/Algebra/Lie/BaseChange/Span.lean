module

public import Mathlib.Algebra.Lie.BaseChange

/-!
# Lie-module generators under extension of scalars

Extension of scalars commutes with the Lie submodule generated by a set:
`LieSubmodule.baseChange_lieSpan` identifies the extension of `lieSpan R L s` with the Lie
submodule generated by the vectors `1 ⊗ₜ m`, for `m ∈ s`, under the extended Lie algebra.
In particular, a cyclic module remains generated by the image of its cyclic vector.

The coefficient algebra is arbitrary: neither flatness nor a field hypothesis is needed.
This comparison applies, for example, when extending a rational highest-weight module to a
larger field: the image of the highest vector still generates the entire extended module.
It makes no assertion that irreducibility is preserved.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapter I, §2 (extension of scalars).
* J. E. Humphreys, *Introduction to Lie Algebras and Representation Theory*, §20
  (modules generated by highest-weight vectors).
-/

public section

open scoped TensorProduct

namespace LieSubmodule

universe u v w x

variable {R : Type u} {A : Type v} {L : Type w} {M : Type x}
variable [CommRing R] [CommRing A] [Algebra R A]
variable [LieRing L] [LieAlgebra R L]
variable [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]

/-- Extension of scalars commutes with the Lie submodule generated by any set.
In particular, the images of a generating set still generate after any scalar extension. -/
@[simp]
theorem baseChange_lieSpan (s : Set M) :
    (lieSpan R L s).baseChange A =
      lieSpan A (A ⊗[R] L) ((TensorProduct.mk R A M 1) '' s) := by
  let N := lieSpan A (A ⊗[R] L) ((TensorProduct.mk R A M 1) '' s)
  -- First transport Lie-span membership on unit tensors; ordinary linear spanning then
  -- supplies every tensor in the extended submodule.
  have hgen {n : M} (hn : n ∈ lieSpan R L s) :
      (1 : A) ⊗ₜ[R] n ∈ N := by
    induction hn using lieSpan_induction with
    | mem n hn => exact subset_lieSpan ⟨n, hn, rfl⟩
    | zero => simp
    | add n k hn hk ihn ihk =>
        simpa only [TensorProduct.tmul_add, mem_toSubmodule] using N.add_mem ihn ihk
    | smul r n hn ihn =>
        simpa using N.smul_mem (algebraMap R A r) ihn
    | lie x n hn ihn =>
        simpa using N.lie_mem (x := 1 ⊗ₜ[R] x) ihn
  refine le_antisymm ?_ (lieSpan_le.mpr ?_)
  · intro m hm
    rw [← mem_toSubmodule, coe_baseChange, Submodule.baseChange_eq_span] at hm
    have hle : Submodule.span A
        (((lieSpan R L s : Submodule R M).map (TensorProduct.mk R A M 1)) :
          Set (A ⊗[R] M)) ≤ N :=
      Submodule.span_le.mpr (by rintro _ ⟨n, hn, rfl⟩; exact hgen hn)
    exact hle hm
  · rintro _ ⟨m, hm, rfl⟩
    exact tmul_mem_baseChange_of_mem 1 (subset_lieSpan hm)

end LieSubmodule
