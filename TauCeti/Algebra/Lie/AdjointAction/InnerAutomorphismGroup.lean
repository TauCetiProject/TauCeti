/-!
# The group of inner automorphisms of a Lie algebra

For an element `x` of a Lie algebra `L` whose adjoint action is nilpotent, `exp (ad x)` is an
automorphism of `L` (`TauCeti.expAd`). The group `Int L` of **inner automorphisms** is the subgroup
of the general linear group of `L` generated by these exponentials. This file defines it as
`TauCeti.intLieAlgebra K L` and proves:

* every element of `Int L` preserves the bracket, so it is an automorphism of `L`
  (`TauCeti.intLieAlgebraLieEquiv`);
* an automorphism `φ` of `L` conjugates `exp (ad x)` to `exp (ad (φ x))`, so `Int L` is normalized
  by every automorphism of `L`;
* the Weyl automorphism `exp (ad e) exp (-ad f) exp (ad e)` of an `sl₂` triple, and the subgroup
  `TauCeti.expAdSubgroup` in which Kostant's conjugacy theorem for `sl₂` triples takes place, lie
  in `Int L`.

For a split semisimple Lie algebra over a field of characteristic zero, `Int L` is the group whose
invariant polynomial functions on `L` Chevalley's restriction theorem describes: the conjugates of
a Cartan subalgebra under `Int L` are dense in `L`, so such a function is determined by its
restriction to the Cartan subalgebra.

## Main definitions

* `TauCeti.intLieAlgebra K L`: the subgroup of `LinearMap.GeneralLinearGroup K L` generated by the
  automorphisms `exp (ad x)` with `ad x` nilpotent.
* `TauCeti.intLieAlgebraLieEquiv`: an element of `Int L`, as an automorphism of the Lie algebra.

## Main results

* `TauCeti.intLieAlgebra_le_iff`: the universal property of `TauCeti.intLieAlgebra`.
* `TauCeti.map_lie_of_mem_intLieAlgebra`: elements of `Int L` preserve the bracket.
* `LieEquiv.map_conj_intLieAlgebra`: conjugation by an automorphism of `L` maps `Int L` onto
  itself.
* `TauCeti.ofLinearEquiv_weylAut_mem_intLieAlgebra`: Weyl automorphisms of `sl₂` triples lie in
  `Int L`.
* `TauCeti.map_expAdSubgroup_le_intLieAlgebra`: Kostant's subgroup lies in `Int L`.

## References

* [J. Humphreys, *Introduction to Lie Algebras and Representation Theory*][humphreys1972], §2.3,
  where `Int L` is introduced and shown to be normal in the automorphism group of `L`.
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapter VII, §3.1, where the same group is the group
  `Aut_e(L)` of elementary automorphisms.
-/

public section

namespace TauCeti

open LieAlgebra LinearMap.GeneralLinearGroup

variable {K L : Type*} [CommRing K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]

variable (K L) in
/-- **The group `Int L` of inner automorphisms** of a Lie algebra `L`: the subgroup of the general
linear group of `L` generated by the automorphisms `exp (ad x)` with `ad x` nilpotent. Its elements
preserve the bracket (`TauCeti.map_lie_of_mem_intLieAlgebra`). -/
def intLieAlgebra : Subgroup (LinearMap.GeneralLinearGroup K L) :=
  Subgroup.closure {g | ∃ x, ∃ hx : IsNilpotent (ad K L x),
    ofLinearEquiv (expAd x hx).toLinearEquiv = g}

/-- Each generator `exp (ad x)` lies in `Int L`. -/
theorem ofLinearEquiv_expAd_mem_intLieAlgebra (x : L) (hx : IsNilpotent (ad K L x)) :
    ofLinearEquiv (expAd x hx).toLinearEquiv ∈ intLieAlgebra K L :=
  Subgroup.subset_closure ⟨x, hx, rfl⟩

/-- `Int L` lies in a subgroup `G` if and only if every generator `exp (ad x)` does. -/
theorem intLieAlgebra_le_iff {G : Subgroup (LinearMap.GeneralLinearGroup K L)} :
    intLieAlgebra K L ≤ G ↔
      ∀ x (hx : IsNilpotent (ad K L x)), ofLinearEquiv (expAd x hx).toLinearEquiv ∈ G := by
  refine (Subgroup.closure_le _).trans ⟨fun hG x hx => hG ⟨x, hx, rfl⟩, ?_⟩
  rintro hG _ ⟨x, hx, rfl⟩
  exact hG x hx

/-! ### Elements of `Int L` are Lie automorphisms -/

/-- **Elements of `Int L` preserve the bracket.** -/
theorem map_lie_of_mem_intLieAlgebra {g : LinearMap.GeneralLinearGroup K L}
    (hg : g ∈ intLieAlgebra K L) (x y : L) : g • ⁅x, y⁆ = ⁅g • x, g • y⁆ := by
  induction hg using Subgroup.closure_induction generalizing x y with
  | mem _ h =>
    obtain ⟨z, hz, rfl⟩ := h
    simpa using (expAd z hz).map_lie x y
  | one => rfl
  | mul g h _ _ hg hh => rw [mul_smul, mul_smul, mul_smul, hh, hg]
  | inv g _ hg => rw [← smul_left_cancel_iff g, smul_inv_smul, hg, smul_inv_smul, smul_inv_smul]

/-- An element of `Int L`, as an automorphism of the Lie algebra `L`. -/
def intLieAlgebraLieEquiv (g : intLieAlgebra K L) : L ≃ₗ⁅K⁆ L :=
  { (g : LinearMap.GeneralLinearGroup K L).toLinearEquiv with
    map_lie' := map_lie_of_mem_intLieAlgebra g.2 _ _ }

/-- `TauCeti.intLieAlgebraLieEquiv g` acts as `g` does. -/
@[simp]
theorem intLieAlgebraLieEquiv_apply (g : intLieAlgebra K L) (x : L) :
    intLieAlgebraLieEquiv g x = (g : LinearMap.GeneralLinearGroup K L) • x :=
  (rfl)

/-- The underlying linear equivalence of `TauCeti.intLieAlgebraLieEquiv g` is that of `g`. -/
@[simp]
theorem intLieAlgebraLieEquiv_toLinearEquiv (g : intLieAlgebra K L) :
    (intLieAlgebraLieEquiv g).toLinearEquiv =
      (g : LinearMap.GeneralLinearGroup K L).toLinearEquiv :=
  (rfl)

/-- On a generator, `TauCeti.intLieAlgebraLieEquiv` is `exp (ad x)`. -/
@[simp]
theorem intLieAlgebraLieEquiv_expAd (x : L) (hx : IsNilpotent (ad K L x)) :
    intLieAlgebraLieEquiv ⟨_, ofLinearEquiv_expAd_mem_intLieAlgebra x hx⟩ = expAd x hx :=
  LieEquiv.ext fun _ => rfl

/-- The identity of `Int L` is the identity automorphism. -/
@[simp]
theorem intLieAlgebraLieEquiv_one : intLieAlgebraLieEquiv (1 : intLieAlgebra K L) = .refl :=
  LieEquiv.ext fun _ => rfl

/-- A product in `Int L` is the composite of the automorphisms, the right factor acting first. -/
theorem intLieAlgebraLieEquiv_mul (g h : intLieAlgebra K L) :
    intLieAlgebraLieEquiv (g * h) = (intLieAlgebraLieEquiv h).trans (intLieAlgebraLieEquiv g) :=
  LieEquiv.ext fun _ => by simp [mul_smul]

/-- An inverse in `Int L` is the inverse automorphism. -/
theorem intLieAlgebraLieEquiv_inv (g : intLieAlgebra K L) :
    intLieAlgebraLieEquiv g⁻¹ = (intLieAlgebraLieEquiv g).symm :=
  LieEquiv.ext fun _ => rfl

end TauCeti

/-! ### Normality -/

namespace LieEquiv

open LieAlgebra LinearMap.GeneralLinearGroup TauCeti

variable {K L : Type*} [CommRing K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]

/-- An automorphism `φ` of `L` intertwines the generator `exp (ad x)` with the generator
`exp (ad (φ x))`. -/
theorem ofLinearEquiv_mul_ofLinearEquiv_expAd (φ : L ≃ₗ⁅K⁆ L) {x : L}
    (hx : IsNilpotent (ad K L x)) :
    ofLinearEquiv φ.toLinearEquiv * ofLinearEquiv (expAd x hx).toLinearEquiv =
      ofLinearEquiv (expAd (φ x) ((φ : L →ₗ⁅K⁆ L).isNilpotent_ad_of_surjective φ.surjective
        hx)).toLinearEquiv * ofLinearEquiv φ.toLinearEquiv := by
  ext y
  exact (φ : L →ₗ⁅K⁆ L).map_expAd hx _ y

/-- Conjugation by an automorphism of `L` maps `Int L` into itself. -/
private theorem map_conj_intLieAlgebra_le (φ : L ≃ₗ⁅K⁆ L) :
    (intLieAlgebra K L).map (MulAut.conj (ofLinearEquiv φ.toLinearEquiv)).toMonoidHom ≤
      intLieAlgebra K L := by
  rw [intLieAlgebra, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
  rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, ofLinearEquiv_mul_ofLinearEquiv_expAd φ hx,
    mul_inv_cancel_right]
  exact ofLinearEquiv_expAd_mem_intLieAlgebra _ _

/-- **`Int L` is normalized by every automorphism of `L`**: conjugation by an automorphism maps
`Int L` onto itself. -/
theorem map_conj_intLieAlgebra (φ : L ≃ₗ⁅K⁆ L) :
    (intLieAlgebra K L).map (MulAut.conj (ofLinearEquiv φ.toLinearEquiv)).toMonoidHom =
      intLieAlgebra K L := by
  refine (map_conj_intLieAlgebra_le φ).antisymm fun g hg => ?_
  have h : ofLinearEquiv φ.toLinearEquiv * ofLinearEquiv φ.symm.toLinearEquiv = 1 := by
    ext y
    simp
  refine ⟨MulAut.conj (ofLinearEquiv φ.symm.toLinearEquiv) g,
    map_conj_intLieAlgebra_le φ.symm ⟨g, hg, rfl⟩, ?_⟩
  rw [MulEquiv.coe_toMonoidHom, ← MulAut.mul_apply, ← map_mul, h, map_one, MulAut.one_apply]

/-- Membership in `Int L` is invariant under conjugation by an automorphism of `L`. -/
theorem conj_mem_intLieAlgebra_iff (φ : L ≃ₗ⁅K⁆ L) {g : LinearMap.GeneralLinearGroup K L} :
    ofLinearEquiv φ.toLinearEquiv * g * (ofLinearEquiv φ.toLinearEquiv)⁻¹ ∈ intLieAlgebra K L ↔
      g ∈ intLieAlgebra K L := by
  conv_lhs => rw [← map_conj_intLieAlgebra φ]
  exact Subgroup.mem_map_iff_mem (MulAut.conj _).injective

end LieEquiv

namespace TauCeti

open LieAlgebra LinearMap.GeneralLinearGroup

variable {K L : Type*} [CommRing K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]

/-! ### Weyl automorphisms and Kostant's subgroup -/

/-- **The Weyl automorphism of an `sl₂` triple is inner**: `exp (ad e) exp (-ad f) exp (ad e)` lies
in `Int L`. -/
theorem ofLinearEquiv_weylAut_mem_intLieAlgebra {h e f : L} (t : IsSl2Triple h e f)
    (he : IsNilpotent (ad K L e)) (hf : IsNilpotent (ad K L f)) :
    ofLinearEquiv (weylAut t he hf).toLinearEquiv ∈ intLieAlgebra K L := by
  have hf' : IsNilpotent (ad K L (-f)) := by simpa using hf.neg
  have h : ofLinearEquiv (weylAut t he hf).toLinearEquiv =
      ofLinearEquiv (expAd e he).toLinearEquiv * ofLinearEquiv (expAd (-f) hf').toLinearEquiv *
        ofLinearEquiv (expAd e he).toLinearEquiv := by
    ext y
    simp [weylAut_apply]
  rw [h]
  exact mul_mem (mul_mem (ofLinearEquiv_expAd_mem_intLieAlgebra e he)
    (ofLinearEquiv_expAd_mem_intLieAlgebra (-f) hf')) (ofLinearEquiv_expAd_mem_intLieAlgebra e he)

/-- **Kostant's subgroup lies in `Int L`**: the subgroup `TauCeti.expAdSubgroup K e` of linear
automorphisms generated by the `exp (ad y)` with `y ∈ ker (ad e) ⊓ [e, L]` is contained in `Int L`
under the identification of linear automorphisms with the general linear group. -/
theorem map_expAdSubgroup_le_intLieAlgebra (e : L) :
    (expAdSubgroup K e).map (generalLinearEquiv K L).symm.toMonoidHom ≤ intLieAlgebra K L := by
  rw [Subgroup.map_le_iff_le_comap, expAdSubgroup_le_iff]
  exact fun y hy _ => ofLinearEquiv_expAd_mem_intLieAlgebra y hy

end TauCeti
