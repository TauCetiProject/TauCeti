module

public import TauCeti.Algebra.Lie.InnerAutomorphism
import TauCeti.Algebra.Lie.AdjointAction.CentralizerFiltration

/-!
# Exponentials along the filtration of a centralizer

Let `L` be a Lie algebra, `e ∈ L`, and `𝔲ₖ = ker (ad e) ⊓ range ((ad e) ^ k)` the filtration of
the centralizer of `e` from `TauCeti.Algebra.Lie.AdjointAction.CentralizerFiltration`. For an
`ad`-nilpotent `y ∈ 𝔲₁ = ker (ad e) ⊓ [e, L]` the inner automorphism `exp (ad y)` fixes `e`.

This file introduces the subgroup of linear automorphisms of `L` generated by these
`exp (ad y)`, the group in which Kostant's conjugacy theorem for `sl₂` triples takes place, and
records how `exp (ad y)` moves vectors along the filtration: over a field of characteristic zero,
if `y` and `⁅y, v⁆` lie in `𝔲ₖ` then `exp (ad y) v = v + ⁅y, v⁆` modulo `𝔲₂ₖ`, because the
bracket compatibility `⁅𝔲ᵢ, 𝔲ⱼ⁆ ⊆ 𝔲ᵢ₊ⱼ` pushes every higher term of the exponential series
into `𝔲₂ₖ`.

## Main definitions

* `TauCeti.expAdSubgroup`: the subgroup generated by the `exp (ad y)` with
  `y ∈ ker (ad e) ⊓ [e, L]`.

## Main results

* `TauCeti.expAdSubgroup_le_iff`: the universal property of `TauCeti.expAdSubgroup`.
* `TauCeti.expAdSubgroup_le_stabilizer`: `TauCeti.expAdSubgroup` fixes `e`.
* `TauCeti.expAd_apply_sub_sub_mem`: `exp (ad y) v - v - ⁅y, v⁆ ∈ 𝔲₂ₖ` when `y, ⁅y, v⁆ ∈ 𝔲ₖ`.

## References

* B. Kostant, *The principal three-dimensional subgroup and the Betti numbers of a complex simple
  Lie group*, Amer. J. Math. **81** (1959), 973–1032.
* D. H. Collingwood and W. M. McGovern, *Nilpotent Orbits in Semisimple Lie Algebras*, Van
  Nostrand Reinhold, 1993, §3.4.
-/

public section

open LieAlgebra

namespace TauCeti

/-! ### The subgroup generated by the `exp (ad y)` -/

section Subgroup

variable {K L : Type*} [CommRing K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]

variable (K) in
/-- The subgroup of linear automorphisms of `L` generated by the automorphisms `exp (ad y)` with
`y ∈ ker (ad e) ⊓ [e, L]`. Kostant's conjugacy theorem takes place in this subgroup. -/
def expAdSubgroup (e : L) : Subgroup (L ≃ₗ[K] L) :=
  Subgroup.closure {φ | ∃ y, ∃ hy : IsNilpotent (ad K L y),
    y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) ∧ (expAd y hy).toLinearEquiv = φ}

/-- Each generator `exp (ad y)`, `y ∈ ker (ad e) ⊓ [e, L]`, lies in `TauCeti.expAdSubgroup`. -/
theorem expAd_toLinearEquiv_mem_expAdSubgroup {e y : L} (hy : IsNilpotent (ad K L y))
    (hye : y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e)) :
    (expAd y hy).toLinearEquiv ∈ expAdSubgroup K e :=
  Subgroup.subset_closure ⟨y, hy, hye, rfl⟩

/-- `TauCeti.expAdSubgroup K e` lies in a subgroup `H` if and only if every generator `exp (ad y)`,
`y ∈ ker (ad e) ⊓ [e, L]`, does. -/
theorem expAdSubgroup_le_iff {e : L} {H : Subgroup (L ≃ₗ[K] L)} :
    expAdSubgroup K e ≤ H ↔ ∀ y (hy : IsNilpotent (ad K L y)),
      y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e) →
        (expAd y hy).toLinearEquiv ∈ H := by
  refine (Subgroup.closure_le _).trans ⟨fun hH y hy hye => hH ⟨y, hy, hye, rfl⟩, ?_⟩
  rintro hH _ ⟨y, hy, hye, rfl⟩
  exact hH y hy hye

/-- `TauCeti.expAdSubgroup K e` lies in the stabilizer of `e`: each generator `exp (ad y)` fixes `e`
because `⁅y, e⁆ = 0`. -/
theorem expAdSubgroup_le_stabilizer (e : L) :
    expAdSubgroup K e ≤ MulAction.stabilizer (L ≃ₗ[K] L) e := by
  refine expAdSubgroup_le_iff.2 fun y hy hmem => ?_
  have hye := (Submodule.mem_inf.mp hmem).1
  rw [LinearMap.mem_ker, ad_apply, ← lie_skew, neg_eq_zero] at hye
  rw [MulAction.mem_stabilizer_iff, LinearEquiv.smul_def,
    LieEquiv.coe_toLinearEquiv]
  exact expAd_apply_of_lie_eq_zero hy hye

/-- Every element of `TauCeti.expAdSubgroup K e` fixes `e`. -/
theorem apply_eq_self_of_mem_expAdSubgroup {e : L} {ψ : L ≃ₗ[K] L}
    (hψ : ψ ∈ expAdSubgroup K e) : ψ e = e :=
  expAdSubgroup_le_stabilizer e hψ

end Subgroup

/-! ### `exp (ad y)` along the filtration -/

section Filtration

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L] [LieAlgebra ℚ L]

/-- If `y` lies in the `k`-th step of the filtration of the centralizer of `e` and `⁅y, v⁆` does
too, then `exp (ad y) v = v + ⁅y, v⁆` up to the `2k`-th step. -/
theorem expAd_apply_sub_sub_mem {e y v : L} {k : ℕ} (hy : IsNilpotent (ad K L y))
    (hyk : y ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k))
    (hyv : ⁅y, v⁆ ∈ LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ k)) :
    expAd y hy v - v - ⁅y, v⁆ ∈
      LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ (k + k)) := by
  set F := fun n : ℕ => LinearMap.ker (ad K L e) ⊓ LinearMap.range (ad K L e ^ n)
  have hpow : ∀ m, (ad K L y ^ (m + 1)) v ∈ F k := by
    intro m
    induction m with
    | zero =>
      rw [zero_add, pow_one, ad_apply]
      exact hyv
    | succ m ih =>
      rw [pow_succ', Module.End.mul_apply, ad_apply]
      exact antitone_ker_inf_range_pow e (Nat.le_add_right k k)
        (lie_mem_ker_inf_range_pow_add hyk ih)
  have hpow₂ (m : ℕ) : (ad K L y ^ (m + 2)) v ∈ F (k + k) := by
    rw [pow_succ', Module.End.mul_apply, ad_apply]
    exact lie_mem_ker_inf_range_pow_add hyk (hpow m)
  obtain ⟨N, hN⟩ := id hy
  rw [expAd_apply_eq_sum hy (k := N + 2) (by rw [pow_add, hN, zero_mul, LinearMap.zero_apply]),
    Finset.sum_range_succ', Finset.sum_range_succ']
  simp only [Nat.factorial_zero, Nat.factorial_one, Nat.cast_one, inv_one, pow_zero, pow_one,
    one_smul, Module.End.one_apply, ad_apply, zero_add]
  rw [add_sub_cancel_right, add_sub_cancel_right]
  exact Submodule.sum_mem _ fun m _ => Submodule.smul_of_tower_mem _ _ (hpow₂ m)

end Filtration

end TauCeti
