/-!
# The shuffle module is an induced module

Let `U` be a module over the Hecke algebra `H_l` on `l` strands, and let `Sh_k(U)` be the shuffle
module of the Hecke algebra `H = TypeAHeckeAlgebra R q (k + l)`
(`TauCeti.TypeAHeckeAlgebra.shuffleRep`). Let `H_J` be the parabolic subalgebra generated by the
generators `T i` crossing two of the first `k` positions or two of the last `l` positions. The
vectors at the initial mask form a copy `ι(U)` of `U`, on which those generators act as on
`triv_k ⊗ U`: by `q` on the first `k` positions, and through `U` on the last `l`. This file proves
that `Sh_k(U)` is the module induced from this `H_J`-module, in the form of the universal property
of induction: for every `H`-module `N`, every linear map `f : U →ₗ[R] N` compatible with the
action of the generators of `H_J` extends uniquely to a map of `H`-modules `Sh_k(U) → N`
(`TauCeti.TypeAHeckeAlgebra.shuffleLift`). Since `H_J` is generated by these generators
(`TauCeti.TypeAHeckeAlgebra.parabolic`), compatibility with them is `H_J`-linearity. This
universal property characterizes `Sh_k(U)`, up to isomorphism, as `H ⊗_{H_J} (triv_k ⊗ U)`; the
tensor product over the noncommutative algebra `H_J` is not formed here.

The extension is explicit. Along a shuffle path `i₁ ⋯ iₘ` to a mask `S`, the *inverse shuffle
word* `T i₁⁻¹ ⋯ T iₘ⁻¹` (`TauCeti.TypeAHeckeAlgebra.shuffleInvWord`) sends the vector `u` at the
initial mask to `(-1) ^ S.length • u` at `S`, so the extension must send the vector `u` at `S` to
`(-1) ^ S.length • T i₁⁻¹ ⋯ T iₘ⁻¹ • f u`. That this is a map of `H`-modules rests on two facts
about the inverse shuffle words in the Hecke algebra itself:

* they do not depend on the shuffle path: two shuffle paths to the same mask differ by
  commutations of distant letters (`ShuffleMask.IsShufflePath.prod_map_eq`);
* a generator `T i` crossing two positions on the same side of `S` passes through the inverse
  shuffle word of `S` and becomes a generator of `H_J`: if both positions are selected it becomes
  the generator crossing the corresponding two of the first `k` positions
  (`TauCeti.TypeAHeckeAlgebra.T_mul_shuffleInvWord_of_mem_of_mem`), and if both are rest positions
  it becomes the generator crossing the corresponding two of the last `l` positions
  (`TauCeti.TypeAHeckeAlgebra.T_mul_shuffleInvWord_of_notMem_of_notMem`).

The second fact is the Hecke algebra form of Deodhar's lemma for the minimal coset
representatives of `S_k × S_l` in `S_(k + l)`. It is proved here directly on shuffle paths, by
induction on the length of the mask, with the braid relation for the generators crossing three
consecutive positions.

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.shuffleInvWord`: the inverse shuffle word of a mask.
* `TauCeti.TypeAHeckeAlgebra.shuffleLift`: the extension of a linear map on `U` to `Sh_k(U)`.

## Main results

* `TauCeti.TypeAHeckeAlgebra.ShuffleMask.IsShufflePath.prod_map_eq`: products along shuffle paths
  do not depend on the path.
* `TauCeti.TypeAHeckeAlgebra.T_mul_shuffleInvWord_of_mem_of_mem` and
  `TauCeti.TypeAHeckeAlgebra.T_mul_shuffleInvWord_of_notMem_of_notMem`: Deodhar's lemma for the
  inverse shuffle words.
* `TauCeti.TypeAHeckeAlgebra.shuffleLift_comp_shuffleRep`, `shuffleLift_single_initial` and
  `TauCeti.TypeAHeckeAlgebra.eq_shuffleLift`: the universal property of the induced module.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52.
* V. V. Deodhar, *On some geometric aspects of Bruhat orderings II. The parabolic analogue of
  Kazhdan-Lusztig polynomials*, J. Algebra 111 (1987), 483–506, Lemma 2.1.
-/

public section

open Finset

namespace TauCeti.TypeAHeckeAlgebra

variable {k l : ℕ}

namespace ShuffleMask

/-- Below a selected position `a` followed by another selected position, there are at most
`k - 2` selected positions. The number of selected positions before `a` is `a - S.restIndex a`. -/
theorem sub_restIndex_add_two_le {S : ShuffleMask k l} {a b : Fin (k + l)}
    (hab : (b : ℕ) = a + 1) (ha : a ∈ S.1) (hb : b ∈ S.1) : (a : ℕ) - S.restIndex a + 2 ≤ k := by
  have h₁ : #{x ∈ S.1 | x < a} + S.restIndex a = a := by
    rw [restIndex_def, ← card_union_of_disjoint (disjoint_filter_filter disjoint_compl_right),
      ← filter_union, union_compl]
    have := Fin.card_filter_val_lt (n := k + l) (m := a)
    simp only [Fin.val_fin_lt] at this
    omega
  have h₂ : insert a (insert b {x ∈ S.1 | x < a}) ⊆ S.1 := by
    intro x
    simp only [mem_insert, mem_filter]
    rintro (rfl | rfl | ⟨hx, -⟩) <;> assumption
  have h₃ := card_le_card h₂
  rw [card_insert_of_notMem (by simp [Fin.ext_iff, hab]),
    card_insert_of_notMem (by simp only [mem_filter, not_and, Fin.lt_def, hab]; omega), S.2] at h₃
  omega

/-- The two ways a word can be a shuffle path: the empty word reaching the initial mask, or a
letter moving a selected position forward, after a shuffle path to the previous mask. -/
private theorem IsShufflePath.eq_nil_or_exists {w : List (Fin (k + l - 1))} {S : ShuffleMask k l}
    (h : IsShufflePath w S) :
    (w = [] ∧ S = initial) ∨ ∃ i w₁ S₁, w = i :: w₁ ∧ IsShufflePath w₁ S₁ ∧
      BraidGroup.strand i ∈ S₁.1 ∧ BraidGroup.strandSucc i ∉ S₁.1 ∧
      S = S₁.swap (BraidGroup.strand i) (BraidGroup.strandSucc i) := by
  cases h with
  | nil => exact .inl ⟨rfl, rfl⟩
  | cons h ha hb => exact .inr ⟨_, _, _, rfl, h, ha, hb, rfl⟩

/-- Two different letters ending shuffle paths to the same mask `S` move selected positions of
`S` past different rest positions. They are distant letters, and the masks before them have a
common predecessor, reached by a shuffle path `w` followed by either letter. -/
private theorem exists_isShufflePath_cons_cons {i j : Fin (k + l - 1)} (hij : i ≠ j)
    {S S₁ S₂ : ShuffleMask k l} (ha : BraidGroup.strand i ∈ S₁.1)
    (hb : BraidGroup.strandSucc i ∉ S₁.1) (hS₁ : S = S₁.swap (BraidGroup.strand i)
      (BraidGroup.strandSucc i))
    (hc : BraidGroup.strand j ∈ S₂.1) (hd : BraidGroup.strandSucc j ∉ S₂.1)
    (hS₂ : S = S₂.swap (BraidGroup.strand j) (BraidGroup.strandSucc j)) :
    ((i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) ∧
      ∃ w, IsShufflePath (j :: w) S₁ ∧ IsShufflePath (i :: w) S₂ := by
  set a := BraidGroup.strand i
  set b := BraidGroup.strandSucc i
  set c := BraidGroup.strand j
  set d := BraidGroup.strandSucc j
  have ha' : a ∉ S.1 := by rwa [hS₁, mem_swap, Equiv.swap_apply_left]
  have hb' : b ∈ S.1 := by rwa [hS₁, mem_swap, Equiv.swap_apply_right]
  have hc' : c ∉ S.1 := by rwa [hS₂, mem_swap, Equiv.swap_apply_left]
  have hd' : d ∈ S.1 := by rwa [hS₂, mem_swap, Equiv.swap_apply_right]
  have hbc : (b : ℕ) ≠ c := fun h ↦ hc' (Fin.ext h ▸ hb')
  have had : (a : ℕ) ≠ d := fun h ↦ ha' (Fin.ext h ▸ hd')
  have hval : (i : ℕ) ≠ j := fun h ↦ hij (Fin.ext h)
  simp only [a, b, c, d, BraidGroup.val_strand, BraidGroup.val_strandSucc] at hbc had
  have hnd : [a, b, c, d].Nodup := by
    simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, Fin.ext_iff, a, b, c, d,
      BraidGroup.val_strand, BraidGroup.val_strandSucc, List.nodup_nil, or_false,
      not_false_eq_true, and_true]
    omega
  have hnd' := hnd
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or] at hnd'
  obtain ⟨⟨-, hac, had⟩, ⟨hbc, hbd⟩, -, -⟩ := hnd'
  refine ⟨by omega, ?_⟩
  obtain ⟨w, hw⟩ := exists_isShufflePath ((S.swap a b).swap c d)
  refine ⟨w, ?_, ?_⟩
  · have := hw.cons (i := j)
      (by rwa [mem_swap, Equiv.swap_apply_left, mem_swap,
        Equiv.swap_apply_of_ne_of_ne (Ne.symm had) (Ne.symm hbd)])
      (by rwa [mem_swap, Equiv.swap_apply_right, mem_swap,
        Equiv.swap_apply_of_ne_of_ne (Ne.symm hac) (Ne.symm hbc)])
    rwa [swap_swap, hS₁, swap_swap] at this
  · rw [swap_swap_comm hnd] at hw
    have := hw.cons (i := i)
      (by rwa [mem_swap, Equiv.swap_apply_left, mem_swap, Equiv.swap_apply_of_ne_of_ne hbc hbd])
      (by rwa [mem_swap, Equiv.swap_apply_right, mem_swap, Equiv.swap_apply_of_ne_of_ne hac had])
    rwa [swap_swap, hS₂, swap_swap] at this

/-- **Shuffle paths are unique up to distant commutations.** In a monoid in which the images of
distant letters commute, any two shuffle paths to the same mask have the same product. -/
theorem IsShufflePath.prod_map_eq {M : Type*} [Monoid M] {g : Fin (k + l - 1) → M}
    (hg : ∀ i j : Fin (k + l - 1), (i : ℕ) + 2 ≤ j → Commute (g i) (g j))
    {w w' : List (Fin (k + l - 1))} {S : ShuffleMask k l} (h : IsShufflePath w S)
    (h' : IsShufflePath w' S) : (w.map g).prod = (w'.map g).prod := by
  induction hn : w.length generalizing w w' S with
  | zero =>
    have hw' : w'.length = 0 := by rw [h'.length_eq, ← h.length_eq, hn]
    rw [List.length_eq_zero_iff.1 hn, List.length_eq_zero_iff.1 hw']
  | succ n ih =>
    obtain ⟨rfl, -⟩ | ⟨i, w₁, S₁, rfl, h₁, ha, hb, hS₁⟩ := h.eq_nil_or_exists
    · simp at hn
    have hlen := length_swap_of_mem_of_notMem (by simp) ha hb
    obtain ⟨rfl, hS⟩ | ⟨j, w₂, S₂, rfl, h₂, hc, hd, hS₂⟩ := h'.eq_nil_or_exists
    · rw [← hS₁, hS, length_initial] at hlen
      omega
    have hlen' := length_swap_of_mem_of_notMem (by simp) hc hd
    rw [List.length_cons, add_left_inj, h₁.length_eq] at hn
    rw [← hS₁] at hlen
    rw [← hS₂] at hlen'
    simp only [List.map_cons, List.prod_cons]
    by_cases hij : i = j
    · subst hij
      obtain rfl : S₁ = S₂ := by
        simpa using congrArg (swap (BraidGroup.strand i) (BraidGroup.strandSucc i))
          (hS₁.symm.trans hS₂)
      rw [ih h₁ h₂ (by rw [h₁.length_eq, hn])]
    obtain ⟨hdist, w₃, h₃₁, h₃₂⟩ := exists_isShufflePath_cons_cons hij ha hb hS₁ hc hd hS₂
    rw [ih h₁ h₃₁ (by rw [h₁.length_eq, hn]), ih h₂ h₃₂ (by rw [h₂.length_eq]; omega)]
    simp only [List.map_cons, List.prod_cons, ← mul_assoc]
    rcases hdist with h | h
    · rw [(hg i j h).eq]
    · rw [(hg j i h).eq]

end ShuffleMask

variable {R : Type*} [CommRing R] {q : Rˣ}

/-- A generator passes an inverse generator on a disjoint pair of strands. -/
private theorem T_mul_inv_unitT_mul {n : ℕ} {i γ : Fin (n - 1)}
    (h : (i : ℕ) + 2 ≤ γ ∨ (γ : ℕ) + 2 ≤ i) {Y Z : TypeAHeckeAlgebra R q n}
    (hY : T q i * Y = Y * Z) :
    T q i * (↑(unitT q γ)⁻¹ * Y) = ↑(unitT q γ)⁻¹ * Y * Z := by
  have : Commute (T q i) (unitT q γ : TypeAHeckeAlgebra R q n) := by
    simpa only [val_unitT] using commute_T h
  rw [← mul_assoc, this.units_inv_right.eq, mul_assoc, hY, mul_assoc]

/-- The braid relation in the form `T i * T γ⁻¹ * T i⁻¹ = T γ⁻¹ * T i⁻¹ * T γ`, for generators on
adjacent pairs of strands. -/
private theorem T_mul_inv_unitT_mul_inv_unitT_mul {n : ℕ} {i γ : Fin (n - 1)}
    (h : (i : ℕ) + 1 = γ ∨ (γ : ℕ) + 1 = i) {Y Z : TypeAHeckeAlgebra R q n}
    (hY : T q γ * Y = Y * Z) :
    T q i * (↑(unitT q γ)⁻¹ * (↑(unitT q i)⁻¹ * Y)) =
      ↑(unitT q γ)⁻¹ * (↑(unitT q i)⁻¹ * Y) * Z := by
  rw [← val_unitT (q := q) i, ← val_unitT (q := q) γ] at *
  set x := unitT q i
  set y := unitT q γ
  have hb : x * y * x = y * x * y := by
    ext
    simpa only [Units.val_mul, x, y, val_unitT] using T_braid h
  have h' : x⁻¹ * y⁻¹ * x⁻¹ = y⁻¹ * x⁻¹ * y⁻¹ := by
    simpa only [mul_inv_rev, mul_assoc] using congrArg Inv.inv hb
  have hinv : x * y⁻¹ * x⁻¹ = y⁻¹ * x⁻¹ * y :=
    calc x * y⁻¹ * x⁻¹ = x * (y⁻¹ * x⁻¹ * y⁻¹) * y := by group
      _ = x * (x⁻¹ * y⁻¹ * x⁻¹) * y := by rw [h']
      _ = y⁻¹ * x⁻¹ * y := by group
  have hval := congrArg Units.val hinv
  simp only [Units.val_mul] at hval
  calc (x : TypeAHeckeAlgebra R q n) * (↑y⁻¹ * (↑x⁻¹ * Y)) = ↑x * ↑y⁻¹ * ↑x⁻¹ * Y := by
        simp only [mul_assoc]
    _ = ↑y⁻¹ * ↑x⁻¹ * (↑y * Y) := by rw [hval, mul_assoc]
    _ = ↑y⁻¹ * (↑x⁻¹ * Y) * Z := by rw [hY]; simp only [mul_assoc]

variable (q) in
/-- The **inverse shuffle word** of a mask `S`: the product `T i₁⁻¹ ⋯ T iₘ⁻¹` along a shuffle path
`i₁ ⋯ iₘ` to `S`. It does not depend on the path
(`TauCeti.TypeAHeckeAlgebra.ShuffleMask.IsShufflePath.prod_map_inv_unitT`), and it sends the
vector `u` at the initial mask of the shuffle module to `(-1) ^ S.length • u` at `S`
(`TauCeti.TypeAHeckeAlgebra.shuffleRep_shuffleInvWord_single_initial`). -/
noncomputable def shuffleInvWord (S : ShuffleMask k l) : TypeAHeckeAlgebra R q (k + l) :=
  ((ShuffleMask.exists_isShufflePath S).choose.map
    fun i ↦ (↑(unitT q i)⁻¹ : TypeAHeckeAlgebra R q (k + l))).prod

/-- The product of the inverse generators along any shuffle path to `S` is the inverse shuffle
word of `S`. -/
theorem ShuffleMask.IsShufflePath.prod_map_inv_unitT {w : List (Fin (k + l - 1))}
    {S : ShuffleMask k l} (h : ShuffleMask.IsShufflePath w S) :
    (w.map fun i ↦ (↑(unitT q i)⁻¹ : TypeAHeckeAlgebra R q (k + l))).prod =
      shuffleInvWord q S :=
  h.prod_map_eq (fun _ _ hij ↦ commute_inv_unitT (.inl hij))
    (ShuffleMask.exists_isShufflePath S).choose_spec

/-- The inverse shuffle word of the initial mask is `1`. -/
@[simp]
theorem shuffleInvWord_initial :
    shuffleInvWord q (ShuffleMask.initial : ShuffleMask k l) = 1 := by
  simp [← ShuffleMask.IsShufflePath.nil.prod_map_inv_unitT]

/-- Moving a selected position `strand i` forward past the rest position after it multiplies the
inverse shuffle word by `T i⁻¹` on the left. -/
theorem shuffleInvWord_swap {i : Fin (k + l - 1)} {S : ShuffleMask k l}
    (ha : BraidGroup.strand i ∈ S.1) (hb : BraidGroup.strandSucc i ∉ S.1) :
    shuffleInvWord q (S.swap (BraidGroup.strand i) (BraidGroup.strandSucc i)) =
      ↑(unitT q i)⁻¹ * shuffleInvWord q S := by
  obtain ⟨w, hw⟩ := ShuffleMask.exists_isShufflePath S
  rw [← (hw.cons ha hb).prod_map_inv_unitT, ← hw.prod_map_inv_unitT, List.map_cons,
    List.prod_cons]

/-- The inverse shuffle word of `S` sends the vector `u` at the initial mask to
`(-1) ^ S.length • u` at `S`. -/
theorem shuffleRep_shuffleInvWord_single_initial {U : Type*} [AddCommGroup U] [Module R U]
    (ρ : TypeAHeckeAlgebra R q l →ₐ[R] Module.End R U) (S : ShuffleMask k l) (u : U) :
    shuffleRep k ρ (shuffleInvWord q S) (Pi.single ShuffleMask.initial u) =
      (-1 : R) ^ S.length • Pi.single S u := by
  obtain ⟨w, hw⟩ := ShuffleMask.exists_isShufflePath S
  rw [← hw.prod_map_inv_unitT, hw.shuffleRep_prod_val_inv_unitT_single_initial]

/-- If `strand γ` is a rest position of `S` followed by a selected position, the inverse shuffle
word of `S` is `T γ⁻¹` times that of the mask exchanging the two positions. -/
private theorem shuffleInvWord_eq_inv_unitT_mul {γ : Fin (k + l - 1)} {S : ShuffleMask k l}
    (hc : BraidGroup.strand γ ∉ S.1) (hd : BraidGroup.strandSucc γ ∈ S.1) :
    shuffleInvWord q S = ↑(unitT q γ)⁻¹ *
      shuffleInvWord q (S.swap (BraidGroup.strand γ) (BraidGroup.strandSucc γ)) := by
  conv_lhs => rw [← ShuffleMask.swap_swap (BraidGroup.strand γ) (BraidGroup.strandSucc γ) S]
  exact shuffleInvWord_swap (by simpa using hd) (by simpa using hc)

/-- A mask other than the initial one has a rest position `strand γ` followed by a selected
position. -/
private theorem exists_strand_notMem_strandSucc_mem {S : ShuffleMask k l}
    (hS : S ≠ ShuffleMask.initial) :
    ∃ γ : Fin (k + l - 1), BraidGroup.strand γ ∉ S.1 ∧ BraidGroup.strandSucc γ ∈ S.1 := by
  obtain ⟨a, b, hab, ha, hb⟩ := ShuffleMask.exists_notMem_mem_of_ne_initial hS
  obtain ⟨γ, rfl, rfl⟩ : ∃ γ : Fin (k + l - 1),
      BraidGroup.strand γ = a ∧ BraidGroup.strandSucc γ = b :=
    ⟨⟨a, by have := b.isLt; omega⟩, Fin.ext (BraidGroup.val_strand _),
      Fin.ext ((BraidGroup.val_strandSucc _).trans hab.symm)⟩
  exact ⟨γ, ha, hb⟩

open ShuffleMask in
/-- The braid step of Deodhar's lemma for selected positions: the selected positions `strand i`
and `strandSucc i` are preceded by the rest position `strand γ`. -/
private theorem T_mul_shuffleInvWord_of_mem_of_mem_of_succ_eq {i γ : Fin (k + l - 1)}
    (hγ : (γ : ℕ) + 1 = i) {S : ShuffleMask k l} (hc : BraidGroup.strand γ ∉ S.1)
    (ha : BraidGroup.strand i ∈ S.1) (hb : BraidGroup.strandSucc i ∈ S.1)
    (ih : ∀ S' : ShuffleMask k l, S'.length < S.length → BraidGroup.strand γ ∈ S'.1 →
      BraidGroup.strandSucc γ ∈ S'.1 → T q γ * shuffleInvWord q S' =
        shuffleInvWord q S' * T q ⟨γ - S'.restIndex (BraidGroup.strand γ), by omega⟩) :
    T q i * shuffleInvWord q S =
      shuffleInvWord q S * T q ⟨i - S.restIndex (BraidGroup.strand i), by omega⟩ := by
  have hda : BraidGroup.strandSucc γ = BraidGroup.strand i := by ext; simp [hγ]
  -- Before `γ`, the position `strand i` was moved forward past `strandSucc i`.
  set S₂ := (S.swap (BraidGroup.strand γ) (BraidGroup.strand i)).swap (BraidGroup.strand i)
    (BraidGroup.strandSucc i)
  have hne₁ : BraidGroup.strandSucc i ≠ BraidGroup.strand γ := by
    intro h; have := congrArg Fin.val h; simp at this; omega
  have hne₂ : BraidGroup.strandSucc i ≠ BraidGroup.strand i := by
    intro h; simpa using congrArg Fin.val h
  have hne₃ : BraidGroup.strand γ ≠ BraidGroup.strand i := by
    rw [← hda]; intro h; simpa using congrArg Fin.val h
  have ha₂ : BraidGroup.strand i ∈ S₂.1 := by
    simpa [S₂, Equiv.swap_apply_of_ne_of_ne hne₁ hne₂] using hb
  have hb₂ : BraidGroup.strandSucc i ∉ S₂.1 := by simpa [S₂] using hc
  have hc₂ : BraidGroup.strand γ ∈ S₂.1 := by
    simpa [S₂, Equiv.swap_apply_of_ne_of_ne hne₃ hne₁.symm] using ha
  have hW₂ := shuffleInvWord_swap (q := q) ha₂ hb₂
  have hlt := length_swap_add_one_of_notMem_of_mem (a := BraidGroup.strand γ)
    (b := BraidGroup.strandSucc γ) (by simp) hc (by rwa [hda])
  have hlt₂ := length_swap_of_mem_of_notMem (by simp) ha₂ hb₂
  rw [swap_swap] at hW₂ hlt₂
  rw [hda] at hlt
  have key := ih _ (by omega) hc₂ (by rwa [hda])
  -- The selected positions before `strand γ` in `S₂` are those before `strand i` in `S`.
  have r₁ : S₂.restIndex (BraidGroup.strand γ) =
      (S.swap (BraidGroup.strand γ) (BraidGroup.strand i)).restIndex (BraidGroup.strand γ) :=
    restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand,
      BraidGroup.val_strandSucc]; omega)
  have r₂ : (S.swap (BraidGroup.strand γ) (BraidGroup.strand i)).restIndex
      (BraidGroup.strand γ) = S.restIndex (BraidGroup.strand γ) :=
    restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand]; omega)
  have r₃ : S.restIndex (BraidGroup.strand i) = S.restIndex (BraidGroup.strand γ) + 1 :=
    restIndex_of_notMem (by simp only [BraidGroup.val_strand]; omega) hc
  rw [shuffleInvWord_eq_inv_unitT_mul hc (hda ▸ ha), hda, hW₂,
    T_mul_inv_unitT_mul_inv_unitT_mul (.inr hγ) key]
  congr 2
  ext
  simp only [r₁, r₂, r₃]
  omega

open ShuffleMask in
/-- **Deodhar's lemma for selected positions.** If both positions crossed by `T i` are selected in
`S`, then `T i` passes through the inverse shuffle word of `S` and becomes the generator crossing
the corresponding two of the first `k` positions: the first position `strand i` is preceded by
`i - S.restIndex (strand i)` selected positions. -/
theorem T_mul_shuffleInvWord_of_mem_of_mem {i : Fin (k + l - 1)} {S : ShuffleMask k l}
    (ha : BraidGroup.strand i ∈ S.1) (hb : BraidGroup.strandSucc i ∈ S.1) :
    T q i * shuffleInvWord q S =
      shuffleInvWord q S * T q ⟨i - S.restIndex (BraidGroup.strand i), by omega⟩ := by
  induction hn : S.length using Nat.strong_induction_on generalizing S i with
  | _ n ih =>
  subst hn
  by_cases hS : S = initial
  · subst hS
    have hi : (i : ℕ) + 1 < k := by simpa using hb
    rw [shuffleInvWord_initial, one_mul, mul_one]
    congr 1
    ext
    simp only [restIndex_initial, BraidGroup.val_strand]
    omega
  -- Split off the last step `γ` of a shuffle path to `S`.
  obtain ⟨γ, hc, hd⟩ := exists_strand_notMem_strandSucc_mem hS
  have hca : (γ : ℕ) ≠ i := fun h ↦ hc (by convert ha using 2; ext; simp [h])
  have hcb : (γ : ℕ) ≠ i + 1 := fun h ↦ hc (by convert hb using 2; ext; simp [h])
  rcases (show (γ : ℕ) + 1 = i ∨ (γ : ℕ) + 2 ≤ i ∨ (i : ℕ) + 2 ≤ γ by omega) with hγ | hγ
  · exact T_mul_shuffleInvWord_of_mem_of_mem_of_succ_eq hγ hc ha hb
      fun S' hS' h₁ h₂ ↦ ih _ hS' h₁ h₂ rfl
  -- Otherwise `γ` does not move the positions crossed by `T i`.
  have hlt := length_swap_add_one_of_notMem_of_mem (by simp) hc hd
  have hne₁ : BraidGroup.strand i ≠ BraidGroup.strand γ := by simp [Fin.ext_iff]; omega
  have hne₂ : BraidGroup.strand i ≠ BraidGroup.strandSucc γ := by simp [Fin.ext_iff]; omega
  have hne₃ : BraidGroup.strandSucc i ≠ BraidGroup.strand γ := by simp [Fin.ext_iff]; omega
  have hne₄ : BraidGroup.strandSucc i ≠ BraidGroup.strandSucc γ := by simp [Fin.ext_iff]; omega
  rw [shuffleInvWord_eq_inv_unitT_mul hc hd, T_mul_inv_unitT_mul (by omega)
    (ih _ (by omega) (by simpa [Equiv.swap_apply_of_ne_of_ne hne₁ hne₂] using ha)
      (by simpa [Equiv.swap_apply_of_ne_of_ne hne₃ hne₄] using hb) rfl)]
  congr 2
  ext
  simp only
  rw [restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand,
    BraidGroup.val_strandSucc]; omega)]

open ShuffleMask in
/-- The braid step of Deodhar's lemma for rest positions: the rest positions `strand i` and
`strandSucc i` are followed by the selected position `strandSucc γ`. -/
private theorem T_mul_shuffleInvWord_of_notMem_of_notMem_of_succ_eq {i γ : Fin (k + l - 1)}
    (hγ : (i : ℕ) + 1 = γ) {S : ShuffleMask k l} (hd : BraidGroup.strandSucc γ ∈ S.1)
    (ha : BraidGroup.strand i ∉ S.1) (hb : BraidGroup.strandSucc i ∉ S.1)
    (ih : ∀ S' : ShuffleMask k l, S'.length < S.length → ∀ (hc' : BraidGroup.strand γ ∉ S'.1)
      (hd' : BraidGroup.strandSucc γ ∉ S'.1), T q γ * shuffleInvWord q S' =
        shuffleInvWord q S' * T q ⟨k + S'.restIndex (BraidGroup.strand γ),
          by have := restIndex_lt_sub_one (by simp [Fin.lt_def]) hc' hd'; omega⟩) :
    T q i * shuffleInvWord q S =
      shuffleInvWord q S * T q ⟨k + S.restIndex (BraidGroup.strand i),
        by have := restIndex_lt_sub_one (by simp [Fin.lt_def]) ha hb; omega⟩ := by
  have hcb : BraidGroup.strand γ = BraidGroup.strandSucc i := by ext; simp [hγ]
  -- Before `γ`, a selected position was moved forward past `strand i`.
  set S₂ := (S.swap (BraidGroup.strandSucc i) (BraidGroup.strandSucc γ)).swap
    (BraidGroup.strand i) (BraidGroup.strandSucc i)
  have hne₁ : BraidGroup.strand i ≠ BraidGroup.strandSucc i := by
    intro h; simpa using congrArg Fin.val h
  have hne₂ : BraidGroup.strand i ≠ BraidGroup.strandSucc γ := by
    intro h; have := congrArg Fin.val h; simp at this; omega
  have hne₃ : BraidGroup.strandSucc γ ≠ BraidGroup.strandSucc i := by
    intro h; have := congrArg Fin.val h; simp at this; omega
  have ha₂ : BraidGroup.strand i ∈ S₂.1 := by simpa [S₂] using hd
  have hb₂ : BraidGroup.strandSucc i ∉ S₂.1 := by
    simpa [S₂, Equiv.swap_apply_of_ne_of_ne hne₁ hne₂] using ha
  have hd₂ : BraidGroup.strandSucc γ ∉ S₂.1 := by
    simpa [S₂, Equiv.swap_apply_of_ne_of_ne hne₂.symm hne₃] using hb
  have hW₂ := shuffleInvWord_swap (q := q) ha₂ hb₂
  have hlt := length_swap_add_one_of_notMem_of_mem (by simp) (hcb ▸ hb) hd
  have hlt₂ := length_swap_of_mem_of_notMem (by simp) ha₂ hb₂
  rw [swap_swap] at hW₂ hlt₂
  rw [hcb] at hlt
  have key := ih _ (by omega) (by rwa [hcb]) hd₂
  -- The rest positions before `strand γ` in `S₂` are those before `strand i` in `S`.
  have r₁ : S₂.restIndex (BraidGroup.strandSucc i) = S₂.restIndex (BraidGroup.strand i) :=
    restIndex_of_mem (by simp) ha₂
  have r₂ : S₂.restIndex (BraidGroup.strand i) =
      (S.swap (BraidGroup.strandSucc i) (BraidGroup.strandSucc γ)).restIndex
        (BraidGroup.strand i) :=
    restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand,
      BraidGroup.val_strandSucc]; omega)
  have r₃ : (S.swap (BraidGroup.strandSucc i) (BraidGroup.strandSucc γ)).restIndex
      (BraidGroup.strand i) = S.restIndex (BraidGroup.strand i) :=
    restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand,
      BraidGroup.val_strandSucc]; omega)
  rw [shuffleInvWord_eq_inv_unitT_mul (hcb ▸ hb) hd, hcb, hW₂,
    T_mul_inv_unitT_mul_inv_unitT_mul (.inl hγ) key]
  congr 2
  ext
  simp only [hcb, r₁, r₂, r₃]

open ShuffleMask in
/-- **Deodhar's lemma for rest positions.** If neither position crossed by `T i` is selected in
`S`, then `T i` passes through the inverse shuffle word of `S` and becomes the generator crossing
the corresponding two of the last `l` positions: the first position `strand i` is the
`S.restIndex (strand i)`-th rest position. -/
theorem T_mul_shuffleInvWord_of_notMem_of_notMem {i : Fin (k + l - 1)} {S : ShuffleMask k l}
    (ha : BraidGroup.strand i ∉ S.1) (hb : BraidGroup.strandSucc i ∉ S.1) :
    T q i * shuffleInvWord q S =
      shuffleInvWord q S * T q ⟨k + S.restIndex (BraidGroup.strand i),
        by have := restIndex_lt_sub_one (by simp [Fin.lt_def]) ha hb; omega⟩ := by
  induction hn : S.length using Nat.strong_induction_on generalizing S i with
  | _ n ih =>
  subst hn
  by_cases hS : S = initial
  · subst hS
    have hi : k ≤ (i : ℕ) := by simpa using ha
    rw [shuffleInvWord_initial, one_mul, mul_one]
    congr 1
    ext
    simp only [restIndex_initial, BraidGroup.val_strand]
    omega
  -- Split off the last step `γ` of a shuffle path to `S`.
  obtain ⟨γ, hc, hd⟩ := exists_strand_notMem_strandSucc_mem hS
  have hca : (γ : ℕ) ≠ i := fun h ↦ hb (by convert hd using 2; ext; simp [h])
  have hcb : (γ : ℕ) + 1 ≠ i := fun h ↦ ha (by convert hd using 2; ext; simp [h])
  rcases (show (i : ℕ) + 1 = γ ∨ (γ : ℕ) + 2 ≤ i ∨ (i : ℕ) + 2 ≤ γ by omega) with hγ | hγ
  · exact T_mul_shuffleInvWord_of_notMem_of_notMem_of_succ_eq hγ hd ha hb
      fun S' hS' h₁ h₂ ↦ ih _ hS' h₁ h₂ rfl
  -- Otherwise `γ` does not move the positions crossed by `T i`.
  have hlt := length_swap_add_one_of_notMem_of_mem (by simp) hc hd
  have hne₁ : BraidGroup.strand i ≠ BraidGroup.strand γ := by simp [Fin.ext_iff]; omega
  have hne₂ : BraidGroup.strand i ≠ BraidGroup.strandSucc γ := by simp [Fin.ext_iff]; omega
  have hne₃ : BraidGroup.strandSucc i ≠ BraidGroup.strand γ := by simp [Fin.ext_iff]; omega
  have hne₄ : BraidGroup.strandSucc i ≠ BraidGroup.strandSucc γ := by simp [Fin.ext_iff]; omega
  rw [shuffleInvWord_eq_inv_unitT_mul hc hd, T_mul_inv_unitT_mul (by omega)
    (ih _ (by omega) (by simpa [Equiv.swap_apply_of_ne_of_ne hne₁ hne₂] using ha)
      (by simpa [Equiv.swap_apply_of_ne_of_ne hne₃ hne₄] using hb) rfl)]
  congr 2
  ext
  simp only
  rw [restIndex_swap (by simp only [Fin.lt_def, BraidGroup.val_strand,
    BraidGroup.val_strandSucc]; omega)]

section Lift

variable {U : Type*} [AddCommGroup U] [Module R U] {N : Type*} [AddCommGroup N] [Module R N]
variable (ρ : TypeAHeckeAlgebra R q l →ₐ[R] Module.End R U)
  (σ : TypeAHeckeAlgebra R q (k + l) →ₐ[R] Module.End R N)

/-- The **extension of a linear map** `f : U →ₗ[R] N` to the shuffle module: the vector `u` at a
mask `S` is sent to `(-1) ^ S.length • shuffleInvWord q S • f u`. If `f` is compatible with the
generators of the parabolic subalgebra `H_J`, this is the unique map of Hecke modules from
`Sh_k(U)` to `N` extending `f` from the initial mask
(`TauCeti.TypeAHeckeAlgebra.shuffleLift_comp_shuffleRep`,
`TauCeti.TypeAHeckeAlgebra.eq_shuffleLift`). -/
noncomputable def shuffleLift (f : U →ₗ[R] N) : (ShuffleMask k l → U) →ₗ[R] N :=
  ∑ S, (-1 : R) ^ S.length • (σ (shuffleInvWord q S) ∘ₗ f ∘ₗ LinearMap.proj S)

/-- The extension sends the vector `u` at `S` to `(-1) ^ S.length • shuffleInvWord q S • f u`. -/
theorem shuffleLift_single (f : U →ₗ[R] N) (S : ShuffleMask k l) (u : U) :
    shuffleLift σ f (Pi.single S u) = (-1 : R) ^ S.length • σ (shuffleInvWord q S) (f u) := by
  rw [shuffleLift, LinearMap.sum_apply, Finset.sum_eq_single S]
  · simp
  · intro M _ hM
    simp [Pi.single_eq_of_ne hM]
  · simp

/-- The extension agrees with `f` on the initial mask. -/
@[simp]
theorem shuffleLift_single_initial (f : U →ₗ[R] N) (u : U) :
    shuffleLift σ f (Pi.single ShuffleMask.initial u) = f u := by
  simp [shuffleLift_single]

variable {σ} in
/-- The extension of a compatible map commutes with the action of a generator. -/
private theorem shuffleLift_comp_shuffleRep_T {f : U →ₗ[R] N}
    (hsel : ∀ i : Fin (k + l - 1), (i : ℕ) + 1 < k → σ (T q i) ∘ₗ f = (q : R) • f)
    (hrest : ∀ j : Fin (l - 1), σ (T q ⟨k + j, by omega⟩) ∘ₗ f = f ∘ₗ ρ (T q j))
    (i : Fin (k + l - 1)) :
    shuffleLift σ f ∘ₗ shuffleRep k ρ (T q i) = σ (T q i) ∘ₗ shuffleLift σ f := by
  refine LinearMap.pi_ext fun S u ↦ ?_
  simp only [LinearMap.comp_apply]
  by_cases ha : BraidGroup.strand i ∈ S.1 <;> by_cases hb : BraidGroup.strandSucc i ∈ S.1
  · have hsel' := LinearMap.congr_fun
      (hsel ⟨i - S.restIndex (BraidGroup.strand i), by omega⟩ (by
      have := ShuffleMask.sub_restIndex_add_two_le (by simp) ha hb
      simp only [BraidGroup.val_strand] at this
      simp only
      omega)) u
    rw [LinearMap.comp_apply] at hsel'
    rw [shuffleRep_T_single_of_mem_of_mem ρ ha hb, map_smul, shuffleLift_single, map_smul,
      ← mul_apply_eq_comp, ← map_mul, T_mul_shuffleInvWord_of_mem_of_mem ha hb, map_mul,
      mul_apply_eq_comp, hsel', LinearMap.smul_apply, map_smul, smul_comm]
  · rw [shuffleRep_T_single_of_mem_of_notMem ρ ha hb, map_sub, map_smul, shuffleLift_single,
      shuffleLift_single, ShuffleMask.length_swap_of_mem_of_notMem (by simp) ha hb,
      shuffleInvWord_swap ha hb, map_smul, val_inv_unitT, map_mul, map_sub, AlgHom.commutes,
      mul_apply_eq_comp, LinearMap.sub_apply, Module.algebraMap_end_apply, pow_succ]
    module
  · set S' := S.swap (BraidGroup.strand i) (BraidGroup.strandSucc i)
    have ha' : BraidGroup.strand i ∈ S'.1 := by simpa [S'] using hb
    have hb' : BraidGroup.strandSucc i ∉ S'.1 := by simpa [S'] using ha
    have hW : shuffleInvWord q S = ↑(unitT q i)⁻¹ * shuffleInvWord q S' := by
      rw [← shuffleInvWord_swap ha' hb', ShuffleMask.swap_swap]
    have hlen : S'.length + 1 = S.length :=
      ShuffleMask.length_swap_add_one_of_notMem_of_mem (by simp) ha hb
    rw [shuffleRep_T_single_of_notMem_of_mem ρ ha hb, map_neg, shuffleLift_single,
      shuffleLift_single, hW, ← hlen, map_smul, ← mul_apply_eq_comp, ← map_mul, ← mul_assoc,
      ← val_unitT (q := q) i, Units.mul_inv, one_mul, pow_succ]
    module
  · have hrest' := LinearMap.congr_fun
      (hrest ⟨S.restIndex (BraidGroup.strand i), ShuffleMask.restIndex_lt_sub_one
        (by simp [Fin.lt_def]) ha hb⟩) u
    rw [LinearMap.comp_apply, LinearMap.comp_apply] at hrest'
    rw [shuffleRep_T_single_of_notMem_of_notMem ρ ha hb, shuffleLift_single, shuffleLift_single,
      map_smul, ← mul_apply_eq_comp, ← map_mul, T_mul_shuffleInvWord_of_notMem_of_notMem ha hb,
      map_mul, mul_apply_eq_comp, ← hrest']

variable {σ} in
/-- **The shuffle module is induced from `triv_k ⊗ U`.** If `f : U →ₗ[R] N` is compatible with
the generators of the parabolic subalgebra `H_J`, in that the generators crossing two of the first
`k` positions act on its image by `q` and those crossing two of the last `l` positions act as on
`U`, then its extension `shuffleLift σ f` is a map of modules over the Hecke algebra on `k + l`
strands. -/
theorem shuffleLift_comp_shuffleRep {f : U →ₗ[R] N}
    (hsel : ∀ i : Fin (k + l - 1), (i : ℕ) + 1 < k → σ (T q i) ∘ₗ f = (q : R) • f)
    (hrest : ∀ j : Fin (l - 1), σ (T q ⟨k + j, by omega⟩) ∘ₗ f = f ∘ₗ ρ (T q j))
    (x : TypeAHeckeAlgebra R q (k + l)) :
    shuffleLift σ f ∘ₗ shuffleRep k ρ x = σ x ∘ₗ shuffleLift σ f := by
  have hx : x ∈ Algebra.adjoin R (Set.range (T (n := k + l) q)) := by
    rw [adjoin_range_T]
    trivial
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact shuffleLift_comp_shuffleRep_T ρ hsel hrest i
  | algebraMap r =>
    ext
    simp
  | add x y _ _ hx hy => rw [map_add, map_add, LinearMap.comp_add, LinearMap.add_comp, hx, hy]
  | mul x y _ _ hx hy =>
    rw [map_mul, map_mul, Module.End.mul_eq_comp, Module.End.mul_eq_comp, ← LinearMap.comp_assoc,
      hx, LinearMap.comp_assoc, hy, LinearMap.comp_assoc]

/-- Two maps of Hecke modules out of the shuffle module agreeing on the initial mask are equal. -/
theorem shuffleRep_hom_ext {F F' : (ShuffleMask k l → U) →ₗ[R] N}
    (hF : ∀ x, F ∘ₗ shuffleRep k ρ x = σ x ∘ₗ F) (hF' : ∀ x, F' ∘ₗ shuffleRep k ρ x = σ x ∘ₗ F')
    (h : ∀ u, F (Pi.single ShuffleMask.initial u) = F' (Pi.single ShuffleMask.initial u)) :
    F = F' :=
  LinearMap.ext_on_range (span_range_shuffleRep_single_initial_eq_top ρ) fun p ↦ by
    rw [← LinearMap.comp_apply, hF, LinearMap.comp_apply, h, ← LinearMap.comp_apply, ← hF',
      LinearMap.comp_apply]

variable {ρ σ} in
/-- **Uniqueness of the extension.** A map of Hecke modules out of the shuffle module agreeing with
a compatible `f` on the initial mask is the extension `shuffleLift σ f`. -/
theorem eq_shuffleLift {f : U →ₗ[R] N}
    (hsel : ∀ i : Fin (k + l - 1), (i : ℕ) + 1 < k → σ (T q i) ∘ₗ f = (q : R) • f)
    (hrest : ∀ j : Fin (l - 1), σ (T q ⟨k + j, by omega⟩) ∘ₗ f = f ∘ₗ ρ (T q j))
    {F : (ShuffleMask k l → U) →ₗ[R] N} (hF : ∀ x, F ∘ₗ shuffleRep k ρ x = σ x ∘ₗ F)
    (hFf : ∀ u, F (Pi.single ShuffleMask.initial u) = f u) : F = shuffleLift σ f :=
  shuffleRep_hom_ext ρ σ hF (shuffleLift_comp_shuffleRep ρ hsel hrest) fun u ↦ by
    rw [hFf, shuffleLift_single_initial]

end Lift

end TauCeti.TypeAHeckeAlgebra
