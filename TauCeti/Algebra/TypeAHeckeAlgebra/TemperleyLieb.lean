/-!
# The Temperley-Lieb algebra as a quotient of the type-A Hecke algebra

Let `q : Rˣ` and let `δ = q + q⁻¹`. The assignment `T i ↦ e i - q⁻¹` respects the quadratic,
braid and distant-commutation relations, so it defines an algebra map
`TauCeti.TypeAHeckeAlgebra.toTemperleyLieb` from the Hecke algebra `TypeAHeckeAlgebra R q n` to
the Temperley-Lieb algebra `TemperleyLieb R δ n` with loop value `δ`. Since
`e i` is the image of `T i + q⁻¹`, the map is surjective, and it is compatible with the tower maps
adding a last strand. No hypothesis on `q + q⁻¹` is needed, because the native Temperley-Lieb
generators are the unnormalized elements `e i`; the normalized projections `δ⁻¹ • e i` of the
Jones tower, with `τ = δ⁻²`, require `δ` to be a unit.

In the generators `g i = q • T i`, which satisfy `(g i + 1) * (g i - q²) = 0`, the kernel is the
two-sided ideal generated by Jones's relation (11.6),

`g i * g j * g i + g i * g j + g j * g i + g i + g j + 1 = 0`  for `j = i + 1`

(`TauCeti.TypeAHeckeAlgebra.ker_toTemperleyLieb`). The left side is
`q ^ 3 • (U i * U j * U i - U i)` for `U i = T i + q⁻¹`
(`TauCeti.TypeAHeckeAlgebra.jonesRelator_eq_smul`), so it records the Temperley-Lieb relation
`e i * e j * e i = e i`, and it is symmetric in the two adjacent indices by the braid relation. It
is not a consequence of the Hecke relations whenever `δ * (δ ^ 2 - 1) ≠ 0` for `δ = q + q⁻¹`:
then the index character `T i ↦ q` does not kill it
(`TauCeti.TypeAHeckeAlgebra.jonesRelator_ne_zero`).

The native spin-model Markov trace `TauCeti.TemperleyLieb.markovTrace` is stated for loop values
`δ = -(p + p⁻¹)`; the loop value `q + q⁻¹` is of this form for `p = -q`. In particular, for
`q = -a⁻²` the loop value is the Kauffman-bracket value `TauCeti.TemperleyLieb.jonesDelta a`, and
the composite of the Hecke braid homomorphism with this quotient map is the Jones representation
`TauCeti.TemperleyLieb.jones` twisted by the character `b ↦ a ^ e(b)` of the exponent sum
(`TauCeti.TypeAHeckeAlgebra.toTemperleyLieb_braidHom`).

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.toTemperleyLieb`: the quotient map `T i ↦ e i - q⁻¹`.
* `TauCeti.TypeAHeckeAlgebra.jonesRelator`: the left side of Jones's relation (11.6).

## Main results

* `TauCeti.TypeAHeckeAlgebra.toTemperleyLieb_surjective`: the map is surjective.
* `TauCeti.TypeAHeckeAlgebra.toTemperleyLieb_strandIncl`: compatibility with the tower maps.
* `TauCeti.TypeAHeckeAlgebra.ker_toTemperleyLieb`: the kernel is generated by Jones's relation.
* `TauCeti.TypeAHeckeAlgebra.toTemperleyLieb_braidHom`: comparison with the Jones representation.

## References

* V. F. R. Jones, *Hecke algebra representations of braid groups and link polynomials*,
  Ann. of Math. 126 (1987), 335–388, Section 11, relation (11.6).
* L. H. Kauffman, *State models and the Jones polynomial*, Topology 26 (1987), 395–407.
-/

public section

namespace TauCeti

namespace TypeAHeckeAlgebra

open TemperleyLieb

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ} {δ : R}

section Quadratic

variable (q) in
/-- The left side `g i * g j * g i + g i * g j + g j * g i + g i + g j + 1` of Jones's relation
(11.6), in the generators `g i = q • T i`. The Temperley-Lieb algebra with loop value `q + q⁻¹` is
the quotient of the Hecke algebra by these elements for adjacent `i` and `j`
(`TauCeti.TypeAHeckeAlgebra.ker_toTemperleyLieb`). -/
def jonesRelator (i j : Fin (n - 1)) : TypeAHeckeAlgebra R q n :=
  ((q : R) • T q i) * ((q : R) • T q j) * ((q : R) • T q i) +
    ((q : R) • T q i) * ((q : R) • T q j) + ((q : R) • T q j) * ((q : R) • T q i) +
    (q : R) • T q i + (q : R) • T q j + 1

/-- The defining expression of Jones's relation in the generators `g i = q • T i`. -/
theorem jonesRelator_def (i j : Fin (n - 1)) :
    jonesRelator q i j =
      ((q : R) • T q i) * ((q : R) • T q j) * ((q : R) • T q i) +
        ((q : R) • T q i) * ((q : R) • T q j) + ((q : R) • T q j) * ((q : R) • T q i) +
        (q : R) • T q i + (q : R) • T q j + 1 := (rfl)

/-- Jones's relation (11.6) is `q ^ 3` times the Temperley-Lieb relation
`U i * U j * U i - U i` in the elements `U i = T i + q⁻¹`. -/
theorem jonesRelator_eq_smul (i j : Fin (n - 1)) :
    jonesRelator q i j =
      ((q : R) ^ 3) • ((T q i + algebraMap R _ (↑q⁻¹ : R)) * (T q j + algebraMap R _ (↑q⁻¹ : R)) *
        (T q i + algebraMap R _ (↑q⁻¹ : R)) - (T q i + algebraMap R _ (↑q⁻¹ : R))) := by
  have hq : (q : R) * ↑q⁻¹ = 1 := q.mul_inv
  simp only [jonesRelator_def, Algebra.algebraMap_eq_smul_one, add_mul, mul_add, mul_sub,
    smul_mul_assoc, mul_smul_comm, smul_smul, one_mul, mul_one, smul_add, smul_sub, mul_assoc,
    T_mul_self]
  match_scalars <;> grind

/-- Jones's relation is symmetric in two adjacent indices, by the braid relation. -/
theorem jonesRelator_comm {i j : Fin (n - 1)} (h : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    jonesRelator q i j = jonesRelator q j i := by
  have hb := T_braid (q := q) h
  simp only [jonesRelator_def, smul_mul_assoc, mul_smul_comm, smul_smul, hb]
  abel

/-- Jones's relation does not follow from the Hecke relations: the index character `T i ↦ q`
sends it to `q ^ 3 * δ * (δ ^ 2 - 1)` for `δ = q + q⁻¹`, so it is nonzero whenever that scalar is
nonzero. -/
theorem jonesRelator_ne_zero (i j : Fin (n - 1))
    (h : ((q : R) + ↑q⁻¹) * (((q : R) + ↑q⁻¹) ^ 2 - 1) ≠ 0) : jonesRelator q i j ≠ 0 := by
  intro h0
  have hq : (q : R) * ↑q⁻¹ = 1 := q.mul_inv
  rw [jonesRelator_eq_smul] at h0
  have hχ := congrArg (InfiniteTypeAHeckeAlgebra.indexCharacter R q ∘ toInfinite R q n) h0
  simp only [Function.comp_apply, map_add, map_sub, map_mul, map_smul, AlgHom.commutes, map_zero,
    toInfinite_T, InfiniteTypeAHeckeAlgebra.indexCharacter_T, smul_eq_mul,
    Algebra.algebraMap_self, RingHom.id_apply] at hχ
  apply h
  linear_combination (↑q⁻¹ : R) ^ 3 * hχ - ((q : R) + ↑q⁻¹) * (((q : R) + ↑q⁻¹) ^ 2 - 1) *
    ((q : R) ^ 2 * (↑q⁻¹ : R) ^ 2 + (q : R) * ↑q⁻¹ + 1) * hq

end Quadratic

section Quotient

variable (n) in
/-- The quotient map from the type-A Hecke algebra to the Temperley-Lieb algebra with loop value
`δ = q + q⁻¹`, sending the generator `T i` to `e i - q⁻¹`. It is surjective
(`TauCeti.TypeAHeckeAlgebra.toTemperleyLieb_surjective`) with kernel generated by Jones's relation
(`TauCeti.TypeAHeckeAlgebra.ker_toTemperleyLieb`). -/
def toTemperleyLieb (hδ : δ = q + q⁻¹) : TypeAHeckeAlgebra R q n →ₐ[R] TemperleyLieb R δ n :=
  lift (fun i ↦ crossing δ (-↑q⁻¹) 1 i)
    (fun i ↦ by
      have hq : (q : R) * ↑q⁻¹ = 1 := q.mul_inv
      rw [crossing_mul_crossing, e_mul_self, crossing_def]
      match_scalars <;> grind)
    (fun h ↦ crossing_braid (by rw [hδ]; linear_combination (-1 : R) * q.mul_inv) (Or.inl h))
    (fun h ↦ crossing_mul_crossing_comm _ _ _ _ (Or.inl h))

variable (hδ : δ = q + q⁻¹)

/-- The quotient map sends `T i` to `e i - q⁻¹`. -/
@[simp]
theorem toTemperleyLieb_T (i : Fin (n - 1)) :
    toTemperleyLieb n hδ (T q i) = e δ i - algebraMap R _ (↑q⁻¹ : R) := by
  rw [toTemperleyLieb, lift_T, crossing_def, Algebra.algebraMap_eq_smul_one, neg_smul, one_smul]
  abel

/-- The quotient map sends `T i + q⁻¹` to the Temperley-Lieb generator `e i`. -/
@[simp]
theorem toTemperleyLieb_T_add_algebraMap (i : Fin (n - 1)) :
    toTemperleyLieb n hδ (T q i + algebraMap R _ (↑q⁻¹ : R)) = e δ i := by
  rw [map_add, toTemperleyLieb_T, AlgHom.commutes, sub_add_cancel]

/-- The quotient map onto the Temperley-Lieb algebra is surjective. -/
theorem toTemperleyLieb_surjective : Function.Surjective (toTemperleyLieb n hδ) := by
  rw [← AlgHom.range_eq_top, eq_top_iff, ← adjoin_range_e, Algebra.adjoin_le_iff,
    Set.range_subset_iff]
  exact fun i ↦ ⟨_, toTemperleyLieb_T_add_algebraMap hδ i⟩

/-- The quotient maps are compatible with the tower maps adding an uncrossed last strand. -/
@[simp]
theorem toTemperleyLieb_strandIncl (x : TypeAHeckeAlgebra R q (n + 1)) :
    toTemperleyLieb (n + 2) hδ (strandIncl R q (n + 1) x) =
      TemperleyLieb.strandIncl (toTemperleyLieb (n + 1) hδ x) := by
  have h : (toTemperleyLieb (n + 2) hδ).comp (strandIncl R q (n + 1)) =
      TemperleyLieb.strandIncl.comp (toTemperleyLieb (n + 1) hδ) :=
    hom_ext fun i ↦ by
      simp only [AlgHom.comp_apply, strandIncl_T, toTemperleyLieb_T, map_sub, AlgHom.commutes,
        TemperleyLieb.strandIncl_e]
      exact congrArg (fun k ↦ e δ k - algebraMap R _ (↑q⁻¹ : R)) (Fin.ext rfl)
  exact DFunLike.congr_fun h x

/-- The quotient map kills Jones's relation for adjacent indices. -/
theorem toTemperleyLieb_jonesRelator {i j : Fin (n - 1)}
    (h : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    toTemperleyLieb n hδ (jonesRelator q i j) = 0 := by
  rw [jonesRelator_eq_smul, map_smul, map_sub, map_mul, map_mul,
    toTemperleyLieb_T_add_algebraMap, toTemperleyLieb_T_add_algebraMap, e_mul_e_mul_e h, sub_self,
    smul_zero]

/-- **The Temperley-Lieb algebra is the Jones quotient of the Hecke algebra.** The kernel of the
quotient map `T i ↦ e i - q⁻¹` is the two-sided ideal generated by Jones's relation (11.6) for the
adjacent pairs `j = i + 1`. -/
theorem ker_toTemperleyLieb :
    TwoSidedIdeal.ker (toTemperleyLieb n hδ) =
      TwoSidedIdeal.span {x | ∃ i j : Fin (n - 1), (i : ℕ) + 1 = j ∧ jonesRelator q i j = x} := by
  set I := TwoSidedIdeal.span {x | ∃ i j : Fin (n - 1), (i : ℕ) + 1 = j ∧ jonesRelator q i j = x}
  have hI : ∀ y, I.ringCon.mkₐ R y = 0 ↔ y ∈ I := fun y ↦ by
    have := (TwoSidedIdeal.mem_ker I.ringCon.mk' (x := y)).symm
    rwa [TwoSidedIdeal.ker_ringCon_mk'] at this
  refine le_antisymm (fun x hx ↦ ?_) (TwoSidedIdeal.span_le.2 ?_)
  · -- The inverse map `e i ↦ T i + q⁻¹` is defined on the quotient by `I`.
    let U : Fin (n - 1) → I.ringCon.Quotient :=
      fun i ↦ I.ringCon.mkₐ R (T q i + algebraMap R _ (↑q⁻¹ : R))
    have hU : ∀ {i j : Fin (n - 1)}, (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i → U i * U j * U i = U i := by
      intro i j h
      have hmem : jonesRelator q i j ∈ I := by
        rcases h with h | h
        · exact TwoSidedIdeal.subset_span ⟨i, j, h, rfl⟩
        · rw [jonesRelator_comm (Or.inr h)]
          exact TwoSidedIdeal.subset_span ⟨j, i, h, rfl⟩
      have h0 : I.ringCon.mkₐ R (jonesRelator q i j) = 0 := (hI _).2 hmem
      rw [jonesRelator_eq_smul, map_smul, map_sub, map_mul, map_mul] at h0
      have h3 := congrArg (((↑q⁻¹ : R) ^ 3) • ·) h0
      simp only [smul_zero, smul_smul, ← mul_pow, Units.inv_mul, one_pow, one_smul] at h3
      exact sub_eq_zero.1 h3
    let G : TemperleyLieb R δ n →ₐ[R] I.ringCon.Quotient :=
      TemperleyLieb.lift U
        (fun i ↦ by simp only [U, ← map_mul, T_add_algebraMap_mul_self, map_smul, hδ])
        hU
        (fun {i j} h ↦ by
          simp only [U, ← map_mul]
          congr 1
          simp only [add_mul, mul_add, (commute_T h).eq, Algebra.commutes]
          abel)
    have hG : G.comp (toTemperleyLieb n hδ) = I.ringCon.mkₐ R :=
      hom_ext fun i ↦ by simp [G, U, AlgHom.commutes]
    have hx0 : I.ringCon.mkₐ R x = 0 := by
      rw [← hG, AlgHom.comp_apply, (TwoSidedIdeal.mem_ker _).1 hx, map_zero]
    exact (hI x).1 hx0
  · rintro _ ⟨i, j, h, rfl⟩
    exact (TwoSidedIdeal.mem_ker _).2 (toTemperleyLieb_jonesRelator hδ (Or.inl h))

end Quotient

section Jones

/-- **Comparison with the Jones representation.** At `q = -a⁻²`, the image of a braid `b` under
the Hecke braid homomorphism and the quotient map `T i ↦ e i - q⁻¹` is `a ^ e(b)` times its image
under the Jones representation, where `e(b)` is the exponent sum of `b`. -/
theorem toTemperleyLieb_braidHom (a : Rˣ) (b : BraidGroup n) :
    toTemperleyLieb n (jonesDelta_eq_add_inv a)
        (braidHom R (-a⁻¹ ^ 2) n b : TypeAHeckeAlgebra R (-a⁻¹ ^ 2) n) =
      ((a ^ Multiplicative.toAdd (ArtinGroup.exponentSum _ b) : Rˣ) : R) •
        (jones n a b : TemperleyLieb R (jonesDelta a) n) := by
  induction b using BraidGroup.sigma_induction_on with
  | sigma i =>
    have ha : (a : R) * ↑a⁻¹ = 1 := a.mul_inv
    simp only [braidHom_sigma, val_unitT, toTemperleyLieb_T, jones_sigma, jonesUnit_val,
      crossing_def, BraidGroup.exponentSum_sigma, toAdd_ofAdd, zpow_one, inv_neg, inv_pow, inv_inv,
      Units.val_neg, Units.val_pow_eq_pow_val, Algebra.algebraMap_eq_smul_one, smul_add, smul_smul]
    match_scalars <;> grind
  | one => simp
  | mul b b' hb hb' =>
    simp only [map_mul, Units.val_mul, hb, hb', toAdd_mul, zpow_add, smul_mul_smul_comm]
  | inv b hb =>
    -- The image of `b⁻¹` is the inverse of the image of `b`, a central multiple of a unit.
    rw [map_inv, map_inv, toAdd_inv, zpow_neg, ← MonoidHom.coe_ofClass (toTemperleyLieb n _),
      ← Units.coe_map_inv]
    refine Units.inv_eq_of_mul_eq_one_right ?_
    rw [Units.coe_map, MonoidHom.coe_ofClass, hb, smul_mul_smul_comm, ← Units.val_mul,
      mul_inv_cancel, Units.val_one, one_smul, ← Units.val_mul, ← map_mul, mul_inv_cancel, map_one,
      Units.val_one]

end Jones

end TypeAHeckeAlgebra

