module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Basis
public import TauCeti.GroupTheory.Coxeter.Parabolic

/-!
# Parabolic subalgebras of the type-A Hecke algebra and their coset bases

Let `cs` be a Coxeter system of type `A_(n-1)` on a group `W`, and let `J` be a set of indices of
the generators `T i` of the Hecke algebra `H = TypeAHeckeAlgebra R q n`. The **parabolic
subalgebra** `H_J = TauCeti.TypeAHeckeAlgebra.parabolic q J` is the subalgebra generated by the
`T i` with `i ∈ J`. For `J = {0, …, k - 2} ∪ {k, …, k + l - 2}` in the algebra on `k + l` strands
it is generated by the generators of the first `k` and of the last `l` strands, the subalgebra from
which modules `triv_k ⊗ U` are induced in the parabolic Pieri rule. For the blocks of a composition
of `n` it is the Young subalgebra of Dipper and James.

This file proves that `H_J` is free over `R` with basis the elements `T_w` for `w` in the standard
parabolic subgroup `W_J = cs.parabolic J` (`TauCeti.TypeAHeckeAlgebra.parabolicBasis`), and that
`H` is a free module over `H_J` on either side, with basis the elements `T_d` attached to the
minimal coset representatives `d`:

* every element of `H` is uniquely a sum `∑ d, T_d * h_d` with coefficients `h_d ∈ H_J`, where
  `d` runs over the minimal representatives of the left cosets `d W_J`
  (`TauCeti.TypeAHeckeAlgebra.parabolicCosetEquivRight`);
* every element of `H` is uniquely a sum `∑ d, h_d * T_d` with coefficients `h_d ∈ H_J`, where
  `d` runs over the elements with no left descent in `J`, the minimal representatives of the
  right cosets `W_J d` (`TauCeti.TypeAHeckeAlgebra.parabolicCosetEquiv`).

The coefficients are linear for multiplication by `H_J` on the corresponding side. Both statements
follow from the basis theorem `TauCeti.TypeAHeckeAlgebra.basisTw` and the unique factorizations
`w = d * v` and `w = v * d` with `v ∈ W_J` and additive lengths
(`CoxeterSystem.minimalCosetRepProdParabolicEquiv`, `CoxeterSystem.parabolicProdEquiv`), under which
`T_w = T_d * T_v`, respectively `T_w = T_v * T_d`. No hypothesis on the commutative ring `R` or on
the unit `q` is needed.

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.parabolic`: the subalgebra generated by the `T i` with `i ∈ J`.
* `TauCeti.TypeAHeckeAlgebra.parabolicBasis`: its basis `T_w`, `w ∈ W_J`.
* `TauCeti.TypeAHeckeAlgebra.parabolicCosetEquivRight`: the isomorphism sending coefficients
  `h` to `∑ d, T_d * h d`, for `d` the minimal left coset representatives.
* `TauCeti.TypeAHeckeAlgebra.parabolicCosetEquiv`: the isomorphism sending coefficients `h` to
  `∑ d, h d * T_d`, for `d` the elements with no left descent in `J`.

## Main results

* `TauCeti.TypeAHeckeAlgebra.span_image_Tw_parabolic`: the elements `T_w`, `w ∈ W_J`, span `H_J`.
* `TauCeti.TypeAHeckeAlgebra.mem_parabolic_iff`: an element lies in `H_J` exactly when its
  coordinates in the basis `T_w` are supported in `W_J`.
* `TauCeti.TypeAHeckeAlgebra.parabolicCosetEquivRight_op_smul` and
  `TauCeti.TypeAHeckeAlgebra.parabolicCosetEquiv_smul`: the coset isomorphisms are linear over
  `H_J`.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*, Proc.
  London Math. Soc. (3) 52 (1986), 20–52.
* M. Geck and G. Pfeiffer, *Characters of Finite Coxeter Groups and Iwahori-Hecke Algebras*,
  OUP (2000).
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*, University
  Lecture Series 15, AMS (1999).
-/

public section

namespace TauCeti

namespace TypeAHeckeAlgebra

open CoxeterSystem MulOpposite

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ}
variable {W : Type*} [Group W] (cs : CoxeterSystem (CoxeterMatrix.A (n - 1)) W)

variable (q) in
/-- The **parabolic subalgebra** of the type-A Hecke algebra attached to a set `J` of generator
indices: the subalgebra generated by the generators `T i` with `i ∈ J`. -/
def parabolic (J : Set (Fin (n - 1))) : Subalgebra R (TypeAHeckeAlgebra R q n) :=
  Algebra.adjoin R (T q '' J)

/-- The parabolic subalgebra of `J` is the subalgebra generated by the `T i` with `i ∈ J`. -/
theorem parabolic_def (J : Set (Fin (n - 1))) :
    parabolic (R := R) q J = Algebra.adjoin R (T q '' J) :=
  (rfl)

/-- The generator `T i` lies in the parabolic subalgebra of `J` when `i ∈ J`. -/
theorem T_mem_parabolic {J : Set (Fin (n - 1))} {i : Fin (n - 1)} (hi : i ∈ J) :
    T q i ∈ parabolic (R := R) q J :=
  Algebra.subset_adjoin ⟨i, hi, rfl⟩

/-- The parabolic subalgebras increase with the set of generators. -/
theorem parabolic_mono {J J' : Set (Fin (n - 1))} (h : J ⊆ J') :
    parabolic (R := R) q J ≤ parabolic q J' :=
  Algebra.adjoin_mono (Set.image_mono h)

/-- The parabolic subalgebra of all generators is the whole Hecke algebra. -/
@[simp]
theorem parabolic_univ : parabolic (R := R) q (Set.univ : Set (Fin (n - 1))) = ⊤ := by
  rw [parabolic_def, Set.image_univ, adjoin_range_T]

/-- The element `T_w` lies in the parabolic subalgebra of `J` when `w` lies in the standard
parabolic subgroup of `J`. -/
theorem Tw_mem_parabolic {J : Set (Fin (n - 1))} {w : W} (hw : w ∈ cs.parabolic J) :
    Tw q cs w ∈ parabolic (R := R) q J := by
  obtain ⟨ω, hred, hωJ, rfl⟩ := cs.exists_isReduced_wordProd_eq_of_mem_parabolic hw
  rw [Tw_wordProd cs hred]
  refine Subalgebra.list_prod_mem _ fun x hx ↦ ?_
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
  exact T_mem_parabolic (hωJ i hi)

/-- The parabolic subalgebra of `J` is spanned by the elements `T_w` with `w` in the standard
parabolic subgroup of `J`. -/
theorem span_image_Tw_parabolic (J : Set (Fin (n - 1))) :
    Submodule.span R (Tw q cs '' (cs.parabolic J : Set W)) =
      Subalgebra.toSubmodule (parabolic q J) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun x hx ↦ ?_
  · rintro _ ⟨w, hw, rfl⟩
    exact Tw_mem_parabolic cs hw
  simpa using mul_mem_span_image_Tw cs
    (fun i hi _ hw ↦ mul_mem (cs.simple_mem_parabolic hi) hw) hx
    (Submodule.subset_span ⟨1, one_mem _, Tw_one cs⟩)

/-- **Membership in a parabolic subalgebra.** An element of the Hecke algebra lies in the
parabolic subalgebra of `J` exactly when its coordinates in the basis `T_w` vanish outside the
standard parabolic subgroup of `J`. -/
theorem mem_parabolic_iff {J : Set (Fin (n - 1))} {x : TypeAHeckeAlgebra R q n} :
    x ∈ parabolic q J ↔ ↑((basisTw q cs).repr x).support ⊆ (cs.parabolic J : Set W) := by
  rw [← Subalgebra.mem_toSubmodule, ← span_image_Tw_parabolic cs, ← coe_basisTw,
    Module.Basis.mem_span_image]

variable (q) in
/-- The basis `T_w`, `w ∈ W_J`, of the parabolic subalgebra of `J`, indexed by the standard
parabolic subgroup `W_J` of `J`. -/
noncomputable def parabolicBasis (J : Set (Fin (n - 1))) :
    Module.Basis (cs.parabolic J) R (parabolic (R := R) q J) :=
  .mk (v := fun w ↦ ⟨Tw q cs w, Tw_mem_parabolic cs w.2⟩)
    (LinearIndependent.of_comp (parabolic q J).val.toLinearMap
      ((linearIndependent_Tw cs).comp _ Subtype.val_injective)) <| by
    refine (Submodule.map_injective_of_injective (f := (parabolic q J).val.toLinearMap)
      Subtype.val_injective ?_).ge
    rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top]
    convert span_image_Tw_parabolic (R := R) (q := q) cs J using 2
    · -- the two sides are the ranges of `Subtype.val ∘ v` and of `fun w ↦ Tw q cs w`
      rw [Set.image_eq_range]
      rfl
    · ext x
      simp

/-- The basis vectors of `TauCeti.TypeAHeckeAlgebra.parabolicBasis` are the elements `T_w`. -/
@[simp]
theorem coe_parabolicBasis_apply (J : Set (Fin (n - 1))) (w : cs.parabolic J) :
    (parabolicBasis q cs J w : TypeAHeckeAlgebra R q n) = Tw q cs w := by
  simp [parabolicBasis]

/-- The coordinates of an element of the parabolic subalgebra in its basis `T_w`, `w ∈ W_J`, are
its coordinates in the basis `T_w` of the whole Hecke algebra. -/
@[simp]
theorem parabolicBasis_repr_apply (J : Set (Fin (n - 1))) (x : parabolic (R := R) q J)
    (w : cs.parabolic J) :
    (parabolicBasis q cs J).repr x w = (basisTw q cs).repr x w := by
  have key : Finsupp.lapply w ∘ₗ (parabolicBasis q cs J).repr.toLinearMap =
      Finsupp.lapply w.1 ∘ₗ (basisTw q cs).repr.toLinearMap ∘ₗ
        (parabolic (R := R) q J).val.toLinearMap :=
    (parabolicBasis q cs J).ext fun v ↦ by
      have h := (basisTw (R := R) q cs).repr_self (v : W)
      rw [coe_basisTw] at h
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
        Module.Basis.repr_self, Finsupp.lapply_apply, AlgHom.toLinearMap_apply, Subalgebra.coe_val,
        coe_parabolicBasis_apply, h]
      exact (Finsupp.single_apply_left Subtype.val_injective _ _ _).symm
  exact LinearMap.congr_fun key x

/-! ### The coset basis of the right module over a parabolic subalgebra -/

section CosetEquivRight

variable (q) in
/-- **The right coset basis.** The type-A Hecke algebra is a free right module over the parabolic
subalgebra of `J`, with basis the elements `T_d` for `d` the minimal representatives of the left
cosets of the standard parabolic subgroup `W_J`: the `R`-linear map sending coefficients `h` to
`∑ d, T_d * h d` is an isomorphism. -/
noncomputable def parabolicCosetEquivRight (J : Set (Fin (n - 1))) :
    ({d : W // cs.IsMinimalCosetRep J d} →₀ parabolic (R := R) q J) ≃ₗ[R]
      TypeAHeckeAlgebra R q n :=
  (Finsupp.basis fun _ ↦ parabolicBasis q cs J).equiv (basisTw q cs)
    ((Equiv.sigmaEquivProd _ _).trans (cs.minimalCosetRepProdParabolicEquiv J))

/-- The right coset isomorphism sends coefficients `h` to `∑ d, T_d * h d`. -/
theorem parabolicCosetEquivRight_apply (J : Set (Fin (n - 1)))
    (h : {d : W // cs.IsMinimalCosetRep J d} →₀ parabolic (R := R) q J) :
    parabolicCosetEquivRight q cs J h = h.sum fun d b ↦ Tw q cs d * b := by
  have key : (parabolicCosetEquivRight q cs J).toLinearMap =
      Finsupp.lsum R fun d : {d : W // cs.IsMinimalCosetRep J d} ↦
        LinearMap.mulLeft R (Tw q cs d) ∘ₗ (parabolic (R := R) q J).val.toLinearMap := by
    refine (Finsupp.basis fun _ ↦ parabolicBasis q cs J).ext fun ⟨d, v⟩ ↦ ?_
    rw [parabolicCosetEquivRight, LinearEquiv.coe_coe, Module.Basis.equiv_apply]
    simp [Tw_mul_Tw cs (cs.length_mul_of_isMinimalCosetRep d.2 v.2)]
  exact LinearMap.congr_fun key h

/-- The right coset isomorphism sends the coefficient `b` at a single representative `d` to
`T_d * b`. -/
@[simp]
theorem parabolicCosetEquivRight_single (J : Set (Fin (n - 1)))
    (d : {d : W // cs.IsMinimalCosetRep J d}) (b : parabolic (R := R) q J) :
    parabolicCosetEquivRight q cs J (Finsupp.single d b) = Tw q cs d * b := by
  simp [parabolicCosetEquivRight_apply]

/-- The coefficients of `T_d * b` are `b` at `d` and zero elsewhere. -/
@[simp]
theorem parabolicCosetEquivRight_symm_Tw_mul (J : Set (Fin (n - 1)))
    (d : {d : W // cs.IsMinimalCosetRep J d}) (b : parabolic (R := R) q J) :
    (parabolicCosetEquivRight q cs J).symm (Tw q cs d * b) = Finsupp.single d b := by
  rw [LinearEquiv.symm_apply_eq, parabolicCosetEquivRight_single]

/-- The right coset isomorphism is linear for right multiplication by the parabolic subalgebra. -/
theorem parabolicCosetEquivRight_op_smul (J : Set (Fin (n - 1))) (b : parabolic (R := R) q J)
    (h : {d : W // cs.IsMinimalCosetRep J d} →₀ parabolic (R := R) q J) :
    parabolicCosetEquivRight q cs J (op b • h) = parabolicCosetEquivRight q cs J h * b := by
  simp only [parabolicCosetEquivRight_apply, Finsupp.sum_mul]
  rw [Finsupp.sum_smul_index' fun _ ↦ by simp]
  simp [mul_assoc]

/-- The coefficients along the right coset basis are linear for right multiplication by the
parabolic subalgebra. -/
theorem parabolicCosetEquivRight_symm_mul (J : Set (Fin (n - 1))) (x : TypeAHeckeAlgebra R q n)
    (b : parabolic (R := R) q J) :
    (parabolicCosetEquivRight q cs J).symm (x * b) =
      op b • (parabolicCosetEquivRight q cs J).symm x := by
  rw [LinearEquiv.symm_apply_eq, parabolicCosetEquivRight_op_smul, LinearEquiv.apply_symm_apply]

end CosetEquivRight

/-! ### The coset basis of the left module over a parabolic subalgebra -/

section CosetEquiv

variable (q) in
/-- **The left coset basis.** The type-A Hecke algebra is a free left module over the parabolic
subalgebra of `J`, with basis the elements `T_d` for `d` the elements with no left descent in `J`,
the minimal representatives of the right cosets of the standard parabolic subgroup `W_J`: the
`R`-linear map sending coefficients `h` to `∑ d, h d * T_d` is an isomorphism. -/
noncomputable def parabolicCosetEquiv (J : Set (Fin (n - 1))) :
    ({d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i} →₀ parabolic (R := R) q J) ≃ₗ[R]
      TypeAHeckeAlgebra R q n :=
  (Finsupp.basis fun _ ↦ parabolicBasis q cs J).equiv (basisTw q cs)
    ((Equiv.sigmaEquivProd _ _).trans ((Equiv.prodComm _ _).trans (cs.parabolicProdEquiv J)))

/-- The left coset isomorphism sends coefficients `h` to `∑ d, h d * T_d`. -/
theorem parabolicCosetEquiv_apply (J : Set (Fin (n - 1)))
    (h : {d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i} →₀ parabolic (R := R) q J) :
    parabolicCosetEquiv q cs J h = h.sum fun d b ↦ b * Tw q cs d := by
  have key : (parabolicCosetEquiv q cs J).toLinearMap =
      Finsupp.lsum R fun d : {d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i} ↦
        LinearMap.mulRight R (Tw q cs d) ∘ₗ (parabolic (R := R) q J).val.toLinearMap := by
    refine (Finsupp.basis fun _ ↦ parabolicBasis q cs J).ext fun ⟨d, v⟩ ↦ ?_
    rw [parabolicCosetEquiv, LinearEquiv.coe_coe, Module.Basis.equiv_apply]
    simp [Tw_mul_Tw cs (cs.length_mul_of_forall_not_isLeftDescent v.2 d.2)]
  exact LinearMap.congr_fun key h

/-- The left coset isomorphism sends the coefficient `b` at a single representative `d` to
`b * T_d`. -/
@[simp]
theorem parabolicCosetEquiv_single (J : Set (Fin (n - 1)))
    (d : {d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i}) (b : parabolic (R := R) q J) :
    parabolicCosetEquiv q cs J (Finsupp.single d b) = b * Tw q cs d := by
  simp [parabolicCosetEquiv_apply]

/-- The coefficients of `b * T_d` are `b` at `d` and zero elsewhere. -/
@[simp]
theorem parabolicCosetEquiv_symm_mul_Tw (J : Set (Fin (n - 1)))
    (d : {d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i}) (b : parabolic (R := R) q J) :
    (parabolicCosetEquiv q cs J).symm (b * Tw q cs d) = Finsupp.single d b := by
  rw [LinearEquiv.symm_apply_eq, parabolicCosetEquiv_single]

/-- The left coset isomorphism is linear for left multiplication by the parabolic subalgebra. -/
theorem parabolicCosetEquiv_smul (J : Set (Fin (n - 1))) (b : parabolic (R := R) q J)
    (h : {d : W // ∀ i ∈ J, ¬ cs.IsLeftDescent d i} →₀ parabolic (R := R) q J) :
    parabolicCosetEquiv q cs J (b • h) = b * parabolicCosetEquiv q cs J h := by
  simp only [parabolicCosetEquiv_apply, Finsupp.mul_sum]
  rw [Finsupp.sum_smul_index' fun _ ↦ by simp]
  simp [mul_assoc]

/-- The coefficients along the left coset basis are linear for left multiplication by the
parabolic subalgebra. -/
theorem parabolicCosetEquiv_symm_mul (J : Set (Fin (n - 1))) (b : parabolic (R := R) q J)
    (x : TypeAHeckeAlgebra R q n) :
    (parabolicCosetEquiv q cs J).symm (b * x) = b • (parabolicCosetEquiv q cs J).symm x := by
  rw [LinearEquiv.symm_apply_eq, parabolicCosetEquiv_smul, LinearEquiv.apply_symm_apply]

end CosetEquiv

end TypeAHeckeAlgebra

end TauCeti
