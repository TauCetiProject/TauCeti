module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Symmetrizer.Basic

/-!
# Parabolic Hecke permutation modules

The permutation module for a standard parabolic subgroup `W_J` is the left ideal
`H C_J(q)`, where `C_J(q) = ∑ w ∈ W_J, q ^ length w • T_w`. It has an `R`-basis
`T_d C_J(q)` indexed by the minimal representatives of the left cosets `d W_J`.
These are the ambient permutation modules used in the construction of Specht modules.

The basis theorem holds over every commutative ring, including singular parameters:
no symmetrizer normalization is inverted. The action of a simple generator is given
by the usual ascent/descent rules when it changes the minimal representative, and
by the scalar `q` when it stays in the same coset.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52, Section 3.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Chapter 3.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open CoxeterSystem

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ}
variable {W : Type*} [Group W] (cs : CoxeterSystem (CoxeterMatrix.A (n - 1)) W)
variable (J : Set (Fin (n - 1))) [Finite (cs.parabolic J)]

/-- The parabolic Hecke permutation module, realized as the left ideal generated by
the row symmetrizer. Its Hecke action is inherited left multiplication. -/
noncomputable def permutationModule : Ideal (TypeAHeckeAlgebra R q n) :=
  Ideal.span {parabolicEigenSum cs J (q : R)}

/-- The permutation module is the principal left ideal of the row symmetrizer. -/
theorem permutationModule_def :
    permutationModule (q := q) cs J = Ideal.span {parabolicEigenSum cs J (q : R)} := (rfl)

/-- Membership means being a left multiple of the row symmetrizer. -/
theorem mem_permutationModule_iff (x : TypeAHeckeAlgebra R q n) :
    x ∈ permutationModule cs J ↔
      ∃ y, y * parabolicEigenSum cs J (q : R) = x := by
  rw [permutationModule_def, Ideal.mem_span_singleton']

/-- The minimal-coset vectors span the entire principal left ideal, not merely a
submodule of it. -/
theorem span_Tw_mul_parabolicEigenSum :
    Submodule.span R (Set.range (fun d : {d : W // cs.IsMinimalCosetRep J d} ↦
      Tw q cs d * parabolicEigenSum cs J (q : R))) =
        (permutationModule (q := q) cs J).restrictScalars R := by
  let C := parabolicEigenSum (q := q) cs J (q : R)
  let S := Submodule.span R (Set.range (fun d : {d : W // cs.IsMinimalCosetRep J d} ↦
    Tw q cs d * C))
  have hw (w : W) : Tw q cs w * C ∈ S := by
    obtain ⟨⟨d, v⟩, rfl⟩ := (cs.minimalCosetRepProdParabolicEquiv J).surjective w
    rw [minimalCosetRepProdParabolicEquiv_apply,
      ← Tw_mul_Tw cs (cs.length_mul_of_isMinimalCosetRep d.2 v.2), mul_assoc,
      Tw_mul_parabolicEigenSum cs J (by simp [sub_mul]) v.2, mul_smul_comm]
    exact S.smul_mem _ (Submodule.subset_span ⟨d, rfl⟩)
  refine le_antisymm (Submodule.span_le.mpr ?_) ?_
  · rintro _ ⟨d, rfl⟩
    exact (mem_permutationModule_iff cs J _).mpr ⟨Tw q cs d, rfl⟩
  · intro x hx
    obtain ⟨y, rfl⟩ := (mem_permutationModule_iff cs J x).mp hx
    clear hx
    have hy : y ∈ Submodule.span R (Set.range (Tw q cs)) := by
      rw [← coe_basisTw, Module.Basis.span_eq]
      trivial
    induction hy using Submodule.span_induction with
    | mem y hy => obtain ⟨w, rfl⟩ := hy; exact hw w
    | zero => simp
    | add y z _ _ hy hz => simpa [add_mul] using S.add_mem hy hz
    | smul r y _ hy => simpa [smul_mul_assoc] using S.smul_mem r hy

/-- The standard basis of a parabolic Hecke permutation module, indexed by minimal
left coset representatives and with vector `T_d C_J(q)`. -/
noncomputable def permutationModuleBasis :
    Module.Basis {d : W // cs.IsMinimalCosetRep J d} R (permutationModule (q := q) cs J) :=
  .mk (v := fun d ↦ ⟨Tw q cs d * parabolicEigenSum cs J (q : R),
      (mem_permutationModule_iff cs J _).mpr ⟨Tw q cs d, rfl⟩⟩)
    (LinearIndependent.of_comp ((permutationModule cs J).subtype.restrictScalars R)
      (linearIndependent_Tw_mul_parabolicEigenSum cs J (q : R))) <| by
    exact ((Submodule.span_range_subtype_eq_top_iff
      ((permutationModule cs J).restrictScalars R) _).mpr
        (span_Tw_mul_parabolicEigenSum (q := q) cs J)).ge

/-- The standard permutation-module basis vector is the corresponding left translate
of the row symmetrizer. -/
@[simp]
theorem coe_permutationModuleBasis (d : {d : W // cs.IsMinimalCosetRep J d}) :
    (permutationModuleBasis (q := q) cs J d : TypeAHeckeAlgebra R q n) =
      Tw q cs d * parabolicEigenSum cs J (q : R) := by
  exact congrArg Subtype.val (Module.Basis.mk_apply _ _ d)

/-- An ascent that remains a minimal representative sends the coset basis vector
to the basis vector of the new coset. -/
theorem T_smul_permutationModuleBasis_of_ascent
    (d : {d : W // cs.IsMinimalCosetRep J d}) (i : Fin (n - 1))
    (hi : ¬cs.IsLeftDescent d i) (hmin : cs.IsMinimalCosetRep J (cs.simple i * d)) :
    T q i • permutationModuleBasis cs J d =
      permutationModuleBasis (q := q) cs J ⟨cs.simple i * d, hmin⟩ := by
  apply Subtype.ext
  simp only [Submodule.coe_smul, smul_eq_mul, coe_permutationModuleBasis]
  rw [← mul_assoc, T_mul_Tw_of_not_isLeftDescent cs hi]

/-- A descent gives the shorter coset vector plus `q - q⁻¹` times the original
vector. The shorter representative is automatically minimal. -/
theorem T_smul_permutationModuleBasis_of_descent
    (d : {d : W // cs.IsMinimalCosetRep J d}) (i : Fin (n - 1))
    (hi : cs.IsLeftDescent d i) :
    T q i • permutationModuleBasis cs J d =
      ((q : R) - ↑q⁻¹) • permutationModuleBasis cs J d +
        permutationModuleBasis (q := q) cs J
          ⟨cs.simple i * d, d.2.simple_mul_of_isLeftDescent cs hi⟩ := by
  apply Subtype.ext
  simp only [Submodule.coe_smul, Submodule.coe_smul_of_tower, Submodule.coe_add,
    smul_eq_mul, coe_permutationModuleBasis]
  rw [← mul_assoc, T_mul_Tw_of_isLeftDescent cs hi, add_mul, smul_mul_assoc]

/-- If a simple reflection does not produce a minimal representative, it stays
in the same parabolic coset and acts by `q`. -/
theorem T_smul_permutationModuleBasis_of_not_minimal
    (d : {d : W // cs.IsMinimalCosetRep J d}) (i : Fin (n - 1))
    (hmin : ¬cs.IsMinimalCosetRep J (cs.simple i * d)) :
    T q i • permutationModuleBasis cs J d =
      (q : R) • permutationModuleBasis (q := q) cs J d := by
  have hi : ¬cs.IsLeftDescent d i :=
    fun h ↦ hmin (d.2.simple_mul_of_isLeftDescent cs h)
  obtain ⟨j, hj, heq⟩ := (d.2.simple_mul_or_exists_eq_mul_simple cs i).resolve_left hmin
  apply Subtype.ext
  simp only [Submodule.coe_smul, Submodule.coe_smul_of_tower, smul_eq_mul,
    coe_permutationModuleBasis]
  rw [← mul_assoc, T_mul_Tw_of_not_isLeftDescent cs hi, heq,
    ← Tw_mul_T_of_not_isRightDescent cs (cs.isMinimalCosetRep_iff.mp d.2 j hj),
    mul_assoc, T_mul_parabolicEigenSum cs J (by simp [sub_mul]) hj, mul_smul_comm]

end TauCeti.TypeAHeckeAlgebra
