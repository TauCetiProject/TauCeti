module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Symmetrizer.Basic
public import Mathlib.RingTheory.SimpleModule.Basic

/-!
# The full symmetrizer eigenline and a semisimplicity obstruction

The simultaneous scalar eigenspace of all simple generators in the regular Hecke module is
exactly the line spanned by the full weighted sum `C(a)`. Its identity PBW coefficient is the
coordinate on that line. This holds over arbitrary commutative rings, without dividing by the
length generating function, including when the two roots of the quadratic coincide.

The line is a central two-sided ideal. If the Hecke algebra is semisimple, the scalar
`P(a) = ∑ w, a ^ (2 * length w)` must be a unit: a generating idempotent for this ideal supplies
its inverse. Thus a vanishing symmetrizer normalization is an obstruction to semisimplicity,
not permission to divide. At `a = q`, this is the row symmetrizer normalization underlying the
quantum-integer semisimplicity criterion. No sufficiency criterion is asserted here.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52, Section 3.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Chapter 3.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ}
variable {W : Type*} [Group W]
variable {cs : CoxeterSystem (CoxeterMatrix.A (n - 1)) W}

/-- A simultaneous scalar eigenvector has PBW coordinates determined by its identity
coefficient. No hypothesis on the scalar is needed for this implication. -/
theorem basisTw_repr_eq_pow_mul_of_forall_T_mul_eq_smul {a : R}
    {x : TypeAHeckeAlgebra R q n} (hx : ∀ i, T q i * x = a • x) (w : W) :
    (basisTw q cs).repr x w = a ^ cs.length w * (basisTw q cs).repr x 1 := by
  classical
  induction hlen : cs.length w using Nat.strong_induction_on generalizing w with
  | ind k ih =>
    by_cases hw : w = 1
    · simp [hw, ← hlen]
    obtain ⟨i, hi⟩ := cs.exists_leftDescent_of_ne_one hw
    have hshort : cs.length (cs.simple i * w) < k := by
      simpa only [CoxeterSystem.IsLeftDescent, hlen] using hi
    have hn : ¬cs.IsLeftDescent (cs.simple i * w) i :=
      cs.isLeftDescent_iff_not_isLeftDescent_mul.mp hi
    have hc := congrArg (fun y => (basisTw q cs).repr y (cs.simple i * w)) (hx i)
    simp only [basisTw_repr_T_mul, hn, ite_false, zero_add,
      cs.simple_mul_simple_cancel_left, map_smul, Finsupp.smul_apply, smul_eq_mul] at hc
    rw [hc, ih _ hshort _ rfl, ← mul_assoc, ← pow_succ', cs.isLeftDescent_iff.mp hi, hlen]

variable [Finite W]

/-- A simultaneous scalar eigenvector is its identity coefficient times the full weighted
sum. In particular the full eigenline has no extra vectors at singular parameters. -/
theorem eq_smul_parabolicEigenSum_univ_of_forall_T_mul_eq_smul {a : R}
    {x : TypeAHeckeAlgebra R q n} (hx : ∀ i, T q i * x = a • x) :
    x = (basisTw q cs).repr x 1 • parabolicEigenSum cs Set.univ a := by
  classical
  apply (basisTw q cs).repr.injective
  ext w
  rw [map_smul, Finsupp.smul_apply, basisTw_repr_parabolicEigenSum,
    cs.parabolic_univ, ite_eq_left (Subgroup.mem_top w), smul_eq_mul,
    basisTw_repr_eq_pow_mul_of_forall_T_mul_eq_smul hx, mul_comm]

variable {a : R}

/-- Membership in the full symmetrizer line is equivalent to the simultaneous generator
eigenvalue equations. This works over rings, not just fields. -/
theorem mem_span_parabolicEigenSum_univ_iff
    (ha : a * a = ((q : R) - ↑q⁻¹) * a + 1) (x : TypeAHeckeAlgebra R q n) :
    x ∈ Submodule.span R {parabolicEigenSum cs Set.univ a} ↔
      ∀ i, T q i * x = a • x := by
  constructor
  · intro hx i
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    rw [mul_smul_comm, T_mul_parabolicEigenSum cs Set.univ ha (Set.mem_univ i),
      smul_comm]
  · intro hx
    exact Submodule.mem_span_singleton.mpr
      ⟨(basisTw q cs).repr x 1,
        (eq_smul_parabolicEigenSum_univ_of_forall_T_mul_eq_smul hx).symm⟩

/-- The full weighted sum is central. The parabolic sum for a proper subgroup need not be. -/
theorem commute_parabolicEigenSum_univ
    (ha : a * a = ((q : R) - ↑q⁻¹) * a + 1) (x : TypeAHeckeAlgebra R q n) :
    Commute (parabolicEigenSum cs Set.univ a) x := by
  apply Algebra.commute_of_mem_adjoin_of_forall_mem_commute (R := R)
    (s := Set.range (T (n := n) q))
  · rw [adjoin_range_T]
    trivial
  · rintro _ ⟨i, rfl⟩
    rw [commute_iff_eq, parabolicEigenSum_mul_T cs Set.univ ha (Set.mem_univ i),
      T_mul_parabolicEigenSum cs Set.univ ha (Set.mem_univ i)]

/-- The left ideal generated by the full weighted sum is exactly its scalar eigenline. -/
theorem mem_ideal_span_parabolicEigenSum_univ_iff
    (ha : a * a = ((q : R) - ↑q⁻¹) * a + 1) (x : TypeAHeckeAlgebra R q n) :
    x ∈ Ideal.span {parabolicEigenSum cs Set.univ a} ↔
      x ∈ Submodule.span R {parabolicEigenSum cs Set.univ a} := by
  constructor
  · intro hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    apply (mem_span_parabolicEigenSum_univ_iff ha _).mpr
    intro i
    rw [← (commute_parabolicEigenSum_univ ha y).eq, ← mul_assoc,
      T_mul_parabolicEigenSum cs Set.univ ha (Set.mem_univ i), smul_mul_assoc]
  · intro hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))

omit [Finite W] in
/-- In a semisimple Hecke algebra the full symmetrizer normalization is a unit. This includes
both roots of the Hecke quadratic and does not assume that the coefficient ring is a field. -/
theorem isUnit_sum_pow_length_of_isSemisimpleRing [Fintype W]
    [IsSemisimpleRing (TypeAHeckeAlgebra R q n)]
    (ha : a * a = ((q : R) - ↑q⁻¹) * a + 1) :
    IsUnit (∑ w : W, a ^ (2 * cs.length w)) := by
  classical
  let C := parabolicEigenSum (q := q) cs Set.univ a
  obtain ⟨e, he, hI⟩ := IsSemisimpleRing.ideal_eq_span_idempotent (Ideal.span {C})
  have hemem : e ∈ Ideal.span {C} := by
    rw [hI]
    exact Ideal.subset_span (Set.mem_singleton e)
  obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp
    ((mem_ideal_span_parabolicEigenSum_univ_iff ha e).mp hemem)
  have hCmem : C ∈ Ideal.span {e} := by
    rw [← hI]
    exact Ideal.subset_span (Set.mem_singleton C)
  obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hCmem
  have hCe : C * e = C := by
    rw [← hy, mul_assoc, he.eq]
  have hnorm : (r * ∑ w : W, a ^ (2 * cs.length w)) • C = (1 : R) • C := by
    calc
      _ = C * (r • C) := by
        rw [mul_smul_comm, parabolicEigenSum_univ_mul_self cs ha, smul_smul]
      _ = C := by rw [hr, hCe]
      _ = (1 : R) • C := (one_smul R C).symm
  have hinv := smul_parabolicEigenSum_injective (q := q) (cs := cs) a hnorm
  exact isUnit_iff_exists_inv'.mpr ⟨r, hinv⟩

omit [Finite W] in
/-- Over a field, semisimplicity forces the full row symmetrizer scalar to be nonzero.
Vanishing therefore detects genuinely nonsemisimple specializations. -/
theorem sum_pow_length_ne_zero_of_isSemisimpleRing {K : Type*} [Field K] {q : Kˣ}
    [Fintype W] [IsSemisimpleRing (TypeAHeckeAlgebra K q n)] :
    (∑ w : W, (q : K) ^ (2 * cs.length w)) ≠ 0 := by
  apply (isUnit_iff_ne_zero).mp
  apply isUnit_sum_pow_length_of_isSemisimpleRing (q := q) (cs := cs)
  simp [sub_mul]

end TauCeti.TypeAHeckeAlgebra
