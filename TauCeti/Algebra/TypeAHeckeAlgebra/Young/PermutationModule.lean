module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Parabolic.PermutationModule
public import TauCeti.Algebra.TypeAHeckeAlgebra.Young.Symmetrizer

/-!
# Young permutation modules of type-`A` Iwahori–Hecke algebras

For a partition `ν` of `n`, the **Young permutation module** `M^ν` of the type-`A` Iwahori–Hecke
algebra `TypeAHeckeAlgebra R q n` is the principal left ideal generated by the Young
`q`-symmetrizer `x_ν = TauCeti.TypeAHeckeAlgebra.youngRowSymmetrizer q ν`,

`youngPermutationModule q ν = H_n(q) x_ν`.

It is defined integrally over any commutative ring `R` and any unit `q : Rˣ`, including at roots of
unity, as a free finitely generated `R`-module of rank `n! / ∏ i, ν_i!`.

When `ν = shapePartition μ` for a Young diagram `μ`, reindexing the parabolic minimal-coset basis
along `TauCeti.RowStandardTableau.minimalCosetRepEquiv` yields the combinatorial Dipper–James basis
`TauCeti.TypeAHeckeAlgebra.youngPermutationModuleBasis q μ` indexed by `RowStandardTableau μ`,
sending a row-standard tableau `t` to `m_t = T_{d(t)} x_μ`. Each Hecke generator `T q i` acts on
`m_t` by the three-case row-comparison rule of Dipper–James and Mathas (Lemma 3.4):

* `q • m_t`, if strands `i` and `i + 1` lie in the same row of `t`;
* `m_{s_i • t}`, if strand `i` lies in a strictly higher (smaller-numbered) row of `t` than
  `i + 1`;
* `(q - q⁻¹) • m_t + m_{s_i • t}`, if strand `i + 1` lies in a strictly higher row of `t` than `i`.

Specializing to `q = 1` over any commutative ring `R`, `Tw 1 _ σ` permutes the basis vectors as
`m_t ↦ m_{σ • t}`, and `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleEquiv` identifies
`youngPermutationModule 1 (shapePartition μ)` `S_n`-equivariantly with the classical symmetric-group
Young permutation module `TauCeti.permutationModule (shapePartition μ)`.

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.youngPermutationModule`: the Young permutation module `M^ν` as a left
  ideal of `TypeAHeckeAlgebra R q n`.
* `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleCosetBasis`: its `R`-basis indexed by minimal
  left-coset representatives of `youngParabolicSet ν`.
* `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleBasis`: the Dipper–James `R`-basis indexed by
  `RowStandardTableau μ`.
* `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleEquiv`: the `q = 1` linear equivalence with
  `(TauCeti.permutationModule (shapePartition μ)).V`.

## Main results

* `TauCeti.TypeAHeckeAlgebra.finrank_youngPermutationModule`: `M^ν` has `R`-rank
  `n! / ∏ i, ν_i!` over any nontrivial commutative ring.
* `TauCeti.TypeAHeckeAlgebra.T_smul_youngPermutationModuleBasis_of_rowIndex_eq`,
  `TauCeti.TypeAHeckeAlgebra.T_smul_youngPermutationModuleBasis_of_rowIndex_lt`,
  `TauCeti.TypeAHeckeAlgebra.T_smul_youngPermutationModuleBasis_of_rowIndex_gt`, and
  `TauCeti.TypeAHeckeAlgebra.T_smul_youngPermutationModuleBasis`: the Dipper–James / Mathas
  Lemma 3.4 generator action on the row-standard-tableau basis.
* `TauCeti.TypeAHeckeAlgebra.youngPermutationModuleEquiv_Tw_smul`: `S_n`-equivariance of the
  `q = 1` comparison with `TauCeti.permutationModule`.

## References

* R. Dipper and G. James, *Representations of Hecke algebras of general linear groups*,
  Proc. London Math. Soc. (3) 52 (1986), 20–52, Section 3.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Theorem 3.3 and Lemma 3.4.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open BraidGroup

section CommRing

variable {R : Type*} [CommRing R]

/-! ### Partition-indexed Young permutation modules and their rank -/

/-- **The Hecke Young permutation module** `M^ν = H_n(q) x_ν`, realized as the principal left ideal
of `TypeAHeckeAlgebra R q n` generated by `youngRowSymmetrizer q ν`. -/
noncomputable def youngPermutationModule (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    Ideal (TypeAHeckeAlgebra R q n) :=
  permutationModule (q := q) (permCoxeterSystem n) (youngParabolicSet ν)

/-- Unfolding equation relating `youngPermutationModule` to `permutationModule`. -/
theorem youngPermutationModule_def (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    youngPermutationModule (R := R) q ν =
      permutationModule (q := q) (permCoxeterSystem n) (youngParabolicSet ν) :=
  (rfl)

/-- `youngPermutationModule q ν` is the left ideal generated by `youngRowSymmetrizer q ν`. -/
theorem youngPermutationModule_eq_span (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    youngPermutationModule (R := R) q ν = Ideal.span {youngRowSymmetrizer q ν} := by
  rw [youngPermutationModule_def, permutationModule_def, youngRowSymmetrizer_def]

/-- Membership in `youngPermutationModule q ν` means being a left multiple of
`youngRowSymmetrizer q ν`. -/
theorem mem_youngPermutationModule_iff (q : Rˣ) {n : ℕ} (ν : n.Partition)
    (x : TypeAHeckeAlgebra R q n) :
    x ∈ youngPermutationModule q ν ↔ ∃ y, y * youngRowSymmetrizer q ν = x := by
  rw [youngPermutationModule_def, youngRowSymmetrizer_def]
  exact mem_permutationModule_iff (permCoxeterSystem n) (youngParabolicSet ν) x

/-- The Young `q`-symmetrizer belongs to `youngPermutationModule q ν`. -/
theorem youngRowSymmetrizer_mem_youngPermutationModule (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    youngRowSymmetrizer q ν ∈ youngPermutationModule q ν :=
  (mem_youngPermutationModule_iff q ν _).mpr ⟨1, one_mul _⟩

/-- On the single-column partition `(1ⁿ)`, the Young permutation module is the regular left module
`⊤` of `TypeAHeckeAlgebra R q n`. -/
@[simp]
theorem youngPermutationModule_ones (q : Rˣ) (n : ℕ) :
    youngPermutationModule (R := R) q (Nat.Partition.ones n) = ⊤ := by
  rw [youngPermutationModule_eq_span, youngRowSymmetrizer_ones, Ideal.span_singleton_one]

/-- The minimal-coset `R`-basis of `youngPermutationModule q ν`. -/
noncomputable def youngPermutationModuleCosetBasis (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    Module.Basis
      {d : Equiv.Perm (Fin n) //
        (permCoxeterSystem n).IsMinimalCosetRep (youngParabolicSet ν) d}
      R (youngPermutationModule (R := R) q ν) :=
  permutationModuleBasis (q := q) (permCoxeterSystem n) (youngParabolicSet ν)

/-- Underlying algebra element of a minimal-coset basis vector: `Tw q _ d * youngRowSymmetrizer`. -/
@[simp]
theorem coe_youngPermutationModuleCosetBasis (q : Rˣ) {n : ℕ} (ν : n.Partition)
    (d : {d : Equiv.Perm (Fin n) //
      (permCoxeterSystem n).IsMinimalCosetRep (youngParabolicSet ν) d}) :
    (youngPermutationModuleCosetBasis (R := R) q ν d : TypeAHeckeAlgebra R q n) =
      Tw q (permCoxeterSystem n) d * youngRowSymmetrizer q ν := by
  rw [youngPermutationModuleCosetBasis, youngRowSymmetrizer_def]
  exact coe_permutationModuleBasis (q := q) (permCoxeterSystem n) (youngParabolicSet ν) d

/-- `youngPermutationModule q ν` is a free `R`-module over every commutative ring `R`. -/
instance instModuleFreeYoungPermutationModule (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    Module.Free R (youngPermutationModule (R := R) q ν) :=
  Module.Free.of_basis (youngPermutationModuleCosetBasis q ν)

/-- `youngPermutationModule q ν` is a finitely generated `R`-module over every commutative ring. -/
instance instModuleFiniteYoungPermutationModule (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    Module.Finite R (youngPermutationModule (R := R) q ν) := by
  let _ := Fintype.ofFinite
    {d : Equiv.Perm (Fin n) // (permCoxeterSystem n).IsMinimalCosetRep (youngParabolicSet ν) d}
  exact Module.Finite.of_basis (youngPermutationModuleCosetBasis q ν)

/-- Over any nontrivial commutative ring, the rank of `youngPermutationModule q ν` equals the index
of `youngSubgroup ν`. -/
theorem finrank_youngPermutationModule_eq_index [Nontrivial R] (q : Rˣ) {n : ℕ}
    (ν : n.Partition) :
    Module.finrank R (youngPermutationModule (R := R) q ν) = (youngSubgroup ν).index := by
  let _ := Fintype.ofFinite
    {d : Equiv.Perm (Fin n) // (permCoxeterSystem n).IsMinimalCosetRep (youngParabolicSet ν) d}
  rw [Module.finrank_eq_card_basis (youngPermutationModuleCosetBasis (R := R) q ν),
    ← Nat.card_eq_fintype_card]
  have hprod := Nat.card_congr
    ((permCoxeterSystem n).minimalCosetRepProdParabolicEquiv (youngParabolicSet ν))
  have hpar : Nat.card ((permCoxeterSystem n).parabolic (youngParabolicSet ν)) =
      (ν.parts.map Nat.factorial).prod := by
    rw [Nat.card_congr (Equiv.subtypeEquivRight fun w => by
      rw [parabolic_youngParabolicSet_eq_youngSubgroup]), card_youngSubgroup]
  rw [Nat.card_prod, hpar, Nat.card_perm, Nat.card_fin, ← youngSubgroup_index_mul ν] at hprod
  have hne : (ν.parts.map Nat.factorial).prod ≠ 0 := by
    apply Multiset.prod_ne_zero
    intro h0
    obtain ⟨p, -, hp⟩ := Multiset.mem_map.mp h0
    exact Nat.factorial_ne_zero p hp
  exact Nat.mul_right_cancel (Nat.pos_of_ne_zero hne) hprod

/-- **Over any nontrivial commutative ring, `youngPermutationModule q ν` is free of rank
`n! / ∏ i, ν_i!`.** -/
@[simp]
theorem finrank_youngPermutationModule [Nontrivial R] (q : Rˣ) {n : ℕ} (ν : n.Partition) :
    Module.finrank R (youngPermutationModule (R := R) q ν) =
      n.factorial / (ν.parts.map Nat.factorial).prod := by
  rw [finrank_youngPermutationModule_eq_index, youngSubgroup_index]

/-! ### Row-standard-tableau basis and Dipper–James / Mathas generator action -/

/-- **The Dipper–James basis** `m_t = T_{d(t)} x_μ` of `youngPermutationModule q (shapePartition μ)`
indexed by row-standard `μ`-tableaux. -/
noncomputable def youngPermutationModuleBasis (q : Rˣ) (μ : YoungDiagram) :
    Module.Basis (RowStandardTableau μ) R
      (youngPermutationModule (R := R) q (shapePartition μ)) :=
  (youngPermutationModuleCosetBasis (R := R) q (shapePartition μ)).reindex
    (RowStandardTableau.minimalCosetRepEquiv μ).symm

/-- Applying `youngPermutationModuleBasis` evaluates `youngPermutationModuleCosetBasis` at the
corresponding minimal coset representative. -/
theorem youngPermutationModuleBasis_eq_cosetBasis (q : Rˣ) (μ : YoungDiagram)
    (t : RowStandardTableau μ) :
    youngPermutationModuleBasis (R := R) q μ t =
      youngPermutationModuleCosetBasis (R := R) q (shapePartition μ)
        (RowStandardTableau.minimalCosetRepEquiv μ t) := by
  rw [youngPermutationModuleBasis, Module.Basis.reindex_apply, Equiv.symm_symm]

/-- Underlying algebra element of the basis vector `m_t`: `T_{rowYoungConjugator t} * x_μ`. -/
@[simp]
theorem coe_youngPermutationModuleBasis (q : Rˣ) (μ : YoungDiagram) (t : RowStandardTableau μ) :
    (youngPermutationModuleBasis (R := R) q μ t : TypeAHeckeAlgebra R q μ.card) =
      Tw q (permCoxeterSystem μ.card) (YoungTableau.rowYoungConjugator t.toTableau) *
        youngRowSymmetrizer q (shapePartition μ) := by
  rw [youngPermutationModuleBasis_eq_cosetBasis, coe_youngPermutationModuleCosetBasis,
    RowStandardTableau.minimalCosetRepEquiv_apply_coe]

/-- **Dipper–James / Mathas Lemma 3.4 (same-row case):** if strands `i` and `i + 1` lie in the same
row of `t`, then `T q i` scales `m_t` by `q`. -/
theorem T_smul_youngPermutationModuleBasis_of_rowIndex_eq (q : Rˣ) {μ : YoungDiagram}
    {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : YoungTableau.rowIndex t.toTableau (strand i) =
      YoungTableau.rowIndex t.toTableau (strandSucc i)) :
    T q i • youngPermutationModuleBasis (R := R) q μ t =
      (q : R) • youngPermutationModuleBasis (R := R) q μ t := by
  rw [youngPermutationModuleBasis_eq_cosetBasis]
  have hnot : ¬ (permCoxeterSystem μ.card).IsMinimalCosetRep
      (youngParabolicSet (shapePartition μ))
      ((permCoxeterSystem μ.card).simple i *
        (RowStandardTableau.minimalCosetRepEquiv μ t : Equiv.Perm (Fin μ.card))) := by
    rw [permCoxeterSystem_simple, RowStandardTableau.minimalCosetRepEquiv_apply_coe,
      RowStandardTableau.isMinimalCosetRep_transposition_mul_rowYoungConjugator_iff]
    exact not_not.mpr h
  exact T_smul_permutationModuleBasis_of_not_minimal
    (permCoxeterSystem μ.card) (youngParabolicSet (shapePartition μ))
    (RowStandardTableau.minimalCosetRepEquiv μ t) i hnot

/-- **Dipper–James / Mathas Lemma 3.4 (ascent case):** if strand `i` lies in a strictly smaller
(higher) row of `t` than `strandSucc i` (`i + 1`), then `T q i • m_t = m_{s_i • t}`. -/
theorem T_smul_youngPermutationModuleBasis_of_rowIndex_lt (q : Rˣ) {μ : YoungDiagram}
    {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : YoungTableau.rowIndex t.toTableau (strand i) <
      YoungTableau.rowIndex t.toTableau (strandSucc i)) :
    T q i • youngPermutationModuleBasis (R := R) q μ t =
      youngPermutationModuleBasis (R := R) q μ (transposition i • t) := by
  rw [youngPermutationModuleBasis_eq_cosetBasis, youngPermutationModuleBasis_eq_cosetBasis]
  have hmin : (permCoxeterSystem μ.card).IsMinimalCosetRep
      (youngParabolicSet (shapePartition μ))
      ((permCoxeterSystem μ.card).simple i *
        (RowStandardTableau.minimalCosetRepEquiv μ t : Equiv.Perm (Fin μ.card))) := by
    rw [permCoxeterSystem_simple, RowStandardTableau.minimalCosetRepEquiv_apply_coe,
      RowStandardTableau.isMinimalCosetRep_transposition_mul_rowYoungConjugator_iff]
    exact h.ne
  have hasc : ¬ (permCoxeterSystem μ.card).IsLeftDescent
      (RowStandardTableau.minimalCosetRepEquiv μ t : Equiv.Perm (Fin μ.card)) i := by
    rw [RowStandardTableau.minimalCosetRepEquiv_apply_coe,
      RowStandardTableau.isLeftDescent_rowYoungConjugator_iff]
    exact h.not_gt
  have hstep := T_smul_permutationModuleBasis_of_ascent (q := q)
    (permCoxeterSystem μ.card) (youngParabolicSet (shapePartition μ))
    (RowStandardTableau.minimalCosetRepEquiv μ t) i hasc hmin
  refine hstep.trans (congrArg
    (youngPermutationModuleCosetBasis (R := R) q (shapePartition μ)) (Subtype.ext ?_))
  dsimp only
  rw [permCoxeterSystem_simple, RowStandardTableau.minimalCosetRepEquiv_apply_coe,
    RowStandardTableau.minimalCosetRepEquiv_apply_coe,
    RowStandardTableau.transposition_mul_rowYoungConjugator_of_rowIndex_ne h.ne]

/-- **Dipper–James / Mathas Lemma 3.4 (descent case):** if `strandSucc i` (`i + 1`) lies in a
strictly smaller (higher) row of `t` than `strand i` (`i`), then
`T q i • m_t = (q - q⁻¹) • m_t + m_{s_i • t}`. -/
theorem T_smul_youngPermutationModuleBasis_of_rowIndex_gt (q : Rˣ) {μ : YoungDiagram}
    {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : YoungTableau.rowIndex t.toTableau (strandSucc i) <
      YoungTableau.rowIndex t.toTableau (strand i)) :
    T q i • youngPermutationModuleBasis (R := R) q μ t =
      ((q : R) - ↑q⁻¹) • youngPermutationModuleBasis (R := R) q μ t +
        youngPermutationModuleBasis (R := R) q μ (transposition i • t) := by
  rw [youngPermutationModuleBasis_eq_cosetBasis, youngPermutationModuleBasis_eq_cosetBasis]
  have hdesc : (permCoxeterSystem μ.card).IsLeftDescent
      (RowStandardTableau.minimalCosetRepEquiv μ t : Equiv.Perm (Fin μ.card)) i := by
    rwa [RowStandardTableau.minimalCosetRepEquiv_apply_coe,
      RowStandardTableau.isLeftDescent_rowYoungConjugator_iff]
  have hstep := T_smul_permutationModuleBasis_of_descent (q := q)
    (permCoxeterSystem μ.card) (youngParabolicSet (shapePartition μ))
    (RowStandardTableau.minimalCosetRepEquiv μ t) i hdesc
  refine hstep.trans (congrArg
    (((q : R) - ↑q⁻¹) • youngPermutationModuleCosetBasis (R := R) q (shapePartition μ)
      (RowStandardTableau.minimalCosetRepEquiv μ t) + ·)
    (congrArg (youngPermutationModuleCosetBasis (R := R) q (shapePartition μ)) (Subtype.ext ?_)))
  dsimp only
  rw [permCoxeterSystem_simple, RowStandardTableau.minimalCosetRepEquiv_apply_coe,
    RowStandardTableau.minimalCosetRepEquiv_apply_coe,
    RowStandardTableau.transposition_mul_rowYoungConjugator_of_rowIndex_ne h.ne']

/-- **Unified Dipper–James / Mathas Lemma 3.4 action formula** for a Hecke generator `T q i` on a
row-standard-tableau basis vector `m_t`. -/
theorem T_smul_youngPermutationModuleBasis (q : Rˣ) (μ : YoungDiagram)
    (t : RowStandardTableau μ) (i : Fin (μ.card - 1)) :
    T q i • youngPermutationModuleBasis (R := R) q μ t =
      if YoungTableau.rowIndex t.toTableau (strand i) =
          YoungTableau.rowIndex t.toTableau (strandSucc i) then
        (q : R) • youngPermutationModuleBasis (R := R) q μ t
      else if YoungTableau.rowIndex t.toTableau (strand i) <
          YoungTableau.rowIndex t.toTableau (strandSucc i) then
        youngPermutationModuleBasis (R := R) q μ (transposition i • t)
      else
        ((q : R) - ↑q⁻¹) • youngPermutationModuleBasis (R := R) q μ t +
          youngPermutationModuleBasis (R := R) q μ (transposition i • t) := by
  rcases lt_trichotomy
      (YoungTableau.rowIndex t.toTableau (strand i))
      (YoungTableau.rowIndex t.toTableau (strandSucc i)) with hlt | heq | hgt
  · rw [ite_eq_right hlt.ne, ite_eq_left hlt]
    exact T_smul_youngPermutationModuleBasis_of_rowIndex_lt q hlt
  · rw [ite_eq_left heq]
    exact T_smul_youngPermutationModuleBasis_of_rowIndex_eq q heq
  · rw [ite_eq_right hgt.ne', ite_eq_right hgt.not_gt]
    exact T_smul_youngPermutationModuleBasis_of_rowIndex_gt q hgt

/-! ### Classical `q = 1` specialization and `S_n`-equivariant isomorphism -/

/-- At `q = 1`, each Hecke generator `T 1 i` permutes the row-standard-tableau basis according to
`transposition i`. -/
@[simp]
theorem T_one_smul_youngPermutationModuleBasis (μ : YoungDiagram) (t : RowStandardTableau μ)
    (i : Fin (μ.card - 1)) :
    T (1 : Rˣ) i • youngPermutationModuleBasis (R := R) (1 : Rˣ) μ t =
      youngPermutationModuleBasis (R := R) (1 : Rˣ) μ (transposition i • t) := by
  rw [T_smul_youngPermutationModuleBasis]
  split_ifs with heq hlt
  · rw [Units.val_one, one_smul, transposition_eq_swap,
      RowStandardTableau.swap_smul_eq_self_of_rowIndex_eq heq]
  · rfl
  · simp

/-- At `q = 1`, every PBW element `Tw 1 _ σ` permutes the row-standard-tableau basis according to
the `S_n`-action `σ • t`. -/
@[simp]
theorem Tw_one_smul_youngPermutationModuleBasis (μ : YoungDiagram)
    (σ : Equiv.Perm (Fin μ.card)) (t : RowStandardTableau μ) :
    Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ •
        youngPermutationModuleBasis (R := R) (1 : Rˣ) μ t =
      youngPermutationModuleBasis (R := R) (1 : Rˣ) μ (σ • t) := by
  obtain ⟨ω, hω, rfl⟩ := (permCoxeterSystem μ.card).exists_isReduced σ
  rw [Tw_wordProd (permCoxeterSystem μ.card) hω, permCoxeterSystem_wordProd]
  clear hω
  induction ω generalizing t with
  | nil => simp
  | cons i ω ih =>
    rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons, mul_smul, ih, mul_smul,
      T_one_smul_youngPermutationModuleBasis]

/-- **Classical `q = 1` Young permutation module isomorphism:** linear equivalence between
`youngPermutationModule (1 : Rˣ) (shapePartition μ)` and the underlying `R`-module of the
symmetric-group Young permutation representation `TauCeti.permutationModule (shapePartition μ)`,
matching `m_t` with the tabloid basis vector `{t}`. -/
noncomputable def youngPermutationModuleEquiv (μ : YoungDiagram) :
    youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ) ≃ₗ[R]
      (TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
  (youngPermutationModuleBasis (R := R) (1 : Rˣ) μ).equiv
    (TauCeti.permutationModuleBasis (R := R) (shapePartition μ))
    (RowStandardTableau.tabloidEquiv μ)

/-- `youngPermutationModuleEquiv` sends the Dipper–James basis vector `m_t` to the tabloid basis
vector `{t}`. -/
@[simp]
theorem youngPermutationModuleEquiv_basis (μ : YoungDiagram) (t : RowStandardTableau μ) :
    youngPermutationModuleEquiv (R := R) μ (youngPermutationModuleBasis (R := R) (1 : Rˣ) μ t) =
      TauCeti.permutationModuleBasis (R := R) (shapePartition μ)
        (YoungTableau.tabloid t.toTableau) := by
  rw [youngPermutationModuleEquiv, Module.Basis.equiv_apply, RowStandardTableau.tabloidEquiv_apply]

/-- **`S_n`-equivariance at `q = 1`:** `youngPermutationModuleEquiv` intertwines the action of
`Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ` on `youngPermutationModule` with the symmetric-group
action `(TauCeti.permutationModule (shapePartition μ)).ρ σ`. -/
theorem youngPermutationModuleEquiv_Tw_smul (μ : YoungDiagram) (σ : Equiv.Perm (Fin μ.card))
    (v : youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ)) :
    youngPermutationModuleEquiv (R := R) μ
        (Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • v) =
      (TauCeti.permutationModule (R := R) (shapePartition μ)).ρ σ
        (youngPermutationModuleEquiv (R := R) μ v) := by
  let smulLin : youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ) →ₗ[R]
      youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ) :=
    { toFun := (Tw (1 : Rˣ) (permCoxeterSystem μ.card) σ • ·)
      map_add' := smul_add _
      map_smul' := fun r x => Subtype.ext (mul_smul_comm r _ x.1) }
  let lhs : youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ) →ₗ[R]
      (TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
    (youngPermutationModuleEquiv (R := R) μ).toLinearMap.comp smulLin
  let rhs : youngPermutationModule (R := R) (1 : Rˣ) (shapePartition μ) →ₗ[R]
      (TauCeti.permutationModule (R := R) (shapePartition μ)).V :=
    ((TauCeti.permutationModule (R := R) (shapePartition μ)).ρ σ).comp
      (youngPermutationModuleEquiv (R := R) μ).toLinearMap
  have heq : lhs = rhs :=
    (youngPermutationModuleBasis (R := R) (1 : Rˣ) μ).ext fun t => by
      dsimp only [lhs, rhs, smulLin, LinearMap.comp_apply, LinearEquiv.coe_coe,
        LinearMap.coe_mk, AddHom.coe_mk]
      rw [Tw_one_smul_youngPermutationModuleBasis, youngPermutationModuleEquiv_basis,
        youngPermutationModuleEquiv_basis, TauCeti.permutationModuleBasis,
        MonoidAlgebra.basis_apply, MonoidAlgebra.basis_apply,
        Representation.ofMulAction_single,
        ← RowStandardTableau.tabloidEquiv_apply, RowStandardTableau.tabloidEquiv_smul,
        RowStandardTableau.tabloidEquiv_apply]
  exact LinearMap.congr_fun heq v

end CommRing

end TauCeti.TypeAHeckeAlgebra
