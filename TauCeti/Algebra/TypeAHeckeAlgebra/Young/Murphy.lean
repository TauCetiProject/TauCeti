module

public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import TauCeti.Algebra.TypeAHeckeAlgebra.Young.PermutationModule

/-!
# Murphy's elements `m_st` of the type-A Hecke algebra

Let `μ` be a Young diagram with `n` cells, `x_μ = TauCeti.TypeAHeckeAlgebra.youngRowSymmetrizer`
the Young `q`-symmetrizer of its row partition, and for a row-standard `μ`-tableau `t` let
`d(t)` be the permutation `TauCeti.YoungTableau.rowYoungConjugator t` carrying the row-reading
tableau `t^μ` to `t`, the minimal representative of its left coset `d(t) S_μ`. **Murphy's
element** of a pair `s`, `t` of row-standard `μ`-tableaux is

`m_st = T_(d(s)) x_μ T_(d(t)⁻¹) = T_(d(s)) x_μ T_(d(t))*`,

where `*` is the reversal anti-involution `TauCeti.TypeAHeckeAlgebra.reverse`, `T_w ↦ T_(w⁻¹)`.
It is defined over every commutative ring and at every unit parameter. In Mathas's right-handed
notation, where `d(t)` stands for the permutation carrying `t` to `t^μ`, this is
`m_st = T_(d(s))* x_μ T_(d(t))`. These are not the Jucys–Murphy elements
`TauCeti.InfiniteTypeAHeckeAlgebra.jucysMurphy`.

Murphy's theorem, which is not proved here, says that for standard tableaux `s` and `t`, with `μ`
running over the partitions of `n`, the `m_st` form a cellular basis of the Hecke algebra, whose
cell modules are the Specht modules. This file proves the properties of the `m_st` that hold for
all row-standard pairs and on which that cellular structure rests:

* `m_st` is the product of the Dipper–James basis vector `m_s = T_(d(s)) x_μ` of the Young
  permutation module `H x_μ` with `T_(d(t)⁻¹)`, and the reversal exchanges `s` and `t`;
* a Hecke generator acts on `m_st` from the left through the Dipper–James row-comparison rule
  on `s`, and from the right through the same rule on `t`;
* the `m_st` span the two-sided ideal `H x_μ H` generated by `x_μ` as an `R`-module.

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.murphyElement`: Murphy's element `m_st` of two row-standard
  tableaux.

## Main results

* `TauCeti.TypeAHeckeAlgebra.reverse_murphyElement`: the reversal sends `m_st` to `m_ts`.
* `TauCeti.TypeAHeckeAlgebra.T_mul_murphyElement_of_rowIndex_eq`,
  `TauCeti.TypeAHeckeAlgebra.T_mul_murphyElement_of_rowIndex_lt`,
  `TauCeti.TypeAHeckeAlgebra.T_mul_murphyElement_of_rowIndex_gt` and their right-handed
  counterparts `TauCeti.TypeAHeckeAlgebra.murphyElement_mul_T_of_rowIndex_eq`, …: the action of
  the generators.
* `TauCeti.TypeAHeckeAlgebra.mem_span_range_murphyElement_iff`: the `R`-span of the `m_st` is
  the two-sided ideal generated by `x_μ`.

## References

* G. E. Murphy, *The representations of Hecke algebras of type `A_n`*, J. Algebra 173 (1995),
  97–121.
* A. Mathas, *Iwahori–Hecke algebras and Schur algebras of the symmetric group*,
  University Lecture Series 15, AMS (1999), Sections 3.2–3.3 and Example 2.15.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open BraidGroup YoungTableau

variable {R : Type*} [CommRing R] (q : Rˣ) {μ : YoungDiagram}

/-- **Murphy's element** `m_st = T_(d(s)) x_μ T_(d(t)⁻¹)` of two row-standard `μ`-tableaux, where
`x_μ` is the Young `q`-symmetrizer of the rows of `μ` and `d(t) = rowYoungConjugator t` is the
minimal left coset representative carrying the row-reading tableau to `t`. For standard `s` and
`t` these are the elements of Murphy's cellular basis. -/
noncomputable def murphyElement (s t : RowStandardTableau μ) : TypeAHeckeAlgebra R q μ.card :=
  Tw q (permCoxeterSystem μ.card) (rowYoungConjugator s.toTableau) *
    youngRowSymmetrizer q (shapePartition μ) *
      Tw q (permCoxeterSystem μ.card) (rowYoungConjugator t.toTableau)⁻¹

/-- Unfolding equation for `murphyElement`. -/
theorem murphyElement_def (s t : RowStandardTableau μ) :
    murphyElement (R := R) q s t =
      Tw q (permCoxeterSystem μ.card) (rowYoungConjugator s.toTableau) *
        youngRowSymmetrizer q (shapePartition μ) *
          Tw q (permCoxeterSystem μ.card) (rowYoungConjugator t.toTableau)⁻¹ :=
  (rfl)

/-- `m_st` is the Dipper–James basis vector `m_s = T_(d(s)) x_μ` of the Young permutation module
multiplied on the right by `T_(d(t)⁻¹)`. -/
theorem murphyElement_eq_youngPermutationModuleBasis_mul (s t : RowStandardTableau μ) :
    murphyElement (R := R) q s t =
      (youngPermutationModuleBasis q μ s : TypeAHeckeAlgebra R q μ.card) *
        Tw q (permCoxeterSystem μ.card) (rowYoungConjugator t.toTableau)⁻¹ := by
  rw [coe_youngPermutationModuleBasis, murphyElement_def]

/-- `m_st` is `T_(d(s))` times the reversal `x_μ T_(d(t)⁻¹)` of the Dipper–James basis vector
`m_t = T_(d(t)) x_μ`. -/
theorem murphyElement_eq_mul_reverse_youngPermutationModuleBasis (s t : RowStandardTableau μ) :
    murphyElement (R := R) q s t =
      Tw q (permCoxeterSystem μ.card) (rowYoungConjugator s.toTableau) *
        reverse q (youngPermutationModuleBasis q μ t : TypeAHeckeAlgebra R q μ.card) := by
  rw [coe_youngPermutationModuleBasis, reverse_mul, reverse_Tw, reverse_youngRowSymmetrizer,
    murphyElement_def, mul_assoc]

/-- The reversal anti-involution transposes Murphy's elements: `m_st* = m_ts`. -/
@[simp]
theorem reverse_murphyElement (s t : RowStandardTableau μ) :
    reverse q (murphyElement (R := R) q s t) = murphyElement q t s := by
  rw [murphyElement_def, murphyElement_def, reverse_mul, reverse_mul, reverse_Tw, reverse_Tw,
    inv_inv, reverse_youngRowSymmetrizer, mul_assoc]

/-- Murphy's element of the row-reading tableau with itself is the Young `q`-symmetrizer. -/
@[simp]
theorem murphyElement_rowSuperstandard_rowSuperstandard :
    murphyElement (R := R) q (RowStandardTableau.rowSuperstandard μ)
        (RowStandardTableau.rowSuperstandard μ) =
      youngRowSymmetrizer q (shapePartition μ) := by
  rw [murphyElement_def, RowStandardTableau.rowSuperstandard_toTableau,
    rowYoungConjugator_rowSuperstandard, inv_one, Tw_one, one_mul, mul_one]

/-- A Murphy element lies in the two-sided ideal generated by the Young `q`-symmetrizer. -/
theorem murphyElement_mem_span_singleton (s t : RowStandardTableau μ) :
    murphyElement (R := R) q s t ∈
      TwoSidedIdeal.span {youngRowSymmetrizer q (shapePartition μ)} :=
  TwoSidedIdeal.mul_mem_right _ _ _ <|
    TwoSidedIdeal.mul_mem_left _ _ _ <| TwoSidedIdeal.subset_span rfl

/-! ### The action of the generators -/

/-- Left multiplication of a Murphy element by `h` is left multiplication of the Dipper–James
basis vector `m_s` by `h`, followed by right multiplication by `T_(d(t)⁻¹)`. -/
private theorem mul_murphyElement (h : TypeAHeckeAlgebra R q μ.card)
    (s t : RowStandardTableau μ) :
    h * murphyElement q s t =
      ((h • youngPermutationModuleBasis q μ s : youngPermutationModule q (shapePartition μ)) :
        TypeAHeckeAlgebra R q μ.card) *
        Tw q (permCoxeterSystem μ.card) (rowYoungConjugator t.toTableau)⁻¹ := by
  rw [murphyElement_eq_youngPermutationModuleBasis_mul, Submodule.coe_smul, smul_eq_mul, mul_assoc]

/-- **Left action, same row:** if `i` and `i + 1` lie in the same row of `s`, then `T i` scales
`m_st` by `q`. -/
theorem T_mul_murphyElement_of_rowIndex_eq {s : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex s.toTableau (strand i) = rowIndex s.toTableau (strandSucc i))
    (t : RowStandardTableau μ) :
    T q i * murphyElement (R := R) q s t = (q : R) • murphyElement q s t := by
  rw [mul_murphyElement, T_smul_youngPermutationModuleBasis_of_rowIndex_eq q h,
    Submodule.coe_smul_of_tower, smul_mul_assoc, murphyElement_eq_youngPermutationModuleBasis_mul]

/-- **Left action, ascent:** if `i` lies in a strictly higher row of `s` than `i + 1`, then
`T i * m_st = m_(s_i s, t)`. -/
theorem T_mul_murphyElement_of_rowIndex_lt {s : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex s.toTableau (strand i) < rowIndex s.toTableau (strandSucc i))
    (t : RowStandardTableau μ) :
    T q i * murphyElement (R := R) q s t = murphyElement q (transposition i • s) t := by
  rw [mul_murphyElement, T_smul_youngPermutationModuleBasis_of_rowIndex_lt q h,
    murphyElement_eq_youngPermutationModuleBasis_mul]

/-- **Left action, descent:** if `i + 1` lies in a strictly higher row of `s` than `i`, then
`T i * m_st = (q - q⁻¹) m_st + m_(s_i s, t)`. -/
theorem T_mul_murphyElement_of_rowIndex_gt {s : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex s.toTableau (strandSucc i) < rowIndex s.toTableau (strand i))
    (t : RowStandardTableau μ) :
    T q i * murphyElement (R := R) q s t =
      ((q : R) - ↑q⁻¹) • murphyElement q s t + murphyElement q (transposition i • s) t := by
  rw [mul_murphyElement, T_smul_youngPermutationModuleBasis_of_rowIndex_gt q h,
    Submodule.coe_add, Submodule.coe_smul_of_tower, add_mul, smul_mul_assoc,
    murphyElement_eq_youngPermutationModuleBasis_mul,
    murphyElement_eq_youngPermutationModuleBasis_mul]

/-- **Right action, same row:** if `i` and `i + 1` lie in the same row of `t`, then `T i` scales
`m_st` by `q`. -/
theorem murphyElement_mul_T_of_rowIndex_eq {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex t.toTableau (strand i) = rowIndex t.toTableau (strandSucc i))
    (s : RowStandardTableau μ) :
    murphyElement (R := R) q s t * T q i = (q : R) • murphyElement q s t := by
  rw [← reverse_murphyElement, ← reverse_T, ← reverse_mul, T_mul_murphyElement_of_rowIndex_eq q h,
    map_smul, reverse_murphyElement]

/-- **Right action, ascent:** if `i` lies in a strictly higher row of `t` than `i + 1`, then
`m_st * T i = m_(s, s_i t)`. -/
theorem murphyElement_mul_T_of_rowIndex_lt {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex t.toTableau (strand i) < rowIndex t.toTableau (strandSucc i))
    (s : RowStandardTableau μ) :
    murphyElement (R := R) q s t * T q i = murphyElement q s (transposition i • t) := by
  rw [← reverse_murphyElement, ← reverse_T, ← reverse_mul, T_mul_murphyElement_of_rowIndex_lt q h,
    reverse_murphyElement]

/-- **Right action, descent:** if `i + 1` lies in a strictly higher row of `t` than `i`, then
`m_st * T i = (q - q⁻¹) m_st + m_(s, s_i t)`. -/
theorem murphyElement_mul_T_of_rowIndex_gt {t : RowStandardTableau μ} {i : Fin (μ.card - 1)}
    (h : rowIndex t.toTableau (strandSucc i) < rowIndex t.toTableau (strand i))
    (s : RowStandardTableau μ) :
    murphyElement (R := R) q s t * T q i =
      ((q : R) - ↑q⁻¹) • murphyElement q s t + murphyElement q s (transposition i • t) := by
  rw [← reverse_murphyElement, ← reverse_T, ← reverse_mul, T_mul_murphyElement_of_rowIndex_gt q h,
    map_add, map_smul, reverse_murphyElement, reverse_murphyElement]

/-! ### The two-sided ideal generated by `x_μ` -/

/-- Every left multiple `y x_μ` of the Young `q`-symmetrizer is a combination of the Dipper–James
basis vectors `m_s = T_(d(s)) x_μ`. -/
private theorem exists_mul_youngRowSymmetrizer_eq_sum (y : TypeAHeckeAlgebra R q μ.card) :
    ∃ c : RowStandardTableau μ → R, y * youngRowSymmetrizer q (shapePartition μ) =
      ∑ s, c s • (youngPermutationModuleBasis q μ s : TypeAHeckeAlgebra R q μ.card) := by
  let v : youngPermutationModule q (shapePartition μ) :=
    ⟨_, (mem_youngPermutationModule_iff q _ _).2 ⟨y, rfl⟩⟩
  refine ⟨(youngPermutationModuleBasis q μ).repr v, ?_⟩
  have h := congrArg Subtype.val ((youngPermutationModuleBasis q μ).sum_repr v)
  simp only [Submodule.coe_sum, Submodule.coe_smul_of_tower] at h
  exact h.symm

/-- **The elements `a x_μ b` are combinations of Murphy's elements.** -/
theorem mul_youngRowSymmetrizer_mul_mem_span_range_murphyElement
    (a b : TypeAHeckeAlgebra R q μ.card) :
    a * youngRowSymmetrizer q (shapePartition μ) * b ∈
      Submodule.span R (Set.range fun p : RowStandardTableau μ × RowStandardTableau μ ↦
        murphyElement q p.1 p.2) := by
  obtain ⟨c, hc⟩ := exists_mul_youngRowSymmetrizer_eq_sum q a
  obtain ⟨d, hd⟩ := exists_mul_youngRowSymmetrizer_eq_sum q (reverse q b)
  -- Reversing `reverse b * x_μ = ∑ d t m_t` writes `x_μ b` through the reversed vectors `m_t*`.
  have hb : youngRowSymmetrizer q (shapePartition μ) * b =
      ∑ t, d t • reverse q (youngPermutationModuleBasis q μ t : TypeAHeckeAlgebra R q μ.card) := by
    have h := congrArg (reverse q) hd
    rw [reverse_mul, reverse_reverse, reverse_youngRowSymmetrizer, map_sum] at h
    simpa only [map_smul] using h
  have hm (s : RowStandardTableau μ) :
      (youngPermutationModuleBasis q μ s : TypeAHeckeAlgebra R q μ.card) * b =
        ∑ t, d t • murphyElement q s t := by
    rw [coe_youngPermutationModuleBasis, mul_assoc, hb, Finset.mul_sum]
    simp only [mul_smul_comm, murphyElement_eq_mul_reverse_youngPermutationModuleBasis]
  rw [hc, Finset.sum_mul]
  refine Submodule.sum_mem _ fun s _ ↦ ?_
  rw [smul_mul_assoc, hm]
  exact Submodule.smul_mem _ _ <| Submodule.sum_mem _ fun t _ ↦
    Submodule.smul_mem _ _ <| Submodule.subset_span ⟨(s, t), rfl⟩

/-- **Murphy's elements span the two-sided ideal generated by `x_μ`:** an element of the Hecke
algebra is an `R`-linear combination of the `m_st`, for `s` and `t` row-standard, exactly when it
lies in `H x_μ H`. -/
theorem mem_span_range_murphyElement_iff {x : TypeAHeckeAlgebra R q μ.card} :
    x ∈ Submodule.span R (Set.range fun p : RowStandardTableau μ × RowStandardTableau μ ↦
        murphyElement q p.1 p.2) ↔
      x ∈ TwoSidedIdeal.span {youngRowSymmetrizer q (shapePartition μ)} := by
  constructor
  · intro hx
    induction hx using Submodule.span_induction with
    | mem _ hy =>
      obtain ⟨p, rfl⟩ := hy
      exact murphyElement_mem_span_singleton q p.1 p.2
    | zero => exact zero_mem _
    | add _ _ _ _ hy hz => exact add_mem hy hz
    | smul r _ _ hy =>
      rw [Algebra.smul_def]
      exact TwoSidedIdeal.mul_mem_left _ _ _ hy
  · intro hx
    rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hx
    induction hx using AddSubgroup.closure_induction with
    | mem _ hy =>
      obtain ⟨_, ⟨a, -, _, rfl, rfl⟩, b, -, rfl⟩ := hy
      exact mul_youngRowSymmetrizer_mul_mem_span_range_murphyElement q a b
    | zero => exact zero_mem _
    | add _ _ _ _ hy hz => exact add_mem hy hz
    | neg _ _ hy => exact neg_mem hy

end TauCeti.TypeAHeckeAlgebra
