/-!
# The balanced projection presentation of the type-A Hecke algebra

For `τ : R`, the balanced projection algebra `BalancedProjectionAlgebra R τ` is the associative
unital `R`-algebra on generators `e i`, `i : ℕ`, subject to

* idempotence `e i * e i = e i`,
* the balanced relation
  `e i * e (i + 1) * e i - τ • e i = e (i + 1) * e i * e (i + 1) - τ • e (i + 1)`, and
* distant commutation `e i * e j = e j * e i` when `|i - j| ≥ 2`.

The balanced relation only equates the two defects `e i * e j * e i - τ • e i` for adjacent
indices `i` and `j`. It is implied by, but does not require, the vanishing of both defects, which
is the pair of Jones relations of the Temperley-Lieb quotient.

When `τ * (q + q⁻¹) ^ 2 = 1` for a unit `q`, the change of generators
`T i = (q + q⁻¹) • e i - q⁻¹`, with inverse `e i = (q + q⁻¹)⁻¹ • (T i + q⁻¹)`, identifies the
balanced projection algebra with the infinite type-A Hecke algebra `InfiniteTypeAHeckeAlgebra R q`
(`TauCeti.BalancedProjectionAlgebra.heckeEquiv`). In Wenzl's generators `g i = q • T i`, with
`t = q ^ 2`, this reads `g i = (1 + t) • e i - 1` and `τ⁻¹ = 2 + t + t⁻¹`. The isomorphism rests on
three identities valid in every `R`-algebra, for `T = (q + q⁻¹) • e - q⁻¹` and
`T' = (q + q⁻¹) • f - q⁻¹`:

* the quadratic defect of `T` is `(q + q⁻¹) ^ 2` times the idempotence defect of `e`;
* for idempotents `e` and `f`, the braid defect `T * T' * T - T' * T * T'` is `(q + q⁻¹) ^ 3`
  times the balanced defect `(e * f * e - τ • e) - (f * e * f - τ • f)`;
* the commutator of `T` and `T'` is `(q + q⁻¹) ^ 2` times that of `e` and `f`.

The isomorphism identifies the finite stages generated by the first generators on both sides, and
a Markov trace with parameter `z` on the Hecke side becomes a functional with projection parameter
`η = (z + q⁻¹) / (q + q⁻¹)`: it multiplies by `η` when a new last projection `e n` is appended.
For the two scalar Markov traces `z = q` and `z = -q⁻¹` this formula gives `η = 1` and `η = 0`.
When `s = q + q⁻¹` is a unit, the image `P i = s⁻¹ • (T i + q⁻¹)` of `e i` is the idempotent
eigenprojection of `T i` for the eigenvalue `q`, so that `T i = q • P i - q⁻¹ • (1 - P i)` and
`T i⁻¹ = q⁻¹ • P i - q • (1 - P i)`.

No star structure, positivity or completion is considered here, and the case `τ = 0`, which admits
no such change of generators, is not treated.

## Main definitions

* `TauCeti.BalancedProjectionAlgebra.Rel`: the defining relations on the free algebra.
* `TauCeti.BalancedProjectionAlgebra`: the balanced projection algebra with parameter `τ`.
* `TauCeti.BalancedProjectionAlgebra.e`: its generators.
* `TauCeti.BalancedProjectionAlgebra.lift`: the universal property.
* `TauCeti.BalancedProjectionAlgebra.stage`: the subalgebra generated by the first generators.
* `TauCeti.BalancedProjectionAlgebra.heckeEquiv`: the isomorphism with the infinite type-A Hecke
  algebra when `τ * (q + q⁻¹) ^ 2 = 1`.

## Main results

* `TauCeti.BalancedProjectionAlgebra.mul_self_sub_eq_smul`,
  `TauCeti.BalancedProjectionAlgebra.mul_mul_sub_mul_mul_eq_smul` and
  `TauCeti.BalancedProjectionAlgebra.mul_sub_mul_eq_smul`: the change-of-generator identities.
* `TauCeti.BalancedProjectionAlgebra.heckeEquiv_e` and
  `TauCeti.BalancedProjectionAlgebra.heckeEquiv_symm_T`: the isomorphism on generators.
* `TauCeti.BalancedProjectionAlgebra.map_stage_heckeEquiv`: the isomorphism matches the stages.
* `TauCeti.InfiniteTypeAHeckeAlgebra.IsMarkovTrace.map_heckeEquiv_mul_e`: the projection parameter
  of a Hecke Markov trace.
* `TauCeti.InfiniteTypeAHeckeAlgebra.T_eq_smul_eigenprojection_sub_smul` and
  `TauCeti.InfiniteTypeAHeckeAlgebra.IsMarkovTrace.map_mul_eigenprojection`: the eigenprojection
  decomposition of a generator, and the projection parameter of a Markov trace in terms of the
  eigenprojection.

## References

* H. Wenzl, *Hecke algebras of type A_n and subfactors*, Invent. Math. 92 (1988), 349–383, for
  the projection generators of the Hecke algebra.
* V. F. R. Jones, *Hecke algebra representations of braid groups and link polynomials*,
  Ann. of Math. 126 (1987), 335–388, for the Ocneanu trace in projection generators.
* The quotient presentation and universal-property API follow
  `TauCeti.Algebra.TypeAHeckeAlgebra.Infinite`.
-/

public section

namespace TauCeti

variable (R : Type*) [CommRing R] (τ : R)

namespace BalancedProjectionAlgebra

/-- The defining relations of the balanced projection algebra with parameter `τ`, as a relation on
the free algebra over the generators `ℕ`: idempotence of each generator, the balanced relation
`e i * e (i + 1) * e i - τ • e i = e (i + 1) * e i * e (i + 1) - τ • e (i + 1)` for adjacent
generators, and commutation of distant generators. The last one is imposed for one ordering of the
pair, which suffices since the quotient relation is symmetric. -/
inductive Rel : FreeAlgebra R ℕ → FreeAlgebra R ℕ → Prop
  | mul_self (i : ℕ) : Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R i) (FreeAlgebra.ι R i)
  | balanced (i : ℕ) :
      Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R (i + 1) * FreeAlgebra.ι R i - τ • FreeAlgebra.ι R i)
        (FreeAlgebra.ι R (i + 1) * FreeAlgebra.ι R i * FreeAlgebra.ι R (i + 1) -
          τ • FreeAlgebra.ι R (i + 1))
  | distant {i j : ℕ} (h : i + 2 ≤ j) :
      Rel (FreeAlgebra.ι R i * FreeAlgebra.ι R j) (FreeAlgebra.ι R j * FreeAlgebra.ι R i)

end BalancedProjectionAlgebra

/-- The balanced projection algebra over `R` with parameter `τ`: the free `R`-algebra on `ℕ` modulo
`TauCeti.BalancedProjectionAlgebra.Rel`. Its generators are idempotents whose adjacent defects
`e i * e j * e i - τ • e i` agree. For `τ * (q + q⁻¹) ^ 2 = 1` it is isomorphic to the infinite
type-A Hecke algebra with parameter `q` (`TauCeti.BalancedProjectionAlgebra.heckeEquiv`). -/
@[expose] def BalancedProjectionAlgebra : Type _ := RingQuot (BalancedProjectionAlgebra.Rel R τ)

instance : Ring (BalancedProjectionAlgebra R τ) :=
  inferInstanceAs (Ring (RingQuot (BalancedProjectionAlgebra.Rel R τ)))

/-- The balanced projection algebra over `R` is an algebra over every ring that `R` is an algebra
over. -/
instance (priority := 900) BalancedProjectionAlgebra.instAlgebra' {S : Type*} [CommSemiring S]
    [Algebra S R] : Algebra S (BalancedProjectionAlgebra R τ) :=
  inferInstanceAs (Algebra S (RingQuot (BalancedProjectionAlgebra.Rel R τ)))

instance : Algebra R (BalancedProjectionAlgebra R τ) := inferInstance

instance {S T : Type*} [CommSemiring S] [CommSemiring T] [SMul S T] [Algebra S R] [Algebra T R]
    [IsScalarTower S T R] : IsScalarTower S T (BalancedProjectionAlgebra R τ) :=
  inferInstanceAs (IsScalarTower S T (RingQuot (BalancedProjectionAlgebra.Rel R τ)))

namespace BalancedProjectionAlgebra

/-- The quotient map from the free algebra to the balanced projection algebra. -/
def mkAlgHom : FreeAlgebra R ℕ →ₐ[R] BalancedProjectionAlgebra R τ :=
  RingQuot.mkAlgHom R (Rel R τ)

variable {R}

/-- The generator `e i` of the balanced projection algebra. -/
def e (i : ℕ) : BalancedProjectionAlgebra R τ :=
  mkAlgHom R τ (FreeAlgebra.ι R i)

variable {τ}

/-- The quotient map takes each free-algebra generator to the corresponding projection. -/
@[simp]
theorem mkAlgHom_ι (i : ℕ) : mkAlgHom R τ (FreeAlgebra.ι R i) = e τ i := (rfl)

/-- Every element of the balanced projection algebra is represented by a free-algebra element. -/
theorem mkAlgHom_surjective : Function.Surjective (mkAlgHom R τ) :=
  RingQuot.mkAlgHom_surjective _ _

/-- Related elements of the free algebra have the same image in the balanced projection
algebra. -/
theorem mkAlgHom_rel {x y : FreeAlgebra R ℕ} (h : Rel R τ x y) : mkAlgHom R τ x = mkAlgHom R τ y :=
  RingQuot.mkAlgHom_rel R h

/-- Each generator is idempotent. -/
@[simp]
theorem e_mul_self (i : ℕ) : e τ i * e τ i = e τ i := by
  simpa only [map_mul, mkAlgHom_ι] using mkAlgHom_rel (Rel.mul_self (R := R) (τ := τ) i)

/-- Each generator is idempotent. -/
theorem isIdempotentElem_e (i : ℕ) : IsIdempotentElem (e τ i) := e_mul_self i

/-- Adjacent generators satisfy the balanced relation: their two defects
`e i * e j * e i - τ • e i` agree. -/
theorem e_balanced (i : ℕ) :
    e τ i * e τ (i + 1) * e τ i - τ • e τ i =
      e τ (i + 1) * e τ i * e τ (i + 1) - τ • e τ (i + 1) := by
  simpa only [map_mul, map_sub, map_smul, mkAlgHom_ι] using
    mkAlgHom_rel (Rel.balanced (R := R) (τ := τ) i)

/-- Two distant generators commute. -/
theorem commute_e {i j : ℕ} (h : i + 2 ≤ j ∨ j + 2 ≤ i) : Commute (e τ i) (e τ j) := by
  rw [commute_iff_eq]
  rcases h with h | h
  · simpa only [map_mul, mkAlgHom_ι] using mkAlgHom_rel (Rel.distant (R := R) (τ := τ) h)
  · simpa only [map_mul, mkAlgHom_ι] using (mkAlgHom_rel (Rel.distant (R := R) (τ := τ) h)).symm

section Lift

variable {A : Type*} [Ring A] [Algebra R A]

/-- The universal property of the balanced projection presentation: a sequence of idempotents in an
`R`-algebra satisfying the balanced relation for adjacent indices and commutation for distant
indices extends to an algebra map out of `BalancedProjectionAlgebra R τ`. -/
def lift (f : ℕ → A) (hself : ∀ i, IsIdempotentElem (f i))
    (hbal : ∀ i, f i * f (i + 1) * f i - τ • f i = f (i + 1) * f i * f (i + 1) - τ • f (i + 1))
    (hdist : ∀ {i j : ℕ}, i + 2 ≤ j → f i * f j = f j * f i) :
    BalancedProjectionAlgebra R τ →ₐ[R] A :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R f, by
    rintro x y (i | i | @⟨i, j, h⟩)
    · simpa only [map_mul, FreeAlgebra.lift_ι_apply] using (hself i).eq
    · simpa only [map_mul, map_sub, map_smul, FreeAlgebra.lift_ι_apply] using hbal i
    · simpa only [map_mul, FreeAlgebra.lift_ι_apply] using hdist h⟩

/-- The algebra map built by `TauCeti.BalancedProjectionAlgebra.lift` takes each generator to its
prescribed value. -/
@[simp]
theorem lift_e (f : ℕ → A) (hself) (hbal) (hdist) (i : ℕ) :
    lift (τ := τ) f hself hbal hdist (e τ i) = f i :=
  (RingQuot.liftAlgHom_mkAlgHom_apply R _ _ _).trans (FreeAlgebra.lift_ι_apply _ _)

/-- Two algebra maps out of the balanced projection algebra agreeing on the generators are
equal. -/
@[ext high]
theorem hom_ext {B : Type*} [Semiring B] [Algebra R B]
    {F G : BalancedProjectionAlgebra R τ →ₐ[R] B} (h : ∀ i, F (e τ i) = G (e τ i)) : F = G :=
  RingQuot.ringQuot_ext' R F G <| FreeAlgebra.hom_ext (funext h)

end Lift

section Stage

variable (R τ) in
/-- The stage of the first `n` strands: the subalgebra generated by the projections
`e 0, …, e (n - 2)`. -/
def stage (n : ℕ) : Subalgebra R (BalancedProjectionAlgebra R τ) :=
  Algebra.adjoin R (Set.range fun i : Fin (n - 1) ↦ e τ i)

/-- A projection with index `i` lies in the stage `n` when `i + 1 < n`. -/
theorem e_mem_stage {i n : ℕ} (h : i + 1 < n) : e τ i ∈ stage R τ n :=
  Algebra.subset_adjoin ⟨⟨i, by omega⟩, rfl⟩

/-- The stage `n` is contained in a subalgebra exactly when every projection with index `i`,
`i + 1 < n`, is. -/
theorem stage_le_iff {n : ℕ} {S : Subalgebra R (BalancedProjectionAlgebra R τ)} :
    stage R τ n ≤ S ↔ ∀ i, i + 1 < n → e τ i ∈ S := by
  rw [stage, Algebra.adjoin_le_iff, Set.range_subset_iff]
  exact ⟨fun h i hi ↦ h ⟨i, by omega⟩, fun h i ↦ h i (by omega)⟩

/-- The stages increase with `n`. -/
theorem stage_mono : Monotone (stage R τ) :=
  fun _ _ hmn ↦ stage_le_iff.2 fun _ hi ↦ e_mem_stage (by omega)

end Stage

section ChangeOfGenerators

/-! ### The change of generators `T = (q + q⁻¹) • e - q⁻¹`

The three identities below hold in every `R`-algebra and compare the Hecke relations of
`T = (q + q⁻¹) • e - q⁻¹` with the projection relations of `e`. -/

variable {A : Type*} [Ring A] [Algebra R A] {q : Rˣ}

/-- The quadratic defect of `T = (q + q⁻¹) • e - q⁻¹` is `(q + q⁻¹) ^ 2` times the idempotence
defect of `e`. -/
theorem mul_self_sub_eq_smul {e x : A} (hx : x = ((q : R) + ↑q⁻¹) • e - algebraMap R A ↑q⁻¹) :
    x * x - (((q : R) - ↑q⁻¹) • x + 1) = ((q : R) + ↑q⁻¹) ^ 2 • (e * e - e) := by
  have hq : (q : R) * ↑q⁻¹ = 1 := q.mul_inv
  subst hx
  simp only [Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm,
    smul_smul, one_mul, mul_one, smul_sub]
  match_scalars <;> grind

/-- For idempotents `e` and `f` and `τ * (q + q⁻¹) ^ 2 = 1`, the braid defect of
`T = (q + q⁻¹) • e - q⁻¹` and `T' = (q + q⁻¹) • f - q⁻¹` is `(q + q⁻¹) ^ 3` times the balanced
defect `(e * f * e - τ • e) - (f * e * f - τ • f)`. -/
theorem mul_mul_sub_mul_mul_eq_smul (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) {e f x y : A}
    (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (hx : x = ((q : R) + ↑q⁻¹) • e - algebraMap R A ↑q⁻¹)
    (hy : y = ((q : R) + ↑q⁻¹) • f - algebraMap R A ↑q⁻¹) :
    x * y * x - y * x * y =
      ((q : R) + ↑q⁻¹) ^ 3 • ((e * f * e - τ • e) - (f * e * f - τ • f)) := by
  have hq : (q : R) * ↑q⁻¹ = 1 := q.mul_inv
  subst hx hy
  simp only [Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm,
    smul_smul, one_mul, mul_one, smul_sub, mul_assoc, he.eq, hf.eq]
  match_scalars <;> grind

/-- The commutator of `T = (q + q⁻¹) • e - q⁻¹` and `T' = (q + q⁻¹) • f - q⁻¹` is
`(q + q⁻¹) ^ 2` times the commutator of `e` and `f`. -/
theorem mul_sub_mul_eq_smul {e f x y : A}
    (hx : x = ((q : R) + ↑q⁻¹) • e - algebraMap R A ↑q⁻¹)
    (hy : y = ((q : R) + ↑q⁻¹) • f - algebraMap R A ↑q⁻¹) :
    x * y - y * x = ((q : R) + ↑q⁻¹) ^ 2 • (e * f - f * e) := by
  subst hx hy
  simp only [Algebra.algebraMap_eq_smul_one, sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm,
    smul_smul, one_mul, mul_one, smul_sub]
  match_scalars <;> ring

end ChangeOfGenerators

end BalancedProjectionAlgebra

/-! ### Idempotence of the eigenprojection of a generator -/

namespace InfiniteTypeAHeckeAlgebra

variable {R} in
/-- The Hecke generator is recovered from the eigenprojection `c • (T i + q⁻¹)`, for an inverse
`c` of `q + q⁻¹`. -/
private theorem T_eq_smul_sub {q : Rˣ} {c : R} (hc : c * ((q : R) + ↑q⁻¹) = 1) (i : ℕ) :
    T q i = ((q : R) + ↑q⁻¹) • (c • (T q i + algebraMap R _ (↑q⁻¹ : R))) -
      algebraMap R _ (↑q⁻¹ : R) := by
  rw [smul_smul, mul_comm, hc, one_smul, add_sub_cancel_right]

variable {R} in
/-- The eigenprojection `P = c • (T i + q⁻¹)` of the generator `T i`, for an inverse `c` of
`q + q⁻¹`, is idempotent: the quadratic defect of `T i` is `(q + q⁻¹) ^ 2` times the idempotence
defect of `P`. -/
theorem isIdempotentElem_eigenprojection {q : Rˣ} {c : R} (hc : c * ((q : R) + ↑q⁻¹) = 1) (i : ℕ) :
    IsIdempotentElem (c • (T q i + algebraMap R _ (↑q⁻¹ : R))) := by
  refine sub_eq_zero.1 (((IsUnit.of_mul_eq_one_right c hc).pow 2).smul_eq_zero.1 ?_)
  rw [← BalancedProjectionAlgebra.mul_self_sub_eq_smul (T_eq_smul_sub hc i), T_mul_self,
    sub_self]

end InfiniteTypeAHeckeAlgebra

namespace BalancedProjectionAlgebra

variable {R τ}

section HeckeEquiv

/-! ### The isomorphism with the infinite type-A Hecke algebra -/

open InfiniteTypeAHeckeAlgebra (T)

variable {q : Rˣ}

/-- The projections `(q + q⁻¹)⁻¹ • (T i + q⁻¹)` of the Hecke algebra satisfy the balanced
presentation. -/
private def toHecke (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) :
    BalancedProjectionAlgebra R τ →ₐ[R] InfiniteTypeAHeckeAlgebra R q :=
  lift (fun i ↦ (τ * ((q : R) + ↑q⁻¹)) • (T q i + algebraMap R _ ↑q⁻¹))
    (fun i ↦ InfiniteTypeAHeckeAlgebra.isIdempotentElem_eigenprojection
      (by linear_combination hτ) i)
    (fun i ↦ by
      have hc : τ * ((q : R) + ↑q⁻¹) * ((q : R) + ↑q⁻¹) = 1 := by linear_combination hτ
      refine sub_eq_zero.1 ((((isUnit_pow_iff two_ne_zero).1
        (IsUnit.of_mul_eq_one_right τ hτ)).pow 3).smul_eq_zero.1 ?_)
      rw [← mul_mul_sub_mul_mul_eq_smul hτ
        (InfiniteTypeAHeckeAlgebra.isIdempotentElem_eigenprojection hc i)
        (InfiniteTypeAHeckeAlgebra.isIdempotentElem_eigenprojection hc (i + 1))
        (InfiniteTypeAHeckeAlgebra.T_eq_smul_sub hc i)
        (InfiniteTypeAHeckeAlgebra.T_eq_smul_sub hc (i + 1)), InfiniteTypeAHeckeAlgebra.T_braid,
        sub_self])
    (fun h ↦ by
      have hc : τ * ((q : R) + ↑q⁻¹) * ((q : R) + ↑q⁻¹) = 1 := by linear_combination hτ
      refine sub_eq_zero.1 ((IsUnit.of_mul_eq_one_right τ hτ).smul_eq_zero.1 ?_)
      rw [← mul_sub_mul_eq_smul (InfiniteTypeAHeckeAlgebra.T_eq_smul_sub hc _)
        (InfiniteTypeAHeckeAlgebra.T_eq_smul_sub hc _),
        (InfiniteTypeAHeckeAlgebra.commute_T (Or.inl h)).eq, sub_self])

/-- The Hecke generators `(q + q⁻¹) • e i - q⁻¹` of the balanced projection algebra satisfy the
Hecke presentation. -/
private def ofHecke (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) :
    InfiniteTypeAHeckeAlgebra R q →ₐ[R] BalancedProjectionAlgebra R τ :=
  InfiniteTypeAHeckeAlgebra.lift (fun i ↦ ((q : R) + ↑q⁻¹) • e τ i - algebraMap R _ ↑q⁻¹)
    (fun i ↦ by rw [← sub_eq_zero, mul_self_sub_eq_smul rfl, e_mul_self, sub_self, smul_zero])
    (fun i ↦ by
      rw [← sub_eq_zero, mul_mul_sub_mul_mul_eq_smul hτ (isIdempotentElem_e i)
        (isIdempotentElem_e (i + 1)) rfl rfl, e_balanced, sub_self, smul_zero])
    (fun h ↦ by
      rw [← sub_eq_zero, mul_sub_mul_eq_smul rfl rfl, (commute_e (Or.inl h)).eq, sub_self,
        smul_zero])

private theorem toHecke_e (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) (i : ℕ) :
    toHecke hτ (e τ i) = (τ * ((q : R) + ↑q⁻¹)) • (T q i + algebraMap R _ ↑q⁻¹) :=
  lift_e _ _ _ _ i

private theorem ofHecke_T (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) (i : ℕ) :
    ofHecke hτ (T q i) = ((q : R) + ↑q⁻¹) • e τ i - algebraMap R _ ↑q⁻¹ :=
  InfiniteTypeAHeckeAlgebra.lift_T _ _ _ _ i

variable (q) in
/-- The balanced projection algebra with parameter `τ` is isomorphic to the infinite type-A Hecke
algebra with parameter `q` when `τ * (q + q⁻¹) ^ 2 = 1`, by the change of generators
`e i ↦ (q + q⁻¹)⁻¹ • (T i + q⁻¹)`, with inverse `T i ↦ (q + q⁻¹) • e i - q⁻¹`. Here
`(q + q⁻¹)⁻¹ = τ * (q + q⁻¹)`. -/
def heckeEquiv (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1) :
    BalancedProjectionAlgebra R τ ≃ₐ[R] InfiniteTypeAHeckeAlgebra R q :=
  AlgEquiv.ofAlgHom (toHecke hτ) (ofHecke hτ)
    (InfiniteTypeAHeckeAlgebra.hom_ext fun i ↦ by
      simp only [AlgHom.comp_apply, ofHecke_T, toHecke_e, map_sub, map_smul, AlgHom.commutes,
        AlgHom.id_apply]
      exact (InfiniteTypeAHeckeAlgebra.T_eq_smul_sub (by linear_combination hτ) i).symm)
    (hom_ext fun i ↦ by
      have h : τ * ((q : R) + ↑q⁻¹) * ((q : R) + ↑q⁻¹) = 1 := by linear_combination hτ
      simp only [AlgHom.comp_apply, toHecke_e, ofHecke_T, map_smul, map_add, AlgHom.commutes,
        sub_add_cancel, smul_smul, h, one_smul, AlgHom.id_apply])

variable (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1)

/-- The isomorphism sends the projection `e i` to `(q + q⁻¹)⁻¹ • (T i + q⁻¹)`, where
`(q + q⁻¹)⁻¹ = τ * (q + q⁻¹)`. -/
@[simp]
theorem heckeEquiv_e (i : ℕ) :
    heckeEquiv q hτ (e τ i) = (τ * ((q : R) + ↑q⁻¹)) • (T q i + algebraMap R _ ↑q⁻¹) :=
  lift_e _ _ _ _ i

/-- The inverse isomorphism sends the Hecke generator `T i` to `(q + q⁻¹) • e i - q⁻¹`. -/
@[simp]
theorem heckeEquiv_symm_T (i : ℕ) :
    (heckeEquiv q hτ).symm (T q i) = ((q : R) + ↑q⁻¹) • e τ i - algebraMap R _ ↑q⁻¹ :=
  InfiniteTypeAHeckeAlgebra.lift_T _ _ _ _ i

/-- The isomorphism carries the stage of the first `n` strands onto the corresponding stage of the
infinite type-A Hecke algebra. -/
theorem map_stage_heckeEquiv (n : ℕ) :
    (stage R τ n).map (heckeEquiv q hτ : BalancedProjectionAlgebra R τ →ₐ[R] _) =
      InfiniteTypeAHeckeAlgebra.stage R q n := by
  refine le_antisymm (Subalgebra.map_le.2 <| stage_le_iff.2 fun i hi ↦ ?_)
    (InfiniteTypeAHeckeAlgebra.stage_le_iff.2 fun i hi ↦
      Subalgebra.mem_map.2
        ⟨(heckeEquiv q hτ).symm (T q i), ?_, (heckeEquiv q hτ).apply_symm_apply _⟩)
  · rw [Subalgebra.mem_comap, AlgEquiv.coe_toAlgHom, heckeEquiv_e]
    exact Subalgebra.smul_mem _
      (add_mem (InfiniteTypeAHeckeAlgebra.T_mem_stage hi) (Subalgebra.algebraMap_mem _ _)) _
  · rw [heckeEquiv_symm_T]
    exact sub_mem (Subalgebra.smul_mem _ (e_mem_stage hi) _) (Subalgebra.algebraMap_mem _ _)

/-- An element lies in a stage of the balanced projection algebra exactly when its image under
the isomorphism lies in the corresponding stage of the infinite type-A Hecke algebra. -/
@[simp]
theorem heckeEquiv_mem_stage_iff {n : ℕ} {w : BalancedProjectionAlgebra R τ} :
    heckeEquiv q hτ w ∈ InfiniteTypeAHeckeAlgebra.stage R q n ↔ w ∈ stage R τ n := by
  rw [← map_stage_heckeEquiv hτ, Subalgebra.mem_map]
  exact ⟨fun ⟨v, hv, h⟩ ↦ (heckeEquiv q hτ).injective h ▸ hv, fun h ↦ ⟨w, h, rfl⟩⟩

end HeckeEquiv

end BalancedProjectionAlgebra

namespace InfiniteTypeAHeckeAlgebra.IsMarkovTrace

open BalancedProjectionAlgebra

variable {R τ} {q : Rˣ} {z : R} {μ : InfiniteTypeAHeckeAlgebra R q →ₗ[R] R}

/-- **The projection parameter of a Hecke Markov trace.** Transported along the isomorphism with
the balanced projection algebra, a Markov trace with parameter `z` multiplies by
`η = (z + q⁻¹) / (q + q⁻¹)` when a new last projection is appended: for `w` in the stage of the
first `n + 1` strands, `μ (w * e n) = η * μ w`. Here `(q + q⁻¹)⁻¹ = τ * (q + q⁻¹)`. -/
theorem map_heckeEquiv_mul_e (hμ : IsMarkovTrace z μ) (hτ : τ * ((q : R) + ↑q⁻¹) ^ 2 = 1)
    {n : ℕ} {w : BalancedProjectionAlgebra R τ}
    (hw : w ∈ BalancedProjectionAlgebra.stage R τ (n + 1)) :
    μ (heckeEquiv q hτ (w * e τ n)) =
      τ * ((q : R) + ↑q⁻¹) * (z + ↑q⁻¹) * μ (heckeEquiv q hτ w) := by
  rw [← heckeEquiv_mem_stage_iff hτ] at hw
  simp only [map_mul, heckeEquiv_e, Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_add,
    mul_one, map_smul, map_add, hμ.map_mul_T hw, smul_eq_mul]
  ring

end InfiniteTypeAHeckeAlgebra.IsMarkovTrace

/-! ### The eigenprojection of a generator -/

namespace InfiniteTypeAHeckeAlgebra

variable {R} {q : Rˣ} (s : Rˣ)

/-- The generator `T i` is `q` on its eigenprojection `P` and `-q⁻¹` on the complement:
`T i = q • P - q⁻¹ • (1 - P)`. -/
theorem T_eq_smul_eigenprojection_sub_smul (hs : (s : R) = q + ↑q⁻¹) (i : ℕ) :
    T q i = (q : R) • ((↑s⁻¹ : R) • (T q i + algebraMap R _ (↑q⁻¹ : R))) -
      (↑q⁻¹ : R) • (1 - (↑s⁻¹ : R) • (T q i + algebraMap R _ (↑q⁻¹ : R))) := by
  have hs' : (↑s⁻¹ : R) * s = 1 := s.inv_mul
  rw [hs] at hs'
  simp only [Algebra.algebraMap_eq_smul_one]
  match_scalars
  · linear_combination -hs'
  · linear_combination -(↑q⁻¹ : R) * hs'

/-- The inverse generator is `q⁻¹` on the eigenprojection `P` of `T i` and `-q` on the
complement: `T i⁻¹ = q⁻¹ • P - q • (1 - P)`. -/
theorem val_inv_unitT_eq_smul_eigenprojection_sub_smul (hs : (s : R) = q + ↑q⁻¹) (i : ℕ) :
    (↑(unitT q i)⁻¹ : InfiniteTypeAHeckeAlgebra R q) =
      (↑q⁻¹ : R) • ((↑s⁻¹ : R) • (T q i + algebraMap R _ (↑q⁻¹ : R))) -
        (q : R) • (1 - (↑s⁻¹ : R) • (T q i + algebraMap R _ (↑q⁻¹ : R))) := by
  have hs' : (↑s⁻¹ : R) * s = 1 := s.inv_mul
  rw [hs] at hs'
  simp only [val_inv_unitT, Algebra.algebraMap_eq_smul_one]
  match_scalars
  · linear_combination -hs'
  · linear_combination -(↑q⁻¹ : R) * hs'

variable {z η : R} {μ : InfiniteTypeAHeckeAlgebra R q →ₗ[R] R}

/-- **The projection parameter of a Markov trace.** If `z = q * η - q⁻¹ * (1 - η)`, a Markov trace
with parameter `z` multiplies by `η` when the eigenprojection of the generator `T n` adding the
new last strand is appended. -/
theorem IsMarkovTrace.map_mul_eigenprojection (hμ : IsMarkovTrace z μ)
    (hs : (s : R) = q + ↑q⁻¹) (hz : z = q * η - ↑q⁻¹ * (1 - η)) {n : ℕ}
    {x : InfiniteTypeAHeckeAlgebra R q} (hx : x ∈ stage R q (n + 1)) :
    μ (x * (↑s⁻¹ : R) • (T q n + algebraMap R _ (↑q⁻¹ : R))) = η * μ x := by
  have hs' : (↑s⁻¹ : R) * s = 1 := s.inv_mul
  rw [hs] at hs'
  rw [mul_smul_comm, map_smul, mul_add, map_add, hμ.map_mul_T hx]
  simp only [Algebra.algebraMap_eq_smul_one, mul_smul_comm, mul_one, map_smul, smul_eq_mul, hz]
  linear_combination η * μ x * hs'

end InfiniteTypeAHeckeAlgebra

end TauCeti
