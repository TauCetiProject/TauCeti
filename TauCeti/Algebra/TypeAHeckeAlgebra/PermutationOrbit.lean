module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Jimbo
public import Mathlib.LinearAlgebra.Finsupp.VectorSpace
public import Mathlib.LinearAlgebra.Dimension.Basic

/-!
# The cyclic permutation-word module of the type-A Hecke algebra

Acting on the increasing word `0, …, n - 1` in the Jimbo word representation produces
exactly the span of words in which every letter occurs once. Thus the Hecke algebra maps
onto a free module of rank `n!`. In particular, over every nontrivial commutative ring,
its module rank is at least `n!`.

This supplies the independence side of the permutation-basis construction: any family of
Hecke elements taking the increasing word to the distinct permutation words is linearly
independent. It does not identify the full tensor representation with the regular module,
nor prove that the cyclic orbit map is injective.

The construction uses `TypeAHeckeAlgebra.jimbo` and Mathlib's adjacent-transposition
generation theorem `Equiv.Perm.mclosure_swap_castSucc_succ`.

## References

* M. Jimbo, *A q-analogue of U(gl(N+1)), Hecke algebra, and the Yang-Baxter equation*,
  Lett. Math. Phys. 11 (1986), 247–252.
* M. Geck and G. Pfeiffer, *Characters of finite Coxeter groups and Iwahori–Hecke algebras*,
  Chapter 4, for the permutation-basis theorem.
-/

public section

namespace TauCeti.TypeAHeckeAlgebra

open Finsupp

variable {R : Type*} [CommRing R] (q : Rˣ) {n : ℕ}

/-- Evaluate the Jimbo action on the increasing word. Its image is exactly the span of
permutation words (`range_permutationOrbit`). -/
noncomputable def permutationOrbit :
    TypeAHeckeAlgebra R q n →ₗ[R] ((Fin n → Fin n) →₀ R) :=
  (LinearMap.applyₗ (R := R) (single id 1)).comp (jimbo (Fin n) q).toLinearMap

/-- The orbit map is evaluation of the Jimbo action on the increasing word. -/
theorem permutationOrbit_apply (x : TypeAHeckeAlgebra R q n) :
    permutationOrbit q x = jimbo (Fin n) q x (single id 1) := (rfl)

/-- The identity takes the increasing word to itself. -/
@[simp]
theorem permutationOrbit_one : permutationOrbit (n := n) q 1 = single id 1 := by
  simp [permutationOrbit_apply]

/-- The orbit map intertwines left multiplication and the Jimbo action. -/
theorem permutationOrbit_mul (x y : TypeAHeckeAlgebra R q n) :
    permutationOrbit q (x * y) = jimbo (Fin n) q x (permutationOrbit q y) := by
  simp [permutationOrbit_apply, Module.End.mul_apply]

private theorem jimbo_T_single_perm (i : Fin (n - 1)) (σ : Equiv.Perm (Fin n)) :
    jimbo (Fin n) q (T q i) (single (σ : Fin n → Fin n) 1) =
      if σ (BraidGroup.strand i) < σ (BraidGroup.strandSucc i) then
        single (⇑(σ * BraidGroup.transposition i)) 1
      else single (⇑(σ * BraidGroup.transposition i)) 1 +
        ((q : R) - ↑q⁻¹) • single (σ : Fin n → Fin n) 1 := by
  have hne := σ.injective.ne (BraidGroup.strand_ne_strandSucc i)
  -- Permutation multiplication is composition, so swapping positions is right multiplication.
  simp only [jimbo_T, KnotTheory.jimboGenerator_single_one, hne, ↓reduceIte,
    BraidGroup.transposition_eq_swap, Equiv.Perm.coe_mul]

private theorem single_perm_mem_range (σ : Equiv.Perm (Fin n)) :
    single (σ : Fin n → Fin n) 1 ∈ LinearMap.range (permutationOrbit q) := by
  have hstep (σ : Equiv.Perm (Fin n)) (i : Fin (n - 1))
      (hσ : single (σ : Fin n → Fin n) 1 ∈ LinearMap.range (permutationOrbit q)) :
      single (⇑(σ * BraidGroup.transposition i)) 1 ∈
        LinearMap.range (permutationOrbit q) := by
    obtain ⟨x, hx⟩ := hσ
    have hT : jimbo (Fin n) q (T q i) (single (σ : Fin n → Fin n) 1) ∈
        LinearMap.range (permutationOrbit q) :=
      ⟨T q i * x, by rw [permutationOrbit_mul, hx]⟩
    rw [jimbo_T_single_perm] at hT
    split_ifs at hT with h
    · exact hT
    · exact ((LinearMap.range (permutationOrbit q)).add_mem_iff_left
        ((LinearMap.range (permutationOrbit q)).smul_mem _ ⟨x, hx⟩)).mp hT
  have hone : single (⇑(1 : Equiv.Perm (Fin n))) 1 ∈
      LinearMap.range (permutationOrbit q) := ⟨1, permutationOrbit_one q⟩
  cases n with
  | zero =>
    have hσ : σ = 1 := Subsingleton.elim _ _
    simpa only [hσ] using hone
  | succ m =>
    induction σ using Submonoid.induction_of_closure_eq_top_right
        (Equiv.Perm.mclosure_swap_castSucc_succ m) with
    | one => exact hone
    | mul_right σ s hs ih =>
      obtain ⟨i, rfl⟩ := hs
      simpa only [BraidGroup.transposition_eq_swap_castSucc_succ] using hstep σ i ih

/-- The cyclic Jimbo module generated by the increasing word consists exactly of the
linear combinations of permutation words. This holds over any commutative coefficient ring
and at every unit parameter, including the repeated-root specializations. -/
theorem range_permutationOrbit :
    LinearMap.range (permutationOrbit (n := n) q) =
      Submodule.span R (Set.range fun σ : Equiv.Perm (Fin n) ↦
        single (σ : Fin n → Fin n) (1 : R)) := by
  let P := Submodule.span R (Set.range fun σ : Equiv.Perm (Fin n) ↦
    single (σ : Fin n → Fin n) (1 : R))
  have hT (i : Fin (n - 1)) (v) (hv : v ∈ P) : jimbo (Fin n) q (T q i) v ∈ P := by
    induction hv using Submodule.span_induction with
    | mem v hv =>
      obtain ⟨σ, rfl⟩ := hv
      rw [jimbo_T_single_perm]
      split_ifs
      · exact Submodule.subset_span ⟨_, rfl⟩
      · exact P.add_mem (Submodule.subset_span ⟨_, rfl⟩)
          (P.smul_mem _ (Submodule.subset_span ⟨σ, rfl⟩))
    | zero => simp
    | add x y hx hy ihx ihy => simpa only [map_add] using P.add_mem ihx ihy
    | smul r x hx ih => simpa only [map_smul] using P.smul_mem r ih
  have hstable (x : TypeAHeckeAlgebra R q n) : ∀ v ∈ P, jimbo (Fin n) q x v ∈ P := by
    have hx : x ∈ Algebra.adjoin R (Set.range (T (n := n) q)) := by
      rw [adjoin_range_T]; trivial
    induction hx using Algebra.adjoin_induction with
    | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hT i
    | algebraMap r => intro v hv; simpa using P.smul_mem r hv
    | add x y hx hy ihx ihy =>
      intro v hv
      simpa using P.add_mem (ihx v hv) (ihy v hv)
    | mul x y hx hy ihx ihy =>
      intro v hv
      simpa only [map_mul, Module.End.mul_apply] using ihx _ (ihy v hv)
  refine le_antisymm ?_ (Submodule.span_le.mpr ?_)
  · rintro v ⟨x, rfl⟩
    exact hstable x _ (Submodule.subset_span ⟨1, rfl⟩)
  · rintro v ⟨σ, rfl⟩
    exact single_perm_mem_range q σ

/-- The finite Hecke algebra contains a linearly independent family indexed by all strand
permutations, lifting the corresponding word vectors under the cyclic Jimbo orbit map. -/
theorem exists_linearIndependent_permutationOrbit :
    ∃ b : Equiv.Perm (Fin n) → TypeAHeckeAlgebra R q n,
      LinearIndependent R b ∧ ∀ σ, permutationOrbit q (b σ) = single (σ : Fin n → Fin n) 1 := by
  classical
  choose b hb using fun σ : Equiv.Perm (Fin n) ↦ single_perm_mem_range q σ
  refine ⟨b, ?_, hb⟩
  apply LinearIndependent.of_comp (permutationOrbit q)
  simpa only [Function.comp_def, hb] using
    (Finsupp.linearIndependent_single_one R (Fin n → Fin n)).comp
      (fun σ : Equiv.Perm (Fin n) ↦ (σ : Fin n → Fin n)) Equiv.coe_fn_injective

/-- The module rank of the type-A Hecke algebra on `n` strands is at least `n!`, over
every nontrivial commutative ring and for every unit Hecke parameter. -/
theorem factorial_le_rank [Nontrivial R] :
    (n.factorial : Cardinal) ≤ Module.rank R (TypeAHeckeAlgebra R q n) := by
  obtain ⟨b, hb, _⟩ := exists_linearIndependent_permutationOrbit (n := n) q
  simpa only [Cardinal.mk_fintype, Fintype.card_perm, Fintype.card_fin,
    Cardinal.lift_natCast, Cardinal.lift_id'] using hb.cardinal_lift_le_rank

end TauCeti.TypeAHeckeAlgebra
