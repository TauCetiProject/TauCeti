module

public import TauCeti.Algebra.TypeAHeckeAlgebra.Coxeter

/-!
# Reduced-word elements of the type-A Hecke algebra

Let `cs` be a Coxeter system of type `A_(n-1)` on a group `W`, so that its simple reflections are
indexed by the generators `T i`, `i : Fin (n - 1)`, of the Hecke algebra `TypeAHeckeAlgebra R q n`
on `n` strands. For `w : W` the element `TypeAHeckeAlgebra.Tw cs w`, usually written `T_w`, is the
product `T i₁ * ⋯ * T iₖ` along any reduced expression `w = s i₁ ⋯ s iₖ`. It is the image of the
element `T_w` of the Hecke algebra of the type-A Coxeter matrix
(`CoxeterMatrix.HeckeAlgebra.Tw`) under the isomorphism
`TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra`, so it does not depend on the reduced expression,
and its multiplication rules and spanning property are transported from the general ones.

The elements `T_w` multiply by the length rule: `T_v * T_w = T_(v * w)` when lengths add, and
multiplication by a generator `T i` on either side follows the length-increase/length-decrease
rule,
* `T i * T_w = T_(s i * w)` if `ℓ (s i * w) = ℓ w + 1`, and
* `T i * T_w = (q - q⁻¹) • T_w + T_(s i * w)` if `ℓ (s i * w) < ℓ w`,

with the mirror statements on the right. Consequently the elements `T_w` span the Hecke algebra as
an `R`-module. The Coxeter system is an arbitrary one of type `A_(n-1)`, so these statements apply
to the abstract Coxeter group `(CoxeterMatrix.A (n - 1)).Group` and to any concrete model of it,
such as the symmetric group on `n` letters.

## Main definitions

* `TauCeti.TypeAHeckeAlgebra.Tw`: the element `T_w` attached to `w : W`.

## Main results

* `TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra_Tw` and
  `TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra_symm_Tw`: `T_w` corresponds to the element `T_w`
  of the Hecke algebra of the type-A Coxeter matrix.
* `TauCeti.TypeAHeckeAlgebra.Tw_wordProd`: `T_w` is the product of the generators along any
  reduced expression of `w`.
* `TauCeti.TypeAHeckeAlgebra.Tw_mul_Tw`: `T_v * T_w = T_(v * w)` when `ℓ (v * w) = ℓ v + ℓ w`.
* `TauCeti.TypeAHeckeAlgebra.T_mul_Tw_of_not_isLeftDescent`,
  `TauCeti.TypeAHeckeAlgebra.T_mul_Tw_of_isLeftDescent`,
  `TauCeti.TypeAHeckeAlgebra.Tw_mul_T_of_not_isRightDescent` and
  `TauCeti.TypeAHeckeAlgebra.Tw_mul_T_of_isRightDescent`: multiplication by a generator.
* `TauCeti.TypeAHeckeAlgebra.mul_mem_span_image_Tw`: the subalgebra generated by the `T i`,
  `i ∈ J`, preserves the span of the `T_w`, `w ∈ S`, when `S` is stable under the `s i`, `i ∈ J`.
* `TauCeti.TypeAHeckeAlgebra.span_range_Tw`: the elements `T_w` span the Hecke algebra.

## References

* N. Iwahori, *On the structure of a Hecke ring of a Chevalley group over a finite field*,
  J. Fac. Sci. Univ. Tokyo Sect. I 10 (1964), 215–236.
* J. E. Humphreys, *Reflection Groups and Coxeter Groups*, CUP (1990), Section 7.1.
* M. Geck and G. Pfeiffer, *Characters of Finite Coxeter Groups and Iwahori-Hecke Algebras*,
  OUP (2000), Section 4.4.
-/

public section

namespace TauCeti

namespace TypeAHeckeAlgebra

open CoxeterSystem

variable {R : Type*} [CommRing R] {q : Rˣ} {n : ℕ}
variable {W : Type*} [Group W] (cs : CoxeterSystem (CoxeterMatrix.A (n - 1)) W)

variable (q) in
/-- The element `T_w` of the type-A Hecke algebra attached to an element `w` of a Coxeter system
of type `A_(n-1)`: the image of the element `T_w` of the Hecke algebra of the type-A Coxeter
matrix under `TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra`. It is the product of the generators
`T i` along any reduced expression of `w` (`TauCeti.TypeAHeckeAlgebra.Tw_wordProd`). -/
noncomputable def Tw (w : W) : TypeAHeckeAlgebra R q n :=
  (algEquivHeckeAlgebra R q n).symm (CoxeterMatrix.HeckeAlgebra.Tw _ cs w)

/-- The inverse of `TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra` takes the element `T_w` of the
Hecke algebra of the Coxeter matrix to the element `T_w` of the type-A Hecke algebra. -/
@[simp]
theorem algEquivHeckeAlgebra_symm_Tw (w : W) :
    (algEquivHeckeAlgebra R q n).symm (CoxeterMatrix.HeckeAlgebra.Tw _ cs w) = Tw q cs w :=
  (rfl)

/-- The isomorphism `TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra` takes the element `T_w` of the
type-A Hecke algebra to the element `T_w` of the Hecke algebra of the Coxeter matrix. -/
@[simp]
theorem algEquivHeckeAlgebra_Tw (w : W) :
    algEquivHeckeAlgebra R q n (Tw q cs w) = CoxeterMatrix.HeckeAlgebra.Tw _ cs w :=
  (AlgEquiv.apply_symm_apply _ _)

/-- `T_w` is the product of the generators along any reduced expression of `w`. -/
theorem Tw_wordProd {ω : List (Fin (n - 1))} (hω : cs.IsReduced ω) :
    Tw q cs (cs.wordProd ω) = (ω.map (T (R := R) q)).prod := by
  rw [← algEquivHeckeAlgebra_symm_Tw, CoxeterMatrix.HeckeAlgebra.Tw_wordProd hω, map_list_prod,
    List.map_map]
  congr 1
  exact List.map_congr_left fun i _ ↦ algEquivHeckeAlgebra_symm_T i

/-- The element `T_w` attached to the identity is `1`. -/
@[simp]
theorem Tw_one : Tw q cs (1 : W) = (1 : TypeAHeckeAlgebra R q n) := by
  simp [← algEquivHeckeAlgebra_symm_Tw]

/-- The element `T_w` attached to a simple reflection is the corresponding generator. -/
@[simp]
theorem Tw_simple (i : Fin (n - 1)) :
    Tw q cs (cs.simple i) = (T q i : TypeAHeckeAlgebra R q n) := by
  simp [← algEquivHeckeAlgebra_symm_Tw]

/-- Each element `T_w` is invertible. -/
theorem isUnit_Tw (w : W) : IsUnit (Tw q cs w : TypeAHeckeAlgebra R q n) :=
  (CoxeterMatrix.HeckeAlgebra.isUnit_Tw _ cs w).map (algEquivHeckeAlgebra R q n).symm

/-- **Length additivity.** If `ℓ (v * w) = ℓ v + ℓ w`, then `T_v * T_w = T_(v * w)`. -/
theorem Tw_mul_Tw {v w : W} (h : cs.length (v * w) = cs.length v + cs.length w) :
    Tw q cs v * Tw q cs w = (Tw q cs (v * w) : TypeAHeckeAlgebra R q n) :=
  (algEquivHeckeAlgebra R q n).injective <| by
    simpa using CoxeterMatrix.HeckeAlgebra.Tw_mul_Tw h

/-- **Left multiplication, length increase.** If `s i * w` is longer than `w`, then
`T i * T_w = T_(s i * w)`. -/
theorem T_mul_Tw_of_not_isLeftDescent {w : W} {i : Fin (n - 1)} (h : ¬cs.IsLeftDescent w i) :
    T q i * Tw q cs w = (Tw q cs (cs.simple i * w) : TypeAHeckeAlgebra R q n) :=
  (algEquivHeckeAlgebra R q n).injective <| by
    simpa using CoxeterMatrix.HeckeAlgebra.T_mul_Tw_of_not_isLeftDescent h

/-- **Right multiplication, length increase.** If `w * s i` is longer than `w`, then
`T_w * T i = T_(w * s i)`. -/
theorem Tw_mul_T_of_not_isRightDescent {w : W} {i : Fin (n - 1)} (h : ¬cs.IsRightDescent w i) :
    Tw q cs w * T q i = (Tw q cs (w * cs.simple i) : TypeAHeckeAlgebra R q n) :=
  (algEquivHeckeAlgebra R q n).injective <| by
    simpa using CoxeterMatrix.HeckeAlgebra.Tw_mul_T_of_not_isRightDescent h

/-- **Left multiplication, length decrease.** If `s i * w` is shorter than `w`, then
`T i * T_w = (q - q⁻¹) • T_w + T_(s i * w)`. -/
theorem T_mul_Tw_of_isLeftDescent {w : W} {i : Fin (n - 1)} (h : cs.IsLeftDescent w i) :
    T q i * Tw q cs w =
      ((q : R) - ↑q⁻¹) • Tw q cs w + (Tw q cs (cs.simple i * w) : TypeAHeckeAlgebra R q n) :=
  (algEquivHeckeAlgebra R q n).injective <| by
    simpa using CoxeterMatrix.HeckeAlgebra.T_mul_Tw_of_isLeftDescent h

/-- **Right multiplication, length decrease.** If `w * s i` is shorter than `w`, then
`T_w * T i = (q - q⁻¹) • T_w + T_(w * s i)`. -/
theorem Tw_mul_T_of_isRightDescent {w : W} {i : Fin (n - 1)} (h : cs.IsRightDescent w i) :
    Tw q cs w * T q i =
      ((q : R) - ↑q⁻¹) • Tw q cs w + (Tw q cs (w * cs.simple i) : TypeAHeckeAlgebra R q n) :=
  (algEquivHeckeAlgebra R q n).injective <| by
    simpa using CoxeterMatrix.HeckeAlgebra.Tw_mul_T_of_isRightDescent h

/-- The span of the elements `T_w`, `w ∈ S`, is the image under the inverse of
`TauCeti.TypeAHeckeAlgebra.algEquivHeckeAlgebra` of the span of the corresponding elements of the
Hecke algebra of the Coxeter matrix. -/
private theorem span_image_Tw (S : Set W) :
    Submodule.span R (Tw q cs '' S) =
      (Submodule.span R (CoxeterMatrix.HeckeAlgebra.Tw _ cs '' S)).map
        (algEquivHeckeAlgebra R q n).symm.toLinearMap := by
  rw [← Submodule.span_image, Set.image_image]
  simp

/-- Let `S ⊆ W` be closed under left multiplication by the simple reflections `s i`, `i ∈ J`. Then
the subalgebra generated by the generators `T i`, `i ∈ J`, multiplies the span of the elements
`T_w`, `w ∈ S`, into itself. -/
theorem mul_mem_span_image_Tw {J : Set (Fin (n - 1))} {S : Set W}
    (hS : ∀ i ∈ J, ∀ w ∈ S, cs.simple i * w ∈ S) {x y : TypeAHeckeAlgebra R q n}
    (hx : x ∈ Algebra.adjoin R (T q '' J)) (hy : y ∈ Submodule.span R (Tw q cs '' S)) :
    x * y ∈ Submodule.span R (Tw q cs '' S) := by
  have hadj : Algebra.adjoin R (T q '' J) =
      (Algebra.adjoin R (CoxeterMatrix.HeckeAlgebra.T _ ((q : R) - ↑q⁻¹) '' J)).map
        (algEquivHeckeAlgebra R q n).symm.toAlgHom := by
    rw [AlgHom.map_adjoin, Set.image_image]
    simp
  rw [span_image_Tw] at hy ⊢
  rw [hadj] at hx
  obtain ⟨x', hx', rfl⟩ := Subalgebra.mem_map.mp hx
  obtain ⟨y', hy', rfl⟩ := Submodule.mem_map.mp hy
  exact Submodule.mem_map.mpr
    ⟨x' * y', CoxeterMatrix.HeckeAlgebra.mul_mem_span_image_Tw hS hx' hy', by simp⟩

/-- The elements `T_w` span the type-A Hecke algebra as an `R`-module. -/
theorem span_range_Tw :
    Submodule.span R (Set.range (Tw q cs : W → TypeAHeckeAlgebra R q n)) = ⊤ := by
  rw [← Set.image_univ, span_image_Tw]
  simp [CoxeterMatrix.HeckeAlgebra.span_range_Tw]

end TypeAHeckeAlgebra

end TauCeti
