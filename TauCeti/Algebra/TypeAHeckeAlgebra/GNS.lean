module

public import TauCeti.Analysis.StarAlgebra.GNS.Unitary
public import TauCeti.Algebra.TypeAHeckeAlgebra.BalancedProjection.GNS
import TauCeti.Algebra.TypeAHeckeAlgebra.RepeatedRoot
import TauCeti.Analysis.Complex.Basic

/-!
# GNS representations and exceptional-parameter positivity of the type-A Hecke algebra

This file develops the Hilbert-space GNS representation theory of `InfiniteTypeAHeckeAlgebra ℂ q`
across both complex `⋆`-algebra parameter fibers, together with the scalar collapse of positive
functionals and positive Markov traces in the repeated-root (`q = ±i`) and unit-circle collapse
(`(q + q⁻¹) ^ 2 ≤ 1`, including `l = 3`) regimes.

1. **Real-parameter fiber (`Fact (IsSelfAdjoint (q : ℂ))`)**: `q + q⁻¹ ≠ 0`, so
   `InfiniteTypeAHeckeAlgebra ℂ q` is generated by star eigenprojections via `heckeStarAlgEquiv`,
   giving `φ.boundedSubalgebra = ⊤` and a bounded GNS representation `gnsRepresentation φ`.
2. **Unit-circle fiber (`InfiniteTypeAHeckeAlgebra.UnitCircle`, `Fact ((q : ℂ) ∈ unitary ℂ)`)**:
   every `T i` is unitary, giving isometric left multiplication, `φ.boundedSubalgebra = ⊤`, and a
   unitary GNS representation for all modulus-one `q` (including `q = ±i`). Combining the
   proper-star repeated-root collapse (`TauCeti.Algebra.TypeAHeckeAlgebra.RepeatedRoot`) at
   `q + q⁻¹ = 0` with balanced-projection collapse for `τ = ((q + q⁻¹) ^ 2)⁻¹ ≥ 1` classifies all
   positive Markov traces whenever `(q + q⁻¹) ^ 2 ≤ 1`.

## Main definitions and results

* `TauCeti.InfiniteTypeAHeckeAlgebra.gnsRepresentation`,
  `TauCeti.InfiniteTypeAHeckeAlgebra.gnsRepresentation_eq_boundedRepresentation`,
  `exists_cstar_representation_iff`: real-fiber bounded GNS representation and C⋆-characterization
  of positivity.
* `TauCeti.InfiniteTypeAHeckeAlgebra.UnitCircle.gnsRepresentation`,
  `UnitCircle.gnsRepresentation_eq_boundedRepresentation`,
  `UnitCircle.exists_cstar_representation_iff`: unit-circle unitary GNS representation and
  C⋆-characterization of positivity.
* `UnitCircle.gnsRepresentation_eq_smul_one`, `UnitCircle.apply_eq_indexCharacter_mul_apply_one`,
  `UnitCircle.apply_one_eq_one_and_forall_star_mul_self_nonneg_iff_of_add_inv_eq_zero`,
  `UnitCircle.isMarkovTrace_and_forall_star_mul_self_nonneg_iff_of_add_inv_sq_le_one`:
  unique normalized positive functional at `q = ±i` and positive Markov trace classification for
  `(q + q⁻¹) ^ 2 ≤ 1`.

## References

* H. Wenzl, *Hecke algebras of type A_n and subfactors*, Invent. Math. 92 (1988), 349–383, §§2–3.
* V. F. R. Jones, *Hecke algebra representations of braid groups and link polynomials*,
  Ann. of Math. 126 (1987), 335–388, §§4, 5, 11.
-/

public section

noncomputable section

open scoped ComplexOrder

namespace TauCeti.InfiniteTypeAHeckeAlgebra

/-! ### Real-parameter fiber: `Fact (IsSelfAdjoint (q : ℂ))` -/

section RealParameter

variable {q : ℂˣ} [hq : Fact (IsSelfAdjoint (q : ℂ))]

private theorem exists_adjoin_isStarProjection_eq_top :
    ∃ s : Set (InfiniteTypeAHeckeAlgebra ℂ q),
      Algebra.adjoin ℂ s = ⊤ ∧ ∀ p ∈ s, IsStarProjection p := by
  let τ : ℂ := (((q : ℂ) + ↑q⁻¹) ^ 2)⁻¹
  have hτ : τ * ((q : ℂ) + ↑q⁻¹) ^ 2 = 1 :=
    inv_mul_cancel₀ (pow_ne_zero 2 (Complex.add_inv_ne_zero_of_isSelfAdjoint hq.out))
  have : Fact (IsSelfAdjoint τ) :=
    ⟨((hq.out.add hq.out.units_inv).pow 2).of_mul_eq_one (mul_comm τ _ ▸ hτ)⟩
  let E := BalancedProjectionAlgebra.heckeStarAlgEquiv q hτ
  refine ⟨⇑E.toAlgEquiv.toAlgHom '' Set.range (BalancedProjectionAlgebra.e τ), ?_, ?_⟩
  · rw [← AlgHom.map_adjoin, BalancedProjectionAlgebra.adjoin_range_e, Algebra.map_top, eq_top_iff]
    exact fun y _ ↦ E.surjective y
  · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact (BalancedProjectionAlgebra.isStarProjection_e i).map E

section Functional

variable (φ : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q))

/-- In the real-parameter fiber, every element acts boundedly on `φ.GNS`. -/
theorem boundedSubalgebra_eq_top : φ.boundedSubalgebra = ⊤ := by
  obtain ⟨s, hs, hp⟩ := exists_adjoin_isStarProjection_eq_top (q := q)
  exact φ.boundedSubalgebra_eq_top_of_adjoin_isStarProjection hs hp

/-- In the real-parameter fiber, left multiplication on `φ.GNS` is continuous for every element. -/
theorem continuous_leftMul (x : InfiniteTypeAHeckeAlgebra ℂ q) : Continuous (φ.leftMul x) :=
  φ.mem_boundedSubalgebra.mp <| (boundedSubalgebra_eq_top φ).symm ▸ trivial

/-- The canonical unital `⋆`-representation of `InfiniteTypeAHeckeAlgebra ℂ q` (in the
real-parameter fiber) on `φ.HilbertGNS`. -/
def gnsRepresentation :
    InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) :=
  φ.boundedRepresentation (continuous_leftMul φ)

/-- `gnsRepresentation φ` agrees with `φ.boundedRepresentation (continuous_leftMul φ)`. -/
theorem gnsRepresentation_eq_boundedRepresentation :
    gnsRepresentation φ = φ.boundedRepresentation (continuous_leftMul φ) := (rfl)

@[simp]
theorem gnsRepresentation_hilbertClassMap (x y : InfiniteTypeAHeckeAlgebra ℂ q) :
    gnsRepresentation φ x (φ.hilbertClassMap y) = φ.hilbertClassMap (x * y) :=
  φ.boundedRepresentation_hilbertClassMap (continuous_leftMul φ) x y

@[simp]
theorem gnsRepresentation_hilbertCyclicVector (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    gnsRepresentation φ x φ.hilbertCyclicVector = φ.hilbertClassMap x :=
  φ.boundedRepresentation_hilbertCyclicVector (continuous_leftMul φ) x

/-- The cyclic vector functional recovers `φ` along `gnsRepresentation φ`. -/
theorem hilbertPositiveLinearMap_gnsRepresentation (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    φ.hilbertPositiveLinearMap (gnsRepresentation φ x) = φ x :=
  φ.hilbertPositiveLinearMap_boundedRepresentation (continuous_leftMul φ) x

end Functional

/-- In the real-parameter fiber, algebraic positivity of a linear functional is equivalent to
factoring through a unital C⋆-representation. -/
theorem exists_cstar_representation_iff {f : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (∃ (C : Type) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] C), ∀ x, ω (π x) = f x) ↔
      ∀ x : InfiniteTypeAHeckeAlgebra ℂ q, 0 ≤ f (star x * x) :=
  StarPositiveFunctional.exists_cstar_representation_iff_forall_nonneg_of_forall_continuous_leftMul
    continuous_leftMul

/-- Normalized state version of `exists_cstar_representation_iff` in the real-parameter fiber. -/
theorem exists_cstar_state_representation_iff {f : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (∃ (C : Type) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] C),
        ω 1 = 1 ∧ ∀ x, ω (π x) = f x) ↔
      f 1 = 1 ∧ ∀ x : InfiniteTypeAHeckeAlgebra ℂ q, 0 ≤ f (star x * x) :=
  StarPositiveFunctional.exists_cstar_state_representation_iff_of_forall_continuous_leftMul
    continuous_leftMul

/-- `indexCharacter ℂ q` as a positive functional in the real-parameter fiber. -/
def indexCharacterPositiveFunctional : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q) :=
  (StarPositiveFunctional.ofPositiveLinearMap (.id ℂ ℂ)).comp indexCharacterStarAlgHom

@[simp]
theorem indexCharacterPositiveFunctional_apply (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    indexCharacterPositiveFunctional x = indexCharacter ℂ q x := by
  simp [indexCharacterPositiveFunctional]

/-- `signCharacter ℂ q` as a positive functional in the real-parameter fiber. -/
def signCharacterPositiveFunctional : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q) :=
  (StarPositiveFunctional.ofPositiveLinearMap (.id ℂ ℂ)).comp signCharacterStarAlgHom

@[simp]
theorem signCharacterPositiveFunctional_apply (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    signCharacterPositiveFunctional x = signCharacter ℂ q x := by
  simp [signCharacterPositiveFunctional]

end RealParameter

/-! ### Unit-circle fiber: `InfiniteTypeAHeckeAlgebra.UnitCircle` -/

namespace UnitCircle

variable {q : ℂˣ} [hq : Fact ((q : ℂ) ∈ unitary ℂ)]

section Functional

variable (φ : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q))

/-- In the unit-circle fiber, left multiplication by `T q i` preserves norms on `φ.GNS`. -/
@[simp]
theorem norm_leftMul_T (i : ℕ) (v : φ.GNS) : ‖φ.leftMul (T q i) v‖ = ‖v‖ :=
  φ.norm_leftMul_of_mem_unitary (T_mem_unitary i) v

/-- In the unit-circle fiber, left multiplication by `T q i` is an isometry on `φ.GNS`. -/
theorem isometry_leftMul_T (i : ℕ) : Isometry (φ.leftMul (T q i)) :=
  φ.isometry_leftMul_of_mem_unitary (T_mem_unitary i)

/-- In the unit-circle fiber, every element acts boundedly on `φ.GNS` (including `q = ±i`). -/
theorem boundedSubalgebra_eq_top : φ.boundedSubalgebra = ⊤ :=
  φ.boundedSubalgebra_eq_top_of_adjoin_unitary adjoin_range_T
    (by rintro _ ⟨i, rfl⟩; exact T_mem_unitary i)

/-- In the unit-circle fiber, left multiplication on `φ.GNS` is continuous for every element. -/
theorem continuous_leftMul (x : InfiniteTypeAHeckeAlgebra ℂ q) : Continuous (φ.leftMul x) :=
  φ.mem_boundedSubalgebra.mp <| (boundedSubalgebra_eq_top φ).symm ▸ trivial

/-- The canonical unital `⋆`-representation of `InfiniteTypeAHeckeAlgebra ℂ q` (in the unit-circle
fiber) on `φ.HilbertGNS`. -/
def gnsRepresentation :
    InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) :=
  φ.boundedRepresentation (continuous_leftMul φ)

/-- `gnsRepresentation φ` agrees with `φ.boundedRepresentation (continuous_leftMul φ)`. -/
theorem gnsRepresentation_eq_boundedRepresentation :
    gnsRepresentation φ = φ.boundedRepresentation (continuous_leftMul φ) := (rfl)

@[simp]
theorem gnsRepresentation_hilbertClassMap (x y : InfiniteTypeAHeckeAlgebra ℂ q) :
    gnsRepresentation φ x (φ.hilbertClassMap y) = φ.hilbertClassMap (x * y) :=
  φ.boundedRepresentation_hilbertClassMap (continuous_leftMul φ) x y

@[simp]
theorem gnsRepresentation_hilbertCyclicVector (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    gnsRepresentation φ x φ.hilbertCyclicVector = φ.hilbertClassMap x :=
  φ.boundedRepresentation_hilbertCyclicVector (continuous_leftMul φ) x

/-- The cyclic vector functional recovers `φ` along `gnsRepresentation φ`. -/
theorem hilbertPositiveLinearMap_gnsRepresentation (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    φ.hilbertPositiveLinearMap (gnsRepresentation φ x) = φ x :=
  φ.hilbertPositiveLinearMap_boundedRepresentation (continuous_leftMul φ) x

/-- Every generator `T q i` acts as a unitary operator on `φ.HilbertGNS`. -/
theorem gnsRepresentation_T_mem_unitary (i : ℕ) :
    gnsRepresentation φ (T q i) ∈ unitary (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) :=
  Unitary.map_mem (gnsRepresentation φ) (T_mem_unitary i)

/-- Every braid group element acts as a unitary operator on `φ.HilbertGNS`. -/
theorem gnsRepresentation_braidHom_mem_unitary {n : ℕ} (b : BraidGroup n) :
    gnsRepresentation φ (braidHom ℂ q n b) ∈ unitary (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) :=
  Unitary.map_mem (gnsRepresentation φ) (braidHom_mem_unitary b)

/-- At `q + q⁻¹ = 0` (`q = ±i`), the bounded GNS representation collapses to scalars via
`indexCharacter ℂ q`. -/
theorem gnsRepresentation_eq_smul_one (hq0 : (q : ℂ) + ↑q⁻¹ = 0)
    (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    gnsRepresentation φ x = indexCharacter ℂ q x • 1 := by
  have : IsProperStar (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) := by
    let _ : CStarAlgebra (φ.HilbertGNS →L[ℂ] φ.HilbertGNS) := inferInstance
    exact inferInstance
  have hnorm (i : ℕ) : IsStarNormal (gnsRepresentation φ (T q i)) :=
    isStarNormal_of_mem_unitary (gnsRepresentation_T_mem_unitary φ i)
  exact map_eq_smul_one_indexCharacter_of_isStarNormal hq0 (gnsRepresentation φ) hnorm x

/-- At `q + q⁻¹ = 0` (`q = ±i`), every algebraically positive functional `φ` is a scalar multiple
of `indexCharacter ℂ q`. -/
theorem apply_eq_indexCharacter_mul_apply_one (hq0 : (q : ℂ) + ↑q⁻¹ = 0)
    (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    φ x = indexCharacter ℂ q x * φ 1 := by
  simpa only [hilbertPositiveLinearMap_gnsRepresentation, map_smul, φ.hilbertPositiveLinearMap_one,
    smul_eq_mul] using congrArg φ.hilbertPositiveLinearMap (gnsRepresentation_eq_smul_one φ hq0 x)

end Functional

/-- In the unit-circle fiber, algebraic positivity of a linear functional is equivalent to
factoring through a unital C⋆-representation. -/
theorem exists_cstar_representation_iff {f : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (∃ (C : Type) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] C), ∀ x, ω (π x) = f x) ↔
      ∀ x : InfiniteTypeAHeckeAlgebra ℂ q, 0 ≤ f (star x * x) :=
  StarPositiveFunctional.exists_cstar_representation_iff_forall_nonneg_of_forall_continuous_leftMul
    continuous_leftMul

/-- Normalized state version of `exists_cstar_representation_iff` in the unit-circle fiber. -/
theorem exists_cstar_state_representation_iff {f : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (∃ (C : Type) (_ : CStarAlgebra C) (_ : PartialOrder C) (_ : StarOrderedRing C)
        (ω : C →ₚ[ℂ] ℂ) (π : InfiniteTypeAHeckeAlgebra ℂ q →⋆ₐ[ℂ] C),
        ω 1 = 1 ∧ ∀ x, ω (π x) = f x) ↔
      f 1 = 1 ∧ ∀ x : InfiniteTypeAHeckeAlgebra ℂ q, 0 ≤ f (star x * x) :=
  StarPositiveFunctional.exists_cstar_state_representation_iff_of_forall_continuous_leftMul
    continuous_leftMul

/-- `indexCharacter ℂ q` as a positive functional in the unit-circle fiber. -/
def indexCharacterPositiveFunctional : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q) :=
  (StarPositiveFunctional.ofPositiveLinearMap (.id ℂ ℂ)).comp indexCharacterStarAlgHom

@[simp]
theorem indexCharacterPositiveFunctional_apply (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    indexCharacterPositiveFunctional x = indexCharacter ℂ q x := by
  simp [indexCharacterPositiveFunctional]

/-- `indexCharacter ℂ q` is nonnegative on algebraic squares in the unit-circle fiber. -/
theorem indexCharacter_star_mul_self_nonneg (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    0 ≤ indexCharacter ℂ q (star x * x) := by
  simpa using (indexCharacterPositiveFunctional (q := q)).square_nonneg x

/-- `signCharacter ℂ q` as a positive functional in the unit-circle fiber. -/
def signCharacterPositiveFunctional : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q) :=
  (StarPositiveFunctional.ofPositiveLinearMap (.id ℂ ℂ)).comp signCharacterStarAlgHom

@[simp]
theorem signCharacterPositiveFunctional_apply (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    signCharacterPositiveFunctional x = signCharacter ℂ q x := by
  simp [signCharacterPositiveFunctional]

/-- `signCharacter ℂ q` is nonnegative on algebraic squares in the unit-circle fiber. -/
theorem signCharacter_star_mul_self_nonneg (x : InfiniteTypeAHeckeAlgebra ℂ q) :
    0 ≤ signCharacter ℂ q (star x * x) := by
  simpa using (signCharacterPositiveFunctional (q := q)).square_nonneg x

/-- **Unique normalized positive functional at `q + q⁻¹ = 0` (`q = ±i`).** -/
theorem apply_one_eq_one_and_forall_star_mul_self_nonneg_iff_of_add_inv_eq_zero
    (hq0 : (q : ℂ) + ↑q⁻¹ = 0) {μ : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (μ 1 = 1 ∧ ∀ x, 0 ≤ μ (star x * x)) ↔ μ = (indexCharacter ℂ q).toLinearMap := by
  constructor
  · rintro ⟨h1, hpos⟩
    let φ : StarPositiveFunctional (InfiniteTypeAHeckeAlgebra ℂ q) := ⟨μ, hpos⟩
    exact LinearMap.ext fun x ↦ by
      simpa [φ, h1] using apply_eq_indexCharacter_mul_apply_one φ hq0 x
  · rintro rfl
    exact ⟨map_one (indexCharacter ℂ q), indexCharacter_star_mul_self_nonneg⟩

/-- **Unique normalized positive functional at `Q = q ^ 2 = -1` (`q = ±i`).** -/
theorem apply_one_eq_one_and_forall_star_mul_self_nonneg_iff_of_sq_eq_neg_one
    (hsq : (q : ℂ) ^ 2 = -1) {μ : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (μ 1 = 1 ∧ ∀ x, 0 ≤ μ (star x * x)) ↔ μ = (indexCharacter ℂ q).toLinearMap :=
  apply_one_eq_one_and_forall_star_mul_self_nonneg_iff_of_add_inv_eq_zero <|
    mul_left_cancel₀ q.ne_zero (by linear_combination hsq + q.mul_inv)

private theorem notMem_Ico_inv_sq_of_sq_le_one {s : ℂ} (hsa : IsSelfAdjoint s) (hs0 : s ≠ 0)
    (hsq : s ^ 2 ≤ 1) : (s ^ 2)⁻¹ ∉ ((↑) : ℝ → ℂ) '' Set.Ico 0 1 := by
  obtain ⟨r, hr⟩ := Complex.conj_eq_iff_real.mp hsa
  have hr0 : r ≠ 0 := fun h ↦ hs0 (by simpa [h] using hr)
  have hr_sq_le : r ^ 2 ≤ 1 := by
    have hsq' : ((r ^ 2 : ℝ) : ℂ) ≤ ((1 : ℝ) : ℂ) := by
      simpa only [Complex.ofReal_pow, Complex.ofReal_one, ← hr] using hsq
    simpa only [Complex.ofReal_re] using (Complex.le_def.mp hsq').1
  rintro ⟨t, ht, hteq⟩
  have ht' : t = (r ^ 2)⁻¹ := Complex.ofReal_injective (by
    rw [hteq, hr]; norm_cast)
  have h1 : (1 : ℝ) ≤ (r ^ 2)⁻¹ := (one_le_inv₀ (sq_pos_of_ne_zero hr0)).mpr hr_sq_le
  linarith [ht.2]

/-- **Classification of positive Markov traces on the unit circle for `(q + q⁻¹) ^ 2 ≤ 1`.**
This covers both `q = ±i` (`(q + q⁻¹) ^ 2 = 0`) and `0 < (q + q⁻¹) ^ 2 ≤ 1` (including `l = 3`):
the only positive Markov traces are `indexCharacter ℂ q` and `signCharacter ℂ q`. -/
theorem isMarkovTrace_and_forall_star_mul_self_nonneg_iff_of_add_inv_sq_le_one
    (hsq : ((q : ℂ) + ↑q⁻¹) ^ 2 ≤ 1) {z : ℂ}
    {μ : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (IsMarkovTrace z μ ∧ ∀ x, 0 ≤ μ (star x * x)) ↔
      (z = q ∧ μ = (indexCharacter ℂ q).toLinearMap) ∨
        (z = -↑q⁻¹ ∧ μ = (signCharacter ℂ q).toLinearMap) := by
  constructor
  · rintro ⟨hμ, hpos⟩
    by_cases hs0 : (q : ℂ) + ↑q⁻¹ = 0
    · have hμ_eq : μ = (indexCharacter ℂ q).toLinearMap :=
        (apply_one_eq_one_and_forall_star_mul_self_nonneg_iff_of_add_inv_eq_zero hs0).mp
          ⟨hμ.map_one, hpos⟩
      have hz : z = q := by
        simpa [hμ.map_one, hμ_eq] using (hμ.map_mul_T (n := 0) (Subalgebra.one_mem _)).symm
      exact Or.inl ⟨hz, hμ_eq⟩
    · have hs_sa : IsSelfAdjoint ((q : ℂ) + ↑q⁻¹) :=
        Units.isSelfAdjoint_add_inv_of_mem_unitary hq.out
      let τ : ℂ := (((q : ℂ) + ↑q⁻¹) ^ 2)⁻¹
      have hτ : τ * ((q : ℂ) + ↑q⁻¹) ^ 2 = 1 := inv_mul_cancel₀ (pow_ne_zero 2 hs0)
      have : Fact (IsSelfAdjoint τ) := ⟨(hs_sa.pow 2).of_mul_eq_one (mul_comm τ _ ▸ hτ)⟩
      have hτ_notMem := notMem_Ico_inv_sq_of_sq_le_one hs_sa hs0 hsq
      let η : ℂ := τ * ((q : ℂ) + ↑q⁻¹) * (z + ↑q⁻¹)
      have hz : z = (q : ℂ) * η - ↑q⁻¹ * (1 - η) := by
        dsimp [η]; linear_combination -(z + ↑q⁻¹) * hτ
      let E := BalancedProjectionAlgebra.heckeEquiv q hτ
      have hmarkov_bp : BalancedProjectionAlgebra.IsMarkovTrace η (μ.comp E.toLinearMap) :=
        (BalancedProjectionAlgebra.isMarkovTrace_comp_heckeEquiv_iff hτ hz).mpr hμ
      have hpos_bp : ∀ x : BalancedProjectionAlgebra ℂ τ,
          0 ≤ (μ.comp E.toLinearMap) (star x * x) := fun x ↦ by
        simpa only [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, map_mul, E,
          BalancedProjectionAlgebra.UnitCircle.heckeEquiv_star] using hpos (E x)
      have cancel_comp {ν : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ}
          (h : μ.comp E.toLinearMap = ν.comp E.toLinearMap) : μ = ν :=
        LinearMap.ext (E.surjective.forall.mpr (LinearMap.congr_fun h))
      rcases (BalancedProjectionAlgebra.isMarkovTrace_and_forall_star_mul_self_nonneg_iff
          hτ_notMem).mp ⟨hmarkov_bp, hpos_bp⟩ with ⟨hη, hchar⟩ | ⟨hη, hchar⟩
      · exact Or.inr ⟨by rw [hη] at hz; linear_combination hz,
          cancel_comp (hchar.trans <| LinearMap.ext fun x ↦
            (BalancedProjectionAlgebra.signCharacter_heckeEquiv hτ x).symm)⟩
      · exact Or.inl ⟨by rw [hη] at hz; linear_combination hz,
          cancel_comp (hchar.trans <| LinearMap.ext fun x ↦
            (BalancedProjectionAlgebra.indexCharacter_heckeEquiv hτ x).symm)⟩
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact ⟨isMarkovTrace_indexCharacter, indexCharacter_star_mul_self_nonneg⟩
    · exact ⟨isMarkovTrace_signCharacter, signCharacter_star_mul_self_nonneg⟩

/-- **Classification of positive Markov traces at `l = 3` (`q ^ 4 + q ^ 2 + 1 = 0`).** Since
`(q + q⁻¹) ^ 2 = 1`, the only positive Markov traces are `indexCharacter ℂ q` and
`signCharacter ℂ q`. -/
theorem isMarkovTrace_and_forall_star_mul_self_nonneg_iff_of_pow_four_add_sq_add_one_eq_zero
    (h : (q : ℂ) ^ 4 + (q : ℂ) ^ 2 + 1 = 0) {z : ℂ}
    {μ : InfiniteTypeAHeckeAlgebra ℂ q →ₗ[ℂ] ℂ} :
    (IsMarkovTrace z μ ∧ ∀ x, 0 ≤ μ (star x * x)) ↔
      (z = q ∧ μ = (indexCharacter ℂ q).toLinearMap) ∨
        (z = -↑q⁻¹ ∧ μ = (signCharacter ℂ q).toLinearMap) := by
  have hsq : ((q : ℂ) + ↑q⁻¹) ^ 2 = 1 := by
    have hq0 : (q : ℂ) * ↑q⁻¹ = 1 := q.mul_inv
    linear_combination (↑q⁻¹ : ℂ) ^ 2 * h +
      (-(q : ℂ) ^ 2 * ((q : ℂ) * ↑q⁻¹ + 1) - ((q : ℂ) * ↑q⁻¹ - 1)) * hq0
  exact isMarkovTrace_and_forall_star_mul_self_nonneg_iff_of_add_inv_sq_le_one hsq.le

end UnitCircle

end TauCeti.InfiniteTypeAHeckeAlgebra
