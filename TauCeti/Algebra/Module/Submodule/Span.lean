module

public import Mathlib.LinearAlgebra.Span.Basic

/-!
# Complements on spans of submodules

This file collects general facts about submodules generated by subsets, complementing
`Mathlib.LinearAlgebra.Span.Basic`.

## Main results

* `Submodule.sup_eq_span_union`: the supremum of two submodules is spanned by the union of their
  underlying sets.
-/

public section

namespace Submodule

/-- The supremum of two submodules is the submodule spanned by the union of their underlying
sets. -/
theorem sup_eq_span_union {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    (p q : Submodule R M) : p ⊔ q = span R ((p : Set M) ∪ (q : Set M)) := by
  rw [span_union, span_eq, span_eq]

end Submodule
