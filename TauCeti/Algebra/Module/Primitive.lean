/-!
# Primitive vectors in integer modules

A vector in an integer module is primitive when an integer-valued linear functional takes the
value one on it. This basis-free condition says that the cyclic submodule generated by the vector
splits off a copy of `ℤ`. It is invariant under linear equivalence and under changing the sign of
the vector.

For a free integer module, every nonzero vector is a positive integer multiple of a
primitive vector. This is the coordinate-free form of dividing a nonzero integer vector by the
greatest common divisor of its coordinates. It supplies primitive representatives whenever a
rational ray is initially described by arbitrary nonzero lattice vectors. Applied to the
torsion-free quotient of a finitely generated abelian group, it gives a surjective integral
coordinate taking a nontorsion class to its positive divisibility.

## Main declarations

* `TauCeti.IsPrimitive`: some integer-valued linear functional takes the value one on the vector.
* `TauCeti.IsPrimitive.eq_one_of_eq_nsmul`: a natural multiplier of a primitive vector
  is one.
* `TauCeti.IsPrimitive.exists_eq_nsmul_iff_dvd`: the natural multipliers of `d • p`, for
  primitive `p`, are exactly the divisors of `d`.
* `TauCeti.IsPrimitive.zsmul_left_injective`, `TauCeti.IsPrimitive.eq_of_pos_zsmul_eq`: integer
  multiples of a primitive vector have distinct multipliers, and primitive vectors with equal
  positive multiples coincide in a module with unique division.
* `LinearEquiv.isPrimitive_iff`: primitivity is invariant under integer-linear equivalences.
* `Units.isPrimitive_units_mul_iff`, `Units.isPrimitive_mul_units_iff`: in a ring, primitivity is
  invariant under multiplication by a unit.
* `TauCeti.exists_eq_zsmul_isPrimitive`: a nonzero vector in a free integer module is a
  positive integer multiple of a primitive vector.
* `TauCeti.exists_integral_coordinate_of_notMem_torsion`: a nontorsion class in a finitely
  generated abelian group has a surjective integral coordinate taking its divisibility as value.
* `Module.Basis.isPrimitive`: a vector of an integral basis is primitive.
* `TauCeti.IsPrimitive.exists_basis`: conversely, a primitive vector of a finite free integer
  module belongs to some integral basis of it.
* `Module.Basis.exists_basis_eq_iff`: the relative version. The vectors `b 0, …, b (i - 1)` of a
  basis `b` followed by `v` extend to a basis exactly when some integer-valued linear functional
  vanishes on `b 0, …, b (i - 1)` and takes the value one on `v`.
-/

public section

namespace TauCeti

variable {M N : Type*} [AddCommGroup M] [AddCommGroup N]

/-- A vector `v` in an integer module is primitive when some integer-valued linear functional
sends it to `1`. Equivalently, the cyclic submodule generated by `v` splits off a copy of `ℤ`. -/
def IsPrimitive (v : M) : Prop := ∃ f : M →ₗ[ℤ] ℤ, f v = 1

/-- A vector is primitive exactly when an integer-valued linear functional takes the value one
on it. This is the introduction and elimination interface for `IsPrimitive`. -/
theorem isPrimitive_def {v : M} : IsPrimitive v ↔ ∃ f : M →ₗ[ℤ] ℤ, f v = 1 := Iff.rfl

/-- A vector is primitive if its image under an integer-linear map is primitive. -/
theorem IsPrimitive.of_map [Module ℤ M] [Module ℤ N] {g : M →ₗ[ℤ] N} {v : M}
    (h : IsPrimitive (g v)) : IsPrimitive v := by
  obtain ⟨f, hf⟩ := h
  exact ⟨f.comp g.toAddMonoidHom.toIntLinearMap, hf⟩

/-- A primitive vector is nonzero. -/
theorem IsPrimitive.ne_zero {v : M} (h : IsPrimitive v) : v ≠ 0 := by
  rintro rfl
  obtain ⟨f, hf⟩ := h
  simp at hf

/-- A primitive vector cannot be a nontrivial natural multiple of another vector. -/
theorem IsPrimitive.eq_one_of_eq_nsmul {v w : M} (hv : IsPrimitive v) {m : ℕ}
    (hvw : v = m • w) : m = 1 := by
  obtain ⟨f, hf⟩ := hv
  rw [hvw, map_nsmul, nsmul_eq_mul] at hf
  exact_mod_cast Int.eq_one_of_mul_eq_one_right (by positivity) hf

/-- A multiple `d • p` of a primitive vector is an `n`-fold multiple exactly when `n ∣ d`. -/
theorem IsPrimitive.exists_eq_nsmul_iff_dvd {p : M} (hp : IsPrimitive p) (d n : ℕ) :
    (∃ x : M, d • p = n • x) ↔ n ∣ d := by
  obtain ⟨g, hg⟩ := isPrimitive_def.1 hp
  constructor
  · rintro ⟨x, hx⟩
    have heq := congrArg g hx
    simp only [map_nsmul, hg, nsmul_eq_mul, mul_one] at heq
    exact Int.natCast_dvd_natCast.1 (Dvd.intro (g x) heq.symm)
  · rintro ⟨m, hm⟩
    exact ⟨m • p, by rw [smul_smul, ← hm]⟩

-- The following two theorems are adapted from `Mei/Algebra/Module/Primitive.lean` in
-- [yuma-mizuno-lean/Mei](https://github.com/yuma-mizuno-lean/Mei), commit
-- `7f1e4c7714fb020473694755ad8748c8f15d0e7f` (Apache 2.0).

/-- Integer multiples of a primitive vector have distinct multipliers, even when the ambient module
has torsion. -/
theorem IsPrimitive.zsmul_left_injective {v : M} (hv : IsPrimitive v) :
    Function.Injective (fun a : ℤ => a • v) := by
  obtain ⟨f, hf⟩ := hv
  intro a b h
  simpa only [map_zsmul, hf, zsmul_eq_mul, mul_one, Int.cast_id] using congrArg f h

/-- Primitive vectors with equal positive integer multiples are equal. -/
theorem IsPrimitive.eq_of_pos_zsmul_eq [HasUniqueDiv M] {v w : M} (hv : IsPrimitive v)
    (hw : IsPrimitive w) {a b : ℤ} (ha : 0 < a) (hb : 0 < b) (h : a • v = b • w) : v = w := by
  obtain ⟨f, hf⟩ := hv
  obtain ⟨g, hg⟩ := hw
  have hf' := congrArg f h
  have hg' := congrArg g h
  simp only [map_zsmul, hf, hg, zsmul_eq_mul, mul_one] at hf' hg'
  have hab : a = b := le_antisymm
    (Int.le_of_dvd hb ⟨g v, hg'.symm⟩) (Int.le_of_dvd ha ⟨f w, hf'⟩)
  exact zsmul_right_injective ha.ne' (hab ▸ h)

/-- The zero vector is not primitive. -/
@[simp]
theorem not_isPrimitive_zero : ¬ IsPrimitive (0 : M) := fun h ↦ h.ne_zero rfl

/-- Primitivity is unchanged by the sign action `v ↦ -v`. -/
theorem IsPrimitive.neg {v : M} (h : IsPrimitive v) : IsPrimitive (-v) := by
  obtain ⟨f, hf⟩ := h
  exact ⟨-f, by simp [hf]⟩

/-- Primitivity is invariant under negation. -/
@[simp]
theorem isPrimitive_neg {v : M} : IsPrimitive (-v) ↔ IsPrimitive v :=
  ⟨fun h ↦ by simpa using h.neg, IsPrimitive.neg⟩

end TauCeti

namespace Module.Basis

variable {ι M : Type*} [AddCommGroup M] [Module ℤ M]

/-- A vector of an integral basis is primitive. The `ℤ`-module structure of the basis may be any
one: all of them agree with the canonical structure, through which primitivity is defined. -/
theorem isPrimitive (b : Module.Basis ι ℤ M) (j : ι) : TauCeti.IsPrimitive (b j) :=
  TauCeti.isPrimitive_def.2 ⟨(b.coord j).toAddMonoidHom.toIntLinearMap, by simp⟩

end Module.Basis

namespace LinearEquiv

variable {M N : Type*} [AddCommGroup M] [AddCommGroup N] [Module ℤ M] [Module ℤ N]

/-- Primitivity transports along an integer-linear equivalence. The `ℤ`-module structures may be
any: primitivity is defined through the canonical structures, and only the additive map of `φ` is
used. -/
@[simp]
theorem isPrimitive_iff (φ : M ≃ₗ[ℤ] N) {v : M} :
    TauCeti.IsPrimitive (φ v) ↔ TauCeti.IsPrimitive v := by
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨g.comp (φ : M →+ N).toIntLinearMap, by simpa using hg⟩
  · rintro ⟨f, hf⟩
    exact ⟨f.comp (φ.symm : N →+ M).toIntLinearMap, by simpa using hf⟩

end LinearEquiv

namespace Units

/-- Primitivity in a ring is invariant under left multiplication by a unit. For integral
matrices this is invariance of the content under left multiplication by `GL(n, ℤ)`. -/
@[simp]
theorem isPrimitive_units_mul_iff {R : Type*} [Ring R] (u : Rˣ) {v : R} :
    TauCeti.IsPrimitive (↑u * v) ↔ TauCeti.IsPrimitive v :=
  (u.mulLeftLinearEquiv ℤ R).isPrimitive_iff

/-- Primitivity in a ring is invariant under right multiplication by a unit. -/
@[simp]
theorem isPrimitive_mul_units_iff {R : Type*} [Ring R] (u : Rˣ) {v : R} :
    TauCeti.IsPrimitive (v * ↑u) ↔ TauCeti.IsPrimitive v :=
  (u.mulRightLinearEquiv ℤ).isPrimitive_iff

end Units

namespace TauCeti

variable {M : Type*} [AddCommGroup M]

/-- Every nonzero vector in a free integer module is a positive integer multiple of a
primitive vector. The multiplier is the greatest common divisor of the coordinates in any
integral basis. -/
theorem exists_eq_zsmul_isPrimitive [Module.Free ℤ M] {v : M}
    (hv : v ≠ 0) : ∃ (d : ℤ) (w : M), 0 < d ∧ IsPrimitive w ∧ v = d • w := by
  classical
  let b := Module.Free.chooseBasis ℤ M
  let c := b.repr v
  obtain ⟨j, hj⟩ : c.support.Nonempty :=
    Finsupp.support_nonempty_iff.2 (by simpa [c] using hv)
  let d := c.support.gcd c
  have hcj : c j ≠ 0 := Finsupp.mem_support_iff.1 hj
  have hd : 0 < d :=
    Finset.Int.finsetGcd_nonneg.lt_of_ne (Finset.gcd_ne_zero_iff.2 ⟨j, hj, hcj⟩).symm
  have hdc (k) : d ∣ c k := by
    by_cases hk : k ∈ c.support
    · exact Finset.gcd_dvd hk
    · simp [Finsupp.notMem_support_iff.1 hk]
  -- `w` has the coordinates of `v` divided by their greatest common divisor `d`.
  let w := b.repr.symm (c.mapRange (· / d) (Int.zero_ediv d))
  have hvw : v = d • w := b.repr.injective <| by
    ext k
    simp [w, c, Int.mul_ediv_cancel' (hdc k)]
  -- Bézout's identity for the coordinates of `w` gives a functional taking the value one on `w`.
  obtain ⟨a, ha⟩ := Finset.gcd_eq_sum_mul c.support (fun k ↦ c k / d)
  refine ⟨d, w, hd, ⟨∑ k ∈ c.support, a k • b.coord k, ?_⟩, hvw⟩
  rw [Finset.gcd_div_eq_one hj hcj] at ha
  simp [w, ha, mul_comm]

/-- A nontorsion element of a finitely generated abelian group admits a surjective integral
coordinate taking its positive divisibility as value. Divisibility is measured in the actual
torsion-free quotient, not in the original group: every natural multiplier of the quotient
class divides `d`, and conversely. -/
theorem exists_integral_coordinate_of_notMem_torsion {H : Type*} [AddCommGroup H] [AddGroup.FG H]
    {h : H} (hh : h ∉ AddCommGroup.torsion H) :
    ∃ (d : ℕ) (f : H →+ ℤ), 0 < d ∧ Function.Surjective f ∧ f h = d ∧
      ∀ n : ℕ, (∃ x : H ⧸ AddCommGroup.torsion H,
        QuotientAddGroup.mk' (AddCommGroup.torsion H) h = n • x) ↔ n ∣ d := by
  set q := QuotientAddGroup.mk' (AddCommGroup.torsion H)
  obtain ⟨d, p, hd, hp, hdp⟩ := exists_eq_zsmul_isPrimitive (v := q h) (by simpa [q] using hh)
  lift d to ℕ using hd.le
  rw [natCast_zsmul] at hdp
  obtain ⟨g, hg⟩ := isPrimitive_def.1 hp
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective p
  refine ⟨d, g.toAddMonoidHom.comp q, mod_cast hd, fun z ↦ ⟨z • x, by simp [q, hg]⟩,
    by simp [hdp, hg], fun n ↦ ?_⟩
  rw [hdp]
  exact hp.exists_eq_nsmul_iff_dvd d n

/-- A primitive vector of a finite free integer module belongs to an integral basis of it. -/
theorem IsPrimitive.exists_basis [Module.Free ℤ M] [Module.Finite ℤ M] {v : M}
    (hv : IsPrimitive v) :
    ∃ (n : ℕ) (b : Module.Basis (Fin n) ℤ M) (j : Fin n), b j = v := by
  obtain ⟨f, hf⟩ := isPrimitive_def.1 hv
  obtain ⟨m, ⟨c⟩⟩ := Submodule.nonempty_basis_of_pid (Module.finBasis ℤ M) (LinearMap.ker f)
  obtain ⟨b, hb, -⟩ := c.exists_basis_finCons_of_apply_eq_one hf
  exact ⟨m + 1, b, 0, hb⟩

end TauCeti

namespace Module.Basis

variable {M : Type*} [AddCommGroup M]

/-- Let `b` be an integral basis indexed by `Fin n`. The vectors `b 0, …, b (i - 1), v` extend to
an integral basis, that is, some basis agrees with `b` before `i` and has `v` at `i`, exactly when
some integer-valued linear functional vanishes on `b 0, …, b (i - 1)` and takes the value one on
`v`. For `i = 0` this is the characterization of primitive vectors as the members of bases. -/
theorem exists_basis_eq_iff {n : ℕ} (b : Basis (Fin n) ℤ M) (i : Fin n) (v : M) :
    (∃ e : Basis (Fin n) ℤ M, (∀ j < i, e j = b j) ∧ e i = v) ↔
      ∃ f : M →ₗ[ℤ] ℤ, (∀ j < i, f (b j) = 0) ∧ f v = 1 := by
  classical
  constructor
  · rintro ⟨e, he, rfl⟩
    exact ⟨e.coord i, fun j hj ↦ by simp [← he j hj, hj.ne], by simp⟩
  rintro ⟨f, hf, hv⟩
  let s : Set (Fin n) := {j | j < i}
  -- `M` is the direct sum of the spans `P` of `b 0, …, b (i - 1)` and `N` of the other vectors.
  let P := Submodule.span ℤ (Set.range (b ∘ ((↑) : s → Fin n)))
  let N := Submodule.span ℤ (Set.range (b ∘ ((↑) : ↥sᶜ → Fin n)))
  -- Use the submodule structures, rather than `AddCommGroup.toIntModule`, on `P` and `N`.
  let : Module ℤ P := P.module
  let : Module ℤ N := N.module
  let : Module ℤ (P × N) := Prod.instModule
  let bP : Basis s ℤ P := .span (b.linearIndependent.comp ((↑) : s → Fin n) Subtype.val_injective)
  let bN : Basis ↥sᶜ ℤ N :=
    .span (b.linearIndependent.comp ((↑) : ↥sᶜ → Fin n) Subtype.val_injective)
  have hPN : IsCompl P N := by
    simpa only [P, N, Set.range_comp, Subtype.range_coe] using
      b.linearIndependent.isCompl_span_image b.span_eq (isCompl_compl (x := s))
  have hPf : P ≤ LinearMap.ker f := Submodule.span_le.2 <| by
    rintro _ ⟨j, rfl⟩
    exact hf j j.2
  have : Module.Free ℤ N := Module.Free.of_basis bN
  have : Module.Finite ℤ N := Module.Finite.of_basis bN
  -- Split `v` into its components in `P` and `N`; the component in `N` is primitive there.
  set w := (Submodule.prodEquivOfIsCompl P N hPN).symm v
  have hvw : v = (w.1 : M) + w.2 := by
    rw [← Submodule.coe_prodEquivOfIsCompl' (h := hPN), LinearEquiv.apply_symm_apply]
  have hw1 : f w.1 = 0 := hPf w.1.2
  have hw2 : f w.2 = 1 := by rw [← hv, hvw, map_add, hw1, zero_add]
  obtain ⟨m, c, k, hck⟩ := TauCeti.IsPrimitive.exists_basis (M := N) ⟨f.comp N.subtype, hw2⟩
  -- Combine `b 0, …, b (i - 1)` with `c`, placing `c k` at position `i`.
  have hi : i ∈ sᶜ := lt_irrefl i
  let τ : ↥sᶜ ≃ Fin m := (bN.indexEquiv c).trans (Equiv.swap (bN.indexEquiv c ⟨i, hi⟩) k)
  have hτ : τ ⟨i, hi⟩ = k := by simp [τ]
  let σ : s ⊕ Fin m ≃ Fin n := (Equiv.sumCongr (Equiv.refl s) τ.symm).trans (Equiv.Set.sumCompl s)
  let d := ((bP.prod c).map (Submodule.prodEquivOfIsCompl P N hPN)).reindex σ
  -- Finally add the component of `v` in `P` to the vector at position `i`.
  refine ⟨d.map (LinearEquiv.transvection (f := f) (v := (w.1 : M)) hw1), fun j hj ↦ ?_, ?_⟩
  · have hσ : σ.symm j = Sum.inl ⟨j, hj⟩ := by
      simp [σ, Equiv.Set.sumCompl_symm_apply_of_mem (s := s) hj]
    have hd : d j = b j := by simp [d, hσ, bP, Basis.span_apply _ (⟨j, hj⟩ : s)]
    rw [Basis.map_apply, LinearEquiv.transvection.apply, hd, hf j hj]
    module
  · have hσ : σ.symm i = Sum.inr k := by
      simp [σ, Equiv.Set.sumCompl_symm_apply_of_notMem (s := s) hi, hτ]
    have hd : d i = w.2 := by simp [d, hσ, hck]
    rw [Basis.map_apply, LinearEquiv.transvection.apply, hd, hw2, hvw]
    module

end Module.Basis
