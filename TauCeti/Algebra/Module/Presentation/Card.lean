module

public import TauCeti.Algebra.Module.Presentation.Quadratic
public import TauCeti.LinearAlgebra.Matrix.CokernelIndex
import Mathlib.Algebra.Field.ZMod

/-!
# The order of a quadratically presented module over a finite-index order

Let `S` be a subring of finite additive index inside a finite product `∏ i, D i` of principal ideal
domains (each possibly finite or infinite, of any characteristic), and let `N` be a quadratically
presented `S`-module whose zeroth Fitting ideal is generated by a non-zero-divisor `x ∈ S`.
Following Dasgupta and Kakde (Lemma 2.4), we prove that `N` and `S ⧸ Ideal.span {x}` have the same
`Nat.card` (`TauCeti.QuadraticPresentation.card_eq`, `TauCeti.IsQuadraticallyPresented.card_eq`),
and that `N` is finite if and only if `S ⧸ Ideal.span {x}` is finite
(`TauCeti.QuadraticPresentation.finite_iff_finite_quotient_span`,
`TauCeti.IsQuadraticallyPresented.finite_iff_finite_quotient_span`).

Since `Fitt₀(N) = (det φ)` for the relation matrix `φ` of any quadratic presentation `P` of `N`
(`TauCeti.QuadraticPresentation.fittingIdeal_eq`), the hypothesis `Fitt₀(N) = (x)` with
`x ∈ nonZeroDivisors S` implies `det φ ∈ nonZeroDivisors S`
(`TauCeti.QuadraticPresentation.det_mem_nonZeroDivisors_of_fittingIdeal_eq_span`) and
`(det φ) = (x)`. Identifying `N` with the cokernel of `φ` (`P.cokernelEquiv`) then reduces the
statement to `Matrix.card_quotient_range_mulVecLin_eq_card_quotient_span_det_of_subring_pi`:
projecting `S` onto the infinite factors kills a finite torsion ideal `K`, lifts regularity from
`S ⧸ K` to the product of infinite PIDs, and compares indices factorwise by Smith normal form.

## Main results

* `TauCeti.QuadraticPresentation.card_eq_of_isPrincipalIdealRing`: over a single PID `D`, when
  `P.rel.det ≠ 0`, `Nat.card N = Nat.card (D ⧸ Ideal.span {P.rel.det})`.
* `TauCeti.QuadraticPresentation.card_eq_card_quotient_span_det`: over a finite-index subring `S` of
  a finite product of PIDs, when `P.rel.det ∈ nonZeroDivisors S`,
  `Nat.card N = Nat.card (S ⧸ Ideal.span {P.rel.det})`.
* `TauCeti.QuadraticPresentation.card_eq`, `TauCeti.IsQuadraticallyPresented.card_eq`:
  Dasgupta–Kakde Lemma 2.4 (`Nat.card N = Nat.card (S ⧸ Ideal.span {x})`).
* `TauCeti.QuadraticPresentation.finite_iff_finite_quotient_span`,
  `TauCeti.IsQuadraticallyPresented.finite_iff_finite_quotient_span`: `N` is finite if and only if
  `S ⧸ Ideal.span {x}` is finite.

## References

* S. Dasgupta, M. Kakde, *On the Brumer–Stark conjecture*, Ann. of Math. (2) 197 (2023), Lemma 2.4.
-/

public section

namespace TauCeti

namespace QuadraticPresentation

section PID

variable {D N : Type*} [CommRing D] [IsDomain D] [IsPrincipalIdealRing D]
  [AddCommGroup N] [Module D N]

/-- Over a principal ideal domain `D`, a quadratically presented module whose relation matrix has
nonzero determinant has the same `Nat.card` as `D ⧸ Ideal.span {P.rel.det}`. -/
theorem card_eq_of_isPrincipalIdealRing (P : QuadraticPresentation D N) (hdet : P.rel.det ≠ 0) :
    Nat.card N = Nat.card (D ⧸ Ideal.span {P.rel.det}) := by
  rw [← Nat.card_congr P.cokernelEquiv.toEquiv, Matrix.toLin'_apply',
    Matrix.card_quotient_range_mulVecLin_eq_card_quotient_span_det hdet]

end PID

section SubringPiPID

variable {ι : Type*} [Finite ι] {D : ι → Type*}
  [∀ i, CommRing (D i)] [∀ i, IsDomain (D i)] [∀ i, IsPrincipalIdealRing (D i)]
  {S : Subring (∀ i, D i)} [S.toAddSubgroup.FiniteIndex]
  {N : Type*} [AddCommGroup N] [Module S N]

/-- Over a finite-index subring `S` of a finite product of principal ideal domains, if the relation
determinant `P.rel.det` is a non-zero-divisor in `S`, then `N` and `S ⧸ Ideal.span {P.rel.det}` have
the same `Nat.card` (`0` when infinite). -/
theorem card_eq_card_quotient_span_det (P : QuadraticPresentation S N)
    (hdet : P.rel.det ∈ nonZeroDivisors S) :
    Nat.card N = Nat.card (S ⧸ Ideal.span {P.rel.det}) := by
  rw [← Nat.card_congr P.cokernelEquiv.toEquiv, Matrix.toLin'_apply',
    Matrix.card_quotient_range_mulVecLin_eq_card_quotient_span_det_of_subring_pi hdet]

/-- **The order of a quadratically presented module over a finite-index order**
(Dasgupta–Kakde, Lemma 2.4). Let `S` be a subring of finite additive index in a finite product of
principal ideal domains, and `P` a quadratic presentation of `N` with `Fitt₀(N) = Ideal.span {x}`
for `x ∈ nonZeroDivisors S`. Then `Nat.card N = Nat.card (S ⧸ Ideal.span {x})` (both `0` when
infinite). -/
theorem card_eq [Module.Finite S N] (P : QuadraticPresentation S N) {x : S}
    (hx : x ∈ nonZeroDivisors S) (hfitt : fittingIdeal S N 0 = Ideal.span {x}) :
    Nat.card N = Nat.card (S ⧸ Ideal.span {x}) := by
  have hdet : P.rel.det ∈ nonZeroDivisors S :=
    P.det_mem_nonZeroDivisors_of_fittingIdeal_eq_span hx hfitt
  rw [P.card_eq_card_quotient_span_det hdet, P.fittingIdeal_eq.symm.trans hfitt]

/-- Under the hypotheses of `QuadraticPresentation.card_eq`, `N` is finite if and only if
`S ⧸ Ideal.span {x}` is finite. -/
theorem finite_iff_finite_quotient_span [Module.Finite S N] (P : QuadraticPresentation S N)
    {x : S} (hx : x ∈ nonZeroDivisors S) (hfitt : fittingIdeal S N 0 = Ideal.span {x}) :
    Finite N ↔ Finite (S ⧸ Ideal.span {x}) := by
  have h1 : Nonempty N := ⟨0⟩
  have h2 : Nonempty (S ⧸ Ideal.span {x}) := ⟨0⟩
  simpa [Nat.card_ne_zero, h1, h2] using congrArg (· ≠ 0) (P.card_eq hx hfitt)

end SubringPiPID

end QuadraticPresentation

namespace IsQuadraticallyPresented

variable {ι : Type*} [Finite ι] {D : ι → Type*}
  [∀ i, CommRing (D i)] [∀ i, IsDomain (D i)] [∀ i, IsPrincipalIdealRing (D i)]
  {S : Subring (∀ i, D i)} [S.toAddSubgroup.FiniteIndex]
  {N : Type*} [AddCommGroup N] [Module S N] [Module.Finite S N]

/-- **The order of a quadratically presented module over a finite-index order**
(Dasgupta–Kakde, Lemma 2.4), existential form: if `N` is quadratically presented over `S` and
`Fitt₀(N) = Ideal.span {x}` for `x ∈ nonZeroDivisors S`, then
`Nat.card N = Nat.card (S ⧸ Ideal.span {x})`. -/
theorem card_eq (hP : IsQuadraticallyPresented S N) {x : S}
    (hx : x ∈ nonZeroDivisors S) (hfitt : fittingIdeal S N 0 = Ideal.span {x}) :
    Nat.card N = Nat.card (S ⧸ Ideal.span {x}) := by
  obtain ⟨m, hm, A, ⟨e⟩⟩ := isQuadraticallyPresented_iff_exists_linearEquiv.mp hP
  exact ((QuadraticPresentation.cokernel hm A).map e).card_eq hx hfitt

/-- If `N` is quadratically presented over `S` and `Fitt₀(N) = Ideal.span {x}` for
`x ∈ nonZeroDivisors S`, then `N` is finite if and only if `S ⧸ Ideal.span {x}` is finite. -/
theorem finite_iff_finite_quotient_span (hP : IsQuadraticallyPresented S N) {x : S}
    (hx : x ∈ nonZeroDivisors S) (hfitt : fittingIdeal S N 0 = Ideal.span {x}) :
    Finite N ↔ Finite (S ⧸ Ideal.span {x}) := by
  obtain ⟨m, hm, A, ⟨e⟩⟩ := isQuadraticallyPresented_iff_exists_linearEquiv.mp hP
  exact ((QuadraticPresentation.cokernel hm A).map e).finite_iff_finite_quotient_span hx hfitt

end IsQuadraticallyPresented

section Examples

-- Mixed infinite/finite PID factors (`ℤ` and `ZMod 2`) where `A.det` is regular in the index-`2`
-- diagonal subring `S ≅ ℤ` yet becomes a zero-divisor `(4, 0)` in the ambient product `∏ b, D b`,
-- exercising the finite-kernel quotient step in `Subring.restrictInfiniteHom`.
example :
    ∃ (D : Bool → Type) (_ : ∀ b, CommRing (D b)) (_ : ∀ b, IsDomain (D b))
      (_ : ∀ b, IsPrincipalIdealRing (D b)) (S : Subring (∀ b, D b))
      (_ : S.toAddSubgroup.FiniteIndex) (A : Matrix (Fin 2) (Fin 2) S),
      Infinite (D false) ∧ Finite (D true) ∧
        A.det ∈ nonZeroDivisors S ∧
        (A.det : ∀ b, D b) ∉ nonZeroDivisors (∀ b, D b) ∧
        Nat.card ((Fin 2 → S) ⧸ LinearMap.range (Matrix.toLin' A)) =
          Nat.card (S ⧸ Ideal.span {A.det}) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let D : Bool → Type := fun b ↦ match b with | false => ℤ | true => ZMod 2
  let instCR : ∀ b : Bool, CommRing (D b) :=
    fun b ↦ match b with | false => inferInstance | true => inferInstance
  let instDom : ∀ b : Bool, IsDomain (D b) :=
    fun b ↦ match b with | false => inferInstance | true => inferInstance
  let instPIR : ∀ b : Bool, IsPrincipalIdealRing (D b) :=
    fun b ↦ match b with | false => inferInstance | true => inferInstance
  let φ : ℤ →+* ∀ b : Bool, D b :=
    RingHom.pi fun b ↦ match b with | false => RingHom.id ℤ | true => Int.castRingHom (ZMod 2)
  let S : Subring (∀ b : Bool, D b) := φ.range
  have hindex : S.toAddSubgroup.FiniteIndex := by
    refine @AddSubgroup.finiteIndex_of_finite_quotient _ _ S.toAddSubgroup ?_
    refine Finite.of_surjective
      (fun u : ZMod 2 ↦
        (QuotientAddGroup.mk (fun b : Bool ↦ match b with | false => (0 : ℤ) | true => u) :
          (∀ b : Bool, D b) ⧸ S.toAddSubgroup))
      fun q ↦ ?_
    obtain ⟨f, rfl⟩ := QuotientAddGroup.mk_surjective q
    refine ⟨f true - (f false : ZMod 2), QuotientAddGroup.eq.mpr ⟨f false, ?_⟩⟩
    ext b
    cases b <;> simp [D, φ]
  let x : S := ⟨φ 2, ⟨2, rfl⟩⟩
  let A : Matrix (Fin 2) (Fin 2) S := !![x, 1; 0, x]
  have hx : x ∈ nonZeroDivisors S := by
    rw [mem_nonZeroDivisors_iff_left]
    rintro ⟨_, ⟨n, rfl⟩⟩ hmul
    have h2n : (2 : ℤ) * n = 0 := congr_fun (congrArg Subtype.val hmul) false
    have hn : n = 0 := (mul_eq_zero.mp h2n).resolve_left (by decide)
    subst hn
    ext b
    cases b <;> rfl
  have hdet_eq : A.det = x * x := by simp [A]
  have hdet : A.det ∈ nonZeroDivisors S := hdet_eq ▸ mul_mem hx hx
  have hdet_not : (A.det : ∀ b, D b) ∉ nonZeroDivisors (∀ b, D b) := by
    intro hmem
    let z : ∀ b : Bool, D b := fun b ↦ match b with | false => 0 | true => 1
    have hz : (A.det : ∀ b, D b) * z = 0 := by
      ext b
      cases b
      · simp [D, hdet_eq, x, φ, z]
      · simp only [D, hdet_eq, x, φ, z, Subring.coe_mul, Pi.mul_apply, Pi.zero_apply,
          RingHom.pi_apply, Int.coe_castRingHom]
        decide
    have hz0 : z = 0 := mem_nonZeroDivisors_iff_left.mp hmem z hz
    exact one_ne_zero (congr_fun hz0 true)
  let P := QuadraticPresentation.cokernel (by decide : 0 < 2) A
  exact ⟨D, instCR, instDom, instPIR, S, hindex, A, inferInstanceAs (Infinite ℤ),
    inferInstanceAs (Finite (ZMod 2)), hdet, hdet_not, P.card_eq_card_quotient_span_det hdet⟩

end Examples

end TauCeti
