/-!
# Lifting square presentations from quotients and product factors

This file proves the relation-lifting results used to descend square presentations from finite
quotients to a Noetherian local ring and to assemble them across a finite product decomposition.

Over a local ring `A`, any minimal free cover `π : Aʳ ↠ N` (`ker π ≤ 𝔪_A Aʳ`) of a module `N`
that admits *some* square presentation `Aˢ → Aˢ ↠ N → 0` (of arbitrary size `s`) has kernel
generated by `r` elements (`TauCeti.exists_squareMatrix_of_minimalCover_of_squarePresentation`).
The argument compares the two covers by projectivity, splits off a free complement `A^{s - r}`
via Nakayama's lemma and Orzech's theorem, and projects the `s` relations onto the minimal cover.
In particular, arbitrarily large finite square matrices do not obstruct the minimal-cover bound,
and no Noetherian hypothesis is needed at the quotient level.

Over a Noetherian local ring `R` with maximal ideal `𝔪`, let `M` be a finite `R`-module and let
`{Iᵢ}` be a family of ideals such that for every `N` there is some `i` with `Iᵢ ≤ 𝔪 ^ N` and
`M ⧸ Iᵢ M` quadratically presented over `R ⧸ Iᵢ`. Choosing a minimal cover `π : Rʳ ↠ M` with
kernel `K` (`TauCeti.IsLocalRing.exists_surjective_ker_le_maximalIdeal_smul`), the Artin–Rees
lemma gives `K ⊓ Iᵢ Rʳ ≤ 𝔪 K` for a sufficiently deep `Iᵢ`. The local comparison lemma bounds the
generators of `K ⧸ (K ⊓ Iᵢ Rʳ)` by `r`, and Nakayama's lemma lifts them to `r` generators of `K`
(`TauCeti.exists_minimalSquarePresentation_of_cofinal_quotientSMulTop`,
`TauCeti.isQuadraticallyPresented_of_cofinal_quotientSMulTop`). When `M = 0` this yields `r = 0`
with the empty matrix of determinant `1` as well as the `1 × 1` unit presentation.

Across a complete orthogonal family of idempotents `eᵢ` of a commutative ring `R`, componentwise
square presentations of locally constant ranks `rᵢ` assemble both to a finite projective square
presentation `P → P ↠ M → 0` retaining the ranks `rᵢ`
(`TauCeti.exists_projectiveSquarePresentation_of_completeOrthogonalIdempotents`) and, after
padding by identity blocks (`TauCeti.QuadraticPresentation.pad`), to a uniform
`TauCeti.QuadraticPresentation R M` (`IsQuadraticallyPresented.of_completeOrthogonalIdempotents`).
Finally, if the relation determinant of a `QuadraticPresentation R N` is a non-zero-divisor (in
particular, whenever `Fitt₀(N)` contains a non-zero-divisor), the relation map is injective
(`QuadraticPresentation.injective_toLin'_of_det_mem_nonZeroDivisors`) and `N` has projective
dimension at most one
(`QuadraticPresentation.hasProjectiveDimensionLE_one_of_det_mem_nonZeroDivisors`,
`IsQuadraticallyPresented.hasProjectiveDimensionLE_one_of_mem_fittingIdeal`).

## Main results

* `TauCeti.QuadraticPresentation.injective_toLin'_of_det_mem_nonZeroDivisors`,
  `TauCeti.QuadraticPresentation.det_mem_nonZeroDivisors_of_mem_fittingIdeal`,
  `TauCeti.QuadraticPresentation.hasProjectiveDimensionLE_one_of_det_mem_nonZeroDivisors`,
  `TauCeti.IsQuadraticallyPresented.hasProjectiveDimensionLE_one_of_mem_fittingIdeal`: a regular
  relation determinant (or any regular element in `Fitt₀(N)`) forces injectivity of the relation
  map and `pd_R(N) ≤ 1`.
* `TauCeti.exists_squareMatrix_of_minimalCover_of_squarePresentation`: over a local ring, a
  minimal free cover of a quadratically presented module has kernel generated by `r` elements.
* `TauCeti.exists_minimalSquarePresentation_of_cofinal_quotientSMulTop`,
  `TauCeti.isQuadraticallyPresented_of_cofinal_quotientSMulTop`,
  `TauCeti.isQuadraticallyPresented_of_cofinal_baseChange_quotient`: lifting square presentations
  over a Noetherian local ring from cofinal quotients inside powers of the maximal ideal.
* `TauCeti.exists_projectiveSquarePresentation_of_completeOrthogonalIdempotents`,
  `TauCeti.exists_minimalSquarePresentation_of_ringEquiv`,
  `TauCeti.IsQuadraticallyPresented.of_completeOrthogonalIdempotents`,
  `TauCeti.IsQuadraticallyPresented.of_pi`: assembling componentwise square presentations over
  finite product decompositions and transporting minimal presentations across ring equivalences.

## References

* M. Kurihara, *Iwasawa theory and Fitting ideals*, J. Reine Angew. Math. 561 (2003), Theorem 2.12
  and Lemma 4.2(2).
-/

public section

noncomputable section

open CategoryTheory Function IsLocalRing LinearMap Module TensorProduct

open scoped Matrix

namespace TauCeti

section Regularity

universe u v

variable {R N : Type*} [CommRing R] [AddCommGroup N] [Module R N]

namespace QuadraticPresentation

/-- If the determinant of the relation matrix of a quadratic presentation is a non-zero-divisor,
then the relation map `R^m → R^m` is injective. -/
theorem injective_toLin'_of_det_mem_nonZeroDivisors (P : QuadraticPresentation R N)
    (hdet : P.rel.det ∈ nonZeroDivisors R) : Function.Injective (Matrix.toLin' P.rel) :=
  fun _ _ hvw ↦ Matrix.mulVec_injective_of_det_mem_nonZeroDivisors hdet hvw

/-- If the determinant of the relation matrix of a quadratic presentation is a non-zero-divisor,
then the presented module has projective dimension at most one. -/
theorem hasProjectiveDimensionLE_one_of_det_mem_nonZeroDivisors {R : Type u} [CommRing R]
    {N : Type v} [AddCommGroup N] [Module R N] [Small.{v} R] (P : QuadraticPresentation R N)
    (hdet : P.rel.det ∈ nonZeroDivisors R) :
    HasProjectiveDimensionLE (ModuleCat.of R N) 1 := by
  let e := Shrink.linearEquiv.{v} R (Fin P.size → R)
  let g : Shrink.{v} (Fin P.size → R) →ₗ[R] N := P.gen.comp e.toLinearMap
  have : Module.Projective R (Shrink.{v} (Fin P.size → R)) := Module.Projective.of_equiv e.symm
  rw [g.hasProjectiveDimensionLE_succ_iff_ker (P.gen_surjective.comp e.surjective) 0,
    ← projective_iff_hasProjectiveDimensionLE_zero, ← IsProjective.iff_projective]
  let φ : (Fin P.size → R) →ₗ[R] Shrink.{v} (Fin P.size → R) :=
    e.symm.toLinearMap.comp (Matrix.toLin' P.rel)
  have hφ_inj : Function.Injective φ :=
    e.symm.injective.comp (P.injective_toLin'_of_det_mem_nonZeroDivisors hdet)
  have hrange : LinearMap.range φ = LinearMap.ker g := by
    ext x
    simp only [LinearMap.mem_range, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.mem_ker,
      φ, g]
    constructor
    · rintro ⟨y, rfl⟩
      rw [e.apply_symm_apply]
      exact LinearMap.mem_ker.mp (P.range_rel_eq_ker ▸ LinearMap.mem_range_self _ y)
    · intro hx
      obtain ⟨y, hy⟩ := P.range_rel_eq_ker.symm ▸ (LinearMap.mem_ker.mpr hx)
      exact ⟨y, by rw [hy, e.symm_apply_apply]⟩
  exact Module.Projective.of_equiv ((LinearEquiv.ofInjective φ hφ_inj).trans
    (LinearEquiv.ofEq _ _ hrange))

/-- If the zeroth Fitting ideal of a quadratically presented module contains a non-zero-divisor,
then the relation determinant is itself a non-zero-divisor (since it divides every element of
`Fitt₀(N)`). -/
theorem det_mem_nonZeroDivisors_of_mem_fittingIdeal [Module.Finite R N]
    (P : QuadraticPresentation R N) {d : R} (hd : d ∈ fittingIdeal R N 0)
    (hreg : d ∈ nonZeroDivisors R) :
    P.rel.det ∈ nonZeroDivisors R := by
  rw [P.fittingIdeal_eq, Ideal.mem_span_singleton] at hd
  obtain ⟨c, rfl⟩ := hd
  exact (mul_mem_nonZeroDivisors.mp hreg).1

end QuadraticPresentation

/-- A quadratically presented module whose zeroth Fitting ideal contains a non-zero-divisor has
projective dimension at most one. -/
theorem IsQuadraticallyPresented.hasProjectiveDimensionLE_one_of_mem_fittingIdeal {R : Type u}
    [CommRing R] {N : Type v} [AddCommGroup N] [Module R N] [Module.Finite R N] [Small.{v} R]
    (h : IsQuadraticallyPresented R N) {d : R} (hd : d ∈ fittingIdeal R N 0)
    (hreg : d ∈ nonZeroDivisors R) :
    HasProjectiveDimensionLE (ModuleCat.of R N) 1 := by
  obtain ⟨P⟩ := h.nonempty
  exact P.hasProjectiveDimensionLE_one_of_det_mem_nonZeroDivisors
    (P.det_mem_nonZeroDivisors_of_mem_fittingIdeal hd hreg)

end Regularity

section LocalMinimalCover

variable {A N : Type*} [CommRing A] [IsLocalRing A] [AddCommGroup N] [Module A N]

/-- Given a minimal cover `π : Aʳ ↠ N`, any surjection `g : Aˢ ↠ N`, and a lift `u : Aˢ → Aʳ`
with `π ∘ u = g`, Nakayama's lemma and Orzech's theorem produce a right inverse `w' : Aʳ → Aˢ` to
`u` satisfying `g ∘ w' = π`. -/
private theorem exists_rightInverse_of_minimalCover {r s : ℕ}
    (π : (Fin r → A) →ₗ[A] N) (hmin : LinearMap.ker π ≤ maximalIdeal A • (⊤ : Submodule A _))
    (g : (Fin s → A) →ₗ[A] N) (hg : Function.Surjective g)
    (u : (Fin s → A) →ₗ[A] (Fin r → A)) (hu : π ∘ₗ u = g) :
    ∃ w' : (Fin r → A) →ₗ[A] (Fin s → A), u ∘ₗ w' = LinearMap.id ∧ g ∘ₗ w' = π := by
  obtain ⟨w, hw⟩ := Module.projective_lifting_property g π hg
  let T : (Fin r → A) →ₗ[A] (Fin r → A) := u ∘ₗ w
  have hT_surj : Function.Surjective T := by
    rw [← LinearMap.range_eq_top, eq_top_iff]
    refine Submodule.le_of_le_smul_of_le_jacobson (I := maximalIdeal A) Module.Finite.fg_top
      (by rw [← Ideal.jacobson_bot]; exact maximalIdeal_le_jacobson ⊥) fun x _ ↦ ?_
    have hdiff : x - T x ∈ LinearMap.ker π := by
      rw [LinearMap.mem_ker, map_sub]
      have h1 : π (T x) = π x := by
        rw [LinearMap.comp_apply (f := u), ← LinearMap.comp_apply π u, hu]
        exact LinearMap.congr_fun hw x
      rw [h1, sub_self]
    rw [show x = T x + (x - T x) by abel]
    exact Submodule.add_mem_sup (LinearMap.mem_range_self T x) (hmin hdiff)
  let eT := LinearEquiv.ofBijective T
    ⟨OrzechProperty.injective_of_surjective_endomorphism T hT_surj, hT_surj⟩
  let w' : (Fin r → A) →ₗ[A] (Fin s → A) := w ∘ₗ eT.symm.toLinearMap
  have huw' : u ∘ₗ w' = LinearMap.id := LinearMap.ext fun x ↦ eT.apply_symm_apply x
  exact ⟨w', huw', by rw [← hu, LinearMap.comp_assoc, huw', LinearMap.comp_id]⟩

/-- **Minimal-cover relation bound over a local ring.** Let `A` be a local ring and let
`π : Aʳ ↠ N` be a minimal free cover (`ker π ≤ 𝔪_A Aʳ`). If `N` admits any square presentation
`Aˢ →f Aˢ →g N → 0` (for arbitrary `s`), then `ker π` is generated by `r` elements. -/
theorem exists_squareMatrix_of_minimalCover_of_squarePresentation {r s : ℕ}
    (π : (Fin r → A) →ₗ[A] N) (hπ : Function.Surjective π)
    (hmin : LinearMap.ker π ≤ maximalIdeal A • (⊤ : Submodule A (Fin r → A)))
    (f : (Fin s → A) →ₗ[A] (Fin s → A)) (g : (Fin s → A) →ₗ[A] N)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    ∃ B : Matrix (Fin r) (Fin r) A, LinearMap.range (Matrix.toLin' B) = LinearMap.ker π := by
  -- Step 1: compare `π` with `g`, split `u : Aˢ → Aʳ` by `w'`, and identify `ker u ≃ A^{s - r}`.
  obtain ⟨u, hu⟩ := Module.projective_lifting_property π g hπ
  obtain ⟨w', huw', hgw'⟩ := exists_rightInverse_of_minimalCover π hmin g hg u hu
  obtain ⟨hrs, ⟨eK⟩⟩ := TauCeti.IsLocalRing.exists_linearEquiv_fin_ker_of_comp_eq_id u w' huw'
  -- Step 2: project `f` along `id - w' ∘ u` onto `ker u ≃ A^{s - r}`; its kernel has rank `r`
  -- and maps onto `ker π` under `u ∘ f`.
  let p : (Fin s → A) →ₗ[A] LinearMap.ker u :=
    { toFun := fun z ↦ ⟨z - w' (u z), by
        rw [LinearMap.mem_ker, map_sub, ← LinearMap.comp_apply u w', huw', LinearMap.id_apply,
          sub_self]⟩
      map_add' := fun x y ↦ by ext; simp; abel
      map_smul' := fun c x ↦ by ext; simp [smul_sub] }
  let q : (Fin s → A) →ₗ[A] (Fin (s - r) → A) := eK.symm.toLinearMap ∘ₗ p ∘ₗ f
  have hq_surj : Function.Surjective q := fun y ↦ by
    obtain ⟨z, hz⟩ : (eK y : Fin s → A) ∈ LinearMap.range f := by
      rw [hfg, LinearMap.mem_ker, ← hu, LinearMap.comp_apply, LinearMap.mem_ker.mp (eK y).property,
        map_zero]
    refine ⟨z, ?_⟩
    have hpz : p (f z) = eK y := Subtype.ext <| by
      simp [p, hz, LinearMap.mem_ker.mp (eK y).property]
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.coe_coe, hpz, eK.symm_apply_apply]
  obtain ⟨t, ht⟩ := Module.projective_lifting_property q LinearMap.id hq_surj
  obtain ⟨_, ⟨eL⟩⟩ := TauCeti.IsLocalRing.exists_linearEquiv_fin_ker_of_comp_eq_id q t ht
  let eL' : (Fin r → A) ≃ₗ[A] LinearMap.ker q :=
    (LinearEquiv.funCongrLeft A A (finCongr (by omega : s - (s - r) = r))).trans eL
  refine ⟨LinearMap.toMatrix' (u ∘ₗ f ∘ₗ (LinearMap.ker q).subtype ∘ₗ eL'.toLinearMap), ?_⟩
  rw [Matrix.toLin'_toMatrix']
  ext y
  simp only [LinearMap.mem_range, LinearMap.mem_ker]
  constructor
  · rintro ⟨x, rfl⟩
    rw [LinearMap.comp_apply, ← LinearMap.comp_apply π u, hu]
    exact LinearMap.mem_ker.mp (hfg ▸ LinearMap.mem_range_self f (eL' x).val)
  · intro hy
    obtain ⟨z, hz⟩ : w' y ∈ LinearMap.range f := by
      rwa [hfg, LinearMap.mem_ker, ← LinearMap.comp_apply g w', hgw']
    have hzq : z ∈ LinearMap.ker q := by
      have hpz : p (f z) = 0 := Subtype.ext <| by
        simp [p, hz, ← LinearMap.comp_apply u w', huw']
      rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.comp_apply, LinearEquiv.coe_coe,
        hpz, map_zero]
    refine ⟨eL'.symm ⟨z, hzq⟩, ?_⟩
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Submodule.coe_subtype,
      eL'.apply_symm_apply, hz, ← LinearMap.comp_apply u w', huw', LinearMap.id_apply]

/-- Over a local ring, a minimal free cover `π : Aʳ ↠ N` of a quadratically presented module has
kernel equal to the range of an `r × r` matrix. -/
theorem exists_squareMatrix_of_minimalCover_of_isQuadraticallyPresented {r : ℕ}
    (π : (Fin r → A) →ₗ[A] N) (hπ : Function.Surjective π)
    (hmin : LinearMap.ker π ≤ maximalIdeal A • (⊤ : Submodule A (Fin r → A)))
    (hQP : IsQuadraticallyPresented A N) :
    ∃ B : Matrix (Fin r) (Fin r) A, LinearMap.range (Matrix.toLin' B) = LinearMap.ker π := by
  obtain ⟨P⟩ := hQP.nonempty
  exact exists_squareMatrix_of_minimalCover_of_squarePresentation π hπ hmin
    (Matrix.toLin' P.rel) P.gen P.gen_surjective P.range_rel_eq_ker

end LocalMinimalCover

section NoetherianLocalLift

variable {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]

/-- Reduce a minimal cover `π : Rʳ ↠ M` modulo an ideal `I ≤ 𝔪_R` using the coordinatewise map
`red := (mkₐ R I).toLinearMap.compLeft (Fin r)`, producing a minimal cover `π'` of `M ⧸ I M` over
`R ⧸ I` whose kernel lifts into `ker π`. -/
private theorem exists_minimalCover_quotientSMulTop {r : ℕ}
    (π : (Fin r → R) →ₗ[R] M) (hπ : Function.Surjective π)
    (hmin : LinearMap.ker π ≤ maximalIdeal R • (⊤ : Submodule R (Fin r → R)))
    {I : Ideal R} (hI : I ≤ maximalIdeal R) :
    let A := R ⧸ I
    letI : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr
      (ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hI)
    letI : IsLocalRing A := IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
    let red : (Fin r → R) →ₗ[R] (Fin r → A) :=
      (Ideal.Quotient.mkₐ R I).toLinearMap.compLeft (Fin r)
    Function.Surjective red ∧
    LinearMap.ker red = I • (⊤ : Submodule R (Fin r → R)) ∧
    ∃ π' : (Fin r → A) →ₗ[A] (M ⧸ (I • (⊤ : Submodule R M))),
      (∀ x : Fin r → R, π' (red x) = Submodule.Quotient.mk (π x)) ∧
      Function.Surjective π' ∧
      LinearMap.ker π' ≤ maximalIdeal A • (⊤ : Submodule A (Fin r → A)) ∧
      (∀ y ∈ LinearMap.ker π', ∃ z ∈ LinearMap.ker π, red z = y) := by
  let A := R ⧸ I
  let mkI : R →+* A := Ideal.Quotient.mk I
  have : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hI)
  have : IsLocalRing A := IsLocalRing.of_surjective' mkI Ideal.Quotient.mk_surjective
  let red : (Fin r → R) →ₗ[R] (Fin r → A) :=
    (Ideal.Quotient.mkₐ R I).toLinearMap.compLeft (Fin r)
  have hred_apply (x : Fin r → R) (j : Fin r) : red x j = mkI (x j) := rfl
  have hred_surj : Function.Surjective red := fun y ↦ by
    choose x hx using fun j ↦ Ideal.Quotient.mk_surjective (y j)
    exact ⟨x, funext hx⟩
  have hred_ker : LinearMap.ker red = I • (⊤ : Submodule R (Fin r → R)) := by
    ext x
    rw [LinearMap.mem_ker, funext_iff, Ideal.mem_smul_top_pi_iff]
    simp only [smul_eq_mul, Ideal.mul_top, Pi.zero_apply, hred_apply]
    exact forall_congr' fun j ↦ Ideal.Quotient.eq_zero_iff_mem
  let π' : (Fin r → A) →ₗ[A] (M ⧸ (I • (⊤ : Submodule R M))) :=
    Fintype.linearCombination A fun j ↦ Submodule.Quotient.mk (π (Pi.single j 1))
  have hπ'_red (x : Fin r → R) : π' (red x) = Submodule.Quotient.mk (π x) := by
    conv_rhs =>
      rw [pi_eq_sum_univ' x, map_sum, ← Submodule.mkQ_apply, map_sum]
    simp only [π', Fintype.linearCombination_apply, hred_apply, Submodule.mkQ_apply, map_smul]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    dsimp only [mkI]
    rw [← Ideal.Quotient.algebraMap_eq]
    exact (algebra_compatible_smul A (x j) _).symm
  have hπ'_surj : Function.Surjective π' := fun z ↦ by
    obtain ⟨m, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    obtain ⟨x, rfl⟩ := hπ m
    exact ⟨red x, hπ'_red x⟩
  have hker_lift : ∀ y ∈ LinearMap.ker π', ∃ z ∈ LinearMap.ker π, red z = y := fun y hy ↦ by
    obtain ⟨x, rfl⟩ := hred_surj y
    rw [LinearMap.mem_ker, hπ'_red, Submodule.Quotient.mk_eq_zero] at hy
    obtain ⟨w, hw, hwx⟩ : π x ∈ (I • (⊤ : Submodule R (Fin r → R))).map π := by
      rwa [Submodule.map_smul'', Submodule.map_top, LinearMap.range_eq_top.mpr hπ]
    have hw0 : red w = 0 := LinearMap.mem_ker.mp (by rwa [hred_ker])
    exact ⟨x - w, by rw [LinearMap.mem_ker, map_sub, hwx, sub_self], by
      rw [map_sub, hw0, sub_zero]⟩
  have hmin' : LinearMap.ker π' ≤ maximalIdeal A • (⊤ : Submodule A (Fin r → A)) := by
    intro y hy
    obtain ⟨z, hzK, rfl⟩ := hker_lift y hy
    rw [Ideal.mem_smul_top_pi_iff]
    simp only [smul_eq_mul, Ideal.mul_top]
    have hz_coord : ∀ j, z j ∈ maximalIdeal R := by
      simpa only [smul_eq_mul, Ideal.mul_top] using (Ideal.mem_smul_top_pi_iff _).mp (hmin hzK)
    intro j
    rw [hred_apply]
    exact IsLocalRing.map_maximalIdeal_of_surjective mkI Ideal.Quotient.mk_surjective ▸
      Ideal.mem_map_of_mem mkI (hz_coord j)
  exact ⟨hred_surj, hred_ker, π', hπ'_red, hπ'_surj, hmin', hker_lift⟩

section

variable [IsNoetherianRing R] [Module.Finite R M]

/-- **Lifting a minimal square presentation over a Noetherian local ring (module-quotient form).**
Let `M` be a finite module over a Noetherian local ring `R` with minimal number of generators
`r = dim_κ (κ ⊗[R] M)`. If `{Iᵢ}` is a family of ideals such that for every `N` there exists `i`
with `Iᵢ ≤ 𝔪 ^ N` and `M ⧸ Iᵢ M` quadratically presented over `R ⧸ Iᵢ`, then `M` has a minimal
square presentation `Rʳ →B Rʳ →π M → 0` (with `r = 0` permitted when `M = 0`). -/
theorem exists_minimalSquarePresentation_of_cofinal_quotientSMulTop {ι : Type*}
    {I : ι → Ideal R}
    (hcof : ∀ N : ℕ, ∃ i : ι, I i ≤ maximalIdeal R ^ N ∧
      IsQuadraticallyPresented (R ⧸ I i) (M ⧸ (I i • (⊤ : Submodule R M)))) :
    ∃ (π : (Fin (finrank (ResidueField R) (ResidueField R ⊗[R] M)) → R) →ₗ[R] M)
      (B : Matrix (Fin (finrank (ResidueField R) (ResidueField R ⊗[R] M)))
        (Fin (finrank (ResidueField R) (ResidueField R ⊗[R] M))) R),
      Function.Surjective π ∧
      LinearMap.ker π ≤ maximalIdeal R • (⊤ : Submodule R _) ∧
      LinearMap.range (Matrix.toLin' B) = LinearMap.ker π := by
  -- Step 1: apply Artin–Rees to a minimal cover `π : Rʳ ↠ M` with kernel `K`.
  set r := finrank (ResidueField R) (ResidueField R ⊗[R] M)
  obtain ⟨π, hπ, hmin⟩ := TauCeti.IsLocalRing.exists_surjective_ker_le_maximalIdeal_smul R M
  set K := LinearMap.ker π
  have hKfg : K.FG := IsNoetherian.noetherian K
  obtain ⟨k, hk⟩ := (maximalIdeal R).exists_pow_inf_eq_pow_smul K
  have hAR : (maximalIdeal R ^ (k + 1) • (⊤ : Submodule R (Fin r → R))) ⊓ K ≤
      maximalIdeal R • K := by
    have h := hk (k + 1) (Nat.le_succ k)
    rw [Nat.add_sub_cancel_left, pow_one] at h
    exact h ▸ Submodule.smul_mono le_rfl inf_le_right
  -- Step 2: descend `π` to a minimal cover `π'` over `R ⧸ Iᵢ` (`Iᵢ ≤ 𝔪^{k+1}`) and bound `ker π'`.
  obtain ⟨i, hi_le, hQP⟩ := hcof (k + 1)
  have hi_le_m : I i ≤ maximalIdeal R := hi_le.trans (Ideal.pow_le_self (Nat.succ_ne_zero k))
  let A := R ⧸ I i
  have : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hi_le_m)
  have : IsLocalRing A := IsLocalRing.of_surjective' (Ideal.Quotient.mk (I i))
    Ideal.Quotient.mk_surjective
  let red : (Fin r → R) →ₗ[R] (Fin r → A) :=
    (Ideal.Quotient.mkₐ R (I i)).toLinearMap.compLeft (Fin r)
  obtain ⟨_, hred_ker, π', hπ'_red, hπ'_surj, hmin', hker_lift⟩ :=
    exists_minimalCover_quotientSMulTop π hπ hmin hi_le_m
  obtain ⟨B', hB'⟩ := exists_squareMatrix_of_minimalCover_of_isQuadraticallyPresented
    π' hπ'_surj hmin' hQP
  -- Step 3: lift the `r` generators of `ker π'` to `z : Fin r → K` and show `K = span z` by
  -- Nakayama + Artin–Rees.
  choose z hzK hzred using fun j : Fin r ↦
    hker_lift (Matrix.toLin' B' (Pi.single j 1)) (hB' ▸ LinearMap.mem_range_self _ _)
  let L : Submodule R (Fin r → R) := Submodule.span R (Set.range z)
  have hLK : L ≤ K := Submodule.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hzK j)
  have hKL : K ≤ L ⊔ maximalIdeal R • K := fun x hx ↦ by
    obtain ⟨c', hc'⟩ : red x ∈ LinearMap.range (Matrix.toLin' B') := by
      rw [hB', LinearMap.mem_ker, hπ'_red, LinearMap.mem_ker.mp hx, Submodule.Quotient.mk_zero]
    choose c hc using fun j ↦ Ideal.Quotient.mk_surjective (c' j)
    let w : Fin r → R := ∑ j : Fin r, c j • z j
    have hwL : w ∈ L :=
      Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem _ (c j) (Submodule.subset_span ⟨j, rfl⟩)
    have hredw : red w = red x := by
      rw [← hc']
      conv_rhs =>
        rw [pi_eq_sum_univ' c', map_sum]
      simp only [w, map_sum, map_smul, Matrix.toLin'_apply]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      ext l
      dsimp only [A, red]
      rw [Pi.smul_apply, Pi.smul_apply, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
        hzred j, Matrix.toLin'_apply, hc j, smul_eq_mul]
    have hdiff_ker : x - w ∈ I i • (⊤ : Submodule R (Fin r → R)) := by
      rw [← hred_ker, LinearMap.mem_ker, map_sub, hredw, sub_self]
    rw [show x = w + (x - w) by abel]
    exact Submodule.add_mem_sup hwL
      (hAR ⟨Submodule.smul_mono_left hi_le hdiff_ker, sub_mem hx (hLK hwL)⟩)
  have hK_eq_L : K = L := le_antisymm
    (Submodule.le_of_le_smul_of_le_jacobson (I := maximalIdeal R) hKfg
      (by rw [← Ideal.jacobson_bot]; exact maximalIdeal_le_jacobson ⊥) hKL) hLK
  refine ⟨π, LinearMap.toMatrix' (Fintype.linearCombination R z), hπ, hmin, ?_⟩
  rw [Matrix.toLin'_toMatrix', Fintype.range_linearCombination]
  exact hK_eq_L.symm

/-- **Lifting a quadratic presentation over a Noetherian local ring (module-quotient form).** -/
theorem isQuadraticallyPresented_of_cofinal_quotientSMulTop {ι : Type*} {I : ι → Ideal R}
    (hcof : ∀ N : ℕ, ∃ i : ι, I i ≤ maximalIdeal R ^ N ∧
      IsQuadraticallyPresented (R ⧸ I i) (M ⧸ (I i • (⊤ : Submodule R M)))) :
    IsQuadraticallyPresented R M := by
  obtain ⟨π, B, hπ, _, hrange⟩ := exists_minimalSquarePresentation_of_cofinal_quotientSMulTop hcof
  exact IsQuadraticallyPresented.of_exact (Pi.basisFun R _) (Pi.basisFun R _)
    (LinearMap.exact_iff.2 hrange.symm) hπ

/-- **Lifting a quadratic presentation over a Noetherian local ring (tensor-quotient form).** -/
theorem isQuadraticallyPresented_of_cofinal_baseChange_quotient {ι : Type*} {I : ι → Ideal R}
    (hcof : ∀ N : ℕ, ∃ i : ι, I i ≤ maximalIdeal R ^ N ∧
      IsQuadraticallyPresented (R ⧸ I i) ((R ⧸ I i) ⊗[R] M)) :
    IsQuadraticallyPresented R M :=
  isQuadraticallyPresented_of_cofinal_quotientSMulTop (I := I) fun N ↦ by
    obtain ⟨i, hi, hQP⟩ := hcof N
    exact ⟨i, hi, hQP.of_equiv (quotTensorEquivQuotSMulQuot (R := R) (M := M) (I i))⟩

end

end NoetherianLocalLift

section SemilocalAssembly

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- The `R`-linear equivalence `M ≃ₗ[R] Π i, (R ⧸ (1 - e i)) ⊗[R] M` induced by a complete
orthogonal family of idempotents `e`. -/
def moduleEquivPiOfCompleteOrthogonalIdempotents {ι : Type*} [Fintype ι] {e : ι → R}
    (he : CompleteOrthogonalIdempotents e) :
    M ≃ₗ[R] ∀ i, (R ⧸ Ideal.span {1 - e i}) ⊗[R] M :=
  open scoped Classical in
  (TensorProduct.lid R M).symm ≪≫ₗ
    TensorProduct.congr
      (AlgEquiv.ofBijective (AlgHom.pi fun _ ↦ Ideal.Quotient.mkₐ R _)
        he.bijective_pi).toLinearEquiv
      (LinearEquiv.refl R M) ≪≫ₗ
    TensorProduct.piLeft (R := R) (N := M) (fun i ↦ R ⧸ Ideal.span {1 - e i})

@[simp]
theorem moduleEquivPiOfCompleteOrthogonalIdempotents_apply {ι : Type*} [Fintype ι] {e : ι → R}
    (he : CompleteOrthogonalIdempotents e) (x : M) (i : ι) :
    moduleEquivPiOfCompleteOrthogonalIdempotents he x i = 1 ⊗ₜ[R] x := by
  simp [moduleEquivPiOfCompleteOrthogonalIdempotents]

/-- The `R`-linear equivalence `(Fin m → R) ≃ₗ[R] Π i, (Fin m → R ⧸ (1 - e i))` induced by a
complete orthogonal family of idempotents `e`. -/
private def freeEquivPiOfCompleteOrthogonalIdempotents {ι : Type*} [Fintype ι] {e : ι → R}
    (he : CompleteOrthogonalIdempotents e) (m : ℕ) :
    (Fin m → R) ≃ₗ[R] ∀ i, (Fin m → R ⧸ Ideal.span {1 - e i}) :=
  let eRing := AlgEquiv.ofBijective (AlgHom.pi fun _ ↦ Ideal.Quotient.mkₐ R _) he.bijective_pi
  { toFun := fun f i j ↦ Ideal.Quotient.mk (Ideal.span {1 - e i}) (f j)
    map_add' := fun _ _ ↦ funext fun _ ↦ funext fun _ ↦ map_add _ _ _
    map_smul' := fun c f ↦ funext fun i ↦ funext fun j ↦ by
      simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Algebra.smul_def,
        Ideal.Quotient.algebraMap_eq, map_mul]
    invFun := fun g j ↦ eRing.symm fun i ↦ g i j
    left_inv := fun f ↦ funext fun j ↦ eRing.symm_apply_apply (f j)
    right_inv := fun g ↦ funext fun i ↦ funext fun j ↦
      congrFun (eRing.apply_symm_apply fun k ↦ g k j) i }

/-- For a complete orthogonal family of idempotents `eᵢ`, the product of componentwise finite free
modules `Π i, (Fin (r i) → R ⧸ (1 - eᵢ))` is finitely generated and projective over `R`, as a
retract of `R^m` (`m = sup r`). -/
private theorem finite_projective_pi_fun_of_completeOrthogonalIdempotents {ι : Type*} [Fintype ι]
    {e : ι → R} (he : CompleteOrthogonalIdempotents e) (r : ι → ℕ) :
    let P := ∀ i : ι, (Fin (r i) → R ⧸ Ideal.span {1 - e i})
    Module.Finite R P ∧ Module.Projective R P := by
  classical
  let Rᵢ : ι → Type _ := fun i ↦ R ⧸ Ideal.span {1 - e i}
  let P := ∀ i : ι, (Fin (r i) → Rᵢ i)
  let m : ℕ := Finset.univ.sup r
  let eFree := freeEquivPiOfCompleteOrthogonalIdempotents he m
  let proj : (∀ i, Fin m → Rᵢ i) →ₗ[R] P :=
    { toFun := fun f i j ↦ f i (Fin.castLE (Finset.le_sup (Finset.mem_univ i)) j)
      map_add' := fun _ _ ↦ funext fun _ ↦ funext fun _ ↦ rfl
      map_smul' := fun _ _ ↦ funext fun _ ↦ funext fun _ ↦ rfl }
  let incl : P →ₗ[R] (∀ i, Fin m → Rᵢ i) :=
    { toFun := fun f i k ↦ if h : k.val < r i then f i ⟨k.val, h⟩ else 0
      map_add' := fun _ _ ↦ funext fun i ↦ funext fun k ↦ by
        dsimp only [P] at *
        by_cases h : k.val < r i <;> simp [h]
      map_smul' := fun _ _ ↦ funext fun i ↦ funext fun k ↦ by
        dsimp only [P] at *
        by_cases h : k.val < r i <;> simp [h] }
  have hpi : proj ∘ₗ incl = LinearMap.id :=
    LinearMap.ext fun _ ↦ funext fun _ ↦ funext fun _ ↦ by simp [proj, incl]
  exact ⟨Module.Finite.of_surjective (proj ∘ₗ eFree.toLinearMap)
      ((show Function.Surjective proj from fun y ↦ ⟨incl y, LinearMap.congr_fun hpi y⟩).comp
        eFree.surjective),
    Module.Projective.of_split (eFree.symm.toLinearMap ∘ₗ incl) (proj ∘ₗ eFree.toLinearMap) <|
      LinearMap.ext fun f ↦ by
        simpa [LinearMap.comp_apply, eFree.apply_symm_apply] using LinearMap.congr_fun hpi f⟩

/-- **Componentwise projective square presentation.** Given a complete orthogonal family of
idempotents `eᵢ` of `R` and componentwise square presentations of possibly varying ranks `rᵢ` on
each factor `(R ⧸ (1 - eᵢ)) ⊗[R] M`, assemble a square presentation `P →Φ P →g M → 0` by a
finitely generated projective `R`-module `P` retaining the locally constant ranks `rᵢ`. -/
theorem exists_projectiveSquarePresentation_of_completeOrthogonalIdempotents {ι : Type*}
    [Fintype ι] {e : ι → R} (he : CompleteOrthogonalIdempotents e) (r : ι → ℕ)
    (A : ∀ i, Matrix (Fin (r i)) (Fin (r i)) (R ⧸ Ideal.span {1 - e i}))
    (π : ∀ i, (Fin (r i) → R ⧸ Ideal.span {1 - e i}) →ₗ[R ⧸ Ideal.span {1 - e i}]
      ((R ⧸ Ideal.span {1 - e i}) ⊗[R] M))
    (hπ : ∀ i, Function.Surjective (π i))
    (hrange : ∀ i, LinearMap.range (Matrix.toLin' (A i)) = LinearMap.ker (π i)) :
    let P := ∀ i : ι, (Fin (r i) → R ⧸ Ideal.span {1 - e i})
    Module.Finite R P ∧ Module.Projective R P ∧
    ∃ (Φ : P →ₗ[R] P) (g : P →ₗ[R] M),
      Function.Surjective g ∧ LinearMap.range Φ = LinearMap.ker g ∧
      ∀ x : P, x ∈ LinearMap.ker g ↔ ∀ i, x i ∈ LinearMap.ker (π i) := by
  let Rᵢ : ι → Type _ := fun i ↦ R ⧸ Ideal.span {1 - e i}
  let P := ∀ i : ι, (Fin (r i) → Rᵢ i)
  obtain ⟨hfin, hproj⟩ := finite_projective_pi_fun_of_completeOrthogonalIdempotents he r
  let Φ : P →ₗ[R] P := LinearMap.piMap fun i ↦ (Matrix.toLin' (A i)).restrictScalars R
  let eM := moduleEquivPiOfCompleteOrthogonalIdempotents (M := M) he
  let g₀ : P →ₗ[R] ∀ i, Rᵢ i ⊗[R] M := LinearMap.piMap fun i ↦ (π i).restrictScalars R
  let g : P →ₗ[R] M := eM.symm.toLinearMap ∘ₗ g₀
  have hg_surj : Function.Surjective g :=
    eM.symm.surjective.comp (Function.Surjective.piMap hπ)
  have hker_g : ∀ x : P, x ∈ LinearMap.ker g ↔ ∀ i, x i ∈ LinearMap.ker (π i) := fun x ↦ by
    dsimp only [g, g₀]
    rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearEquiv.coe_coe,
      map_eq_zero_iff _ eM.symm.injective, LinearMap.coe_piMap, funext_iff]
    simp only [Pi.map_apply, Pi.zero_apply, LinearMap.coe_restrictScalars, LinearMap.mem_ker]
  have hrange_eq : LinearMap.range Φ = LinearMap.ker g := by
    ext x
    rw [hker_g, LinearMap.mem_range]
    constructor
    · rintro ⟨y, rfl⟩ i
      exact LinearMap.mem_ker.mp (hrange i ▸ LinearMap.mem_range_self _ (y i))
    · intro hx
      have hx' (i : ι) : x i ∈ LinearMap.range (Matrix.toLin' (A i)) := (hrange i).symm ▸ hx i
      choose y hy using hx'
      exact ⟨y, funext hy⟩
  exact ⟨hfin, hproj, Φ, g, hg_surj, hrange_eq, hker_g⟩

/-- Transport a minimal square presentation across a ring equivalence `e : R₁ ≃+* R₂` between local
rings and a semilinear module equivalence `eN : N₁ ≃+ N₂` over `e`. -/
theorem exists_minimalSquarePresentation_of_ringEquiv {R₁ R₂ N₁ N₂ : Type*}
    [CommRing R₁] [IsLocalRing R₁] [CommRing R₂] [IsLocalRing R₂]
    [AddCommGroup N₁] [Module R₁ N₁] [AddCommGroup N₂] [Module R₂ N₂]
    (e : R₁ ≃+* R₂) (eN : N₁ ≃+ N₂) (heN : ∀ (c : R₁) (x : N₁), eN (c • x) = e c • eN x)
    {r : ℕ} (A₁ : Matrix (Fin r) (Fin r) R₁) (π₁ : (Fin r → R₁) →ₗ[R₁] N₁)
    (hπ₁ : Function.Surjective π₁)
    (hmin₁ : LinearMap.ker π₁ ≤ maximalIdeal R₁ • (⊤ : Submodule R₁ (Fin r → R₁)))
    (hrange₁ : LinearMap.range (Matrix.toLin' A₁) = LinearMap.ker π₁) :
    ∃ (A₂ : Matrix (Fin r) (Fin r) R₂) (π₂ : (Fin r → R₂) →ₗ[R₂] N₂),
      Function.Surjective π₂ ∧
      LinearMap.ker π₂ ≤ maximalIdeal R₂ • (⊤ : Submodule R₂ (Fin r → R₂)) ∧
      LinearMap.range (Matrix.toLin' A₂) = LinearMap.ker π₂ := by
  let A₂ : Matrix (Fin r) (Fin r) R₂ := A₁.map e
  let π₂ : (Fin r → R₂) →ₗ[R₂] N₂ :=
    { toFun := fun v ↦ eN (π₁ (e.symm ∘ v))
      map_add' := fun u v ↦ by
        have hadd : e.symm ∘ (u + v) = e.symm ∘ u + e.symm ∘ v :=
          funext fun j ↦ map_add e.symm (u j) (v j)
        rw [hadd, map_add, map_add]
      map_smul' := fun c v ↦ by
        have hsmul : e.symm ∘ (c • v) = e.symm c • (e.symm ∘ v) :=
          funext fun j ↦ map_mul e.symm c (v j)
        rw [hsmul, map_smul, RingHom.id_apply, heN, e.apply_symm_apply] }
  have hπ₂ : Function.Surjective π₂ := fun y ↦ by
    obtain ⟨w, hw⟩ := hπ₁ (eN.symm y)
    refine ⟨e ∘ w, ?_⟩
    simp only [π₂, LinearMap.coe_mk, AddHom.coe_mk]
    rw [show e.symm ∘ (e ∘ w) = w from funext fun j ↦ e.symm_apply_apply (w j), hw,
      eN.apply_symm_apply]
  have hker_iff (v : Fin r → R₂) : v ∈ LinearMap.ker π₂ ↔ (e.symm ∘ v) ∈ LinearMap.ker π₁ := by
    simp [π₂]
  have hmin₂ : LinearMap.ker π₂ ≤ maximalIdeal R₂ • (⊤ : Submodule R₂ (Fin r → R₂)) := by
    intro v hv
    rw [Ideal.mem_smul_top_pi_iff]
    simp only [smul_eq_mul, Ideal.mul_top]
    have hcoord₁ : ∀ j, e.symm (v j) ∈ maximalIdeal R₁ := fun j ↦ by
      simpa only [smul_eq_mul, Ideal.mul_top, Function.comp_apply] using
        (Ideal.mem_smul_top_pi_iff _).mp (hmin₁ ((hker_iff v).mp hv)) j
    intro j
    have hj := hcoord₁ j
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hj ⊢
    exact fun hu ↦ hj (e.symm.toRingHom.isUnit_map hu)
  have hrange₂ : LinearMap.range (Matrix.toLin' A₂) = LinearMap.ker π₂ := by
    ext v
    rw [hker_iff, ← hrange₁, LinearMap.mem_range, LinearMap.mem_range]
    have hmulVec (w : Fin r → R₂) :
        e.symm ∘ Matrix.toLin' A₂ w = Matrix.toLin' A₁ (e.symm ∘ w) := by
      funext j
      simpa [A₂, Matrix.map_map, Function.comp_def, e.symm_apply_apply] using
        RingHom.map_mulVec e.symm.toRingHom A₂ w j
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨e.symm ∘ w, (hmulVec w).symm⟩
    · rintro ⟨w, hw⟩
      refine ⟨e ∘ w, funext fun j ↦ e.symm.injective ?_⟩
      have h1 := congrFun (hmulVec (e ∘ w)) j
      have hid : e.symm ∘ (e ∘ w) = w := funext fun k ↦ e.symm_apply_apply (w k)
      simpa only [Function.comp_apply, hid, hw] using h1
  exact ⟨A₂, π₂, hπ₂, hmin₂, hrange₂⟩

/-- **Assembling a uniform `QuadraticPresentation` across a complete orthogonal family of
idempotents.** Each component presentation is padded by an identity block to the maximum size
(at least `1`), preserving its relation determinant. -/
theorem IsQuadraticallyPresented.of_completeOrthogonalIdempotents {ι : Type*} [Fintype ι]
    {e : ι → R} (he : CompleteOrthogonalIdempotents e)
    (hcomp : ∀ i, IsQuadraticallyPresented (R ⧸ Ideal.span {1 - e i})
      ((R ⧸ Ideal.span {1 - e i}) ⊗[R] M)) :
    IsQuadraticallyPresented R M := by
  classical
  let P (i : ι) := (hcomp i).nonempty.some
  let m : ℕ := max 1 (Finset.univ.sup fun i ↦ (P i).size)
  let Q (i : ι) := (P i).pad (m := m)
    ((Finset.le_sup (f := fun i ↦ (P i).size) (Finset.mem_univ i)).trans (le_max_right 1 _))
  obtain ⟨_, _, Φ, g, hg_surj, hrange_eq, _⟩ :=
    exists_projectiveSquarePresentation_of_completeOrthogonalIdempotents (M := M) he (fun _ ↦ m)
      (fun i ↦ (Q i).rel) (fun i ↦ (Q i).gen) (fun i ↦ (Q i).gen_surjective)
      (fun i ↦ (Q i).range_rel_eq_ker)
  let eFree := freeEquivPiOfCompleteOrthogonalIdempotents he m
  refine IsQuadraticallyPresented.of_exact (Pi.basisFun R (Fin m)) (Pi.basisFun R (Fin m))
    (f := eFree.symm.toLinearMap ∘ₗ Φ ∘ₗ eFree.toLinearMap) (π := g ∘ₗ eFree.toLinearMap)
    (LinearMap.exact_iff.2 ?_) (hg_surj.comp eFree.surjective)
  ext x
  simp only [LinearMap.mem_ker, LinearMap.mem_range, LinearMap.comp_apply, LinearEquiv.coe_coe]
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := hrange_eq.symm ▸ (LinearMap.mem_ker.mpr hx : eFree x ∈ LinearMap.ker g)
    exact ⟨eFree.symm y, by simp [hy]⟩
  · rintro ⟨y, rfl⟩
    rw [eFree.apply_symm_apply]
    exact LinearMap.mem_ker.mp (hrange_eq ▸ LinearMap.mem_range_self Φ (eFree y))

/-- Componentwise assembly of quadratic presentations over a finite product of rings. -/
theorem IsQuadraticallyPresented.of_pi {ι : Type*} [Finite ι] {S : ι → Type*}
    [∀ i, CommRing (S i)] {N : Type*} [AddCommGroup N] [Module (∀ i, S i) N]
    (hcomp : ∀ i, letI : Algebra (∀ j, S j) (S i) := (Pi.evalRingHom S i).toAlgebra
      IsQuadraticallyPresented (S i) (S i ⊗[∀ j, S j] N)) :
    IsQuadraticallyPresented (∀ i, S i) N := by
  classical
  let := Fintype.ofFinite ι
  refine IsQuadraticallyPresented.of_completeOrthogonalIdempotents
    (CompleteOrthogonalIdempotents.single S) fun i ↦ ?_
  let : Algebra (∀ j, S j) (S i) := (Pi.evalRingHom S i).toAlgebra
  let Rᵢ := (∀ j, S j) ⧸ Ideal.span {1 - Pi.single i (1 : S i)}
  let eqRing : Rᵢ ≃+* S i :=
    (Ideal.quotEquivOfEq (RingHom.ker_evalRingHom S i).symm).trans
      (RingHom.quotientKerEquivOfSurjective
        (show Function.Surjective (Pi.evalRingHom S i) from Function.surjective_eval i))
  let : Algebra (S i) Rᵢ := eqRing.symm.toRingHom.toAlgebra
  have : IsScalarTower (∀ j, S j) (S i) Rᵢ :=
    IsScalarTower.of_algebraMap_eq fun x ↦ eqRing.injective <| by
      dsimp only [Rᵢ]
      rw [RingHom.algebraMap_toAlgebra, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
        eqRing.apply_symm_apply, RingHom.algebraMap_toAlgebra, Ideal.Quotient.algebraMap_eq]
      dsimp only [eqRing]
      rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
        RingHom.quotientKerEquivOfSurjective_apply_mk]
  exact ((hcomp i).baseChange Rᵢ).of_equiv
    (AlgebraTensorModule.cancelBaseChange (∀ j, S j) (S i) Rᵢ Rᵢ N)

end SemilocalAssembly

end TauCeti
