module

public import TauCeti.Algebra.Module.Submodule.OrbitRelQuotient
public import TauCeti.Algebra.Module.ZLattice.Family.AffineAction
public import TauCeti.Algebra.Module.ZLattice.Family.Fiber
public import TauCeti.RepresentationTheory.Cyclic.Affine

/-!
# Freeness of affine actions on families of tori at base stabilizers

Let a group `Γ` act on `Y`, and let it act on the family of tori `(Y × E)/Λ → Y` of a period
family `P` by the affine action `g • [y, v] = R g y v +ᵥ b g y`
(`TauCeti.torusFamilyAffineMulAction`). An element `g` fixing a point `y` of the base carries the
fibre over `y`, the torus `T_y = E / LinearMap.range (P y)`
(`TauCeti.torusFamilyFiberMap`), to itself, and acts on it by an affine automorphism of the
additive group `T_y`:

* its linear part `TauCeti.torusFamilyFiberLinearPart` is the automorphism `[v] ↦ [R g y v]` of
  `T_y`, well defined because `R g y` carries the periods at `y` onto themselves;
* its translation part `TauCeti.torusFamilyFiberTranslationPart` is the point `b g y` of the fibre
  over `g • y = y`, read in `T_y`.

So `g` acts on `T_y` by `AddEquiv.affineEquiv A t` (`TauCeti.torusFamilyAffineMap_fiberMap`), and
`g ^ k` by its `k`-th iterate `x ↦ A^k x + N_{A,k}(t)`, where `N_{A,k}(t) = ∑ i < k, A^i t` is the
partial norm `AddEquiv.partialNorm`. The fixed-point criterion for cyclic affine automorphisms then
says that `g ^ k` fixes a point of the fibre over `y` exactly when `N_{A,k}(t)` lies in the image
of `1 - A^k` (`TauCeti.exists_pow_smul_torusFamilyFiberMap_eq_self_iff`), and a relation
`g ^ m = 1` forces `A^m = 1` and `N_{A,m}(t) = 0` on the fibre.

An element fixing a point of the family fixes its base point, so the affine action on the total
space is free exactly when, at every point `y` of the base, every nonidentity element of the
stabilizer of `y` acts on `T_y` without fixed points, that is, when its translation part does not
lie in the image of `1 - A` (`TauCeti.isCancelSMul_torusFamilyAffineMulAction_iff`). Freeness on
the base is not required: over a fixed point of the base, a translation part outside the image of
`1 - A` removes the fixed points of `g` from the fibre. When every stabilizer is generated by an
element `γ y` of finite order `m`, the criterion becomes the cyclic one: for every `0 < k < m` the
partial norm `N_{A,k}(t)` of the translation part of `γ y` does not lie in the image of `1 - A^k`
(`TauCeti.isCancelSMul_torusFamilyAffineMulAction_iff_of_stabilizer_le_zpowers`). For composite
`m` every such `k` must be checked.

## Main definitions

* `TauCeti.torusFamilyFiberLinearPart`: the linear part on the fibre over a fixed point.
* `TauCeti.torusFamilyFiberTranslationPart`: the translation part on the fibre over a fixed point.

## Main results

* `TauCeti.torusFamilyAffineMap_fiberMap`,
  `TauCeti.pow_smul_torusFamilyFiberMap`: over a fixed point `y` of `g`, the element `g` acts on
  `T_y` by the affine automorphism with these linear and translation parts, and `g ^ k` by its
  `k`-th iterate.
* `TauCeti.exists_pow_smul_torusFamilyFiberMap_eq_self_iff`: `g ^ k` fixes a point of `T_y`
  exactly when the `k`-th partial norm of the translation part lies in the image of `1 - A^k`.
* `TauCeti.affineEquiv_torusFamilyFiber_iterate_eq_id_of_pow_eq_one`: if `g ^ m = 1`, the affine
  automorphism of `T_y` has `m`-th iterate the identity, so its linear part has period dividing
  `m` and its `m`-th partial norm vanishes.
* `TauCeti.isCancelSMul_torusFamilyAffineMulAction_iff`: the affine action on the total space is
  free exactly when no nonidentity element of a base stabilizer has a fixed point on the fibre.
* `TauCeti.isCancelSMul_torusFamilyAffineMulAction_iff_of_stabilizer_le_zpowers`: the same
  criterion for cyclic stabilizers of finite order, checked on every nonidentity power.

## References

* Christina Birkenhake and Herbert Lange, *Complex Abelian Varieties*, second edition,
  Grundlehren der mathematischen Wissenschaften 302, Springer, 2004, Chapter 8 (families of
  complex tori given by period matrices, and the actions of discrete groups on them).
* W. P. Barth, K. Hulek, C. A. M. Peters, A. Van de Ven, *Compact Complex Surfaces*, second
  edition, Springer (2004), Chapter V, section *Logarithmic transformations*, for the cyclic
  affine actions on tori over a fixed point of the base.
-/

public section

namespace TauCeti

variable {Y Λ E Γ : Type*} [AddCommGroup Λ] [AddCommGroup E] [Group Γ] [MulAction Γ Y]
  (R : Γ → Y → E →+ E)
  (hone : ∀ (y : Y) (v : E), R 1 y v = v)
  (hmul : ∀ (g h : Γ) (y : Y) (v : E), R (g * h) y v = R g (h • y) (R h y v))
  (P : Y → Λ →ₗ[ℤ] E) (ρ : Representation ℤ Γ Λ)
  (hP : ∀ (g : Γ) (y : Y) (l : Λ), P (g • y) (ρ g l) = R g y (P y l))

/-! ### The affine automorphism of a fibre over a fixed point -/

include hP in
/-- Over a fixed point `y` of `g`, the linear part `R g y` carries the periods at `y` into
themselves. -/
private theorem range_le_comap_linearCocycle {g : Γ} {y : Y} (hy : g • y = y) :
    LinearMap.range (P y) ≤ (LinearMap.range (P y)).comap (R g y).toIntLinearMap := by
  rintro _ ⟨l, rfl⟩
  exact ⟨ρ g l, by simpa [hy] using hP g y l⟩

/-- **The linear part on a fibre over a fixed point.** If `g • y = y`, the additive automorphism
`[v] ↦ [R g y v]` of the torus `E / LinearMap.range (P y)`. It is well defined because `R g y`
carries the periods at `y` into themselves, and its inverse is induced by `R g⁻¹ y`. -/
def torusFamilyFiberLinearPart {g : Γ} {y : Y} (hy : g • y = y) :
    AddAction.orbitRel.Quotient (LinearMap.range (P y)) E ≃+
      AddAction.orbitRel.Quotient (LinearMap.range (P y)) E where
  toFun := (LinearMap.range (P y)).orbitRelQuotientMap _ (R g y).toIntLinearMap
    (range_le_comap_linearCocycle R P ρ hP hy)
  invFun := (LinearMap.range (P y)).orbitRelQuotientMap _ (R g⁻¹ y).toIntLinearMap
    (range_le_comap_linearCocycle R P ρ hP (inv_smul_eq_iff.2 hy.symm))
  left_inv x := by
    induction x using Quotient.inductionOn with
    | h v =>
      -- `R g⁻¹ y` inverts `R g y`, by the cocycle laws applied to `g⁻¹` at `g⁻¹ • y = y`.
      have h := linearCocycle_apply_inv_apply R hone hmul g⁻¹ y v
      rw [inv_inv, inv_smul_eq_iff.2 hy.symm] at h
      simp [h]
  right_inv x := by
    induction x using Quotient.inductionOn with
    | h v =>
      have h := linearCocycle_apply_inv_apply R hone hmul g y v
      rw [hy] at h
      simp [h]
  map_add' := map_add _

/-- The linear part on the fibre over a fixed point sends the class of `v` to the class of
`R g y v`. -/
@[simp]
theorem torusFamilyFiberLinearPart_mk {g : Γ} {y : Y} (hy : g • y = y) (v : E) :
    torusFamilyFiberLinearPart R hone hmul P ρ hP hy (Quotient.mk _ v) =
      Quotient.mk _ (R g y v) :=
  (LinearMap.range (P y)).orbitRelQuotientMap_mk _ _ _ v

/-- The inverse of the linear part on the fibre over a fixed point sends the class of `v` to the
class of `R g⁻¹ y v`. -/
@[simp]
theorem torusFamilyFiberLinearPart_symm_mk {g : Γ} {y : Y} (hy : g • y = y) (v : E) :
    (torusFamilyFiberLinearPart R hone hmul P ρ hP hy).symm (Quotient.mk _ v) =
      Quotient.mk _ (R g⁻¹ y v) :=
  (LinearMap.range (P y)).orbitRelQuotientMap_mk _ _ _ v

variable (b : Γ → Y → letI := periodAddAction P; AddAction.orbitRel.Quotient Λ (Y × E))
  (hb : ∀ (g : Γ) (y : Y), torusFamilyProjection P (b g y) = g • y)

include hb in
/-- The value `b g y` of the translation section lies in the fibre over `y` when `g • y = y`. -/
private theorem mem_range_torusFamilyFiberMap_translation {g : Γ} {y : Y} (hy : g • y = y) :
    b g y ∈ Set.range (torusFamilyFiberMap P y) := by
  rw [range_torusFamilyFiberMap]
  exact (hb g y).trans hy

/-- **The translation part on a fibre over a fixed point.** If `g • y = y`, the point `b g y` of
the family lies over `y`; this is that point of the torus `E / LinearMap.range (P y)`, the unique
point sent to `b g y` by the inclusion `TauCeti.torusFamilyFiberMap` of the fibre. -/
noncomputable def torusFamilyFiberTranslationPart {g : Γ} {y : Y} (hy : g • y = y) :
    AddAction.orbitRel.Quotient (LinearMap.range (P y)) E :=
  (Equiv.ofInjective _ (torusFamilyFiberMap_injective P y)).symm
    ⟨b g y, mem_range_torusFamilyFiberMap_translation P b hb hy⟩

/-- The inclusion of the fibre sends the translation part to the value `b g y` of the translation
section. -/
@[simp]
theorem torusFamilyFiberMap_fiberTranslationPart {g : Γ} {y : Y} (hy : g • y = y) :
    torusFamilyFiberMap P y (torusFamilyFiberTranslationPart P b hb hy) = b g y :=
  Equiv.apply_ofInjective_symm _ _

/-- If `β` represents `b g y` over a fixed point `y` of `g`, the translation part on the fibre is
the class of `β`. -/
theorem torusFamilyFiberTranslationPart_eq_mk {g : Γ} {y : Y} (hy : g • y = y) {β : E}
    (hβ : b g y = Quotient.mk _ (y, β)) :
    torusFamilyFiberTranslationPart P b hb hy = Quotient.mk _ β :=
  torusFamilyFiberMap_injective P y <| by
    rw [torusFamilyFiberMap_fiberTranslationPart, torusFamilyFiberMap_mk, hβ]

/-- **The action on a fibre over a fixed point is affine.** If `g • y = y`, the affine map of `g`
acts on the fibre `E / LinearMap.range (P y)` by `AddEquiv.affineEquiv A t`, with linear part
`A = TauCeti.torusFamilyFiberLinearPart` and translation part
`t = TauCeti.torusFamilyFiberTranslationPart`. -/
theorem torusFamilyAffineMap_fiberMap {g : Γ} {y : Y} (hy : g • y = y)
    (z : AddAction.orbitRel.Quotient (LinearMap.range (P y)) E) :
    torusFamilyAffineMap R P ρ hP b hb g (torusFamilyFiberMap P y z) =
      torusFamilyFiberMap P y (AddEquiv.affineEquiv
        (torusFamilyFiberLinearPart R hone hmul P ρ hP hy)
        (torusFamilyFiberTranslationPart P b hb hy) z) := by
  obtain ⟨β, hβ⟩ := Quotient.exists_rep (torusFamilyFiberTranslationPart P b hb hy)
  have hbβ : b g y = Quotient.mk _ (g • y, β) := by
    rw [hy, ← torusFamilyFiberMap_fiberTranslationPart P b hb hy, ← hβ, torusFamilyFiberMap_mk]
  induction z using Quotient.inductionOn with
  | h v =>
    rw [torusFamilyFiberMap_mk, torusFamilyAffineMap_mk_of_eq R P ρ hP b hb hbβ,
      AddEquiv.affineEquiv_apply, torusFamilyFiberLinearPart_mk, ← hβ,
      ← Submodule.orbitRelQuotient_mk_add, torusFamilyFiberMap_mk, hy]

variable (hbone : ∀ y : Y, b 1 y = Quotient.mk _ (y, 0))
  (hbmul : ∀ (g h : Γ) (y : Y), b (g * h) y = torusFamilyAffineMap R P ρ hP b hb g (b h y))

/-- **The iterates on a fibre over a fixed point.** If `g • y = y`, then `g ^ k` acts on the fibre
`E / LinearMap.range (P y)` by the `k`-th iterate of the affine automorphism `x ↦ A x + t` of
`TauCeti.torusFamilyAffineMap_fiberMap`, that is by `x ↦ A^k x + N_{A,k}(t)`
(`AddEquiv.affineEquiv_iterate_apply`). -/
theorem pow_smul_torusFamilyFiberMap {g : Γ} {y : Y} (hy : g • y = y) (k : ℕ)
    (z : AddAction.orbitRel.Quotient (LinearMap.range (P y)) E) :
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    g ^ k • torusFamilyFiberMap P y z =
      torusFamilyFiberMap P y ((⇑(AddEquiv.affineEquiv
        (torusFamilyFiberLinearPart R hone hmul P ρ hP hy)
        (torusFamilyFiberTranslationPart P b hb hy)))^[k] z) := by
  let _ := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', mul_smul, ih, Function.iterate_succ_apply',
      torusFamilyAffineMulAction_smul, torusFamilyAffineMap_fiberMap]

/-- **Fixed points of a power on a fibre over a fixed point.** If `g • y = y`, the point `z` of the
fibre over `y` is fixed by `g ^ k` exactly when `z - A^k z` is the `k`-th partial norm of the
translation part `t`. -/
theorem pow_smul_torusFamilyFiberMap_eq_self_iff {g : Γ} {y : Y} (hy : g • y = y) (k : ℕ)
    (z : AddAction.orbitRel.Quotient (LinearMap.range (P y)) E) :
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    g ^ k • torusFamilyFiberMap P y z = torusFamilyFiberMap P y z ↔
      z - (⇑(torusFamilyFiberLinearPart R hone hmul P ρ hP hy))^[k] z =
        AddEquiv.partialNorm (torusFamilyFiberLinearPart R hone hmul P ρ hP hy) k
          (torusFamilyFiberTranslationPart P b hb hy) := by
  rw [pow_smul_torusFamilyFiberMap R hone hmul P ρ hP b hb hbone hbmul hy,
    (torusFamilyFiberMap_injective P y).eq_iff, AddEquiv.affineEquiv_iterate_apply_eq_self_iff]

/-- **The fixed-point criterion on a fibre over a fixed point.** If `g • y = y`, then `g ^ k` fixes
a point of the fibre over `y` exactly when the `k`-th partial norm of the translation part lies in
the image of `1 - A^k`, where `A` is the linear part. -/
theorem exists_pow_smul_torusFamilyFiberMap_eq_self_iff {g : Γ} {y : Y} (hy : g • y = y)
    (k : ℕ) :
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    (∃ z, g ^ k • torusFamilyFiberMap P y z = torusFamilyFiberMap P y z) ↔
      ∃ c, c - (⇑(torusFamilyFiberLinearPart R hone hmul P ρ hP hy))^[k] c =
        AddEquiv.partialNorm (torusFamilyFiberLinearPart R hone hmul P ρ hP hy) k
          (torusFamilyFiberTranslationPart P b hb hy) :=
  exists_congr fun z ↦ pow_smul_torusFamilyFiberMap_eq_self_iff R hone hmul P ρ hP b hb hbone hbmul
    hy k z

include hbone hbmul in
/-- **Periodicity on a fibre over a fixed point.** If `g • y = y` and `g ^ m = 1`, the affine
automorphism by which `g` acts on the fibre over `y` has `m`-th iterate the identity. By
`AddEquiv.affineEquiv_iterate_eq_id_iff`, its linear part then has `m`-th iterate the identity and
the `m`-th partial norm of its translation part vanishes, which are the hypotheses of the action
`AddEquiv.affineAddAction` of `ZMod m` on the fibre. -/
theorem affineEquiv_torusFamilyFiber_iterate_eq_id_of_pow_eq_one {g : Γ} {y : Y}
    (hy : g • y = y) {m : ℕ} (hm : g ^ m = 1) :
    (⇑(AddEquiv.affineEquiv (torusFamilyFiberLinearPart R hone hmul P ρ hP hy)
      (torusFamilyFiberTranslationPart P b hb hy)))^[m] = id := by
  let _ := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
  funext z
  apply torusFamilyFiberMap_injective P y
  rw [← pow_smul_torusFamilyFiberMap R hone hmul P ρ hP b hb hbone hbmul hy, hm, one_smul, id]

/-! ### Freeness of the affine action -/

/-- The affine action is free exactly when every element fixing a point `y` of the base and a
point of the fibre over `y` is the identity. -/
private theorem isCancelSMul_torusFamilyAffineMulAction_iff_fiberMap :
    letI := periodAddAction P
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    IsCancelSMul Γ (AddAction.orbitRel.Quotient Λ (Y × E)) ↔
      ∀ (y : Y) (g : Γ), g • y = y → ∀ c, g • torusFamilyFiberMap P y c =
        torusFamilyFiberMap P y c → g = 1 := by
  let _ := periodAddAction P
  let _ := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
  rw [isCancelSMul_iff_eq_one_of_smul_eq]
  refine ⟨fun h y g _ c hc ↦ h g _ hc, fun h g x hx ↦ ?_⟩
  -- `g` fixes the base point of `x`, and `x` is a point of the fibre over it.
  obtain ⟨c, hc⟩ : x ∈ Set.range (torusFamilyFiberMap P (torusFamilyProjection P x)) := by
    rw [range_torusFamilyFiberMap, Set.mem_ofPred_eq]
  have hy := torusFamilyAffineMulAction_stabilizer_le R hone hmul P ρ hP b hb hbone hbmul x hx
  rw [← hc] at hx
  exact h _ g hy c hx

/-- **Freeness of the affine action at base stabilizers.** The affine action of `Γ` on the total
space of the family of tori is free exactly when, for every point `y` of the base and every
nonidentity `g` fixing `y`, the affine automorphism `x ↦ A x + t` by which `g` acts on the fibre
over `y` has no fixed point, that is, its translation part `t` does not lie in the image of
`1 - A`. No freeness of the action on the base is assumed. -/
theorem isCancelSMul_torusFamilyAffineMulAction_iff :
    letI := periodAddAction P
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    IsCancelSMul Γ (AddAction.orbitRel.Quotient Λ (Y × E)) ↔
      ∀ (y : Y) (g : Γ) (hy : g • y = y), g ≠ 1 →
        ∀ c, c - torusFamilyFiberLinearPart R hone hmul P ρ hP hy c ≠
          torusFamilyFiberTranslationPart P b hb hy := by
  let _ := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
  rw [isCancelSMul_torusFamilyAffineMulAction_iff_fiberMap]
  refine forall₂_congr fun y g ↦ ⟨fun h hy hg c hc ↦ hg (h hy c ?_), fun h hy c hc ↦ ?_⟩
  · simpa using (pow_smul_torusFamilyFiberMap_eq_self_iff R hone hmul P ρ hP b hb hbone hbmul
      hy 1 c).2 (by simpa using hc)
  · by_contra hg
    exact h hy hg c (by simpa using (pow_smul_torusFamilyFiberMap_eq_self_iff R hone hmul P ρ hP
      b hb hbone hbmul hy 1 c).1 (by simpa using hc))

/-- **Freeness at cyclic base stabilizers.** Suppose the stabilizer of each point `y` of the base
is generated by an element `γ y` of finite order. Then the affine action on the total space of the
family of tori is free exactly when, at every `y` and for every `0 < k < orderOf (γ y)`, the
`k`-th partial norm `N_{A,k}(t)` of the translation part `t` of `γ y` on the fibre over `y` does
not lie in the image of `1 - A^k`, where `A` is the linear part. For composite orders every such
`k` must be checked, not only `k = 1`. -/
theorem isCancelSMul_torusFamilyAffineMulAction_iff_of_stabilizer_le_zpowers (γ : Y → Γ)
    (hγ : ∀ y, γ y • y = y) (hstab : ∀ y, MulAction.stabilizer Γ y ≤ Subgroup.zpowers (γ y))
    (hfin : ∀ y, IsOfFinOrder (γ y)) :
    letI := periodAddAction P
    letI := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
    IsCancelSMul Γ (AddAction.orbitRel.Quotient Λ (Y × E)) ↔
      ∀ (y : Y) (k : ℕ), 0 < k → k < orderOf (γ y) →
        ∀ c, c - (⇑(torusFamilyFiberLinearPart R hone hmul P ρ hP (hγ y)))^[k] c ≠
          AddEquiv.partialNorm (torusFamilyFiberLinearPart R hone hmul P ρ hP (hγ y)) k
            (torusFamilyFiberTranslationPart P b hb (hγ y)) := by
  classical
  let _ := torusFamilyAffineMulAction R hone hmul P ρ hP b hb hbone hbmul
  rw [isCancelSMul_torusFamilyAffineMulAction_iff_fiberMap]
  refine forall_congr' fun y ↦ ⟨fun h k hk hkm c hc ↦ pow_ne_one_of_lt_orderOf hk.ne' hkm
    (h _ ((MulAction.mem_stabilizer_iff.1 (Subgroup.pow_mem _ (hγ y) k))) c
      ((pow_smul_torusFamilyFiberMap_eq_self_iff R hone hmul P ρ hP b hb hbone hbmul
        (hγ y) k c).2 hc)), fun h g hg c hc ↦ ?_⟩
  -- `g` fixes `y`, so it is a power `γ y ^ k` with `k < orderOf (γ y)`.
  obtain ⟨k, hkm, rfl⟩ := Finset.mem_image.1
    ((hfin y).mem_zpowers_iff_mem_range_orderOf.1 (hstab y hg))
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · exact pow_zero _
  · exact absurd ((pow_smul_torusFamilyFiberMap_eq_self_iff R hone hmul P ρ hP b hb hbone hbmul
      (hγ y) k c).1 hc) (h k hk (Finset.mem_range.1 hkm) c)

end TauCeti
