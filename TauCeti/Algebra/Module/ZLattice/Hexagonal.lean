module

public import TauCeti.Algebra.Module.ZLattice.Covolume
public import TauCeti.Analysis.Fourier.LaplacianSymbol

/-!
# The hexagonal lattice and its reciprocal vectors

The lattice generated by `(1, 0)` and `(1/2, √3/2)` has covolume `√3/2`. Its reciprocal
vectors are parametrized by integers `m, n` as `(m, (2n - m)/√3)`. Their least nonzero
squared norm is `4/3`, giving the least value `16π²/3` of the negative Laplacian symbol
on the nonzero frequencies of the hexagonal flat torus.
-/

public section

noncomputable section

open Module
open scoped InnerProductSpace Real

local notation "ℝ²" => EuclideanSpace ℝ (Fin 2)

namespace TauCeti.HexagonalLattice

private def coordinates : ℝ² ≃ₗ[ℝ] (Fin 2 → ℝ) where
  toFun x := ![x 0 - x 1 / √3, 2 * x 1 / √3]
  invFun c := !₂[c 0 + c 1 / 2, √3 / 2 * c 1]
  left_inv x := by
    apply PiLp.ext
    intro i
    have h3 : √(3 : ℝ) ≠ 0 := by positivity
    fin_cases i
    · dsimp
      field_simp [h3]
      ring
    · simp [h3]
  right_inv c := by
    funext i
    have h3 : √(3 : ℝ) ≠ 0 := by positivity
    fin_cases i
    · dsimp
      field_simp [h3]
      ring
    · dsimp
      field_simp [h3]
  map_add' x y := by
    funext i
    fin_cases i <;> simp <;> ring
  map_smul' c x := by
    funext i
    fin_cases i <;> simp <;> ring

/-- The real basis with vectors `(1, 0)` and `(1/2, √3/2)`. -/
def basis : Basis (Fin 2) ℝ ℝ² := Basis.ofEquivFun coordinates

/-- The first generator of the hexagonal lattice. -/
@[simp] theorem basis_zero : basis 0 = !₂[1, 0] := by
  rw [basis, Basis.coe_ofEquivFun]
  apply PiLp.ext
  intro i
  fin_cases i <;> norm_num [coordinates, Pi.single_apply]

/-- The second generator of the hexagonal lattice. -/
@[simp] theorem basis_one : basis 1 = !₂[1 / 2, √3 / 2] := by
  rw [basis, Basis.coe_ofEquivFun]
  apply PiLp.ext
  intro i
  fin_cases i <;> norm_num [coordinates, Pi.single_apply]

/-- The integer span of the two basis vectors of the hexagonal lattice. -/
def lattice : Submodule ℤ ℝ² := Submodule.span ℤ (Set.range basis)

instance instDiscreteTopologyLattice : DiscreteTopology lattice := by
  rw [lattice]
  infer_instance

instance instIsZLatticeLattice : IsZLattice ℝ lattice :=
  inferInstanceAs (IsZLattice ℝ (Submodule.span ℤ (Set.range basis)))

/-- Membership in the hexagonal lattice is an integer combination of its two generators. -/
theorem mem_lattice_iff {x : ℝ²} :
    x ∈ lattice ↔ ∃ m n : ℤ, x = m • basis 0 + n • basis 1 := by
  rw [lattice, Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨c 0, c 1, by rw [Fin.sum_univ_two]⟩
  · rintro ⟨m, n, rfl⟩
    exact ⟨![m, n], by simp only [Fin.sum_univ_two, Matrix.cons_val_zero,
      Matrix.cons_val_one]⟩

/-- The Euclidean covolume of the hexagonal lattice is `√3/2`. -/
theorem covolume_lattice : ZLattice.covolume lattice = √3 / 2 := by
  have hsq : ZLattice.covolume lattice ^ 2 = 3 / 4 := by
    rw [lattice, ZLattice.covolume_span_sq_eq_det_gram, Matrix.det_fin_two]
    simp only [Matrix.gram_apply, basis_zero, basis_one, EuclideanSpace.inner_eq_star_dotProduct,
      Matrix.vec2_dotProduct, star_trivial,
      Matrix.cons_val_zero, Matrix.cons_val_one]
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
  nlinarith [ZLattice.covolume_pos lattice, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3),
    Real.sqrt_nonneg 3]

/-- The real basis reciprocal to `basis` under the Euclidean inner product. -/
def dualBasis : Basis (Fin 2) ℝ ℝ² :=
  LinearMap.BilinForm.dualBasis (innerₗ ℝ²) nondegenerate_inner basis

/-- The reciprocal vector whose pairings with the two lattice generators are `m` and `n`. -/
def dualVector (m n : ℤ) : ℝ² := !₂[(m : ℝ), (2 * (n : ℝ) - m) / √3]

/-- The first coordinate of a reciprocal vector. -/
@[simp] theorem dualVector_zero (m n : ℤ) : dualVector m n 0 = (m : ℝ) := (rfl)

/-- The second coordinate of a reciprocal vector. -/
@[simp] theorem dualVector_one (m n : ℤ) :
    dualVector m n 1 = (2 * (n : ℝ) - m) / √3 := (rfl)

/-- The first reciprocal basis vector. -/
@[simp] theorem dualBasis_zero : dualBasis 0 = dualVector 1 0 := by
  apply dualBasis.ext_elem
  intro j
  simp only [Basis.repr_self, dualBasis, LinearMap.BilinForm.dualBasis_repr_apply,
    innerₗ_apply_apply, Finsupp.single_apply]
  fin_cases j <;>
    norm_num [dualVector, EuclideanSpace.inner_eq_star_dotProduct, Matrix.vec2_dotProduct]

/-- The second reciprocal basis vector. -/
@[simp] theorem dualBasis_one : dualBasis 1 = dualVector 0 1 := by
  apply dualBasis.ext_elem
  intro j
  simp only [Basis.repr_self, dualBasis, LinearMap.BilinForm.dualBasis_repr_apply,
    innerₗ_apply_apply, Finsupp.single_apply]
  fin_cases j <;>
    norm_num [dualVector, EuclideanSpace.inner_eq_star_dotProduct, Matrix.vec2_dotProduct]

private theorem dualVector_eq_zsmul (m n : ℤ) :
    dualVector m n = m • dualBasis 0 + n • dualBasis 1 := by
  apply PiLp.ext
  intro i
  fin_cases i
  · simp [dualVector, ← Int.cast_smul_eq_zsmul ℝ, smul_eq_mul]
  · simp [dualVector, ← Int.cast_smul_eq_zsmul ℝ, smul_eq_mul]
    ring

/-- The reciprocal lattice consists exactly of the vectors `(m, (2n - m)/√3)` for integers
`m` and `n`. -/
theorem mem_dual_lattice_iff {x : ℝ²} :
    x ∈ ZLattice.dual lattice ↔ ∃ m n : ℤ, x = dualVector m n := by
  rw [lattice, ZLattice.dual_span_basis, ← dualBasis,
    Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨c 0, c 1, by rw [Fin.sum_univ_two, dualVector_eq_zsmul]⟩
  · rintro ⟨m, n, rfl⟩
    exact ⟨![m, n], by simp only [Fin.sum_univ_two, dualVector_eq_zsmul, Matrix.cons_val_zero,
      Matrix.cons_val_one]⟩

/-- Every integer-indexed reciprocal vector belongs to the reciprocal lattice. -/
theorem dualVector_mem_dual (m n : ℤ) : dualVector m n ∈ ZLattice.dual lattice :=
  mem_dual_lattice_iff.mpr ⟨m, n, rfl⟩

/-- The norm form of the reciprocal lattice in the integer coordinates `m, n`. -/
theorem norm_sq_dualVector (m n : ℤ) :
    ‖dualVector m n‖ ^ 2 = (4 / 3 : ℝ) * ((m : ℝ) ^ 2 - (m : ℝ) * n + (n : ℝ) ^ 2) := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two, dualVector]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
  ring

/-- Every nonzero reciprocal vector of the hexagonal lattice has squared norm at least `4/3`. -/
theorem four_div_three_le_norm_sq {x : ℝ²} (hx : x ∈ ZLattice.dual lattice) (hx₀ : x ≠ 0) :
    4 / 3 ≤ ‖x‖ ^ 2 := by
  obtain ⟨m, n, rfl⟩ := mem_dual_lattice_iff.mp hx
  have hpos := sq_pos_of_pos (norm_pos_iff.mpr hx₀)
  rw [norm_sq_dualVector] at hpos
  have hq : 0 < m ^ 2 - m * n + n ^ 2 := by
    exact_mod_cast (pos_of_mul_pos_right hpos (by norm_num : (0 : ℝ) ≤ 4 / 3))
  have hq' : (1 : ℝ) ≤ (m : ℝ) ^ 2 - (m : ℝ) * n + (n : ℝ) ^ 2 := by
    exact_mod_cast (show 1 ≤ m ^ 2 - m * n + n ^ 2 by omega)
  rw [norm_sq_dualVector]
  linarith

/-- The least squared norm of a nonzero vector of the reciprocal lattice is `4/3`. -/
theorem isLeast_norm_sq_dual :
    IsLeast ((fun x : ℝ² ↦ ‖x‖ ^ 2) '' {x | x ∈ ZLattice.dual lattice ∧ x ≠ 0}) (4 / 3) := by
  have hnorm : ‖dualVector 0 1‖ ^ 2 = 4 / 3 := by norm_num [norm_sq_dualVector]
  refine ⟨⟨dualVector 0 1, ⟨mem_dual_lattice_iff.mpr ⟨0, 1, rfl⟩, ?_⟩, hnorm⟩, ?_⟩
  · intro h
    rw [h, norm_zero] at hnorm
    norm_num at hnorm
  · rintro _ ⟨x, ⟨hx, hx₀⟩, rfl⟩
    exact four_div_three_le_norm_sq hx hx₀

/-- The least symbol of the negative Laplacian on nonzero reciprocal vectors is `16π²/3`. -/
theorem isLeast_neg_laplacianSymbol_dual :
    IsLeast ((fun x : ℝ² ↦ -laplacianSymbol x) '' {x | x ∈ ZLattice.dual lattice ∧ x ≠ 0})
      (16 * π ^ 2 / 3) := by
  have hmono : Monotone (fun t : ℝ ↦ (4 * π ^ 2) * t) :=
    fun _ _ h ↦ mul_le_mul_of_nonneg_left h (by positivity)
  simpa only [Set.image_image, laplacianSymbol_apply, neg_neg,
    show (4 * π ^ 2) * (4 / 3) = 16 * π ^ 2 / 3 by ring] using
    hmono.map_isLeast isLeast_norm_sq_dual

end TauCeti.HexagonalLattice
