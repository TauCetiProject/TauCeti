/-!
# Dense additive subgroups of finite-dimensional real spaces

An additive subgroup `H` of a finite-dimensional real normed space `E` is dense exactly when no
nonzero real linear functional takes only integer values on `H`
(`AddSubgroup.dense_iff_forall_dual_eq_zero`). This is the higher-dimensional analogue of the
dichotomy for subgroups of `ℝ` (`dense_addSubgroupClosure_pair_iff`), and the abstract form of
Kronecker's approximation theorem: for the subgroup of `ℝⁿ` generated by `ℤⁿ` and one vector `α`,
an integer-valued functional is an integer relation between `1, α₁, …, αₙ`.

The proof uses the structure of closed subgroups. A closed subgroup `G` containing no line
through the origin is discrete
(`AddSubgroup.discreteTopology_of_isClosed_of_forall_smul_mem`). In general, the vectors `v`
with `ℝ v ⊆ G` form a subspace `V ⊆ G`, and `G` is the sum of `V` and its trace on a
complement `W` of `V`, which is discrete. If `G ≠ E` spans `E`, that trace is a lattice in
`W ≠ 0`, and a coordinate functional of a lattice basis, composed with the projection onto `W`,
is integer-valued on `G` (`AddSubgroup.exists_dual_ne_zero_of_isClosed`).

## Main results

* `ZLattice.exists_dual_ne_zero`: a full lattice in a nonzero space admits a nonzero linear
  functional with integer values on it.
* `AddSubgroup.discreteTopology_of_isClosed_of_forall_smul_mem`: a closed subgroup containing
  no line through the origin is discrete.
* `AddSubgroup.exists_dual_ne_zero_of_isClosed`: a proper closed subgroup admits a nonzero linear
  functional with integer values on it.
* `AddSubgroup.dense_iff_forall_dual_eq_zero`: a subgroup is dense if and only if every linear
  functional with integer values on it vanishes.

## References

* N. Bourbaki, *General Topology*, Chapter VII, § 1, no. 2, Theorem 2 (closed subgroups of
  `ℝⁿ`) and § 1, no. 3, Proposition 7 (dense subgroups of `ℝⁿ`).
* G. H. Hardy and E. M. Wright, *An Introduction to the Theory of Numbers*, Chapter XXIII.
-/

public section

open Filter Topology Module Submodule

namespace AddSubgroup

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- A closed additive subgroup of a finite-dimensional real normed space that contains no line
through the origin is discrete. -/
theorem discreteTopology_of_isClosed_of_forall_smul_mem {G : AddSubgroup E}
    (hG : IsClosed (G : Set E))
    (hline : ∀ v : E, (∀ t : ℝ, t • v ∈ G) → v = 0) : DiscreteTopology G := by
  rw [discreteTopology_iff_isOpen_singleton_zero, Metric.isOpen_singleton_iff]
  by_contra! h
  -- Nonzero elements `g k` of norm `r k < 1 / (k + 1)`, with unit vectors `u k = g k / r k`.
  choose g hg hg0 using fun k : ℕ ↦ h (1 / (k + 1)) Nat.one_div_pos_of_nat
  set r : ℕ → ℝ := fun k ↦ ‖(g k : E)‖
  have hr : ∀ k, 0 < r k := fun k ↦ norm_pos_iff.2 fun h0 ↦ hg0 k (Subtype.ext h0)
  have hr0 : Tendsto r atTop (𝓝 0) :=
    squeeze_zero (fun k ↦ (hr k).le) (fun k ↦ by simpa [dist_zero_right] using (hg k).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  set u : ℕ → E := fun k ↦ (r k)⁻¹ • (g k : E)
  have hu : ∀ k, u k ∈ Metric.sphere (0 : E) 1 := fun k ↦ by
    simpa [u, r] using norm_smul_inv_norm (𝕜 := ℝ) fun h0 ↦ hg0 k (Subtype.ext h0)
  obtain ⟨a, ha, φ, hφ, hlim⟩ := tendsto_subseq_of_bounded Metric.isBounded_sphere hu
  rw [Metric.isClosed_sphere.closure_eq, mem_sphere_zero_iff_norm] at ha
  refine (norm_ne_zero_iff.1 (ha ▸ one_ne_zero)) (hline a fun t ↦ ?_)
  -- The multiples `⌊t / r k⌋ • g k ∈ G` lie within `r k` of `t • u k`, so they tend to `t • a`.
  have hclose : ∀ k, ‖(⌊t / r k⌋ : ℝ) • (g k : E) - t • u k‖ ≤ r k := fun k ↦ by
    have : (⌊t / r k⌋ : ℝ) • (g k : E) - t • u k = -(Int.fract (t / r k) • (g k : E)) := by
      simp only [u, smul_smul, Int.fract, ← sub_smul, ← neg_smul, div_eq_mul_inv]
      ring_nf
    rw [this, norm_neg, norm_smul, Real.norm_of_nonneg (Int.fract_nonneg _)]
    exact mul_le_of_le_one_left (hr k).le (Int.fract_lt_one _).le
  have hdiff : Tendsto (fun k ↦ (⌊t / r k⌋ : ℝ) • (g k : E) - t • u k) atTop (𝓝 0) :=
    squeeze_zero_norm hclose hr0
  have hmem : Tendsto (fun k ↦ (⌊t / r (φ k)⌋ : ℝ) • (g (φ k) : E)) atTop (𝓝 (t • a)) := by
    simpa using (hdiff.comp hφ.tendsto_atTop).add (hlim.const_smul t)
  refine hG.mem_of_tendsto hmem (Eventually.of_forall fun k ↦ ?_)
  rw [Int.cast_smul_eq_zsmul]
  exact G.zsmul_mem (g (φ k)).2 _

/-- A full lattice `L` in a nonzero finite-dimensional real normed space admits a nonzero real
linear functional taking integer values on `L`, for instance a coordinate functional of a
`ℤ`-basis of `L`. -/
theorem _root_.ZLattice.exists_dual_ne_zero [Nontrivial E] (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] : ∃ f : Dual ℝ E, f ≠ 0 ∧ ∀ x ∈ L, ∃ k : ℤ, f x = k := by
  let b := Free.chooseBasis ℤ L
  let bR := b.ofZLatticeBasis ℝ L
  obtain ⟨i⟩ := bR.index_nonempty
  refine ⟨bR.coord i, fun h ↦ ?_, fun x hx ↦ ⟨b.repr ⟨x, hx⟩ i, ?_⟩⟩
  · simpa using LinearMap.congr_fun h (bR i)
  · simp [bR, ← b.ofZLatticeBasis_repr_apply ℝ L]

/-- **Closed subgroups of a finite-dimensional real space.** A proper closed additive subgroup
`G` of a finite-dimensional real normed space admits a nonzero real linear functional taking
integer values on `G`. -/
theorem exists_dual_ne_zero_of_isClosed {G : AddSubgroup E} (hG : IsClosed (G : Set E))
    (hne : G ≠ ⊤) : ∃ f : Dual ℝ E, f ≠ 0 ∧ ∀ g ∈ G, ∃ k : ℤ, f g = k := by
  by_cases hspan : span ℝ (G : Set E) = ⊤
  swap
  · -- A functional vanishing on the span of `G` will do.
    obtain ⟨f, hf, hmap⟩ := exists_dual_map_eq_bot_of_lt_top (lt_top_iff_ne_top.2 hspan)
      inferInstance
    refine ⟨f, hf, fun g hg ↦ ⟨0, ?_⟩⟩
    have : f g ∈ (span ℝ (G : Set E)).map f := Submodule.mem_map_of_mem (subset_span hg)
    simpa [hmap] using this
  -- The subspace `V` of vectors whose whole line lies in `G`, and a complement `W`.
  let V : Submodule ℝ E :=
    { carrier := {v | ∀ t : ℝ, t • v ∈ G}
      add_mem' := fun hv hw t ↦ by simpa [smul_add] using G.add_mem (hv t) (hw t)
      zero_mem' := fun t ↦ by simp
      smul_mem' := fun c v hv t ↦ by simpa [smul_smul] using hv (t * c) }
  have hVG : ∀ v ∈ V, v ∈ G := fun v hv ↦ by simpa using hv 1
  obtain ⟨W, hVW⟩ := V.exists_isCompl
  let π := W.projectionOnto V hVW.symm
  have hπ : ∀ g ∈ G, (π g : E) ∈ G := fun g hg ↦ by
    have hV : g - π g ∈ V := by
      rw [← projectionOnto_apply_eq_zero_iff hVW.symm, map_sub,
        projectionOnto_apply_left hVW.symm, sub_self]
    simpa using G.sub_mem hg (hVG _ hV)
  -- The trace of `G` on `W` is a lattice in `W`.
  let L : Submodule ℤ W := G.toIntSubmodule.comap (W.subtype.restrictScalars ℤ)
  have hLmem : ∀ w : W, w ∈ L ↔ (w : E) ∈ G := fun _ ↦ by
    simp [L, ← SetLike.mem_coe, AddSubgroup.coe_toIntSubmodule]
  have : DiscreteTopology L := by
    have hL : IsClosed (L : Set W) := hG.preimage continuous_subtype_val
    -- `L` and `L.toAddSubgroup` have the same underlying subtype.
    refine discreteTopology_of_isClosed_of_forall_smul_mem (G := L.toAddSubgroup) hL fun w hw ↦ ?_
    have hwV : (w : E) ∈ V := fun t ↦ (hLmem _).1 (hw t)
    exact Subtype.ext ((Submodule.disjoint_def.1 hVW.disjoint) _ hwV w.2)
  have : IsZLattice ℝ L := by
    refine ⟨eq_top_iff.2 ?_⟩
    rw [← LinearMap.range_eq_top.2 (projectionOnto_surjective hVW.symm), LinearMap.range_eq_map,
      ← hspan, map_span]
    exact span_mono (Set.image_subset_iff.2 fun g hg ↦ (hLmem _).2 (hπ g hg))
  have : Nontrivial W := by
    refine Submodule.nontrivial_iff_ne_bot.2 fun hW ↦ hne (eq_top_iff.2 fun x _ ↦ hVG x ?_)
    have htop := hVW.sup_eq_top
    rw [hW, sup_bot_eq] at htop
    exact htop ▸ Submodule.mem_top
  -- A functional with integer values on the lattice, composed with the projection onto `W`.
  obtain ⟨f, hf, hfL⟩ := ZLattice.exists_dual_ne_zero L
  refine ⟨f.comp π, fun h ↦ hf (LinearMap.ext fun w ↦ ?_), fun g hg ↦ hfL _ (hπ g hg)⟩
  simpa [π, projectionOnto_apply_left] using LinearMap.congr_fun h w

/-- **Dense subgroups of a finite-dimensional real space.** An additive subgroup `H` of a
finite-dimensional real normed space is dense if and only if every real linear functional taking
integer values on `H` is zero. -/
theorem dense_iff_forall_dual_eq_zero {H : AddSubgroup E} :
    Dense (H : Set E) ↔ ∀ f : Dual ℝ E, (∀ h ∈ H, ∃ k : ℤ, f h = k) → f = 0 := by
  constructor
  · intro hd f hf
    -- By continuity `f` is integer-valued on the closure of `H`, which is everything.
    have hint : ∀ x, f x ∈ Set.range ((↑) : ℤ → ℝ) := fun x ↦
      Real.isClosed_range_intCast.closure_subset_iff.2
        (Set.image_subset_iff.2 fun h hh ↦ hf h hh |>.imp fun _ ↦ Eq.symm)
        (map_mem_closure (LinearMap.continuous_of_finiteDimensional f) (hd x)
          fun _ hh ↦ Set.mem_image_of_mem f hh)
    by_contra hf0
    obtain ⟨x, hx⟩ : ∃ x, f x ≠ 0 := by simpa [LinearMap.ext_iff] using hf0
    obtain ⟨k, hk⟩ := hint ((2 * f x)⁻¹ • x)
    have : (k : ℝ) = 1 / 2 := by rw [hk, map_smul, smul_eq_mul]; field_simp
    have h2 : (2 * k : ℝ) = 1 := by rw [this]; norm_num
    exact absurd (by exact_mod_cast h2 : 2 * k = 1) (by omega)
  · intro h
    rw [← dense_closure, ← H.topologicalClosure_coe]
    by_contra hd
    have hne : H.topologicalClosure ≠ ⊤ := fun htop ↦ hd (by simp [htop])
    obtain ⟨f, hf, hfG⟩ := exists_dual_ne_zero_of_isClosed H.isClosed_topologicalClosure hne
    exact hf (h f fun x hx ↦ hfG x (H.le_topologicalClosure hx))

end AddSubgroup
