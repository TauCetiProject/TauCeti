module

public import TauCeti.Analysis.SpecialFunctions.Complex.Circle.Basic

import Mathlib.Analysis.Fourier.FiniteAbelian.PontryaginDuality

/-!
# Character modules of abelian groups

The characters `CharacterModule M = M →+ AddCircle (1 : ℚ)` of an abelian group `M` separate its
points, and when `M` is finite its character module is finite with as many elements as `M`; when
`M` is infinite, so is its character module:

* `TauCeti.CharacterModule.zero_apply`: the zero character vanishes everywhere;
* `TauCeti.CharacterModule.eval_injective`: evaluation embeds `M` in its double character module;
* instances `Finite (CharacterModule M)` and `Finite (M →+ AddCircle (1 : ℚ))` for finite `M`;
* `TauCeti.natCard_characterModule`: `Nat.card (CharacterModule M) = Nat.card M` for every abelian
  group `M`; when `M` is infinite both sides are `0`.

Every element moreover admits a character with a prescribed value, the reciprocal of its additive
order (the junk value `0` for an element of infinite order, where the zero character works); for a
nonzero element of finite order this character detects it, taking a nonzero value:

* `TauCeti.CharacterModule.ofSpanSingleton_apply_self`: for `a` of finite order, Mathlib's
  canonical character of the cyclic subgroup generated by `a` takes `a` to `1 / addOrderOf a`;
* `TauCeti.CharacterModule.exists_apply_eq_inv_addOrderOf`: some character of the whole group
  takes `a` to `1 / addOrderOf a`.

The simp lemmas `CharacterModule.zero_apply`, `add_apply`, `neg_apply`, `sub_apply`, `nsmul_apply`
and `zsmul_apply` evaluate the group operations of `CharacterModule M` pointwise.
-/

public section

namespace CharacterModule

variable {G : Type*} [AddCommGroup G]

@[simp]
theorem zero_apply (x : G) : (0 : CharacterModule G) x = 0 := rfl

@[simp]
theorem add_apply (f g : CharacterModule G) (x : G) : (f + g) x = f x + g x := rfl

@[simp]
theorem neg_apply (f : CharacterModule G) (x : G) : (-f) x = -f x := rfl

@[simp]
theorem sub_apply (f g : CharacterModule G) (x : G) : (f - g) x = f x - g x := rfl

@[simp]
theorem nsmul_apply (n : ℕ) (f : CharacterModule G) (x : G) : (n • f) x = n • f x := rfl

@[simp]
theorem zsmul_apply (n : ℤ) (f : CharacterModule G) (x : G) : (n • f) x = n • f x := rfl

end CharacterModule

namespace TauCeti

/-- The zero character vanishes everywhere. -/
@[simp]
theorem CharacterModule.zero_apply {A : Type*} [AddCommGroup A] (a : A) :
    (0 : CharacterModule A) a = 0 :=
  rfl

/-- The character module of a finite abelian group is finite. -/
instance (M : Type*) [AddCommGroup M] [Finite M] : Finite (CharacterModule M) :=
  Finite.of_injective (fun c : CharacterModule M ↦ expCircle.compAddMonoidHom c)
    (expCircle.compAddMonoidHom_injective_right (AddChar.injective_iff.2
      fun _ hx ↦ expCircle_eq_one_iff.mp hx))

/-- The additive homomorphisms `M →+ AddCircle (1 : ℚ)` of a finite abelian group form a finite
type. This is the previous instance, read through the definitional equality
`CharacterModule M = M →+ AddCircle (1 : ℚ)`, for maps stated with the unfolded type. -/
instance (M : Type*) [AddCommGroup M] [Finite M] : Finite (M →+ AddCircle (1 : ℚ)) :=
  inferInstanceAs (Finite (CharacterModule M))

private theorem card_characterModule_le (M : Type*) [AddCommGroup M] [Finite M] :
    Nat.card (CharacterModule M) ≤ Nat.card M := by
  cases nonempty_fintype M
  have : Fintype (CharacterModule M) := Fintype.ofFinite _
  have hle := Fintype.card_le_of_injective
    (fun c : CharacterModule M ↦ expCircle.compAddMonoidHom c)
    (expCircle.compAddMonoidHom_injective_right (AddChar.injective_iff.2
      fun _ hx ↦ expCircle_eq_one_iff.mp hx))
  rw [AddChar.card_eq] at hle
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  exact hle

/-- Evaluation `m ↦ (c ↦ c m)`, Mathlib's `AddMonoidHom.eval`, embeds an abelian group in its
double character module: the characters of `M` separate its points. -/
theorem CharacterModule.eval_injective (M : Type*) [AddCommGroup M] :
    Function.Injective (AddMonoidHom.eval : M →+ CharacterModule (CharacterModule M)) := by
  intro x y hxy
  have h : ∀ c : CharacterModule M, c (x - y) = 0 := fun c ↦ by
    have hc : c x = c y := DFunLike.congr_fun hxy c
    rw [map_sub, hc, sub_self]
  exact sub_eq_zero.mp (CharacterModule.eq_zero_of_character_apply h)

/-- A finite abelian group and its character module have the same cardinality. For infinite `M`
both `M` and its character module are infinite, so both `Nat.card`s are `0`. -/
@[simp]
theorem natCard_characterModule (M : Type*) [AddCommGroup M] :
    Nat.card (CharacterModule M) = Nat.card M := by
  obtain _ | _ := finite_or_infinite M
  · -- `M` embeds in its double character module, which is no larger than the character module
    exact (card_characterModule_le M).antisymm <|
      (Nat.card_le_card_of_injective _ (CharacterModule.eval_injective M)).trans
        (card_characterModule_le (CharacterModule M))
  · -- both sides vanish: were the character module finite, so would the double character module
    -- be, and `M` embeds in it
    have : Infinite (CharacterModule M) := not_finite_iff_infinite.mp fun _ ↦
      (Finite.of_injective (β := CharacterModule (CharacterModule M)) _
        (CharacterModule.eval_injective M)).false
    rw [Nat.card_eq_zero_of_infinite, Nat.card_eq_zero_of_infinite]

/-- Mathlib's canonical character `CharacterModule.ofSpanSingleton a` of the cyclic subgroup
generated by a finite-order element `a` takes `a` to the reciprocal of its additive order in
`ℚ / ℤ`. -/
theorem CharacterModule.ofSpanSingleton_apply_self {A : Type*} [AddCommGroup A] (a : A)
    (ha : addOrderOf a ≠ 0) :
    CharacterModule.ofSpanSingleton a ⟨a, Submodule.mem_span_singleton_self a⟩ =
      ((1 / addOrderOf a : ℚ) : AddCircle (1 : ℚ)) := by
  have hif : (if addOrderOf a = 0 then 2 else addOrderOf a) = addOrderOf a :=
    ite_eq_right ha
  -- `CharacterModule M` is a semireducible definition for `M →+ AddCircle (1 : ℚ)`, so the
  -- intermediate terms of this evaluation are ill-typed at instance transparency and `rw` cannot
  -- see the patterns; `erw` is the idiom Mathlib uses for the same evaluation in
  -- `CharacterModule.eq_zero_of_ofSpanSingleton_apply_self`.
  erw [CharacterModule.ofSpanSingleton, LinearMap.toAddMonoidHom_coe, LinearMap.comp_apply,
    CharacterModule.intSpanEquivQuotAddOrderOf_apply_self,
    Submodule.liftQSpanSingleton_apply, CharacterModule.int.divByNat,
    LinearMap.toSpanSingleton_apply_one, hif]
  simp only [one_div]

/-- An element of an abelian group admits a character taking it to the reciprocal of its additive
order in `ℚ / ℤ`. For an element of infinite order the reciprocal is the junk value `0` and the
zero character works. -/
theorem CharacterModule.exists_apply_eq_inv_addOrderOf {A : Type*} [AddCommGroup A] (a : A) :
    ∃ χ : CharacterModule A,
      χ a = ((1 / addOrderOf a : ℚ) : AddCircle (1 : ℚ)) := by
  by_cases ha : addOrderOf a = 0
  · exact ⟨0, by simp only [ha, Nat.cast_zero, div_zero, AddCircle.coe_zero]; rfl⟩
  -- Extend the canonical character of the cyclic subgroup `ℤ ∙ a` using the injectivity of
  -- `ℚ / ℤ`.
  let i : (ℤ ∙ a) →ₗ[ℤ] A := Submodule.subtype _
  obtain ⟨χ, hχ⟩ := CharacterModule.dual_surjective_of_injective i
    (Submodule.injective_subtype _) (CharacterModule.ofSpanSingleton a)
  refine ⟨χ, ?_⟩
  have hχa := DFunLike.congr_fun hχ ⟨a, Submodule.mem_span_singleton_self a⟩
  -- `CharacterModule.dual i χ` is `χ.comp i` only up to the semireducible definition of
  -- `CharacterModule`, so `CharacterModule.dual_apply` followed by `AddMonoidHom.comp_apply`
  -- produces an ill-typed term that `rw` rejects; evaluate the restriction definitionally.
  change χ a = CharacterModule.ofSpanSingleton a
    ⟨a, Submodule.mem_span_singleton_self a⟩ at hχa
  rw [hχa, ofSpanSingleton_apply_self a ha]

end TauCeti
