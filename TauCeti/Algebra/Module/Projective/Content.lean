module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.IsTensorProduct

/-!
# The content ideal of a submodule of a projective module

Let `M` be a module over a commutative ring `A` and `N` a submodule of `M`. The *content* of `N`
is the ideal of `A` generated by the values `φ x` of all linear functionals `φ : M →ₗ[A] A` at all
`x ∈ N` (`Submodule.content`). When `M` is projective, it is the smallest ideal `𝔞` of `A` with
`N ≤ 𝔞 • M` (`Submodule.content_le_iff_le_smul_top`), the content of `N` in the sense of Ohm and
Rush.

The point of the content of a submodule of a projective module is that it computes where `N`
vanishes after base change: for an `A`-algebra `A'`, the image of `N` in `A' ⊗[A] M` is zero
exactly when `A → A'` kills the content of `N` (`IsBaseChange.content_le_ker_iff`). The content
itself commutes with base change (`IsBaseChange.content_span_image`), and for an ideal `J` of an
`A`-algebra `B` which is projective as an `A`-module, the content of the extension of `J` to a
pushout `A' ⊗[A] B` is the extension of the content of `J`
(`Algebra.IsPushout.content_restrictScalars_map`).

Geometrically, if `Spec B → Spec A` is finite locally free and `J ⊆ B` cuts out a closed subscheme
`Z ⊆ Spec B`, the closed subscheme of `Spec A` cut out by the content of `J` is the locus over
which `Spec B` lies inside `Z`: the Weil restriction of `Z` along `Spec B → Spec A`.

## Main definitions

* `Submodule.content N`: the content ideal of a submodule `N` of an `A`-module.

## Main results

* `Submodule.content_le_iff`: the content lies in `𝔞` exactly when every functional maps `N`
  into `𝔞`.
* `Submodule.content_le_iff_le_smul_top`: for projective `M`, the content of `N` is the smallest
  ideal `𝔞` with `N ≤ 𝔞 • ⊤`.
* `IsBaseChange.content_le_ker_iff`: for projective `M`, the image of `N` in the base change of `M`
  along `A → A'` is zero exactly when `A → A'` kills the content of `N`.
* `IsBaseChange.content_span_image`: for projective `M`, the content of the image of `N` in a base
  change of `M` is the extension of the content of `N`.
* `Algebra.IsPushout.content_restrictScalars_map`: the ideal version, for pushouts of algebras.

## References

* J. Ohm and D. E. Rush, *Content modules and algebras*, Math. Scand. 31 (1972), 49–68.
* S. Bosch, W. Lütkebohmert and M. Raynaud, *Néron Models*, §7.6, for Weil restriction.
-/

public section

open Module

namespace Submodule

variable {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]

/-- The **content** of a submodule `N` of an `A`-module `M`: the ideal of `A` generated by the
values `φ x` of the linear functionals `φ : M →ₗ[A] A` at the elements `x ∈ N`. For projective `M`
it is the smallest ideal `𝔞` with `N ≤ 𝔞 • ⊤` (`Submodule.content_le_iff_le_smul_top`). -/
noncomputable def content (N : Submodule A M) : Ideal A :=
  ⨆ φ : Dual A M, N.map φ

theorem apply_mem_content {N : Submodule A M} (φ : Dual A M) {x : M} (hx : x ∈ N) :
    φ x ∈ N.content :=
  le_iSup (fun φ : Dual A M ↦ N.map φ) φ (mem_map_of_mem hx)

theorem content_le_iff {N : Submodule A M} {𝔞 : Ideal A} :
    N.content ≤ 𝔞 ↔ ∀ φ : Dual A M, ∀ x ∈ N, φ x ∈ 𝔞 := by
  simp only [content, iSup_le_iff, map_le_iff_le_comap]
  exact forall_congr' fun φ ↦ ⟨fun h x hx ↦ h hx, fun h x hx ↦ h x hx⟩

theorem content_mono : Monotone (content : Submodule A M → Ideal A) := fun _ _ h ↦
  content_le_iff.2 fun φ _ hx ↦ apply_mem_content φ (h hx)

@[simp]
theorem content_bot : (⊥ : Submodule A M).content = ⊥ :=
  le_bot_iff.1 <| content_le_iff.2 fun φ x hx ↦ by simp [(mem_bot A).1 hx]

variable [Projective A M]

/-- An element of a projective module is the combination `∑ₘ (s x)(m) • m` for a linear map
`s : M →ₗ[A] M →₀ A`, chosen once and for all. -/
private theorem exists_sum_smul_eq :
    ∃ s : M →ₗ[A] M →₀ A, ∀ x, ((s x).sum fun m c ↦ c • m) = x := by
  obtain ⟨s, hs⟩ := projective_def'.1 (inferInstance : Projective A M)
  exact ⟨s, fun x ↦ by simpa [Finsupp.linearCombination_apply] using LinearMap.congr_fun hs x⟩

/-- For projective `M`, an `A`-linear map `χ : M →ₗ[A] A'` to an `A`-algebra carries `N` into the
extension of the content of `N`. -/
theorem apply_mem_map_content {A' : Type*} [CommRing A'] [Algebra A A'] {N : Submodule A M}
    (χ : M →ₗ[A] A') {x : M} (hx : x ∈ N) : χ x ∈ Ideal.map (algebraMap A A') N.content := by
  obtain ⟨s, hs⟩ := exists_sum_smul_eq (A := A) (M := M)
  rw [← hs x, Finsupp.sum, map_sum]
  refine Submodule.sum_mem _ fun m _ ↦ ?_
  rw [map_smul, Algebra.smul_def]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _
    (apply_mem_content ((Finsupp.lapply m).comp s) hx))

/-- For projective `M`, every submodule `N` lies in `content N • ⊤`. -/
theorem le_content_smul_top (N : Submodule A M) : N ≤ N.content • ⊤ := by
  obtain ⟨s, hs⟩ := exists_sum_smul_eq (A := A) (M := M)
  intro x hx
  rw [← hs x, Finsupp.sum]
  exact sum_mem fun m _ ↦ smul_mem_smul (apply_mem_content ((Finsupp.lapply m).comp s) hx)
    mem_top

/-- **The content as an Ohm–Rush content.** For projective `M`, the content of `N` lies in an
ideal `𝔞` exactly when `N ≤ 𝔞 • ⊤`: it is the smallest such ideal. -/
theorem content_le_iff_le_smul_top {N : Submodule A M} {𝔞 : Ideal A} :
    N.content ≤ 𝔞 ↔ N ≤ 𝔞 • ⊤ := by
  refine ⟨fun h ↦ (le_content_smul_top N).trans (smul_mono_left h), fun h ↦ ?_⟩
  refine content_le_iff.2 fun φ x hx ↦ ?_
  refine smul_induction_on (p := fun x ↦ φ x ∈ 𝔞) (h hx) (fun a ha m _ ↦ ?_)
    fun x y hx hy ↦ by simpa using add_mem hx hy
  simpa using 𝔞.mul_mem_right (φ m) ha

end Submodule

namespace IsBaseChange

open Submodule

variable {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
  {A' M' : Type*} [CommRing A'] [Algebra A A'] [AddCommGroup M'] [Module A' M'] [Module A M']
  [IsScalarTower A A' M'] {f : M →ₗ[A] M'}

/-- For `M` projective and `f : M → M'` a base change of `M` along `A → A'`, the submodule `N`
maps to zero in `M'` exactly when `A → A'` kills the content of `N`. -/
theorem content_le_ker_iff (h : IsBaseChange A' f) [Projective A M] {N : Submodule A M} :
    N.content ≤ RingHom.ker (algebraMap A A') ↔ ∀ x ∈ N, f x = 0 := by
  refine ⟨fun hN x hx ↦ ?_, fun hN ↦ content_le_iff.2 fun φ x hx ↦ ?_⟩
  · -- `x` is a combination of elements of `M` with coefficients in the content of `N`
    obtain ⟨s, hs⟩ := Submodule.exists_sum_smul_eq (A := A) (M := M)
    rw [← hs x, Finsupp.sum, map_sum]
    refine Finset.sum_eq_zero fun m _ ↦ ?_
    have hm := hN (apply_mem_content ((Finsupp.lapply m).comp s) hx)
    simp only [LinearMap.comp_apply, Finsupp.lapply_apply, RingHom.mem_ker] at hm
    rw [map_smul, ← algebraMap_smul A', hm, zero_smul]
  · have := h.lift_eq ((Algebra.linearMap A A').comp φ) x
    rw [hN x hx, map_zero] at this
    exact RingHom.mem_ker.2 (by simpa using this.symm)

/-- **The content commutes with base change.** For `M` projective and `f : M → M'` a base change
of `M` along `A → A'`, the content of the `A'`-submodule spanned by the image of `N` is the
extension of the content of `N`. -/
theorem content_span_image (h : IsBaseChange A' f) [Projective A M] (N : Submodule A M) :
    (span A' (f '' N)).content = Ideal.map (algebraMap A A') N.content := by
  refine le_antisymm (content_le_iff.2 fun ψ y hy ↦ ?_) (Ideal.map_le_iff_le_comap.2 <|
    content_le_iff.2 fun φ x hx ↦ ?_)
  · induction hy using span_induction with
    | mem y hy =>
      obtain ⟨x, hx, rfl⟩ := hy
      exact apply_mem_map_content ((ψ.restrictScalars A).comp f) hx
    | zero => simp
    | add y z _ _ hy hz => simpa using add_mem hy hz
    | smul a y _ hy => simpa using Ideal.mul_mem_left _ a hy
  · have := h.lift_eq ((Algebra.linearMap A A').comp φ) x
    rw [Ideal.mem_comap]
    simpa [this] using apply_mem_content (N := span A' (f '' N))
      (h.lift ((Algebra.linearMap A A').comp φ)) (subset_span ⟨x, hx, rfl⟩)

end IsBaseChange

namespace Algebra.IsPushout

open Submodule

variable {A A' B B' : Type*} [CommRing A] [CommRing A'] [CommRing B] [CommRing B'] [Algebra A A']
  [Algebra A B] [Algebra A' B'] [Algebra B B'] [Algebra A B'] [IsScalarTower A A' B']
  [IsScalarTower A B B']

/-- In a pushout `B' = A' ⊗[A] B`, the extension of an ideal `J` of `B` is spanned over `A'` by
the image of `J`. -/
theorem restrictScalars_map_eq_span [h : Algebra.IsPushout A A' B B'] (J : Ideal B) :
    (Ideal.map (algebraMap B B') J).restrictScalars A' = span A' (algebraMap B B' '' J) := by
  refine le_antisymm (fun y hy ↦ ?_) (span_le.2 fun _ ⟨x, hx, hxy⟩ ↦ hxy ▸ J.mem_map_of_mem _ hx)
  -- the `A'`-span of the image of `J` is stable under multiplication by `B'`
  have key (b : B') {y : B'} (hy : y ∈ span A' (algebraMap B B' '' J)) :
      b * y ∈ span A' (algebraMap B B' '' J) := by
    induction b using h.out.inductionOn with
    | tmul b =>
      induction hy using span_induction with
      | mem y hy =>
        obtain ⟨x, hx, rfl⟩ := hy
        exact subset_span ⟨b * x, J.mul_mem_left b hx, by simp⟩
      | zero => simp
      | add y z _ _ hy hz => simpa [mul_add] using add_mem hy hz
      | smul a y _ hy => simpa [mul_smul_comm] using smul_mem _ a hy
    | smul a b hb => simpa [smul_mul_assoc] using smul_mem _ a hb
    | add b c hb hc => simpa [add_mul] using add_mem hb hc
  induction hy using span_induction with
  | mem y hy =>
    obtain ⟨x, hx, rfl⟩ := hy
    exact subset_span ⟨x, hx, rfl⟩
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz
  | smul b y _ hy => exact key b hy

/-- **The content of an extended ideal.** If `B` is projective as an `A`-module and `B'` is the
pushout `A' ⊗[A] B`, the content over `A'` of the extension to `B'` of an ideal `J` of `B` is the
extension of the content of `J` over `A`. -/
theorem content_restrictScalars_map [h : Algebra.IsPushout A A' B B'] [Projective A B]
    (J : Ideal B) :
    ((Ideal.map (algebraMap B B') J).restrictScalars A').content =
      Ideal.map (algebraMap A A') (J.restrictScalars A).content := by
  rw [restrictScalars_map_eq_span (A := A), ← h.out.content_span_image]
  rfl

end Algebra.IsPushout
