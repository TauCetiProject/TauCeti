-- Private: `Module.Free.function` makes `Γⁿ` projective in the proof of `projective_end`.
import Mathlib.LinearAlgebra.StdBasis

/-!
# Generators of a module category and the double centralizer

An `R`-module `M` is a **generator** (`TauCeti.Module.IsGenerator`) when finitely many linear forms
`φᵢ : M →ₗ[R] R` and vectors `mᵢ : M` satisfy `∑ᵢ φᵢ(mᵢ) = 1`. Equivalently, the images of the
linear forms on `M` span `R`, that is, the trace ideal of `M` is `R`
(`TauCeti.Module.isGenerator_iff_iSup_range_eq_top`), and `R` is a quotient of a finite power
`Mⁿ` (`TauCeti.Module.isGenerator_iff_exists_surjective`). Then every `R`-module is the sum of the
images of the linear maps out of `M` (`TauCeti.Module.IsGenerator.iSup_range_eq_top`), which is the
categorical meaning of the word.

Let `Γ = Module.End R M`, acting on `M` by evaluation. For a generator, `M` is a finitely generated
projective `Γ`-module, being a direct summand of `Γⁿ`, and the action map `R → Module.End Γ M` is
bijective (`TauCeti.toModuleEnd_moduleEnd_bijective_of_isGenerator`): `R` is recovered as the ring
of `Γ`-linear endomorphisms of `M`. This is the **double centralizer property of a generator**.
It is the step of Morita theory that recovers a ring from a progenerator of its module category,
and the step of the Morita-Tachikawa correspondence that recovers an algebra from a
generator-cogenerator.

Unlike `TauCeti.toModuleEnd_moduleEnd_bijective` of
`TauCeti.RingTheory.Semisimple.DoubleCentralizer`, which rests on the Jacobson density theorem,
nothing is assumed of `R` or of `M` beyond being a
generator: `R` is any semiring, and `M` need not be semisimple or finitely generated over `R`. For
instance `R` itself is a generator over every ring, and it is semisimple only over a semisimple
ring.

## Implementation notes

Both results come from one family of endomorphisms. For `x : M`, the map `y ↦ φᵢ(y) • x` lies in
`Γ`, so a `Γ`-linear `f` commutes with it; applied to `∑ᵢ φᵢ(mᵢ) • x = x` this gives
`f x = (∑ᵢ φᵢ(f mᵢ)) • x`. The same maps give the splitting `x ↦ (y ↦ φᵢ(y) • x)ᵢ` of the
evaluation `Γⁿ → M`, `(gᵢ) ↦ ∑ᵢ gᵢ(mᵢ)`.

## Main definitions

* `TauCeti.Module.IsGenerator R M`: `M` is a generator of the category of `R`-modules.
* `TauCeti.ringEquivEndEndOfIsGenerator`: the double centralizer isomorphism
  `R ≃+* Module.End (Module.End R M) M` of a generator, and
  `TauCeti.algEquivEndEndOfIsGenerator` its form as an isomorphism of algebras over a compatible
  commutative base ring.

## Main results

* `TauCeti.Module.isGenerator_iff_iSup_range_eq_top` and
  `TauCeti.Module.isGenerator_iff_exists_surjective`: the trace-ideal and finite-power
  characterizations.
* `TauCeti.Module.IsGenerator.iSup_range_eq_top`: every module is generated by images of `M`.
* `TauCeti.Module.IsGenerator.of_surjective`: a module mapping onto a generator is a generator; so
  `R`, nonzero free modules and products with a generator factor are generators.
* `TauCeti.Module.IsGenerator.finite_end` and `TauCeti.Module.IsGenerator.projective_end`: a
  generator is finitely generated and projective over its endomorphism ring.
* `TauCeti.toModuleEnd_moduleEnd_bijective_of_isGenerator`: **the double centralizer property of a
  generator**.

## References

* T. Y. Lam, *Lectures on Modules and Rings*, GTM 189, §18 (generators, the trace ideal, and the
  balance of a generator over its endomorphism ring).
* F. W. Anderson and K. R. Fuller, *Rings and Categories of Modules*, GTM 13, §§8 and 17.
-/

public section

namespace TauCeti

open Module

variable (R : Type*) [Semiring R] (M : Type*) [AddCommMonoid M] [Module R M]

/-- An `R`-module `M` is a **generator** of the category of `R`-modules when finitely many linear
forms `φᵢ` on `M` and vectors `mᵢ` of `M` satisfy `∑ᵢ φᵢ(mᵢ) = 1`; that is, the trace ideal of `M`,
spanned by the images of all linear forms on `M`, is all of `R`
(`TauCeti.Module.isGenerator_iff_iSup_range_eq_top`). Equivalently, `R` is a quotient of a finite
power of `M` (`TauCeti.Module.isGenerator_iff_exists_surjective`), and then every `R`-module is
the sum of the images of the linear maps out of `M`
(`TauCeti.Module.IsGenerator.iSup_range_eq_top`). -/
class Module.IsGenerator : Prop where
  exists_sum_eq_one : ∃ (n : ℕ) (φ : Fin n → M →ₗ[R] R) (m : Fin n → M), ∑ i, φ i (m i) = 1

namespace Module

variable {R M}

/-- The defining property of a generator: finitely many linear forms `φᵢ` and vectors `mᵢ` with
`∑ᵢ φᵢ(mᵢ) = 1`. -/
theorem isGenerator_iff_exists_sum_eq_one :
    IsGenerator R M ↔
      ∃ (n : ℕ) (φ : Fin n → M →ₗ[R] R) (m : Fin n → M), ∑ i, φ i (m i) = 1 :=
  ⟨fun h ↦ h.1, fun h ↦ ⟨h⟩⟩

/-- **Every module is generated by a generator**: for a generator `M`, every `R`-module `N` is the
sum of the images of the linear maps `M →ₗ[R] N`. -/
theorem IsGenerator.iSup_range_eq_top [IsGenerator R M] (N : Type*) [AddCommMonoid N]
    [Module R N] : ⨆ f : M →ₗ[R] N, LinearMap.range f = ⊤ := by
  obtain ⟨n, φ, m, h⟩ := IsGenerator.exists_sum_eq_one (R := R) (M := M)
  refine eq_top_iff.mpr fun x _ ↦ ?_
  have hx : x = ∑ i, (φ i).smulRight x (m i) := by
    simp [← Finset.sum_smul, h]
  rw [hx]
  exact Submodule.sum_mem _ fun i _ ↦
    Submodule.mem_iSup_of_mem ((φ i).smulRight x) (LinearMap.mem_range_self _ _)

/-- **The trace-ideal characterization**: `M` is a generator exactly when the images of the linear
forms on `M` span `R`. -/
theorem isGenerator_iff_iSup_range_eq_top :
    IsGenerator R M ↔ ⨆ φ : M →ₗ[R] R, LinearMap.range φ = ⊤ := by
  refine ⟨fun _ ↦ IsGenerator.iSup_range_eq_top R, fun h ↦ ⟨?_⟩⟩
  have h1 : (1 : R) ∈ ⨆ φ : M →ₗ[R] R, LinearMap.range φ := h ▸ Submodule.mem_top
  refine Submodule.iSup_induction _ (motive := fun r : R ↦
    ∃ (n : ℕ) (φ : Fin n → M →ₗ[R] R) (m : Fin n → M), ∑ i, φ i (m i) = r) h1 ?_ ?_ ?_
  · rintro φ _ ⟨y, rfl⟩
    exact ⟨1, fun _ ↦ φ, fun _ ↦ y, by simp⟩
  · exact ⟨0, Fin.elim0, Fin.elim0, by simp⟩
  · rintro _ _ ⟨n, φ, m, rfl⟩ ⟨k, ψ, m', rfl⟩
    exact ⟨n + k, Fin.append φ ψ, Fin.append m m', by simp [Fin.sum_univ_add]⟩

/-- **The finite-power characterization**: `M` is a generator exactly when `R` is a quotient of a
finite power of `M`. -/
theorem isGenerator_iff_exists_surjective :
    IsGenerator R M ↔ ∃ (n : ℕ) (f : (Fin n → M) →ₗ[R] R), Function.Surjective f := by
  refine ⟨fun ⟨n, φ, m, h⟩ ↦ ⟨n, ∑ i, φ i ∘ₗ LinearMap.proj i, fun r ↦ ⟨fun i ↦ r • m i, ?_⟩⟩,
    fun ⟨n, f, hf⟩ ↦ ⟨?_⟩⟩
  · simp [← Finset.mul_sum, h]
  · obtain ⟨x, hx⟩ := hf 1
    refine ⟨n, fun i ↦ f ∘ₗ LinearMap.single R (fun _ ↦ M) i, x, ?_⟩
    conv_rhs => rw [← hx, ← Finset.univ_sum_single x, map_sum]
    simp

namespace IsGenerator

/-- A module mapping onto a generator is a generator. -/
theorem of_surjective {N : Type*} [AddCommMonoid N] [Module R N] [IsGenerator R N]
    (f : M →ₗ[R] N) (hf : Function.Surjective f) : IsGenerator R M := by
  obtain ⟨n, φ, m, h⟩ := IsGenerator.exists_sum_eq_one (R := R) (M := N)
  choose m' hm' using fun i ↦ hf (m i)
  exact ⟨n, fun i ↦ φ i ∘ₗ f, m', by simpa [hm'] using h⟩

/-- An `R`-module isomorphic to a generator is a generator. -/
theorem of_linearEquiv {N : Type*} [AddCommMonoid N] [Module R N] [IsGenerator R N]
    (e : M ≃ₗ[R] N) : IsGenerator R M :=
  of_surjective e.toLinearMap e.surjective

/-- The regular module is a generator. -/
instance self : IsGenerator R R :=
  ⟨1, fun _ ↦ LinearMap.id, fun _ ↦ 1, by simp⟩

/-- A nonzero free module is a generator: a coordinate form takes the value `1` on its basis
vector. -/
instance of_free [Module.Free R M] [Nontrivial M] : IsGenerator R M :=
  let b := Module.Free.chooseBasis R M
  have : Nonempty (Module.Free.ChooseBasisIndex R M) := b.index_nonempty
  let i := Classical.arbitrary (Module.Free.ChooseBasisIndex R M)
  ⟨1, fun _ ↦ b.coord i, fun _ ↦ b i, by simp⟩

/-- A product with a generator as its first factor is a generator. -/
instance prod_left {N : Type*} [AddCommMonoid N] [Module R N] [IsGenerator R M] :
    IsGenerator R (M × N) :=
  of_surjective (LinearMap.fst R M N) LinearMap.fst_surjective

/-- A product with a generator as its second factor is a generator. -/
instance prod_right {N : Type*} [AddCommMonoid N] [Module R N] [IsGenerator R N] :
    IsGenerator R (M × N) :=
  of_surjective (LinearMap.snd R M N) LinearMap.snd_surjective

/-- A generator is faithful: `r = ∑ᵢ φᵢ(r • mᵢ)` is determined by the action of `r` on `M`. -/
instance faithfulSMul [IsGenerator R M] : FaithfulSMul R M where
  eq_of_smul_eq_smul {r s} h := by
    obtain ⟨n, φ, m, h1⟩ := IsGenerator.exists_sum_eq_one (R := R) (M := M)
    have key (t : R) : t = ∑ i, φ i (t • m i) := by simp [← Finset.mul_sum, h1]
    rw [key r, key s]
    simp only [h]

end IsGenerator

/-! ### A generator over its endomorphism ring -/

namespace IsGenerator

variable [IsGenerator R M]

/-- A generator `M` is a direct summand of a finite free module over `Γ = Module.End R M`: the
evaluation `Γⁿ → M`, `(gᵢ) ↦ ∑ᵢ gᵢ(mᵢ)`, is split by `x ↦ (y ↦ φᵢ(y) • x)ᵢ`. -/
private theorem exists_comp_eq_id :
    ∃ (n : ℕ) (p : (Fin n → Module.End R M) →ₗ[Module.End R M] M)
      (s : M →ₗ[Module.End R M] Fin n → Module.End R M), p ∘ₗ s = LinearMap.id := by
  obtain ⟨n, φ, m, h⟩ := IsGenerator.exists_sum_eq_one (R := R) (M := M)
  -- The `i`-th coordinate of the splitting, `x ↦ (y ↦ φᵢ(y) • x)`, is linear over `Γ`.
  let s (i : Fin n) : M →ₗ[Module.End R M] Module.End R M :=
    { toFun x := (φ i).smulRight x
      map_add' x y := by ext; simp
      map_smul' g x := by ext; simp }
  refine ⟨n, ∑ i, LinearMap.toSpanSingleton _ M (m i) ∘ₗ LinearMap.proj i, LinearMap.pi s,
    LinearMap.ext fun x ↦ ?_⟩
  simp [s, Module.End.smul_def, ← Finset.sum_smul, h]

/-- A generator is finitely generated over its endomorphism ring. -/
instance finite_end : Module.Finite (Module.End R M) M :=
  have ⟨_, p, s, h⟩ := exists_comp_eq_id (R := R) (M := M)
  .of_surjective p (LinearMap.surjective_of_comp_eq_id s p h)

/-- A generator is projective over its endomorphism ring. -/
instance projective_end : Module.Projective (Module.End R M) M :=
  have ⟨_, p, s, h⟩ := exists_comp_eq_id (R := R) (M := M)
  .of_split s p h

end IsGenerator

end Module

open Module

/-- **The double centralizer property of a generator.** For a generator `M` of the category of
`R`-modules, the action map `R → Module.End Γ M`, for `Γ = Module.End R M`, is bijective: `R` is
exactly the ring of `Γ`-linear endomorphisms of `M`. -/
theorem toModuleEnd_moduleEnd_bijective_of_isGenerator [IsGenerator R M] :
    Function.Bijective (Module.toModuleEnd (Module.End R M) M (S := R)) := by
  refine ⟨fun _ _ h ↦ eq_of_smul_eq_smul (α := M) fun m ↦ LinearMap.congr_fun h m, fun f ↦ ?_⟩
  obtain ⟨n, φ, m, h⟩ := IsGenerator.exists_sum_eq_one (R := R) (M := M)
  refine ⟨∑ i, φ i (f (m i)), LinearMap.ext fun x ↦ ?_⟩
  -- `f` commutes with the endomorphisms `y ↦ φᵢ(y) • x`, and `∑ᵢ φᵢ(mᵢ) • x = x`.
  have hx : x = ∑ i, (φ i).smulRight x • m i := by
    simp [Module.End.smul_def, ← Finset.sum_smul, h]
  conv_rhs => rw [hx, map_sum]
  simp only [LinearMap.map_smul]
  simp [Module.End.smul_def]

/-- The double centralizer property of a generator as a ring isomorphism
`R ≃+* Module.End (Module.End R M) M`. -/
noncomputable def ringEquivEndEndOfIsGenerator [IsGenerator R M] :
    R ≃+* Module.End (Module.End R M) M :=
  RingEquiv.ofBijective _ (toModuleEnd_moduleEnd_bijective_of_isGenerator R M)

variable {R M}

@[simp]
theorem ringEquivEndEndOfIsGenerator_apply [IsGenerator R M] (r : R) (m : M) :
    ringEquivEndEndOfIsGenerator R M r m = r • m := by
  simp [ringEquivEndEndOfIsGenerator]

@[simp]
theorem ringEquivEndEndOfIsGenerator_symm_smul [IsGenerator R M]
    (f : Module.End (Module.End R M) M) (m : M) :
    (ringEquivEndEndOfIsGenerator R M).symm f • m = f m := by
  rw [← ringEquivEndEndOfIsGenerator_apply, RingEquiv.apply_symm_apply]

variable (R M)

/-- The double centralizer property of a generator as an isomorphism of `K`-algebras, for a
commutative base ring `K` acting on `M` compatibly with `R`. -/
noncomputable def algEquivEndEndOfIsGenerator (K : Type*) [CommSemiring K] [Algebra K R]
    [Module K M] [IsScalarTower K R M] [IsGenerator R M] :
    R ≃ₐ[K] Module.End (Module.End R M) M :=
  AlgEquiv.ofRingEquiv (f := ringEquivEndEndOfIsGenerator R M) fun k ↦ by
    ext m
    rw [ringEquivEndEndOfIsGenerator_apply, algebraMap_smul, Module.algebraMap_end_apply]

variable {R M}

@[simp]
theorem algEquivEndEndOfIsGenerator_apply (K : Type*) [CommSemiring K] [Algebra K R]
    [Module K M] [IsScalarTower K R M] [IsGenerator R M] (r : R) (m : M) :
    algEquivEndEndOfIsGenerator R M K r m = r • m :=
  ringEquivEndEndOfIsGenerator_apply r m

@[simp]
theorem algEquivEndEndOfIsGenerator_symm_smul (K : Type*) [CommSemiring K] [Algebra K R]
    [Module K M] [IsScalarTower K R M] [IsGenerator R M]
    (f : Module.End (Module.End R M) M) (m : M) :
    (algEquivEndEndOfIsGenerator R M K).symm f • m = f m := by
  rw [← algEquivEndEndOfIsGenerator_apply K, AlgEquiv.apply_symm_apply]

end TauCeti
