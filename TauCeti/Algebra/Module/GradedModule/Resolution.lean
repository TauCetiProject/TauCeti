module

public import Mathlib.Algebra.Exact.Basic
public import Mathlib.Algebra.Module.Projective
public import TauCeti.Algebra.Module.GradedModule.Generated
public import TauCeti.LinearAlgebra.Graded.LinearMap

/-!
# Linear graded projective resolutions

Let `𝒜` be a `ℤ`-graded `k`-algebra and `M` a graded `𝒜`-module. A graded projective resolution of
`M` is an exact sequence

`⋯ ⟶ P₂ ⟶ P₁ ⟶ P₀ ⟶ M ⟶ 0`

of graded `𝒜`-modules and degree-zero homogeneous `𝒜`-linear maps, whose terms are projective
`𝒜`-modules. It is **linear** when its `n`th term is generated by its homogeneous piece of internal
degree `n`. This is the notion in which Koszulity is stated: a nonnegatively graded algebra with
semisimple degree-zero part `A₀` is Koszul when `A₀`, as a graded module, has a linear resolution.

Write `A₊` for the sum of the pieces of `𝒜` of positive degree. A graded projective resolution is
**minimal** when every differential takes values in `A₊ Pₙ`, the standard notion of minimality
for graded resolutions over a nonnegatively graded algebra. The main result of this file is that,
over a nonnegatively graded algebra, a linear resolution is minimal: the
differential `Pₙ₊₁ ⟶ Pₙ` is homogeneous of degree zero, its source lives in degrees `≥ n + 1`, and
every homogeneous element of `Pₙ` of degree `> n` already lies in `A₊ Pₙ`, because `Pₙ` is
generated in degree `n`. A linear resolution also forces the resolved module to be generated in
degree zero.

## Main definitions

* `TauCeti.GradedProjectiveResolution`: a graded projective resolution of a graded module.
* `TauCeti.GradedProjectiveResolution.IsLinear`: the `n`th term is generated in internal
  degree `n`.
* `TauCeti.GradedProjectiveResolution.IsMinimal`: the differentials take values in `A₊ Pₙ`.

## Main results

* `TauCeti.GradedProjectiveResolution.IsLinear.isMinimal`: over a nonnegatively graded algebra, a
  linear resolution is minimal.
* `TauCeti.GradedProjectiveResolution.IsLinear.piece_eq_bot_of_lt`: over a nonnegatively graded
  algebra, the `n`th term of a linear resolution vanishes in internal degrees below `n`.
* `TauCeti.GradedProjectiveResolution.IsLinear.isGeneratedInDegree_zero`: a module with a linear
  resolution is generated in degree zero.

## Implementation notes

The terms are graded modules in the sense of `TauCeti.InternalGrading`: total `𝒜`-modules with an
internal direct-sum decomposition into `k`-submodules, on which `𝒜` acts by
`SetLike.GradedSMul`. Mathlib has no category of graded modules, so the resolution is recorded by
its terms, differentials and augmentation, with exactness stated by `Function.Exact`. Projectivity
is projectivity of the underlying `𝒜`-module; for `ℤ`-graded rings a graded module is projective
in the category of graded modules exactly when it is projective as an ungraded module
(Năstăsescu--Van Oystaeyen).

## References

* A. Beilinson, V. Ginzburg and W. Soergel, "Koszul duality patterns in representation theory",
  *Journal of the AMS* **9** (1996), Section 1.2, for Koszul rings defined by linear
  resolutions.
* S. Priddy, "Koszul resolutions", *Transactions of the American Mathematical Society* **152**
  (1970), 39--60.
* C. Năstăsescu and F. Van Oystaeyen, *Methods of graded rings*, Lecture Notes in Mathematics
  **1836**, Springer (2004), Section 2.3, for projective graded modules.
-/

public section

namespace TauCeti

universe uk uA uM w

variable {k : Type uk} {A : Type uA} [CommRing k] [Ring A] [Algebra k A]
variable (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]
variable {M : Type uM} [AddCommGroup M] [Module k M] [Module A M] (G : InternalGrading k M)

/-- A **graded projective resolution** of the graded `𝒜`-module `(M, G)`: projective graded
`𝒜`-modules `X n`, degree-zero homogeneous `𝒜`-linear differentials `d n : X (n + 1) ⟶ X n` and
a degree-zero homogeneous augmentation `π : X 0 ⟶ M`, such that
`⋯ ⟶ X 1 ⟶ X 0 ⟶ M ⟶ 0` is exact. -/
structure GradedProjectiveResolution where
  /-- The term in homological degree `n`. -/
  X : ℕ → Type w
  [addCommGroup (n : ℕ) : AddCommGroup (X n)]
  [module (n : ℕ) : Module A (X n)]
  [moduleBase (n : ℕ) : Module k (X n)]
  [isScalarTower (n : ℕ) : IsScalarTower k A (X n)]
  /-- The internal grading of the term in homological degree `n`. -/
  grading (n : ℕ) : InternalGrading k (X n)
  [gradedSMul (n : ℕ) : SetLike.GradedSMul 𝒜 (grading n).piece]
  /-- Every term is a projective `𝒜`-module. -/
  projective (n : ℕ) : Module.Projective A (X n)
  /-- The differential from homological degree `n + 1` to `n`. -/
  d (n : ℕ) : X (n + 1) →ₗ[A] X n
  /-- The augmentation onto the resolved module. -/
  π : X 0 →ₗ[A] M
  /-- The differentials preserve internal degree. -/
  isHomogeneous_d (n : ℕ) : LinearMap.IsHomogeneous (d n) (grading (n + 1)).piece
    (grading n).piece 0
  /-- The augmentation preserves internal degree. -/
  isHomogeneous_π : LinearMap.IsHomogeneous π (grading 0).piece G.piece 0
  /-- The augmentation is surjective. -/
  surjective_π : Function.Surjective π
  /-- The sequence is exact at `X 0`. -/
  exact_d_π : Function.Exact (d 0) π
  /-- The sequence is exact at `X (n + 1)`. -/
  exact_d_d (n : ℕ) : Function.Exact (d (n + 1)) (d n)

namespace GradedProjectiveResolution

attribute [instance] addCommGroup module moduleBase isScalarTower gradedSMul

variable {𝒜 G}

/-- A graded projective resolution is **linear** if its term in homological degree `n` is
generated by its homogeneous piece of internal degree `n`. -/
def IsLinear (r : GradedProjectiveResolution 𝒜 G) : Prop :=
  ∀ n : ℕ, (r.grading n).IsGeneratedInDegree A n

/-- A graded projective resolution is **minimal** if each differential `X (n + 1) ⟶ X n` takes
values in `A₊ (X n)`, the products of elements of positive degree of `𝒜` with elements of
`X n`. -/
def IsMinimal (r : GradedProjectiveResolution 𝒜 G) : Prop :=
  ∀ (n : ℕ) (x : r.X (n + 1)), r.d n x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k (r.X n))

variable {r : GradedProjectiveResolution 𝒜 G}

omit [GradedAlgebra 𝒜] in
/-- Linearity of a resolution, unfolded: each term is generated in its homological degree. -/
theorem isLinear_iff : r.IsLinear ↔ ∀ n : ℕ, (r.grading n).IsGeneratedInDegree A n :=
  Iff.rfl

omit [GradedAlgebra 𝒜] in
/-- Minimality of a resolution, unfolded: each differential takes values in `A₊ (X n)`. -/
theorem isMinimal_iff : r.IsMinimal ↔
    ∀ (n : ℕ) (x : r.X (n + 1)),
      r.d n x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k (r.X n)) :=
  Iff.rfl

/-- Over a nonnegatively graded algebra, the term in homological degree `n` of a linear
resolution has no nonzero homogeneous elements of internal degree below `n`. -/
theorem IsLinear.piece_eq_bot_of_lt (h𝒜 : ∀ i < 0, 𝒜 i = ⊥) (hr : r.IsLinear) {n : ℕ} {p : ℤ}
    (hp : p < n) : (r.grading n).piece p = ⊥ :=
  (hr n).piece_eq_bot_of_lt 𝒜 h𝒜 hp

/-- **A linear resolution is minimal**, over a nonnegatively graded algebra: each differential
goes from a module generated in degree `n + 1` to one generated in degree `n`, so it takes values
in `A₊ (X n)`. -/
theorem IsLinear.isMinimal (h𝒜 : ∀ i < 0, 𝒜 i = ⊥) (hr : r.IsLinear) : r.IsMinimal :=
  fun n ↦ InternalGrading.apply_mem_smul_top_of_isGeneratedInDegree 𝒜 h𝒜
    (by exact_mod_cast hr (n + 1)) (hr n) (by omega) (r.isHomogeneous_d n)

omit [GradedAlgebra 𝒜] in
/-- A graded module with a linear resolution is generated in degree zero: the augmentation is
surjective and preserves degree, and its source is generated in degree zero. -/
theorem IsLinear.isGeneratedInDegree_zero (hr : r.IsLinear) : G.IsGeneratedInDegree A 0 := by
  refine (G.isGeneratedInDegree_iff 0).2 fun x ↦ ?_
  obtain ⟨y, rfl⟩ := r.surjective_π x
  have hy := ((r.grading 0).isGeneratedInDegree_iff _).1 (hr 0) y
  refine Submodule.span_mono ?_ (Submodule.apply_mem_span_image_of_mem_span r.π hy)
  rintro _ ⟨z, hz, rfl⟩
  simpa using r.isHomogeneous_π.map_mem hz

end GradedProjectiveResolution

end TauCeti
