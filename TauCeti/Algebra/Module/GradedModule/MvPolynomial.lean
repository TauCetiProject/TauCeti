module

public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import TauCeti.Algebra.Module.GradedModule.Quotient

/-!
# Integer-graded modules over a polynomial ring

Let `A` be a commutative semiring and `M` a module over the polynomial ring `A[X_σ]`, with an
integer grading `ℳ : ℤ → Submodule A M` by `A`-submodules on which a homogeneous polynomial of
degree `i` raises degrees by `i`. This is a graded module over the standard graded polynomial
ring; when finitely generated, its generators may sit in negative degrees.

When `M` is finitely generated over `A[X_σ]` and `σ` is finite, every graded piece `ℳ d` is
finitely generated over `A`, and the pieces vanish in all sufficiently negative degrees. Choosing
finitely many homogeneous generators `g` of `M`, the piece `ℳ d` is the sum of the images
`A[X_σ]_(d - deg g) • g` of the homogeneous polynomials of the complementary degrees, each of which
is a finitely generated `A`-module. No finiteness hypothesis on `A` is needed.

These are the finiteness inputs of the Hilbert–Serre theorem on the lengths of the graded pieces
over an Artinian coefficient ring.

## Main results

* `TauCeti.MvPolynomial.coe_decompose_smul_add_of_mem`: the degree-`j + n` component of `p • x`,
  for `x` homogeneous of degree `j`, is the degree-`n` component of `p` acting on `x`.
* `TauCeti.MvPolynomial.piece_eq_iSup_map`: the degree-`d` piece is spanned over `A` by the
  homogeneous polynomials of degree `d - deg g` times the generators `g`.
* `TauCeti.MvPolynomial.fg_piece`: each graded piece is a finitely generated `A`-module.
* `TauCeti.MvPolynomial.exists_forall_lt_piece_eq_bot`: the pieces vanish in sufficiently negative
  degrees.
* `TauCeti.MvPolynomial.isHomogeneous_lsmul_X`: multiplication by a variable has degree one.
* `TauCeti.MvPolynomial.smul_mem_ker_piece`, `TauCeti.MvPolynomial.smul_mem_quotient_piece`: the
  gradings of the kernel of a homogeneous map and of the quotient by a homogeneous submodule are
  again compatible with the grading of the polynomial ring.

## References

* The Stacks Project, Commutative Algebra, Section 10.58, Lemmas 10.58.5 and 10.58.6.
* M. F. Atiyah and I. G. Macdonald, *Introduction to Commutative Algebra*, Chapter 11, proof of
  Theorem 11.1.
-/

public section

open DirectSum MvPolynomial

namespace TauCeti.MvPolynomial

section Pieces

variable {σ A M : Type*} [CommSemiring A] [AddCommMonoid M] [Module A M]
  [Module (MvPolynomial σ A) M] {ℳ : ℤ → Submodule A M} [Decomposition ℳ]

/-- For a module graded compatibly with the standard grading of the polynomial ring, the
degree-`j + n` component of `p • x`, for `x` homogeneous of degree `j`, is the degree-`n`
homogeneous component of `p` acting on `x`. -/
theorem coe_decompose_smul_add_of_mem
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {x : M} {j : ℤ} (hx : x ∈ ℳ j) {p : MvPolynomial σ A} (n : ℕ) :
    (decompose ℳ (p • x) (j + n) : M) = homogeneousComponent n p • x := by
  classical
  have hterm (i : ℕ) : (decompose ℳ (homogeneousComponent i p • x) (j + n) : M) =
      if i = n then homogeneousComponent n p • x else 0 := by
    have hmem := hℳ i j _ (homogeneousComponent_mem i p) x hx
    split_ifs with hin
    · subst hin
      exact decompose_of_mem_same ℳ hmem
    · exact decompose_of_mem_ne ℳ hmem (by omega)
  conv_lhs => rw [← sum_homogeneousComponent p]
  simp only [Finset.sum_smul, decompose_sum, DirectSum.sum_apply,
    AddSubmonoidClass.coe_finsetSum, hterm, Finset.sum_ite_eq', Finset.mem_range]
  split_ifs with hn
  · rfl
  · rw [homogeneousComponent_eq_zero n p (by omega), zero_smul]

/-- For a module graded compatibly with the standard grading of the polynomial ring, a polynomial
multiple of an element of degree `j` has no components in degrees below `j`. -/
theorem coe_decompose_smul_of_lt
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {x : M} {j d : ℤ} (hx : x ∈ ℳ j) {p : MvPolynomial σ A} (hd : d < j) :
    (decompose ℳ (p • x) d : M) = 0 := by
  classical
  conv_lhs => rw [← sum_homogeneousComponent p]
  simp only [Finset.sum_smul, decompose_sum, DirectSum.sum_apply,
    AddSubmonoidClass.coe_finsetSum]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  exact decompose_of_mem_ne ℳ (hℳ i j _ (homogeneousComponent_mem i p) x hx) (by omega)

variable (σ ℳ) in
/-- A finitely generated module over a polynomial ring with an integer grading is generated by
finitely many homogeneous elements `x ∈ s`, of chosen degrees `deg x`. These are the generators to
which `piece_eq_iSup_map` applies. -/
private theorem exists_finset_mem_span_eq_top [Module.Finite (MvPolynomial σ A) M] :
    ∃ (s : Finset M) (deg : M → ℤ), (∀ x ∈ s, x ∈ ℳ (deg x)) ∧
      Submodule.span (MvPolynomial σ A) (s : Set M) = ⊤ := by
  obtain ⟨s, hs, hspan⟩ :=
    (InternalGrading.ofDecomposition ℳ).exists_finset_span_eq_top (MvPolynomial σ A)
  rw [InternalGrading.ofDecomposition_piece] at hs
  choose! deg hdeg using hs
  exact ⟨s, deg, hdeg, hspan⟩

/-- The degree-`d` piece of a graded module generated by homogeneous elements `g ∈ s` of degrees
`deg g` is the sum, over the generators of degree at most `d`, of the homogeneous polynomials of
degree `d - deg g` times `g`. -/
theorem piece_eq_iSup_map [IsScalarTower A (MvPolynomial σ A) M]
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {s : Finset M} {deg : M → ℤ} (hs : ∀ x ∈ s, x ∈ ℳ (deg x))
    (hspan : Submodule.span (MvPolynomial σ A) (s : Set M) = ⊤) (d : ℤ) :
    ℳ d = ⨆ x ∈ s, ⨆ (_ : deg x ≤ d),
      (homogeneousSubmodule σ A (d - deg x).toNat).map
        ((LinearMap.toSpanSingleton (MvPolynomial σ A) M x).restrictScalars A) := by
  classical
  refine le_antisymm (fun m hm ↦ ?_) (iSup₂_le fun x hx ↦ iSup_le fun hxd ↦ ?_)
  · -- Write `m` as a polynomial combination of the generators and take degree-`d` components.
    have hm' : m ∈ Submodule.span (MvPolynomial σ A) (s : Set M) := hspan ▸ Submodule.mem_top
    obtain ⟨c, rfl⟩ := Submodule.mem_span_finset.mp hm' |>.imp fun c hc ↦ hc.2
    rw [← decompose_of_mem_same ℳ hm, decompose_sum, DirectSum.sum_apply,
      AddSubmonoidClass.coe_finsetSum]
    refine Submodule.sum_mem _ fun x hx ↦ ?_
    by_cases hxd : deg x ≤ d
    · have hd : d = deg x + ((d - deg x).toNat : ℕ) := by omega
      rw [hd, coe_decompose_smul_add_of_mem hℳ (hs x hx), ← hd]
      exact Submodule.mem_iSup_of_mem x <| Submodule.mem_iSup_of_mem hx <|
        Submodule.mem_iSup_of_mem hxd ⟨_, homogeneousComponent_mem _ _, rfl⟩
    · rw [coe_decompose_smul_of_lt hℳ (hs x hx) (not_le.mp hxd)]
      exact Submodule.zero_mem _
  · rintro _ ⟨p, hp, rfl⟩
    have h := hℳ _ _ p hp x (hs x hx)
    rw [show deg x + ((d - deg x).toNat : ℕ) = d by omega] at h
    simpa using h

/-- The graded pieces of a finitely generated graded module over a polynomial ring vanish in all
sufficiently negative degrees. -/
theorem exists_forall_lt_piece_eq_bot [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M]
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i)) :
    ∃ d₀ : ℤ, ∀ d < d₀, ℳ d = ⊥ := by
  obtain ⟨s, deg, hdeg, hspan⟩ := exists_finset_mem_span_eq_top σ ℳ
  obtain ⟨d₀, hd₀⟩ := (s.image deg).finite_toSet.bddBelow
  refine ⟨d₀, fun d hd ↦ ?_⟩
  rw [piece_eq_iSup_map hℳ hdeg hspan d]
  refine iSup₂_eq_bot.mpr fun x hx ↦ iSup_eq_bot.mpr fun hxd ↦ ?_
  have := hd₀ (Finset.mem_coe.mpr (Finset.mem_image_of_mem deg hx))
  omega

variable [Finite σ]

/-- Each graded piece of a finitely generated graded module over a polynomial ring in finitely
many variables is a finitely generated module over the coefficients. -/
theorem fg_piece [IsScalarTower A (MvPolynomial σ A) M] [Module.Finite (MvPolynomial σ A) M]
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i)) (d : ℤ) :
    (ℳ d).FG := by
  obtain ⟨s, deg, hdeg, hspan⟩ := exists_finset_mem_span_eq_top σ ℳ
  rw [piece_eq_iSup_map hℳ hdeg hspan d]
  exact Submodule.fg_biSup s _ fun x _ ↦
    Submodule.fg_iSup _ fun _ ↦ (homogeneousSubmodule_fg σ A _).map _

end Pieces

section Ker

variable {σ A M : Type*} [CommSemiring A] [AddCommMonoid M] [Module A M]
  [Module (MvPolynomial σ A) M] (G : InternalGrading A M ℤ)

/-- Multiplication by a variable is homogeneous of degree one. -/
theorem isHomogeneous_lsmul_X
    (hG : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ G.piece j, p • m ∈ G.piece (j + i)) (i : σ) :
    LinearMap.IsHomogeneous (LinearMap.lsmul (MvPolynomial σ A) M (X i)) G.piece G.piece 1 :=
  LinearMap.isHomogeneous_def.2 fun p x hx ↦ by
    simpa using hG 1 p (X i) ((mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X A i)) x hx

variable [IsScalarTower A (MvPolynomial σ A) M]

/-- The kernel of a homogeneous map is again graded compatibly with the polynomial ring. -/
theorem smul_mem_ker_piece
    (hG : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ G.piece j, p • m ∈ G.piece (j + i))
    {N : Type*} [AddCommMonoid N] [Module A N] [Module (MvPolynomial σ A) N]
    {H : InternalGrading A N ℤ} {f : M →ₗ[MvPolynomial σ A] N} {r : ℤ}
    (hf : LinearMap.IsHomogeneous f G.piece H.piece r)
    (i : ℕ) (j : ℤ) {p : MvPolynomial σ A} (hp : p ∈ homogeneousSubmodule σ A i)
    (z : LinearMap.ker f) (hz : z ∈ (G.ker hf).piece j) : p • z ∈ (G.ker hf).piece (j + i) :=
  (G.mem_ker_piece hf).2 (hG i j p hp _ ((G.mem_ker_piece hf).1 hz))

end Ker

section Quotient

variable {σ A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
  [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M] (G : InternalGrading A M ℤ)

/-- The quotient by a homogeneous submodule is again graded compatibly with the polynomial ring. -/
theorem smul_mem_quotient_piece
    (hG : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ G.piece j, p • m ∈ G.piece (j + i))
    (U : Submodule (MvPolynomial σ A) M) (hU : SetLike.IsHomogeneous G.piece U)
    (i : ℕ) (j : ℤ) {p : MvPolynomial σ A} (hp : p ∈ homogeneousSubmodule σ A i)
    (y : M ⧸ U) (hy : y ∈ (G.quotient U hU).piece j) : p • y ∈ (G.quotient U hU).piece (j + i) := by
  obtain ⟨x, hx, rfl⟩ := (G.mem_quotient_piece_iff _ _).mp hy
  rw [← Submodule.Quotient.mk_smul]
  exact G.mk_mem_quotient_piece _ _ (hG i j p hp x hx)

end Quotient

end TauCeti.MvPolynomial
