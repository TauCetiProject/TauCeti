open DirectSum MvPolynomial PowerSeries

namespace TauCeti.MvPolynomial

universe w

variable {σ A : Type*} [CommRing A]

section Induction

/-- The Hilbert series of a module, shifted to start in degree `d₀`, with integer coefficients the
lengths of the pieces. -/
private noncomputable abbrev lengthSeries {M : Type*} [AddCommGroup M] [Module A M]
    (ℳ : ℤ → Submodule A M) (d₀ : ℤ) : PowerSeries ℤ :=
  mk fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ)

/-- The base of the induction: if every variable acts by zero, the shifted Hilbert series is a
polynomial. -/
private theorem exists_lengthSeries_eq_of_forall_X_smul_eq_zero {M : Type*} [AddCommGroup M]
    [Module A M] [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M] (G : InternalGrading A M ℤ)
    (h : ∀ (i : σ) (m : M), (X i : MvPolynomial σ A) • m = 0) (d₀ : ℤ) :
    ∃ p : Polynomial ℤ, lengthSeries G.piece d₀ = p := by
  have := finite_of_forall_X_smul_eq_zero h
  obtain ⟨B, hB⟩ := G.finite_piece_ne_bot.bddAbove
  -- The coefficients vanish from index `(B - d₀ + 1).toNat` on, so the series is its truncation.
  refine ⟨trunc (B - d₀ + 1).toNat (lengthSeries G.piece d₀), PowerSeries.ext fun n ↦ ?_⟩
  rw [Polynomial.coeff_coe, coeff_trunc]
  split_ifs with hn
  · rfl
  have hbot : G.piece (d₀ + n) = ⊥ := by
    by_contra hne
    have := hB hne
    omega
  rw [coeff_mk, hbot]
  simp

variable [IsArtinianRing A] [Finite σ]

/-- The induction on the set `s` of variables which may act nontrivially: the shifted Hilbert
series times `(1 - T) ^ #s` is a polynomial. -/
private theorem exists_lengthSeries_mul_eq (s : Finset σ) :
    ∀ {M : Type w} [AddCommGroup M] [Module A M] [Module (MvPolynomial σ A) M]
      [IsScalarTower A (MvPolynomial σ A) M] [Module.Finite (MvPolynomial σ A) M]
      (G : InternalGrading A M ℤ),
      (∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A), p ∈ homogeneousSubmodule σ A i →
        ∀ m ∈ G.piece j, p • m ∈ G.piece (j + i)) →
      (∀ i ∉ s, ∀ m : M, (X i : MvPolynomial σ A) • m = 0) →
      ∀ d₀ : ℤ, (∀ d < d₀, G.piece d = ⊥) →
        ∃ h : Polynomial ℤ,
          lengthSeries G.piece d₀ * (1 - PowerSeries.X : PowerSeries ℤ) ^ s.card = h := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro M _ _ _ _ _ G _ hs d₀ _
    obtain ⟨p, hp⟩ := exists_lengthSeries_eq_of_forall_X_smul_eq_zero G
      (fun i ↦ hs i (Finset.notMem_empty i)) d₀
    exact ⟨p, by rw [Finset.card_empty, pow_zero, mul_one, hp]⟩
  | insert i s hi ih =>
    intro M _ _ _ _ _ G hG hs d₀ hd₀
    -- Multiplication by `X i` has degree one; apply the induction hypothesis to its kernel and
    -- cokernel, on which `X i` acts by zero.
    have hf := isHomogeneous_lsmul_X G hG i
    have hs' (j : σ) (hj : j ∉ s) (hji : j ≠ i) := hs j (by simp [hji, hj])
    obtain ⟨hK, hhK⟩ := ih (G.ker hf) (smul_mem_ker_piece G hG hf)
      (fun j hj z ↦ Subtype.ext <| by
        by_cases hji : j = i
        · subst hji
          simpa only [Submodule.coe_smul, ZeroMemClass.coe_zero, LinearMap.lsmul_apply] using
            LinearMap.mem_ker.mp z.property
        · exact hs' j hj hji z) d₀ fun d hd ↦ G.ker_piece_eq_bot hf (hd₀ d hd)
    obtain ⟨hC, hhC⟩ := ih (G.quotient _ hf.isHomogeneous_range)
      (smul_mem_quotient_piece G hG _ _)
      (fun j hj y ↦ by
        obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ y
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
        by_cases hji : j = i
        · subst hji
          exact LinearMap.mem_range_self _ x
        · rw [hs' j hj hji x]
          exact Submodule.zero_mem _) d₀
      fun d hd ↦ G.quotient_piece_eq_bot _ _ (hd₀ d hd)
    -- The exact sequences `0 → K_d → M_d → M_{d+1} → C_{d+1} → 0` give `(1 - T) H_M = H_C - T H_K`.
    have key := mk_mul_one_sub_X_eq (d₀ := d₀)
      (a := fun d ↦ ((Module.length A (G.piece d)).toNat : ℤ))
      (b := fun d ↦ ((Module.length A ((G.ker hf).piece d)).toNat : ℤ))
      (c := fun d ↦ ((Module.length A ((G.quotient _ hf.isHomogeneous_range).piece d)).toNat : ℤ))
      (fun d ↦ by
        let := MvPolynomial.gradedAlgebra (σ := σ) (R := A)
        have hfin := fun (N : Type w) [AddCommGroup N] [Module A N] [Module (MvPolynomial σ A) N]
            [IsScalarTower A (MvPolynomial σ A) N] [Module.Finite (MvPolynomial σ A) N]
            (𝒩 : ℤ → Submodule A N) [Decomposition 𝒩] h𝒩 (k : ℤ) ↦
          TauCeti.GradedModule.length_piece_ne_top (MvPolynomial.homogeneousSubmodule σ A)
            (fun i ↦ TauCeti.homogeneousSubmodule_moduleFinite i) 𝒩 h𝒩 k
        have := congrArg ENat.toNat (G.length_ker_piece_add_length_piece_add hf d)
        rw [ENat.toNat_add (hfin _ _ (smul_mem_ker_piece G hG hf) d)
          (hfin _ _ hG (d + 1)), ENat.toNat_add (hfin _ _ hG d)
          (hfin _ _ (smul_mem_quotient_piece G hG _ _) (d + 1))] at this
        exact_mod_cast this)
      (by rw [hd₀ (d₀ - 1) (by omega)]; simp)
      (by rw [G.ker_piece_eq_bot hf (hd₀ (d₀ - 1) (by omega))]; simp)
    refine ⟨hC - Polynomial.X * hK, ?_⟩
    rw [Finset.card_insert_of_notMem hi, pow_succ', ← mul_assoc, key]
    simp [sub_mul, mul_assoc, hhK, hhC]

end Induction

section HilbertSerre

variable [IsArtinianRing A] [Fintype σ] {M : Type*} [AddCommGroup M] [Module A M]
  [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
  [Module.Finite (MvPolynomial σ A) M] {ℳ : ℤ → Submodule A M} [Decomposition ℳ]

/-- **The Hilbert–Serre theorem**, rational form. Let `M` be a finitely generated graded module over
the polynomial ring in `e` variables over an Artinian ring `A`, and let `d₀` be a degree below which
all pieces of `M` vanish. Then the Hilbert series `∑ₙ ℓ_A(ℳ (d₀ + n)) Tⁿ`, starting in degree `d₀`,
is `h(T) / (1 - T)ᵉ` for a polynomial `h` with integer coefficients. -/
theorem exists_mk_length_mul_one_sub_X_pow_eq
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {d₀ : ℤ} (hd₀ : ∀ d < d₀, ℳ d = ⊥) :
    ∃ h : Polynomial ℤ, mk (fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ)) *
      (1 - PowerSeries.X : PowerSeries ℤ) ^ Fintype.card σ = h := by
  have hG := InternalGrading.ofDecomposition_piece ℳ
  obtain ⟨h, hh⟩ := exists_lengthSeries_mul_eq Finset.univ (InternalGrading.ofDecomposition ℳ)
    (by rwa [hG]) (fun i hi ↦ absurd (Finset.mem_univ i) hi) d₀ (by rwa [hG])
  rw [hG, Finset.card_univ] at hh
  exact ⟨h, hh⟩

/-- **The Hilbert–Serre theorem**, polynomial form. For a finitely generated graded module over the
polynomial ring in `e` variables over an Artinian ring `A`, the length of the degree-`d` piece
agrees for all large `d` with the value at `d` of a rational polynomial of degree less than `e`. -/
theorem exists_degree_lt_and_eval_eq_length
    (hℳ : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i)) :
    ∃ P : Polynomial ℚ, P.degree < (Fintype.card σ : WithBot ℕ) ∧
      ∃ N : ℤ, ∀ d, N ≤ d → P.eval (d : ℚ) = ((Module.length A (ℳ d)).toNat : ℚ) := by
  let := MvPolynomial.gradedAlgebra (σ := σ) (R := A)
  obtain ⟨d₀, hd₀⟩ :=
    TauCeti.GradedModule.exists_forall_lt_piece_eq_bot (homogeneousSubmodule σ A) ℳ hℳ
  obtain ⟨h, hh⟩ := exists_mk_length_mul_one_sub_X_pow_eq hℳ hd₀
  let q := h.map (Int.castRingHom ℚ)
  -- Over `ℚ`, the shifted Hilbert series is `q / (1 - T) ^ e`.
  have hq : mk (fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℚ)) =
      q * invOneSubPow ℚ (Fintype.card σ) := by
    have := congrArg (PowerSeries.map (Int.castRingHom ℚ)) hh
    simp only [map_mul, map_pow, map_sub, map_one, PowerSeries.map_X] at this
    rw [← Polynomial.polynomial_map_coe] at this
    rw [← this, mul_assoc, ← invOneSubPow_inv_eq_one_sub_pow, Units.inv_val, mul_one]
    ext n
    simp
  refine ⟨Polynomial.taylor (-(d₀ : ℚ)) (Polynomial.hilbertPoly q (Fintype.card σ)), ?_,
    d₀ + q.natDegree + 1, fun d hd ↦ ?_⟩
  · rw [Polynomial.degree_taylor]
    exact Polynomial.degree_hilbertPoly_lt _ _
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, d = d₀ + n := ⟨(d - d₀).toNat, by omega⟩
    have hn : ((d₀ + n : ℤ) : ℚ) + -(d₀ : ℚ) = n := by push_cast; ring
    rw [Polynomial.taylor_eval, hn, ← Polynomial.coeff_mul_invOneSubPow_eq_hilbertPoly_eval _
      (by omega : q.natDegree < n), ← hq, coeff_mk]

end HilbertSerre

end TauCeti.MvPolynomial

namespace TauCeti.GradedModule

universe u v w

/-! ### Rational Hilbert–Serre series over general commutative rings -/

section RationalSeries

/-- Extending the standard `ℕ`-grading of `MvPolynomial σ A` by `⊥` in negative degrees to `ℤ`. -/
private noncomputable def mvPolynomialIntGrading (A σ : Type*) [CommSemiring A] :
    ℤ → Submodule A (MvPolynomial σ A)
  | (n : ℕ) => MvPolynomial.homogeneousSubmodule σ A n
  | Int.negSucc _ => ⊥

private theorem isInternal_mvPolynomialIntGrading (A σ : Type*) [CommSemiring A] :
    DirectSum.IsInternal (mvPolynomialIntGrading A σ) := by
  classical
  let := MvPolynomial.gradedAlgebra (σ := σ) (R := A)
  have hfib := (DirectSum.Decomposition.isInternal
    (MvPolynomial.homogeneousSubmodule σ A)).iSup_fiber (Nat.cast : ℕ → ℤ)
  convert hfib with j
  cases j with
  | ofNat n =>
    simp only [mvPolynomialIntGrading, Int.ofNat_eq_natCast, Nat.cast_inj, iSup_iSup_eq_left]
  | negSucc n =>
    simp [mvPolynomialIntGrading, eq_comm]

/-- Lifting an `A`-module grading on a module annihilated by `I` to `A ⧸ I` reduces the rational
Hilbert–Serre series to the Artinian ring `A ⧸ I`. -/
private theorem exists_hilbertSeries_of_isTorsionBySet {A : Type u} [CommRing A] (I : Ideal A)
    [IsArtinianRing (A ⧸ I)] {σ : Type v} [Fintype σ] {M : Type w} [AddCommGroup M] [Module A M]
    [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M] (hI : Module.IsTorsionBySet A M I)
    (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {d₀ : ℤ} (hd₀ : ∀ d < d₀, ℳ d = ⊥) :
    ∃ h : Polynomial ℤ,
      (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ)) *
        (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries := by
  let B := A ⧸ I
  let : Module B M := hI.module
  have : IsScalarTower A B M := hI.isScalarTower
  let π : MvPolynomial σ A →+* MvPolynomial σ B := MvPolynomial.map (Ideal.Quotient.mk I)
  have hπ_surj : Function.Surjective π := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective
  have hker : Module.IsTorsionBySet (MvPolynomial σ A) M (RingHom.ker π) :=
    ((Ideal.mk_ker (I := I)).symm ▸ hI).ker_mvPolynomial_map (σ := σ)
  let eR : (MvPolynomial σ A ⧸ RingHom.ker π) ≃+* MvPolynomial σ B :=
    RingHom.quotientKerEquivOfSurjective hπ_surj
  let : Module (MvPolynomial σ A ⧸ RingHom.ker π) M := hker.module
  let : Module (MvPolynomial σ B) M := Module.compHom M eR.symm.toRingHom
  have hπ_smul (p : MvPolynomial σ A) (x : M) : π p • x = p • x := by
    simp [MulAction.compHom_smul_def, eR, hker.mk_smul]
  have : IsScalarTower B (MvPolynomial σ B) M := ⟨fun b q x ↦ by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨p, rfl⟩ := hπ_surj q
    have hsm : Ideal.Quotient.mk I a • π p = π (a • p) := by
      simp [Algebra.smul_def, π, B]
    rw [hsm, hπ_smul, hπ_smul, smul_assoc, hI.mk_smul]⟩
  let : Algebra (MvPolynomial σ A) (MvPolynomial σ B) := π.toAlgebra
  have : IsScalarTower (MvPolynomial σ A) (MvPolynomial σ B) M :=
    IsScalarTower.of_algebraMap_smul fun p x ↦ by
      rw [RingHom.algebraMap_toAlgebra]; exact hπ_smul p x
  have : Module.Finite (MvPolynomial σ B) M :=
    Module.Finite.of_restrictScalars_finite (MvPolynomial σ A) (MvPolynomial σ B) M
  let e := Submodule.orderIsoOfAlgebraMapSurjective (R := A) (S := B) (M := M)
    Ideal.Quotient.mk_surjective
  let ℳB : ℤ → Submodule B M := fun d ↦ e.symm (ℳ d)
  let : DirectSum.Decomposition ℳB :=
    ((DirectSum.Decomposition.isInternal ℳ).of_algebraMap_surjective
      Ideal.Quotient.mk_surjective).chooseDecomposition
  have hmemB (j : ℤ) (m : M) : m ∈ ℳB j ↔ m ∈ ℳ j := by
    have he : (ℳB j).restrictScalars A = ℳ j :=
      (Submodule.orderIsoOfAlgebraMapSurjective_apply
        Ideal.Quotient.mk_surjective (ℳB j)).symm.trans (e.apply_symm_apply (ℳ j))
    rw [← Submodule.restrictScalars_mem A, he]
  have hgradedB : ∀ (i : ℕ) (j : ℤ) (q : MvPolynomial σ B),
      q ∈ MvPolynomial.homogeneousSubmodule σ B i → ∀ m ∈ ℳB j, q • m ∈ ℳB (j + i) := by
    intro i j q hq m hm
    obtain ⟨p, hp, rfl⟩ := hq.exists_map_eq Ideal.Quotient.mk_surjective
    rw [hπ_smul, hmemB]
    exact hgraded i j p hp m ((hmemB j m).mp hm)
  have hlen (d : ℤ) : Module.length A (ℳ d) = Module.length B (ℳB d) :=
    (LinearEquiv.length_eq
      ((LinearEquiv.ofEq _ _ (e.apply_symm_apply (ℳ d)).symm).trans
        (((ℳB d).restrictScalarsEquiv A).restrictScalars A))).trans
      (Module.length_eq_of_surjective (S := A) (R := B) Ideal.Quotient.mk_surjective)
  obtain ⟨h, hh⟩ := TauCeti.MvPolynomial.exists_mk_length_mul_one_sub_X_pow_eq hgradedB
    (fun d hd ↦ by simp only [ℳB, hd₀ d hd, map_bot])
  exact ⟨h, by simpa only [hlen] using hh⟩

/-- If a single sufficiently high piece `ℳ N₁` (generating the tail `d ≥ N₁` over
`MvPolynomial σ A`) has finite `A`-length, then the shifted Hilbert series from `N₁` is rational
with denominator `(1 - X) ^ Fintype.card σ`. -/
private theorem exists_hilbertSeries_of_tail_piece_length_ne_top {A : Type u} [CommRing A]
    {σ : Type v} [Fintype σ] {M : Type w} [AddCommGroup M] [Module A M]
    [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {N₁ : ℤ}
    (htail : ∀ d ≥ N₁, ℳ d ≤ (Submodule.span (MvPolynomial σ A) (ℳ N₁ : Set M)).restrictScalars A)
    (hfin : Module.length A (ℳ N₁) ≠ ⊤) :
    ∃ h : Polynomial ℤ,
      (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (N₁ + n))).toNat : ℤ)) *
        (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries := by
  let G := InternalGrading.ofDecomposition ℳ
  have hGp : G.piece = ℳ := InternalGrading.ofDecomposition_piece ℳ
  let M' : Submodule (MvPolynomial σ A) M := Submodule.span (MvPolynomial σ A) (G.piece N₁ : Set M)
  have hM'_eq : M' = Submodule.span (MvPolynomial σ A) (ℳ N₁ : Set M) := by
    dsimp only [M']; rw [hGp]
  have hfl : IsFiniteLength A (ℳ N₁) := Module.length_ne_top_iff.mp hfin
  have : IsArtinianRing (A ⧸ Module.annihilator A (ℳ N₁)) :=
    TauCeti.isArtinianRing_quotient_annihilator hfl
  have : IsNoetherian A (ℳ N₁) := (isFiniteLength_iff_isNoetherian_isArtinian.mp hfl).1
  have : Module.Finite (MvPolynomial σ A) M' := by
    rw [hM'_eq]
    exact Module.Finite.of_fg ((Module.Finite.iff_fg.mp inferInstance).span)
  let 𝒜 := mvPolynomialIntGrading A σ
  let : DirectSum.Decomposition 𝒜 := (isInternal_mvPolynomialIntGrading A σ).chooseDecomposition
  let : SetLike.GradedSMul 𝒜 G.piece := ⟨fun {i j p m} hp hm ↦ by
    rw [hGp] at hm ⊢
    cases i with
    | ofNat n =>
      simpa only [Int.ofNat_eq_natCast, vadd_eq_add, add_comm] using hgraded n j p hp m hm
    | negSucc n => simp only [𝒜, mvPolynomialIntGrading, Submodule.mem_bot] at hp; simp [hp]⟩
  have hM'_hom : DirectSum.SetLike.IsHomogeneous G.piece M' :=
    InternalGrading.isHomogeneous_span_piece (A := MvPolynomial σ A) 𝒜 N₁
  have hlt_zero (x : M) (hx : x ∈ M') (d : ℤ) (hd : d < N₁) : (decompose ℳ x d : M) = 0 := by
    rw [← InternalGrading.coe_decompose_ofDecomposition_piece_apply ℳ]
    exact InternalGrading.decompose_mem_span_piece_eq_zero_of_lt 𝒜
      (fun i hi ↦ by
        cases i with
        | ofNat n => exact False.elim (Int.not_lt.mpr (Int.natCast_nonneg n) hi)
        | negSucc _ => rfl) hd hx
  have hI_M' : Module.IsTorsionBySet A M' (Module.annihilator A (ℳ N₁)) := by
    rw [hM'_eq]
    exact Module.IsTorsionBySet.span (ℳ N₁) (Module.isTorsionBySet_annihilator A (ℳ N₁))
  let G' := G.submodule M' hM'_hom
  obtain ⟨h, hh⟩ := exists_hilbertSeries_of_isTorsionBySet (d₀ := N₁) (Module.annihilator A (ℳ N₁))
    hI_M' G'.piece
    (fun i j p hp x hx ↦ by
      rw [G.mem_submodule_piece, hGp] at hx ⊢
      exact hgraded i j p hp x.val hx)
    (fun d hd ↦ (Submodule.eq_bot_iff _).mpr fun x hx ↦ Subtype.ext (by
      rw [G.mem_submodule_piece, hGp] at hx
      rw [← decompose_of_mem_same ℳ hx, hlt_zero x.val x.property d hd, ZeroMemClass.coe_zero]))
  have hlen (n : ℕ) : Module.length A (G'.piece (N₁ + n)) = Module.length A (ℳ (N₁ + n)) :=
    have hle : ℳ (N₁ + n) ≤ M'.restrictScalars A := hM'_eq ▸ htail (N₁ + n) (by omega)
    LinearEquiv.length_eq
      ((LinearEquiv.ofEq _ _ (by rw [G.submodule_piece, hGp]; rfl)).trans
        (Submodule.comapSubtypeEquivOfLe hle))
  have hmk : (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (G'.piece (N₁ + n))).toNat : ℤ)) =
      (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (N₁ + n))).toNat : ℤ)) := by
    ext n; rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk, hlen n]
  exact ⟨h, hmk ▸ hh⟩

/-- **Rational Hilbert–Serre series.** For any commutative ring `A` and any finitely generated
`ℤ`-graded module `M` over `MvPolynomial σ A` (with `σ` finite), the shifted formal series of
`ENat.toNat` length coefficients `(Module.length A (ℳ (d₀ + n))).toNat` from any starting degree
`d₀ : ℤ` multiplied by `(1 - X) ^ Fintype.card σ` is a polynomial in `ℤ[X]`. Note that
`ENat.toNat ⊤ = 0`, so infinite-length pieces contribute `0`; this coincides with the genuine
length Hilbert series whenever every graded piece has finite `A`-length (for instance when `A` is
Artinian). -/
theorem exists_hilbertSeries_mul_one_sub_X_pow {A : Type u} [CommRing A]
    {σ : Type v} [Fintype σ] {M : Type w} [AddCommGroup M] [Module A M]
    [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M]
    (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    (d₀ : ℤ) :
    ∃ h : Polynomial ℤ,
      (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ)) *
        (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries := by
  obtain ⟨N₀, hN₀⟩ := TauCeti.MvPolynomial.exists_degree_ge_le_span_piece hgraded
  by_cases hex : ∃ N₁ ≥ N₀, Module.length A (ℳ N₁) ≠ ⊤
  · obtain ⟨N₁, hN₁, hfin⟩ := hex
    obtain ⟨h, hh⟩ := exists_hilbertSeries_of_tail_piece_length_ne_top ℳ hgraded (hN₀ N₁ hN₁) hfin
    have hpow : ((1 - (Polynomial.X : Polynomial ℤ)) ^ Fintype.card σ).toPowerSeries =
        (1 - PowerSeries.X) ^ Fintype.card σ := by
      simp only [Polynomial.coe_pow, Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_X]
    have hh' : (PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (N₁ + n))).toNat : ℤ)) *
        ((1 - (Polynomial.X : Polynomial ℤ)) ^ Fintype.card σ).toPowerSeries =
          h.toPowerSeries := by
      rwa [hpow]
    obtain ⟨h', hh''⟩ := PowerSeries.exists_mul_toPowerSeries_shift
      (f := fun k ↦ ((Module.length A (ℳ k)).toNat : ℤ)) (d₁ := N₁)
      ((1 - (Polynomial.X : Polynomial ℤ)) ^ Fintype.card σ) hh' d₀
    exact ⟨h', by rwa [← hpow]⟩
  · push Not at hex
    let B : ℕ := (N₀ - d₀).toNat
    let H : PowerSeries ℤ := PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ)
    refine ⟨PowerSeries.trunc B H * (1 - Polynomial.X) ^ Fintype.card σ, ?_⟩
    have hser : (PowerSeries.trunc B H).toPowerSeries =
        PowerSeries.mk fun n : ℕ ↦ ((Module.length A (ℳ (d₀ + n))).toNat : ℤ) :=
      PowerSeries.coe_trunc_eq_self_of_coeff_eq_zero fun n hn ↦ by
        rw [PowerSeries.coeff_mk, hex (d₀ + n) (by omega), ENat.toNat_top, Nat.cast_zero]
    rw [← hser]
    simp

end RationalSeries

/-! ### The Hilbert–Serre theorem and specializations -/

section HilbertSerre

/-- **The Hilbert–Serre theorem.** A finitely generated `ℤ`-graded module `M` over a standard
polynomial ring `MvPolynomial σ A` (with `A` Artinian and `σ` finite) has finite-length graded
pieces, vanishes below some integer `d₀`, has shifted Hilbert series `h(X) / (1 - X)^e` for some
`h : ℤ[X]` (where `e = Fintype.card σ`), and has an eventual rational Hilbert polynomial `P : ℚ[X]`
of degree strictly less than `e`. -/
theorem hilbertSerre (A : Type u) [CommRing A] [IsArtinianRing A]
    (σ : Type v) [Fintype σ] (M : Type w) [AddCommGroup M] [Module A M]
    [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M]
    (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i →
        ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i)) :
    (∀ d, Module.Finite A (ℳ d) ∧ Module.length A (ℳ d) ≠ ⊤) ∧
      ∃ (d₀ : ℤ) (h : Polynomial ℤ) (P : Polynomial ℚ) (N : ℤ),
        (∀ d < d₀, ℳ d = ⊥) ∧
        (PowerSeries.mk (fun n : ℕ =>
          ((Module.length A (ℳ (d₀ + n))).toNat : ℤ))) *
          (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries ∧
        P.degree < (Fintype.card σ : WithBot ℕ) ∧
        ∀ d, N ≤ d → P.eval (d : ℚ) = ((Module.length A (ℳ d)).toNat : ℚ) := by
  let := MvPolynomial.gradedAlgebra (σ := σ) (R := A)
  have hfin : ∀ d, Module.Finite A (ℳ d) ∧ Module.length A (ℳ d) ≠ ⊤ := fun d ↦
    ⟨moduleFinite_piece (MvPolynomial.homogeneousSubmodule σ A)
        (fun i ↦ TauCeti.homogeneousSubmodule_moduleFinite i) ℳ hgraded d,
      length_piece_ne_top (MvPolynomial.homogeneousSubmodule σ A)
        (fun i ↦ TauCeti.homogeneousSubmodule_moduleFinite i) ℳ hgraded d⟩
  obtain ⟨d₀, hd₀⟩ := exists_forall_lt_piece_eq_bot
    (MvPolynomial.homogeneousSubmodule σ A) ℳ hgraded
  obtain ⟨h, hh⟩ := TauCeti.MvPolynomial.exists_mk_length_mul_one_sub_X_pow_eq hgraded hd₀
  obtain ⟨P, hdeg, N, hP⟩ := TauCeti.MvPolynomial.exists_degree_lt_and_eval_eq_length hgraded
  exact ⟨hfin, d₀, h, P, N, hd₀, hh, hdeg, hP⟩

/-- Any polynomial `P : R[X]` (over a ring `R` with unique additive division) that eventually agrees
with the `ENat.toNat` length coefficients `(Module.length A (ℳ d)).toNat` of a finitely generated
`ℤ`-graded `MvPolynomial σ A`-module takes integer values at every integer `z`, and has degree
strictly less than `Fintype.card σ` (where `ENat.toNat ⊤ = 0`, agreeing with the genuine lengths
when the graded pieces have finite `A`-length). -/
theorem exists_int_eval_of_eventually_eval_length {A : Type u} [CommRing A]
    {σ : Type v} [Fintype σ] {M : Type w} [AddCommGroup M] [Module A M]
    [Module (MvPolynomial σ A) M] [IsScalarTower A (MvPolynomial σ A) M]
    [Module.Finite (MvPolynomial σ A) M]
    (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i))
    {R : Type*} [Ring R] [HasUniqueDiv R] {P : Polynomial R} {N : ℤ}
    (hP : ∀ d : ℤ, N ≤ d → P.eval (d : R) = ((Module.length A (ℳ d)).toNat : R)) :
    P.degree < (Fintype.card σ : WithBot ℕ) ∧ ∀ z : ℤ, ∃ m : ℤ, P.eval (z : R) = (m : R) := by
  let e := Fintype.card σ
  obtain ⟨h, hh⟩ := exists_hilbertSeries_mul_one_sub_X_pow ℳ hgraded 0
  obtain ⟨Q, hQdeg, hQmap⟩ := Polynomial.exists_map_eq_factorial_nsmul_hilbertPoly h e
  have hQeval_map (x : ℤ) :
      (Q.map (Int.castRingHom R)).eval (x : R) = ((Q.eval x : ℤ) : R) := by
    simp
  have hQrat_mul (x : ℤ) : ((Q.eval x : ℤ) : ℚ) =
      ((e - 1).factorial : ℚ) *
        (Polynomial.hilbertPoly (h.map (Int.castRingHom ℚ)) e).eval (x : ℚ) := by
    have hrat : (Q.map (Int.castRingHom ℚ)).eval (x : ℚ) = ((Q.eval x : ℤ) : ℚ) := by simp
    rw [← hrat, hQmap, Polynomial.eval_smul, nsmul_eq_mul]
  let q : Polynomial ℚ := h.map (Int.castRingHom ℚ)
  have hq : PowerSeries.mk (fun n : ℕ ↦ ((Module.length A (ℳ (0 + n))).toNat : ℚ)) =
      (q : PowerSeries ℚ) * PowerSeries.invOneSubPow ℚ e := by
    have hmap := congrArg (PowerSeries.map (Int.castRingHom ℚ)) hh
    simp only [map_mul, map_pow, map_sub, map_one, PowerSeries.map_X] at hmap
    rw [← Polynomial.polynomial_map_coe] at hmap
    rw [← hmap, mul_assoc, ← PowerSeries.invOneSubPow_inv_eq_one_sub_pow, Units.inv_val, mul_one]
    ext n
    simp
  have hQ_eval (d : ℤ) (hd : (h.natDegree : ℤ) + 1 ≤ d) :
      Q.eval d = ((e - 1).factorial : ℤ) * ((Module.length A (ℳ d)).toNat : ℤ) := by
    apply Int.cast_injective (α := ℚ)
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, d = (n : ℤ) := ⟨d.toNat, by omega⟩
    have hn : q.natDegree < n := lt_of_le_of_lt Polynomial.natDegree_map_le (by omega)
    have h1 : (Polynomial.hilbertPoly q e).eval (n : ℚ) =
        ((Module.length A (ℳ n)).toNat : ℚ) := by
      rw [← Polynomial.coeff_mul_invOneSubPow_eq_hilbertPoly_eval e hn, ← hq, PowerSeries.coeff_mk]
      exact congrArg (fun k : ℤ ↦ ((Module.length A (ℳ k)).toNat : ℚ)) (zero_add (n : ℤ))
    simpa [q, Int.cast_natCast] using
      (hQrat_mul n).trans (congrArg (((e - 1).factorial : ℚ) * ·) h1)
  have hPQ : (e - 1).factorial • P = Q.map (Int.castRingHom R) := by
    refine Polynomial.eq_of_forall_ge_intCast_eval_eq (N := max N ((h.natDegree : ℤ) + 1))
      fun d hd ↦ ?_
    rw [Polynomial.eval_smul, hP d (le_of_max_le_left hd), hQeval_map d,
      hQ_eval d (le_of_max_le_right hd)]
    simp [nsmul_eq_mul]
  refine ⟨?_, fun z ↦ ?_⟩
  · by_cases hP0 : P = 0
    · simp [hP0]
    · rw [Polynomial.degree_eq_natDegree hP0]
      norm_cast
      by_contra hge
      have hkQ : Q.coeff P.natDegree = 0 := Polynomial.coeff_eq_zero_of_degree_lt
        (hQdeg.trans_le (WithBot.coe_le_coe.mpr (Nat.le_of_not_lt hge)))
      have hc := congrArg (fun p : Polynomial R ↦ p.coeff P.natDegree) hPQ
      rw [AddMonoidAlgebra.coeff_smul_apply, Polynomial.coeff_map, hkQ, map_zero,
        ← nsmul_zero ((e - 1).factorial)] at hc
      exact Polynomial.leadingCoeff_ne_zero.mpr hP0
        (HasUniqueDiv.nsmul_right_injective (Nat.factorial_ne_zero _) hc)
  · obtain ⟨m, hm⟩ := Polynomial.exists_int_eval_hilbertPoly_map_intCast (F := ℚ) h e z
    have hQz : Q.eval z = ((e - 1).factorial : ℤ) * m := by
      apply Int.cast_injective (α := ℚ)
      simpa [hm] using hQrat_mul z
    refine ⟨m, HasUniqueDiv.nsmul_right_injective (Nat.factorial_ne_zero (e - 1)) ?_⟩
    have h1 := congrArg (Polynomial.eval (z : R)) hPQ
    simpa [Polynomial.eval_smul, hQeval_map z, hQz, nsmul_eq_mul] using h1

/-- **Hilbert–Serre for finitely generated algebras.** If `B` is a commutative `A`-algebra
generated over an Artinian ring `A` by finitely many elements `f : σ → B` each shifting a
`ℤ`-grading `ℳ` of a finitely generated `B`-module `M` by `1`, then `M` satisfies the
Hilbert–Serre theorem with denominator `(1 - X) ^ Fintype.card σ`. -/
theorem hilbertSerre_of_adjoin_eq_top {A : Type u} [CommRing A] [IsArtinianRing A]
    {B : Type*} [CommSemiring B] [Algebra A B] {σ : Type v} [Fintype σ] {f : σ → B}
    (hgen : Algebra.adjoin A (Set.range f) = ⊤)
    {M : Type w} [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M] (ℳ : ℤ → Submodule A M) [DirectSum.Decomposition ℳ]
    (hf : ∀ (i : σ) (j : ℤ) (m : M), m ∈ ℳ j → f i • m ∈ ℳ (j + 1)) :
    (∀ d, Module.Finite A (ℳ d) ∧ Module.length A (ℳ d) ≠ ⊤) ∧
      ∃ (d₀ : ℤ) (h : Polynomial ℤ) (P : Polynomial ℚ) (N : ℤ),
        (∀ d < d₀, ℳ d = ⊥) ∧
        (PowerSeries.mk (fun n : ℕ =>
          ((Module.length A (ℳ (d₀ + n))).toNat : ℤ))) *
          (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries ∧
        P.degree < (Fintype.card σ : WithBot ℕ) ∧
        ∀ d, N ≤ d → P.eval (d : ℚ) = ((Module.length A (ℳ d)).toNat : ℚ) := by
  let φ : MvPolynomial σ A →ₐ[A] B := MvPolynomial.aeval f
  have hsurj : Function.Surjective φ := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval]
    exact hgen
  let : Module (MvPolynomial σ A) M := Module.compHom M φ.toRingHom
  have : IsScalarTower A (MvPolynomial σ A) M := φ.isScalarTower_compHom
  let : Algebra (MvPolynomial σ A) B := φ.toRingHom.toAlgebra
  have : IsScalarTower (MvPolynomial σ A) B M :=
    IsScalarTower.of_algebraMap_smul fun p m ↦ by
      simp [RingHom.algebraMap_toAlgebra, MulAction.compHom_smul_def]
  have : Module.Finite (MvPolynomial σ A) B :=
    Module.Finite.of_surjective (Algebra.linearMap (MvPolynomial σ A) B) hsurj
  have : Module.Finite (MvPolynomial σ A) M := Module.Finite.trans B M
  have hgraded' : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ A),
      p ∈ MvPolynomial.homogeneousSubmodule σ A i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i) :=
    fun i j p hp m hm ↦ by
      rw [MulAction.compHom_smul_def]
      simpa [φ] using hp.aeval_smul_mem (r := (1 : ℤ)) hf hm
  exact hilbertSerre A σ M ℳ hgraded'

/-- **Hilbert–Serre over a field.** For a finitely generated `ℤ`-graded module `M` over a standard
polynomial ring `MvPolynomial σ k` over a field `k`, the shifted generating series has graded-piece
dimensions `Module.finrank k (ℳ d)` as coefficients and equals `h(X) / (1 - X)^e`, while the
eventual rational polynomial `P : ℚ[X]` of degree strictly less than `e` agrees with
`Module.finrank k (ℳ d)` in all sufficiently high degrees and takes integer values at every
integer. -/
theorem hilbertSerre_field (k : Type u) [Field k]
    (σ : Type v) [Fintype σ] (M : Type w) [AddCommGroup M] [Module k M]
    [Module (MvPolynomial σ k) M] [IsScalarTower k (MvPolynomial σ k) M]
    [Module.Finite (MvPolynomial σ k) M]
    (ℳ : ℤ → Submodule k M) [DirectSum.Decomposition ℳ]
    (hgraded : ∀ (i : ℕ) (j : ℤ) (p : MvPolynomial σ k),
      p ∈ MvPolynomial.homogeneousSubmodule σ k i → ∀ m ∈ ℳ j, p • m ∈ ℳ (j + i)) :
    (∀ d, Module.Finite k (ℳ d)) ∧
      ∃ (d₀ : ℤ) (h : Polynomial ℤ) (P : Polynomial ℚ) (N : ℤ),
        (∀ d < d₀, ℳ d = ⊥) ∧
        (PowerSeries.mk (fun n : ℕ => (Module.finrank k (ℳ (d₀ + n)) : ℤ))) *
          (1 - PowerSeries.X) ^ Fintype.card σ = h.toPowerSeries ∧
        P.degree < (Fintype.card σ : WithBot ℕ) ∧
        (∀ z : ℤ, ∃ m : ℤ, P.eval (z : ℚ) = m) ∧
        ∀ d, N ≤ d → P.eval (d : ℚ) = (Module.finrank k (ℳ d) : ℚ) := by
  obtain ⟨hfin, d₀, h, P, N, hd₀, hh, hdeg, hP⟩ := hilbertSerre k σ M ℳ hgraded
  have hlen (d : ℤ) : (Module.length k (ℳ d)).toNat = Module.finrank k (ℳ d) := by
    have : Module.Finite k (ℳ d) := (hfin d).1
    rw [Module.length_eq_finrank, ENat.toNat_natCast]
  have hint := (exists_int_eval_of_eventually_eval_length ℳ hgraded hP).2
  refine ⟨fun d ↦ (hfin d).1, d₀, h, P, N, hd₀, ?_, hdeg, hint, fun d hd ↦ ?_⟩
  · simpa only [hlen] using hh
  · simpa only [hlen] using hP d hd

end HilbertSerre

end TauCeti.GradedModule
