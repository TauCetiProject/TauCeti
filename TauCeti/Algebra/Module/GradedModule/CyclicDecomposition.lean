module

public import TauCeti.Algebra.Module.GradedModule.HomogeneousBasis
public import TauCeti.Order.SupIndep
public import Mathlib.LinearAlgebra.Dual.Lemmas

/-!
# Homogeneous cyclic decomposition of graded `k[X]`-modules

Let `k` be a field and `M` a finitely generated `k[X]`-module with an internal `ℤ`-grading on
which `X` lowers degree by a fixed nonzero `d`. This file completes the structure theorem for such
modules: `M` is the internal direct sum of cyclic submodules `k[X] ∙ t` generated by homogeneous
elements `t`, each of which is either free (an `X`-tower) or isomorphic to `k[X] ⧸ (X ^ m)` for
some `m ≠ 0`. The free summands come from
`TauCeti.InternalGrading.exists_linearIndependent_isCompl_torsion`; the new input is the
decomposition of the torsion submodule.

The torsion summands are split off one at a time. Let `L` be a homogeneous submodule killed by
`X ^ m`, and `t ∈ L` a homogeneous element of degree `p` with `X ^ (m - 1) • t ≠ 0`. Choose a
`k`-linear functional `φ` that sees only the homogeneous component of degree
`q = p - (m - 1) * d` and takes the value `1` on `X ^ (m - 1) • t`. Since the elements `X ^ l • t`
lie in the distinct degrees `p - l * d`, the functional `φ` vanishes on all of them except
`X ^ (m - 1) • t`. The elements `y ∈ L` with `φ (a • y) = 0` for every polynomial `a` then form a
homogeneous complement of `k[X] ∙ t` in `L`. Repeating this inside the complement builds a
strictly increasing chain of submodules of `M`, which stops because `M` is Noetherian.

## Main results

* `TauCeti.InternalGrading.exists_disjoint_span_singleton_sup_eq`: a cyclic submodule generated by
  a homogeneous element of maximal order has a homogeneous complement.
* `TauCeti.InternalGrading.exists_iSupIndep_iSup_span_singleton_eq_of_le_torsion`: a homogeneous
  torsion submodule is an independent sum of finitely many cyclic submodules `k[X] ∙ t` with
  homogeneous `t` and annihilator `(X ^ m)`, `m ≠ 0`.
* `TauCeti.InternalGrading.exists_isInternal_span_singleton`: the structure theorem; `M` is the
  internal direct sum of homogeneous free cyclic submodules and finitely many homogeneous cyclic
  submodules with annihilators `(X ^ m)`, `m ≠ 0`.

## References

* P. Ozsváth, A. Stipsicz, Z. Szabó, *Grid Homology for Knots and Links*, AMS Mathematical Surveys
  and Monographs 208, 2015, Appendix A: the structure of finitely generated graded modules over
  `𝔽[U]`.
-/

public section

open Polynomial

namespace TauCeti.InternalGrading

universe u

variable {k : Type*} {M : Type u} [Field k] [AddCommGroup M] [Module k M] [Module k[X] M]
  [IsScalarTower k k[X] M] {G : InternalGrading k M} {d : ℕ}

/-- **Splitting off a cyclic summand of maximal order.** Let `X` lower degree by `d ≠ 0`, let `L`
be a homogeneous `k[X]`-submodule killed by `X ^ m`, and let `t ∈ L` be homogeneous with
`X ^ (m - 1) • t ≠ 0`. Then the cyclic submodule `k[X] ∙ t` has a homogeneous complement in `L`. -/
theorem exists_disjoint_span_singleton_sup_eq (hd : d ≠ 0)
    (hX : ∀ ⦃p : ℤ⦄ ⦃x : M⦄, x ∈ G.piece p → (X : k[X]) • x ∈ G.piece (p - d))
    {L : Submodule k[X] M} (hL : DirectSum.SetLike.IsHomogeneous G.piece L) {m : ℕ}
    (hLm : ∀ y ∈ L, (X ^ m : k[X]) • y = 0) {p : ℤ} {t : M} (htL : t ∈ L) (htp : t ∈ G.piece p)
    (ht : (X ^ (m - 1) : k[X]) • t ≠ 0) :
    ∃ K : Submodule k[X] M, DirectSum.SetLike.IsHomogeneous G.piece K ∧
      Disjoint (k[X] ∙ t) K ∧ (k[X] ∙ t) ⊔ K = L := by
  classical
  have hm : m ≠ 0 := by
    rintro rfl
    exact ht (by simpa using hLm t htL)
  have hdz : (d : ℤ) ≠ 0 := by exact_mod_cast hd
  -- `φ` reads off the component of degree `q` and sends `X ^ (m - 1) • t` to `1`.
  set q : ℤ := p - ((m - 1 : ℕ) : ℤ) * d
  have hv : (X ^ (m - 1) : k[X]) • t ∈ G.piece q := X_pow_smul_mem_piece hX (m - 1) htp
  obtain ⟨φ₀, hφ₀⟩ := Module.Projective.exists_dual_eq_one k
    (x := (⟨_, hv⟩ : G.piece q)) (by simpa [← Subtype.coe_ne_coe] using ht)
  let φ : M →ₗ[k] k := φ₀ ∘ₗ DirectSum.component k ℤ (fun i ↦ G.piece i) q ∘ₗ
    (DirectSum.decomposeLinearEquiv G.piece).toLinearMap
  have hφ (y : M) : φ y = φ₀ (DirectSum.decompose G.piece y q) := rfl
  -- On a polynomial multiple, `φ` only sees the values on the `X ^ n`-multiples.
  have hφ_poly (a : k[X]) (z : M) :
      φ (a • z) = ∑ n ∈ a.support, a.coeff n * φ ((X ^ n : k[X]) • z) := by
    conv_lhs => rw [a.as_sum_support_C_mul_X_pow, Finset.sum_smul]
    rw [map_sum]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    rw [mul_smul, ← algebraMap_eq, algebraMap_smul, map_smul, smul_eq_mul]
  -- Of the elements `X ^ l • t`, only `X ^ (m - 1) • t` lies in degree `q`.
  have hφt (l : ℕ) : φ ((X ^ l : k[X]) • t) = if l = m - 1 then 1 else 0 := by
    split_ifs with hl
    · subst hl
      rw [hφ, ← hφ₀]
      exact congrArg φ₀ (Subtype.ext (DirectSum.decompose_of_mem_same _ hv))
    · have hmem := X_pow_smul_mem_piece hX l htp
      have hne : p - (l : ℤ) * d ≠ q := fun h ↦ hl <| by
        have : (l : ℤ) * d = ((m - 1 : ℕ) : ℤ) * d := by omega
        exact_mod_cast mul_right_cancel₀ hdz this
      rw [hφ, Submodule.coe_eq_zero.mp (DirectSum.decompose_of_mem_ne _ hmem hne), map_zero]
  have hφXt (a : k[X]) (j : ℕ) :
      φ ((X ^ j : k[X]) • a • t) = if j ≤ m - 1 then a.coeff (m - 1 - j) else 0 := by
    rw [smul_comm, hφ_poly]
    simp_rw [← mul_smul, ← pow_add, hφt, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite, Finset.sum_const_zero, add_zero]
    split_ifs with hj
    · by_cases hc : a.coeff (m - 1 - j) = 0
      · refine (Finset.sum_eq_zero fun n hn ↦ ?_).trans hc.symm
        rw [Finset.mem_filter] at hn
        rwa [show n = m - 1 - j by omega]
      · rw [Finset.sum_eq_single_of_mem (m - 1 - j)
          (Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc, by omega⟩)]
        intro n hn hne
        rw [Finset.mem_filter] at hn
        omega
    · exact Finset.sum_eq_zero fun n hn ↦ by
        rw [Finset.mem_filter] at hn
        omega
  -- The complement: elements of `L` all of whose polynomial multiples are killed by `φ`.
  let K : Submodule k[X] M :=
    { carrier := {y | y ∈ L ∧ ∀ a : k[X], φ (a • y) = 0}
      add_mem' := fun {y z} hy hz ↦ ⟨L.add_mem hy.1 hz.1, fun a ↦ by
        rw [smul_add, map_add, hy.2, hz.2, add_zero]⟩
      zero_mem' := ⟨L.zero_mem, fun a ↦ by rw [smul_zero, map_zero]⟩
      smul_mem' := fun b y hy ↦ ⟨L.smul_mem b hy.1, fun a ↦ by rw [← mul_smul, hy.2]⟩ }
  have hmemK {y : M} : y ∈ K ↔ y ∈ L ∧ ∀ j : ℕ, φ ((X ^ j : k[X]) • y) = 0 := by
    refine ⟨fun h ↦ ⟨h.1, fun j ↦ h.2 _⟩, fun h ↦ ⟨h.1, fun a ↦ ?_⟩⟩
    rw [hφ_poly]
    exact Finset.sum_eq_zero fun n _ ↦ by rw [h.2 n, mul_zero]
  refine ⟨K, fun r y hy ↦ ?_, ?_, ?_⟩
  · -- Homogeneity: `φ (X ^ j • y_r)` is either `0` or `φ (X ^ j • y)`.
    refine hmemK.mpr ⟨hL r hy.1, fun j ↦ ?_⟩
    have hmem := X_pow_smul_mem_piece hX j (DirectSum.decompose G.piece y r).2
    by_cases hr : r - (j : ℤ) * d = q
    · have key := coe_decompose_X_pow_smul hX j q y
      rw [show q + (j : ℤ) * d = r by omega] at key
      rw [← key, hφ,
        Subtype.ext (DirectSum.decompose_of_mem_same _ (DirectSum.decompose G.piece _ q).2)]
      exact (hmemK.mp hy).2 j
    · rw [hφ, Submodule.coe_eq_zero.mp (DirectSum.decompose_of_mem_ne _ hmem hr), map_zero]
  · -- Disjointness: a nonzero `a • t` has a nonzero coefficient seen by some `φ (X ^ j • _)`.
    refine Submodule.disjoint_def.mpr fun y hyt hyK ↦ ?_
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hyt
    by_contra hy
    obtain ⟨n, hn⟩ : ∃ n, a.coeff n • (X ^ n : k[X]) • t ≠ 0 := by
      by_contra! h
      refine hy ?_
      conv_lhs => rw [a.as_sum_support_C_mul_X_pow, Finset.sum_smul]
      exact Finset.sum_eq_zero fun n _ ↦ by rw [mul_smul, ← algebraMap_eq, algebraMap_smul, h n]
    have hnm : n ≤ m - 1 := by
      by_contra! hnm
      refine hn ?_
      rw [show n = (n - m) + m by omega, pow_add, mul_smul, hLm t htL, smul_zero, smul_zero]
    have := (hmemK.mp hyK).2 (m - 1 - n)
    rw [hφXt, ite_eq_left (by omega), show m - 1 - (m - 1 - n) = n by omega] at this
    exact hn (by rw [this, zero_smul])
  · -- Spanning: `y - ∑ i < m, φ (X ^ (m - 1 - i) • y) • X ^ i • t` lies in `K`.
    refine le_antisymm (sup_le ((Submodule.span_singleton_le_iff_mem _ _).mpr htL)
      fun y hy ↦ hy.1) fun y hy ↦ ?_
    set a : k[X] := ∑ i ∈ Finset.range m, C (φ ((X ^ (m - 1 - i) : k[X]) • y)) * X ^ i with ha
    have hcoeff (i : ℕ) : a.coeff i = if i < m then φ ((X ^ (m - 1 - i) : k[X]) • y) else 0 := by
      simp only [ha, finsetSum_coeff, coeff_C_mul_X_pow, Finset.sum_ite_eq, Finset.mem_range]
    have hrest : y - a • t ∈ K := by
      refine hmemK.mpr ⟨L.sub_mem hy (L.smul_mem a htL), fun j ↦ ?_⟩
      rw [smul_sub, map_sub, hφXt, sub_eq_zero]
      split_ifs with hj
      · rw [hcoeff, ite_eq_left (by omega), show m - 1 - (m - 1 - j) = j by omega]
      · rw [show j = (j - m) + m by omega, pow_add, mul_smul, hLm y hy, smul_zero, map_zero]
    rw [show y = a • t + (y - a • t) by abel]
    exact Submodule.add_mem_sup (Submodule.mem_span_singleton.mpr ⟨a, rfl⟩) hrest

/-- **The torsion part of the structure theorem.** Let `X` lower degree by `d ≠ 0` in a finitely
generated graded `k[X]`-module over a field. Then every homogeneous `k[X]`-submodule `L` contained
in the torsion submodule is the independent sum of finitely many cyclic submodules `k[X] ∙ t i`,
where each `t i` is homogeneous with annihilator `(X ^ m i)` for some `m i ≠ 0`. Thus each summand
is isomorphic to `k[X] ⧸ (X ^ m i)` (`Ideal.quotTorsionOfEquivSpanSingleton`). -/
theorem exists_iSupIndep_iSup_span_singleton_eq_of_le_torsion [Module.Finite k[X] M] (hd : d ≠ 0)
    (hX : ∀ ⦃p : ℤ⦄ ⦃x : M⦄, x ∈ G.piece p → (X : k[X]) • x ∈ G.piece (p - d))
    (L : Submodule k[X] M) (hL : DirectSum.SetLike.IsHomogeneous G.piece L)
    (hLT : L ≤ Submodule.torsion k[X] M) :
    ∃ (ι : Type u) (_ : Finite ι) (t : ι → M) (deg : ι → ℤ) (m : ι → ℕ),
      (∀ i, t i ∈ G.piece (deg i)) ∧ (∀ i, m i ≠ 0) ∧
      (∀ i, Ideal.torsionOf k[X] M (t i) = Ideal.span {X ^ m i}) ∧
      iSupIndep (fun i ↦ k[X] ∙ t i) ∧ ⨆ i, k[X] ∙ t i = L := by
  classical
  obtain ⟨N, hN⟩ := torsion_eq_torsionBy_X_pow hd hX (G := G)
  have hLN (y : M) (hy : y ∈ L) : (X ^ N : k[X]) • y = 0 :=
    (Submodule.mem_torsionBy_iff _ _).mp (hN ▸ hLT hy)
  -- The admissible finite sets of generators: homogeneous, with annihilator `(X ^ m)`, `m ≠ 0`,
  -- and generating independent cyclic submodules.
  let Good (s : Finset M) : Prop :=
    (∀ t ∈ s, ∃ p m, t ∈ G.piece p ∧ m ≠ 0 ∧ Ideal.torsionOf k[X] M t = Ideal.span {X ^ m}) ∧
      s.SupIndep (fun t ↦ k[X] ∙ t)
  -- Enlarge an admissible family spanning `S` with a homogeneous complement `K` of `S` in `L`,
  -- by Noetherian induction on `S`.
  have key : ∀ S : Submodule k[X] M, ∀ (s : Finset M) (K : Submodule k[X] M), Good s →
      s.sup (fun t ↦ k[X] ∙ t) = S → DirectSum.SetLike.IsHomogeneous G.piece K →
      Disjoint S K → S ⊔ K = L → ∃ s' : Finset M, Good s' ∧ s'.sup (fun t ↦ k[X] ∙ t) = L := by
    intro S
    induction S using IsNoetherian.induction with
    | hgt S ih =>
      intro s K hs hsS hK hSK hSKL
      by_cases hK0 : K = ⊥
      · exact ⟨s, hs, by rw [hsS, ← hSKL, hK0, sup_bot_eq]⟩
      have hKL : K ≤ L := hSKL ▸ le_sup_right
      -- `m` is the exponent of `K`: the least power of `X` killing it.
      have hex : ∃ m, ∀ y ∈ K, (X ^ m : k[X]) • y = 0 := ⟨N, fun y hy ↦ hLN y (hKL hy)⟩
      let m := Nat.find hex
      have hKm : ∀ y ∈ K, (X ^ m : k[X]) • y = 0 := Nat.find_spec hex
      have hm : m ≠ 0 := by
        intro hm0
        refine hK0 (eq_bot_iff.mpr fun y hy ↦ ?_)
        simpa [show m = 0 from hm0] using hKm y hy
      obtain ⟨y, hyK, hy⟩ : ∃ y ∈ K, (X ^ (m - 1) : k[X]) • y ≠ 0 := by
        by_contra! h
        exact Nat.find_min hex (show m - 1 < m by omega) h
      -- Some homogeneous component `t` of `y` still has `X ^ (m - 1) • t ≠ 0`.
      obtain ⟨r, hr⟩ : ∃ r, (X ^ (m - 1) : k[X]) • (DirectSum.decompose G.piece y r : M) ≠ 0 := by
        by_contra! h
        refine hy ?_
        rw [← DirectSum.sum_support_decompose G.piece y, Finset.smul_sum]
        exact Finset.sum_eq_zero fun r _ ↦ h r
      set t : M := (DirectSum.decompose G.piece y r : M)
      have htK : t ∈ K := hK r hyK
      have ht0 : t ≠ 0 := fun h ↦ hr (by rw [h, smul_zero])
      obtain ⟨K', hK', hCK', hCK'K⟩ :=
        exists_disjoint_span_singleton_sup_eq hd hX hK hKm htK
          (DirectSum.decompose G.piece y r).2 hr
      have hCK : k[X] ∙ t ≤ K := hCK'K ▸ le_sup_left
      have hCS : Disjoint (k[X] ∙ t) S := (hSK.mono_right hCK).symm
      -- The annihilator of `t` is `(X ^ m)`: it contains `X ^ m` but not `X ^ (m - 1)`.
      have htor : Ideal.torsionOf k[X] M t = Ideal.span {X ^ m} := by
        obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal (Ideal.torsionOf k[X] M t)).principal
        have hmem (n : ℕ) : X ^ n ∈ Ideal.torsionOf k[X] M t ↔ g ∣ X ^ n := by
          rw [hg, Ideal.submodule_span_eq, Ideal.mem_span_singleton]
        obtain ⟨i, him, hgi⟩ := (dvd_prime_pow prime_X m).mp
          ((hmem m).mp ((Ideal.mem_torsionOf_iff _ _).mpr (hKm t htK)))
        have him' : i = m := by
          by_contra hne
          refine hr ((Ideal.mem_torsionOf_iff _ _).mp ((hmem (m - 1)).mpr ?_))
          exact hgi.dvd.trans (pow_dvd_pow X (by omega))
        rw [hg, Ideal.submodule_span_eq, Ideal.span_singleton_eq_span_singleton.mpr hgi, him']
      refine ih (S ⊔ k[X] ∙ t) (lt_of_le_of_ne le_sup_left fun h ↦ ht0 ?_) (insert t s) K'
        ⟨?_, hs.2.insert ?_⟩ ?_ hK' ?_ ?_
      · exact (Submodule.disjoint_def.mp hCS) t (Submodule.mem_span_singleton_self t)
          (h ▸ Submodule.mem_sup_right (Submodule.mem_span_singleton_self t))
      · intro t' ht'
        rcases Finset.mem_insert.mp ht' with rfl | ht'
        · exact ⟨r, m, (DirectSum.decompose G.piece y r).2, hm, htor⟩
        · exact hs.1 t' ht'
      · rwa [hsS]
      · rw [Finset.sup_insert, hsS, sup_comm]
      · exact hCK'.disjoint_sup_left_of_disjoint_sup_right (hCK'K ▸ hSK)
      · rw [sup_assoc, hCK'K, hSKL]
  obtain ⟨s, hs, hsL⟩ := key ⊥ ∅ L ⟨by simp, Finset.supIndep_empty _⟩ (by simp) hL
    disjoint_bot_left (bot_sup_eq L)
  choose deg m hdeg hm hmt using hs.1
  refine ⟨s, inferInstance, (↑), fun t ↦ deg t t.2, fun t ↦ m t t.2, fun t ↦ hdeg t t.2,
    fun t ↦ hm t t.2, fun t ↦ hmt t t.2, hs.2.independent, ?_⟩
  rw [← hsL, Finset.sup_eq_iSup, iSup_subtype']

open scoped Classical in
/-- **The structure theorem for finitely generated graded `k[X]`-modules.** Let `X` lower degree
by `d ≠ 0` in a finitely generated graded `k[X]`-module `M` over a field. Then `M` is the internal
direct sum of cyclic submodules `k[X] ∙ t i` generated by homogeneous elements `t i`, indexed by
the disjoint union of two finite types: for `i` in the first, `t i` has zero annihilator, so
`k[X] ∙ t i` is a free `X`-tower; for `j` in the second, `t j` has annihilator `(X ^ m j)` with
`m j ≠ 0`, so `k[X] ∙ t j ≅ k[X] ⧸ (X ^ m j)`. -/
theorem exists_isInternal_span_singleton [Module.Finite k[X] M] (hd : d ≠ 0)
    (hX : ∀ ⦃p : ℤ⦄ ⦃x : M⦄, x ∈ G.piece p → (X : k[X]) • x ∈ G.piece (p - d)) :
    ∃ (ι κ : Type u) (_ : Finite ι) (_ : Finite κ) (t : ι ⊕ κ → M) (deg : ι ⊕ κ → ℤ)
      (m : κ → ℕ), (∀ i, t i ∈ G.piece (deg i)) ∧
      (∀ i, Ideal.torsionOf k[X] M (t (.inl i)) = ⊥) ∧ (∀ j, m j ≠ 0) ∧
      (∀ j, Ideal.torsionOf k[X] M (t (.inr j)) = Ideal.span {X ^ m j}) ∧
      DirectSum.IsInternal (fun i ↦ k[X] ∙ t i) := by
  obtain ⟨ι, b, degb, hb, hli, hcompl⟩ := exists_linearIndependent_isCompl_torsion hd hX (G := G)
  obtain ⟨κ, hκ, c, degc, m, hc, hm, hmc, hind, hsup⟩ :=
    exists_iSupIndep_iSup_span_singleton_eq_of_le_torsion hd hX _
      (isHomogeneous_torsion hd hX) le_rfl
  refine ⟨ι, κ, hli.finite_of_isNoetherian, hκ, Sum.elim b c, Sum.elim degb degc, m,
    Sum.rec hb hc, fun i ↦ ?_, hm, hmc, ?_⟩
  · refine eq_bot_iff.mpr fun a ha ↦ ?_
    have h := linearIndependent_iff.mp hli (Finsupp.single i a)
      (by simpa using (Ideal.mem_torsionOf_iff _ _).mp ha)
    simpa using h
  · have hfam : (fun i ↦ k[X] ∙ Sum.elim b c i) =
        Sum.elim (fun i ↦ k[X] ∙ b i) (fun j ↦ k[X] ∙ c j) := by
      ext1 (i | j) <;> rfl
    rw [hfam]
    refine DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
      (iSupIndep.sum_elim hli.iSupIndep_span_singleton hind ?_) ?_
    · rw [← Submodule.span_range_eq_iSup, hsup]
      exact hcompl.symm.disjoint
    · rw [iSup_sum]
      simp only [Sum.elim_inl, Sum.elim_inr]
      rw [← Submodule.span_range_eq_iSup, hsup]
      exact hcompl.symm.sup_eq_top

end TauCeti.InternalGrading
