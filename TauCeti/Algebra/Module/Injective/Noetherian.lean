module

public import Mathlib.Algebra.Module.Injective
public import Mathlib.Algebra.Module.LocalizedModule.IsLocalization
public import Mathlib.Algebra.Module.Torsion.PrimaryComponent
public import Mathlib.RingTheory.Filtration

/-!
# Injective modules over a Noetherian ring

Let `R` be a Noetherian commutative ring and `I` an injective `R`-module. This file proves the
algebraic facts about `I` on which the flasqueness of the associated quasi-coherent sheaf `I^~` on
`Spec R` rests.

* For every ideal `𝔞`, the `𝔞`-primary component
  `Γ_𝔞(I) = {x ∈ I | 𝔞ⁿ x = 0 for some n}` (Mathlib's `Ideal.primaryComponent`) is again an
  injective module. The proof is Baer's criterion: a map from an ideal `𝔟` to `Γ_𝔞(I)` is killed
  by a power `𝔞ⁿ`, because `𝔟` is finitely generated, and by the Artin–Rees lemma it therefore
  vanishes on `𝔞ᵐ ∩ 𝔟` for `m` large. It extends by zero to `𝔟 + 𝔞ᵐ`, hence to `R`, and the
  extension takes values in `Γ_𝔞(I)`.
* For every multiplicative subset `S`, the localization map `I → S⁻¹I` is surjective. If
  `ann(t)` is maximal among the annihilators of elements of `S`, then `ann(ts) = ann(t)` for all
  `s ∈ S`, so the map `(ts) → I`, `tsr ↦ trx`, is well defined; extending it to `R` produces a
  preimage of `x / s`.
* Combining the two, the localization map `I → S⁻¹I` is also surjective on `𝔞`-primary
  components: an element of `S⁻¹I` killed by a power of `𝔞` comes from an element of `I` killed
  by a power of `𝔞`. On `Spec R` this says that a section of `I^~` over `D(f)` supported on `V(𝔞)`
  extends to a global section supported on `V(𝔞)`.

## Main declarations

* `Ideal.exists_le_torsionBySet_pow_of_le_primaryComponent`: a finitely generated submodule of
  `Γ_𝔞(N)` is killed by a single power of `𝔞`, and `Ideal.mem_primaryComponent_span_iff`
  describes `Γ_𝔞(N)` when `𝔞` is generated by a finite set;
* `Ideal.injective_primaryComponent`: `Γ_𝔞(I)` is an injective module;
* `Module.Injective.surjective_of_isLocalizedModule`: every localization map out of `I` is
  surjective;
* `Module.Injective.primaryComponent_map_surjective`: every localization map out of `I` is
  surjective on `𝔞`-primary components.

## References

* R. Hartshorne, *Algebraic Geometry*, Chapter III, Lemma 3.2 and Proposition 3.3.
-/

public section

open Submodule

universe u v

namespace Ideal

variable {R : Type u} [CommRing R]

/-- A finitely generated submodule of the `𝔞`-primary component is killed by a single power of
`𝔞`: the primary component is the directed union of the submodules killed by `𝔞ⁿ`. -/
theorem exists_le_torsionBySet_pow_of_le_primaryComponent {N : Type*} [AddCommMonoid N]
    [Module R N] (𝔞 : Ideal R) {P : Submodule R N} (hP : P.FG)
    (h : P ≤ 𝔞.primaryComponent N) : ∃ n, P ≤ torsionBySet R N ↑(𝔞 ^ n) := by
  obtain ⟨_, ⟨n, rfl⟩, hn⟩ := (isCompactElement_iff_le_of_directed_sSup_le _).mp
    ((fg_iff_compact _).mp hP) (Set.range fun n ↦ torsionBySet R N ↑(𝔞 ^ n))
    (Set.range_nonempty _)
    (Monotone.directed_le fun i j hij ↦ torsionBySet_le_torsionBySet_pow i j hij 𝔞).directedOn_range
    (by rwa [sSup_range])
  exact ⟨n, hn⟩

/-- For an ideal generated by a finite set `G`, an element lies in the primary component exactly
when each generator `g ∈ G` kills it after raising to some power. -/
theorem mem_primaryComponent_span_iff {N : Type*} [AddCommMonoid N] [Module R N] (G : Finset R)
    {y : N} : y ∈ (span (G : Set R)).primaryComponent N ↔ ∀ g ∈ G, ∃ n : ℕ, g ^ n • y = 0 := by
  simp only [primaryComponent_mem, mem_torsionBySet_iff, Subtype.forall, SetLike.mem_coe]
  constructor
  · rintro ⟨n, hn⟩ g hg
    exact ⟨n, hn _ (pow_mem_pow (subset_span hg) n)⟩
  · intro h
    obtain ⟨n, hn⟩ := exists_pow_le_of_le_radical_of_fg (J := torsionOf R N y)
      (span_le.mpr fun g hg ↦ by
        obtain ⟨n, hn⟩ := h g hg
        exact ⟨n, (mem_torsionOf_iff _ _).mpr hn⟩)
      ⟨G, rfl⟩
    exact ⟨n, fun r hr ↦ (mem_torsionOf_iff _ _).mp (hn hr)⟩

variable [IsNoetherianRing R] {M : Type v} [AddCommGroup M] [Module R M] [Small.{v} R]
  [Module.Injective R M]

/-- **The `𝔞`-primary component of an injective module over a Noetherian ring is injective**
(Hartshorne, *Algebraic Geometry*, Lemma III.3.2). -/
instance injective_primaryComponent (𝔞 : Ideal R) :
    Module.Injective R (𝔞.primaryComponent M) := by
  refine Module.Baer.injective fun 𝔟 g ↦ ?_
  let g' : 𝔟 →ₗ[R] M := (𝔞.primaryComponent M).subtype ∘ₗ g
  -- `g` is killed by `𝔞ⁿ`, and by Artin–Rees `𝔞ᵐ ∩ 𝔟 ⊆ 𝔞ⁿ 𝔟` for `m` large.
  obtain ⟨n, hn⟩ := exists_le_torsionBySet_pow_of_le_primaryComponent 𝔞
    (P := LinearMap.range g') (by
      rw [LinearMap.range_eq_map]
      exact (IsNoetherian.noetherian (⊤ : Submodule R 𝔟)).map _)
    (by
      rintro _ ⟨x, rfl⟩
      exact (g x).2)
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔞 (𝔟 : Submodule R R)
  have hvanish : ∀ x : 𝔟, (x : R) ∈ 𝔞 ^ (n + k) → g' x = 0 := by
    intro x hx
    have hmem : (x : R) ∈ 𝔞 ^ n • (𝔟 : Submodule R R) := by
      have h := hk (n + k) (Nat.le_add_left k n)
      rw [Nat.add_sub_cancel] at h
      have hx' : (x : R) ∈ 𝔞 ^ (n + k) • (⊤ : Submodule R R) ⊓ 𝔟 := by
        refine ⟨?_, x.2⟩
        rwa [Ideal.smul_eq_mul, Ideal.mul_top]
      rw [h] at hx'
      exact Submodule.smul_mono le_rfl inf_le_right hx'
    -- `g'` vanishes on `𝔞ⁿ 𝔟`, since its values are killed by `𝔞ⁿ`.
    have key : ∀ y ∈ 𝔞 ^ n • (𝔟 : Submodule R R), ∀ hy : y ∈ 𝔟, g' ⟨y, hy⟩ = 0 := by
      intro y hy
      induction hy using Submodule.smul_induction_on' with
      | smul r hr z hz =>
        intro _
        have : g' ⟨r • z, 𝔟.smul_mem r hz⟩ = r • g' ⟨z, hz⟩ := by
          rw [← map_smul]
          rfl
        rw [this]
        exact (mem_torsionBySet_iff _ _).mp (hn ⟨⟨z, hz⟩, rfl⟩) ⟨r, hr⟩
      | add y₁ hy₁ y₂ hy₂ ih₁ ih₂ =>
        intro hy
        have hy₁' : y₁ ∈ 𝔟 := Submodule.smul_le_right hy₁
        have hy₂' : y₂ ∈ 𝔟 := Submodule.smul_le_right hy₂
        have : g' ⟨y₁ + y₂, hy⟩ = g' ⟨y₁, hy₁'⟩ + g' ⟨y₂, hy₂'⟩ := by
          rw [← map_add]
          rfl
        rw [this, ih₁ hy₁', ih₂ hy₂', add_zero]
    exact key x hmem x.2
  -- Extend `g'` by zero on `𝔞^(n + k)`, and then to all of `R` by injectivity of `M`.
  let φ : R →ₗ.[R] M := ⟨𝔟, g'⟩
  let ψ : R →ₗ.[R] M := ⟨𝔞 ^ (n + k), 0⟩
  have H : ∀ (x : φ.domain) (y : ψ.domain), (x : R) = y → φ x = ψ y := by
    intro x y hxy
    exact (hvanish x (hxy ▸ y.2)).trans (LinearMap.zero_apply _).symm
  obtain ⟨h, hh⟩ := Module.Baer.of_injective (R := R) (Q := M) inferInstance
    (𝔟 ⊔ 𝔞 ^ (n + k)) (φ.sup ψ H).toFun
  have hh₀ : ∀ r ∈ 𝔞 ^ (n + k), h r = 0 := by
    intro r hr
    rw [hh r (Submodule.mem_sup_right hr)]
    exact (LinearPMap.sup_apply H 0 ⟨r, hr⟩ _ (zero_add r)).trans (by simp [φ, ψ])
  -- The value `h 1` is killed by `𝔞^(n + k)`, so it lies in the primary component.
  have hmem : h 1 ∈ 𝔞.primaryComponent M := by
    refine (primaryComponent_mem _ _ _).mpr ⟨n + k, (mem_torsionBySet_iff _ _).mpr ?_⟩
    rintro ⟨r, hr⟩
    rw [← map_smul, smul_eq_mul, mul_one]
    exact hh₀ r hr
  refine ⟨LinearMap.toSpanSingleton R _ ⟨h 1, hmem⟩, fun x hx ↦ Subtype.ext ?_⟩
  rw [LinearMap.toSpanSingleton_apply, Submodule.coe_smul, ← map_smul, smul_eq_mul, mul_one,
    hh x (Submodule.mem_sup_left hx)]
  exact (LinearPMap.sup_apply H ⟨x, hx⟩ 0 _ (add_zero x)).trans (by simp [φ, ψ, g'])

end Ideal

variable {R : Type u} [CommRing R] [IsNoetherianRing R] {M : Type v} [AddCommGroup M]
  [Module R M] [Small.{v} R] [Module.Injective R M]

/-- **A localization of an injective module over a Noetherian ring is a quotient of it**
(Hartshorne, *Algebraic Geometry*, Proposition III.3.3): if `M` is injective and `f : M → M'` is a
localization map at a multiplicative subset `S`, then `f` is surjective. -/
theorem Module.Injective.surjective_of_isLocalizedModule (S : Submonoid R)
    {M' : Type*} [AddCommMonoid M'] [Module R M'] (f : M →ₗ[R] M') [IsLocalizedModule S f] :
    Function.Surjective f := by
  -- Choose `t ∈ S` whose annihilator is maximal among the annihilators of elements of `S`.
  obtain ⟨_, ⟨t, rfl⟩, hmax⟩ := set_has_maximal_iff_noetherian.mpr
    (inferInstance : IsNoetherian R R)
    (Set.range fun s : S ↦ LinearMap.ker (LinearMap.mulLeft R (s : R))) (Set.range_nonempty _)
  have hann : ∀ s : S, LinearMap.ker (LinearMap.mulLeft R ((t * s : S) : R)) =
      LinearMap.ker (LinearMap.mulLeft R (t : R)) := by
    intro s
    have hle : LinearMap.ker (LinearMap.mulLeft R (t : R)) ≤
        LinearMap.ker (LinearMap.mulLeft R ((t * s : S) : R)) := by
      intro r hr
      simp only [LinearMap.mem_ker, LinearMap.mulLeft_apply, Submonoid.coe_mul] at hr ⊢
      rw [mul_right_comm, hr, zero_mul]
    exact (eq_of_le_of_not_lt hle (hmax _ ⟨t * s, rfl⟩)).symm
  intro y
  obtain ⟨⟨x, s⟩, hs⟩ := IsLocalizedModule.surj S f y
  -- The map `R / ann(ts) → M`, `r ↦ r t x`, extends along multiplication by `ts`.
  let K := LinearMap.ker (LinearMap.mulLeft R ((t * s : S) : R))
  let i : (R ⧸ K) →ₗ[R] R := K.liftQ (LinearMap.mulLeft R ((t * s : S) : R)) le_rfl
  have hi : Function.Injective i := by
    rw [← LinearMap.ker_eq_bot]
    exact K.ker_liftQ_eq_bot _ _ le_rfl
  let g : (R ⧸ K) →ₗ[R] M := K.liftQ (LinearMap.toSpanSingleton R M ((t : R) • x)) (by
    intro r hr
    replace hr : r ∈ LinearMap.ker (LinearMap.mulLeft R (t : R)) := hann s ▸ hr
    simp only [LinearMap.mem_ker, LinearMap.mulLeft_apply, LinearMap.toSpanSingleton_apply]
      at hr ⊢
    rw [smul_smul, mul_comm, hr, zero_smul])
  obtain ⟨h, hh⟩ := (Module.Baer.of_injective (R := R) (Q := M) inferInstance).extension_property
    i hi g
  have h₁ : ((t * s : S) : R) • h 1 = (t : R) • x := by
    have := LinearMap.congr_fun hh (K.mkQ 1)
    simp only [LinearMap.comp_apply, i, g, Submodule.mkQ_apply, Submodule.liftQ_apply,
      LinearMap.mulLeft_apply, mul_one, LinearMap.toSpanSingleton_apply, one_smul] at this
    rw [← this, ← map_smul, smul_eq_mul, mul_one]
  refine ⟨h 1, ?_⟩
  -- Both sides agree after multiplying by `ts`, which acts invertibly on `M'`.
  apply ((Module.End.isUnit_iff _).mp (IsLocalizedModule.map_units f (t * s))).1
  simp only [Module.algebraMap_end_apply]
  rw [← map_smul, h₁, map_smul, ← hs, Submonoid.coe_mul, mul_smul, Submonoid.smul_def]

/-- **Localization of an injective module is surjective on primary components.** Let `M` be an
injective module over a Noetherian ring and `f : M → M'` a localization map at `S`. Every element
of `M'` killed by a power of an ideal `𝔞` is the image of an element of `M` killed by a power of
`𝔞`. -/
theorem Module.Injective.primaryComponent_map_surjective (𝔞 : Ideal R) (S : Submonoid R)
    {M' : Type*} [AddCommMonoid M'] [Module R M'] (f : M →ₗ[R] M') [IsLocalizedModule S f] :
    Function.Surjective (Ideal.primaryComponent.map 𝔞 f) := by
  classical
  rintro ⟨y, hy⟩
  obtain ⟨G, rfl⟩ := (IsNoetherian.noetherian 𝔞 : 𝔞.FG)
  obtain ⟨⟨x, s⟩, hs⟩ := IsLocalizedModule.surj S f y
  -- Clearing denominators, some `c ∈ S` makes `c x` killed by powers of the generators of `𝔞`.
  have hloc : ∀ g ∈ G, ∃ c : S, ∃ n : ℕ, (c : R) • g ^ n • x = 0 := by
    intro g hg
    obtain ⟨n, hn⟩ := (Ideal.mem_primaryComponent_span_iff G).mp hy g hg
    obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_zero_iff S f).mp (by
      rw [map_smul, ← hs, smul_comm, hn, smul_zero] : f (g ^ n • x) = 0)
    exact ⟨c, n, hc⟩
  choose! c n hcn using hloc
  let c₀ : S := ∏ g ∈ G, c g
  have hx : (c₀ : R) • x ∈ (Ideal.span (G : Set R)).primaryComponent M := by
    refine (Ideal.mem_primaryComponent_span_iff G).mpr fun g hg ↦ ⟨n g, ?_⟩
    have hc₀ : ((c₀ : S) : R) = ((∏ g' ∈ G.erase g, c g' : S) : R) * (c g : R) := by
      rw [← Submonoid.coe_mul, mul_comm, Finset.mul_prod_erase G c hg]
    rw [hc₀, mul_smul, smul_comm (g ^ n g) ((∏ g' ∈ G.erase g, c g' : S) : R),
      smul_comm (g ^ n g) ((c g : S) : R), hcn g hg, smul_zero]
  -- The primary component is injective, so it surjects onto its own localization.
  obtain ⟨u, hu⟩ := Module.Injective.surjective_of_isLocalizedModule S
    (LocalizedModule.mkLinearMap S ((Ideal.span (G : Set R)).primaryComponent M))
    (LocalizedModule.mk ⟨_, hx⟩ (c₀ * s))
  obtain ⟨c', hc'⟩ := LocalizedModule.mk_eq.mp hu
  have h : f (((c' * (c₀ * s) : S) : R) • (u : M)) = f ((c' : R) • (c₀ : R) • x) := by
    have := congrArg (fun z : Ideal.primaryComponent M (span R (G : Set R)) ↦ f (z : M)) hc'
    simpa only [Submonoid.smul_def, Submodule.coe_smul, one_smul, Submonoid.coe_mul,
      mul_smul] using this
  refine ⟨u, Subtype.ext ?_⟩
  apply IsLocalizedModule.smul_injective f (c' * (c₀ * s))
  simp only [Ideal.primaryComponent.map_apply_coe, Submonoid.smul_def]
  rw [← map_smul, h, map_smul, map_smul, ← hs, Submonoid.coe_mul, Submonoid.coe_mul, mul_smul,
    mul_smul, Submonoid.smul_def]
