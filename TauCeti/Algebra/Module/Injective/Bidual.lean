module

public import Mathlib.Algebra.Module.Injective
public import Mathlib.RingTheory.Finiteness.Cardinality

/-!
# Evaluation into a double Hom

For an injective module `E`, surjectivity of the evaluation map into the double `E`-dual
passes to quotients, and descends to submodules whose cokernel is cogenerated by `E`. Over any
commutative semiring, injectivity, surjectivity, and bijectivity of evaluation into the double
`E`-dual are preserved and reflected by binary products, and surjectivity passes to finite
products.

If every endomorphism of `E` is scalar, evaluation is surjective on `E`, on finite powers of `E`,
and on finite free modules, and hence on every finitely generated module and on every submodule
of a finite power of `E` with cogenerated cokernel. Together with a cogenerator condition, this
gives biduality on both finitely generated and Artinian modules in Matlis duality over a complete
Noetherian local ring, as well as on mixed direct sums such as `R × E`.

The argument uses Mathlib's `LinearEquiv.piRing` to identify the dual of a finite free
module, and `Module.Injective.extension_property` to dualize an injection.

## References

* The Stacks Project, Proposition 47.7.8, Matlis duality, Tag 08Z9.
-/

public section

noncomputable section

universe u v w z

namespace LinearMap

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]
  {M : Type w} [AddCommGroup M] [Module R M]
  {N : Type z} [AddCommGroup N] [Module R N]

/-- Surjectivity of evaluation into the double dual with injective coefficients passes to
quotients. -/
theorem surjective_applyₗ_of_surjective [Small.{v} R] [Module.Injective R E]
    (f : M →ₗ[R] N) (hf : Function.Surjective f)
    (hM : Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E) := by
  intro φ
  obtain ⟨ψ, hψ⟩ := Module.Injective.extension_property R E _ _ (f.lcomp R E)
    (lcomp_injective_of_surjective f hf) φ
  obtain ⟨m, hm⟩ := hM ψ
  refine ⟨f m, LinearMap.ext fun g ↦ ?_⟩
  have h := LinearMap.congr_fun hψ g
  simpa [← hm] using h

/-- Surjectivity of evaluation into the double dual with injective coefficients descends along an
injective linear map whose cokernel is cogenerated by `E`. -/
theorem surjective_applyₗ_of_injective [Small.{v} R] [Module.Injective R E]
    (f : M →ₗ[R] N) (hf : Function.Injective f)
    (hcoker : Function.Injective
      (applyₗ : (N ⧸ range f) →ₗ[R] ((N ⧸ range f) →ₗ[R] E) →ₗ[R] E))
    (hN : Function.Surjective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) := by
  intro φ
  -- Restrict `φ` along `f` to a functional on `Hom_R(N, E)` and represent it by some `n : N`.
  obtain ⟨n, hn⟩ := hN (φ ∘ₗ f.lcomp R E)
  -- Every map `N → E` vanishing on `range f` kills `n`, so `n` lies in `range f`.
  have hn_zero : (applyₗ : (N ⧸ range f) →ₗ[R] ((N ⧸ range f) →ₗ[R] E) →ₗ[R] E)
      ((range f).mkQ n) = 0 := by
    ext k
    have hk : (k ∘ₗ (range f).mkQ) ∘ₗ f = 0 := by
      ext m
      simp [(Submodule.Quotient.mk_eq_zero (range f)).mpr (mem_range_self f m)]
    simpa [lcomp_apply', hk] using LinearMap.congr_fun hn (k ∘ₗ (range f).mkQ)
  obtain ⟨m, rfl⟩ := (Submodule.Quotient.mk_eq_zero (range f)).mp
    (hcoker (hn_zero.trans (map_zero _).symm))
  refine ⟨m, LinearMap.ext fun g ↦ ?_⟩
  obtain ⟨g', rfl⟩ := Module.Injective.extension_property R E M N f hf g
  simpa [lcomp_apply'] using LinearMap.congr_fun hn g'

end LinearMap

namespace TauCeti

open LinearMap

section Semiring

variable {R : Type u} [CommSemiring R] {E : Type v} [AddCommMonoid E] [Module R E]
  {M : Type w} [AddCommMonoid M] [Module R M]
  {N : Type z} [AddCommMonoid N] [Module R N]

/-- Evaluation into the double `E`-dual is injective on `M × N` if and only if it is injective on
both factors. -/
theorem injective_applyₗ_prod_iff :
    Function.Injective (applyₗ : (M × N) →ₗ[R] ((M × N) →ₗ[R] E) →ₗ[R] E) ↔
      Function.Injective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) ∧
        Function.Injective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E) := by
  constructor
  · intro h
    refine ⟨fun m₁ m₂ hm ↦ ?_, fun n₁ n₂ hn ↦ ?_⟩
    · refine congrArg Prod.fst (@h (m₁, 0) (m₂, 0) (LinearMap.ext fun f ↦ ?_))
      simpa using LinearMap.congr_fun hm (f ∘ₗ inl R M N)
    · refine congrArg Prod.snd (@h (0, n₁) (0, n₂) (LinearMap.ext fun f ↦ ?_))
      simpa using LinearMap.congr_fun hn (f ∘ₗ inr R M N)
  · rintro ⟨hM, hN⟩ ⟨m₁, n₁⟩ ⟨m₂, n₂⟩ h
    refine Prod.ext (hM (LinearMap.ext fun f ↦ ?_)) (hN (LinearMap.ext fun g ↦ ?_))
    · simpa using LinearMap.congr_fun h (f ∘ₗ fst R M N)
    · simpa using LinearMap.congr_fun h (g ∘ₗ snd R M N)

/-- Evaluation into the double `E`-dual is surjective on `M × N` if and only if it is surjective on
both factors. -/
theorem surjective_applyₗ_prod_iff :
    Function.Surjective (applyₗ : (M × N) →ₗ[R] ((M × N) →ₗ[R] E) →ₗ[R] E) ↔
      Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) ∧
        Function.Surjective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E) := by
  constructor
  · intro h
    refine ⟨fun φ ↦ ?_, fun ψ ↦ ?_⟩
    · obtain ⟨⟨m, n⟩, hmn⟩ := h (φ ∘ₗ (inl R M N).lcomp R E)
      refine ⟨m, LinearMap.ext fun f ↦ ?_⟩
      simpa [lcomp_apply', comp_assoc] using LinearMap.congr_fun hmn (f ∘ₗ fst R M N)
    · obtain ⟨⟨m, n⟩, hmn⟩ := h (ψ ∘ₗ (inr R M N).lcomp R E)
      refine ⟨n, LinearMap.ext fun g ↦ ?_⟩
      simpa [lcomp_apply', comp_assoc] using LinearMap.congr_fun hmn (g ∘ₗ snd R M N)
  · rintro ⟨hM, hN⟩ φ
    obtain ⟨m, hm⟩ := hM (φ ∘ₗ (fst R M N).lcomp R E)
    obtain ⟨n, hn⟩ := hN (φ ∘ₗ (snd R M N).lcomp R E)
    refine ⟨(m, n), LinearMap.ext fun f ↦ ?_⟩
    have hf : f = (f ∘ₗ inl R M N) ∘ₗ fst R M N + (f ∘ₗ inr R M N) ∘ₗ snd R M N := by
      apply LinearMap.ext
      rintro ⟨x, y⟩
      simp [← map_add]
    have h₁ := LinearMap.congr_fun hm (f ∘ₗ inl R M N)
    have h₂ := LinearMap.congr_fun hn (f ∘ₗ inr R M N)
    conv_rhs => rw [hf, map_add]
    simpa [lcomp_apply', ← map_add] using congrArg₂ (· + ·) h₁ h₂

/-- Evaluation into the double `E`-dual is bijective on `M × N` if and only if it is bijective on
both factors. -/
theorem bijective_applyₗ_prod_iff :
    Function.Bijective (applyₗ : (M × N) →ₗ[R] ((M × N) →ₗ[R] E) →ₗ[R] E) ↔
      Function.Bijective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) ∧
        Function.Bijective (applyₗ : N →ₗ[R] (N →ₗ[R] E) →ₗ[R] E) := by
  simp only [Function.Bijective, injective_applyₗ_prod_iff, surjective_applyₗ_prod_iff]
  tauto

/-- Surjectivity of evaluation into the double `E`-dual passes to finite products. -/
theorem surjective_applyₗ_pi {ι : Type*} [Finite ι] {P : ι → Type*}
    [∀ i, AddCommMonoid (P i)] [∀ i, Module R (P i)]
    (hP : ∀ i, Function.Surjective (applyₗ : P i →ₗ[R] (P i →ₗ[R] E) →ₗ[R] E)) :
    Function.Surjective (applyₗ : (∀ i, P i) →ₗ[R] ((∀ i, P i) →ₗ[R] E) →ₗ[R] E) := by
  classical
  let := Fintype.ofFinite ι
  intro φ
  choose p hp using fun i ↦ hP i (φ ∘ₗ (proj i).lcomp R E)
  refine ⟨p, LinearMap.ext fun f ↦ ?_⟩
  have hf : f = ∑ i, (f ∘ₗ single R P i) ∘ₗ proj i := by
    apply LinearMap.ext
    intro x
    conv_lhs => rw [← Finset.univ_sum_single x, map_sum]
    simp
  conv_rhs => rw [hf, map_sum]
  conv_lhs => rw [applyₗ_apply_apply, ← Finset.univ_sum_single p, map_sum]
  exact Finset.sum_congr rfl fun i _ ↦ by
    simpa [lcomp_apply'] using LinearMap.congr_fun (hp i) (f ∘ₗ single R P i)

/-- If every endomorphism of `E` is scalar, evaluation into the double `E`-dual of `E` itself is
surjective: a functional `φ` is evaluation at `φ id`. -/
theorem surjective_applyₗ_self_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id) :
    Function.Surjective (applyₗ : E →ₗ[R] (E →ₗ[R] E) →ₗ[R] E) := by
  intro φ
  refine ⟨φ LinearMap.id, LinearMap.ext fun f ↦ ?_⟩
  obtain ⟨r, rfl⟩ := hE f
  simp

/-- If every endomorphism of `E` is scalar, evaluation into the double `E`-dual of a finite power
of `E` is surjective. -/
theorem surjective_applyₗ_pi_self_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (ι : Type*) [Finite ι] :
    Function.Surjective (applyₗ : (ι → E) →ₗ[R] ((ι → E) →ₗ[R] E) →ₗ[R] E) :=
  surjective_applyₗ_pi fun _ ↦ surjective_applyₗ_self_of_end_eq_smul hE

/-- If every endomorphism of `E` is scalar, evaluation into the double `E`-dual of a finite
free module is surjective. -/
theorem surjective_applyₗ_pi_of_end_eq_smul
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (ι : Type*) [Finite ι] :
    Function.Surjective (applyₗ : (ι → R) →ₗ[R] ((ι → R) →ₗ[R] E) →ₗ[R] E) := by
  classical
  let := Fintype.ofFinite ι
  intro φ
  let e := LinearEquiv.piRing R E ι R
  let ψ := φ.comp e.symm.toLinearMap
  choose r hr using fun i ↦ hE (ψ.comp (LinearMap.single R (fun _ : ι ↦ E) i))
  refine ⟨r, LinearMap.ext fun f ↦ ?_⟩
  have hψ : ψ (e f) = ∑ i, r i • e f i := by
    conv_lhs => rw [← Finset.univ_sum_single (e f), map_sum]
    exact Finset.sum_congr rfl fun i _ ↦ LinearMap.congr_fun (hr i) (e f i)
  have hf : f r = ∑ i, r i • e f i := by
    simpa only [e, LinearEquiv.piRing_symm_apply] using
      congrArg (fun g : (ι → R) →ₗ[R] E ↦ g r) (e.symm_apply_apply f).symm
  simpa only [LinearMap.applyₗ_apply_apply] using
    hf.trans (by simpa [ψ] using hψ.symm)

end Semiring

variable {R : Type u} [CommRing R] {E : Type v} [AddCommGroup E] [Module R E]

/-- If `E` is injective and every endomorphism of `E` is scalar, every finitely generated
module maps surjectively onto its double `E`-dual by evaluation. -/
theorem surjective_applyₗ_of_finite_of_end_eq_smul [Small.{v} R] [Module.Injective R E]
    (hE : ∀ f : Module.End R E, ∃ r : R, f = r • LinearMap.id)
    (M : Type w) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Function.Surjective (applyₗ : M →ₗ[R] (M →ₗ[R] E) →ₗ[R] E) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  exact f.surjective_applyₗ_of_surjective hf (surjective_applyₗ_pi_of_end_eq_smul hE (Fin n))

end TauCeti
