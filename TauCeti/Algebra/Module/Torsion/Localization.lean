module

public import Mathlib.Algebra.Module.Torsion.Basic
public import Mathlib.RingTheory.Localization.BaseChange
public import TauCeti.Algebra.Module.Torsion.PrimaryComponent
import Mathlib.Algebra.Module.LocalizedModule.Submodule
import Mathlib.RingTheory.Flat.Localization
import TauCeti.Algebra.Module.LocalizedModule.BaseChange

/-!
# Torsion modules are those killed by localization

A module `M` over a commutative semiring `R` is `S`-torsion, for a submonoid `S` of `R`, exactly
when its base change `A ⊗[R] M` to a localization `A` of `R` at `S` vanishes: the base change is
a localization of `M` at `S`, and an element of `M` dies there exactly when some element of `S`
kills it. Taking `S` to be the nonzerodivisors, a module is torsion exactly when its base change to
the total ring of fractions vanishes. For abelian groups this is the classical characterization of
torsion groups as the groups `G` with `ℚ ⊗ G = 0`.

Localizing a torsion module at any submonoid gives a torsion module over the localized ring, since
non-zero-divisors stay non-zero-divisors after localization.

Since a localization `A` of `R` at `S` is flat, base change to `A` is exact. A linear map
therefore becomes injective (resp. surjective, bijective) over `A` exactly when its kernel (resp.
cokernel, both) is `S`-torsion; over the total ring of fractions this reads: torsion.

For an ideal generated by a finite set `G`, a module is ideal-power torsion exactly when its
localization at every generator is zero. This identifies modules supported on the closed set
`V(G)` without requiring finite generation of the module.

## Main results

* `Submonoid.isTorsion'_iff_subsingleton_tensorProduct`: `M` is `S`-torsion if and only if
  `A ⊗[R] M` is trivial, for a localization `A` of `R` at `S`.
* `TauCeti.Module.isTorsion_iff_subsingleton_tensorProduct`: `M` is torsion if and only if
  `K ⊗[R] M` is trivial, for the total ring of fractions `K` of `R`.
* `TauCeti.isAddTorsion_iff_subsingleton_rat_tensorProduct`: an abelian group `G` is torsion if
  and only if `ℚ ⊗[ℤ] G` is trivial.
* `LinearMap.baseChange_injective_iff_isTorsion'_ker`,
  `LinearMap.baseChange_surjective_iff_isTorsion'_coker`,
  `LinearMap.baseChange_bijective_iff_isTorsion'`: for a localization `A` of `R` at `S`,
  `f.baseChange A` is injective, surjective or bijective iff the kernel, the cokernel or both of
  `f` are `S`-torsion.
* `LinearMap.baseChange_injective_iff_isTorsion_ker`,
  `LinearMap.baseChange_surjective_iff_isTorsion_coker`,
  `LinearMap.baseChange_bijective_iff_isTorsion`: the same over the total ring of fractions `K`,
  with torsion kernel and cokernel.
* `Module.IsTorsion.of_isLocalizedModule`, `Module.IsTorsion.localizedModule`: the localization of
  a torsion module is torsion.
* `Module.IsTorsion'.isUnit_addOrderOf`: in an abelian group which is `S`-torsion for a submonoid
  `S` of `ℤ`, the order of every element is a unit of every ring in which `S` becomes invertible,
  such as the localization of `ℤ` at `S`.
* `Module.IsTorsionFree.mk_one_injective_of_isFractionRing`: a torsion-free module embeds in its
  base change `n ↦ 1 ⊗ n` to the total ring of fractions.
* `Ideal.primaryComponent_span_eq_top_iff_subsingleton_localized`: ideal-power torsion is detected
  by vanishing on the complementary principal opens.
-/

public section

open TensorProduct

namespace Submonoid

variable {R : Type*} [CommSemiring R] (S : Submonoid R) (A : Type*) [CommSemiring A] [Algebra R A]
  [IsLocalization S A] {M : Type*} [AddCommMonoid M] [Module R M]

/-- A module is `S`-torsion if and only if its base change to a localization at `S` is
trivial. -/
theorem isTorsion'_iff_subsingleton_tensorProduct :
    Module.IsTorsion' M S ↔ Subsingleton (A ⊗[R] M) := by
  rw [IsLocalizedModule.subsingleton_iff S (TensorProduct.mk R A M 1)]
  simp [Module.IsTorsion']

end Submonoid

namespace TauCeti

/-- A module is torsion if and only if its base change to the total ring of fractions is
trivial. -/
theorem Module.isTorsion_iff_subsingleton_tensorProduct {R : Type*} [CommSemiring R] (K : Type*)
    [CommSemiring K] [Algebra R K] [IsFractionRing R K] {M : Type*} [AddCommMonoid M]
    [Module R M] :
    Module.IsTorsion R M ↔ Subsingleton (K ⊗[R] M) :=
  (nonZeroDivisors R).isTorsion'_iff_subsingleton_tensorProduct K

/-- An abelian group `G` is torsion if and only if its rationalization `ℚ ⊗[ℤ] G` is trivial. -/
theorem isAddTorsion_iff_subsingleton_rat_tensorProduct {G : Type*} [AddCommGroup G] :
    IsAddTorsion G ↔ Subsingleton (ℚ ⊗[ℤ] G) :=
  isAddTorsion_iff_isTorsion_int.trans (Module.isTorsion_iff_subsingleton_tensorProduct ℚ)

end TauCeti

namespace LinearMap

open Function

variable {R : Type*} [CommRing R] {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N]
  [Module R N] (f : M →ₗ[R] N)

section Localization

variable (S : Submonoid R) (A : Type*) [CommRing A] [Algebra R A] [IsLocalization S A]

/-- The base change of a linear map to a localization at `S` is injective iff the kernel of the
map is `S`-torsion. -/
theorem baseChange_injective_iff_isTorsion'_ker :
    Injective (f.baseChange A) ↔ Module.IsTorsion' (ker f) S := by
  have := IsLocalization.flat A S
  -- Base change to the flat algebra `A` keeps `ker f → M → N` exact and `ker f → M` injective.
  have hex := Module.Flat.lTensor_exact A (exact_subtype_ker_map f)
  have hinj := Module.Flat.lTensor_preserves_injective_linearMap (M := A) _
    (ker f).injective_subtype
  rw [S.isTorsion'_iff_subsingleton_tensorProduct A, baseChange_eq_lTensor,
    injective_iff_map_eq_zero]
  refine ⟨fun h ↦ ⟨fun x y ↦ hinj ?_⟩, fun _ x hx ↦ ?_⟩
  · rw [h _ (hex.apply_apply_eq_zero x), h _ (hex.apply_apply_eq_zero y)]
  · obtain ⟨y, rfl⟩ := (hex x).mp hx
    rw [Subsingleton.elim y 0, map_zero]

/-- The base change of a linear map to a localization at `S` is surjective iff the cokernel of
the map is `S`-torsion. -/
theorem baseChange_surjective_iff_isTorsion'_coker :
    Surjective (f.baseChange A) ↔ Module.IsTorsion' (N ⧸ range f) S := by
  rw [IsLocalization.baseChange_surjective_iff S,
    LinearMap.localizedMap_surjective_iff_subsingleton_localized_coker,
    LocalizedModule.subsingleton_iff]
  simp [Module.IsTorsion']

/-- The base change of a linear map to a localization at `S` is bijective iff the kernel and the
cokernel of the map are `S`-torsion. -/
theorem baseChange_bijective_iff_isTorsion' :
    Bijective (f.baseChange A) ↔
      Module.IsTorsion' (ker f) S ∧ Module.IsTorsion' (N ⧸ range f) S :=
  and_congr (f.baseChange_injective_iff_isTorsion'_ker S A)
    (f.baseChange_surjective_iff_isTorsion'_coker S A)

end Localization

variable (K : Type*) [CommRing K] [Algebra R K] [IsFractionRing R K]

/-- The base change of a linear map to the total ring of fractions is injective iff the kernel of
the map is torsion. -/
theorem baseChange_injective_iff_isTorsion_ker :
    Injective (f.baseChange K) ↔ Module.IsTorsion R (ker f) :=
  f.baseChange_injective_iff_isTorsion'_ker (nonZeroDivisors R) K

/-- The base change of a linear map to the total ring of fractions is surjective iff the cokernel
of the map is torsion. -/
theorem baseChange_surjective_iff_isTorsion_coker :
    Surjective (f.baseChange K) ↔ Module.IsTorsion R (N ⧸ range f) :=
  f.baseChange_surjective_iff_isTorsion'_coker (nonZeroDivisors R) K

/-- The base change of a linear map to the total ring of fractions is bijective iff the kernel and
the cokernel of the map are torsion. -/
theorem baseChange_bijective_iff_isTorsion :
    Bijective (f.baseChange K) ↔
      Module.IsTorsion R (ker f) ∧ Module.IsTorsion R (N ⧸ range f) :=
  f.baseChange_bijective_iff_isTorsion' (nonZeroDivisors R) K

end LinearMap

namespace Module.IsTorsion

variable {R : Type*} [CommSemiring R] {M : Type*} [AddCommMonoid M] [Module R M]

/-- A localization `N` of a torsion module `M` at a submonoid `S` is torsion over any localization
`A` of the base ring at `S`. -/
theorem of_isLocalizedModule {A : Type*} [CommSemiring A] [Algebra R A] {N : Type*}
    [AddCommMonoid N] [Module R N] [Module A N] [IsScalarTower R A N] (hM : Module.IsTorsion R M)
    (S : Submonoid R) [IsLocalization S A] (f : M →ₗ[R] N) [IsLocalizedModule S f] :
    Module.IsTorsion A N := by
  intro x
  obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective S f x
  obtain ⟨⟨a, ha⟩, ham⟩ := @hM m
  refine ⟨⟨algebraMap R A a,
    IsLocalization.map_nonZeroDivisors_le S A (Submonoid.mem_map_of_mem _ ha)⟩, ?_⟩
  rw [Submonoid.mk_smul] at ham ⊢
  rw [Function.uncurry_apply_pair, algebraMap_smul, ← IsLocalizedModule.mk'_smul, ham,
    IsLocalizedModule.mk'_zero]

/-- The localization of a torsion module at a submonoid `S` is torsion over `Localization S`. -/
theorem localizedModule (hM : Module.IsTorsion R M) (S : Submonoid R) :
    Module.IsTorsion (Localization S) (LocalizedModule S M) :=
  hM.of_isLocalizedModule S (LocalizedModule.mkLinearMap S M)

end Module.IsTorsion

namespace Module.IsTorsion'

/-- In an abelian group in which every element is killed by an element of a submonoid `S` of `ℤ`,
the order of every element is a unit of any commutative ring `k` in which the elements of `S` are
units, for instance a localization of `ℤ` at `S`: it divides an element of `S`. -/
theorem isUnit_addOrderOf {A : Type*} [AddCommGroup A] {S : Submonoid ℤ}
    (h : Module.IsTorsion' A S) {k : Type*} [CommRing k] (hS : ∀ s ∈ S, IsUnit ((s : ℤ) : k))
    (a : A) : IsUnit (addOrderOf a : k) := by
  obtain ⟨s, hs⟩ := @h a
  rw [Submonoid.smul_def] at hs
  have hdvd : (addOrderOf a : ℤ) ∣ s := addOrderOf_dvd_iff_zsmul_eq_zero.2 hs
  simpa using isUnit_of_dvd_unit (map_dvd (Int.castRingHom k) hdvd) (hS s s.property)

end Module.IsTorsion'

namespace Module.IsTorsionFree

variable {R : Type*} [CommRing R] (K : Type*) [CommRing K] [Algebra R K] [IsFractionRing R K]
  {N : Type*} [AddCommMonoid N] [Module R N] [Module.IsTorsionFree R N]

/-- A torsion-free module embeds in its base change to the total ring of fractions `K`:
`n ↦ 1 ⊗ n` is injective. -/
theorem mk_one_injective_of_isFractionRing : Function.Injective (TensorProduct.mk R K N 1) :=
  (IsLocalizedModule.injective_iff_isRegular (nonZeroDivisors R) _).mpr fun c ↦
    isSMulRegular (isRegular_iff_mem_nonZeroDivisors.mpr c.property)

variable {K} in
/-- In a torsion-free module, an element `n` with `1 ⊗ n = 0` in the base change to the total
ring of fractions is zero. -/
theorem eq_zero_of_one_tmul_eq_zero {n : N} (h : (1 : K) ⊗ₜ[R] n = 0) : n = 0 :=
  (map_eq_zero_iff _ (mk_one_injective_of_isFractionRing K)).mp h

end Module.IsTorsionFree

namespace Ideal

/-- A module is torsion for the ideal generated by a finite set `G` exactly when its
localizations at the generators vanish. The module need not be finitely generated. -/
theorem primaryComponent_span_eq_top_iff_subsingleton_localized {R : Type*} [CommRing R]
    {M : Type*} [AddCommMonoid M] [Module R M] (G : Finset R) :
    (span (G : Set R)).primaryComponent M = ⊤ ↔
      ∀ g ∈ G, Subsingleton (LocalizedModule (.powers g) M) := by
  simp only [Submodule.eq_top_iff', mem_primaryComponent_span_iff,
    LocalizedModule.subsingleton_iff, Submonoid.mem_powers_iff, exists_exists_eq_and]
  exact ⟨fun h g hg m ↦ h m g hg, fun h m g hg ↦ h g hg m⟩

end Ideal
