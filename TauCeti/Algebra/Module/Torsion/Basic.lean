module

public import Mathlib.Algebra.Module.Torsion.Basic

/-!
# Torsion subgroups, products, and maps

A subgroup of an additive commutative group consists of torsion points as soon as it is finite:
its cardinality annihilates each of its elements, so a subgroup `H` is contained in the
`Nat.card H`-torsion subgroup. For finite `H` this says that a subgroup with `n` elements is
`n`-torsion; for infinite `H` one has `Nat.card H = 0` and the statement is the trivial
`H ≤ A[0]`.

A linear map `f` with a left inverse up to multiplication by a nonzerodivisor `a`, that is
`g ∘ f = a • id`, reflects torsion: if `f x` is torsion then so is `x`. The quotient of a
commutative ring by an ideal containing a nonzerodivisor is a torsion module.

If the `n`-torsion lies in the cyclic subgroup generated by `n ^ k • y`, then the
`n ^ (k + 1)`-torsion lies in the cyclic subgroup generated by `y`. So when the `n`-torsion is
cyclic and every element is divisible by `n`, each `n ^ (k + 1)`-torsion subgroup is cyclic too,
generated by any `n ^ k`-th root of a generator of the `n`-torsion.

Over a commutative semiring without zero divisors, if each of finitely many elements has a
nonzero multiple in a submodule `N`, then a single nonzero scalar carries all of them into `N`:
the image of a finite family in the torsion of `M ⧸ N` has a common nonzero annihilator.

Torsion also commutes with products and additive equivalences. When `a ∣ b`, the `a`-torsion
inside the `b`-torsion subgroup is the ambient `a`-torsion subgroup. Linear maps send torsion
elements to torsion elements, so submodules and linear images of torsion modules are torsion, and
the torsion submodule of `M × N` is the product of the torsion submodules.

## Main definitions

* `TauCeti.AddSubgroup.torsionByPiEquiv`: torsion of a product is the product of torsions.
* `TauCeti.AddSubgroup.torsionByTorsionByEquiv`: nested torsion for `a ∣ b`.
* `AddEquiv.torsionByCongr`: transport torsion along an additive equivalence.
* `TauCeti.Submodule.torsionProdEquiv`: the torsion submodule of `M × N` is the product of the
  torsion submodules.

## Main results

* `AddSubgroup.le_torsionBy_natCard`: a subgroup `H` is contained in the `Nat.card H`-torsion
  subgroup.
* `AddSubgroup.torsionBy_pow_succ_le_zmultiples`: if `A[n] ≤ ⟨n ^ k • y⟩`, then
  `A[n ^ (k + 1)] ≤ ⟨y⟩`.
* `TauCeti.Submodule.comap_torsion_le_of_comp_eq_smul`: a linear map with a left inverse up to a
  nonzerodivisor reflects torsion.
* `LinearMap.le_comap_torsion`: a linear map sends torsion elements to torsion elements.
* `TauCeti.Submodule.prodMk_mem_torsion`: a pair of torsion elements is torsion.
* `Module.IsTorsion.of_injective`, `Module.IsTorsion.of_surjective`, `Module.IsTorsion.prod`:
  submodules, linear images and products of torsion modules are torsion.
* `Submodule.exists_smul_mem_of_forall_exists_smul_mem`: finitely many elements with nonzero
  multiples in `N` have a common nonzero multiplier into `N`.
* `Ideal.isTorsion_quotient_of_mem`: the quotient of a commutative ring by an ideal
  containing a nonzerodivisor is a torsion module.
-/

public section

namespace AddSubgroup

/-- A subgroup `H` consists of `Nat.card H`-torsion points; for finite `H` this is the statement
that a subgroup with `n` elements is `n`-torsion, and for infinite `H` it is the trivial
`H ≤ A[0]`. -/
theorem le_torsionBy_natCard {A : Type*} [AddCommGroup A] {H : AddSubgroup A} :
    H ≤ A[(Nat.card H : ℤ)] := fun x hx ↦
  torsionBy.nsmul_iff.mpr <| by
    have : Nat.card H • (⟨x, hx⟩ : H) = 0 := card_nsmul_eq_zero'
    exact congrArg Subtype.val this

/-- If the `n`-torsion of `A` lies in the cyclic subgroup generated by `n ^ k • y`, then the
`n ^ (k + 1)`-torsion lies in the cyclic subgroup generated by `y`. For instance, if `A[p]` is
cyclic of prime order `p` and generated by `p ^ k • y`, then `A[p ^ (k + 1)]` is cyclic,
generated by `y`. -/
theorem torsionBy_pow_succ_le_zmultiples {A : Type*} [AddCommGroup A] {n : ℤ} {y : A} {k : ℕ}
    (h : A[n] ≤ zmultiples (n ^ k • y)) : A[n ^ (k + 1)] ≤ zmultiples y := by
  have mem {m : ℤ} {z : A} : z ∈ A[m] ↔ m • z = 0 := Submodule.mem_torsionBy_iff m z
  induction k generalizing y with
  | zero => simpa using h
  | succ k ih =>
    intro x hx
    -- `n • x` is `n ^ (k + 1)`-torsion, so a multiple of `n • y` by induction
    obtain ⟨m, hm⟩ : n • x ∈ zmultiples (n • y) := by
      refine ih (by rwa [smul_smul, ← pow_succ]) (mem.2 ?_)
      rw [smul_smul, ← pow_succ, mem.1 hx]
    -- so `x - m • y` is `n`-torsion, hence a multiple of `n ^ (k + 1) • y`
    have hxm : n • (x - m • y) = 0 := by rw [smul_sub, ← hm, smul_comm, sub_self]
    obtain ⟨m', hm'⟩ := h (mem.2 hxm)
    rw [← sub_add_cancel x (m • y), ← hm']
    exact add_mem (zsmul_mem (zsmul_mem_zmultiples y _) m') (zsmul_mem_zmultiples y m)

end AddSubgroup

namespace TauCeti

namespace AddSubgroup

/-- Torsion in a product of additive commutative groups is additively equivalent to the product
of their torsion subgroups. -/
def torsionByPiEquiv {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] (n : ℤ) :
    _root_.AddSubgroup.torsionBy (∀ i, A i) n ≃+
      (∀ i, _root_.AddSubgroup.torsionBy (A i) n) where
  toFun x i := ⟨x.1 i, by
    have hx : n • (x.1 : ∀ i, A i) = 0 :=
      (Submodule.mem_torsionBy_iff _ _).mp x.2
    exact (Submodule.mem_torsionBy_iff _ _).2 <|
      by simpa only [Pi.smul_apply, Pi.zero_apply] using congrFun hx i⟩
  invFun x := ⟨fun i ↦ x i, by
    apply (Submodule.mem_torsionBy_iff _ _).2
    ext i
    simpa only [Pi.smul_apply, Pi.zero_apply] using
      (Submodule.mem_torsionBy_iff _ _).mp (x i).2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- `torsionByPiEquiv` sends a torsion element to its pointwise torsion elements. -/
@[simp]
theorem torsionByPiEquiv_apply_coe {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)]
    (n : ℤ) (x : _root_.AddSubgroup.torsionBy (∀ i, A i) n) (i : ι) :
    ((torsionByPiEquiv A n x i : _root_.AddSubgroup.torsionBy (A i) n) : A i) = x.1 i :=
  by simp [torsionByPiEquiv]

/-- The inverse of `torsionByPiEquiv` assembles torsion elements pointwise. -/
@[simp]
theorem torsionByPiEquiv_symm_apply_coe {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)]
    (n : ℤ) (x : ∀ i, _root_.AddSubgroup.torsionBy (A i) n) (i : ι) :
    (((torsionByPiEquiv A n).symm x : _root_.AddSubgroup.torsionBy (∀ i, A i) n) :
      ∀ i, A i) i = (x i).1 :=
  by simp [torsionByPiEquiv]

/-- Torsion by `a` inside the `b`-torsion subgroup is the ambient `a`-torsion when `a ∣ b`. -/
def torsionByTorsionByEquiv {A : Type*} [AddCommGroup A] {a b : ℤ} (hab : a ∣ b) :
    _root_.AddSubgroup.torsionBy (_root_.AddSubgroup.torsionBy A b) a ≃+
      _root_.AddSubgroup.torsionBy A a := by
  have ha (x : _root_.AddSubgroup.torsionBy A a) : a • (x.1 : A) = 0 :=
    (Submodule.mem_torsionBy_iff _ _).mp x.2
  exact
    { toFun := fun x ↦ ⟨x.1.1, (Submodule.mem_torsionBy_iff _ _).2 <| by
          have hx := (Submodule.mem_torsionBy_iff _ _).mp x.2
          exact congrArg Subtype.val hx⟩
      invFun := fun x ↦
        ⟨⟨x.1, (Submodule.mem_torsionBy_iff _ _).2 <| by
            obtain ⟨c, rfl⟩ := hab
            calc
              (a * c) • (x.1 : A) = c • (a • (x.1 : A)) := by rw [mul_comm a c, mul_zsmul]
              _ = 0 := by simp only [ha x, smul_zero]⟩,
          (Submodule.mem_torsionBy_iff _ _).2 <| Subtype.ext <| ha x⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl
      map_add' := fun _ _ ↦ rfl }

/-- `torsionByTorsionByEquiv` preserves the underlying ambient element. -/
@[simp]
theorem torsionByTorsionByEquiv_apply_coe {A : Type*} [AddCommGroup A] {a b : ℤ} (hab : a ∣ b)
    (x : _root_.AddSubgroup.torsionBy (_root_.AddSubgroup.torsionBy A b) a) :
    ((torsionByTorsionByEquiv hab x : _root_.AddSubgroup.torsionBy A a) : A) = x.1.1 :=
  by simp [torsionByTorsionByEquiv]

/-- The inverse of `torsionByTorsionByEquiv` preserves the underlying ambient element. -/
@[simp]
theorem torsionByTorsionByEquiv_symm_apply_coe {A : Type*} [AddCommGroup A] {a b : ℤ}
    (hab : a ∣ b) (x : _root_.AddSubgroup.torsionBy A a) :
    (((torsionByTorsionByEquiv hab).symm x :
      _root_.AddSubgroup.torsionBy (_root_.AddSubgroup.torsionBy A b) a) : A) = x.1 :=
  by simp [torsionByTorsionByEquiv]

end AddSubgroup

end TauCeti

namespace AddEquiv

/-- An additive equivalence carries the `n`-torsion subgroup to the `n`-torsion subgroup. -/
def torsionByCongr {A B : Type*} [AddCommGroup A] [AddCommGroup B] (e : A ≃+ B) (n : ℤ) :
    _root_.AddSubgroup.torsionBy A n ≃+ _root_.AddSubgroup.torsionBy B n where
  toFun x := ⟨e x, by
    have hx : n • (x.1 : A) = 0 := (Submodule.mem_torsionBy_iff _ _).mp x.2
    apply (Submodule.mem_torsionBy_iff _ _).2
    calc
      n • e x = e (n • (x.1 : A)) := (map_zsmul e n x.1).symm
      _ = e 0 := congrArg e hx
      _ = 0 := map_zero e⟩
  invFun x := ⟨e.symm x, by
    have hx : n • (x.1 : B) = 0 := (Submodule.mem_torsionBy_iff _ _).mp x.2
    apply (Submodule.mem_torsionBy_iff _ _).2
    calc
      n • e.symm x = e.symm (n • (x.1 : B)) := (map_zsmul e.symm n x.1).symm
      _ = e.symm 0 := congrArg e.symm hx
      _ = 0 := map_zero e.symm⟩
  left_inv x := Subtype.ext (e.left_inv x)
  right_inv x := Subtype.ext (e.right_inv x)
  map_add' _ _ := Subtype.ext (e.map_add _ _)

/-- `torsionByCongr` applies its additive equivalence to the underlying element. -/
@[simp]
theorem torsionByCongr_apply_coe {A B : Type*} [AddCommGroup A] [AddCommGroup B] (e : A ≃+ B)
    (n : ℤ) (x : _root_.AddSubgroup.torsionBy A n) :
    ((torsionByCongr e n x : _root_.AddSubgroup.torsionBy B n) : B) = e x.1 :=
  by simp [torsionByCongr]

/-- The inverse of `torsionByCongr` applies the inverse additive equivalence. -/
@[simp]
theorem torsionByCongr_symm_apply_coe {A B : Type*} [AddCommGroup A] [AddCommGroup B]
    (e : A ≃+ B) (n : ℤ) (x : _root_.AddSubgroup.torsionBy B n) :
    (((torsionByCongr e n).symm x : _root_.AddSubgroup.torsionBy A n) : A) = e.symm x.1 :=
  by simp [torsionByCongr]

end AddEquiv

open scoped nonZeroDivisors

namespace TauCeti

namespace Submodule

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N]
  [Module R N]

/-- A linear map `f` for which some `g` satisfies `g ∘ f = a • id` with `a` a nonzerodivisor
reflects torsion: an element whose image is torsion is itself torsion. -/
theorem comap_torsion_le_of_comp_eq_smul {f : M →ₗ[R] N} {g : N →ₗ[R] M} {a : R} (ha : a ∈ R⁰)
    (hgf : ∀ x, g (f x) = a • x) :
    (_root_.Submodule.torsion R N).comap f ≤ _root_.Submodule.torsion R M := by
  intro x hx
  obtain ⟨b, hb⟩ := (_root_.Submodule.mem_torsion_iff _).mp
    (_root_.Submodule.mem_comap.mp hx)
  refine (_root_.Submodule.mem_torsion_iff x).mpr ⟨b * ⟨a, ha⟩, ?_⟩
  rw [mul_smul, Submonoid.smul_def ⟨a, ha⟩, ← hgf, Submonoid.smul_def, ← map_smul,
    ← Submonoid.smul_def, hb, map_zero]

/-- A linear map sends torsion elements to torsion elements. -/
theorem _root_.LinearMap.le_comap_torsion (f : M →ₗ[R] N) :
    _root_.Submodule.torsion R M ≤ (_root_.Submodule.torsion R N).comap f := fun x hx ↦ by
  obtain ⟨a, ha⟩ := (_root_.Submodule.mem_torsion_iff x).mp hx
  exact (_root_.Submodule.mem_torsion_iff _).mpr
    ⟨a, by rw [← LinearMap.map_smul_of_tower, ha, map_zero]⟩

/-- A pair of torsion elements is torsion: if `a • x = 0` and `b • y = 0`, then `(a * b)`
annihilates `(x, y)`. -/
theorem prodMk_mem_torsion {x : M} {y : N} (hx : x ∈ _root_.Submodule.torsion R M)
    (hy : y ∈ _root_.Submodule.torsion R N) : (x, y) ∈ _root_.Submodule.torsion R (M × N) := by
  obtain ⟨a, ha⟩ := (_root_.Submodule.mem_torsion_iff _).mp hx
  obtain ⟨b, hb⟩ := (_root_.Submodule.mem_torsion_iff _).mp hy
  refine (_root_.Submodule.mem_torsion_iff _).mpr ⟨a * b, Prod.ext ?_ ?_⟩
  · rw [Prod.smul_fst, mul_comm, mul_smul, ha, smul_zero, Prod.fst_zero]
  · rw [Prod.smul_snd, mul_smul, hb, smul_zero, Prod.snd_zero]

variable (R M N) in
/-- The torsion submodule of a product is the product of the torsion submodules. -/
def torsionProdEquiv :
    _root_.Submodule.torsion R (M × N) ≃ₗ[R]
      _root_.Submodule.torsion R M × _root_.Submodule.torsion R N where
  toFun x := (⟨x.1.1, (LinearMap.fst R M N).le_comap_torsion x.2⟩,
    ⟨x.1.2, (LinearMap.snd R M N).le_comap_torsion x.2⟩)
  invFun x := ⟨(x.1, x.2), prodMk_mem_torsion x.1.2 x.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The first component of `torsionProdEquiv` is the first coordinate. -/
@[simp]
theorem torsionProdEquiv_apply_fst_coe (x : _root_.Submodule.torsion R (M × N)) :
    ((torsionProdEquiv R M N x).1 : M) = (x : M × N).1 := by
  simp [torsionProdEquiv]

/-- The second component of `torsionProdEquiv` is the second coordinate. -/
@[simp]
theorem torsionProdEquiv_apply_snd_coe (x : _root_.Submodule.torsion R (M × N)) :
    ((torsionProdEquiv R M N x).2 : N) = (x : M × N).2 := by
  simp [torsionProdEquiv]

/-- The inverse of `torsionProdEquiv` pairs two torsion elements. -/
@[simp]
theorem torsionProdEquiv_symm_apply_coe
    (x : _root_.Submodule.torsion R M × _root_.Submodule.torsion R N) :
    ((torsionProdEquiv R M N).symm x : M × N) = ((x.1 : M), (x.2 : N)) := by
  simp [torsionProdEquiv]

end Submodule

end TauCeti

namespace Module.IsTorsion

variable {R M N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N]
  [Module R N]

/-- A module that embeds linearly into a torsion module is torsion. -/
theorem of_injective (hN : Module.IsTorsion R N) {f : M →ₗ[R] N} (hf : Function.Injective f) :
    Module.IsTorsion R M := fun x ↦ by
  obtain ⟨a, ha⟩ := @hN (f x)
  exact ⟨a, hf (by rw [LinearMap.map_smul_of_tower, ha, map_zero])⟩

/-- A linear image of a torsion module is torsion. -/
theorem of_surjective (hM : Module.IsTorsion R M) {f : M →ₗ[R] N} (hf : Function.Surjective f) :
    Module.IsTorsion R N := fun y ↦ by
  obtain ⟨x, rfl⟩ := hf y
  exact (_root_.Submodule.mem_torsion_iff _).mp
    (f.le_comap_torsion ((_root_.Submodule.mem_torsion_iff x).mpr (@hM x)))

/-- A product of two torsion modules is torsion. -/
theorem prod (hM : Module.IsTorsion R M) (hN : Module.IsTorsion R N) :
    Module.IsTorsion R (M × N) := fun x ↦
  (_root_.Submodule.mem_torsion_iff _).mp (TauCeti.Submodule.prodMk_mem_torsion
    ((_root_.Submodule.mem_torsion_iff _).mpr (@hM x.1))
    ((_root_.Submodule.mem_torsion_iff _).mpr (@hN x.2)))

end Module.IsTorsion

namespace Submodule

variable {R M : Type*} [CommSemiring R] [NoZeroDivisors R] [Nontrivial R] [AddCommMonoid M]
  [Module R M]

/-- If each `v i` with `i ∈ s` has a nonzero multiple in `N`, then a single nonzero scalar
carries every `v i` with `i ∈ s` into `N`. -/
theorem exists_smul_mem_of_forall_exists_smul_mem (N : Submodule R M) {ι : Type*}
    (s : Finset ι) {v : ι → M} (h : ∀ i ∈ s, ∃ r : R, r ≠ 0 ∧ r • v i ∈ N) :
    ∃ r : R, r ≠ 0 ∧ ∀ i ∈ s, r • v i ∈ N := by
  classical
  choose! r hr0 hr using h
  refine ⟨∏ i ∈ s, r i, Finset.prod_ne_zero_iff.mpr hr0, fun i hi ↦ ?_⟩
  rw [← Finset.prod_erase_mul _ _ hi, mul_smul]
  exact N.smul_mem _ (hr i hi)

end Submodule

namespace Ideal

/-- The quotient `R ⧸ I` of a commutative ring by an ideal containing a nonzerodivisor `a` is a
torsion `R`-module: `a` annihilates it. For instance `R ⧸ (a)` is torsion for every
nonzerodivisor `a`. -/
theorem isTorsion_quotient_of_mem {R : Type*} [CommRing R] {I : Ideal R} {a : R}
    (haI : a ∈ I) (ha : a ∈ R⁰) : Module.IsTorsion R (R ⧸ I) := by
  intro x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective I x
  refine ⟨⟨a, ha⟩, ?_⟩
  rw [Submonoid.mk_smul, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
    smul_eq_mul]
  exact I.mul_mem_right y haI

end Ideal
