module

public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.Algebra.Field.Subfield.Defs
import Mathlib.Algebra.Group.Submonoid.BigOperators

/-!
# Subfield containment for linear recurrences

Let `K` be a division ring, `E` a subfield-like subobject of `K` (such as a `Subfield K` or an
`IntermediateField F K`), and `a : ℕ → K` a sequence satisfying a variable-coefficient linear
recurrence

  `∑ i : Fin (r + 1), c n i * a (n + i) = 0`

whose coefficients `c n i` lie in `E` and whose leading coefficient `c n (Fin.last r)` is nonzero.
Whenever the first `r` terms of `a` lie in `E`, every term of `a` lies in `E`
(`TauCeti.mem_of_sum_mul_add_eq_zero`).

In applications to P-recursive (D-finite) power series, the leading polynomial coefficient may
vanish at finitely many natural numbers; the shifted form
`TauCeti.mem_of_sum_mul_add_eq_zero_of_le` applies once `n ≥ N` is past those roots, showing that
every term `a m` with `N ≤ m` lies in `E` provided `a m ∈ E` for `N ≤ m < N + r`. Together with a
finite extension generated by the recurrence coefficients and initial terms, this forces all
algebraic coefficients of a D-finite power series to lie in a single finite extension (or number
field).

## Main results

* `TauCeti.mem_of_sum_mul_add_eq_zero`: subfield containment for a sequence satisfying a linear
  recurrence with nonzero leading coefficient for all `n`.
* `TauCeti.mem_of_sum_mul_add_eq_zero_of_le`: shifted form for recurrences valid from an index
  `N` onward.
-/

public section

namespace TauCeti

/-- If a sequence `a : ℕ → K` in a division ring satisfies a linear recurrence
`∑ i : Fin (r + 1), c n i * a (n + i) = 0` for every `n` with coefficients `c n i` in a
subfield-like subobject `E` and nonzero leading coefficient `c n (Fin.last r) ≠ 0`, and the
initial terms `a m` for `m < r` lie in `E`, then `a m ∈ E` for every `m`. -/
theorem mem_of_sum_mul_add_eq_zero {K S : Type*} [DivisionRing K] [SetLike S K]
    [SubfieldClass S K] {E : S} {r : ℕ} {c : ℕ → Fin (r + 1) → K} {a : ℕ → K}
    (hcne : ∀ n, c n (Fin.last r) ≠ 0)
    (hrec : ∀ n, ∑ i : Fin (r + 1), c n i * a (n + i) = 0)
    (hcmem : ∀ n i, c n i ∈ E)
    (hinit : ∀ m < r, a m ∈ E) (m : ℕ) :
    a m ∈ E := by
  induction m using Nat.strong_induction_on with
  | ind m ih =>
    by_cases hm : m < r
    · exact hinit m hm
    · set n : ℕ := m - r
      have hmr : n + r = m := by omega
      have hsum := hrec n
      rw [Fin.sum_univ_castSucc, Fin.val_last] at hsum
      have hmul : c n (Fin.last r) * a (n + r) =
          -∑ i : Fin r, c n i.castSucc * a (n + i.castSucc) :=
        eq_neg_of_add_eq_zero_right hsum
      have hsolve : a (n + r) =
          (c n (Fin.last r))⁻¹ * -∑ i : Fin r, c n i.castSucc * a (n + i.castSucc) := by
        rw [← hmul, inv_mul_cancel_left₀ (hcne n)]
      rw [← hmr, hsolve]
      refine mul_mem (inv_mem (hcmem n (Fin.last r))) (neg_mem (sum_mem fun i _ ↦ ?_))
      rw [Fin.val_castSucc]
      exact mul_mem (hcmem n i.castSucc) (ih (n + i) (by have := i.isLt; omega))

/-- Shifted form of `mem_of_sum_mul_add_eq_zero` for recurrences whose leading coefficient is
nonzero only from an index `N` onward (for instance, beyond the natural roots of the leading
polynomial of a P-recursive recurrence): if `∑ i : Fin (r + 1), c n i * a (n + i) = 0` with
`c n i ∈ E` and `c n (Fin.last r) ≠ 0` for all `n ≥ N`, and `a m ∈ E` for `N ≤ m < N + r`,
then `a m ∈ E` for every `m ≥ N`. -/
theorem mem_of_sum_mul_add_eq_zero_of_le {K S : Type*} [DivisionRing K] [SetLike S K]
    [SubfieldClass S K] {E : S} {r N : ℕ} {c : ℕ → Fin (r + 1) → K} {a : ℕ → K}
    (hcne : ∀ n, N ≤ n → c n (Fin.last r) ≠ 0)
    (hrec : ∀ n, N ≤ n → ∑ i : Fin (r + 1), c n i * a (n + i) = 0)
    (hcmem : ∀ n, N ≤ n → ∀ i, c n i ∈ E)
    (hinit : ∀ m, N ≤ m → m < N + r → a m ∈ E) {m : ℕ} (hm : N ≤ m) :
    a m ∈ E := by
  have h := mem_of_sum_mul_add_eq_zero
    (c := fun n i ↦ c (N + n) i) (a := fun n ↦ a (N + n))
    (fun n ↦ hcne (N + n) (Nat.le_add_right N n))
    (fun n ↦ by simpa only [Nat.add_assoc] using hrec (N + n) (Nat.le_add_right N n))
    (fun n i ↦ hcmem (N + n) (Nat.le_add_right N n) i)
    (fun k hk ↦ hinit (N + k) (Nat.le_add_right N k) (Nat.add_lt_add_left hk N))
    (m - N)
  rwa [Nat.add_sub_cancel' hm] at h

end TauCeti
