module

public import TauCeti.Algebra.CrossedProduct.Cohomology
public import TauCeti.FieldTheory.GaloisCohomology.Cyclic

/-!
# The cocycle of a quadratic extension

Let `L` be a commutative `K`-algebra whose automorphism group `Aut_K(L)` has order two, generated
by `σ`. For `b ∈ Kˣ`, the **quadratic cocycle** `TauCeti.TwoCocycle.quadratic h b` is the
`2`-cocycle of `Aut_K(L)` with values in `Lˣ` whose only nontrivial value is `c(σ, σ) = b`. It is
the cocycle behind the quaternion algebra: when `char K ≠ 2` and `L = K(√a)`, its crossed product
is generated over `L` by `u_σ` with `u_σ² = b` and `u_σ √a = -√a u_σ`, which are the relations of
`(a, b)_K`.

For `L/K` Galois this cocycle computes the second cohomology of the cyclic group `Gal(L/K)` of
order two:

`Kˣ / N_{L/K}(Lˣ) ≃ H²(Gal(L/K), Lˣ)`, `[b] ↦ [quadratic h b]`

(`TauCeti.quadraticNormQuotientEquiv`). Indeed the quadratic cocycle is the carry cocycle of `b` at
the generator `σ`, so its class is `TauCeti.cyclicClass` of `b`
(`TauCeti.TwoCocycle.cohomologyClass_quadratic`). Consequently every cocycle is cohomologous to a
quadratic one, and the quadratic cocycle of `b` is a coboundary exactly when `b` is a norm from
`L`. Since the group of order two has a unique generator, this identification involves no choice.

## Main definitions

* `TauCeti.TwoCocycle.quadratic h b`: the `2`-cocycle of a group of automorphisms of order two
  whose only nontrivial value is `c(σ, σ) = b`.
* `TauCeti.quadraticNormQuotientEquiv`: the identification
  `Kˣ / N_{L/K}(Lˣ) ≃ H²(Gal(L/K), Lˣ)` of a quadratic Galois extension.

## Main results

* `TauCeti.TwoCocycle.quadratic_mul`: the quadratic cocycle is multiplicative in `b`.
* `TauCeti.TwoCocycle.cohomologyClass_quadratic`: its class is the class of `b` under
  two-periodicity at the nontrivial automorphism.
* `TauCeti.TwoCocycle.cohomologyClass_quadratic_eq_zero_iff`: its class vanishes exactly when `b`
  is a norm from `L`.
* `TauCeti.TwoCocycle.cohomologous_quadratic_iff`: the quadratic cocycles of `a` and `b` are
  cohomologous exactly when `a / b` is a norm from `L`.
* `TauCeti.TwoCocycle.exists_cohomologous_quadratic`: every `2`-cocycle is cohomologous to a
  quadratic one.

## References

* J.-P. Serre, *Local Fields*, Graduate Texts in Mathematics 67, Springer (1979), Chapter XIV,
  §2.
* P. Gille and T. Szamuely, *Central Simple Algebras and Galois Cohomology* (2006), §4.7.
-/

public section

noncomputable section

open groupCohomology

namespace TauCeti

section Cocycle

variable {K L : Type*} [CommSemiring K] [CommRing L] [Algebra K L]
  (h : Nat.card (L ≃ₐ[K] L) = 2)

include h in
/-- In an automorphism group of order two, the product of two nontrivial automorphisms is
trivial. -/
private theorem mul_eq_one_of_ne_one {σ τ : L ≃ₐ[K] L} (hσ : σ ≠ 1) (hτ : τ ≠ 1) :
    σ * τ = 1 := by
  obtain ⟨ρ, -, hρ⟩ := (Nat.card_eq_two_iff' (1 : L ≃ₐ[K] L)).1 h
  rw [hρ σ hσ, hρ τ hτ, ← pow_two, ← h, pow_card_eq_one']

include h in
/-- An automorphism group of order two is generated by its nontrivial element. -/
private theorem exists_forall_mem_zpowers : ∃ σ : L ≃ₐ[K] L, ∀ τ, τ ∈ Subgroup.zpowers σ := by
  obtain ⟨σ, hσ, -⟩ := (Nat.card_eq_two_iff' (1 : L ≃ₐ[K] L)).1 h
  exact ⟨σ, fun _ ↦ mem_zpowers_of_prime_card h hσ⟩

namespace TwoCocycle

open scoped Classical in
/-- **The quadratic cocycle** of `b ∈ Kˣ`, for an automorphism group `Aut_K(L)` of order two: the
`2`-cocycle `c` with `c(σ, σ) = b` for the nontrivial automorphism `σ`, and `c(σ, τ) = 1` whenever
`σ` or `τ` is trivial. -/
def quadratic (b : Kˣ) : TwoCocycle K L where
  toFun σ τ := if σ = 1 ∨ τ = 1 then 1 else Units.map (algebraMap K L : K →* L) b
  isMulCocycle₂ σ τ ρ := by
    have hb : σ • Units.map (algebraMap K L : K →* L) b = Units.map (algebraMap K L : K →* L) b :=
      Units.ext (AlgEquiv.commutes σ b)
    rcases eq_or_ne σ 1 with rfl | hσ
    · simp
    rcases eq_or_ne τ 1 with rfl | hτ
    · simp
    rcases eq_or_ne ρ 1 with rfl | hρ
    · simp
    simp [hσ, hτ, hρ, mul_eq_one_of_ne_one h hσ hτ, mul_eq_one_of_ne_one h hτ hρ, hb]

/-- The quadratic cocycle is trivial when its second argument is; with
`TauCeti.TwoCocycle.toFun_one_left`, it is also trivial when its first argument is. -/
@[simp]
theorem quadratic_toFun_one_right (b : Kˣ) (σ : L ≃ₐ[K] L) : (quadratic h b).toFun σ 1 = 1 := by
  simp [quadratic]

/-- On two nontrivial automorphisms, which are both the generator, the quadratic cocycle of `b`
takes the value `b`. -/
theorem quadratic_toFun_of_ne_one (b : Kˣ) {σ τ : L ≃ₐ[K] L} (hσ : σ ≠ 1) (hτ : τ ≠ 1) :
    (quadratic h b).toFun σ τ = Units.map (algebraMap K L : K →* L) b := by
  simp [quadratic, hσ, hτ]

/-- The quadratic cocycle of `1` is trivial. -/
@[simp]
theorem quadratic_one : quadratic h (1 : Kˣ) = 1 :=
  TwoCocycle.ext <| funext₂ fun σ τ ↦ by
    rcases eq_or_ne σ 1 with rfl | hσ
    · simp
    rcases eq_or_ne τ 1 with rfl | hτ
    · simp
    simp [quadratic_toFun_of_ne_one h _ hσ hτ]

/-- The quadratic cocycle is multiplicative in `b`. -/
theorem quadratic_mul (a b : Kˣ) : quadratic h (a * b) = quadratic h a * quadratic h b :=
  TwoCocycle.ext <| funext₂ fun σ τ ↦ by
    rcases eq_or_ne σ 1 with rfl | hσ
    · simp
    rcases eq_or_ne τ 1 with rfl | hτ
    · simp
    simp [quadratic_toFun_of_ne_one h _ hσ hτ]

end TwoCocycle

end Cocycle

variable {K L : Type} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
  (h : Nat.card (L ≃ₐ[K] L) = 2)

namespace TwoCocycle

omit [IsGalois K L] in
/-- **The quadratic cocycle is the carry cocycle.** For a Galois extension of degree two, generated
by `σ`, the class of the quadratic cocycle of `b` in `H²(Gal(L/K), Lˣ)` is the class of `b` under
two-periodicity at `σ`. -/
theorem cohomologyClass_quadratic [IsCyclic (L ≃ₐ[K] L)] {σ : L ≃ₐ[K] L}
    (hσ : ∀ τ, τ ∈ Subgroup.zpowers σ) (b : Kˣ) :
    (quadratic h b).cohomologyClass = cyclicClass hσ (Additive.ofMul b) := by
  have horder : orderOf σ = 2 := (orderOf_eq_card_of_forall_mem_zpowers hσ).trans h
  have hσ1 : σ ≠ 1 := by
    rintro rfl
    simp at horder
  rw [cohomologyClass_def]
  refine H2π_eq_cyclicClass hσ _ b fun i j hi hj ↦ ?_
  rw [coe_toCocycles₂]
  rw [horder] at hi hj ⊢
  -- The values `0` and `Additive.ofMul _` live in the carrier of the representation, which is
  -- `Additive Lˣ` only up to unfolding `Rep.ofMulDistribMulAction`, so `toMul_zero` and
  -- `toMul_ofMul` do not fire syntactically; the remaining goals hold by `rfl`.
  interval_cases i <;> interval_cases j <;>
    simp [quadratic_toFun_of_ne_one h b hσ1 hσ1] <;> rfl

/-- The class of the quadratic cocycle of `b` vanishes exactly when `b` is a norm from `L`. -/
@[simp]
theorem cohomologyClass_quadratic_eq_zero_iff (b : Kˣ) :
    (quadratic h b).cohomologyClass = 0 ↔ b ∈ normGroup K L := by
  obtain ⟨σ, hσ⟩ := exists_forall_mem_zpowers h
  have := isCyclic_of_prime_card h
  rw [cohomologyClass_quadratic h hσ, cyclicClass_eq_zero_iff]

/-- The quadratic cocycles of `a` and `b` are cohomologous exactly when `a / b` is a norm from
`L`. -/
theorem cohomologous_quadratic_iff (a b : Kˣ) :
    (quadratic h a).Cohomologous (quadratic h b) ↔ a / b ∈ normGroup K L := by
  obtain ⟨σ, hσ⟩ := exists_forall_mem_zpowers h
  have := isCyclic_of_prime_card h
  rw [cohomologous_iff_cohomologyClass_eq, cohomologyClass_quadratic h hσ,
    cohomologyClass_quadratic h hσ, cyclicClass_eq_iff]

/-- **Every `2`-cocycle of a quadratic Galois extension is cohomologous to a quadratic cocycle.**
-/
theorem exists_cohomologous_quadratic (z : TwoCocycle K L) :
    ∃ b : Kˣ, z.Cohomologous (quadratic h b) := by
  obtain ⟨σ, hσ⟩ := exists_forall_mem_zpowers h
  have := isCyclic_of_prime_card h
  obtain ⟨b, hb⟩ := cyclicClass_surjective hσ z.cohomologyClass
  exact ⟨b.toMul, by rw [cohomologous_iff_cohomologyClass_eq, cohomologyClass_quadratic h hσ,
    ofMul_toMul, hb]⟩

end TwoCocycle

/-- **`H²` of a quadratic Galois extension is the norm quotient**:
`Kˣ / N_{L/K}(Lˣ) ≃ H²(Gal(L/K), Lˣ)`, sending the class of `b` to the class of the quadratic
cocycle of `b` (`quadraticNormQuotientEquiv_mk`). -/
def quadraticNormQuotientEquiv :
    Additive (Kˣ ⧸ normGroup K L) ≃+ H2 (Rep.ofMulDistribMulAction (L ≃ₐ[K] L) Lˣ) :=
  haveI := isCyclic_of_prime_card h
  cyclicNormQuotientEquiv (exists_forall_mem_zpowers h).choose_spec

/-- `quadraticNormQuotientEquiv` sends the class of `b ∈ Kˣ` to the class of the quadratic
cocycle of `b`. -/
@[simp]
theorem quadraticNormQuotientEquiv_mk (b : Kˣ) :
    quadraticNormQuotientEquiv h (Additive.ofMul (b : Kˣ ⧸ normGroup K L)) =
      (TwoCocycle.quadratic h b).cohomologyClass := by
  have := isCyclic_of_prime_card h
  rw [TwoCocycle.cohomologyClass_quadratic h (exists_forall_mem_zpowers h).choose_spec]
  exact cyclicNormQuotientEquiv_mk _ b

end TauCeti
