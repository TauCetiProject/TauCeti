module

public import TauCeti.Algebra.OreExtension.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic

import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Left ideals of Ore extensions and differential operator rings

Let `R[X; σ, δ]` be an Ore extension represented by its left-coefficient sequences `∑ n, aₙ Xⁿ`.
If a left ideal `I` of `R` is stable under both `σ` and `δ`, the Ore polynomials whose left
coefficients all belong to `I` form a left ideal `TauCeti.OreExtension.coeffLeftIdeal`: left
multiplication by `C a` multiplies each coefficient on the left by `a`, while left multiplication
by `X` sends `a Xⁿ` to `σ(a) Xⁿ⁺¹ + δ(a) Xⁿ`. Right multiplication by `X`, on the other hand,
shifts left coefficients upward (`(∑ aₙ Xⁿ) X = ∑ aₙ Xⁿ⁺¹`), so it preserves every such left ideal
without any shift.

Over a ring `R`, the quotient of `R[X; σ, δ]` by `coeffLeftIdeal I` is a left `R`-module through
left multiplication by constants (`TauCeti.OreExtension.instIsScalarTowerSelf`), and reading off
left coefficients modulo `I` identifies this quotient `R`-linearly with `ℕ →₀ (R ⧸ I)`
(`TauCeti.OreExtension.quotientCoeffLeftIdealEquiv`), compatibly with quotient transitions.

For differential operator rings `R[X; δ]` (`σ = id`), a `δ`-invariant left ideal `I` generates
`coeffLeftIdeal I` as a left ideal (`TauCeti.OreExtension.span_image_C_eq_coeffLeftIdeal`),
since `a Xⁿ⁺¹ = X (a Xⁿ) - δ(a) Xⁿ` inductively places every monomial with coefficient in `I` in
the left ideal generated by `C '' I`. Consequently, if `I = R · s`, the left ideal of `R[X; δ]`
generated by `C '' s` is `coeffLeftIdeal I`. Moreover, a downward-directed family of `δ`-invariant
left ideals satisfying the right-shift estimate in `R` induces a family of left ideals satisfying
the right-shift estimate in `R[X; δ]`
(`TauCeti.OreExtension.exists_forall_mul_mem_coeffLeftIdeal`).

## Main definitions

* `TauCeti.OreExtension.coeffLeftIdeal`: the left ideal `{p | ∀ n, coeff p n ∈ I}` of `R[X; σ, δ]`
  associated to a `(σ, δ)`-invariant left ideal `I` of `R`.
* `TauCeti.OreExtension.quotientCoeffLeftIdealEquiv`: the left `R`-linear isomorphism
  `(R[X; σ, δ] ⧸ coeffLeftIdeal I) ≃ₗ[R] (ℕ →₀ (R ⧸ I))`.

## Main results

* `TauCeti.OreExtension.coeff_mul_X_zero`, `TauCeti.OreExtension.coeff_mul_X_succ`: right
  multiplication by `X` shifts left coefficients by one.
* `TauCeti.OreExtension.mul_X_mem_coeffLeftIdeal`: right multiplication by `X` preserves
  `coeffLeftIdeal I`.
* `TauCeti.OreExtension.span_image_C_eq_coeffLeftIdeal`: in `R[X; δ]`, the left ideal generated by
  `C '' I` for a `δ`-invariant left ideal `I` is `coeffLeftIdeal I`.
* `TauCeti.OreExtension.exists_forall_mul_mem_coeffLeftIdeal`: the right-shift estimate transfers
  from `δ`-invariant left ideals of `R` to `R[X; δ]`.

## References

* J. C. McConnell and J. C. Robson, *Noncommutative Noetherian Rings*, Chapter 1, §1.2, for
  extension and contraction of ideals in differential operator rings.
-/

public section

noncomputable section

namespace TauCeti.OreExtension

section Semiring

variable {k R : Type*} [CommSemiring k] [Semiring R] [Algebra k R]
  {σ : R →ₐ[k] R} {δ : SigmaDerivation σ}

/-- Right multiplication of a left-coefficient monomial `a Xⁿ` by `X` raises its degree by one. -/
theorem monomial_mul_X (n : ℕ) (a : R) :
    monomial (σ := σ) (δ := δ) n a * X = monomial (n + 1) a := by
  rw [← C_mul_X_pow_eq_monomial, mul_assoc, ← pow_succ, C_mul_X_pow_eq_monomial]

/-- Right multiplication by `X` clears the constant left coefficient. -/
@[simp]
theorem coeff_mul_X_zero (p : OreExtension σ δ) : coeff (p * X) 0 = 0 := by
  induction p using induction_on with
  | zero => simp
  | add n a p _ _ ih =>
    rw [add_mul, coeff_add, monomial_mul_X, coeff_monomial, ih]
    simp

/-- Right multiplication by `X` shifts left coefficients upward by one. -/
@[simp]
theorem coeff_mul_X_succ (p : OreExtension σ δ) (n : ℕ) :
    coeff (p * X) (n + 1) = coeff p n := by
  induction p using induction_on with
  | zero => simp
  | add m a p _ _ ih =>
    rw [add_mul, coeff_add, coeff_add, monomial_mul_X, ih, coeff_monomial, coeff_monomial]
    simp

/-- Right multiplication by `Xᵐ` shifts left coefficients upward by `m`. -/
@[simp]
theorem coeff_mul_X_pow_add (p : OreExtension σ δ) (n m : ℕ) :
    coeff (p * X ^ m) (n + m) = coeff p n := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ, ← mul_assoc, ← Nat.add_assoc, coeff_mul_X_succ, ih]

/-- Left scalar multiplication by `R` on `R[X; σ, δ]` associates with multiplication in
`R[X; σ, δ]`, so quotients by left ideals of `R[X; σ, δ]` inherit a left `R`-module structure. -/
instance instIsScalarTowerSelf : IsScalarTower R (OreExtension σ δ) (OreExtension σ δ) where
  smul_assoc a p q := by rw [smul_eq_C_mul, smul_eq_C_mul, smul_eq_mul, smul_eq_mul, mul_assoc]

/-- **The coefficientwise left ideal of an Ore extension.** If a left ideal `I` of `R` is stable
under `σ` and `δ`, the Ore polynomials whose left coefficients all lie in `I` form a left ideal of
`R[X; σ, δ]`. -/
def coeffLeftIdeal (I : Submodule R R) (hσ : Set.MapsTo σ I I) (hδ : Set.MapsTo δ I I) :
    Submodule (OreExtension σ δ) (OreExtension σ δ) where
  carrier := {p | ∀ n, coeff p n ∈ I}
  zero_mem' n := by simp
  add_mem' hp hq n := by
    rw [coeff_add]
    exact add_mem (hp n) (hq n)
  smul_mem' q := by
    induction q using induction_on_mul with
    | C a =>
      intro p hp n
      rw [smul_eq_mul, coeff_C_mul, ← smul_eq_mul]
      exact I.smul_mem a (hp n)
    | X =>
      intro p hp n
      cases n with
      | zero =>
        rw [smul_eq_mul, coeff_X_mul_zero]
        exact hδ (hp 0)
      | succ n =>
        rw [smul_eq_mul, coeff_X_mul_succ]
        exact add_mem (hσ (hp n)) (hδ (hp (n + 1)))
    | add q₁ q₂ h₁ h₂ =>
      intro p hp n
      rw [smul_eq_mul, add_mul, coeff_add]
      exact add_mem (h₁ hp n) (h₂ hp n)
    | mul q₁ q₂ h₁ h₂ =>
      intro p hp
      rw [smul_eq_mul, mul_assoc]
      exact h₁ (h₂ hp)

/-- An Ore polynomial lies in `coeffLeftIdeal I` if and only if every left coefficient lies in
`I`. -/
theorem mem_coeffLeftIdeal_iff {I : Submodule R R} {hσ : Set.MapsTo σ I I}
    {hδ : Set.MapsTo δ I I} {p : OreExtension σ δ} :
    p ∈ coeffLeftIdeal I hσ hδ ↔ ∀ n, coeff p n ∈ I :=
  Iff.rfl

/-- A constant `C a` belongs to `coeffLeftIdeal I` if and only if `a ∈ I`. -/
@[simp]
theorem C_mem_coeffLeftIdeal_iff {I : Submodule R R} {hσ : Set.MapsTo σ I I}
    {hδ : Set.MapsTo δ I I} {a : R} :
    C a ∈ coeffLeftIdeal I hσ hδ ↔ a ∈ I := by
  refine ⟨fun h ↦ by simpa using h 0, fun ha n ↦ ?_⟩
  by_cases hn : n = 0 <;> simp [hn, ha]

/-- Monomials with coefficients in `I` belong to `coeffLeftIdeal I`. -/
theorem monomial_mem_coeffLeftIdeal {I : Submodule R R} {hσ : Set.MapsTo σ I I}
    {hδ : Set.MapsTo δ I I} (n : ℕ) {a : R} (ha : a ∈ I) :
    monomial n a ∈ coeffLeftIdeal I hσ hδ := by
  intro m
  by_cases h : n = m <;> simp [coeff_monomial, h, ha]

/-- Right multiplication by `X` preserves `coeffLeftIdeal I` without any shift. -/
theorem mul_X_mem_coeffLeftIdeal {I : Submodule R R} {hσ : Set.MapsTo σ I I}
    {hδ : Set.MapsTo δ I I} {p : OreExtension σ δ} (hp : p ∈ coeffLeftIdeal I hσ hδ) :
    p * X ∈ coeffLeftIdeal I hσ hδ := by
  rintro (_ | n)
  · simp
  · rw [coeff_mul_X_succ]
    exact hp n

/-- Right multiplication by any power `Xᵐ` preserves `coeffLeftIdeal I`. -/
theorem mul_X_pow_mem_coeffLeftIdeal {I : Submodule R R} {hσ : Set.MapsTo σ I I}
    {hδ : Set.MapsTo δ I I} {p : OreExtension σ δ} (hp : p ∈ coeffLeftIdeal I hσ hδ) (m : ℕ) :
    p * X ^ m ∈ coeffLeftIdeal I hσ hδ := by
  induction m with
  | zero => simpa using hp
  | succ m ih =>
    rw [pow_succ, ← mul_assoc]
    exact mul_X_mem_coeffLeftIdeal ih

/-- `coeffLeftIdeal` is monotone in the coefficient left ideal `I`. -/
theorem coeffLeftIdeal_mono {I₁ I₂ : Submodule R R} {hσ₁ : Set.MapsTo σ I₁ I₁}
    {hδ₁ : Set.MapsTo δ I₁ I₁} {hσ₂ : Set.MapsTo σ I₂ I₂} {hδ₂ : Set.MapsTo δ I₂ I₂}
    (h : I₁ ≤ I₂) :
    coeffLeftIdeal I₁ hσ₁ hδ₁ ≤ coeffLeftIdeal I₂ hσ₂ hδ₂ :=
  fun _ hp n ↦ h (hp n)

/-- The zero left ideal of `R` induces the zero left ideal of `R[X; σ, δ]`. -/
@[simp]
theorem coeffLeftIdeal_bot :
    coeffLeftIdeal (⊥ : Submodule R R)
      (by rintro _ rfl; simp)
      (by rintro _ rfl; simp) =
      (⊥ : Submodule (OreExtension σ δ) (OreExtension σ δ)) := by
  rw [eq_bot_iff]
  intro p hp
  ext n
  simpa using mem_coeffLeftIdeal_iff.1 hp n

/-- Intersecting a family of `coeffLeftIdeal`s intersects their coefficient ideals. -/
theorem iInf_coeffLeftIdeal {ι : Sort*} {I : ι → Submodule R R}
    (hσ : ∀ i, Set.MapsTo σ (I i) (I i)) (hδ : ∀ i, Set.MapsTo δ (I i) (I i)) :
    (⨅ i, coeffLeftIdeal (I i) (hσ i) (hδ i)) =
      coeffLeftIdeal (⨅ i, I i)
        (fun x hx ↦ (Submodule.mem_iInf _).2 fun i ↦ hσ i ((Submodule.mem_iInf _).1 hx i))
        (fun x hx ↦ (Submodule.mem_iInf _).2 fun i ↦ hδ i ((Submodule.mem_iInf _).1 hx i)) := by
  ext p
  refine ⟨fun hp n ↦ (Submodule.mem_iInf _).2 fun i ↦
      mem_coeffLeftIdeal_iff.1 ((Submodule.mem_iInf _).1 hp i) n,
    fun hp ↦ (Submodule.mem_iInf _).2 fun i ↦
      mem_coeffLeftIdeal_iff.2 fun n ↦ (Submodule.mem_iInf _).1 (mem_coeffLeftIdeal_iff.1 hp n) i⟩

/-- The left ideal of `R[X; σ, δ]` generated by `C '' (Submodule.span R s)` coincides with the
left ideal generated by `C '' s`. -/
theorem span_image_C_span (σ : R →ₐ[k] R) (δ : SigmaDerivation σ) (s : Set R) :
    Submodule.span (OreExtension σ δ) ((C (σ := σ) (δ := δ)) '' (Submodule.span R s : Set R)) =
      Submodule.span (OreExtension σ δ) ((C (σ := σ) (δ := δ)) '' s) := by
  refine le_antisymm (Submodule.span_le.2 ?_)
    (Submodule.span_mono (Set.image_mono Submodule.subset_span))
  rintro _ ⟨a, ha, rfl⟩
  induction ha using Submodule.span_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | smul r x _ hx =>
    rw [smul_eq_mul, C_mul]
    exact Submodule.smul_mem _ (C r) hx

end Semiring

section Ring

variable {k R : Type*} [CommSemiring k] [Ring R] [Algebra k R]

section Quotient

variable {σ : R →ₐ[k] R} {δ : SigmaDerivation σ}

/-- The left `R`-linear map reading off the left coefficients of an Ore polynomial modulo a left
ideal `I` of `R`. -/
def toQuotientFinsupp (I : Submodule R R) : OreExtension σ δ →ₗ[R] (ℕ →₀ (R ⧸ I)) :=
  (Finsupp.mapRange.linearMap I.mkQ).comp leftCoeffLinearEquiv.toLinearMap

/-- `toQuotientFinsupp I` reads off the `n`-th left coefficient modulo `I`. -/
@[simp]
theorem toQuotientFinsupp_apply (I : Submodule R R) (p : OreExtension σ δ) (n : ℕ) :
    toQuotientFinsupp I p n = I.mkQ (coeff p n) := by
  simp [toQuotientFinsupp, coeff_def]

/-- `toQuotientFinsupp I` sends a monomial `a Xⁿ` to `Finsupp.single n (a mod I)`. -/
@[simp]
theorem toQuotientFinsupp_monomial (I : Submodule R R) (n : ℕ) (a : R) :
    toQuotientFinsupp (σ := σ) (δ := δ) I (monomial n a) = Finsupp.single n (I.mkQ a) := by
  simp [toQuotientFinsupp]

/-- `toQuotientFinsupp I` is surjective. -/
theorem toQuotientFinsupp_surjective (I : Submodule R R) :
    Function.Surjective (toQuotientFinsupp (σ := σ) (δ := δ) I) :=
  (Finsupp.mapRange_surjective _ (map_zero _) I.mkQ_surjective).comp
    leftCoeffLinearEquiv.surjective

/-- The kernel of `toQuotientFinsupp I` is `coeffLeftIdeal I` restricted to `R`-scalars. -/
@[simp]
theorem ker_toQuotientFinsupp (I : Submodule R R) (hσ : Set.MapsTo σ I I)
    (hδ : Set.MapsTo δ I I) :
    LinearMap.ker (toQuotientFinsupp (σ := σ) (δ := δ) I) =
      (coeffLeftIdeal I hσ hδ).restrictScalars R := by
  ext p
  simp [LinearMap.mem_ker, Finsupp.ext_iff, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    mem_coeffLeftIdeal_iff]

/-- **Left-coefficient decomposition of the quotient by `coeffLeftIdeal I`.** As a left `R`-module,
`R[X; σ, δ] ⧸ coeffLeftIdeal I` is isomorphic to `ℕ →₀ (R ⧸ I)` via its left coefficients. -/
def quotientCoeffLeftIdealEquiv (I : Submodule R R) (hσ : Set.MapsTo σ I I)
    (hδ : Set.MapsTo δ I I) :
    (OreExtension σ δ ⧸ coeffLeftIdeal I hσ hδ) ≃ₗ[R] (ℕ →₀ (R ⧸ I)) :=
  ((Submodule.Quotient.restrictScalarsEquiv R (coeffLeftIdeal I hσ hδ)).symm.trans
    (Submodule.quotEquivOfEq _ _ (ker_toQuotientFinsupp I hσ hδ).symm)).trans
      ((toQuotientFinsupp I).quotKerEquivOfSurjective (toQuotientFinsupp_surjective I))

/-- `quotientCoeffLeftIdealEquiv` acts on a coset `Submodule.Quotient.mk p` by
`toQuotientFinsupp I p`. -/
@[simp]
theorem quotientCoeffLeftIdealEquiv_mk (I : Submodule R R) (hσ : Set.MapsTo σ I I)
    (hδ : Set.MapsTo δ I I) (p : OreExtension σ δ) :
    quotientCoeffLeftIdealEquiv I hσ hδ (Submodule.Quotient.mk p) =
      toQuotientFinsupp I p := by
  simp [quotientCoeffLeftIdealEquiv]

/-- The inverse of `quotientCoeffLeftIdealEquiv` sends `Finsupp.single n (a mod I)` to the class of
`a Xⁿ`. -/
@[simp]
theorem quotientCoeffLeftIdealEquiv_symm_single (I : Submodule R R) (hσ : Set.MapsTo σ I I)
    (hδ : Set.MapsTo δ I I) (n : ℕ) (a : R) :
    (quotientCoeffLeftIdealEquiv (σ := σ) (δ := δ) I hσ hδ).symm
        (Finsupp.single n (Submodule.Quotient.mk a)) =
      Submodule.Quotient.mk (monomial n a) := by
  rw [LinearEquiv.symm_apply_eq, quotientCoeffLeftIdealEquiv_mk, toQuotientFinsupp_monomial,
    Submodule.mkQ_apply]

/-- The quotient decompositions at `I₁ ≤ I₂` commute with `Submodule.factor` and coefficientwise
reduction `Finsupp.mapRange.linearMap (Submodule.factor h)`. -/
theorem quotientCoeffLeftIdealEquiv_factor {I₁ I₂ : Submodule R R}
    {hσ₁ : Set.MapsTo σ I₁ I₁} {hδ₁ : Set.MapsTo δ I₁ I₁}
    {hσ₂ : Set.MapsTo σ I₂ I₂} {hδ₂ : Set.MapsTo δ I₂ I₂} (h : I₁ ≤ I₂)
    (q : OreExtension σ δ ⧸ coeffLeftIdeal I₁ hσ₁ hδ₁) :
    quotientCoeffLeftIdealEquiv I₂ hσ₂ hδ₂
        (Submodule.factor (coeffLeftIdeal_mono h) q) =
      Finsupp.mapRange.linearMap (Submodule.factor h)
        (quotientCoeffLeftIdealEquiv I₁ hσ₁ hδ₁ q) := by
  obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective _ q
  ext n
  simp

end Quotient

section DifferentialOperator

variable {δ : SigmaDerivation (AlgHom.id k R)}

/-- Every submodule of `R` is invariant under `AlgHom.id k R`. -/
theorem mapsTo_id (I : Submodule R R) : Set.MapsTo (AlgHom.id k R) I I :=
  fun _ hx ↦ by rwa [AlgHom.id_apply]

/-- **Generators of `coeffLeftIdeal` in a differential operator ring.** For an ordinary derivation
`δ` (`σ = id`) and a `δ`-invariant left ideal `I` of `R`, the left ideal of `R[X; δ]` generated by
`C '' I` is `coeffLeftIdeal I`. -/
theorem span_image_C_eq_coeffLeftIdeal (I : Submodule R R) (hδ : Set.MapsTo δ I I) :
    Submodule.span (OreExtension (AlgHom.id k R) δ) (C '' (I : Set R)) =
      coeffLeftIdeal I (mapsTo_id I) hδ := by
  refine le_antisymm (Submodule.span_le.2 ?_) fun p hp ↦ ?_
  · rintro _ ⟨a, ha, rfl⟩
    exact C_mem_coeffLeftIdeal_iff.2 ha
  · have hmon (n : ℕ) : ∀ {a : R}, a ∈ I →
        monomial (σ := AlgHom.id k R) (δ := δ) n a ∈
          Submodule.span (OreExtension (AlgHom.id k R) δ) (C '' (I : Set R)) := by
      induction n with
      | zero =>
        intro a ha
        rw [monomial_zero_left]
        exact Submodule.subset_span ⟨a, ha, rfl⟩
      | succ n ih =>
        intro a ha
        -- Since `X * (a Xⁿ) = a Xⁿ⁺¹ + δ(a) Xⁿ`, both terms on the right of
        -- `a Xⁿ⁺¹ = X * (a Xⁿ) - δ(a) Xⁿ` lie in the span by the induction hypothesis.
        have hX : monomial (σ := AlgHom.id k R) (δ := δ) (n + 1) a =
            X * monomial n a - monomial n (δ a) := by
          rw [X_mul_monomial, AlgHom.id_apply, add_sub_cancel_right]
        rw [hX]
        exact sub_mem (Submodule.smul_mem _ X (ih ha)) (ih (hδ ha))
    rw [← sum_monomial_eq p]
    exact Submodule.sum_mem _ fun n _ ↦ hmon n (hp n)

/-- **Right-shift estimate in a differential operator ring.** If a downward-directed family `I` of
`δ`-invariant left ideals of `R` satisfies the right-shift estimate in `R`, then the induced family
`coeffLeftIdeal (I i)` satisfies the right-shift estimate in `R[X; δ]`. -/
theorem exists_forall_mul_mem_coeffLeftIdeal {ι : Type*} {I : ι → Submodule R R}
    (hI : Directed (· ≥ ·) I) (hδ : ∀ i, Set.MapsTo δ (I i) (I i))
    (hIr : ∀ (b : R) (i : ι), ∃ j, ∀ a ∈ I j, a * b ∈ I i)
    (q : OreExtension (AlgHom.id k R) δ) (i : ι) :
    ∃ j, ∀ p ∈ coeffLeftIdeal (I j) (mapsTo_id (I j)) (hδ j),
      p * q ∈ coeffLeftIdeal (I i) (mapsTo_id (I i)) (hδ i) := by
  induction q using induction_on_mul generalizing i with
  | C b =>
    obtain ⟨j, hj⟩ := hIr b i
    refine ⟨j, fun p hp ↦ ?_⟩
    rw [← span_image_C_eq_coeffLeftIdeal (I j) (hδ j)] at hp
    induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      rw [← C_mul, C_mem_coeffLeftIdeal_iff]
      exact hj a ha
    | zero => simp
    | add x y _ _ hx hy =>
      rw [add_mul]
      exact add_mem hx hy
    | smul r x _ hx =>
      rw [smul_eq_mul, mul_assoc]
      exact Submodule.smul_mem _ r hx
  | X =>
    exact ⟨i, fun _ hp ↦ mul_X_mem_coeffLeftIdeal hp⟩
  | add q₁ q₂ h₁ h₂ =>
    obtain ⟨j₁, hj₁⟩ := h₁ i
    obtain ⟨j₂, hj₂⟩ := h₂ i
    obtain ⟨j, hle₁, hle₂⟩ := hI j₁ j₂
    refine ⟨j, fun p hp ↦ ?_⟩
    rw [mul_add]
    exact add_mem (hj₁ p (coeffLeftIdeal_mono hle₁ hp)) (hj₂ p (coeffLeftIdeal_mono hle₂ hp))
  | mul q₁ q₂ h₁ h₂ =>
    obtain ⟨j₁, hj₁⟩ := h₂ i
    obtain ⟨j, hj⟩ := h₁ j₁
    exact ⟨j, fun p hp ↦ by rw [← mul_assoc]; exact hj₁ (p * q₁) (hj p hp)⟩

end DifferentialOperator

end Ring

end TauCeti.OreExtension
