/-!
# The cubic Gaussian braid representation and its finiteness

In the cubic quantum torus `CubicTorus N`, set `u = twelfthRootOfUnity = exp (π i / 6)` and
`ζ = u ^ 2 = exp (π i / 3)`. The **Gaussian braid generators**

  `g_j = gaussianBraidGenerator N j = u • ((1 + ζ) • p_j - 1)`

lie in the inversion-fixed star subalgebra `cubicFixed N`, are unitary with inverse `star g_j`,
satisfy `g_j ^ 3 = (-I) • 1` and `g_j ^ 12 = 1`, satisfy the braid relations (giving a
representation `gaussianBraid N : BraidGroup (N + 1) →* (CubicTorus N)ˣ`), and agree up to a
scalar phase with the image of `TemperleyLieb.jonesUnit` under `cubicFixedHom (N + 1)` whenever
`a ^ 2 = -u⁻¹` (so that `jonesDelta a = √3`).

In the Weyl basis, `g_j = -(√3)⁻¹ • (1 + ω ^ 2 • (U_j + U_j ^ 2))`, and conjugation by `g_j`
permutes the Weyl basis itself by the symplectic transvection of `chainForm N`:

  `g_j * W(a) * g_j⁻¹ = W(a + B(a, e_j) • e_j)`.

Hence the subgroup `G = Subgroup.closure (Set.range (gaussianBraidUnit N))` acts by conjugation on
the finite set `Fin N → ZMod 3`, producing a group homomorphism
`φ : G →* Equiv.Perm (Fin N → ZMod 3)` into a finite group. Any `z ∈ φ.ker` commutes with every
`W(a)`, so its Weyl support lies in the radical of `chainForm N` — trivial for even `N`, and
spanned by `(1, 0, 1, 0, …, 1)` for odd `N`. Passing to the determinant of left multiplication on
`CubicTorus N` (for even `N`) or on the three nonzero central-idempotent eigenspaces of `W(ρ)`
(for odd `N`) shows that every eigenvalue of `z` is a root of unity of bounded order, since each
generator satisfies `g_j ^ 12 = 1`. Thus `φ.ker` is finite, and therefore `G` is finite
(`TauCeti.TemperleyLieb.finite_gaussianBraid_closure`).

## Main definitions

* `TauCeti.TemperleyLieb.twelfthRootOfUnity`: `u = exp (π i / 6)`.
* `TauCeti.TemperleyLieb.gaussianBraidGenerator` and `TauCeti.TemperleyLieb.gaussianBraidUnit`:
  the Gaussian braid generators `g_j` in `CubicTorus N` and as units in `(CubicTorus N)ˣ`.
* `TauCeti.TemperleyLieb.gaussianBraid`: the braid group representation
  `BraidGroup (N + 1) →* (CubicTorus N)ˣ` sending `BraidGroup.sigma j` to `gaussianBraidUnit N j`.

## Main results

* `TauCeti.TemperleyLieb.gaussianBraidGenerator_eq_weyl`,
  `TauCeti.TemperleyLieb.gaussianBraidGenerator_pow_three`, and
  `TauCeti.TemperleyLieb.gaussianBraidUnit_pow_twelve`: Weyl expansion and finite order of `g_j`.
* `TauCeti.TemperleyLieb.gaussianBraidUnit_braid` and
  `TauCeti.TemperleyLieb.gaussianBraidUnit_mul_comm`: the Artin braid relations.
* `TauCeti.TemperleyLieb.cubicFixedHom_crossing_eq_gaussianBraidGenerator`: comparison with the
  Jones representation at `a ^ 2 = -u⁻¹`.
* `TauCeti.TemperleyLieb.gaussianBraidUnit_conj_weyl`: conjugation by `g_j` acts on the Weyl basis
  as the symplectic transvection `a ↦ a + chainForm N a (Pi.single j 1) • Pi.single j 1`.
* `TauCeti.TemperleyLieb.finite_gaussianBraid_closure`: the subgroup of `(CubicTorus N)ˣ`
  generated by the Gaussian braid units is finite.

## References

* V. F. R. Jones, *A polynomial invariant for knots via von Neumann algebras*, Bull. Amer. Math.
  Soc. 12 (1985), 103–111, p. 107.
* C. Galindo and E. C. Rowell, *Braid representations from unitary braided vector spaces*,
  J. Math. Phys. 55 (2014), 061702, Proposition 3.6.
* E. C. Rowell and H. Wenzl, *SO(N)_2 braid group representations are Gaussian*, Quantum Topol. 8
  (2017), no. 1, 1–33.
-/

public section

namespace TauCeti.TemperleyLieb

private theorem zmod3_cases (c : ZMod 3) : c = 0 ∨ c = 1 ∨ c = 2 := by
  decide +revert

/-! ### The twelfth root of unity `u = exp (π i / 6)` -/

/-- `u = exp (π i / 6)`, a primitive twelfth root of unity with `u + u⁻¹ = √3` and `u ^ 4 = ω`. -/
noncomputable def twelfthRootOfUnity : ℂ :=
  Complex.exp (((Real.pi / 6 : ℝ) : ℂ) * Complex.I)

/-- Unfolding `twelfthRootOfUnity`. -/
theorem twelfthRootOfUnity_def :
    twelfthRootOfUnity = Complex.exp (((Real.pi / 6 : ℝ) : ℂ) * Complex.I) := (rfl)

/-- Rectangular form `u = (√3 + i) / 2`. -/
theorem twelfthRootOfUnity_eq :
    twelfthRootOfUnity = ((Real.sqrt 3 : ℂ) + Complex.I) / 2 := by
  rw [twelfthRootOfUnity_def, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
    Real.cos_pi_div_six, Real.sin_pi_div_six]
  push_cast
  ring

/-- `twelfthRootOfUnity ≠ 0`. -/
theorem twelfthRootOfUnity_ne_zero : twelfthRootOfUnity ≠ 0 :=
  Complex.exp_ne_zero _

/-- `star u = u⁻¹`. -/
@[simp]
theorem star_twelfthRootOfUnity : star twelfthRootOfUnity = twelfthRootOfUnity⁻¹ := by
  have hmul : star twelfthRootOfUnity * twelfthRootOfUnity = 1 := by
    rw [twelfthRootOfUnity_def, Complex.star_def, ← Complex.exp_conj]
    have hconj : (starRingEnd ℂ) (((Real.pi / 6 : ℝ) : ℂ) * Complex.I) =
        -(((Real.pi / 6 : ℝ) : ℂ) * Complex.I) := by
      rw [map_mul, Complex.conj_ofReal, Complex.conj_I, mul_neg]
    rw [hconj, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero]
  exact eq_inv_of_mul_eq_one_left hmul

/-- `u⁻¹ = (√3 - i) / 2`. -/
theorem twelfthRootOfUnity_inv_eq :
    twelfthRootOfUnity⁻¹ = ((Real.sqrt 3 : ℂ) - Complex.I) / 2 := by
  rw [← star_twelfthRootOfUnity, twelfthRootOfUnity_eq, Complex.star_def, map_div₀, map_add,
    Complex.conj_ofReal, Complex.conj_I, map_ofNat, sub_eq_add_neg]

/-- `u + u⁻¹ = √3`. -/
theorem twelfthRootOfUnity_add_inv :
    twelfthRootOfUnity + twelfthRootOfUnity⁻¹ = (Real.sqrt 3 : ℂ) := by
  rw [twelfthRootOfUnity_inv_eq, twelfthRootOfUnity_eq]
  ring

private theorem sqrt_three_sq : (Real.sqrt 3 : ℂ) ^ 2 = 3 := by
  rw [sq]
  exact_mod_cast Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 3)

/-- `u ^ 2 = (1 + √3 i) / 2`. -/
theorem twelfthRootOfUnity_pow_two :
    twelfthRootOfUnity ^ 2 = (1 + (Real.sqrt 3 : ℂ) * Complex.I) / 2 := by
  rw [twelfthRootOfUnity_eq]
  linear_combination (1 / 4 : ℂ) * sqrt_three_sq + (1 / 4 : ℂ) * Complex.I_sq

/-- `1 + u ^ 2 = √3 * u`. -/
theorem one_add_twelfthRootOfUnity_sq :
    1 + twelfthRootOfUnity ^ 2 = (Real.sqrt 3 : ℂ) * twelfthRootOfUnity := by
  rw [twelfthRootOfUnity_pow_two, twelfthRootOfUnity_eq]
  linear_combination (-1 / 2 : ℂ) * sqrt_three_sq

/-- `u ^ 3 = i`. -/
@[simp]
theorem twelfthRootOfUnity_pow_three : twelfthRootOfUnity ^ 3 = Complex.I := by
  rw [pow_succ, twelfthRootOfUnity_pow_two, twelfthRootOfUnity_eq]
  linear_combination (Complex.I / 4 : ℂ) * sqrt_three_sq + ((Real.sqrt 3 : ℂ) / 4) * Complex.I_sq

/-- `u ^ 4 = ω`. -/
@[simp]
theorem twelfthRootOfUnity_pow_four : twelfthRootOfUnity ^ 4 = (cubeRootOfUnity : ℂ) := by
  rw [pow_succ, twelfthRootOfUnity_pow_three, twelfthRootOfUnity_eq, cubeRootOfUnity_val_eq]
  linear_combination (1 / 2 : ℂ) * Complex.I_sq

/-- `u ^ 6 = -1`. -/
@[simp]
theorem twelfthRootOfUnity_pow_six : twelfthRootOfUnity ^ 6 = -1 := by
  have h : twelfthRootOfUnity ^ 6 = (twelfthRootOfUnity ^ 3) ^ 2 := by ring
  rw [h, twelfthRootOfUnity_pow_three, Complex.I_sq]

/-- `u ^ 12 = 1`. -/
@[simp]
theorem twelfthRootOfUnity_pow_twelve : twelfthRootOfUnity ^ 12 = 1 := by
  have h : twelfthRootOfUnity ^ 12 = (twelfthRootOfUnity ^ 6) ^ 2 := by ring
  rw [h, twelfthRootOfUnity_pow_six]
  norm_num

/-! ### Gaussian braid generators, unitarity, order, and braid relations -/

/-- The Gaussian braid generator `g_j = u • ((1 + u ^ 2) • p_j - 1)` in `CubicTorus N`. -/
noncomputable def gaussianBraidGenerator (N : ℕ) (j : Fin N) : CubicTorus N :=
  twelfthRootOfUnity • ((1 + twelfthRootOfUnity ^ 2) • cubicProjection N j - 1)

/-- Unfolding `gaussianBraidGenerator`. -/
theorem gaussianBraidGenerator_def (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j =
      twelfthRootOfUnity • ((1 + twelfthRootOfUnity ^ 2) • cubicProjection N j - 1) := (rfl)

/-- Every Gaussian braid generator lies in the inversion-fixed star subalgebra `cubicFixed N`. -/
theorem gaussianBraidGenerator_mem_cubicFixed (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j ∈ cubicFixed N :=
  StarSubalgebra.smul_mem _
    (sub_mem (StarSubalgebra.smul_mem _ (cubicProjection_mem_cubicFixed N j) _) (one_mem _)) _

/-- `g_j` is the image under `cubicFixedHom (N + 1)` of the crossing
`(-u) • 1 + u ^ 2 • e_j` in `TemperleyLieb ℂ (√3 : ℂ) (N + 1)`. -/
theorem gaussianBraidGenerator_eq_crossing (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j =
      ((cubicFixedHom (N + 1)
        (crossing (Real.sqrt 3 : ℂ) (-twelfthRootOfUnity) (twelfthRootOfUnity ^ 2) j)).1 :
        CubicTorus N) := by
  rw [crossing_def, map_add, map_smul, map_smul, map_one, AddMemClass.coe_add,
    SetLike.val_smul, SetLike.val_smul, OneMemClass.coe_one, coe_cubicFixedHom_e, smul_smul,
    gaussianBraidGenerator_def, smul_sub, smul_smul, one_add_twelfthRootOfUnity_sq]
  have hcoef : twelfthRootOfUnity * ((Real.sqrt 3 : ℂ) * twelfthRootOfUnity) =
      twelfthRootOfUnity ^ 2 * (Real.sqrt 3 : ℂ) := by ring
  rw [hcoef, neg_smul, sub_eq_neg_add]
  rfl

/-- Weyl-basis expansion `g_j = -(√3)⁻¹ • (1 + ω ^ 2 • (U_j + U_j ^ 2))`. -/
theorem gaussianBraidGenerator_eq_weyl (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j =
      -((Real.sqrt 3 : ℂ)⁻¹) •
        (1 + ((cubeRootOfUnity : ℂ) ^ 2) • (cubicSite N j + cubicSite N j ^ 2)) := by
  have hsqrt_ne : (Real.sqrt 3 : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num))
  have hω2 : -((cubeRootOfUnity : ℂ) ^ 2) = twelfthRootOfUnity ^ 2 := by
    rw [← twelfthRootOfUnity_pow_four]
    have h8 : twelfthRootOfUnity ^ 8 = -twelfthRootOfUnity ^ 2 := by
      calc
        twelfthRootOfUnity ^ 8 = twelfthRootOfUnity ^ 6 * twelfthRootOfUnity ^ 2 := by ring
        _ = -twelfthRootOfUnity ^ 2 := by rw [twelfthRootOfUnity_pow_six]; ring
    linear_combination -h8
  have h3inv : (Real.sqrt 3 : ℂ) * (3 : ℂ)⁻¹ = (Real.sqrt 3 : ℂ)⁻¹ := by
    apply mul_left_cancel₀ hsqrt_ne
    rw [mul_inv_cancel₀ hsqrt_ne, ← mul_assoc, ← sq, sqrt_three_sq]
    norm_num
  have hc1 : twelfthRootOfUnity * (1 + twelfthRootOfUnity ^ 2) * (3 : ℂ)⁻¹ - twelfthRootOfUnity =
      -(Real.sqrt 3 : ℂ)⁻¹ := by
    rw [one_add_twelfthRootOfUnity_sq]
    have hmul : (Real.sqrt 3 : ℂ) *
        (twelfthRootOfUnity * ((Real.sqrt 3 : ℂ) * twelfthRootOfUnity) * (3 : ℂ)⁻¹ -
          twelfthRootOfUnity) = -1 := by
      calc
        (Real.sqrt 3 : ℂ) *
            (twelfthRootOfUnity * ((Real.sqrt 3 : ℂ) * twelfthRootOfUnity) * (3 : ℂ)⁻¹ -
              twelfthRootOfUnity)
          = (Real.sqrt 3 : ℂ) ^ 2 * (3 : ℂ)⁻¹ * twelfthRootOfUnity ^ 2 -
              (Real.sqrt 3 : ℂ) * twelfthRootOfUnity := by ring
        _ = twelfthRootOfUnity ^ 2 - (1 + twelfthRootOfUnity ^ 2) := by
              rw [sqrt_three_sq, ← one_add_twelfthRootOfUnity_sq]; ring
        _ = -1 := by ring
    apply mul_left_cancel₀ hsqrt_ne
    rw [hmul, mul_neg, mul_inv_cancel₀ hsqrt_ne]
  have hc2 : twelfthRootOfUnity * (1 + twelfthRootOfUnity ^ 2) * (3 : ℂ)⁻¹ =
      -(Real.sqrt 3 : ℂ)⁻¹ * (cubeRootOfUnity : ℂ) ^ 2 := by
    rw [one_add_twelfthRootOfUnity_sq]
    calc
      twelfthRootOfUnity * ((Real.sqrt 3 : ℂ) * twelfthRootOfUnity) * (3 : ℂ)⁻¹
        = ((Real.sqrt 3 : ℂ) * (3 : ℂ)⁻¹) * twelfthRootOfUnity ^ 2 := by ring
      _ = (Real.sqrt 3 : ℂ)⁻¹ * (-(cubeRootOfUnity : ℂ) ^ 2) := by rw [h3inv, ← hω2]
      _ = -(Real.sqrt 3 : ℂ)⁻¹ * (cubeRootOfUnity : ℂ) ^ 2 := by ring
  simp only [gaussianBraidGenerator_def, cubicProjection_def, smul_sub, smul_add, smul_smul,
    ← mul_assoc]
  rw [add_assoc ((twelfthRootOfUnity * (1 + twelfthRootOfUnity ^ 2) * (3 : ℂ)⁻¹) • (1 : _)),
    add_sub_right_comm, ← sub_smul, hc1, hc2]

/-- Weyl-basis expansion of the adjoint
`star g_j = -(√3)⁻¹ • (1 + ω • (U_j + U_j ^ 2))`. -/
theorem star_gaussianBraidGenerator_eq_weyl (N : ℕ) (j : Fin N) :
    star (gaussianBraidGenerator N j) =
      -((Real.sqrt 3 : ℂ)⁻¹) •
        (1 + (cubeRootOfUnity : ℂ) • (cubicSite N j + cubicSite N j ^ 2)) := by
  have hωstar : star ((cubeRootOfUnity : ℂ) ^ 2) = (cubeRootOfUnity : ℂ) := by
    rw [star_pow, star_cubeRootOfUnity_val]
    have hmul : ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) ^ 2 * (cubeRootOfUnity : ℂ) ^ 2 = 1 := by
      rw [← mul_pow, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_pow]
    calc
      ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) ^ 2
        = ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) ^ 2 * (cubeRootOfUnity : ℂ) ^ 3 := by
            rw [cubeRootOfUnity_val_pow_three, mul_one]
      _ = (((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) ^ 2 * (cubeRootOfUnity : ℂ) ^ 2) *
            (cubeRootOfUnity : ℂ) := by ring
      _ = (cubeRootOfUnity : ℂ) := by rw [hmul, one_mul]
  have h4 : cubicSite N j ^ 4 = cubicSite N j := by
    rw [pow_succ, cubicSite_pow_three, one_mul]
  rw [gaussianBraidGenerator_eq_weyl, star_smul, star_add, star_one, star_smul, star_add,
    hωstar, star_pow, star_cubicSite, ← pow_mul, h4, add_comm (cubicSite N j ^ 2)]
  have hcoef : star (-(Real.sqrt 3 : ℂ)⁻¹) = -(Real.sqrt 3 : ℂ)⁻¹ := by simp
  rw [hcoef]

/-- Spectral decomposition `g_j = i • p_j + (-u) • (1 - p_j)`. -/
theorem gaussianBraidGenerator_eq_spectral (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j =
      Complex.I • cubicProjection N j + (-twelfthRootOfUnity) • (1 - cubicProjection N j) := by
  rw [gaussianBraidGenerator_def, smul_sub, smul_smul, smul_sub]
  have hc : twelfthRootOfUnity * (1 + twelfthRootOfUnity ^ 2) =
      Complex.I + twelfthRootOfUnity := by
    rw [mul_add, mul_one, ← pow_succ', twelfthRootOfUnity_pow_three]
    ring
  rw [hc, add_smul, neg_smul, neg_smul]
  abel

private theorem star_gaussianBraidGenerator_eq_spectral (N : ℕ) (j : Fin N) :
    star (gaussianBraidGenerator N j) =
      (-Complex.I) • cubicProjection N j +
        (-twelfthRootOfUnity⁻¹) • (1 - cubicProjection N j) := by
  rw [gaussianBraidGenerator_eq_spectral, star_add, star_smul, star_smul, star_sub, star_one,
    star_cubicProjection, star_neg, star_twelfthRootOfUnity, Complex.star_def, Complex.conj_I]

private theorem cubicProjection_spectral_mul (N : ℕ) (j : Fin N) (a b c d : ℂ) :
    (a • cubicProjection N j + b • (1 - cubicProjection N j)) *
        (c • cubicProjection N j + d • (1 - cubicProjection N j)) =
      (a * c) • cubicProjection N j + (b * d) • (1 - cubicProjection N j) := by
  have horth1 : cubicProjection N j * (1 - cubicProjection N j) = 0 := by
    rw [mul_sub, mul_one, cubicProjection_mul_self, sub_self]
  have horth2 : (1 - cubicProjection N j) * cubicProjection N j = 0 := by
    rw [sub_mul, one_mul, cubicProjection_mul_self, sub_self]
  have hcomp : (1 - cubicProjection N j) * (1 - cubicProjection N j) = 1 - cubicProjection N j := by
    rw [mul_sub, mul_one, horth2, sub_zero]
  rw [add_mul, mul_add, mul_add, smul_mul_smul_comm, smul_mul_smul_comm, smul_mul_smul_comm,
    smul_mul_smul_comm, cubicProjection_mul_self, horth1, horth2, hcomp, smul_zero, smul_zero,
    add_zero, zero_add]

/-- Every Gaussian braid generator is unitary: `star g_j * g_j = 1`. -/
@[simp]
theorem star_gaussianBraidGenerator_mul_self (N : ℕ) (j : Fin N) :
    star (gaussianBraidGenerator N j) * gaussianBraidGenerator N j = 1 := by
  rw [star_gaussianBraidGenerator_eq_spectral, gaussianBraidGenerator_eq_spectral,
    cubicProjection_spectral_mul]
  have hI : (-Complex.I) * Complex.I = 1 := by
    rw [neg_mul, Complex.I_mul_I, neg_neg]
  have hu : (-twelfthRootOfUnity⁻¹) * (-twelfthRootOfUnity) = 1 := by
    rw [neg_mul_neg, inv_mul_cancel₀ twelfthRootOfUnity_ne_zero]
  rw [hI, hu, one_smul, one_smul, add_sub_cancel]

/-- Every Gaussian braid generator is unitary: `g_j * star g_j = 1`. -/
@[simp]
theorem gaussianBraidGenerator_mul_star_self (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j * star (gaussianBraidGenerator N j) = 1 := by
  rw [star_gaussianBraidGenerator_eq_spectral, gaussianBraidGenerator_eq_spectral,
    cubicProjection_spectral_mul]
  have hI : Complex.I * (-Complex.I) = 1 := by
    rw [mul_neg, Complex.I_mul_I, neg_neg]
  have hu : (-twelfthRootOfUnity) * (-twelfthRootOfUnity⁻¹) = 1 := by
    rw [neg_mul_neg, mul_inv_cancel₀ twelfthRootOfUnity_ne_zero]
  rw [hI, hu, one_smul, one_smul, add_sub_cancel]

/-- The Gaussian braid generator `g_j`, bundled as a unitary unit in `(CubicTorus N)ˣ`. -/
noncomputable def gaussianBraidUnit (N : ℕ) (j : Fin N) : (CubicTorus N)ˣ where
  val := gaussianBraidGenerator N j
  inv := star (gaussianBraidGenerator N j)
  val_inv := gaussianBraidGenerator_mul_star_self N j
  inv_val := star_gaussianBraidGenerator_mul_self N j

/-- The underlying value of `gaussianBraidUnit N j`. -/
@[simp]
theorem gaussianBraidUnit_val (N : ℕ) (j : Fin N) :
    (gaussianBraidUnit N j : CubicTorus N) = gaussianBraidGenerator N j := (rfl)

/-- The inverse of `gaussianBraidUnit N j` is `star (gaussianBraidGenerator N j)`. -/
@[simp]
theorem gaussianBraidUnit_inv_val (N : ℕ) (j : Fin N) :
    (((gaussianBraidUnit N j)⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) =
      star (gaussianBraidGenerator N j) := (rfl)

/-- Every Gaussian braid generator cubes to `-i`: `g_j ^ 3 = (-I) • 1`. -/
@[simp]
theorem gaussianBraidGenerator_pow_three (N : ℕ) (j : Fin N) :
    gaussianBraidGenerator N j ^ 3 = (-Complex.I) • (1 : CubicTorus N) := by
  have hpow (a b : ℂ) (m : ℕ) :
      (a • cubicProjection N j + b • (1 - cubicProjection N j)) ^ (m + 1) =
        (a ^ (m + 1)) • cubicProjection N j + (b ^ (m + 1)) • (1 - cubicProjection N j) := by
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, ih, cubicProjection_spectral_mul, ← pow_succ, ← pow_succ]
  rw [gaussianBraidGenerator_eq_spectral, hpow _ _ 2]
  have hI3 : Complex.I ^ 3 = -Complex.I := by
    rw [pow_succ, Complex.I_sq]; ring
  have hu3 : (-twelfthRootOfUnity) ^ 3 = -Complex.I := by
    rw [neg_pow, show (-1 : ℂ) ^ 3 = -1 by norm_num, twelfthRootOfUnity_pow_three]
    ring
  rw [hI3, hu3, ← smul_add, add_sub_cancel]

/-- Every Gaussian braid unit has order dividing `12`: `g_j ^ 12 = 1`. -/
@[simp]
theorem gaussianBraidUnit_pow_twelve (N : ℕ) (j : Fin N) :
    gaussianBraidUnit N j ^ 12 = 1 := by
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_one, gaussianBraidUnit_val,
    show (12 : ℕ) = 3 * 4 by decide, pow_mul, gaussianBraidGenerator_pow_three, smul_pow, one_pow]
  have hI4 : (-Complex.I) ^ 4 = 1 := by
    have h : (-Complex.I) ^ 4 = (Complex.I ^ 2) ^ 2 := by ring
    rw [h, Complex.I_sq]
    norm_num
  rw [hI4, one_smul]

/-- Distant Gaussian braid units commute when `|i - j| ≥ 2`. -/
theorem gaussianBraidUnit_mul_comm {N : ℕ} {i j : Fin N}
    (hij : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    gaussianBraidUnit N i * gaussianBraidUnit N j =
      gaussianBraidUnit N j * gaussianBraidUnit N i := by
  apply Units.ext
  simp only [Units.val_mul, gaussianBraidUnit_val, gaussianBraidGenerator_eq_crossing,
    ← MulMemClass.coe_mul, ← map_mul]
  congr 2
  exact crossing_mul_crossing_comm _ _ _ _ hij

/-- Adjacent Gaussian braid units satisfy the Artin braid relation. -/
theorem gaussianBraidUnit_braid {N : ℕ} {i j : Fin N}
    (hij : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    gaussianBraidUnit N i * gaussianBraidUnit N j * gaussianBraidUnit N i =
      gaussianBraidUnit N j * gaussianBraidUnit N i * gaussianBraidUnit N j := by
  have hcoef : twelfthRootOfUnity ^ 2 *
      ((-twelfthRootOfUnity) ^ 2 +
        (-twelfthRootOfUnity) * twelfthRootOfUnity ^ 2 * (Real.sqrt 3 : ℂ) +
        (twelfthRootOfUnity ^ 2) ^ 2) = 0 := by
    have hmul : (-twelfthRootOfUnity) * twelfthRootOfUnity ^ 2 * (Real.sqrt 3 : ℂ) =
        -twelfthRootOfUnity ^ 2 * (1 + twelfthRootOfUnity ^ 2) := by
      rw [one_add_twelfthRootOfUnity_sq]
      ring
    rw [hmul]
    ring
  apply Units.ext
  simp only [Units.val_mul, gaussianBraidUnit_val, gaussianBraidGenerator_eq_crossing,
    ← MulMemClass.coe_mul, ← map_mul]
  congr 2
  exact crossing_braid hcoef hij

/-- The **Gaussian braid representation** `BraidGroup (N + 1) →* (CubicTorus N)ˣ` sending each
elementary braid `BraidGroup.sigma j` to `gaussianBraidUnit N j`. -/
noncomputable def gaussianBraid (N : ℕ) : BraidGroup (N + 1) →* (CubicTorus N)ˣ :=
  BraidGroup.lift (gaussianBraidUnit N)
    (fun h ↦ gaussianBraidUnit_mul_comm h)
    (fun h ↦ gaussianBraidUnit_braid h)

/-- `gaussianBraid N` sends `BraidGroup.sigma j` to `gaussianBraidUnit N j`. -/
@[simp]
theorem gaussianBraid_sigma (N : ℕ) (j : Fin N) :
    gaussianBraid N (BraidGroup.sigma j) = gaussianBraidUnit N j := by
  rw [gaussianBraid, BraidGroup.lift_sigma]

/-- For any unit `a : ℂˣ` satisfying `a ^ 2 = -u⁻¹`, the Jones loop value `jonesDelta a` is `√3`. -/
theorem jonesDelta_eq_sqrt_three_of_sq_eq {a : ℂˣ}
    (ha : (a : ℂ) ^ 2 = -twelfthRootOfUnity⁻¹) :
    jonesDelta a = (Real.sqrt 3 : ℂ) := by
  have hinv : ((a⁻¹ : ℂˣ) : ℂ) ^ 2 = -twelfthRootOfUnity := by
    have hmul : (a : ℂ) ^ 2 * ((a⁻¹ : ℂˣ) : ℂ) ^ 2 = 1 := by
      rw [← mul_pow, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_pow]
    rw [ha] at hmul
    apply mul_left_cancel₀ (neg_ne_zero.mpr (inv_ne_zero twelfthRootOfUnity_ne_zero))
    rw [hmul, neg_mul_neg, inv_mul_cancel₀ twelfthRootOfUnity_ne_zero]
  rw [jonesDelta_def, ha, hinv]
  linear_combination twelfthRootOfUnity_add_inv

/-- For any unit `a : ℂˣ` satisfying `a ^ 2 = -u⁻¹`, the image under `cubicFixedHom (N + 1)` of
the Jones crossing `a • 1 + a⁻¹ • e j` is `(-a / u) • g_j`. -/
theorem cubicFixedHom_crossing_eq_gaussianBraidGenerator (N : ℕ) {a : ℂˣ}
    (ha : (a : ℂ) ^ 2 = -twelfthRootOfUnity⁻¹) (j : Fin N) :
    ((cubicFixedHom (N + 1) (crossing (Real.sqrt 3 : ℂ) (a : ℂ) ((a⁻¹ : ℂˣ) : ℂ) j)).1 :
        CubicTorus N) =
      (-(a : ℂ) / twelfthRootOfUnity) • gaussianBraidGenerator N j := by
  have hinv_a : ((a⁻¹ : ℂˣ) : ℂ) = -(a : ℂ) * twelfthRootOfUnity := by
    have hmul : (a : ℂ) * ((a⁻¹ : ℂˣ) : ℂ) = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    apply mul_left_cancel₀ (Units.ne_zero a)
    rw [hmul, ← mul_assoc, mul_neg, ← sq, ha, neg_neg, inv_mul_cancel₀ twelfthRootOfUnity_ne_zero]
  rw [crossing_def, map_add, map_smul, map_smul, map_one, AddMemClass.coe_add,
    SetLike.val_smul, SetLike.val_smul, OneMemClass.coe_one, coe_cubicFixedHom_e,
    gaussianBraidGenerator_def, smul_smul, smul_smul, smul_sub, smul_smul,
    one_add_twelfthRootOfUnity_sq, hinv_a]
  have h1 : -(a : ℂ) / twelfthRootOfUnity * twelfthRootOfUnity = -(a : ℂ) := by
    field_simp [twelfthRootOfUnity_ne_zero]
  have h2 : -(a : ℂ) / twelfthRootOfUnity * twelfthRootOfUnity *
      ((Real.sqrt 3 : ℂ) * twelfthRootOfUnity) =
      -(a : ℂ) * twelfthRootOfUnity * (Real.sqrt 3 : ℂ) := by
    rw [h1]
    ring
  rw [h2, h1, neg_smul, sub_neg_eq_add]
  exact add_comm _ _

/-! ### Symplectic transvection action on the Weyl basis -/

/-- **Conjugation by a Gaussian braid unit acts on the Weyl basis as a symplectic transvection**:
`g_j * W(a) * g_j⁻¹ = W(a + B(a, e_j) • e_j)`. -/
theorem gaussianBraidUnit_conj_weyl (N : ℕ) (j : Fin N) (a : Fin N → ZMod 3) :
    (gaussianBraidUnit N j : CubicTorus N) * weyl N (Multiplicative.ofAdd a) *
        (((gaussianBraidUnit N j)⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) =
      weyl N (Multiplicative.ofAdd (a + chainForm N a (Pi.single j 1) • Pi.single j 1)) := by
  set U : CubicTorus N := cubicSite N j
  set W : CubicTorus N := weyl N (Multiplicative.ofAdd a)
  set ω : ℂ := (cubeRootOfUnity : ℂ)
  have hω3 : ω ^ 3 = 1 := cubeRootOfUnity_val_pow_three
  have hωsum : 1 + ω + ω ^ 2 = 0 := one_add_cubeRootOfUnity_add_sq
  have hU3 : U ^ 3 = 1 := cubicSite_pow_three N j
  have hU_def : U = weyl N (Multiplicative.ofAdd (Pi.single j 1)) := cubicSite_def N j
  have hgw : gaussianBraidGenerator N j =
      -((Real.sqrt 3 : ℂ)⁻¹) • (1 + ω ^ 2 • (U + U ^ 2)) :=
    gaussianBraidGenerator_eq_weyl N j
  have hsgw : star (gaussianBraidGenerator N j) =
      -((Real.sqrt 3 : ℂ)⁻¹) • (1 + ω • (U + U ^ 2)) :=
    star_gaussianBraidGenerator_eq_weyl N j
  have hU_comm : U * W = (cubeRootPow (-chainForm N a (Pi.single j 1)) : ℂ) • (W * U) := by
    rw [hU_def, weyl_mul_comm_factor, toAdd_ofAdd, toAdd_ofAdd, chainForm_swap]
  have hsqrt_inv : (-(Real.sqrt 3 : ℂ)⁻¹) * (-(Real.sqrt 3 : ℂ)⁻¹) = (3 : ℂ)⁻¹ := by
    rw [neg_mul_neg, ← mul_inv, ← sq, sqrt_three_sq]
  have hU2_weyl : U ^ 2 = weyl N (Multiplicative.ofAdd ((2 : ZMod 3) • Pi.single j 1)) := by
    rw [hU_def, weyl_sq]
    congr 1
    apply Multiplicative.toAdd.injective
    ext k
    simp only [toAdd_inv, toAdd_ofAdd, Pi.neg_apply, Pi.smul_apply, smul_eq_mul]
    have h2 : (2 : ZMod 3) = -1 := by decide
    rw [h2, neg_one_mul]
  generalize hc : chainForm N a (Pi.single j 1) = c
  rw [hc] at hU_comm
  rcases zmod3_cases c with rfl | rfl | rfl
  · -- Case `B(a, e_j) = 0`: `U_j` commutes with `W(a)`, hence `g_j` commutes with `W(a)`.
    have hcommU : U * W = W * U := by
      simpa [neg_zero, cubeRootPow_zero] using hU_comm
    have hcommU2 : U ^ 2 * W = W * U ^ 2 := by
      rw [sq, mul_assoc, hcommU, ← mul_assoc, hcommU, mul_assoc, ← sq]
    have hcommg : gaussianBraidGenerator N j * W = W * gaussianBraidGenerator N j := by
      rw [hgw]
      simp only [smul_mul_assoc, mul_smul_comm, add_mul, mul_add, one_mul, mul_one,
        hcommU, hcommU2]
    rw [gaussianBraidUnit_val, gaussianBraidUnit_inv_val, zero_smul, add_zero, hcommg,
      mul_assoc, gaussianBraidGenerator_mul_star_self, mul_one]
  · -- Case `B(a, e_j) = 1`: `U * W = ω ^ 2 • W * U`, giving `ω • (W * U) = W(a + e_j)`.
    have hUW : U * W = (ω ^ 2) • (W * U) := by
      have hneg1 : (-1 : ZMod 3) = 2 := by decide
      simpa [hneg1, cubeRootPow_two, Units.val_pow_eq_pow_val, ω] using hU_comm
    have hU2W : U ^ 2 * W = ω • (W * U ^ 2) := by
      calc
        U ^ 2 * W = U * (U * W) := by rw [sq, mul_assoc]
        _ = (ω ^ 2) • (U * (W * U)) := by rw [hUW, mul_smul_comm]
        _ = (ω ^ 4) • (W * U ^ 2) := by
              rw [← mul_assoc, hUW, smul_mul_assoc, smul_smul, mul_assoc, ← sq]
              congr 1; ring
        _ = ω • (W * U ^ 2) := by
              have h4 : ω ^ 4 = ω := by
                calc
                  ω ^ 4 = ω ^ 3 * ω := by ring
                  _ = ω := by rw [hω3, one_mul]
              rw [h4]
    have hpoly : (1 + ω • U + U ^ 2) * (1 + ω • (U + U ^ 2)) = (3 * ω) • U := by
      have hU4 : U ^ 2 * U ^ 2 = U := by
        rw [← pow_add, show (2 + 2 : ℕ) = 3 + 1 by decide, pow_succ, hU3, one_mul]
      have hU21 : U ^ 2 * U = 1 := by rw [← pow_succ, hU3]
      have hU12 : U * U ^ 2 = 1 := by rw [← pow_succ', hU3]
      calc
        (1 + ω • U + U ^ 2) * (1 + ω • (U + U ^ 2))
          = (1 + ω ^ 2 + ω) • (1 : CubicTorus N) + (ω + ω + ω) • U +
              (ω + ω ^ 2 + 1) • U ^ 2 := by
              simp only [smul_add, add_mul, mul_add, one_mul, mul_one, smul_mul_assoc,
                mul_smul_comm, smul_smul, hU4, ← sq, hU12, hU21]
              module
        _ = (3 * ω) • U := by
              have hz1 : 1 + ω ^ 2 + ω = 0 := by linear_combination hωsum
              have hz2 : ω + ω ^ 2 + 1 = 0 := by linear_combination hωsum
              have h3ω : ω + ω + ω = 3 * ω := by ring
              rw [hz1, hz2, h3ω, zero_smul, zero_smul, zero_add, add_zero]
    have hpush : gaussianBraidGenerator N j * W =
        (-(Real.sqrt 3 : ℂ)⁻¹) • (W * (1 + ω • U + U ^ 2)) := by
      rw [hgw]
      simp only [smul_mul_assoc, add_mul, one_mul, hUW, hU2W, mul_add, mul_one, mul_smul_comm,
        smul_add, smul_smul]
      have h4 : ω ^ 2 * ω ^ 2 = ω := by
        calc
          ω ^ 2 * ω ^ 2 = ω ^ 3 * ω := by ring
          _ = ω := by rw [hω3, one_mul]
      have h3 : ω ^ 2 * ω = 1 := by
        calc
          ω ^ 2 * ω = ω ^ 3 := by ring
          _ = 1 := hω3
      rw [mul_assoc (-(Real.sqrt 3 : ℂ)⁻¹), mul_assoc (-(Real.sqrt 3 : ℂ)⁻¹), h4, h3, mul_one,
        ← add_assoc]
    have hconj : gaussianBraidGenerator N j * W * star (gaussianBraidGenerator N j) =
        ω • (W * U) := by
      rw [hpush, hsgw, smul_mul_smul_comm, hsqrt_inv, mul_assoc, hpoly, mul_smul_comm, smul_smul]
      congr 1
      ring
    rw [gaussianBraidUnit_val, gaussianBraidUnit_inv_val, hconj, one_smul]
    simp only [W, hU_def, weyl_mul, smul_smul, ← ofAdd_add]
    have hfac : ω * (cubicFactor N (Multiplicative.ofAdd a)
        (Multiplicative.ofAdd (Pi.single j 1)) : ℂ) = 1 := by
      rw [cubicFactor_def, toAdd_ofAdd, toAdd_ofAdd, hc, mul_one, cubeRootPow_two,
        Units.val_pow_eq_pow_val]
      calc
        ω * ω ^ 2 = ω ^ 3 := by ring
        _ = 1 := hω3
    rw [hfac, one_smul]
  · -- Case `B(a, e_j) = 2`: `U * W = ω • W * U`, giving `ω • (W * U ^ 2) = W(a + 2 • e_j)`.
    have hUW : U * W = ω • (W * U) := by
      have hneg2 : (-2 : ZMod 3) = 1 := by decide
      simpa [hneg2, cubeRootPow_one, ω] using hU_comm
    have hU2W : U ^ 2 * W = (ω ^ 2) • (W * U ^ 2) := by
      calc
        U ^ 2 * W = U * (U * W) := by rw [sq, mul_assoc]
        _ = ω • (U * (W * U)) := by rw [hUW, mul_smul_comm]
        _ = (ω ^ 2) • (W * U ^ 2) := by
              rw [← mul_assoc, hUW, smul_mul_assoc, smul_smul, ← sq, mul_assoc, ← sq]
    have hpoly : (1 + U + ω • U ^ 2) * (1 + ω • (U + U ^ 2)) = (3 * ω) • U ^ 2 := by
      have hU4 : U ^ 2 * U ^ 2 = U := by
        rw [← pow_add, show (2 + 2 : ℕ) = 3 + 1 by decide, pow_succ, hU3, one_mul]
      have hU21 : U ^ 2 * U = 1 := by rw [← pow_succ, hU3]
      have hU12 : U * U ^ 2 = 1 := by rw [← pow_succ', hU3]
      calc
        (1 + U + ω • U ^ 2) * (1 + ω • (U + U ^ 2))
          = (1 + ω + ω ^ 2) • (1 : CubicTorus N) + (ω + 1 + ω ^ 2) • U +
              (ω + ω + ω) • U ^ 2 := by
              simp only [smul_add, add_mul, mul_add, one_mul, mul_one, smul_mul_assoc,
                mul_smul_comm, smul_smul, hU4, ← sq, hU12, hU21]
              module
        _ = (3 * ω) • U ^ 2 := by
              have hz1 : ω + 1 + ω ^ 2 = 0 := by linear_combination hωsum
              have h3ω : ω + ω + ω = 3 * ω := by ring
              rw [hωsum, hz1, h3ω, zero_smul, zero_smul, zero_add, zero_add]
    have hpush : gaussianBraidGenerator N j * W =
        (-(Real.sqrt 3 : ℂ)⁻¹) • (W * (1 + U + ω • U ^ 2)) := by
      rw [hgw]
      simp only [smul_mul_assoc, add_mul, one_mul, hUW, hU2W, mul_add, mul_one, mul_smul_comm,
        smul_add, smul_smul]
      have h4 : ω ^ 2 * ω ^ 2 = ω := by
        calc
          ω ^ 2 * ω ^ 2 = ω ^ 3 * ω := by ring
          _ = ω := by rw [hω3, one_mul]
      have h3 : ω ^ 2 * ω = 1 := by
        calc
          ω ^ 2 * ω = ω ^ 3 := by ring
          _ = 1 := hω3
      rw [mul_assoc (-(Real.sqrt 3 : ℂ)⁻¹), mul_assoc (-(Real.sqrt 3 : ℂ)⁻¹), h3, h4, mul_one,
        ← add_assoc]
    have hconj : gaussianBraidGenerator N j * W * star (gaussianBraidGenerator N j) =
        ω • (W * U ^ 2) := by
      rw [hpush, hsgw, smul_mul_smul_comm, hsqrt_inv, mul_assoc, hpoly, mul_smul_comm, smul_smul]
      congr 1
      ring
    rw [gaussianBraidUnit_val, gaussianBraidUnit_inv_val, hconj, hU2_weyl]
    simp only [W, weyl_mul, smul_smul, ← ofAdd_add]
    have hfac : ω * (cubicFactor N (Multiplicative.ofAdd a)
        (Multiplicative.ofAdd ((2 : ZMod 3) • Pi.single j 1)) : ℂ) = 1 := by
      rw [cubicFactor_def, toAdd_ofAdd, toAdd_ofAdd, chainForm_smul_right, hc]
      have h222 : (2 : ZMod 3) * (2 * 2) = 2 := by decide
      rw [h222, cubeRootPow_two, Units.val_pow_eq_pow_val]
      calc
        ω * ω ^ 2 = ω ^ 3 := by ring
        _ = 1 := hω3
    rw [hfac, one_smul]

/-! ### Radical of `chainForm N`, center of `CubicTorus N`, and finiteness of the braid image -/

/-- The alternating indicator `(1, 0, 1, 0, …)` on `Fin N`, spanning the radical of `chainForm N`
when `N` is odd. -/
private def oddRadicalVec (N : ℕ) : Fin N → ZMod 3 :=
  fun i ↦ if Even i.val then 1 else 0

private theorem chainForm_radical_step {N : ℕ} {a : Fin N → ZMod 3}
    (ha : ∀ b, chainForm N a b = 0) :
    (∀ i : Fin N, Odd i.val → a i = 0) ∧
    (∀ i : Fin N, Even i.val → a i = a ⟨0, Nat.zero_lt_of_lt i.2⟩) := by
  have h1 : ∀ (n : ℕ) (hn : n < N),
      (Odd n → a ⟨n, hn⟩ = 0) ∧ (Even n → a ⟨n, hn⟩ = a ⟨0, by omega⟩) := by
    intro n
    induction n using Nat.strongRecOn with
    | ind n ih =>
      intro hn
      match n with
      | 0 =>
        exact ⟨fun h ↦ absurd h (by decide), fun _ ↦ rfl⟩
      | 1 =>
        refine ⟨fun _ ↦ ?_, fun h ↦ absurd h (by decide)⟩
        have h0 := ha (Pi.single ⟨0, by omega⟩ 1)
        rw [chainForm_single_right] at h0
        simpa [hn] using h0
      | m + 2 =>
        have hmid := ha (Pi.single ⟨m + 1, by omega⟩ 1)
        rw [chainForm_single_right] at hmid
        have hstep : a ⟨m, by omega⟩ - a ⟨m + 2, hn⟩ = 0 := by
          simpa [hn] using hmid
        have heq : a ⟨m + 2, hn⟩ = a ⟨m, by omega⟩ := (sub_eq_zero.mp hstep).symm
        obtain ⟨hodd, heven⟩ := ih m (by omega) (by omega)
        refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
        · rw [heq]
          apply hodd
          obtain ⟨k, hk⟩ := h
          exact ⟨k - 1, by omega⟩
        · rw [heq]
          apply heven
          obtain ⟨k, hk⟩ := h
          exact ⟨k - 1, by omega⟩
  exact ⟨fun i hi ↦ (h1 i.val i.2).1 hi, fun i hi ↦ (h1 i.val i.2).2 hi⟩

private theorem chainForm_radical_eq_zero_of_even {N : ℕ} (hN : Even N) {a : Fin N → ZMod 3}
    (ha : ∀ b, chainForm N a b = 0) : a = 0 := by
  obtain ⟨hodd, heven⟩ := chainForm_radical_step ha
  ext i
  rcases Nat.even_or_odd i.val with hi | hi
  · rw [heven i hi]
    obtain ⟨k, hk⟩ := hN
    have hiN : i.val < N := i.2
    have hkpos : 0 < k := by omega
    have hlast := ha (Pi.single ⟨N - 1, by omega⟩ 1)
    rw [chainForm_single_right] at hlast
    have hne : ¬ (N - 1) + 1 < N := by omega
    have hpos : 0 < N - 1 := by omega
    have ha_prev : a ⟨N - 1 - 1, by omega⟩ = 0 := by
      simpa [hpos, hne] using hlast
    have hev_prev : Even (N - 1 - 1) := ⟨k - 1, by omega⟩
    have hEq := heven ⟨N - 1 - 1, by omega⟩ hev_prev
    rw [← hEq, ha_prev]
    rfl
  · exact hodd i hi

private theorem chainForm_radical_of_odd {N : ℕ} (hN : Odd N) {a : Fin N → ZMod 3}
    (ha : ∀ b, chainForm N a b = 0) :
    a = a ⟨0, by obtain ⟨k, hk⟩ := hN; omega⟩ • oddRadicalVec N := by
  obtain ⟨hodd, heven⟩ := chainForm_radical_step ha
  ext i
  simp only [Pi.smul_apply, smul_eq_mul, oddRadicalVec]
  rcases Nat.even_or_odd i.val with hi | hi
  · simp [hi, heven i hi]
  · have hnev : ¬ Even i.val := Nat.not_even_iff_odd.mpr hi
    simp [hnev, hodd i hi]

private theorem chainForm_oddRadicalVec_single {N : ℕ} (hN : Odd N) (k : Fin N) :
    chainForm N (oddRadicalVec N) (Pi.single k 1) = 0 := by
  obtain ⟨m, hm⟩ := hN
  rw [chainForm_single_right]
  rcases Nat.even_or_odd k.val with hk | hk
  · -- `k` is even, so both `k - 1` (if `0 < k`) and `k + 1` (if `< N`) are odd.
    obtain ⟨r, hr⟩ := hk
    split_ifs with h1 h2 h3
    · have ho1 : ¬ Even (k.val - 1) := Nat.not_even_iff_odd.mpr ⟨r - 1, by omega⟩
      have ho2 : ¬ Even (k.val + 1) := Nat.not_even_iff_odd.mpr ⟨r, by omega⟩
      simp [oddRadicalVec, ho1, ho2]
    · have ho1 : ¬ Even (k.val - 1) := Nat.not_even_iff_odd.mpr ⟨r - 1, by omega⟩
      simp [oddRadicalVec, ho1]
    · have ho2 : ¬ Even (k.val + 1) := Nat.not_even_iff_odd.mpr ⟨r, by omega⟩
      simp [oddRadicalVec, ho2]
    · simp
  · -- `k` is odd and `< 2m + 1`, so `0 < k` and `k + 1 < 2m + 1`, and both neighbors are even.
    obtain ⟨r, hr⟩ := hk
    have h1 : 0 < k.val := by omega
    have h2 : k.val + 1 < N := by omega
    have he1 : Even (k.val - 1) := ⟨r, by omega⟩
    have he2 : Even (k.val + 1) := ⟨r + 1, by omega⟩
    simp [h1, h2, oddRadicalVec, he1, he2]

private theorem chainForm_oddRadicalVec {N : ℕ} (hN : Odd N) (b : Fin N → ZMod 3) :
    chainForm N (oddRadicalVec N) b = 0 := by
  have hb : b = ∑ k : Fin N, b k • Pi.single k (1 : ZMod 3) := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  rw [hb]
  have hsum (s : Finset (Fin N)) :
      chainForm N (oddRadicalVec N) (∑ k ∈ s, b k • Pi.single k (1 : ZMod 3)) = 0 := by
    classical
    induction s using Finset.induction_on with
    | empty => simp
    | insert k s _ ih =>
      rw [Finset.sum_insert ‹_›, chainForm_add_right, chainForm_smul_right,
        chainForm_oddRadicalVec_single hN k, mul_zero, zero_add, ih]
  exact hsum Finset.univ

private theorem mem_radical_of_commute_weyl {N : ℕ} {z : CubicTorus N}
    (hz : ∀ b, z * weyl N b = weyl N b * z)
    {a : Multiplicative (Fin N → ZMod 3)}
    (ha : (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)).repr
      z a ≠ 0) :
    ∀ b : Fin N → ZMod 3, chainForm N a.toAdd b = 0 := by
  intro b
  set bM : Multiplicative (Fin N → ZMod 3) := Multiplicative.ofAdd b
  have hcoord :
      (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)).repr
          (z * weyl N bM) (a * bM) =
        (cubicFactor N a bM : ℂ) *
          (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)).repr
            z a := by
    have hmul :=
      TwistedMonoidAlgebra.scalarTrace_mul_of_inv (cubicFactor N) (z * weyl N bM) (a * bM)
    have hinv : weyl N bM * weyl N (a * bM)⁻¹ =
        (cubicFactor N bM (a * bM)⁻¹ : ℂ) • weyl N a⁻¹ := by
      rw [weyl_mul]
      congr 1
      group
    have hmul' :
        TwistedMonoidAlgebra.scalarTrace (cubicFactor N) (z * weyl N bM * weyl N (a * bM)⁻¹) =
          (cubicFactor N bM (a * bM)⁻¹ : ℂ) *
            ((cubicFactor N a a⁻¹ : ℂ) *
              (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
                (cubicFactor N)).repr z a) := by
      rw [mul_assoc, hinv, mul_smul_comm, map_smul, smul_eq_mul, weyl_def,
        TwistedMonoidAlgebra.scalarTrace_mul_of_inv]
    rw [← weyl_def] at hmul
    rw [hmul', cubicFactor_inv_self, Units.val_one, one_mul] at hmul
    have hcocycle : cubicFactor N bM (a * bM)⁻¹ = cubicFactor N a bM := by
      simp only [cubicFactor_def, toAdd_inv, toAdd_mul, neg_add]
      congr 1
      rw [chainForm_add_right, chainForm_neg_right, chainForm_neg_right, chainForm_self,
        neg_zero, add_zero, chainForm_swap, neg_neg]
    rw [cubicFactor_inv_self, Units.val_one, one_mul, hcocycle] at hmul
    exact hmul.symm
  have hcoord2 :
      (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)).repr
          (weyl N bM * z) (a * bM) =
        (cubicFactor N bM a : ℂ) *
          (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)).repr
            z a := by
    have hmul :=
      TwistedMonoidAlgebra.scalarTrace_mul_of_inv (cubicFactor N) (weyl N bM * z) (a * bM)
    rw [← weyl_def, TwistedMonoidAlgebra.scalarTrace_mul_comm, ← mul_assoc] at hmul
    have hinv : weyl N (a * bM)⁻¹ * weyl N bM =
        (cubicFactor N (a * bM)⁻¹ bM : ℂ) • weyl N a⁻¹ := by
      rw [weyl_mul]
      congr 1
      rw [mul_comm a bM]
      group
    rw [hinv, smul_mul_assoc, map_smul, smul_eq_mul, TwistedMonoidAlgebra.scalarTrace_mul_comm,
      weyl_def, TwistedMonoidAlgebra.scalarTrace_mul_of_inv, cubicFactor_inv_self,
      cubicFactor_inv_self, Units.val_one, one_mul, one_mul] at hmul
    have hcocycle : cubicFactor N (a * bM)⁻¹ bM = cubicFactor N bM a := by
      simp only [cubicFactor_def, toAdd_inv, toAdd_mul, neg_add]
      congr 1
      rw [chainForm_add_left, chainForm_neg_left, chainForm_neg_left, chainForm_self,
        neg_zero, add_zero, chainForm_swap, neg_neg]
    rw [hcocycle] at hmul
    exact hmul.symm
  have heq : (cubicFactor N a bM : ℂ) = (cubicFactor N bM a : ℂ) := by
    have h1 := congrArg
      (fun x ↦ (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
        (cubicFactor N)).repr x (a * bM)) (hz bM)
    rw [hcoord, hcoord2] at h1
    exact mul_right_cancel₀ ha h1
  have hunit : cubicFactor N a bM * (cubicFactor N bM a)⁻¹ = 1 := by
    apply Units.ext
    simp [heq]
  rw [cubicFactor_mul_inv_swap] at hunit
  exact cubeRootPow_eq_one_iff.mp hunit

/-- Helper: in any `ℂ`-module `V`, a scalar `λ • id` whose `12`-th power of determinant is `1`
satisfies `λ ^ (12 * finrank ℂ V) = 1`. -/
private theorem det_smul_id_pow_twelve {V : Type*} [AddCommGroup V] [Module ℂ V] {c : ℂ}
    (hdet : LinearMap.det (c • (LinearMap.id : V →ₗ[ℂ] V)) ^ 12 = 1) :
    c ^ (12 * Module.finrank ℂ V) = 1 := by
  rw [LinearMap.det_smul, LinearMap.det_id, mul_one, ← pow_mul, mul_comm] at hdet
  exact hdet

/-- Helper: the set `{c : ℂ | c ^ k = 1}` is finite for every `k ≠ 0`. -/
private theorem finite_pow_eq_one {k : ℕ} (hk : k ≠ 0) :
    Finite {c : ℂ // c ^ k = 1} := by
  have : NeZero k := ⟨hk⟩
  let toRoot : {c : ℂ // c ^ k = 1} → rootsOfUnity k ℂ := fun c ↦
    ⟨Units.mk0 c.1 (fun h0 ↦ by
      have := c.2
      rw [h0, zero_pow hk] at this
      exact zero_ne_one this),
      by
        rw [mem_rootsOfUnity]
        apply Units.ext
        simpa using c.2⟩
  refine Finite.of_injective toRoot fun a b hab ↦ Subtype.ext ?_
  have hval := congrArg (fun u : rootsOfUnity k ℂ ↦ ((u : ℂˣ) : ℂ)) hab
  simpa [toRoot] using hval

/-- Any `ℂ`-linear representation of `CubicTorus N` sends every element of the Gaussian braid
subgroup to an operator whose determinant is a `12`-th root of unity. -/
private theorem det_pow_twelve_of_mem_gaussianBraid {N : ℕ} {V : Type*} [AddCommGroup V]
    [Module ℂ V] (L : CubicTorus N →ₐ[ℂ] Module.End ℂ V)
    (x : Subgroup.closure (Set.range (gaussianBraidUnit N))) :
    (LinearMap.det (L ((x : (CubicTorus N)ˣ) : CubicTorus N))) ^ 12 = 1 := by
  let det12 : (CubicTorus N)ˣ →* ℂ :=
    { toFun := fun u ↦ (LinearMap.det (L (u : CubicTorus N))) ^ 12
      map_one' := by simp
      map_mul' := fun u v ↦ by simp only [Units.val_mul, map_mul, mul_pow] }
  have hle : Subgroup.closure (Set.range (gaussianBraidUnit N)) ≤ det12.ker := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    simp only [SetLike.mem_coe, MonoidHom.mem_ker, det12, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [← map_pow, ← map_pow, ← Units.val_pow_eq_pow_val, gaussianBraidUnit_pow_twelve,
      Units.val_one, map_one, map_one]
  exact hle x.2

/-- Every element of the Gaussian braid subgroup permutes the Weyl basis `{W(a)}` by conjugation. -/
private theorem exists_weylPerm_of_mem_gaussianBraid (N : ℕ)
    (x : Subgroup.closure (Set.range (gaussianBraidUnit N))) :
    ∃ σ : Equiv.Perm (Fin N → ZMod 3),
      ∀ a : Fin N → ZMod 3,
        ((x : (CubicTorus N)ˣ) : CubicTorus N) * weyl N (Multiplicative.ofAdd a) *
            (((x : (CubicTorus N)ˣ)⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) =
          weyl N (Multiplicative.ofAdd (σ a)) := by
  let weylPermSubgroup : Subgroup (CubicTorus N)ˣ :=
    { carrier := {u | ∃ σ : Equiv.Perm (Fin N → ZMod 3),
        ∀ a : Fin N → ZMod 3,
          (u : CubicTorus N) * weyl N (Multiplicative.ofAdd a) * ((u⁻¹ : (CubicTorus N)ˣ) :
            CubicTorus N) = weyl N (Multiplicative.ofAdd (σ a))}
      one_mem' := ⟨Equiv.refl _, fun a ↦ by simp⟩
      mul_mem' := by
        rintro u v ⟨σ, hσ⟩ ⟨τ, hτ⟩
        refine ⟨τ.trans σ, fun a ↦ ?_⟩
        simp only [Units.val_mul, mul_inv_rev, Equiv.trans_apply]
        calc
          (u : CubicTorus N) * (v : CubicTorus N) * weyl N (Multiplicative.ofAdd a) *
              (((v⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) *
                ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N))
            = (u : CubicTorus N) * ((v : CubicTorus N) * weyl N (Multiplicative.ofAdd a) *
                ((v⁻¹ : (CubicTorus N)ˣ) : CubicTorus N)) *
                ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) := by
                simp only [mul_assoc]
          _ = (u : CubicTorus N) * weyl N (Multiplicative.ofAdd (τ a)) *
                ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) := by rw [hτ]
          _ = weyl N (Multiplicative.ofAdd (σ (τ a))) := hσ (τ a)
      inv_mem' := by
        rintro u ⟨σ, hσ⟩
        refine ⟨σ.symm, fun a ↦ ?_⟩
        have h := hσ (σ.symm a)
        rw [Equiv.apply_symm_apply] at h
        calc
          ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) * weyl N (Multiplicative.ofAdd a) *
              ((u⁻¹⁻¹ : (CubicTorus N)ˣ) : CubicTorus N)
            = ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) *
                ((u : CubicTorus N) * weyl N (Multiplicative.ofAdd (σ.symm a)) *
                  ((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N)) * (u : CubicTorus N) := by
                rw [inv_inv, h]
          _ = (((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) * (u : CubicTorus N)) *
                weyl N (Multiplicative.ofAdd (σ.symm a)) *
                (((u⁻¹ : (CubicTorus N)ˣ) : CubicTorus N) * (u : CubicTorus N)) := by
                simp only [mul_assoc]
          _ = weyl N (Multiplicative.ofAdd (σ.symm a)) := by
                rw [← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul, mul_one] }
  have hle : Subgroup.closure (Set.range (gaussianBraidUnit N)) ≤ weylPermSubgroup := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    let σ : Equiv.Perm (Fin N → ZMod 3) :=
      { toFun := fun a ↦ a + chainForm N a (Pi.single j 1) • Pi.single j 1
        invFun := fun a ↦ a - chainForm N a (Pi.single j 1) • Pi.single j 1
        left_inv := fun a ↦ by
          dsimp only
          rw [chainForm_add_left, chainForm_smul_left, chainForm_self, mul_zero, add_zero,
            add_sub_cancel_right]
        right_inv := fun a ↦ by
          dsimp only
          rw [sub_eq_add_neg, chainForm_add_left, chainForm_neg_left, chainForm_smul_left,
            chainForm_self, mul_zero, neg_zero, add_zero, ← sub_eq_add_neg, sub_add_cancel] }
    exact ⟨σ, fun a ↦ gaussianBraidUnit_conj_weyl N j a⟩
  exact hle x.2

/-- The conjugation action homomorphism from the Gaussian braid subgroup to
`Equiv.Perm (Fin N → ZMod 3)`. -/
private noncomputable def weylPermHom (N : ℕ) :
    Subgroup.closure (Set.range (gaussianBraidUnit N)) →* Equiv.Perm (Fin N → ZMod 3) where
  toFun x := (exists_weylPerm_of_mem_gaussianBraid N x).choose
  map_one' := by
    have hweyl_inj : Function.Injective (fun a : Fin N → ZMod 3 ↦
        weyl N (Multiplicative.ofAdd a)) := fun a b hab ↦ by
      dsimp only at hab
      rw [weyl_def, weyl_def, ← TwistedMonoidAlgebra.basis_apply,
        ← TwistedMonoidAlgebra.basis_apply] at hab
      exact Multiplicative.ofAdd.injective
        ((TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
          (cubicFactor N)).injective hab)
    exact Equiv.ext fun a ↦ hweyl_inj (by
      simpa using ((exists_weylPerm_of_mem_gaussianBraid N 1).choose_spec a).symm)
  map_mul' x y := by
    have hweyl_inj : Function.Injective (fun a : Fin N → ZMod 3 ↦
        weyl N (Multiplicative.ofAdd a)) := fun a b hab ↦ by
      dsimp only at hab
      rw [weyl_def, weyl_def, ← TwistedMonoidAlgebra.basis_apply,
        ← TwistedMonoidAlgebra.basis_apply] at hab
      exact Multiplicative.ofAdd.injective
        ((TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
          (cubicFactor N)).injective hab)
    refine Equiv.ext fun a ↦ hweyl_inj ?_
    dsimp only
    rw [Equiv.Perm.mul_apply,
      ← (exists_weylPerm_of_mem_gaussianBraid N x).choose_spec _,
      ← (exists_weylPerm_of_mem_gaussianBraid N y).choose_spec a,
      ← (exists_weylPerm_of_mem_gaussianBraid N (x * y)).choose_spec a]
    simp only [Subgroup.coe_mul, Units.val_mul, mul_inv_rev, mul_assoc]

private theorem weylPermHom_ker_comm {N : ℕ} (z : (weylPermHom N).ker)
    (b : Multiplicative (Fin N → ZMod 3)) :
    ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) * weyl N b =
      weyl N b * ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) := by
  have hfix : (exists_weylPerm_of_mem_gaussianBraid N z.1).choose b.toAdd = b.toAdd := by
    have hz : weylPermHom N z.1 = 1 := z.2
    simpa [weylPermHom] using congrArg (fun σ : Equiv.Perm (Fin N → ZMod 3) ↦ σ b.toAdd) hz
  have hconj := (exists_weylPerm_of_mem_gaussianBraid N z.1).choose_spec b.toAdd
  rw [hfix, ofAdd_toAdd] at hconj
  have hmul := congrArg (· * ((z.1 : (CubicTorus N)ˣ) : CubicTorus N)) hconj
  simpa [mul_assoc, ← Units.val_mul] using hmul

private theorem finite_ker_weylPermHom_of_even {N : ℕ} (hN : Even N) :
    Finite (weylPermHom N).ker := by
  let b := TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)
  have hscalar (z : (weylPermHom N).ker) :
      ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) =
        TwistedMonoidAlgebra.scalarTrace (cubicFactor N)
          ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) • (1 : CubicTorus N) := by
    have hsupp : ∀ g : Multiplicative (Fin N → ZMod 3), g ≠ 1 →
        b.repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) g = 0 := by
      intro g hg
      by_contra hne
      have hrad := mem_radical_of_commute_weyl (weylPermHom_ker_comm z) hne
      have hg0 : g.toAdd = 0 := chainForm_radical_eq_zero_of_even hN hrad
      exact hg (Multiplicative.toAdd.injective (by simpa using hg0))
    conv_lhs => rw [← b.sum_repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N)]
    rw [Finset.sum_eq_single (1 : Multiplicative (Fin N → ZMod 3))]
    · simp [b, TwistedMonoidAlgebra.scalarTrace_apply]
    · intro g _ hg
      rw [hsupp g hg, zero_smul]
    · intro h; exact absurd (Finset.mem_univ _) h
  have hpos : 12 * Module.finrank ℂ (CubicTorus N) ≠ 0 := by
    rw [finrank_cubicTorus]
    positivity
  have : Finite {c : ℂ // c ^ (12 * Module.finrank ℂ (CubicTorus N)) = 1} :=
    finite_pow_eq_one hpos
  let toScalar : (weylPermHom N).ker →
      {c : ℂ // c ^ (12 * Module.finrank ℂ (CubicTorus N)) = 1} :=
    fun z ↦
      ⟨TwistedMonoidAlgebra.scalarTrace (cubicFactor N)
          ((z.1 : (CubicTorus N)ˣ) : CubicTorus N), by
        have hdet := det_pow_twelve_of_mem_gaussianBraid (Algebra.lmul ℂ (CubicTorus N)) z.1
        rw [hscalar z, map_smul, map_one] at hdet
        exact det_smul_id_pow_twelve (by simpa [Module.End.one_eq_id] using hdet)⟩
  refine Finite.of_injective toScalar fun z₁ z₂ h ↦ Subtype.ext <| Subtype.ext <| Units.ext ?_
  have hc : TwistedMonoidAlgebra.scalarTrace (cubicFactor N)
      ((z₁.1 : (CubicTorus N)ˣ) : CubicTorus N) =
    TwistedMonoidAlgebra.scalarTrace (cubicFactor N)
      ((z₂.1 : (CubicTorus N)ˣ) : CubicTorus N) := congrArg Subtype.val h
  rw [hscalar z₁, hscalar z₂, hc]

/-- The three central spectral idempotents of the radical generator `W(oddRadicalVec N)` when `N`
is odd. -/
private noncomputable def oddCentralIdempotent (N : ℕ) (c : ZMod 3) : CubicTorus N :=
  let R : CubicTorus N := weyl N (Multiplicative.ofAdd (oddRadicalVec N))
  (3 : ℂ)⁻¹ • (1 + (cubeRootPow (-c) : ℂ) • R + (cubeRootPow (-(2 * c)) : ℂ) • R ^ 2)

private theorem weyl_oddRadicalVec_comm {N : ℕ} (hN : Odd N) (x : CubicTorus N) :
    weyl N (Multiplicative.ofAdd (oddRadicalVec N)) * x =
      x * weyl N (Multiplicative.ofAdd (oddRadicalVec N)) := by
  let b := TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)
  have hlin : LinearMap.mulLeft ℂ (weyl N (Multiplicative.ofAdd (oddRadicalVec N))) =
      LinearMap.mulRight ℂ (weyl N (Multiplicative.ofAdd (oddRadicalVec N))) := by
    refine b.ext fun g ↦ ?_
    simp only [LinearMap.mulLeft_apply, LinearMap.mulRight_apply, b,
      TwistedMonoidAlgebra.basis_apply, ← weyl_def]
    rw [weyl_mul_comm_factor, toAdd_ofAdd, chainForm_oddRadicalVec hN, cubeRootPow_zero,
      Units.val_one, one_smul]
  exact LinearMap.congr_fun hlin x

private theorem oddCentralIdempotent_comm {N : ℕ} (hN : Odd N) (c : ZMod 3) (x : CubicTorus N) :
    oddCentralIdempotent N c * x = x * oddCentralIdempotent N c := by
  have hR := weyl_oddRadicalVec_comm hN x
  have hR2 : weyl N (Multiplicative.ofAdd (oddRadicalVec N)) ^ 2 * x =
      x * weyl N (Multiplicative.ofAdd (oddRadicalVec N)) ^ 2 := by
    rw [sq, mul_assoc, hR, ← mul_assoc, hR, mul_assoc, ← sq]
  simp only [oddCentralIdempotent, smul_mul_assoc, mul_smul_comm, add_mul, mul_add, one_mul,
    mul_one, hR, hR2]

private theorem weyl_oddRadicalVec_mul_oddCentralIdempotent (N : ℕ) (c : ZMod 3) :
    weyl N (Multiplicative.ofAdd (oddRadicalVec N)) * oddCentralIdempotent N c =
      (cubeRootPow c : ℂ) • oddCentralIdempotent N c := by
  set R : CubicTorus N := weyl N (Multiplicative.ofAdd (oddRadicalVec N))
  have hR3 : R ^ 3 = 1 := weyl_pow_three N _
  have hR12 : R * R ^ 2 = 1 := by rw [← pow_succ', hR3]
  have h1 : (cubeRootPow c : ℂ) * (cubeRootPow (-c) : ℂ) = 1 := by
    rw [← Units.val_mul, ← cubeRootPow_add, add_neg_cancel, cubeRootPow_zero, Units.val_one]
  have h2 : (cubeRootPow c : ℂ) * (cubeRootPow (-(2 * c)) : ℂ) = (cubeRootPow (-c) : ℂ) := by
    rw [← Units.val_mul, ← cubeRootPow_add]
    congr 2; ring
  have h3 : (cubeRootPow (-2 * c) : ℂ) = (cubeRootPow c : ℂ) := by
    congr 2
    rcases zmod3_cases c with rfl | rfl | rfl <;> decide
  dsimp only [oddCentralIdempotent]
  rw [mul_smul_comm, smul_comm (cubeRootPow c : ℂ) (3 : ℂ)⁻¹]
  congr 1
  rw [mul_add, mul_add, mul_one, mul_smul_comm, mul_smul_comm, ← sq, hR12,
    smul_add, smul_add, smul_smul, smul_smul, h1, h2, one_smul]
  have hneg : -(2 * c) = -2 * c := by ring
  rw [hneg, h3]
  abel

private theorem sum_oddCentralIdempotent (N : ℕ) :
    ∑ c : ZMod 3, oddCentralIdempotent N c = 1 := by
  have hsum_zmod (f : ZMod 3 → ℂ) : ∑ c : ZMod 3, f c = f 0 + f 1 + f 2 := by
    have huniv : (Finset.univ : Finset (ZMod 3)) = {0, 1, 2} := by decide
    rw [huniv, Finset.sum_insert (by decide), Finset.sum_insert (by decide),
      Finset.sum_singleton, add_assoc]
  have hsum1 : ∑ c : ZMod 3, (cubeRootPow (-c) : ℂ) = 0 := by
    rw [hsum_zmod]
    have h0 : (-0 : ZMod 3) = 0 := by decide
    have h1 : (-1 : ZMod 3) = 2 := by decide
    have h2 : (-2 : ZMod 3) = 1 := by decide
    simp only [h0, h1, h2, cubeRootPow_zero, cubeRootPow_one, cubeRootPow_two, Units.val_one,
      Units.val_pow_eq_pow_val]
    linear_combination one_add_cubeRootOfUnity_add_sq
  have hsum2 : ∑ c : ZMod 3, (cubeRootPow (-(2 * c)) : ℂ) = 0 := by
    rw [hsum_zmod]
    have h0 : (-(2 * 0) : ZMod 3) = 0 := by decide
    have h1 : (-(2 * 1) : ZMod 3) = 1 := by decide
    have h2 : (-(2 * 2) : ZMod 3) = 2 := by decide
    simp only [h0, h1, h2, cubeRootPow_zero, cubeRootPow_one, cubeRootPow_two, Units.val_one,
      Units.val_pow_eq_pow_val]
    linear_combination one_add_cubeRootOfUnity_add_sq
  simp only [oddCentralIdempotent, ← Finset.smul_sum, Finset.sum_add_distrib, Finset.sum_const,
    Finset.card_univ, ZMod.card, ← Finset.sum_smul, hsum1, hsum2, zero_smul, add_zero]
  rw [← Nat.cast_smul_eq_nsmul ℂ, smul_smul]
  norm_num

private theorem oddCentralIdempotent_ne_zero {N : ℕ} (hN : Odd N) (c : ZMod 3) :
    oddCentralIdempotent N c ≠ 0 := by
  intro h0
  have hρ_ne : oddRadicalVec N ≠ 0 := by
    intro h
    obtain ⟨k, hk⟩ := hN
    have hval := congrFun h ⟨0, by omega⟩
    simp [oddRadicalVec] at hval
  have hR_ne1 : Multiplicative.ofAdd (oddRadicalVec N) ≠ 1 :=
    fun h ↦ hρ_ne (by simpa using congrArg Multiplicative.toAdd h)
  have hRinv_ne1 : (Multiplicative.ofAdd (oddRadicalVec N))⁻¹ ≠ 1 := inv_ne_one.mpr hR_ne1
  have htr := congrArg (TwistedMonoidAlgebra.scalarTrace (cubicFactor N)) h0
  dsimp only [oddCentralIdempotent] at htr
  rw [weyl_sq, weyl_def, weyl_def] at htr
  simp only [map_smul, map_add, TwistedMonoidAlgebra.scalarTrace_one,
    TwistedMonoidAlgebra.scalarTrace_of_ne_one _ hR_ne1,
    TwistedMonoidAlgebra.scalarTrace_of_ne_one _ hRinv_ne1,
    map_zero, smul_eq_mul, mul_zero, add_zero, mul_one, inv_eq_zero,
    OfNat.ofNat_ne_zero] at htr

private theorem finite_ker_weylPermHom_of_odd {N : ℕ} (hN : Odd N) :
    Finite (weylPermHom N).ker := by
  let b := TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)
  set ρ : Fin N → ZMod 3 := oddRadicalVec N
  set R : CubicTorus N := weyl N (Multiplicative.ofAdd ρ)
  have hρ_ne : ρ ≠ 0 := by
    intro h0
    obtain ⟨k, hk⟩ := hN
    have hval := congrFun h0 ⟨0, by omega⟩
    simp [ρ, oddRadicalVec] at hval
  have hR2_mul_P (c : ZMod 3) :
      R ^ 2 * oddCentralIdempotent N c = ((cubeRootPow c : ℂ) ^ 2) • oddCentralIdempotent N c := by
    rw [sq, mul_assoc, weyl_oddRadicalVec_mul_oddCentralIdempotent, mul_smul_comm,
      weyl_oddRadicalVec_mul_oddCentralIdempotent, smul_smul, ← sq]
  let V (c : ZMod 3) : Submodule ℂ (CubicTorus N) :=
    LinearMap.range (LinearMap.mulLeft ℂ (oddCentralIdempotent N c))
  have hV_pos (c : ZMod 3) : 0 < Module.finrank ℂ (V c) := by
    have hne : Nontrivial (V c) :=
      ⟨⟨⟨oddCentralIdempotent N c, 1, by simp⟩, 0,
        fun h ↦ oddCentralIdempotent_ne_zero hN c (congrArg Subtype.val h)⟩⟩
    exact Module.finrank_pos
  let L (c : ZMod 3) : CubicTorus N →ₐ[ℂ] Module.End ℂ (V c) :=
    { toFun := fun x ↦
        { toFun := fun v ↦ ⟨x * v.1, by
            obtain ⟨y, hy⟩ := v.2
            refine ⟨x * y, ?_⟩
            simp only [LinearMap.mulLeft_apply] at hy ⊢
            rw [← hy, ← mul_assoc, oddCentralIdempotent_comm hN, mul_assoc]⟩
          map_add' := fun v w ↦ Subtype.ext (mul_add x v.1 w.1)
          map_smul' := fun r v ↦ Subtype.ext (mul_smul_comm r x v.1) }
      map_one' := LinearMap.ext fun v ↦ Subtype.ext (one_mul v.1)
      map_mul' := fun x y ↦ LinearMap.ext fun v ↦ Subtype.ext (mul_assoc x y v.1)
      map_zero' := LinearMap.ext fun v ↦ Subtype.ext (zero_mul v.1)
      map_add' := fun x y ↦ LinearMap.ext fun v ↦ Subtype.ext (add_mul x y v.1)
      commutes' := fun r ↦ LinearMap.ext fun v ↦ Subtype.ext (Algebra.smul_def r v.1).symm }
  have hcentral_decomp (z : (weylPermHom N).ker) :
      ∃ c₀ c₁ c₂ : ℂ,
        ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) = c₀ • 1 + c₁ • R + c₂ • R ^ 2 := by
    refine ⟨b.repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) 1,
      b.repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) (Multiplicative.ofAdd ρ),
      b.repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) (Multiplicative.ofAdd ρ)⁻¹, ?_⟩
    have hsupp : ∀ g : Multiplicative (Fin N → ZMod 3),
        g ≠ 1 → g ≠ Multiplicative.ofAdd ρ → g ≠ (Multiplicative.ofAdd ρ)⁻¹ →
        b.repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) g = 0 := by
      intro g hg0 hg1 hg2
      by_contra hne
      have hrad := mem_radical_of_commute_weyl (weylPermHom_ker_comm z) hne
      have hmul := chainForm_radical_of_odd hN hrad
      rcases zmod3_cases (g.toAdd ⟨0, by obtain ⟨k, hk⟩ := hN; omega⟩) with ht | ht | ht
      · apply hg0
        rw [ht, zero_smul] at hmul
        exact Multiplicative.toAdd.injective (by simpa using hmul)
      · apply hg1
        rw [ht, one_smul] at hmul
        exact Multiplicative.toAdd.injective (by simpa [ρ] using hmul)
      · apply hg2
        have h2 : (2 : ZMod 3) = -1 := by decide
        rw [ht, h2, neg_one_smul] at hmul
        exact Multiplicative.toAdd.injective (by simpa [ρ] using hmul)
    have hdisj :
        ({(1 : Multiplicative (Fin N → ZMod 3)), Multiplicative.ofAdd ρ,
            (Multiplicative.ofAdd ρ)⁻¹} : Finset _) ⊆ Finset.univ := Finset.subset_univ _
    conv_lhs => rw [← b.sum_repr ((z.1 : (CubicTorus N)ˣ) : CubicTorus N)]
    rw [← Finset.sum_subset hdisj]
    · have h01 : (1 : Multiplicative (Fin N → ZMod 3)) ≠ Multiplicative.ofAdd ρ := by
        intro h; exact hρ_ne (by simpa using (congrArg Multiplicative.toAdd h).symm)
      have h02 : (1 : Multiplicative (Fin N → ZMod 3)) ≠ (Multiplicative.ofAdd ρ)⁻¹ := by
        intro h; exact h01 (by simpa using congrArg Inv.inv h)
      have h12 : Multiplicative.ofAdd ρ ≠ (Multiplicative.ofAdd ρ)⁻¹ := by
        intro h
        obtain ⟨k, hk⟩ := hN
        have h0 : (1 : ZMod 3) = -1 := by
          simpa [ρ, oddRadicalVec] using congrFun (congrArg Multiplicative.toAdd h) ⟨0, by omega⟩
        exact absurd h0 (by decide)
      rw [Finset.sum_insert (by simp [h01, h02]), Finset.sum_insert (by simp [h12]),
        Finset.sum_singleton]
      simp [b, R, ← weyl_def, weyl_sq, add_assoc]
    · intro g _ hg
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hg
      rw [hsupp g hg.1 hg.2.1 hg.2.2, zero_smul]
  have heig (z : (weylPermHom N).ker) (c : ZMod 3) :
      ∃ lam : ℂ,
        ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) * oddCentralIdempotent N c =
          lam • oddCentralIdempotent N c := by
    obtain ⟨c₀, c₁, c₂, hz⟩ := hcentral_decomp z
    refine ⟨c₀ + c₁ * (cubeRootPow c : ℂ) + c₂ * (cubeRootPow c : ℂ) ^ 2, ?_⟩
    rw [hz, add_mul, add_mul, smul_mul_assoc, smul_mul_assoc, smul_mul_assoc, one_mul,
      weyl_oddRadicalVec_mul_oddCentralIdempotent, hR2_mul_P, smul_smul, smul_smul,
      add_smul, add_smul]
  choose eigVal heigVal using heig
  have hL_eig (z : (weylPermHom N).ker) (c : ZMod 3) :
      L c ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) = eigVal z c • LinearMap.id := by
    refine LinearMap.ext fun v ↦ Subtype.ext ?_
    obtain ⟨y, hy⟩ := v.2
    simp only [L, AlgHom.coe_mk, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk,
      LinearMap.coe_mk, AddHom.coe_mk, LinearMap.smul_apply, LinearMap.id_apply,
      SetLike.val_smul]
    simp only [LinearMap.mulLeft_apply] at hy
    rw [← hy, ← mul_assoc, heigVal z c, smul_mul_assoc]
  have (c : ZMod 3) : Finite {w : ℂ // w ^ (12 * Module.finrank ℂ (V c)) = 1} :=
    finite_pow_eq_one (mul_ne_zero (by decide) (hV_pos c).ne')
  let toEig : (weylPermHom N).ker →
      ∀ c : ZMod 3, {w : ℂ // w ^ (12 * Module.finrank ℂ (V c)) = 1} :=
    fun z c ↦ ⟨eigVal z c, by
      have hdet := det_pow_twelve_of_mem_gaussianBraid (L c) z.1
      rw [hL_eig z c] at hdet
      exact det_smul_id_pow_twelve hdet⟩
  refine Finite.of_injective toEig fun z₁ z₂ h ↦ Subtype.ext <| Subtype.ext <| Units.ext ?_
  have hz_eq (z : (weylPermHom N).ker) :
      ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) =
        ∑ c : ZMod 3, eigVal z c • oddCentralIdempotent N c := by
    calc
      ((z.1 : (CubicTorus N)ˣ) : CubicTorus N)
        = ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) * ∑ c : ZMod 3, oddCentralIdempotent N c := by
            rw [sum_oddCentralIdempotent, mul_one]
      _ = ∑ c : ZMod 3, ((z.1 : (CubicTorus N)ˣ) : CubicTorus N) * oddCentralIdempotent N c :=
            Finset.mul_sum ..
      _ = ∑ c : ZMod 3, eigVal z c • oddCentralIdempotent N c :=
            Finset.sum_congr rfl fun c _ ↦ heigVal z c
  rw [hz_eq z₁, hz_eq z₂]
  refine Finset.sum_congr rfl fun c _ ↦ ?_
  have hc : eigVal z₁ c = eigVal z₂ c := congrArg Subtype.val (congrFun h c)
  rw [hc]

/-- **Finiteness of the subgroup generated by the Gaussian braid units** in `(CubicTorus N)ˣ`. -/
theorem finite_subgroup_closure_gaussianBraidUnit (N : ℕ) :
    Finite (Subgroup.closure (Set.range (gaussianBraidUnit N))) :=
  (weylPermHom N).finite_iff_finite_ker_range.mpr
    ⟨(Nat.even_or_odd N).elim finite_ker_weylPermHom_of_even finite_ker_weylPermHom_of_odd,
      inferInstance⟩

/-- **The Gaussian braid image is finite.** For every `N : ℕ`, the Gaussian braid generators
`g_j = gaussianBraidGenerator N j` are units of `CubicTorus N` and generate a finite subgroup of
`(CubicTorus N)ˣ`. -/
theorem finite_gaussianBraid_closure (N : ℕ) :
    ∃ g : Fin N → (CubicTorus N)ˣ,
      (∀ j, (g j : CubicTorus N) = gaussianBraidGenerator N j) ∧
        Finite (Subgroup.closure (Set.range g)) :=
  ⟨gaussianBraidUnit N, gaussianBraidUnit_val N, finite_subgroup_closure_gaussianBraidUnit N⟩

end TauCeti.TemperleyLieb
