/-!
# The cubic quantum torus and its inversion-fixed Temperley–Lieb model at `δ = √3`

At loop value `δ = √3 = 2 cos (π / 6)` (corresponding to Jones's parameter `t = exp (π i / 3)` and
`ω = t² = exp (2 π i / 3)`), Jones related the positive Temperley–Lieb quotients to a "cubic
Clifford algebra", realized concretely as the inversion-fixed subalgebra of a twisted group algebra
of `(ℤ / 3ℤ)^N` — the *cubic quantum torus*.

For `N : ℕ`, let `V_N = Fin N → ZMod 3` carry the alternating nearest-neighbor bilinear form
`chainForm N a b = ∑_{i + 1 = j} (a_i b_j - b_i a_j)` and the normalized factor set
`cubicFactor N a b = ω ^ (2 * chainForm N a b)` (meaning `ω ^ (chainForm N a b / 2)` since
`2⁻¹ = 2` in `ZMod 3`). Its complex twisted group algebra `CubicTorus N` has dimension `3 ^ N` and
Weyl basis `weyl N a` satisfying `weyl N a * weyl N b = cubicFactor N a b • weyl N (a * b)`. The
site elements `cubicSite N j = weyl N (ofAdd (Pi.single j 1))` satisfy `U_j ^ 3 = 1`,
`U_i * U_{i+1} = ω • (U_{i+1} * U_i)`, and commute at distance at least two; `CubicTorus N` is the
universal `ℂ`-algebra generated by `N` elements subject to these relations (`liftSite`).

Group inversion induces an involutive `ℂ`-algebra automorphism `cubicInversion N` sending
`weyl N a` to `weyl N a⁻¹`; its fixed-point subalgebra `cubicFixed N` has dimension
`(3 ^ N + 1) / 2`, spanned by the symmetrized Weyl elements `weyl N a + weyl N a⁻¹`. The spectral
projections `cubicProjection N j = 3⁻¹ • (1 + U_j + U_j²)` lie in `cubicFixed N`, are fixed by the
conjugate-linear product-reversing involution `cubicAdjoint N`, satisfy
`p_j * p_{j±1} * p_j = 3⁻¹ • p_j`, and commute at distance at least two. Rescaling by `√3` gives
the surjective star-compatible comparison homomorphism
`cubicFixedHom m : TemperleyLieb ℂ (√3 : ℂ) m →ₐ[ℂ] cubicFixed (m - 1)`.

## Main definitions

* `TauCeti.TemperleyLieb.chainForm`: the alternating chain form on `Fin N → ZMod 3`.
* `TauCeti.TemperleyLieb.cubeRootOfUnity` and `TauCeti.TemperleyLieb.cubeRootPow`:
  `ω = exp (2 π i / 3) : ℂˣ` and `x ↦ ω ^ x.val` on `ZMod 3`.
* `TauCeti.TemperleyLieb.cubicFactor`, `TauCeti.TemperleyLieb.CubicTorus`, and
  `TauCeti.TemperleyLieb.weyl`: the factor set, twisted group algebra `G_N`, and Weyl basis.
* `TauCeti.TemperleyLieb.cubicSite` and `TauCeti.TemperleyLieb.liftSite`: the site unitaries `U_j`
  and the universal property of `CubicTorus N` on site presentations.
* `TauCeti.TemperleyLieb.cubicScalarCoefficient` and `TauCeti.TemperleyLieb.cubicAdjoint`: the
  faithful normalized trace `s_N` and conjugate-linear reversal `†` on `CubicTorus N`.
* `TauCeti.TemperleyLieb.cubicInversion`, `TauCeti.TemperleyLieb.cubicFixed`, and
  `TauCeti.TemperleyLieb.cubicFixedAdjoint`: the inversion automorphism `θ_N`, its fixed-point
  subalgebra `C_N`, and the restricted adjoint on `C_N`.
* `TauCeti.TemperleyLieb.cubicProjection` and `TauCeti.TemperleyLieb.cubicFixedHom`: the spectral
  projections `p_j` and the comparison homomorphism `TL_m(√3) →ₐ[ℂ] C_{m - 1}`.

## Main results

* `TauCeti.TemperleyLieb.finrank_cubicTorus` and `TauCeti.TemperleyLieb.finrank_cubicFixed`:
  `dim_ℂ G_N = 3 ^ N` and `dim_ℂ C_N = (3 ^ N + 1) / 2`.
* `TauCeti.TemperleyLieb.liftSite_cubicSite`, `TauCeti.TemperleyLieb.adjoin_range_cubicSite`, and
  `TauCeti.TemperleyLieb.algHom_ext_cubicSite`: universal presentation of `CubicTorus N`.
* `TauCeti.TemperleyLieb.adjoin_range_cubicProjection` and
  `TauCeti.TemperleyLieb.cubicFixedHom_surjective`: the projections `p_j` generate `cubicFixed N`,
  so `cubicFixedHom m` is surjective for every `m : ℕ`.
* `TauCeti.TemperleyLieb.cubicFixedHom_star`: `cubicFixedHom m` intertwines the Temperley–Lieb
  analytic adjoint `star` with `cubicFixedAdjoint (m - 1)`.

## References

* V. F. R. Jones, *A polynomial invariant for knots via von Neumann algebras*, Bull. Amer. Math.
  Soc. 12 (1985), 103–111, p. 107.
* V. F. R. Jones, *Index for subfactors*, Invent. Math. 72 (1983), 1–25.
* F. M. Goodman, P. de la Harpe, and V. F. R. Jones, *Coxeter Graphs and Towers of Algebras*,
  MSRI Publications 14, Springer (1989).
* G. Karpilovsky, *Projective Representations of Finite Groups*, Marcel Dekker (1985), Ch. 3.
-/

public section

namespace TauCeti.TemperleyLieb

open Multiplicative

/-- Registers `IsSelfAdjoint (Real.sqrt 3 : ℂ)` as a `Fact` so that
`TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m` carries its analytic `StarRing` structure automatically. -/
instance : Fact (IsSelfAdjoint (Real.sqrt 3 : ℂ)) :=
  ⟨Complex.conj_ofReal _⟩

private theorem zmod3_cases (x : ZMod 3) : x = 0 ∨ x = 1 ∨ x = 2 := by
  have hval := ZMod.natCast_zmod_val x
  have hlt : x.val < 3 := x.val_lt
  match h : x.val with
  | 0 => exact Or.inl (by rw [← hval, h]; rfl)
  | 1 => exact Or.inr (Or.inl (by rw [← hval, h]; rfl))
  | 2 => exact Or.inr (Or.inr (by rw [← hval, h]; rfl))
  | n + 3 => omega

/-! ### The alternating chain form on `Fin N → ZMod 3` -/

/-- Upper-triangular half `∑_{i + 1 = j} a_i b_j` of `chainForm`, used internally to organize
biadditivity and normal-ordered monomial products. -/
private def halfChainForm (N : ℕ) (a b : Fin N → ZMod 3) : ZMod 3 :=
  ∑ i : Fin N, ∑ j : Fin N, if (i : ℕ) + 1 = j then a i * b j else 0

/-- **The chain form** `B(a, b) = ∑_{i + 1 = j} (a_i b_j - b_i a_j)` on `Fin N → ZMod 3`. -/
def chainForm (N : ℕ) (a b : Fin N → ZMod 3) : ZMod 3 :=
  ∑ i : Fin N, ∑ j : Fin N, if (i : ℕ) + 1 = j then a i * b j - b i * a j else 0

/-- Unfolds `chainForm N a b`. -/
theorem chainForm_def (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N a b =
      ∑ i : Fin N, ∑ j : Fin N, if (i : ℕ) + 1 = j then a i * b j - b i * a j else 0 :=
  (rfl)

/-- Extending two vectors by `0` in the last coordinate preserves `chainForm`. -/
@[simp]
theorem chainForm_snoc_zero (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm (N + 1) (Fin.snoc a 0) (Fin.snoc b 0) = chainForm N a b := by
  unfold chainForm
  rw [Fin.sum_univ_castSucc]
  simp only [Fin.snoc_last, zero_mul, sub_self, ite_self, Finset.sum_const_zero, add_zero]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Fin.sum_univ_castSucc]
  simp

private theorem chainForm_eq_sub (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N a b = halfChainForm N a b - halfChainForm N b a := by
  unfold chainForm halfChainForm
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  split_ifs <;> ring

private theorem halfChainForm_add_left (N : ℕ) (a₁ a₂ b : Fin N → ZMod 3) :
    halfChainForm N (a₁ + a₂) b = halfChainForm N a₁ b + halfChainForm N a₂ b := by
  unfold halfChainForm
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  simp only [Pi.add_apply]
  split_ifs <;> ring

private theorem halfChainForm_add_right (N : ℕ) (a b₁ b₂ : Fin N → ZMod 3) :
    halfChainForm N a (b₁ + b₂) = halfChainForm N a b₁ + halfChainForm N a b₂ := by
  unfold halfChainForm
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  simp only [Pi.add_apply]
  split_ifs <;> ring

private theorem halfChainForm_zero_left (N : ℕ) (b : Fin N → ZMod 3) :
    halfChainForm N 0 b = 0 := by
  simp [halfChainForm]

private theorem halfChainForm_zero_right (N : ℕ) (a : Fin N → ZMod 3) :
    halfChainForm N a 0 = 0 := by
  simp [halfChainForm]

private theorem halfChainForm_single_right (N : ℕ) (a : Fin N → ZMod 3) (j : Fin N) (d : ZMod 3) :
    halfChainForm N a (Pi.single j d) =
      ∑ i : Fin N, if (i : ℕ) + 1 = j then a i * d else 0 := by
  unfold halfChainForm
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [Fintype.sum_eq_single j]
  · simp
  · intro y hy
    simp [Pi.single_eq_of_ne hy]

private theorem halfChainForm_single_left (N : ℕ) (i : Fin N) (c : ZMod 3) (b : Fin N → ZMod 3) :
    halfChainForm N (Pi.single i c) b =
      ∑ j : Fin N, if (i : ℕ) + 1 = j then c * b j else 0 := by
  unfold halfChainForm
  rw [Fintype.sum_eq_single i]
  · simp
  · intro x hx
    simp [Pi.single_eq_of_ne hx]

private theorem halfChainForm_single_single (N : ℕ) (i j : Fin N) (c d : ZMod 3) :
    halfChainForm N (Pi.single i c) (Pi.single j d) =
      if (i : ℕ) + 1 = j then c * d else 0 := by
  rw [halfChainForm_single_left, Fintype.sum_eq_single j]
  · simp
  · intro y hy
    simp [Pi.single_eq_of_ne hy]

/-- `chainForm` is additive in its first argument. -/
theorem chainForm_add_left (N : ℕ) (a₁ a₂ b : Fin N → ZMod 3) :
    chainForm N (a₁ + a₂) b = chainForm N a₁ b + chainForm N a₂ b := by
  simp only [chainForm_eq_sub, halfChainForm_add_left, halfChainForm_add_right]
  ring

/-- `chainForm` is additive in its second argument. -/
theorem chainForm_add_right (N : ℕ) (a b₁ b₂ : Fin N → ZMod 3) :
    chainForm N a (b₁ + b₂) = chainForm N a b₁ + chainForm N a b₂ := by
  simp only [chainForm_eq_sub, halfChainForm_add_left, halfChainForm_add_right]
  ring

/-- `chainForm` vanishes when its first argument is `0`. -/
@[simp]
theorem chainForm_zero_left (N : ℕ) (b : Fin N → ZMod 3) : chainForm N 0 b = 0 := by
  simp [chainForm_eq_sub, halfChainForm_zero_left, halfChainForm_zero_right]

/-- `chainForm` vanishes when its second argument is `0`. -/
@[simp]
theorem chainForm_zero_right (N : ℕ) (a : Fin N → ZMod 3) : chainForm N a 0 = 0 := by
  simp [chainForm_eq_sub, halfChainForm_zero_left, halfChainForm_zero_right]

/-- `chainForm` is alternating: `B(a, a) = 0`. -/
@[simp]
theorem chainForm_self (N : ℕ) (a : Fin N → ZMod 3) : chainForm N a a = 0 := by
  simp [chainForm_eq_sub]

/-- `chainForm` is skew-symmetric: `B(b, a) = -B(a, b)`. -/
theorem chainForm_swap (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N b a = -chainForm N a b := by
  simp only [chainForm_eq_sub]
  ring

/-- `chainForm` negates in its first argument. -/
@[simp]
theorem chainForm_neg_left (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N (-a) b = -chainForm N a b := by
  apply eq_neg_of_add_eq_zero_left
  rw [← chainForm_add_left, neg_add_cancel, chainForm_zero_left]

/-- `chainForm` negates in its second argument. -/
@[simp]
theorem chainForm_neg_right (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N a (-b) = -chainForm N a b := by
  apply eq_neg_of_add_eq_zero_left
  rw [← chainForm_add_right, neg_add_cancel, chainForm_zero_right]

/-- `chainForm` is invariant under simultaneous negation of both arguments. -/
theorem chainForm_neg_neg (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N (-a) (-b) = chainForm N a b := by
  rw [chainForm_neg_left, chainForm_neg_right, neg_neg]

/-- Evaluation of `chainForm` on coordinate vectors `Pi.single i c` and `Pi.single j d`. -/
theorem chainForm_single_single (N : ℕ) (i j : Fin N) (c d : ZMod 3) :
    chainForm N (Pi.single i c) (Pi.single j d) =
      (if (i : ℕ) + 1 = j then c * d else 0) - (if (j : ℕ) + 1 = i then d * c else 0) := by
  rw [chainForm_eq_sub, halfChainForm_single_single, halfChainForm_single_single]

/-! ### Cube roots of unity and the cubic factor set -/

/-- The primitive third root of unity `ω = exp (2 π i / 3)`, bundled as a unit of `ℂ`. -/
noncomputable def cubeRootOfUnity : ℂˣ :=
  Units.mk0 (Complex.exp (2 * Real.pi / 3 * Complex.I)) (Complex.exp_ne_zero _)

/-- `ω ^ x` for an exponent `x : ZMod 3`, read through `ZMod.val`. -/
noncomputable def cubeRootPow (x : ZMod 3) : ℂˣ :=
  cubeRootOfUnity ^ x.val

/-- Unfolds `cubeRootPow x`. -/
theorem cubeRootPow_def (x : ZMod 3) : cubeRootPow x = cubeRootOfUnity ^ x.val :=
  (rfl)

/-- `cubeRootOfUnity` has order dividing `3`. -/
@[simp]
theorem cubeRootOfUnity_pow_three : cubeRootOfUnity ^ 3 = 1 := by
  ext
  simp only [Units.val_pow_eq_pow_val, cubeRootOfUnity, Units.val_mk0, Units.val_one]
  rw [← Complex.exp_nat_mul]
  convert Complex.exp_two_pi_mul_I using 2
  push_cast
  ring

/-- `(cubeRootOfUnity : ℂ)` has cubed value `1`. -/
@[simp]
theorem coe_cubeRootOfUnity_pow_three : (cubeRootOfUnity : ℂ) ^ 3 = 1 := by
  rw [← Units.val_pow_eq_pow_val, cubeRootOfUnity_pow_three, Units.val_one]

/-- `cubeRootOfUnity` is nontrivial: `exp (2 π i / 3) ≠ 1`. -/
theorem coe_cubeRootOfUnity_ne_one : (cubeRootOfUnity : ℂ) ≠ 1 := by
  intro h
  have him : (cubeRootOfUnity : ℂ).im = Real.sin (2 * Real.pi / 3) := by
    have hexp : 2 * Real.pi / 3 * Complex.I = ((2 * Real.pi / 3 : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    simp [cubeRootOfUnity, hexp, Complex.exp_ofReal_mul_I_im]
  have hpos : 0 < Real.sin (2 * Real.pi / 3) :=
    Real.sin_pos_of_pos_of_lt_pi (by positivity) (by linarith [Real.pi_pos])
  rw [h, Complex.one_im] at him
  exact hpos.ne him

/-- Cyclotomic vanishing `1 + ω + ω² = 0`. -/
theorem one_add_cubeRootOfUnity_add_sq :
    1 + (cubeRootOfUnity : ℂ) + (cubeRootOfUnity : ℂ) ^ 2 = 0 := by
  have hprod : (1 - (cubeRootOfUnity : ℂ)) *
      (1 + (cubeRootOfUnity : ℂ) + (cubeRootOfUnity : ℂ) ^ 2) = 0 := by
    linear_combination -coe_cubeRootOfUnity_pow_three
  exact (mul_eq_zero.mp hprod).resolve_left (sub_ne_zero.mpr coe_cubeRootOfUnity_ne_one.symm)

/-- Complex conjugation inverts `cubeRootOfUnity`. -/
@[simp]
theorem star_coe_cubeRootOfUnity :
    star (cubeRootOfUnity : ℂ) = ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) := by
  simp only [cubeRootOfUnity, Units.val_mk0, Units.val_inv_eq_inv_val, Complex.star_def,
    ← Complex.exp_conj, ← Complex.exp_neg]
  congr 1
  simp only [map_mul, map_div₀, map_ofNat, Complex.conj_ofReal, Complex.conj_I]
  ring

@[simp]
theorem cubeRootPow_zero : cubeRootPow 0 = 1 := by
  simp [cubeRootPow]

@[simp]
theorem cubeRootPow_one : cubeRootPow 1 = cubeRootOfUnity :=
  pow_one cubeRootOfUnity

@[simp]
theorem cubeRootPow_two : cubeRootPow 2 = cubeRootOfUnity ^ 2 :=
  (rfl)

/-- `cubeRootPow` converts addition in `ZMod 3` to multiplication in `ℂˣ`. -/
theorem cubeRootPow_add (x y : ZMod 3) :
    cubeRootPow (x + y) = cubeRootPow x * cubeRootPow y := by
  simp only [cubeRootPow, ZMod.val_add]
  rw [← pow_add, ← pow_eq_pow_mod _ cubeRootOfUnity_pow_three]

/-- `cubeRootPow` converts negation in `ZMod 3` to inversion in `ℂˣ`. -/
@[simp]
theorem cubeRootPow_neg (x : ZMod 3) : cubeRootPow (-x) = (cubeRootPow x)⁻¹ := by
  apply mul_eq_one_iff_eq_inv.mp
  rw [← cubeRootPow_add, neg_add_cancel, cubeRootPow_zero]

/-- Every value of `cubeRootPow` cubes to `1`. -/
@[simp]
theorem cubeRootPow_pow_three (x : ZMod 3) : cubeRootPow x ^ 3 = 1 := by
  rw [cubeRootPow, ← pow_mul, mul_comm, pow_mul, cubeRootOfUnity_pow_three, one_pow]

/-- `cubeRootPow (n : ZMod 3)` is `cubeRootOfUnity ^ n`. -/
theorem cubeRootPow_natCast (n : ℕ) : cubeRootPow (n : ZMod 3) = cubeRootOfUnity ^ n := by
  rw [cubeRootPow, ZMod.val_natCast, ← pow_eq_pow_mod _ cubeRootOfUnity_pow_three]

/-- `cubeRootPow x = 1` if and only if `x = 0`. -/
@[simp]
theorem cubeRootPow_eq_one_iff {x : ZMod 3} : cubeRootPow x = 1 ↔ x = 0 := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ by simp [hx]⟩
  rcases zmod3_cases x with rfl | rfl | rfl
  · rfl
  · rw [cubeRootPow_one] at hx
    exact absurd ((congrArg Units.val hx).trans Units.val_one) coe_cubeRootOfUnity_ne_one
  · have h22 : (2 : ZMod 3) + 2 = 1 := by decide
    have h := cubeRootPow_add 2 2
    rw [h22, cubeRootPow_one, hx, one_mul] at h
    exact absurd ((congrArg Units.val h).trans Units.val_one) coe_cubeRootOfUnity_ne_one

/-- Complex conjugation sends `(cubeRootPow x : ℂ)` to `(cubeRootPow (-x) : ℂ)`. -/
@[simp]
theorem star_coe_cubeRootPow (x : ZMod 3) :
    star (cubeRootPow x : ℂ) = (cubeRootPow (-x) : ℂ) := by
  rw [cubeRootPow_neg, cubeRootPow, Units.val_pow_eq_pow_val, star_pow, star_coe_cubeRootOfUnity,
    Units.val_inv_eq_inv_val, ← inv_pow, ← Units.val_inv_eq_inv_val, ← Units.val_pow_eq_pow_val]

/-- For every nonzero `c : ZMod 3`, `1 + ω^c + ω^(2c) = 0`. -/
theorem one_add_cubeRootPow_add_two_mul {c : ZMod 3} (hc : c ≠ 0) :
    1 + (cubeRootPow c : ℂ) + (cubeRootPow (2 * c) : ℂ) = 0 := by
  rcases zmod3_cases c with rfl | rfl | rfl
  · exact absurd rfl hc
  · have h21 : (2 : ZMod 3) * 1 = 2 := by decide
    rw [h21, cubeRootPow_one, cubeRootPow_two, Units.val_pow_eq_pow_val]
    exact one_add_cubeRootOfUnity_add_sq
  · have h22 : (2 : ZMod 3) * 2 = 1 := by decide
    rw [h22, cubeRootPow_two, cubeRootPow_one, Units.val_pow_eq_pow_val, add_right_comm]
    exact one_add_cubeRootOfUnity_add_sq

/-- **The factor set of the cubic quantum torus**: `α(a, b) = ω ^ (2 * B(a, b))`. -/
noncomputable def cubicFactor (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) : ℂˣ :=
  cubeRootPow (2 * chainForm N a.toAdd b.toAdd)

/-- Unfolds `cubicFactor N a b`. -/
theorem cubicFactor_def (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a b = cubeRootPow (2 * chainForm N a.toAdd b.toAdd) :=
  (rfl)

/-- `cubicFactor N` is a normalized factor set on `Multiplicative (Fin N → ZMod 3)`. -/
instance cubicFactor_isFactorSet (N : ℕ) : IsFactorSet (cubicFactor N) where
  cocycle g h j := by
    simp only [cubicFactor, toAdd_mul, ← cubeRootPow_add]
    congr 1
    rw [chainForm_add_left, chainForm_add_right]
    ring
  one_left g := by simp [cubicFactor]

@[simp]
theorem cubicFactor_self (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a a = 1 := by
  simp [cubicFactor]

@[simp]
theorem cubicFactor_inv_self (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a⁻¹ a = 1 := by
  simp [cubicFactor]

@[simp]
theorem cubicFactor_self_inv (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a a⁻¹ = 1 := by
  simp [cubicFactor]

/-- Group inversion preserves `cubicFactor`. -/
theorem cubicFactor_inv_inv (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a⁻¹ b⁻¹ = cubicFactor N a b := by
  simp [cubicFactor]

/-- Negating the right argument inverts `cubicFactor`. -/
@[simp]
theorem cubicFactor_inv_right (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a b⁻¹ = (cubicFactor N a b)⁻¹ := by
  simp [cubicFactor, ← cubeRootPow_neg]

/-- Negating the left argument inverts `cubicFactor`. -/
@[simp]
theorem cubicFactor_inv_left (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a⁻¹ b = (cubicFactor N a b)⁻¹ := by
  simp [cubicFactor, ← cubeRootPow_neg]

/-- Swapping arguments inverts `cubicFactor`. -/
theorem cubicFactor_swap (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N b a = (cubicFactor N a b)⁻¹ := by
  rw [cubicFactor, chainForm_swap, mul_neg, cubeRootPow_neg, ← cubicFactor]

/-- Complex conjugation on `cubicFactor` matches the adjoint condition `star α(a, b) = α(b⁻¹, a⁻¹)`
required by `TwistedMonoidAlgebra.conjReverse_mul`. -/
theorem star_coe_cubicFactor (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    star (cubicFactor N a b : ℂ) = (cubicFactor N b⁻¹ a⁻¹ : ℂ) := by
  rw [cubicFactor, star_coe_cubeRootPow, cubicFactor_inv_inv, cubicFactor, chainForm_swap, mul_neg,
    neg_neg]

/-! ### The cubic quantum torus `G_N`, Weyl basis, trace, and adjoint -/

/-- **The cubic quantum torus** `G_N`: the complex twisted group algebra of `(ZMod 3)^N` with
factor set `cubicFactor N`. -/
noncomputable abbrev CubicTorus (N : ℕ) :=
  twistedMonoidAlgebra ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)

/-- The Weyl basis element `W(a)` of `CubicTorus N`. -/
noncomputable def weyl (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) : CubicTorus N :=
  TwistedMonoidAlgebra.of a

/-- Unfolds `weyl N a` to `TwistedMonoidAlgebra.of a`. -/
theorem weyl_def (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    weyl N a = TwistedMonoidAlgebra.of a :=
  (rfl)

@[simp]
theorem weyl_one (N : ℕ) : weyl N 1 = 1 :=
  TwistedMonoidAlgebra.of_one

@[simp]
theorem weyl_mul_weyl (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    weyl N a * weyl N b = (cubicFactor N a b : ℂ) • weyl N (a * b) :=
  TwistedMonoidAlgebra.of_mul_of a b

/-- Every Weyl generator `W(a)` is a unit with inverse `W(a⁻¹)` (`α(a⁻¹, a) = 1`). -/
theorem weyl_mul_weyl_inv (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    weyl N a * weyl N a⁻¹ = 1 := by
  rw [weyl_mul_weyl, cubicFactor_self_inv, Units.val_one, one_smul, mul_inv_cancel, weyl_one]

theorem weyl_inv_mul_weyl (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    weyl N a⁻¹ * weyl N a = 1 := by
  rw [weyl_mul_weyl, cubicFactor_inv_self, Units.val_one, one_smul, inv_mul_cancel, weyl_one]

/-- Commutation law for Weyl basis elements: `W(a) W(b) = ω ^ B(a, b) • (W(b) W(a))`. -/
theorem weyl_mul_comm (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    weyl N a * weyl N b =
      (cubeRootPow (chainForm N a.toAdd b.toAdd) : ℂ) • (weyl N b * weyl N a) := by
  rw [weyl_mul_weyl, weyl_mul_weyl, mul_comm b a, smul_smul, ← Units.val_mul, cubicFactor,
    cubicFactor, chainForm_swap N a.toAdd b.toAdd, ← cubeRootPow_add]
  apply congrArg (fun z ↦ (cubeRootPow z : ℂ) • weyl N (a * b))
  rcases zmod3_cases (chainForm N a.toAdd b.toAdd) with h | h | h <;> rw [h] <;> decide

/-- The dimension of `CubicTorus N` over `ℂ` is `3 ^ N`. -/
@[simp]
theorem finrank_cubicTorus (N : ℕ) : Module.finrank ℂ (CubicTorus N) = 3 ^ N := by
  rw [TwistedMonoidAlgebra.finrank_eq_natCard]
  simp

/-- **The normalized scalar trace** `s_N` on `CubicTorus N`, reading off the `W(0)`-coefficient in
`TwistedMonoidAlgebra.basis`. -/
noncomputable abbrev cubicScalarCoefficient (N : ℕ) : CubicTorus N →ₗ[ℂ] ℂ :=
  TwistedMonoidAlgebra.scalarTrace ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)

/-- **The conjugate-linear adjoint** `†` on `CubicTorus N`, sending `∑ z_a • W(a)` to
`∑ star z_a • W(a⁻¹)`. -/
noncomputable abbrev cubicAdjoint (N : ℕ) : CubicTorus N →ₗ⋆[ℂ] CubicTorus N :=
  TwistedMonoidAlgebra.conjReverse ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)

@[simp]
theorem cubicAdjoint_weyl (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicAdjoint N (weyl N a) = weyl N a⁻¹ :=
  TwistedMonoidAlgebra.conjReverse_of a

/-- `cubicAdjoint N` reverses multiplication on `CubicTorus N`. -/
theorem cubicAdjoint_mul (N : ℕ) (x y : CubicTorus N) :
    cubicAdjoint N (x * y) = cubicAdjoint N y * cubicAdjoint N x :=
  TwistedMonoidAlgebra.conjReverse_mul (star_coe_cubicFactor N) x y

/-! ### Site unitaries and the universal presentation of `CubicTorus N` -/

/-- The site unitary `U_j = W(e_j)` at site `j : Fin N`. -/
noncomputable def cubicSite (N : ℕ) (j : Fin N) : CubicTorus N :=
  weyl N (ofAdd (Pi.single j 1))

/-- Unfolds `cubicSite N j` to `weyl N (ofAdd (Pi.single j 1))`. -/
theorem cubicSite_def (N : ℕ) (j : Fin N) :
    cubicSite N j = weyl N (ofAdd (Pi.single j 1)) :=
  (rfl)

/-- `cubicSite N j ^ 2` is the Weyl element `W(2 e_j) = W(-e_j)`. -/
theorem cubicSite_sq (N : ℕ) (j : Fin N) :
    cubicSite N j ^ 2 = weyl N (ofAdd (Pi.single j 2)) := by
  have h11 : (1 : ZMod 3) + 1 = 2 := rfl
  rw [sq, cubicSite_def, weyl_mul_weyl, cubicFactor_self, Units.val_one, one_smul, ← ofAdd_add,
    ← Pi.single_add, h11]

/-- Each site unitary has order dividing `3`: `U_j ^ 3 = 1`. -/
@[simp]
theorem cubicSite_pow_three (N : ℕ) (j : Fin N) : cubicSite N j ^ 3 = 1 := by
  have h21 : (2 : ZMod 3) + 1 = 0 := by decide
  rw [pow_succ, cubicSite_sq, cubicSite_def, weyl_mul_weyl, cubicFactor, toAdd_ofAdd, toAdd_ofAdd,
    chainForm_single_single]
  simp only [Nat.add_one_ne_self, ↓reduceIte, sub_self, mul_zero, cubeRootPow_zero, Units.val_one,
    one_smul, ← ofAdd_add, ← Pi.single_add, h21, Pi.single_zero, ofAdd_zero, weyl_one]

/-- `cubicAdjoint` inverts each site unitary: `U_j† = U_j²`. -/
@[simp]
theorem cubicAdjoint_cubicSite (N : ℕ) (j : Fin N) :
    cubicAdjoint N (cubicSite N j) = cubicSite N j ^ 2 := by
  have hneg : (-1 : ZMod 3) = 2 := by decide
  nth_rw 1 [cubicSite_def]
  rw [cubicAdjoint_weyl, ← ofAdd_neg, ← Pi.single_neg, hneg, ← cubicSite_sq]

/-- Adjacent site unitaries satisfy `U_i * U_j = ω • (U_j * U_i)` when `i + 1 = j`. -/
theorem cubicSite_mul_cubicSite_of_succ {N : ℕ} {i j : Fin N} (h : (i : ℕ) + 1 = j) :
    cubicSite N i * cubicSite N j = (cubeRootOfUnity : ℂ) • (cubicSite N j * cubicSite N i) := by
  have hne : ¬ (j : ℕ) + 1 = i := by omega
  rw [cubicSite_def, cubicSite_def, weyl_mul_comm, toAdd_ofAdd, toAdd_ofAdd,
    chainForm_single_single]
  simp [h, hne]

/-- Site unitaries at distance at least two commute. -/
theorem commute_cubicSite {N : ℕ} {i j : Fin N} (h : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    Commute (cubicSite N i) (cubicSite N j) := by
  have hij : ¬ (i : ℕ) + 1 = j := by omega
  have hji : ¬ (j : ℕ) + 1 = i := by omega
  rw [commute_iff_eq, cubicSite_def, cubicSite_def, weyl_mul_comm, toAdd_ofAdd, toAdd_ofAdd,
    chainForm_single_single]
  simp [hij, hji]

section UniversalProperty

/-- Ordered monomial `u_0^{a_0} ⋯ u_{N-1}^{a_{N-1}}` used to construct `liftSite`. -/
private def siteMonomial {A : Type*} [Monoid A] :
    ∀ {N : ℕ}, (Fin N → A) → (Fin N → ZMod 3) → A
  | 0, _, _ => 1
  | _ + 1, u, a =>
    siteMonomial (u ∘ Fin.castSucc) (Fin.init a) * u (Fin.last _) ^ (a (Fin.last _)).val

private theorem siteMonomial_zero {A : Type*} [Monoid A] {N : ℕ} (u : Fin N → A) :
    siteMonomial u 0 = 1 := by
  induction N with
  | zero => rfl
  | succ N ih =>
    simp only [siteMonomial, Fin.init_def, Pi.zero_apply, ZMod.val_zero, pow_zero, mul_one]
    exact ih (u ∘ Fin.castSucc)

private theorem siteMonomial_single {A : Type*} [Monoid A] :
    ∀ {N : ℕ} (u : Fin N → A) (j : Fin N), siteMonomial u (Pi.single j 1) = u j
  | 0, _, j => Fin.elim0 j
  | N + 1, u, j => by
    induction j using Fin.lastCases with
    | last =>
      have hinit : Fin.init (Pi.single (Fin.last N) 1 : Fin (N + 1) → ZMod 3) = 0 := by
        ext i; simp [Fin.init]
      have hlast : (Pi.single (Fin.last N) 1 : Fin (N + 1) → ZMod 3) (Fin.last N) = 1 := by simp
      rw [siteMonomial, hinit, hlast, siteMonomial_zero, one_mul]
      exact pow_one (u (Fin.last N))
    | cast i =>
      have hinit : Fin.init (Pi.single i.castSucc 1 : Fin (N + 1) → ZMod 3) = Pi.single i 1 := by
        ext k; simp [Fin.init, Pi.single_apply, Fin.castSucc_inj]
      have hlast : (Pi.single i.castSucc 1 : Fin (N + 1) → ZMod 3) (Fin.last N) = 0 :=
        Pi.single_eq_of_ne (M := fun _ : Fin (N + 1) ↦ ZMod 3) (Fin.castSucc_ne_last i).symm 1
      rw [siteMonomial, hinit, hlast, ZMod.val_zero, pow_zero, mul_one]
      exact siteMonomial_single (u ∘ Fin.castSucc) i

variable {A : Type*} [Semiring A] [Algebra ℂ A]

private theorem mul_pow_of_qcomm {v w : A} {c : ZMod 3}
    (hvw : v * w = (cubeRootPow (2 * c) : ℂ) • (w * v)) :
    ∀ s : ℕ, v * w ^ s = (cubeRootPow (2 * c * (s : ZMod 3)) : ℂ) • (w ^ s * v)
  | 0 => by simp
  | s + 1 => by
    rw [pow_succ', ← mul_assoc, hvw, smul_mul_assoc, mul_assoc, mul_pow_of_qcomm hvw s,
      mul_smul_comm, smul_smul, ← Units.val_mul, ← cubeRootPow_add, ← mul_assoc w (w ^ s) v,
      ← pow_succ']
    congr 3
    push_cast
    ring

private theorem mul_siteMonomial_of_qcomm :
    ∀ {N : ℕ} {u : Fin N → A} {v : A} {φ : Fin N → ZMod 3},
      (∀ i : Fin N, v * u i = (cubeRootPow (2 * φ i) : ℂ) • (u i * v)) →
      ∀ b : Fin N → ZMod 3,
        v * siteMonomial u b =
          (cubeRootPow (2 * ∑ i : Fin N, φ i * b i) : ℂ) • (siteMonomial u b * v)
  | 0, _, _, _, _, _ => by simp [siteMonomial]
  | N + 1, u, v, φ, hφ, b => by
    have ih := mul_siteMonomial_of_qcomm (u := u ∘ Fin.castSucc) (φ := φ ∘ Fin.castSucc)
      (fun i ↦ hφ i.castSucc) (Fin.init b)
    have hlast := mul_pow_of_qcomm (hφ (Fin.last N)) (b (Fin.last N)).val
    simp only [ZMod.natCast_zmod_val] at hlast
    rw [siteMonomial, ← mul_assoc, ih, smul_mul_assoc, mul_assoc, hlast, mul_smul_comm,
      smul_smul, ← Units.val_mul, ← cubeRootPow_add, ← mul_assoc]
    congr 3
    rw [Fin.sum_univ_castSucc]
    simp [Fin.init, mul_add]
    ring

private theorem pow_mul_siteMonomial_of_qcomm {N : ℕ} {u : Fin N → A} {v : A} {φ : Fin N → ZMod 3}
    (hφ : ∀ i : Fin N, v * u i = (cubeRootPow (2 * φ i) : ℂ) • (u i * v))
    (b : Fin N → ZMod 3) :
    ∀ r : ℕ, v ^ r * siteMonomial u b =
      (cubeRootPow (2 * (r : ZMod 3) * ∑ i : Fin N, φ i * b i) : ℂ) • (siteMonomial u b * v ^ r)
  | 0 => by simp
  | r + 1 => by
    rw [pow_succ, mul_assoc, mul_siteMonomial_of_qcomm hφ b, mul_smul_comm, ← mul_assoc,
      pow_mul_siteMonomial_of_qcomm hφ b r, smul_mul_assoc, smul_smul, ← Units.val_mul,
      ← cubeRootPow_add, mul_assoc (siteMonomial u b) (v ^ r) v, ← pow_succ]
    congr 3
    push_cast
    ring

private theorem halfChainForm_succ (N : ℕ) (b a : Fin (N + 1) → ZMod 3) :
    halfChainForm (N + 1) b a =
      halfChainForm N (Fin.init b) (Fin.init a) +
        a (Fin.last N) *
          ∑ i : Fin N, (if (i : ℕ) + 1 = N then (1 : ZMod 3) else 0) * b i.castSucc := by
  unfold halfChainForm
  rw [Fin.sum_univ_castSucc]
  have hlast : (∑ j : Fin (N + 1),
      if (Fin.last N : ℕ) + 1 = (j : ℕ) then b (Fin.last N) * a j else 0) = 0 := by
    refine Finset.sum_eq_zero fun j _ ↦ ?_
    have hj : ¬ N + 1 = (j : ℕ) := by omega
    simp [Fin.val_last, hj]
  rw [hlast, add_zero]
  simp only [Fin.sum_univ_castSucc, Fin.val_castSucc, Fin.val_last, Finset.sum_add_distrib,
    Fin.init, Finset.mul_sum]
  congr 1
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  split_ifs <;> ring

private theorem siteMonomial_mul_siteMonomial :
    ∀ {N : ℕ} (u : Fin N → A), (∀ j, u j ^ 3 = 1) →
      (∀ {i j : Fin N}, (i : ℕ) + 1 = j → u i * u j = (cubeRootOfUnity : ℂ) • (u j * u i)) →
      (∀ {i j : Fin N}, (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i → u i * u j = u j * u i) →
      ∀ a b : Fin N → ZMod 3,
      siteMonomial u a * siteMonomial u b =
        (cubeRootPow (2 * halfChainForm N b a) : ℂ) • siteMonomial u (a + b)
  | 0, _, _, _, _, _, _ => by simp [siteMonomial, halfChainForm]
  | N + 1, u, hcube, hadj, hdist, a, b => by
    have hqcomm : ∀ i : Fin N, u (Fin.last N) * u i.castSucc =
        (cubeRootPow (2 * if (i : ℕ) + 1 = N then (1 : ZMod 3) else 0) : ℂ) •
          (u i.castSucc * u (Fin.last N)) := by
      intro i
      split_ifs with hi
      · have h := congrArg ((cubeRootPow 2 : ℂ) • ·) (hadj (i := i.castSucc) (j := Fin.last N) hi)
        have h21 : (cubeRootOfUnity : ℂ) ^ 2 * (cubeRootOfUnity : ℂ) = 1 := by
          rw [← pow_succ, coe_cubeRootOfUnity_pow_three]
        simpa [smul_smul, h21] using h.symm
      · have hd : (i.castSucc : ℕ) + 2 ≤ (Fin.last N : ℕ) := by
          have := i.isLt; simp at hi ⊢; omega
        simp [hdist (Or.inr hd)]
    have hcomm := pow_mul_siteMonomial_of_qcomm (u := u ∘ Fin.castSucc) hqcomm (Fin.init b)
      (a (Fin.last N)).val
    simp only [ZMod.natCast_zmod_val] at hcomm
    have ih := siteMonomial_mul_siteMonomial (u ∘ Fin.castSucc) (fun j ↦ hcube j.castSucc)
      (fun h ↦ hadj h) (fun h ↦ hdist h) (Fin.init a) (Fin.init b)
    have hpow : u (Fin.last N) ^ (a (Fin.last N)).val * u (Fin.last N) ^ (b (Fin.last N)).val =
        u (Fin.last N) ^ ((a + b) (Fin.last N)).val := by
      rw [← pow_add, Pi.add_apply, ZMod.val_add, ← pow_eq_pow_mod _ (hcube (Fin.last N))]
    calc
      siteMonomial u a * siteMonomial u b
          = siteMonomial (u ∘ Fin.castSucc) (Fin.init a) *
              (u (Fin.last N) ^ (a (Fin.last N)).val *
                siteMonomial (u ∘ Fin.castSucc) (Fin.init b)) *
              u (Fin.last N) ^ (b (Fin.last N)).val := by
            simp only [siteMonomial, mul_assoc]
      _ = (cubeRootPow (2 * halfChainForm (N + 1) b a) : ℂ) • siteMonomial u (a + b) := by
            rw [hcomm, mul_smul_comm, ← mul_assoc (siteMonomial _ _) (siteMonomial _ _), ih]
            simp only [smul_mul_assoc, mul_assoc, hpow, smul_smul, ← Units.val_mul,
              ← cubeRootPow_add, halfChainForm_succ, siteMonomial]
            change _ = _ • (siteMonomial (u ∘ Fin.castSucc) (Fin.init a + Fin.init b) * _)
            apply congrArg (fun z ↦ (cubeRootPow z : ℂ) • _)
            simp only [Fin.init]
            ring

/-- **Universal property of `CubicTorus N` on site generators.** Any `N` elements `u : Fin N → A` of
a `ℂ`-algebra satisfying `u j ^ 3 = 1`, `u i * u_{i+1} = ω • (u_{i+1} * u i)`, and commuting at
distance at least two determine a `ℂ`-algebra homomorphism `CubicTorus N →ₐ[ℂ] A` sending
`cubicSite N j` to `u j`. -/
noncomputable def liftSite {N : ℕ} (u : Fin N → A)
    (hcube : ∀ j, u j ^ 3 = 1)
    (hadj : ∀ {i j : Fin N}, (i : ℕ) + 1 = j → u i * u j = (cubeRootOfUnity : ℂ) • (u j * u i))
    (hdist : ∀ {i j : Fin N}, (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i → u i * u j = u j * u i) :
    CubicTorus N →ₐ[ℂ] A :=
  TwistedMonoidAlgebra.lift
    (fun a ↦ (cubeRootPow (halfChainForm N a.toAdd a.toAdd) : ℂ) • siteMonomial u a.toAdd)
    (by simp [siteMonomial_zero, halfChainForm_zero_left])
    (fun a b ↦ by
      rw [smul_mul_smul_comm, siteMonomial_mul_siteMonomial u hcube hadj hdist, smul_smul,
        smul_smul, ← Units.val_mul, ← Units.val_mul, ← Units.val_mul, cubicFactor,
        ← cubeRootPow_add, ← cubeRootPow_add, ← cubeRootPow_add, chainForm_eq_sub, toAdd_mul,
        halfChainForm_add_left, halfChainForm_add_right, halfChainForm_add_right]
      congr 3
      have h3 : (3 : ZMod 3) = 0 := by decide
      apply sub_eq_zero.mp
      calc
        halfChainForm N a.toAdd a.toAdd + halfChainForm N b.toAdd b.toAdd +
            2 * halfChainForm N b.toAdd a.toAdd -
            (2 * (halfChainForm N a.toAdd b.toAdd - halfChainForm N b.toAdd a.toAdd) +
              (halfChainForm N a.toAdd a.toAdd + halfChainForm N a.toAdd b.toAdd +
                (halfChainForm N b.toAdd a.toAdd + halfChainForm N b.toAdd b.toAdd)))
            = (3 : ZMod 3) * (halfChainForm N b.toAdd a.toAdd -
                halfChainForm N a.toAdd b.toAdd) := by ring
        _ = 0 := by rw [h3, zero_mul])

/-- `liftSite` sends each site unitary `cubicSite N j` to `u j`. -/
@[simp]
theorem liftSite_cubicSite {N : ℕ} (u : Fin N → A) (hcube) (hadj) (hdist) (j : Fin N) :
    liftSite u hcube hadj hdist (cubicSite N j) = u j := by
  simp [liftSite, cubicSite_def, weyl_def, halfChainForm_single_single, siteMonomial_single]

end UniversalProperty

private theorem siteMonomial_mem_adjoin {B : Type*} [Semiring B] [Algebra ℂ B] :
    ∀ {M : ℕ} (u : Fin M → B) (a : Fin M → ZMod 3),
      siteMonomial u a ∈ Algebra.adjoin ℂ (Set.range u)
  | 0, u, _ => (Algebra.adjoin ℂ (Set.range u)).one_mem
  | M + 1, u, a => by
    let S : Subalgebra ℂ B := Algebra.adjoin ℂ (Set.range u)
    have hprev : siteMonomial (u ∘ Fin.castSucc) (Fin.init a) ∈ S :=
      Algebra.adjoin_mono (Set.range_comp_subset_range _ _)
        (siteMonomial_mem_adjoin (u ∘ Fin.castSucc) (Fin.init a))
    have hlast : u (Fin.last M) ∈ S := Algebra.subset_adjoin (Set.mem_range_self (Fin.last M))
    exact S.mul_mem hprev (S.pow_mem hlast _)

private theorem weyl_eq_liftSite_id (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    weyl N a =
      (cubeRootPow (halfChainForm N a.toAdd a.toAdd) : ℂ) • siteMonomial (cubicSite N) a.toAdd := by
  let Φ : CubicTorus N →ₐ[ℂ] CubicTorus N :=
    liftSite (cubicSite N) (cubicSite_pow_three N)
      (fun h ↦ cubicSite_mul_cubicSite_of_succ h)
      (fun h ↦ (commute_cubicSite h).eq)
  suffices ∀ x : Fin N → ZMod 3, Φ (weyl N (ofAdd x)) = weyl N (ofAdd x) by
    simpa [Φ, liftSite, weyl_def] using (this a.toAdd).symm
  intro x
  have hsum : x = ∑ j : Fin N, Pi.single j (x j) := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  rw [hsum]
  induction (Finset.univ : Finset (Fin N)) using Finset.cons_induction with
  | empty => simp [weyl_one]
  | cons j s hjs ih =>
    rw [Finset.sum_cons, ofAdd_add]
    have hmul := weyl_mul_weyl N (ofAdd (Pi.single j (x j)))
      (ofAdd (∑ i ∈ s, Pi.single i (x i)))
    have hunit : IsUnit (cubicFactor N (ofAdd (Pi.single j (x j)))
        (ofAdd (∑ i ∈ s, Pi.single i (x i))) : ℂ) := Units.isUnit _
    have hsingle : Φ (weyl N (ofAdd (Pi.single j (x j)))) =
        weyl N (ofAdd (Pi.single j (x j))) := by
      rcases zmod3_cases (x j) with h0 | h1 | h2
      · simp [h0]
      · rw [h1, ← cubicSite_def]
        exact liftSite_cubicSite ..
      · rw [h2, ← cubicSite_sq, map_pow]
        congr 1
        exact liftSite_cubicSite ..
    have hprod : Φ (weyl N (ofAdd (Pi.single j (x j))) *
          weyl N (ofAdd (∑ i ∈ s, Pi.single i (x i)))) =
        weyl N (ofAdd (Pi.single j (x j))) *
          weyl N (ofAdd (∑ i ∈ s, Pi.single i (x i))) := by
      rw [map_mul, hsingle, ih]
    rw [hmul, map_smul] at hprod
    exact hunit.smul_left_cancel.mp hprod

/-- The site unitaries `cubicSite N` generate `CubicTorus N` as a `ℂ`-algebra. -/
theorem adjoin_range_cubicSite (N : ℕ) :
    Algebra.adjoin ℂ (Set.range (cubicSite N)) = ⊤ := by
  let S : Subalgebra ℂ (CubicTorus N) := Algebra.adjoin ℂ (Set.range (cubicSite N))
  suffices ∀ x : CubicTorus N, x ∈ S from eq_top_iff.mpr fun x _ ↦ this x
  intro x
  induction (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
      (cubicFactor N)).mem_span x using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨a, rfl⟩ := hy
    rw [TwistedMonoidAlgebra.basis_apply, ← weyl_def, weyl_eq_liftSite_id]
    exact S.smul_mem (siteMonomial_mem_adjoin (cubicSite N) a.toAdd) _
  | zero => exact S.zero_mem
  | add _ _ _ _ hx hy => exact S.add_mem hx hy
  | smul _ _ _ hx => exact S.smul_mem hx _

/-- Two `ℂ`-algebra homomorphisms out of `CubicTorus N` agreeing on `cubicSite N` are equal. -/
theorem algHom_ext_cubicSite {N : ℕ} {A : Type*} [Semiring A] [Algebra ℂ A]
    {F G : CubicTorus N →ₐ[ℂ] A} (h : ∀ j : Fin N, F (cubicSite N j) = G (cubicSite N j)) :
    F = G := by
  have heq : AlgHom.equalizer F G = ⊤ := by
    rw [eq_top_iff, ← adjoin_range_cubicSite N, Algebra.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    exact h j
  exact AlgHom.ext fun x ↦ (AlgHom.mem_equalizer F G x).mp (heq.symm ▸ trivial)

/-! ### Group inversion, the fixed subalgebra `C_N`, and its dimension `(3 ^ N + 1) / 2` -/

/-- **The inversion automorphism** `θ_N : W(a) ↦ W(a⁻¹)` of `CubicTorus N`. -/
noncomputable def cubicInversion (N : ℕ) : CubicTorus N →ₐ[ℂ] CubicTorus N :=
  TwistedMonoidAlgebra.mapDomain invMonoidHom (cubicFactor_inv_inv N)

/-- Unfolds `cubicInversion N`. -/
theorem cubicInversion_def (N : ℕ) :
    cubicInversion N = TwistedMonoidAlgebra.mapDomain invMonoidHom (cubicFactor_inv_inv N) :=
  (rfl)

@[simp]
theorem cubicInversion_weyl (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicInversion N (weyl N a) = weyl N a⁻¹ :=
  TwistedMonoidAlgebra.mapDomain_of ..

/-- `cubicInversion N` is an involution. -/
@[simp]
theorem cubicInversion_cubicInversion (N : ℕ) (x : CubicTorus N) :
    cubicInversion N (cubicInversion N x) = x := by
  have hcomp : (cubicInversion N).comp (cubicInversion N) = AlgHom.id ℂ (CubicTorus N) :=
    TwistedMonoidAlgebra.algHom_ext fun g ↦ by
      rw [AlgHom.comp_apply, AlgHom.id_apply, ← weyl_def, cubicInversion_weyl, cubicInversion_weyl,
        inv_inv]
  exact AlgHom.congr_fun hcomp x

/-- `cubicInversion N` commutes with `cubicAdjoint N`. -/
theorem cubicAdjoint_cubicInversion (N : ℕ) (x : CubicTorus N) :
    cubicAdjoint N (cubicInversion N x) = cubicInversion N (cubicAdjoint N x) :=
  TwistedMonoidAlgebra.conjReverse_mapDomain invMonoidHom (cubicFactor_inv_inv N) x

/-- `cubicInversion N` preserves `cubicScalarCoefficient N`. -/
@[simp]
theorem cubicScalarCoefficient_cubicInversion (N : ℕ) (x : CubicTorus N) :
    cubicScalarCoefficient N (cubicInversion N x) = cubicScalarCoefficient N x :=
  TwistedMonoidAlgebra.scalarTrace_mapDomain_of_injective (cubicFactor_inv_inv N) inv_injective x

/-- `cubicInversion` squares each site unitary: `θ_N(U_j) = U_j²`. -/
@[simp]
theorem cubicInversion_cubicSite (N : ℕ) (j : Fin N) :
    cubicInversion N (cubicSite N j) = cubicSite N j ^ 2 := by
  have hneg : (-1 : ZMod 3) = 2 := by decide
  nth_rw 1 [cubicSite_def]
  rw [cubicInversion_weyl, ← ofAdd_neg, ← Pi.single_neg, hneg, ← cubicSite_sq]

/-- **The inversion-fixed subalgebra** `C_N = {x ∈ CubicTorus N | cubicInversion N x = x}`. -/
noncomputable def cubicFixed (N : ℕ) : Subalgebra ℂ (CubicTorus N) :=
  AlgHom.equalizer (cubicInversion N) (AlgHom.id ℂ (CubicTorus N))

@[simp]
theorem mem_cubicFixed_iff {N : ℕ} {x : CubicTorus N} :
    x ∈ cubicFixed N ↔ cubicInversion N x = x :=
  Iff.rfl

/-- `cubicAdjoint N` maps `cubicFixed N` into itself. -/
theorem cubicAdjoint_mem_cubicFixed {N : ℕ} {x : CubicTorus N} (hx : x ∈ cubicFixed N) :
    cubicAdjoint N x ∈ cubicFixed N := by
  rw [mem_cubicFixed_iff, ← cubicAdjoint_cubicInversion, mem_cubicFixed_iff.mp hx]

/-- Restriction of `cubicAdjoint N` to the inversion-fixed subalgebra `cubicFixed N`. -/
noncomputable def cubicFixedAdjoint (N : ℕ) : cubicFixed N →ₗ⋆[ℂ] cubicFixed N where
  toFun x := ⟨cubicAdjoint N x.1, cubicAdjoint_mem_cubicFixed x.2⟩
  map_add' x y := Subtype.ext (map_add (cubicAdjoint N) x.1 y.1)
  map_smul' c x := Subtype.ext (map_smulₛₗ (cubicAdjoint N) c x.1)

@[simp]
theorem coe_cubicFixedAdjoint (N : ℕ) (x : cubicFixed N) :
    (cubicFixedAdjoint N x : CubicTorus N) = cubicAdjoint N x :=
  (rfl)

@[simp]
theorem cubicFixedAdjoint_cubicFixedAdjoint (N : ℕ) (x : cubicFixed N) :
    cubicFixedAdjoint N (cubicFixedAdjoint N x) = x :=
  Subtype.ext (TwistedMonoidAlgebra.conjReverse_conjReverse x.1)

theorem cubicFixedAdjoint_mul (N : ℕ) (x y : cubicFixed N) :
    cubicFixedAdjoint N (x * y) = cubicFixedAdjoint N y * cubicFixedAdjoint N x :=
  Subtype.ext (cubicAdjoint_mul N x.1 y.1)

private theorem inv_eq_self_iff_eq_one_cubic (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    a⁻¹ = a ↔ a = 1 := by
  refine ⟨fun h ↦ ?_, fun h ↦ by simp [h]⟩
  apply toAdd.injective
  ext i
  have hi := congrFun (congrArg toAdd h) i
  simp only [toAdd_inv, Pi.neg_apply] at hi
  rcases zmod3_cases (a.toAdd i) with h0 | h1 | h2
  · exact h0
  · rw [h1] at hi; exact absurd hi (by decide)
  · rw [h2] at hi; exact absurd hi (by decide)

/-- **Dimension of the inversion-fixed subalgebra**: `dim_ℂ (cubicFixed N) = (3 ^ N + 1) / 2`. -/
@[simp]
theorem finrank_cubicFixed (N : ℕ) : Module.finrank ℂ (cubicFixed N) = (3 ^ N + 1) / 2 := by
  let b := TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)
  let θ : Module.End ℂ (CubicTorus N) := (cubicInversion N).toLinearMap
  let f : Module.End ℂ (CubicTorus N) := 1 + θ
  have hsq : f * f = (2 : ℂ) • f := by
    ext x
    simp only [f, θ, mul_apply_eq_comp, _root_.LinearMap.add_apply, one_apply_eq_self,
      AlgHom.toLinearMap_apply, map_add, cubicInversion_cubicInversion, two_smul]
    abel_nf
  have hrange : _root_.LinearMap.range f = (cubicFixed N).toSubmodule := by
    ext x
    simp only [_root_.LinearMap.mem_range, Subalgebra.mem_toSubmodule, mem_cubicFixed_iff]
    refine ⟨?_, fun hx ↦ ⟨(2 : ℂ)⁻¹ • x, ?_⟩⟩
    · rintro ⟨y, rfl⟩
      simp [f, θ, add_comm]
    · simp [f, θ, hx, ← two_smul ℂ x]
  have hdiag (a : Multiplicative (Fin N → ZMod 3)) :
      (_root_.LinearMap.toMatrix b b θ) a a = if a = 1 then 1 else 0 := by
    classical
    rw [_root_.LinearMap.toMatrix_apply, TwistedMonoidAlgebra.basis_apply]
    change b.repr (cubicInversion N (weyl N a)) a = _
    rw [cubicInversion_weyl, weyl_def, TwistedMonoidAlgebra.basis_repr_of, Finsupp.single_apply]
    simp only [inv_eq_self_iff_eq_one_cubic]
  have htrθ : _root_.LinearMap.trace ℂ (CubicTorus N) θ = 1 := by
    classical
    rw [_root_.LinearMap.trace_eq_matrix_trace ℂ b θ, Matrix.trace]
    simp [hdiag]
  have htr1 : _root_.LinearMap.trace ℂ (CubicTorus N) (1 : Module.End ℂ (CubicTorus N)) =
      (3 ^ N : ℂ) := by
    classical
    rw [_root_.LinearMap.trace_eq_matrix_trace ℂ b 1]
    simp
  have htr := TauCeti.LinearMap.trace_eq_mul_finrank_range (K := ℂ) (M := CubicTorus N) hsq
  rw [show f = 1 + θ from rfl, map_add, htr1, htrθ, hrange] at htr
  have hnat : 3 ^ N + 1 = 2 * Module.finrank ℂ (cubicFixed N) := by
    exact_mod_cast htr
  omega

/-! ### Spectral projections and the Temperley–Lieb comparison map -/

/-- **The spectral projection** `p_j = 3⁻¹ • (1 + U_j + U_j²)` at site `j : Fin N`. -/
noncomputable def cubicProjection (N : ℕ) (j : Fin N) : CubicTorus N :=
  (3 : ℂ)⁻¹ • (1 + cubicSite N j + cubicSite N j ^ 2)

/-- Unfolds `cubicProjection N j`. -/
theorem cubicProjection_def (N : ℕ) (j : Fin N) :
    cubicProjection N j = (3 : ℂ)⁻¹ • (1 + cubicSite N j + cubicSite N j ^ 2) :=
  (rfl)

private theorem one_add_cubicSite_mul_cubicSite (N : ℕ) (j : Fin N) :
    (1 + cubicSite N j + cubicSite N j ^ 2) * cubicSite N j =
      1 + cubicSite N j + cubicSite N j ^ 2 := by
  linear_combination (norm := noncomm_ring) cubicSite_pow_three N j

private theorem cubicSite_mul_one_add_cubicSite (N : ℕ) (j : Fin N) :
    cubicSite N j * (1 + cubicSite N j + cubicSite N j ^ 2) =
      1 + cubicSite N j + cubicSite N j ^ 2 := by
  linear_combination (norm := noncomm_ring) cubicSite_pow_three N j

/-- `cubicProjection N j` is fixed by `cubicInversion N`. -/
@[simp]
theorem cubicInversion_cubicProjection (N : ℕ) (j : Fin N) :
    cubicInversion N (cubicProjection N j) = cubicProjection N j := by
  have h4 : (cubicSite N j ^ 2) ^ 2 = cubicSite N j := by
    rw [← pow_mul, show 2 * 2 = 3 + 1 from rfl, pow_succ, cubicSite_pow_three, one_mul]
  rw [cubicProjection_def, map_smul, map_add, map_add, map_one, map_pow, cubicInversion_cubicSite,
    h4, add_right_comm]

/-- Every `cubicProjection N j` belongs to `cubicFixed N`. -/
theorem cubicProjection_mem_cubicFixed (N : ℕ) (j : Fin N) :
    cubicProjection N j ∈ cubicFixed N :=
  cubicInversion_cubicProjection N j

/-- `cubicProjection N j` is self-adjoint under `cubicAdjoint N`. -/
@[simp]
theorem cubicAdjoint_cubicProjection (N : ℕ) (j : Fin N) :
    cubicAdjoint N (cubicProjection N j) = cubicProjection N j := by
  have hsq : cubicAdjoint N (cubicSite N j ^ 2) = cubicSite N j := by
    rw [sq, cubicAdjoint_mul, cubicAdjoint_cubicSite, ← pow_add, show 2 + 2 = 3 + 1 from rfl,
      pow_succ, cubicSite_pow_three, one_mul]
  rw [cubicProjection_def, map_smulₛₗ, starRingEnd_apply, star_inv₀, star_ofNat, map_add, map_add,
    TwistedMonoidAlgebra.conjReverse_one, cubicAdjoint_cubicSite, hsq, add_right_comm]

/-- `cubicProjection N j` is idempotent: `p_j * p_j = p_j`. -/
@[simp]
theorem cubicProjection_mul_self (N : ℕ) (j : Fin N) :
    cubicProjection N j * cubicProjection N j = cubicProjection N j := by
  set s := 1 + cubicSite N j + cubicSite N j ^ 2
  have hsu : s * cubicSite N j = s := one_add_cubicSite_mul_cubicSite N j
  have hsu2 : s * cubicSite N j ^ 2 = s := by rw [sq, ← mul_assoc, hsu, hsu]
  have hsum : s * s = (3 : ℂ) • s := by
    calc
      s * (1 + cubicSite N j + cubicSite N j ^ 2)
          = s + s + s := by rw [mul_add, mul_add, mul_one, hsu, hsu2]
      _ = (3 : ℂ) • s := by
        rw [show (3 : ℂ) = 1 + 1 + 1 by norm_num, add_smul, add_smul, one_smul]
  rw [cubicProjection_def, ← show s = 1 + cubicSite N j + cubicSite N j ^ 2 from rfl,
    smul_mul_smul_comm, hsum, smul_smul]
  congr 1
  norm_num

/-- Sandwiching a Weyl element `W(a)` with `B(e_j, a) ≠ 0` between `cubicProjection N j` gives
`0`. -/
theorem cubicProjection_mul_weyl_mul_cubicProjection_eq_zero {N : ℕ} (j : Fin N)
    {a : Multiplicative (Fin N → ZMod 3)} (hc : chainForm N (Pi.single j 1) a.toAdd ≠ 0) :
    cubicProjection N j * weyl N a * cubicProjection N j = 0 := by
  set u := cubicSite N j
  set s := 1 + u + u ^ 2
  set c := chainForm N (Pi.single j 1) a.toAdd
  have hu : u * weyl N a = (cubeRootPow c : ℂ) • (weyl N a * u) := by
    simpa [u, c, cubicSite_def] using weyl_mul_comm N (ofAdd (Pi.single j 1)) a
  have hu2 : u ^ 2 * weyl N a = (cubeRootPow (2 * c) : ℂ) • (weyl N a * u ^ 2) := by
    rw [sq, mul_assoc, hu, mul_smul_comm, ← mul_assoc, hu, smul_mul_assoc, smul_smul,
      ← Units.val_mul, ← cubeRootPow_add, two_mul, mul_assoc (weyl N a) u u]
  have hus : u * s = s := cubicSite_mul_one_add_cubicSite N j
  have hu2s : u ^ 2 * s = s := by rw [sq, mul_assoc, hus, hus]
  have hs : s * weyl N a * s = 0 := by
    calc
      s * weyl N a * s
          = weyl N a * s + (cubeRootPow c : ℂ) • (weyl N a * (u * s)) +
              (cubeRootPow (2 * c) : ℂ) • (weyl N a * (u ^ 2 * s)) := by
            simp only [s, add_mul, one_mul, hu, hu2, smul_mul_assoc, mul_assoc]
      _ = (1 + (cubeRootPow c : ℂ) + (cubeRootPow (2 * c) : ℂ)) • (weyl N a * s) := by
            rw [hus, hu2s, add_smul, add_smul, one_smul]
      _ = 0 := by rw [one_add_cubeRootPow_add_two_mul hc, zero_smul]
  simp only [cubicProjection_def, ← show s = 1 + cubicSite N j + cubicSite N j ^ 2 from rfl,
    smul_mul_assoc, mul_smul_comm, hs, smul_zero]

/-- Adjacent projections satisfy `p_j * p_k * p_j = 3⁻¹ • p_j` when `|j - k| = 1`. -/
theorem cubicProjection_mul_cubicProjection_mul_cubicProjection {N : ℕ} {j k : Fin N}
    (h : (j : ℕ) + 1 = k ∨ (k : ℕ) + 1 = j) :
    cubicProjection N j * cubicProjection N k * cubicProjection N j =
      (3 : ℂ)⁻¹ • cubicProjection N j := by
  have hc : ∀ {r : ZMod 3}, r ≠ 0 → chainForm N (Pi.single j 1) (Pi.single k r) ≠ 0 := by
    intro r hr
    rw [chainForm_single_single]
    rcases h with hjk | hkj
    · have hne : ¬ (k : ℕ) + 1 = j := by omega
      simpa [hjk, hne] using hr
    · have hne : ¬ (j : ℕ) + 1 = k := by omega
      simpa [hkj, hne] using hr
  have h1 := cubicProjection_mul_weyl_mul_cubicProjection_eq_zero j (a := ofAdd (Pi.single k 1))
    (hc (by decide))
  have h2 := cubicProjection_mul_weyl_mul_cubicProjection_eq_zero j (a := ofAdd (Pi.single k 2))
    (hc (by decide))
  rw [cubicProjection_def N k, cubicSite_sq, cubicSite_def]
  simp only [mul_smul_comm, smul_mul_assoc, mul_add, add_mul, mul_one, h1, h2, add_zero,
    cubicProjection_mul_self]

/-- Projections at distance at least two commute. -/
theorem commute_cubicProjection {N : ℕ} {j k : Fin N}
    (h : (j : ℕ) + 2 ≤ k ∨ (k : ℕ) + 2 ≤ j) :
    Commute (cubicProjection N j) (cubicProjection N k) := by
  have hsite := commute_cubicSite (N := N) h
  have hleft : Commute (cubicProjection N j) (cubicSite N k) := by
    rw [cubicProjection_def]
    exact (((Commute.one_left _).add_left hsite).add_left (hsite.pow_left 2)).smul_left _
  rw [cubicProjection_def N k]
  exact (((Commute.one_right _).add_right hleft).add_right (hleft.pow_right 2)).smul_right _

/-- **The comparison homomorphism** `F_m : TemperleyLieb ℂ (√3 : ℂ) m →ₐ[ℂ] cubicFixed (m - 1)`
sending each generator `e j` to `√3 • cubicProjection (m - 1) j`. -/
noncomputable def cubicFixedHom (m : ℕ) :
    TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m →ₐ[ℂ] cubicFixed (m - 1) :=
  have hsq : (Real.sqrt 3 : ℂ) * (Real.sqrt 3 : ℂ) = 3 := by
    exact_mod_cast Real.mul_self_sqrt (by positivity)
  lift (fun j ↦ ⟨(Real.sqrt 3 : ℂ) • cubicProjection (m - 1) j,
      (cubicFixed (m - 1)).smul_mem (cubicProjection_mem_cubicFixed (m - 1) j) _⟩)
    (fun j ↦ Subtype.ext <| by
      simp only [Subalgebra.coe_mul, Subalgebra.coe_smul, smul_mul_smul_comm,
        cubicProjection_mul_self, smul_smul, hsq])
    (fun h ↦ Subtype.ext <| by
      simp only [Subalgebra.coe_mul]
      rw [smul_mul_smul_comm, smul_mul_smul_comm,
        cubicProjection_mul_cubicProjection_mul_cubicProjection h, smul_smul, hsq]
      congr 1
      ring)
    (fun h ↦ Subtype.ext <| by
      simpa [Subalgebra.coe_mul, smul_mul_smul_comm] using
        ((commute_cubicProjection (N := m - 1) h).smul_left (Real.sqrt 3 : ℂ)
          |>.smul_right (Real.sqrt 3 : ℂ)).eq)

theorem coe_cubicFixedHom_e (m : ℕ) (j : Fin (m - 1)) :
    (cubicFixedHom m (e (Real.sqrt 3 : ℂ) j) : CubicTorus (m - 1)) =
      (Real.sqrt 3 : ℂ) • cubicProjection (m - 1) j := by
  simp [cubicFixedHom]

@[simp]
theorem cubicFixedHom_e (m : ℕ) (j : Fin (m - 1)) :
    cubicFixedHom m (e (Real.sqrt 3 : ℂ) j) =
      ⟨(Real.sqrt 3 : ℂ) • cubicProjection (m - 1) j,
        (cubicFixed (m - 1)).smul_mem (cubicProjection_mem_cubicFixed (m - 1) j) _⟩ :=
  Subtype.ext (coe_cubicFixedHom_e m j)

/-- `cubicFixedHom m` intertwines the Temperley–Lieb analytic adjoint `star` with
`cubicAdjoint (m - 1)` in `CubicTorus (m - 1)`. -/
theorem coe_cubicFixedHom_star {m : ℕ} (x : TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m) :
    (cubicFixedHom m (star x) : CubicTorus (m - 1)) =
      cubicAdjoint (m - 1) (cubicFixedHom m x) := by
  induction x using TemperleyLieb.induction with
  | e j =>
    rw [star_e, coe_cubicFixedHom_e, map_smulₛₗ, starRingEnd_apply, Complex.star_def,
      Complex.conj_ofReal, cubicAdjoint_cubicProjection]
  | algebraMap c =>
    have hstar : star (algebraMap ℂ (TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m) c) =
        algebraMap ℂ _ (star c) := by
      rw [Algebra.algebraMap_eq_smul_one, star_smul, star_one, Algebra.algebraMap_eq_smul_one]
    rw [hstar, AlgHom.commutes, AlgHom.commutes, Algebra.algebraMap_eq_smul_one,
      Algebra.algebraMap_eq_smul_one, Subalgebra.coe_smul, Subalgebra.coe_one,
      Subalgebra.coe_smul, Subalgebra.coe_one, map_smulₛₗ, starRingEnd_apply,
      TwistedMonoidAlgebra.conjReverse_one]
  | add x y hx hy =>
    have hadd (a b) : cubicFixedHom m (a + b) = cubicFixedHom m a + cubicFixedHom m b :=
      (cubicFixedHom m).map_add' a b
    rw [star_add, hadd, hadd, Subalgebra.coe_add, Subalgebra.coe_add,
      map_add (cubicAdjoint (m - 1)), hx, hy]
  | mul x y hx hy =>
    rw [star_mul, map_mul, map_mul, Subalgebra.coe_mul, Subalgebra.coe_mul, cubicAdjoint_mul,
      hx, hy]

/-- `cubicFixedHom m` intertwines `star` with `cubicFixedAdjoint (m - 1)`. -/
@[simp]
theorem cubicFixedHom_star {m : ℕ} (x : TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m) :
    cubicFixedHom m (star x) = cubicFixedAdjoint (m - 1) (cubicFixedHom m x) :=
  Subtype.ext (coe_cubicFixedHom_star x)

/-! ### Generation of `cubicFixed N` by `cubicProjection N` and surjectivity of `cubicFixedHom` -/

/-- Symmetrized Weyl element `S(a) = W(a) + W(a⁻¹)` in `CubicTorus N`. -/
private noncomputable def symmWeyl (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) : CubicTorus N :=
  weyl N a + weyl N a⁻¹

private theorem symmWeyl_inv (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    symmWeyl N a⁻¹ = symmWeyl N a := by
  simp [symmWeyl, add_comm]

private theorem symmWeyl_one (N : ℕ) : symmWeyl N 1 = (2 : ℂ) • 1 := by
  simp [symmWeyl, two_smul]

private theorem symmWeyl_mul_symmWeyl (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    symmWeyl N a * symmWeyl N b =
      (cubicFactor N a b : ℂ) • symmWeyl N (a * b) +
        (((cubicFactor N a b)⁻¹ : ℂˣ) : ℂ) • symmWeyl N (a * b⁻¹) := by
  have hab : a⁻¹ * b⁻¹ = (a * b)⁻¹ := toAdd.injective (by ext; simp [add_comm])
  have hab' : a⁻¹ * b = (a * b⁻¹)⁻¹ := toAdd.injective (by ext; simp [add_comm])
  simp only [symmWeyl, add_mul, mul_add, weyl_mul_weyl, cubicFactor_inv_right,
    cubicFactor_inv_left, hab, hab', inv_inv, smul_add]
  abel

private theorem symmWeyl_mul_mem_of_chainForm_ne_zero {N : ℕ} {S : Subalgebra ℂ (CubicTorus N)}
    {a b : Multiplicative (Fin N → ZMod 3)}
    (ha : symmWeyl N a ∈ S) (hb : symmWeyl N b ∈ S)
    (hc : chainForm N a.toAdd b.toAdd ≠ 0) :
    symmWeyl N (a * b) ∈ S := by
  set u : ℂˣ := cubicFactor N a b
  set α : ℂ := (u : ℂ)
  set β : ℂ := ((u⁻¹ : ℂˣ) : ℂ)
  have hαβ : α * β = 1 := by
    change (u : ℂ) * ((u⁻¹ : ℂˣ) : ℂ) = 1
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hβα : β * α = 1 := by rw [mul_comm, hαβ]
  have hα3 : α ^ 3 = 1 := by
    change (cubicFactor N a b : ℂ) ^ 3 = 1
    rw [← Units.val_pow_eq_pow_val, cubicFactor, cubeRootPow_pow_three, Units.val_one]
  have hα1 : α ≠ 1 := by
    intro h1
    have hu_eq : cubicFactor N a b = 1 := Units.ext h1
    rw [cubicFactor, cubeRootPow_eq_one_iff] at hu_eq
    exact hc ((mul_eq_zero.mp hu_eq).resolve_left (by decide))
  have hba : symmWeyl N b * symmWeyl N a =
      β • symmWeyl N (a * b) + α • symmWeyl N (a * b⁻¹) := by
    have hcomm : b * a = a * b := mul_comm b a
    have hinv : b * a⁻¹ = (a * b⁻¹)⁻¹ := toAdd.injective (by ext; simp)
    rw [symmWeyl_mul_symmWeyl, cubicFactor_swap, inv_inv, hcomm, hinv, symmWeyl_inv]
  have hcomb : α • (symmWeyl N a * symmWeyl N b) + (-β) • (symmWeyl N b * symmWeyl N a) =
      (α ^ 2 - β ^ 2) • symmWeyl N (a * b) := by
    have hab := symmWeyl_mul_symmWeyl N a b
    change symmWeyl N a * symmWeyl N b =
      α • symmWeyl N (a * b) + β • symmWeyl N (a * b⁻¹) at hab
    have hc1 : -β * β = -(β ^ 2) := by ring
    have hc2 : -β * α = -1 := by linear_combination -hβα
    rw [hab, hba, smul_add, smul_add, smul_smul, smul_smul, smul_smul, smul_smul, hαβ, hc1, hc2,
      ← sq α, add_add_add_comm, ← add_smul, ← add_smul, add_neg_cancel, zero_smul, add_zero,
      ← sub_eq_add_neg]
  have hne : α ^ 2 - β ^ 2 ≠ 0 := by
    intro h0
    have hprod : (α ^ 2 - β ^ 2) * α ^ 2 = α - 1 := by
      linear_combination α * hα3 - (β * α + 1) * hβα
    rw [h0, zero_mul] at hprod
    exact hα1 (sub_eq_zero.mp hprod.symm)
  have hmem : (α ^ 2 - β ^ 2) • symmWeyl N (a * b) ∈ S := by
    rw [← hcomb]
    exact S.add_mem (S.smul_mem (S.mul_mem ha hb) α) (S.smul_mem (S.mul_mem hb ha) (-β))
  have hmem' := S.smul_mem hmem (α ^ 2 - β ^ 2)⁻¹
  rwa [smul_smul, inv_mul_cancel₀ hne, one_smul] at hmem'

private theorem symmWeyl_single_mem_adjoin (N : ℕ) (j : Fin N) (r : ZMod 3) :
    symmWeyl N (ofAdd (Pi.single j r)) ∈ Algebra.adjoin ℂ (Set.range (cubicProjection N)) := by
  let S : Subalgebra ℂ (CubicTorus N) := Algebra.adjoin ℂ (Set.range (cubicProjection N))
  have hp : symmWeyl N (ofAdd (Pi.single j 1)) ∈ S := by
    have hneg : (-1 : ZMod 3) = 2 := by decide
    have h1 : (1 : CubicTorus N) + (-1 : ℂ) • (1 : CubicTorus N) = 0 := by
      nth_rw 1 [← one_smul ℂ (1 : CubicTorus N)]
      rw [← add_smul, add_neg_cancel, zero_smul]
    have heq : symmWeyl N (ofAdd (Pi.single j 1)) =
        (3 : ℂ) • cubicProjection N j + (-1 : ℂ) • (1 : CubicTorus N) := by
      rw [symmWeyl, ← ofAdd_neg, ← Pi.single_neg, hneg, ← cubicSite_sq, ← cubicSite_def,
        cubicProjection_def, smul_smul, mul_inv_cancel₀ (by norm_num), one_smul,
        add_right_comm (1 + cubicSite N j) (cubicSite N j ^ 2), add_right_comm 1 (cubicSite N j),
        h1, zero_add]
    rw [heq]
    exact S.add_mem (S.smul_mem (Algebra.subset_adjoin (Set.mem_range_self j)) (3 : ℂ))
      (S.smul_mem S.one_mem (-1 : ℂ))
  rcases zmod3_cases r with rfl | rfl | rfl
  · rw [Pi.single_zero, ofAdd_zero, symmWeyl_one]
    exact S.smul_mem S.one_mem (2 : ℂ)
  · exact hp
  · have hneg : (-1 : ZMod 3) = 2 := by decide
    simpa [← hneg, Pi.single_neg, ofAdd_neg, symmWeyl_inv] using hp

private theorem chainForm_prefix_single {N m : ℕ} (hm : m + 1 < N)
    {y : Multiplicative (Fin N → ZMod 3)} (hy : ∀ i : Fin N, m + 1 ≤ (i : ℕ) → y.toAdd i = 0)
    (r : ZMod 3) :
    chainForm N y.toAdd (Pi.single ⟨m + 1, hm⟩ r) = y.toAdd ⟨m, by omega⟩ * r := by
  rw [chainForm_eq_sub, halfChainForm_single_right, halfChainForm_single_left]
  have hright : (∑ j : Fin N,
      if (⟨m + 1, hm⟩ : Fin N).val + 1 = (j : ℕ) then r * y.toAdd j else 0) = 0 := by
    refine Finset.sum_eq_zero fun j _ ↦ ?_
    simp only
    split_ifs with hj
    · rw [hy j (by omega), mul_zero]
    · rfl
  rw [hright, sub_zero, Fintype.sum_eq_single (⟨m, by omega⟩ : Fin N)]
  · simp
  · intro i hi
    simp only
    split_ifs with hval
    · exact absurd (Fin.ext (by simp; omega)) hi
    · rfl

/-- Inductive elimination step for `symmWeyl_mem_adjoin_of_support`: assuming all elements supported
in `< m + 1` belong to `adjoin (range (cubicProjection N))`, right-multiplying such an element `y`
by a nonzero single-site element at `m + 1` stays in the adjoin. -/
private theorem symmWeyl_mul_single_mem_adjoin_of_prefix {N m : ℕ} (hm : m + 1 < N)
    (ih : ∀ z : Multiplicative (Fin N → ZMod 3),
      (∀ i : Fin N, m + 1 ≤ (i : ℕ) → z.toAdd i = 0) →
      symmWeyl N z ∈ Algebra.adjoin ℂ (Set.range (cubicProjection N)))
    {y : Multiplicative (Fin N → ZMod 3)}
    (hy : ∀ i : Fin N, m + 1 ≤ (i : ℕ) → y.toAdd i = 0)
    {r : ZMod 3} (hr : r ≠ 0) :
    symmWeyl N (y * ofAdd (Pi.single ⟨m + 1, hm⟩ r)) ∈
      Algebra.adjoin ℂ (Set.range (cubicProjection N)) := by
  let S : Subalgebra ℂ (CubicTorus N) := Algebra.adjoin ℂ (Set.range (cubicProjection N))
  let jk : Fin N := ⟨m + 1, hm⟩
  let jm : Fin N := ⟨m, by omega⟩
  have hstep : ∀ (z : Multiplicative (Fin N → ZMod 3)) (s : ZMod 3),
      (∀ i : Fin N, m + 1 ≤ (i : ℕ) → z.toAdd i = 0) → z.toAdd jm ≠ 0 → s ≠ 0 →
      symmWeyl N (z * ofAdd (Pi.single jk s)) ∈ S := fun z s hz hzm hs ↦
    symmWeyl_mul_mem_of_chainForm_ne_zero (ih z hz) (symmWeyl_single_mem_adjoin N jk s)
      (by rw [toAdd_ofAdd, chainForm_prefix_single hm hz]; exact mul_ne_zero hzm hs)
  by_cases hym : y.toAdd jm = 0
  · let em : Multiplicative (Fin N → ZMod 3) := ofAdd (Pi.single jm 1)
    let b := y * em
    let c := em⁻¹ * ofAdd (Pi.single jk r)
    let y' := y * ofAdd (Pi.single jm 2)
    have hbc : b * c = y * ofAdd (Pi.single jk r) :=
      toAdd.injective (by ext; simp [b, c])
    have hbcinv : b * c⁻¹ = y' * ofAdd (Pi.single jk (-r)) :=
      toAdd.injective (by ext i; simp [b, c, y', em, Pi.single_apply]; split_ifs <;> ring)
    have hb_mem : symmWeyl N b ∈ S := ih b fun i hi ↦ by
      have hne : i ≠ jm := fun h ↦ by subst h; simp [jm] at hi
      simp [b, em, Pi.single_eq_of_ne hne, hy i hi]
    have hc_mem : symmWeyl N c ∈ S := hstep em⁻¹ r (fun i hi ↦ by
      have hne : i ≠ jm := fun h ↦ by subst h; simp [jm] at hi
      simp [em, Pi.single_eq_of_ne hne]) (by simp [em]) hr
    have hy'_mem : symmWeyl N (b * c⁻¹) ∈ S := hbcinv ▸ hstep y' (-r) (fun i hi ↦ by
      have hne : i ≠ jm := fun h ↦ by subst h; simp [jm] at hi
      simp [y', Pi.single_eq_of_ne hne, hy i hi])
      (by simp only [y', toAdd_mul, toAdd_ofAdd, Pi.add_apply, hym, zero_add, Pi.single_eq_same,
        ne_eq]; decide)
      (neg_ne_zero.mpr hr)
    set γ : ℂ := (((cubicFactor N b c)⁻¹ : ℂˣ) : ℂ)
    have hcomb : symmWeyl N b * symmWeyl N c + (-γ) • symmWeyl N (b * c⁻¹) =
        (cubicFactor N b c : ℂ) • symmWeyl N (y * ofAdd (Pi.single jk r)) := by
      rw [symmWeyl_mul_symmWeyl N b c, hbc, add_assoc, ← add_smul, add_neg_cancel, zero_smul,
        add_zero]
    have hsub : (cubicFactor N b c : ℂ) • symmWeyl N (y * ofAdd (Pi.single jk r)) ∈ S := by
      rw [← hcomb]
      exact S.add_mem (S.mul_mem hb_mem hc_mem) (S.smul_mem hy'_mem (-γ))
    have hres := S.smul_mem hsub γ
    rwa [smul_smul, show γ * (cubicFactor N b c : ℂ) = 1 by
      change (((cubicFactor N b c)⁻¹ : ℂˣ) : ℂ) * (cubicFactor N b c : ℂ) = 1
      rw [← Units.val_mul, inv_mul_cancel, Units.val_one], one_smul] at hres
  · exact hstep y r hy hym hr

private theorem symmWeyl_mem_adjoin_of_support (N k : ℕ) :
    ∀ (a : Multiplicative (Fin N → ZMod 3)),
      (∀ i : Fin N, k ≤ (i : ℕ) → a.toAdd i = 0) →
      symmWeyl N a ∈ Algebra.adjoin ℂ (Set.range (cubicProjection N)) := by
  induction k with
  | zero =>
    intro a ha
    let S : Subalgebra ℂ (CubicTorus N) := Algebra.adjoin ℂ (Set.range (cubicProjection N))
    have ha1 : a = 1 := toAdd.injective (funext fun i ↦ ha i (Nat.zero_le _))
    rw [ha1, symmWeyl_one]
    exact S.smul_mem S.one_mem (2 : ℂ)
  | succ k ih =>
    intro a ha
    by_cases hkN : k < N
    · let jk : Fin N := ⟨k, hkN⟩
      set r := a.toAdd jk
      by_cases hr : r = 0
      · refine ih a fun i hi ↦ ?_
        rcases eq_or_lt_of_le hi with hval | hlt
        · have hij : i = jk := Fin.ext hval.symm
          exact hij ▸ hr
        · exact ha i hlt
      · let d : Multiplicative (Fin N → ZMod 3) := ofAdd (Pi.single jk r)
        let y : Multiplicative (Fin N → ZMod 3) := a * d⁻¹
        have hayd : a = y * d := by simp [y]
        have hy : ∀ i : Fin N, k ≤ (i : ℕ) → y.toAdd i = 0 := by
          intro i hi
          rcases eq_or_lt_of_le hi with hval | hlt
          · have hij : i = jk := Fin.ext hval.symm
            subst hij
            simp [y, d, r]
          · have hne : i ≠ jk := fun h ↦ by subst h; exact Nat.lt_irrefl _ hlt
            simp [y, d, Pi.single_eq_of_ne hne, ha i hlt]
        rw [hayd]
        rcases k with _ | m
        · have hy1 : y = 1 := toAdd.injective (funext fun i ↦ hy i (Nat.zero_le _))
          rw [hy1, one_mul]
          exact symmWeyl_single_mem_adjoin N jk r
        · exact symmWeyl_mul_single_mem_adjoin_of_prefix hkN ih hy hr
    · exact ih a fun i _ ↦ absurd i.isLt (by omega)

/-- **The projections `cubicProjection N` generate `cubicFixed N`** as a `ℂ`-algebra. -/
theorem adjoin_range_cubicProjection (N : ℕ) :
    Algebra.adjoin ℂ (Set.range (cubicProjection N)) = cubicFixed N := by
  let S : Subalgebra ℂ (CubicTorus N) := Algebra.adjoin ℂ (Set.range (cubicProjection N))
  refine le_antisymm ?_ ?_
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    exact cubicProjection_mem_cubicFixed N j
  · intro x hx
    have hsymm : ∀ z : CubicTorus N, z + cubicInversion N z ∈ S := by
      intro z
      induction (TwistedMonoidAlgebra.basis ℂ (Multiplicative (Fin N → ZMod 3))
          (cubicFactor N)).mem_span z using Submodule.span_induction with
      | mem w hw =>
        obtain ⟨a, rfl⟩ := hw
        rw [TwistedMonoidAlgebra.basis_apply, ← weyl_def, cubicInversion_weyl]
        exact symmWeyl_mem_adjoin_of_support N N a fun i hi ↦ absurd i.isLt (not_lt.mpr hi)
      | zero => simp [S.zero_mem]
      | add y w _ _ hy hw =>
        rw [map_add, add_add_add_comm]
        exact S.add_mem hy hw
      | smul c y _ hy =>
        rw [map_smul, ← smul_add]
        exact S.smul_mem hy c
    have hx2 := hsymm x
    rw [mem_cubicFixed_iff.mp hx, ← two_smul ℂ x] at hx2
    have hres := S.smul_mem hx2 (2 : ℂ)⁻¹
    rwa [smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul] at hres

/-- **Surjectivity of `cubicFixedHom`.** For every `m : ℕ` (including `m = 0`), the comparison
homomorphism `TemperleyLieb ℂ (√3 : ℂ) m →ₐ[ℂ] cubicFixed (m - 1)` is surjective. -/
theorem cubicFixedHom_surjective (m : ℕ) : Function.Surjective (cubicFixedHom m) := by
  have hsqrt : (Real.sqrt 3 : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (by positivity)).ne'
  let Φ : TemperleyLieb ℂ (Real.sqrt 3 : ℂ) m →ₐ[ℂ] CubicTorus (m - 1) :=
    (cubicFixed (m - 1)).val.comp (cubicFixedHom m)
  have hrange : Φ.range = cubicFixed (m - 1) := by
    rw [← Algebra.map_top, ← adjoin_range_e, AlgHom.map_adjoin, ← Set.range_comp]
    let S₁ : Subalgebra ℂ (CubicTorus (m - 1)) :=
      Algebra.adjoin ℂ (Set.range (Φ ∘ e (Real.sqrt 3 : ℂ)))
    let S₂ : Subalgebra ℂ (CubicTorus (m - 1)) :=
      Algebra.adjoin ℂ (Set.range (cubicProjection (m - 1)))
    have hadj : S₁ = S₂ := by
      refine le_antisymm (Algebra.adjoin_le_iff.mpr ?_) (Algebra.adjoin_le_iff.mpr ?_)
      · rintro _ ⟨j, rfl⟩
        simp only [Function.comp_apply, Φ, AlgHom.comp_apply, Subalgebra.coe_val,
          coe_cubicFixedHom_e]
        exact S₂.smul_mem (Algebra.subset_adjoin (Set.mem_range_self j)) (Real.sqrt 3 : ℂ)
      · rintro _ ⟨j, rfl⟩
        have hj0 : (Φ ∘ e (Real.sqrt 3 : ℂ)) j ∈ S₁ :=
          Algebra.subset_adjoin (Set.mem_range_self j)
        simp only [Function.comp_apply, Φ, AlgHom.comp_apply, Subalgebra.coe_val,
          coe_cubicFixedHom_e] at hj0
        have hres := S₁.smul_mem hj0 (Real.sqrt 3 : ℂ)⁻¹
        rwa [smul_smul, inv_mul_cancel₀ hsqrt, one_smul] at hres
    change S₁ = _
    rw [hadj]
    exact adjoin_range_cubicProjection (m - 1)
  intro y
  obtain ⟨x, hx⟩ : (y : CubicTorus (m - 1)) ∈ Φ.range := hrange.symm ▸ y.2
  exact ⟨x, Subtype.ext hx⟩

end TauCeti.TemperleyLieb
