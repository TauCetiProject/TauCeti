module

public import TauCeti.Algebra.CentralSimple.Splitting
import Mathlib.LinearAlgebra.LinearIndependent.BaseChange
import Mathlib.LinearAlgebra.Matrix.StdBasis

/-!
# Finite separable splitting fields

Every finite-dimensional central simple algebra over a field has a finite separable splitting
field.  The separable closure splits the algebra, and a matrix presentation there uses only
finitely many coefficients.  Adjoining those coefficients to the base field produces the desired
finite separable extension.

Concretely, fix a basis of the algebra and pull the standard matrix units back along a splitting
over the separable closure.  Their coordinates generate a finite intermediate field `L`.  The same
coordinate formulas give elements of `L ⊗[K] A`; after extending scalars back to the separable
closure they are the original matrix units.  They are therefore linearly independent, and the
dimension count makes them a basis.  The matrix-unit multiplication laws descend along the
injective coefficient embedding and upgrade the resulting linear equivalence to an algebra
equivalence.

## Main result

* `TauCeti.Algebra.exists_isSplittingField_finiteDimensional_isSeparable`: every
  finite-dimensional central simple algebra has a finite separable splitting field.

## References

See P. Gille and T. Szamuely, *Central Simple Algebras and Galois Cohomology*, Section 2.2,
and R. S. Pierce, *Associative Algebras*, Chapter 13.
-/

public section

namespace TauCeti

open Module
open scoped TensorProduct

universe u

namespace Algebra

variable (K : Type u) [Field K] (A : Type u) [Ring A] [Algebra K A]
  [Algebra.IsCentral K A] [IsSimpleRing A] [FiniteDimensional K A]

/-- The finite family of coefficients needed to descend a chosen splitting over the separable
closure.  It consists of the coordinates, in a base-changed basis of `A`, of the inverse images of
the standard matrix units. -/
private noncomputable def splittingCoefficients
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Fin (deg K A) × Fin (deg K A) × Fin (finrank K A) → SeparableClosure K :=
  fun q ↦ ((Module.finBasis K A).baseChange (SeparableClosure K)).repr
    (e.symm (Matrix.single q.1 q.2.1 1)) q.2.2

/-- The intermediate field generated by the coefficients of the pulled-back matrix units. -/
private noncomputable def finiteSplittingField
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    IntermediateField K (SeparableClosure K) :=
  IntermediateField.adjoin K (Set.range (splittingCoefficients K A e))

private noncomputable instance finiteSplittingField.finiteDimensional
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    FiniteDimensional K (finiteSplittingField K A e) := by
  apply IntermediateField.finiteDimensional_adjoin
  intro x hx
  exact (Algebra.IsSeparable.isSeparable K x).isIntegral

private noncomputable instance finiteSplittingField.isSeparable
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Algebra.IsSeparable K (finiteSplittingField K A e) := by
  rw [finiteSplittingField, IntermediateField.isSeparable_adjoin_iff_isSeparable]
  rintro _ ⟨q, rfl⟩
  exact Algebra.IsSeparable.isSeparable K (splittingCoefficients K A e q)

variable {K A}

private noncomputable def descendedCoefficient
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (q : Fin (deg K A) × Fin (deg K A) × Fin (finrank K A)) :
    finiteSplittingField K A e :=
  ⟨splittingCoefficients K A e q, by
    apply IntermediateField.subset_adjoin K
    exact Set.mem_range_self q⟩

/-- The pulled-back `(i,j)` matrix unit with all its coefficients regarded as elements of the
finite intermediate field they generate. -/
private noncomputable def descendedMatrixUnit
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (i j : Fin (deg K A)) : finiteSplittingField K A e ⊗[K] A :=
  ∑ k : Fin (finrank K A), descendedCoefficient e (i, j, k) ⊗ₜ
    (Module.finBasis K A) k

/-- Extend coefficients from the finite field generated by the matrix-unit coordinates back to the
separable closure. -/
private noncomputable def extendToSeparableClosure
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    finiteSplittingField K A e ⊗[K] A →ₗ[finiteSplittingField K A e]
      SeparableClosure K ⊗[K] A :=
  TensorProduct.AlgebraTensorModule.map
    (Algebra.ofId (finiteSplittingField K A e) (SeparableClosure K)).toLinearMap
    (LinearMap.id (R := K) (M := A))

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
@[simp]
private theorem extendToSeparableClosure_tmul
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (x : finiteSplittingField K A e) (a : A) :
    extendToSeparableClosure e (x ⊗ₜ a) = (x : SeparableClosure K) ⊗ₜ a := rfl

/-- The ring homomorphism underlying coefficient extension. -/
private noncomputable def extendToSeparableClosureRingHom
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    (finiteSplittingField K A e ⊗[K] A) →+* (SeparableClosure K ⊗[K] A) :=
  (Algebra.TensorProduct.map
    (Algebra.ofId (finiteSplittingField K A e) (SeparableClosure K))
    (AlgHom.id K A)).toRingHom

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
@[simp]
private theorem extendToSeparableClosureRingHom_tmul
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (x : finiteSplittingField K A e) (a : A) :
    extendToSeparableClosureRingHom e (x ⊗ₜ a) =
      (x : SeparableClosure K) ⊗ₜ a := rfl

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
private theorem extendToSeparableClosure_eq_ringHom
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (x : finiteSplittingField K A e ⊗[K] A) :
    extendToSeparableClosure e x = extendToSeparableClosureRingHom e x := by
  refine TensorProduct.induction_on x ?_ ?_ ?_
  · simp
  · intro a b
    rw [extendToSeparableClosure_tmul, extendToSeparableClosureRingHom_tmul]
  · intro x y hx hy
    calc
      extendToSeparableClosure e (x + y) =
          extendToSeparableClosure e x + extendToSeparableClosure e y :=
        (extendToSeparableClosure e).map_add x y
      _ = extendToSeparableClosureRingHom e x +
          extendToSeparableClosureRingHom e y := congrArg₂ (· + ·) hx hy
      _ = extendToSeparableClosureRingHom e (x + y) :=
        (extendToSeparableClosureRingHom e).map_add x y |>.symm

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
private theorem extendToSeparableClosure_one
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    extendToSeparableClosure e 1 = 1 := by
  rw [extendToSeparableClosure_eq_ringHom]
  exact (extendToSeparableClosureRingHom e).map_one

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
private theorem extendToSeparableClosure_mul
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (x y : finiteSplittingField K A e ⊗[K] A) :
    extendToSeparableClosure e (x * y) =
      extendToSeparableClosure e x * extendToSeparableClosure e y := by
  rw [extendToSeparableClosure_eq_ringHom,
    extendToSeparableClosure_eq_ringHom, extendToSeparableClosure_eq_ringHom]
  exact (extendToSeparableClosureRingHom e).map_mul x y

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
@[simp]
private theorem extendToSeparableClosure_descendedMatrixUnit
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (i j : Fin (deg K A)) :
    extendToSeparableClosure e (descendedMatrixUnit e i j) =
      e.symm (Matrix.single i j 1) := by
  rw [descendedMatrixUnit, map_sum]
  simp_rw [extendToSeparableClosure_tmul]
  rw [← ((Module.finBasis K A).baseChange (SeparableClosure K)).sum_repr
    (e.symm (Matrix.single i j 1))]
  apply Finset.sum_congr rfl
  intro k _
  rw [show (descendedCoefficient e (i, j, k) : SeparableClosure K) =
      splittingCoefficients K A e (i, j, k) from rfl]
  simp [splittingCoefficients, Basis.baseChange_apply, TensorProduct.smul_tmul']

omit [Algebra.IsCentral K A] [IsSimpleRing A] in
/-- The descended matrix units are linearly independent.  Their images in the separable closure
are the inverse images of the standard matrix basis under an algebra equivalence. -/
private theorem linearIndependent_descendedMatrixUnit
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    LinearIndependent (finiteSplittingField K A e)
      (fun q : Fin (deg K A) × Fin (deg K A) ↦ descendedMatrixUnit e q.1 q.2) := by
  apply LinearIndependent.of_comp (extendToSeparableClosure e)
  rw [show (extendToSeparableClosure e) ∘
      (fun q : Fin (deg K A) × Fin (deg K A) ↦ descendedMatrixUnit e q.1 q.2) =
      fun q ↦ e.symm (Matrix.single q.1 q.2 1) by
        funext q
        exact extendToSeparableClosure_descendedMatrixUnit e q.1 q.2]
  have h : LinearIndependent (SeparableClosure K)
      (fun q : Fin (deg K A) × Fin (deg K A) ↦ e.symm (Matrix.single q.1 q.2 1)) := by
    have h' := (Matrix.stdBasis (SeparableClosure K)
      (Fin (deg K A)) (Fin (deg K A))).linearIndependent.map'
      e.symm.toLinearMap (LinearMap.ker_eq_bot_of_injective e.symm.injective)
    rw [show e.symm.toLinearMap ∘ ⇑(Matrix.stdBasis (SeparableClosure K)
        (Fin (deg K A)) (Fin (deg K A))) =
        fun q ↦ e.symm (Matrix.single q.1 q.2 1) by
      funext q
      rw [Function.comp_apply, Matrix.stdBasis_eq_single]
      rfl] at h'
    exact h'
  exact h.restrict_scalars' (finiteSplittingField K A e)

/-- The descended matrix units form a basis, since their number is the dimension of the scalar
extension. -/
private noncomputable def descendedMatrixUnitBasis
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Basis (Fin (deg K A) × Fin (deg K A)) (finiteSplittingField K A e)
      (finiteSplittingField K A e ⊗[K] A) :=
  basisOfLinearIndependentOfCardEqFinrank'
    (fun q : Fin (deg K A) × Fin (deg K A) ↦ descendedMatrixUnit e q.1 q.2)
    (linearIndependent_descendedMatrixUnit e) (by
      rw [Fintype.card_prod, Fintype.card_fin,
        Module.finrank_baseChange (R := finiteSplittingField K A e) (S := K) (M' := A),
        ← deg_sq, pow_two])

/-- The linear equivalence which sends each standard matrix unit to its descended counterpart. -/
private noncomputable def descendedMatrixLinearEquiv
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Matrix (Fin (deg K A)) (Fin (deg K A))
        (finiteSplittingField K A e) ≃ₗ[finiteSplittingField K A e]
      finiteSplittingField K A e ⊗[K] A :=
  (Matrix.stdBasis (finiteSplittingField K A e) (Fin (deg K A)) (Fin (deg K A))).equiv
    (descendedMatrixUnitBasis e) (Equiv.refl _)

@[simp]
private theorem descendedMatrixLinearEquiv_single
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (i j : Fin (deg K A)) :
    descendedMatrixLinearEquiv e (Matrix.single i j 1) = descendedMatrixUnit e i j := by
  rw [← Matrix.stdBasis_eq_single]
  simp [descendedMatrixLinearEquiv, descendedMatrixUnitBasis]

/-- Extending the descended linear equivalence to the separable closure recovers the inverse of
the chosen splitting, after applying the coefficient embedding entrywise. -/
private theorem extend_descendedMatrixLinearEquiv
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K))
    (x : Matrix (Fin (deg K A)) (Fin (deg K A)) (finiteSplittingField K A e)) :
    extendToSeparableClosure e (descendedMatrixLinearEquiv e x) =
      e.symm ((Algebra.ofId (finiteSplittingField K A e) (SeparableClosure K)).mapMatrix x) := by
  let f : Matrix (Fin (deg K A)) (Fin (deg K A)) (finiteSplittingField K A e) →ₗ[
      finiteSplittingField K A e] SeparableClosure K ⊗[K] A :=
    (extendToSeparableClosure e).comp (descendedMatrixLinearEquiv e).toLinearMap
  let g : Matrix (Fin (deg K A)) (Fin (deg K A)) (finiteSplittingField K A e) →ₗ[
      finiteSplittingField K A e] SeparableClosure K ⊗[K] A :=
    (e.symm.toLinearMap.restrictScalars (finiteSplittingField K A e)).comp
      ((Algebra.ofId (finiteSplittingField K A e)
        (SeparableClosure K)).mapMatrix).toLinearMap
  have hfg : f = g := by
    apply (Matrix.stdBasis (finiteSplittingField K A e)
      (Fin (deg K A)) (Fin (deg K A))).ext
    rintro ⟨i, j⟩
    simp only [f, g, LinearMap.comp_apply, LinearMap.coe_restrictScalars]
    rw [Matrix.stdBasis_eq_single]
    change extendToSeparableClosure e
        (descendedMatrixLinearEquiv e (Matrix.single i j 1)) =
      e.symm ((Algebra.ofId (finiteSplittingField K A e)
        (SeparableClosure K)).mapMatrix (Matrix.single i j 1))
    rw [descendedMatrixLinearEquiv_single, extendToSeparableClosure_descendedMatrixUnit]
    congr 1
    ext r s
    by_cases hri : r = i <;> by_cases hsj : s = j <;>
      simp [AlgHom.mapMatrix_apply, Matrix.single_apply, hri, hsj]
  exact LinearMap.congr_fun hfg x

/-- The coefficient-extension map is injective.  Its composite with the descended matrix linear
equivalence is a composite of two injective maps. -/
private theorem extendToSeparableClosure_injective
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Function.Injective (extendToSeparableClosure e) := by
  intro x y hxy
  obtain ⟨x, rfl⟩ := (descendedMatrixLinearEquiv e).surjective x
  obtain ⟨y, rfl⟩ := (descendedMatrixLinearEquiv e).surjective y
  rw [extend_descendedMatrixLinearEquiv, extend_descendedMatrixLinearEquiv] at hxy
  congr 1
  apply Matrix.ext
  intro i j
  apply Subtype.ext
  exact congr_fun (congr_fun (e.symm.injective hxy) i) j

/-- The descended linear equivalence preserves multiplication and the identity because this is true
after the injective extension back to the separable closure. -/
private noncomputable def descendedMatrixAlgEquiv
    (e : SeparableClosure K ⊗[K] A ≃ₐ[SeparableClosure K]
      Matrix (Fin (deg K A)) (Fin (deg K A)) (SeparableClosure K)) :
    Matrix (Fin (deg K A)) (Fin (deg K A))
        (finiteSplittingField K A e) ≃ₐ[finiteSplittingField K A e]
      finiteSplittingField K A e ⊗[K] A :=
  AlgEquiv.ofLinearEquiv (descendedMatrixLinearEquiv e)
    (extendToSeparableClosure_injective e <| by
      calc
        extendToSeparableClosure e (descendedMatrixLinearEquiv e 1) =
            e.symm ((Algebra.ofId (finiteSplittingField K A e)
              (SeparableClosure K)).mapMatrix 1) := extend_descendedMatrixLinearEquiv e 1
        _ = e.symm 1 := congrArg e.symm (map_one _)
        _ = 1 := e.symm.map_one
        _ = extendToSeparableClosure e 1 := (extendToSeparableClosure_one e).symm)
    (fun x y ↦ extendToSeparableClosure_injective e <| by
      calc
        extendToSeparableClosure e (descendedMatrixLinearEquiv e (x * y)) =
            e.symm ((Algebra.ofId (finiteSplittingField K A e)
              (SeparableClosure K)).mapMatrix (x * y)) :=
          extend_descendedMatrixLinearEquiv e (x * y)
        _ = e.symm ((Algebra.ofId (finiteSplittingField K A e)
              (SeparableClosure K)).mapMatrix x) *
            e.symm ((Algebra.ofId (finiteSplittingField K A e)
              (SeparableClosure K)).mapMatrix y) := by
          rw [map_mul, map_mul]
        _ = extendToSeparableClosure e (descendedMatrixLinearEquiv e x) *
            extendToSeparableClosure e (descendedMatrixLinearEquiv e y) := by
          rw [extend_descendedMatrixLinearEquiv, extend_descendedMatrixLinearEquiv]
        _ = extendToSeparableClosure e
            (descendedMatrixLinearEquiv e x * descendedMatrixLinearEquiv e y) :=
          (extendToSeparableClosure_mul e _ _).symm)

/-- **Every finite-dimensional central simple algebra has a finite separable splitting field.**

The field is an intermediate field of a separable closure, generated by the finitely many
coefficients of matrix units in a splitting over that closure.  The result gives both finiteness
and separability as typeclass witnesses, together with the splitting predicate. -/
theorem exists_isSplittingField_finiteDimensional_isSeparable :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ Algebra.IsSeparable K L ∧ IsSplittingField K A L := by
  let e := Classical.choice
    (isSplittingField_of_isSepClosed K A (SeparableClosure K)).nonempty_algEquiv_matrix_deg
  let L := finiteSplittingField K A e
  refine ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, ?_⟩
  exact (isSplittingField_iff K A L).2
    ⟨deg K A, ⟨(descendedMatrixAlgEquiv e).symm⟩⟩

end Algebra

