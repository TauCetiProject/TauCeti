module

public import Mathlib.Algebra.BigOperators.Ring.Finset
public import Mathlib.Algebra.Field.Basic
public import Mathlib.Algebra.Polynomial.Inductions
public import Mathlib.Algebra.Ring.Action.ConjAct
public import Mathlib.Algebra.Ring.Subring.Pointwise
public import Mathlib.Tactic.NoncommRing

/-!
# Finite polynomial replacement

Let `x, z` be nonzero elements of a division ring `D` and `C` a subring of `D` normalized by
`x` and `z`. Suppose that two exchange relations

```
z* · z  = n₀ + ∑ₐ x ^ nₐ · cₐ,
z** · z = (x*) ^ N · m₀ + ∑ₐ (x*) ^ (N - nₐ) · dₐ
```

are given, whose leading terms are proportional, `φ · n₀ = m₀` with `φ ∈ C`, and whose
remaining terms are related by `dₐ = gₐ · (x ^ nₐ)⁻¹ φ x ^ nₐ · cₐ`. If moreover each defect
`(x*) ^ nₐ · x ^ nₐ - gₐ` lies in `z · C[z]`, then `z**` is the explicit element
`(x*) ^ N φ z*` minus a sum of corrections, and lies in every subring containing
`C`, `x*`, `z*` and `z`. Here `C[z]` is the subring generated by `C` and `z`.

This is the local algebraic step that expresses the cluster variable obtained by two
consecutive mutations in interacting directions through the variables of the intermediate
seeds. It is stated without reference to seeds, with left coefficients and in an arbitrary
division ring, so that it applies to classical and quantum exchange relations alike.

## Main results

* `TauCeti.finiteReplacement_eq`: the explicit formula for `z**`.
* `TauCeti.finiteReplacement_mem`: `z**` lies in every subring containing `C`, `x*`, `z*`
  and `z`.
* `TauCeti.scalarReplacement_eq` and `TauCeti.binaryReplacement_eq`,
  `TauCeti.binaryReplacement_mem`: the cases with no, respectively exactly one, interacting
  term.
* `TauCeti.polynomialReplacement_mem`: the commutative instance for two exchange relations
  `x z = P(y)` and `y w = Q(x)` with polynomial right-hand sides, in which the defects are
  computed from `Polynomial.divX (P ^ a)`.

## References

* A. Berenstein, S. Fomin, A. Zelevinsky, *Cluster algebras III: Upper bounds and double
  Bruhat cells*, Lemma 4.6.
* A. Berenstein, A. Zelevinsky, *Quantum cluster algebras*, Lemma 5.8.
-/

public section

open Polynomial
open scoped Pointwise

namespace TauCeti

section DivisionRing

variable {D ι : Type*} [DivisionRing D]

/-- One summand of the finite replacement: multiplying out the defect
`(x*) ^ n · x ^ n - g` recovers the difference of the two exchange terms. -/
private theorem replacement_term {x xs φ g c : D} {n N : ℕ} (hx : x ≠ 0) (hn : n ≤ N) :
    xs ^ N * φ * (x ^ n * c) -
        xs ^ (N - n) * (xs ^ n * x ^ n - g) * ((x ^ n)⁻¹ * φ * x ^ n) * c =
      xs ^ (N - n) * (g * ((x ^ n)⁻¹ * φ * x ^ n) * c) := by
  have hu : x ^ n * ((x ^ n)⁻¹ * φ * x ^ n) = φ * x ^ n := by
    rw [← mul_assoc, ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero n hx), one_mul]
  have e : xs ^ (N - n) * (xs ^ n * x ^ n - g) * ((x ^ n)⁻¹ * φ * x ^ n) * c =
      xs ^ (N - n) * xs ^ n * (x ^ n * ((x ^ n)⁻¹ * φ * x ^ n)) * c -
        xs ^ (N - n) * (g * ((x ^ n)⁻¹ * φ * x ^ n) * c) := by
    noncomm_ring
  rw [e, hu, ← pow_sub_mul_pow xs hn]
  noncomm_ring

/-- **Finite polynomial replacement.** If `z* · z` and `z** · z` are given by two exchange
relations whose leading terms satisfy `φ · n₀ = m₀` and whose remaining terms satisfy
`dₐ = gₐ · (x ^ nₐ)⁻¹ φ x ^ nₐ · cₐ`, then `z**` is `(x*) ^ N φ z*` minus the sum of the
corrections `(x*) ^ (N - nₐ) ((x*) ^ nₐ x ^ nₐ - gₐ) (x ^ nₐ)⁻¹ φ x ^ nₐ cₐ`, multiplied by
`z⁻¹` on the right. -/
theorem finiteReplacement_eq {x z xs zs zss φ n₀ m₀ : D} {N : ℕ} {s : Finset ι}
    {n : ι → ℕ} {c d g : ι → D} (hx : x ≠ 0) (hz : z ≠ 0) (hN : ∀ a ∈ s, n a ≤ N)
    (hm₀ : φ * n₀ = m₀) (hzs : zs * z = n₀ + ∑ a ∈ s, x ^ n a * c a)
    (hzss : zss * z = xs ^ N * m₀ + ∑ a ∈ s, xs ^ (N - n a) * d a)
    (hd : ∀ a ∈ s, d a = g a * ((x ^ n a)⁻¹ * φ * x ^ n a) * c a) :
    zss = xs ^ N * φ * zs - (∑ a ∈ s, xs ^ (N - n a) * (xs ^ n a * x ^ n a - g a) *
      ((x ^ n a)⁻¹ * φ * x ^ n a) * c a) * z⁻¹ := by
  have key : zss * z = xs ^ N * φ * zs * z - ∑ a ∈ s, xs ^ (N - n a) *
      (xs ^ n a * x ^ n a - g a) * ((x ^ n a)⁻¹ * φ * x ^ n a) * c a := by
    rw [hzss, mul_assoc (xs ^ N * φ), hzs, mul_add, ← hm₀, Finset.mul_sum, add_sub_assoc,
      ← Finset.sum_sub_distrib, mul_assoc]
    congr 1
    refine Finset.sum_congr rfl fun a ha ↦ ?_
    rw [hd a ha, replacement_term hx (hN a ha)]
  rw [← mul_inv_cancel_right₀ hz zss, key, sub_mul, mul_inv_cancel_right₀ hz]

/-- **Finite polynomial replacement, membership.** Under the hypotheses of
`finiteReplacement_eq`, if `x` and `z` normalize a subring `C` containing `φ` and every `cₐ`,
and each defect `(x*) ^ nₐ x ^ nₐ - gₐ` lies in `z · C[z]`, then `z**` lies in every subring
containing `C`, `x*`, `z*` and `z`. -/
theorem finiteReplacement_mem {C H : Subring D} {x z xs zs zss φ n₀ m₀ : D} {N : ℕ}
    {s : Finset ι} {n : ι → ℕ} {c d g : ι → D} (hx : x ≠ 0) (hz : z ≠ 0)
    (hxC : ∀ b ∈ C, x⁻¹ * b * x ∈ C) (hzC : ∀ b ∈ C, z * b * z⁻¹ ∈ C) (hφ : φ ∈ C)
    (hc : ∀ a ∈ s, c a ∈ C) (hN : ∀ a ∈ s, n a ≤ N) (hm₀ : φ * n₀ = m₀)
    (hzs : zs * z = n₀ + ∑ a ∈ s, x ^ n a * c a)
    (hzss : zss * z = xs ^ N * m₀ + ∑ a ∈ s, xs ^ (N - n a) * d a)
    (hd : ∀ a ∈ s, d a = g a * ((x ^ n a)⁻¹ * φ * x ^ n a) * c a)
    (hg : ∀ a ∈ s, ∃ w ∈ Subring.closure (insert z (C : Set D)),
      xs ^ n a * x ^ n a - g a = z * w)
    (hCH : C ≤ H) (hxs : xs ∈ H) (hzsH : zs ∈ H) (hzH : z ∈ H) :
    zss ∈ H := by
  have hconj (k : ℕ) {b : D} (hb : b ∈ C) : (x ^ k)⁻¹ * b * x ^ k ∈ C := by
    induction k with
    | zero => simpa using hb
    | succ k ih =>
      have : (x ^ (k + 1))⁻¹ * b * x ^ (k + 1) = x⁻¹ * ((x ^ k)⁻¹ * b * x ^ k) * x := by
        simp only [pow_succ, mul_inv_rev, mul_assoc]
      rw [this]
      exact hxC _ ih
  -- Conjugation by `z` maps `C[z]` into itself, since it fixes `z` and maps `C` into `C`.
  have hconjz {v : D} (hv : v ∈ Subring.closure (insert z (C : Set D))) :
      z * v * z⁻¹ ∈ Subring.closure (insert z (C : Set D)) := by
    let u := ConjAct.toConjAct (Units.mk0 z hz)
    have hu (b : D) : u • b = z * b * z⁻¹ := ConjAct.units_smul_def _ _
    have hle : u • Subring.closure (insert z (C : Set D)) ≤
        Subring.closure (insert z (C : Set D)) := by
      rw [Subring.smul_closure]
      refine Subring.closure_mono ?_
      rintro _ ⟨b, hb, rfl⟩
      simp only [hu]
      rcases hb with rfl | hb
      · rw [mul_inv_cancel_right₀ hz]
        exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (hzC b hb)
    rw [← hu]
    exact hle (Subring.smul_mem_pointwise_smul u v _ hv)
  have hclosure : Subring.closure (insert z (C : Set D)) ≤ H :=
    Subring.closure_le.2 (Set.insert_subset hzH hCH)
  rw [finiteReplacement_eq hx hz hN hm₀ hzs hzss hd, Finset.sum_mul]
  refine H.sub_mem (H.mul_mem (H.mul_mem (H.pow_mem hxs N) (hCH hφ)) hzsH)
    (H.sum_mem fun a ha ↦ ?_)
  obtain ⟨w, hw, hgw⟩ := hg a ha
  have hk : (x ^ n a)⁻¹ * φ * x ^ n a * c a ∈ C := C.mul_mem (hconj _ hφ) (hc a ha)
  have hwk : w * ((x ^ n a)⁻¹ * φ * x ^ n a * c a) ∈ Subring.closure (insert z (C : Set D)) :=
    Subring.mul_mem _ hw (Subring.subset_closure (Set.mem_insert_of_mem _ hk))
  have : xs ^ (N - n a) * (xs ^ n a * x ^ n a - g a) * ((x ^ n a)⁻¹ * φ * x ^ n a) * c a * z⁻¹ =
      xs ^ (N - n a) * (z * (w * ((x ^ n a)⁻¹ * φ * x ^ n a * c a)) * z⁻¹) := by
    rw [hgw]
    simp only [mul_assoc]
  rw [this]
  exact H.mul_mem (H.pow_mem hxs _) (hclosure (hconjz hwk))

/-- **Scalar replacement.** With no interacting terms, `z* · z = n₀` and
`z** · z = (x*) ^ N · m₀` with `φ · n₀ = m₀` give `z** = (x*) ^ N φ z*`. -/
theorem scalarReplacement_eq {z xs zs zss φ n₀ m₀ : D} {N : ℕ} (hz : z ≠ 0)
    (hm₀ : φ * n₀ = m₀) (hzs : zs * z = n₀) (hzss : zss * z = xs ^ N * m₀) :
    zss = xs ^ N * φ * zs := by
  simpa using finiteReplacement_eq (s := (∅ : Finset Unit)) (n := fun _ ↦ 0) (c := fun _ ↦ 0)
    (d := fun _ ↦ 0) (g := fun _ ↦ 0) (x := 1) one_ne_zero hz (by simp) hm₀ (by simpa using hzs)
    (by simpa using hzss) (by simp)

/-- **Binary replacement.** For one interacting term of full degree `N`, the exchange
relations `z* · z = n₀ + x ^ N c` and `z** · z = (x*) ^ N m₀ + d` with `φ · n₀ = m₀` and
`d = g · (x ^ N)⁻¹ φ x ^ N · c` give
`z** = (x*) ^ N φ z* - ((x*) ^ N x ^ N - g) (x ^ N)⁻¹ φ x ^ N c z⁻¹`. -/
theorem binaryReplacement_eq {x z xs zs zss φ n₀ m₀ c d g : D} {N : ℕ} (hx : x ≠ 0)
    (hz : z ≠ 0) (hm₀ : φ * n₀ = m₀) (hzs : zs * z = n₀ + x ^ N * c)
    (hzss : zss * z = xs ^ N * m₀ + d) (hd : d = g * ((x ^ N)⁻¹ * φ * x ^ N) * c) :
    zss = xs ^ N * φ * zs - (xs ^ N * x ^ N - g) * ((x ^ N)⁻¹ * φ * x ^ N) * c * z⁻¹ := by
  simpa using finiteReplacement_eq (s := {()}) (N := N) (n := fun _ ↦ N) (c := fun _ ↦ c)
    (d := fun _ ↦ d) (g := fun _ ↦ g) hx hz (by simp) hm₀ (by simpa using hzs)
    (by simpa using hzss) (by simpa using hd)

/-- **Binary replacement, membership.** Under the hypotheses of `binaryReplacement_eq`, if `x`
and `z` normalize a subring `C` containing `φ` and `c`, and `(x*) ^ N x ^ N - g` lies in
`z · C[z]`, then `z**` lies in every subring containing `C`, `x*`, `z*` and `z`. -/
theorem binaryReplacement_mem {C H : Subring D} {x z xs zs zss φ n₀ m₀ c d g : D} {N : ℕ}
    (hx : x ≠ 0) (hz : z ≠ 0) (hxC : ∀ b ∈ C, x⁻¹ * b * x ∈ C)
    (hzC : ∀ b ∈ C, z * b * z⁻¹ ∈ C) (hφ : φ ∈ C) (hc : c ∈ C) (hm₀ : φ * n₀ = m₀)
    (hzs : zs * z = n₀ + x ^ N * c) (hzss : zss * z = xs ^ N * m₀ + d)
    (hd : d = g * ((x ^ N)⁻¹ * φ * x ^ N) * c)
    (hg : ∃ w ∈ Subring.closure (insert z (C : Set D)), xs ^ N * x ^ N - g = z * w)
    (hCH : C ≤ H) (hxs : xs ∈ H) (hzsH : zs ∈ H) (hzH : z ∈ H) :
    zss ∈ H :=
  finiteReplacement_mem (s := {()}) (N := N) (n := fun _ ↦ N) (c := fun _ ↦ c) (d := fun _ ↦ d)
    (g := fun _ ↦ g) hx hz hxC hzC hφ (by simpa using hc) (by simp) hm₀ (by simpa using hzs)
    (by simpa using hzss) (by simpa using hd) (by simpa using hg) hCH hxs hzsH hzH

end DivisionRing

/-- **Polynomial replacement.** Let `f : R →+* F` be a ring map into a field and let `x, y` be
nonzero with `x z = P_f(y)` and `y w = Q_f(x)` for polynomials `P, Q` over `R`. For every
`e ≥ deg Q`, the element `(∑ₐ f(Q.coeff a) f(P(0)) ^ a z ^ (e - a)) / y` lies in every subring
of `F` containing `f(R)`, `y`, `z` and `w`. -/
theorem polynomialReplacement_mem {R F : Type*} [Ring R] [Field F] (f : R →+* F)
    (P Q : R[X]) {e : ℕ} (he : Q.natDegree ≤ e) {x y z w : F} (hx : x ≠ 0) (hy : y ≠ 0)
    (hxz : x * z = P.eval₂ f y) (hyw : y * w = Q.eval₂ f x) {H : Subring F}
    (hfH : f.range ≤ H) (hyH : y ∈ H) (hzH : z ∈ H) (hwH : w ∈ H) :
    (∑ a ∈ Q.support, f (Q.coeff a) * f (P.coeff 0) ^ a * z ^ (e - a)) / y ∈ H := by
  refine finiteReplacement_mem (C := f.range) (x := x) (z := y) (xs := z) (zs := w)
    (φ := 1) (n₀ := 0) (m₀ := 0) (N := e) (n := fun a ↦ a) (c := fun a ↦ f (Q.coeff a))
    (d := fun a ↦ f (P.coeff 0) ^ a * f (Q.coeff a)) (g := fun a ↦ f (P.coeff 0) ^ a)
    hx hy (fun b hb ↦ by rwa [mul_comm x⁻¹ b, inv_mul_cancel_right₀ hx])
    (fun b hb ↦ by rwa [mul_comm y b, mul_inv_cancel_right₀ hy]) (one_mem _) (fun a _ ↦ ⟨_, rfl⟩)
    (fun a ha ↦ le_trans (le_natDegree_of_mem_supp a ha) he) (mul_zero _) ?_ ?_
    (fun a _ ↦ by rw [mul_one, inv_mul_cancel₀ (pow_ne_zero a hx), mul_one]) (fun a _ ↦ ?_)
    hfH hzH hwH hyH
  · rw [mul_comm w y, hyw, eval₂_eq_sum, Polynomial.sum_def, zero_add]
    exact Finset.sum_congr rfl fun a _ ↦ mul_comm _ _
  · rw [div_mul_cancel₀ _ hy, mul_zero, zero_add]
    exact Finset.sum_congr rfl fun a _ ↦ by ring
  · refine ⟨(divX (P ^ a)).eval₂ f y, ?_, ?_⟩
    · rw [eval₂_eq_sum, Polynomial.sum_def]
      refine Subring.sum_mem _ fun i _ ↦ Subring.mul_mem _ ?_ (Subring.pow_mem _ ?_ _)
      · exact Subring.subset_closure (Set.mem_insert_of_mem _ ⟨_, rfl⟩)
      · exact Subring.subset_closure (Set.mem_insert _ _)
    · have h := congrArg (eval₂ f y) (X_mul_divX_add (P ^ a))
      rw [eval₂_add, eval₂_mul, eval₂_X, eval₂_C, eval₂_pow, ← hxz, ← constantCoeff_apply,
        map_pow, constantCoeff_apply, map_pow] at h
      rw [← mul_pow, mul_comm z x, ← h]
      ring

end TauCeti
