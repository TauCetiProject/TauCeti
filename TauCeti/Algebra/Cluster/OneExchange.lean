/-!
# One-step skew Laurent exchange over a subsemiring

Let `C` be a subsemiring of a (not necessarily commutative) semiring `B`, and let `x : Bˣ` be a
unit normalizing `C` under conjugation (`ConjAct.toConjAct x • C = C`) such that finite left
Laurent expansions `∑_m c_m * x^m` with coefficients `c_m ∈ C` are uniquely determined by their sum
in `B`. Given a second normalizing unit `E : Bˣ` with `(E : B) ∈ C`, define the exchanged unit
`y = E * x⁻¹` and the twisted exchange products `P_0 = 1`, `P_{r + 1} = P_r * ((x^r)⁻¹ * E * x^r)`
(`TauCeti.exchangeProduct x E r`).

Working entirely over semirings without subtraction, this file proves the three fundamental
one-exchange theorems:

1. `y` normalizes `C`, satisfies `y^r = P_r * (x^r)⁻¹`, and finite left Laurent expansions in `y`
   have unique left coefficients in `C` (`Subsemiring.skewLaurentSum_mul_inv_injective`).
2. A left Laurent expansion `∑_m c_m * x^m` belongs to `C.laurentAdjoin y` if and only if for every
   `r > 0`, `c_{-r}` is a left `C`-multiple of `P_r` (`Subsemiring.mem_laurentAdjoin_mul_inv_iff`).
3. The intersection `C.laurentAdjoin x ⊓ C.laurentAdjoin y` equals the subsemiring
   `C ⊔ Subsemiring.closure {x, y}` and has unique finite normal forms
   `c_0 + ∑_{r ≥ 0} c^+_r * x^{r + 1} + ∑_{r ≥ 0} c^-_r * y^{r + 1}`
   (`Subsemiring.laurentAdjoin_inf_laurentAdjoin_mul_inv`,
   `Subsemiring.range_exchangeNormalForm_mul_inv`,
   `Subsemiring.exchangeNormalForm_mul_inv_injective`).

When `B` is a ring and `C = S.toSubsemiring` comes from a subring `S : Subring B`, the adjoined
subsemirings coincide with the underlying subsemirings of the corresponding subrings
(`Subring.toSubsemiring_sup_closure`, `Subring.toSubsemiring_laurentAdjoin`).

## Main definitions

* `TauCeti.exchangeProduct`: the twisted product `P_r = ∏_{j = 0}^{r - 1} (x^j)⁻¹ * E * x^j` in any
  group.
* `Subsemiring.laurentAdjoin`: the subsemiring `C ⊔ Subsemiring.closure {x, x⁻¹}` generated by `C`
  and a unit `x : Bˣ` together with its inverse.
* `Subsemiring.skewLaurentSum`: evaluation `(ℤ →₀ C) →+ B` sending `f` to `∑_m f(m) * x^m`.
* `Subsemiring.exchangeNormalForm`: evaluation `(C × (ℕ →₀ C) × (ℕ →₀ C)) →+ B` of two-sided
  positive normal forms `c_0 + ∑_r c^+_r * x^{r + 1} + ∑_r c^-_r * y^{r + 1}`.
* `Subring.laurentAdjoin`: the subring counterpart `S ⊔ Subring.closure {x, x⁻¹}`.

## References

* A. Berenstein, S. Fomin, and A. Zelevinsky, *Cluster algebras III: Upper bounds and double Bruhat
  cells*, Duke Math. J. 126 (2005), Lemmas 4.1–4.2.
* A. Berenstein and A. Zelevinsky, *Quantum cluster algebras*, Adv. Math. 195 (2005),
  Lemmas 5.5–5.6.
-/

public section

open scoped Pointwise

namespace TauCeti

section Group

variable {G : Type*} [Group G]

/-- **Twisted exchange product** `P_r` associated to `x, E : G`: defined recursively by `P_0 = 1`
and `P_{r + 1} = P_r * ((x^r)⁻¹ * E * x^r)`, so `(E * x⁻¹)^r = P_r * (x^r)⁻¹`. -/
def exchangeProduct (x E : G) : ℕ → G
  | 0 => 1
  | r + 1 => exchangeProduct x E r * ((x ^ r)⁻¹ * E * x ^ r)

@[simp]
theorem exchangeProduct_zero (x E : G) : exchangeProduct x E 0 = 1 :=
  (rfl)

@[simp]
theorem exchangeProduct_succ (x E : G) (r : ℕ) :
    exchangeProduct x E (r + 1) = exchangeProduct x E r * ((x ^ r)⁻¹ * E * x ^ r) :=
  (rfl)

theorem exchangeProduct_one (x E : G) : exchangeProduct x E 1 = E := by
  simp [exchangeProduct]

theorem exchangeProduct_two (x E : G) :
    exchangeProduct x E 2 = E * (x⁻¹ * E * x) := by
  simp [exchangeProduct]

/-- For every `r : ℕ`, `(E * x⁻¹)^r = exchangeProduct x E r * (x^r)⁻¹`. -/
theorem mul_inv_pow_eq_exchangeProduct_mul_pow_inv (x E : G) (r : ℕ) :
    (E * x⁻¹) ^ r = exchangeProduct x E r * (x ^ r)⁻¹ := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ, ih, exchangeProduct_succ, pow_succ', mul_inv_rev]
    simp only [mul_assoc, mul_inv_cancel_left]

/-- Integer-exponent form of `mul_inv_pow_eq_exchangeProduct_mul_pow_inv`. -/
theorem mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg (x E : G) (r : ℕ) :
    (E * x⁻¹) ^ (r : ℤ) = exchangeProduct x E r * x ^ (-(r : ℤ)) := by
  rw [zpow_natCast, mul_inv_pow_eq_exchangeProduct_mul_pow_inv, zpow_neg, zpow_natCast]

/-- **Cocycle identity** for `exchangeProduct`:
`P_{s + t} = P_s * ((x^s)⁻¹ * P_t * x^s)`. -/
theorem exchangeProduct_add (x E : G) (s t : ℕ) :
    exchangeProduct x E (s + t) =
      exchangeProduct x E s * ((x ^ s)⁻¹ * exchangeProduct x E t * x ^ s) := by
  induction t with
  | zero => simp
  | succ t ih =>
    have hpow : x ^ (s + t) = x ^ t * x ^ s := by rw [add_comm, pow_add]
    rw [Nat.add_succ, exchangeProduct_succ, ih, exchangeProduct_succ, hpow, mul_inv_rev]
    simp only [mul_assoc, mul_inv_cancel_left]

/-- **Shifted power identity**: for all `k N : ℕ`,
`(E * x⁻¹)^{k - N} * P_N = P_k * x^{N - k}`. -/
theorem mul_inv_zpow_sub_mul_exchangeProduct (x E : G) (k N : ℕ) :
    (E * x⁻¹) ^ ((k : ℤ) - (N : ℤ)) * exchangeProduct x E N =
      exchangeProduct x E k * x ^ ((N : ℤ) - (k : ℤ)) := by
  have hN : (E * x⁻¹) ^ (-(N : ℤ)) * exchangeProduct x E N = x ^ (N : ℤ) := by
    apply mul_left_cancel (a := (E * x⁻¹) ^ (N : ℤ))
    rw [← mul_assoc, ← zpow_add, add_neg_cancel, zpow_zero, one_mul,
      mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg, mul_assoc, ← zpow_add,
      neg_add_cancel, zpow_zero, mul_one]
  rw [sub_eq_add_neg, zpow_add, mul_assoc, hN,
    mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg, mul_assoc, ← zpow_add, neg_add_eq_sub]

/-- When `x` and `E` commute, `exchangeProduct x E r = E ^ r`. -/
theorem exchangeProduct_of_commute {x E : G} (h : Commute x E) (r : ℕ) :
    exchangeProduct x E r = E ^ r := by
  induction r with
  | zero => simp
  | succ r ih =>
    have hcomm : (x ^ r)⁻¹ * E = E * (x ^ r)⁻¹ := (h.pow_left r).inv_left.eq
    rw [exchangeProduct_succ, ih, hcomm, mul_assoc E, inv_mul_cancel, mul_one, pow_succ]

end Group

end TauCeti

/-! ### Skew Laurent evaluation and one-step exchange on a subsemiring -/

namespace Subsemiring

open TauCeti

section Semiring

variable {B : Type*} [Semiring B]

/-- If a unit `x : Bˣ` normalizes `C`, then `x⁻¹` also normalizes `C`. -/
theorem conjAct_inv_smul_eq {C : Subsemiring B} {x : Bˣ} (hx : ConjAct.toConjAct x • C = C) :
    ConjAct.toConjAct x⁻¹ • C = C := by
  have h := congrArg (ConjAct.toConjAct x⁻¹ • ·) hx
  simpa [← mul_smul] using h.symm

/-- If a unit `x : Bˣ` normalizes `C`, then every integer power `x^m` normalizes `C`. -/
theorem conjAct_zpow_smul_eq {C : Subsemiring B} {x : Bˣ} (hx : ConjAct.toConjAct x • C = C)
    (m : ℤ) : ConjAct.toConjAct (x ^ m) • C = C := by
  induction m using Int.induction_on with
  | zero => simp
  | succ k hk => rw [zpow_add_one, map_mul, mul_smul, hx, hk]
  | pred k hk => rw [zpow_sub_one, map_mul, mul_smul, conjAct_inv_smul_eq hx, hk]

/-- If `x` and `E` normalize `C`, then the exchanged unit `E * x⁻¹` normalizes `C`. -/
theorem conjAct_mul_inv_smul_eq {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hE : ConjAct.toConjAct E • C = C) :
    ConjAct.toConjAct (E * x⁻¹) • C = C := by
  rw [map_mul, mul_smul, conjAct_inv_smul_eq hx, hE]

/-- Conjugating an element of `C` by `x^m` stays in `C` when `x` normalizes `C`. -/
theorem conj_zpow_mem {C : Subsemiring B} {x : Bˣ} (hx : ConjAct.toConjAct x • C = C) (m : ℤ)
    {c : B} (hc : c ∈ C) : ((x ^ m : Bˣ) : B) * c * ((x ^ (-m) : Bˣ) : B) ∈ C := by
  have hmem : ConjAct.toConjAct (x ^ m) • c ∈ C := by
    rw [← conjAct_zpow_smul_eq hx m]
    exact smul_mem_pointwise_smul _ _ _ hc
  simpa [ConjAct.units_smul_def, zpow_neg] using hmem

/-- Moving `x^m` past `c ∈ C` to the right: `x^m * c = (x^m * c * x^{-m}) * x^m`. -/
theorem zpow_mul_eq_conj_mul_zpow (x : Bˣ) (m : ℤ) (c : B) :
    ((x ^ m : Bˣ) : B) * c =
      (((x ^ m : Bˣ) : B) * c * ((x ^ (-m) : Bˣ) : B)) * ((x ^ m : Bˣ) : B) := by
  rw [mul_assoc (((x ^ m : Bˣ) : B) * c), ← Units.val_mul, ← zpow_add, neg_add_cancel, zpow_zero,
    Units.val_one, mul_one]

/-- When `x` normalizes `C` and `(E : B) ∈ C`, every twisted exchange product
`exchangeProduct x E r` belongs to `C`. -/
theorem coe_exchangeProduct_mem {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C) (r : ℕ) :
    ((exchangeProduct x E r : Bˣ) : B) ∈ C := by
  induction r with
  | zero => simp [C.one_mem]
  | succ r ih =>
    rw [exchangeProduct_succ, Units.val_mul]
    refine C.mul_mem ih ?_
    have hconj := conj_zpow_mem hx (-(r : ℤ)) hEC
    simpa [zpow_neg, zpow_natCast, mul_assoc] using hconj

/-- The subsemiring `C[x^{±1}] = C ⊔ Subsemiring.closure {x, x⁻¹}` generated by `C` and a unit
`x : Bˣ` together with its inverse. -/
def laurentAdjoin (C : Subsemiring B) (x : Bˣ) : Subsemiring B :=
  C ⊔ Subsemiring.closure {(x : B), ((x⁻¹ : Bˣ) : B)}

theorem laurentAdjoin_def (C : Subsemiring B) (x : Bˣ) :
    C.laurentAdjoin x = C ⊔ Subsemiring.closure {(x : B), ((x⁻¹ : Bˣ) : B)} :=
  (rfl)

theorem le_laurentAdjoin (C : Subsemiring B) (x : Bˣ) : C ≤ C.laurentAdjoin x :=
  le_sup_left

theorem coe_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) : (x : B) ∈ C.laurentAdjoin x :=
  (le_sup_right : Subsemiring.closure _ ≤ C.laurentAdjoin x) <| subset_closure <| by simp

theorem coe_inv_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) :
    ((x⁻¹ : Bˣ) : B) ∈ C.laurentAdjoin x :=
  (le_sup_right : Subsemiring.closure _ ≤ C.laurentAdjoin x) <| subset_closure <| by simp

theorem coe_zpow_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) (m : ℤ) :
    ((x ^ m : Bˣ) : B) ∈ C.laurentAdjoin x := by
  induction m using Int.induction_on with
  | zero => simp [(C.laurentAdjoin x).one_mem]
  | succ k hk =>
    rw [zpow_add_one, Units.val_mul]
    exact (C.laurentAdjoin x).mul_mem hk (C.coe_mem_laurentAdjoin x)
  | pred k hk =>
    rw [zpow_sub_one, Units.val_mul]
    exact (C.laurentAdjoin x).mul_mem hk (C.coe_inv_mem_laurentAdjoin x)

/-- Evaluation of finite left Laurent expansions `f ↦ ∑_m f(m) * x^m` with coefficients in `C`. -/
def skewLaurentSum (C : Subsemiring B) (x : Bˣ) : (ℤ →₀ C) →+ B where
  toFun f := f.sum fun m c ↦ (c : B) * ((x ^ m : Bˣ) : B)
  map_zero' := Finsupp.sum_zero_index
  map_add' _ _ := Finsupp.sum_add_index' (fun _ ↦ zero_mul _) (fun _ _ _ ↦ add_mul _ _ _)

theorem skewLaurentSum_apply (C : Subsemiring B) (x : Bˣ) (f : ℤ →₀ C) :
    C.skewLaurentSum x f = f.sum fun m c ↦ (c : B) * ((x ^ m : Bˣ) : B) :=
  (rfl)

@[simp]
theorem skewLaurentSum_single (C : Subsemiring B) (x : Bˣ) (m : ℤ) (c : C) :
    C.skewLaurentSum x (Finsupp.single m c) = (c : B) * ((x ^ m : Bˣ) : B) := by
  rw [skewLaurentSum_apply, Finsupp.sum_single_index (zero_mul _)]

theorem skewLaurentSum_mem_laurentAdjoin (C : Subsemiring B) (x : Bˣ) (f : ℤ →₀ C) :
    C.skewLaurentSum x f ∈ C.laurentAdjoin x := by
  induction f using Finsupp.induction_linear with
  | zero => simp [(C.laurentAdjoin x).zero_mem]
  | add f g hf hg =>
    rw [map_add]
    exact (C.laurentAdjoin x).add_mem hf hg
  | single m c =>
    rw [skewLaurentSum_single]
    exact (C.laurentAdjoin x).mul_mem (C.le_laurentAdjoin x c.2) (C.coe_zpow_mem_laurentAdjoin x m)

/-- When `x` normalizes `C`, `C.laurentAdjoin x` is precisely the range of `C.skewLaurentSum x`. -/
theorem range_skewLaurentSum {C : Subsemiring B} {x : Bˣ} (hx : ConjAct.toConjAct x • C = C) :
    Set.range (C.skewLaurentSum x) = (C.laurentAdjoin x : Set B) := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨f, rfl⟩
    exact C.skewLaurentSum_mem_laurentAdjoin x f
  · let M := AddMonoidHom.mrange (C.skewLaurentSum x)
    have hmul_single (m n : ℤ) (c₁ c₂ : C) :
        ((c₁ : B) * ((x ^ m : Bˣ) : B)) * ((c₂ : B) * ((x ^ n : Bˣ) : B)) ∈ M := by
      refine ⟨Finsupp.single (m + n)
        ⟨(c₁ : B) * (((x ^ m : Bˣ) : B) * (c₂ : B) * ((x ^ (-m) : Bˣ) : B)),
          C.mul_mem c₁.2 (conj_zpow_mem hx m c₂.2)⟩, ?_⟩
      rw [skewLaurentSum_single]
      dsimp only
      rw [zpow_add, Units.val_mul, ← mul_assoc _ ((x ^ m : Bˣ) : B), mul_assoc (c₁ : B),
        ← zpow_mul_eq_conj_mul_zpow]
      simp only [mul_assoc]
    have hmul : ∀ {a b : B}, a ∈ M → b ∈ M → a * b ∈ M := by
      rintro _ _ ⟨f, rfl⟩ ⟨g, rfl⟩
      induction f using Finsupp.induction_linear with
      | zero => simp [M.zero_mem]
      | add f₁ f₂ hf₁ hf₂ =>
        rw [map_add, add_mul]
        exact M.add_mem hf₁ hf₂
      | single m c₁ =>
        induction g using Finsupp.induction_linear with
        | zero => simp [M.zero_mem]
        | add g₁ g₂ hg₁ hg₂ =>
          rw [map_add, mul_add]
          exact M.add_mem hg₁ hg₂
        | single n c₂ =>
          rw [skewLaurentSum_single, skewLaurentSum_single]
          exact hmul_single m n c₁ c₂
    let S : Subsemiring B :=
      { M with
        one_mem' := ⟨Finsupp.single 0 1, by simp⟩
        mul_mem' := hmul }
    suffices C.laurentAdjoin x ≤ S from this
    refine sup_le (fun c hc ↦ ⟨Finsupp.single 0 ⟨c, hc⟩, by simp⟩) (closure_le.mpr ?_)
    rintro b (rfl | rfl)
    · exact ⟨Finsupp.single 1 1, by simp⟩
    · exact ⟨Finsupp.single (-1) 1, by simp⟩

private theorem finsupp_sum_single_apply_of_injective {α β M N : Type*} [AddCommMonoid M]
    [AddCommMonoid N] (f : α →₀ M) {φ : α → β} (hφ : Function.Injective φ) (ψ : α → M → N)
    (hψ : ∀ a, ψ a 0 = 0) (a₀ : α) :
    (f.sum fun a m ↦ Finsupp.single (φ a) (ψ a m)) (φ a₀) = ψ a₀ (f a₀) := by
  classical
  rw [Finsupp.sum_apply, Finsupp.sum]
  by_cases ha₀ : a₀ ∈ f.support
  · rw [Finset.sum_eq_single a₀]
    · exact Finsupp.single_eq_same
    · intro a _ hne
      exact Finsupp.single_eq_of_ne (hφ.ne hne.symm)
    · intro hnot
      exact absurd ha₀ hnot
  · rw [Finset.sum_eq_zero, Finsupp.notMem_support_iff.mp ha₀, hψ]
    intro a ha
    have hne : a ≠ a₀ := fun h ↦ ha₀ (h ▸ ha)
    exact Finsupp.single_eq_of_ne (hφ.ne hne.symm)

/-- **Uniqueness of left Laurent expansions after one-step skew exchange**: if `x` normalizes `C`,
`(E : B) ∈ C`, and left Laurent expansions in `x` have unique coefficients in `C`, then left
Laurent expansions in `y = E * x⁻¹` also have unique coefficients in `C`. -/
theorem skewLaurentSum_mul_inv_injective {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) :
    Function.Injective (C.skewLaurentSum (E * x⁻¹)) := by
  intro f₁ f₂ hfg
  ext m₀
  classical
  let N : ℕ := (f₁.support ∪ f₂.support ∪ {m₀}).sup fun m ↦ (-m).toNat
  have hN_le (m : ℤ) (hm : m ∈ f₁.support ∪ f₂.support ∪ {m₀}) : 0 ≤ m + (N : ℤ) := by
    have hle : (-m).toNat ≤ N := Finset.le_sup (f := fun k : ℤ ↦ (-k).toNat) hm
    omega
  let p (m : ℤ) : C :=
    ⟨((exchangeProduct x E (m + (N : ℤ)).toNat : Bˣ) : B), coe_exchangeProduct_mem hx hEC _⟩
  let Φ (f : ℤ →₀ C) : ℤ →₀ C :=
    f.sum fun m c ↦ Finsupp.single (-(m + (N : ℤ))) (c * p m)
  have hΦ (f : ℤ →₀ C) (hf : ∀ m ∈ f.support, 0 ≤ m + (N : ℤ)) :
      C.skewLaurentSum x (Φ f) =
        C.skewLaurentSum (E * x⁻¹) f * (((E * x⁻¹) ^ (N : ℤ) : Bˣ) : B) := by
    rw [map_finsuppSum, skewLaurentSum_apply, Finsupp.sum, Finsupp.sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun m hm ↦ ?_
    have hmN : ((m + (N : ℤ)).toNat : ℤ) = m + (N : ℤ) := Int.toNat_of_nonneg (hf m hm)
    have hneg : -(m + (N : ℤ)) = -((m + (N : ℤ)).toNat : ℤ) := by omega
    rw [skewLaurentSum_single]
    dsimp only [p]
    rw [Subsemiring.coe_mul, mul_assoc ((f m : C) : B), ← Units.val_mul, hneg,
      ← mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg, hmN, zpow_add, Units.val_mul,
      mul_assoc]
  have hΦ_eq : Φ f₁ = Φ f₂ := hinj <| by
    rw [hΦ f₁ (fun m hm ↦ hN_le m (by simp [hm])),
      hΦ f₂ (fun m hm ↦ hN_le m (by simp [hm])), hfg]
  have hinj_neg : Function.Injective fun m : ℤ ↦ -(m + (N : ℤ)) :=
    fun a b (h : -(a + (N : ℤ)) = -(b + (N : ℤ))) ↦ by omega
  have hcoeff := congrArg (fun g : ℤ →₀ C ↦ (g (-(m₀ + (N : ℤ))) : B)) hΦ_eq
  dsimp only [Φ] at hcoeff
  rw [finsupp_sum_single_apply_of_injective f₁ hinj_neg (fun m c ↦ c * p m)
      (fun _ ↦ zero_mul _) m₀,
    finsupp_sum_single_apply_of_injective f₂ hinj_neg (fun m c ↦ c * p m)
      (fun _ ↦ zero_mul _) m₀] at hcoeff
  exact (Units.mul_left_inj (exchangeProduct x E (m₀ + (N : ℤ)).toNat)).mp hcoeff

/-- Evaluation of finite two-sided positive normal forms
`(c₀, c⁺, c⁻) ↦ c₀ + ∑_r c⁺(r) * x^{r + 1} + ∑_r c⁻(r) * y^{r + 1}`. -/
def exchangeNormalForm (C : Subsemiring B) (x y : B) : (C × (ℕ →₀ C) × (ℕ →₀ C)) →+ B where
  toFun t :=
    (t.1 : B) + (t.2.1.sum fun r c ↦ (c : B) * x ^ (r + 1)) +
      (t.2.2.sum fun r c ↦ (c : B) * y ^ (r + 1))
  map_zero' := by simp
  map_add' _ _ := by
    rw [Prod.fst_add, Subsemiring.coe_add, Prod.snd_add, Prod.fst_add, Prod.snd_add,
      Finsupp.sum_add_index' (fun _ ↦ zero_mul _) (fun _ _ _ ↦ add_mul _ _ _),
      Finsupp.sum_add_index' (fun _ ↦ zero_mul _) (fun _ _ _ ↦ add_mul _ _ _)]
    simp only [add_assoc, add_left_comm]

theorem exchangeNormalForm_apply (C : Subsemiring B) (x y : B) (t : C × (ℕ →₀ C) × (ℕ →₀ C)) :
    C.exchangeNormalForm x y t =
      (t.1 : B) + (t.2.1.sum fun r c ↦ (c : B) * x ^ (r + 1)) +
        (t.2.2.sum fun r c ↦ (c : B) * y ^ (r + 1)) :=
  (rfl)

theorem exchangeNormalForm_mem_sup_closure (C : Subsemiring B) (x y : B)
    (t : C × (ℕ →₀ C) × (ℕ →₀ C)) :
    C.exchangeNormalForm x y t ∈ C ⊔ Subsemiring.closure {x, y} := by
  let S : Subsemiring B := C ⊔ Subsemiring.closure {x, y}
  have hCS : C ≤ S := le_sup_left
  have hcl : Subsemiring.closure {x, y} ≤ S := le_sup_right
  have hxS : x ∈ S := hcl <| subset_closure <| by simp
  have hyS : y ∈ S := hcl <| subset_closure <| by simp
  refine S.add_mem (S.add_mem (hCS t.1.2) ?_) ?_
  · rw [Finsupp.sum]
    exact S.sum_mem fun r _ ↦ S.mul_mem (hCS (t.2.1 r).2) (S.pow_mem hxS _)
  · rw [Finsupp.sum]
    exact S.sum_mem fun r _ ↦ S.mul_mem (hCS (t.2.2 r).2) (S.pow_mem hyS _)

theorem sup_closure_mul_inv_le_inf_laurentAdjoin {C : Subsemiring B} {x E : Bˣ}
    (hEC : (E : B) ∈ C) :
    C ⊔ Subsemiring.closure {(x : B), ((E * x⁻¹ : Bˣ) : B)} ≤
      C.laurentAdjoin x ⊓ C.laurentAdjoin (E * x⁻¹) := by
  refine le_inf ?_ ?_
  · refine sup_le (C.le_laurentAdjoin x) (closure_le.mpr ?_)
    rintro b (rfl | rfl)
    · exact C.coe_mem_laurentAdjoin x
    · rw [Units.val_mul]
      exact (C.laurentAdjoin x).mul_mem (C.le_laurentAdjoin x hEC) (C.coe_inv_mem_laurentAdjoin x)
  · refine sup_le (C.le_laurentAdjoin (E * x⁻¹)) (closure_le.mpr ?_)
    rintro b (rfl | rfl)
    · have hx_val : (x : B) = (((E * x⁻¹)⁻¹ : Bˣ) : B) * (E : B) := by
        rw [← Units.val_mul]
        congr 1
        simp [mul_inv_rev]
      rw [hx_val]
      exact (C.laurentAdjoin (E * x⁻¹)).mul_mem (C.coe_inv_mem_laurentAdjoin (E * x⁻¹))
        (C.le_laurentAdjoin (E * x⁻¹) hEC)
    · exact C.coe_mem_laurentAdjoin (E * x⁻¹)

private theorem skewLaurentSum_mem_range_exchangeNormalForm {C : Subsemiring B} {x E : Bˣ}
    {f : ℤ →₀ C}
    (hd : ∀ r : ℕ, 0 < r →
      ∃ d : C, (f (-(r : ℤ)) : B) = (d : B) * ((exchangeProduct x E r : Bˣ) : B)) :
    C.skewLaurentSum x f ∈
      Set.range (C.exchangeNormalForm (x : B) ((E * x⁻¹ : Bˣ) : B)) := by
  rw [← AddMonoidHom.coe_mrange, SetLike.mem_coe, skewLaurentSum_apply, Finsupp.sum]
  refine (AddMonoidHom.mrange (C.exchangeNormalForm (x : B) ((E * x⁻¹ : Bˣ) : B))).sum_mem
      fun m _ ↦ ?_
  rcases lt_trichotomy m 0 with hm | rfl | hm
  · let r : ℕ := (-m - 1).toNat
    have hm_eq : m = -((r + 1 : ℕ) : ℤ) := by omega
    obtain ⟨d, hd_eq⟩ := hd (r + 1) (Nat.succ_pos r)
    refine ⟨(0, 0, Finsupp.single r d), ?_⟩
    rw [exchangeNormalForm_apply, hm_eq, hd_eq, mul_assoc, ← Units.val_mul,
      ← mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg, zpow_natCast,
      Units.val_pow_eq_pow_val, Finsupp.sum_single_index (zero_mul _)]
    simp
  · exact ⟨(f 0, 0, 0), by simp [exchangeNormalForm_apply]⟩
  · let r : ℕ := (m - 1).toNat
    have hm_eq : m = ((r + 1 : ℕ) : ℤ) := by omega
    refine ⟨(0, Finsupp.single r (f m), 0), ?_⟩
    rw [exchangeNormalForm_apply, hm_eq, zpow_natCast, Units.val_pow_eq_pow_val,
      Finsupp.sum_single_index (zero_mul _)]
    simp

private theorem exists_mul_exchangeProduct_of_skewLaurentSum_eq {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) {f g : ℤ →₀ C}
    (hg : C.skewLaurentSum x f = C.skewLaurentSum (E * x⁻¹) g) (r : ℕ) :
    ∃ d : C, (f (-(r : ℤ)) : B) = (d : B) * ((exchangeProduct x E r : Bˣ) : B) := by
  let N : ℕ := g.support.sup fun n ↦ (-n).toNat
  have hN_le (n : ℤ) (hn : n ∈ g.support) : 0 ≤ n + (N : ℤ) := by
    have hle : (-n).toNat ≤ N := Finset.le_sup (f := fun k : ℤ ↦ (-k).toNat) hn
    omega
  let qL (m : ℤ) : C :=
    ⟨((x ^ m : Bˣ) : B) * ((exchangeProduct x E N : Bˣ) : B) * ((x ^ (-m) : Bˣ) : B),
      conj_zpow_mem hx m (coe_exchangeProduct_mem hx hEC N)⟩
  let qR (n : ℤ) : C :=
    ⟨((exchangeProduct x E (n + (N : ℤ)).toNat : Bˣ) : B), coe_exchangeProduct_mem hx hEC _⟩
  let f' : ℤ →₀ C := f.sum fun m c ↦ Finsupp.single m (c * qL m)
  let g' : ℤ →₀ C := g.sum fun n d ↦ Finsupp.single (-n) (d * qR n)
  have hf' : C.skewLaurentSum x f' =
      C.skewLaurentSum x f * ((exchangeProduct x E N : Bˣ) : B) := by
    rw [map_finsuppSum, skewLaurentSum_apply, Finsupp.sum, Finsupp.sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun m _ ↦ ?_
    rw [skewLaurentSum_single, Subsemiring.coe_mul, mul_assoc ((f m : C) : B),
      ← zpow_mul_eq_conj_mul_zpow, mul_assoc]
  have hg' : C.skewLaurentSum x g' =
      C.skewLaurentSum (E * x⁻¹) g * ((exchangeProduct x E N : Bˣ) : B) := by
    rw [map_finsuppSum, skewLaurentSum_apply, Finsupp.sum, Finsupp.sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun n hn ↦ ?_
    have hk : ((n + (N : ℤ)).toNat : ℤ) - (N : ℤ) = n := by
      have := Int.toNat_of_nonneg (hN_le n hn)
      omega
    have hk_neg : (N : ℤ) - ((n + (N : ℤ)).toNat : ℤ) = -n := by omega
    rw [skewLaurentSum_single, Subsemiring.coe_mul, mul_assoc ((g n : C) : B), ← Units.val_mul,
      ← hk_neg, ← mul_inv_zpow_sub_mul_exchangeProduct, hk, Units.val_mul, mul_assoc]
  have hfg' : f' = g' := hinj (by rw [hf', hg', hg])
  have hcoeff := congrArg (fun h : ℤ →₀ C ↦ (h (-(r : ℤ)) : B)) hfg'
  rw [finsupp_sum_single_apply_of_injective f (φ := fun m ↦ m) (fun _ _ h ↦ h)
      (fun m c ↦ c * qL m) (fun _ ↦ zero_mul _) (-(r : ℤ)),
    finsupp_sum_single_apply_of_injective g neg_injective
      (fun n d ↦ d * qR n) (fun _ ↦ zero_mul _) (r : ℤ)] at hcoeff
  dsimp only [qL, qR, Subsemiring.coe_mul] at hcoeff
  have hrN : (((r : ℤ) + (N : ℤ)).toNat : ℕ) = r + N := by omega
  let W : Bˣ := (x ^ r)⁻¹ * exchangeProduct x E N * x ^ r
  have hW : ((x ^ (-(r : ℤ)) : Bˣ) : B) * ((exchangeProduct x E N : Bˣ) : B) *
      ((x ^ (-(-(r : ℤ))) : Bˣ) : B) = (W : B) := by
    simp [W, zpow_neg, zpow_natCast, mul_assoc]
  rw [hrN, hW, exchangeProduct_add, Units.val_mul (exchangeProduct x E r) W,
    ← mul_assoc ((g (r : ℤ) : C) : B)] at hcoeff
  exact ⟨g (r : ℤ), (Units.mul_left_inj W).mp hcoeff⟩

/-- **Coefficient divisibility criterion for one-step skew exchange**: for normalizing units
`x, E : Bˣ` with `(E : B) ∈ C` and injective `C.skewLaurentSum x`, a left Laurent expansion
`∑_m f(m) * x^m` belongs to `C.laurentAdjoin (E * x⁻¹)` if and only if for every `r > 0`,
`f(-r)` is a left `C`-multiple of `exchangeProduct x E r`. -/
theorem mem_laurentAdjoin_mul_inv_iff {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hE : ConjAct.toConjAct E • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) (f : ℤ →₀ C) :
    C.skewLaurentSum x f ∈ C.laurentAdjoin (E * x⁻¹) ↔
      ∀ r : ℕ, 0 < r →
        ∃ d : C, (f (-(r : ℤ)) : B) = (d : B) * ((exchangeProduct x E r : Bˣ) : B) := by
  constructor
  · intro hmem r _
    have hmem' : C.skewLaurentSum x f ∈ Set.range (C.skewLaurentSum (E * x⁻¹)) := by
      rwa [range_skewLaurentSum (conjAct_mul_inv_smul_eq hx hE)]
    obtain ⟨g, hg⟩ := hmem'
    exact exists_mul_exchangeProduct_of_skewLaurentSum_eq hx hEC hinj hg.symm r
  · intro hd
    obtain ⟨t, ht⟩ := skewLaurentSum_mem_range_exchangeNormalForm hd
    rw [← ht]
    exact (sup_closure_mul_inv_le_inf_laurentAdjoin hEC).trans inf_le_right
      (C.exchangeNormalForm_mem_sup_closure _ _ t)

/-- **Intersection theorem for one-step skew exchange**:
`C[x^{±1}] ⊓ C[(E * x⁻¹)^{±1}] = C⟨x, E * x⁻¹⟩`. -/
theorem laurentAdjoin_inf_laurentAdjoin_mul_inv {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hE : ConjAct.toConjAct E • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) :
    C.laurentAdjoin x ⊓ C.laurentAdjoin (E * x⁻¹) =
      C ⊔ Subsemiring.closure {(x : B), ((E * x⁻¹ : Bˣ) : B)} := by
  refine le_antisymm ?_ (sup_closure_mul_inv_le_inf_laurentAdjoin hEC)
  intro b ⟨hbx, hby⟩
  have hbx' : b ∈ Set.range (C.skewLaurentSum x) := by rwa [range_skewLaurentSum hx]
  obtain ⟨f, rfl⟩ := hbx'
  have hd := (mem_laurentAdjoin_mul_inv_iff hx hE hEC hinj f).mp hby
  obtain ⟨t, ht⟩ := skewLaurentSum_mem_range_exchangeNormalForm hd
  rw [← ht]
  exact C.exchangeNormalForm_mem_sup_closure _ _ t

/-- **Surjectivity of two-sided positive normal forms** onto `C⟨x, E * x⁻¹⟩` (and hence onto
`C[x^{±1}] ⊓ C[(E * x⁻¹)^{±1}]`). -/
theorem range_exchangeNormalForm_mul_inv {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hE : ConjAct.toConjAct E • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) :
    Set.range (C.exchangeNormalForm (x : B) ((E * x⁻¹ : Bˣ) : B)) =
      ((C ⊔ Subsemiring.closure {(x : B), ((E * x⁻¹ : Bˣ) : B)} : Subsemiring B) : Set B) := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨t, rfl⟩
    exact C.exchangeNormalForm_mem_sup_closure _ _ t
  · rw [← laurentAdjoin_inf_laurentAdjoin_mul_inv hx hE hEC hinj]
    rintro b ⟨hbx, hby⟩
    have hbx' : b ∈ Set.range (C.skewLaurentSum x) := by rwa [range_skewLaurentSum hx]
    obtain ⟨f, rfl⟩ := hbx'
    exact skewLaurentSum_mem_range_exchangeNormalForm
      ((mem_laurentAdjoin_mul_inv_iff hx hE hEC hinj f).mp hby)

private noncomputable def normalFormToLaurent {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C)
    (t : C × (ℕ →₀ C) × (ℕ →₀ C)) : ℤ →₀ C :=
  Finsupp.single 0 t.1 +
    (t.2.1.sum fun r c ↦ Finsupp.single ((r + 1 : ℕ) : ℤ) c) +
    (t.2.2.sum fun r c ↦
      Finsupp.single (-((r + 1 : ℕ) : ℤ))
        (c * ⟨((exchangeProduct x E (r + 1) : Bˣ) : B), coe_exchangeProduct_mem hx hEC (r + 1)⟩))

private theorem skewLaurentSum_normalFormToLaurent {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C)
    (t : C × (ℕ →₀ C) × (ℕ →₀ C)) :
    C.skewLaurentSum x (normalFormToLaurent hx hEC t) =
      C.exchangeNormalForm (x : B) ((E * x⁻¹ : Bˣ) : B) t := by
  rw [normalFormToLaurent, map_add, map_add, skewLaurentSum_single, zpow_zero, Units.val_one,
    mul_one, map_finsuppSum, map_finsuppSum, exchangeNormalForm_apply]
  congr 1
  · congr 1
    refine Finsupp.sum_congr fun r _ ↦ ?_
    rw [skewLaurentSum_single, zpow_natCast, Units.val_pow_eq_pow_val]
  · refine Finsupp.sum_congr fun r _ ↦ ?_
    rw [skewLaurentSum_single, Subsemiring.coe_mul, mul_assoc, ← Units.val_mul,
      ← mul_inv_zpow_natCast_eq_exchangeProduct_mul_zpow_neg, zpow_natCast,
      Units.val_pow_eq_pow_val]

private theorem finsupp_sum_single_eq_zero_of_forall_ne {C : Type*} [AddCommMonoid C]
    (f : ℕ →₀ C) (φ : ℕ → ℤ) (g : ℕ → C → C) {m : ℤ} (hm : ∀ r, φ r ≠ m) :
    (f.sum fun r c ↦ Finsupp.single (φ r) (g r c)) m = 0 := by
  rw [Finsupp.sum_apply, Finsupp.sum]
  exact Finset.sum_eq_zero fun r _ ↦ Finsupp.single_eq_of_ne (hm r).symm

/-- **Uniqueness of two-sided positive normal forms**
`c_0 + ∑_r c⁺_r x^{r + 1} + ∑_r c⁻_r y^{r + 1}` for `y = E * x⁻¹`. -/
theorem exchangeNormalForm_mul_inv_injective {C : Subsemiring B} {x E : Bˣ}
    (hx : ConjAct.toConjAct x • C = C) (hEC : (E : B) ∈ C)
    (hinj : Function.Injective (C.skewLaurentSum x)) :
    Function.Injective (C.exchangeNormalForm (x : B) ((E * x⁻¹ : Bˣ) : B)) := by
  have hinj_pos : Function.Injective fun r : ℕ ↦ ((r + 1 : ℕ) : ℤ) := fun a b h ↦ by
    dsimp only at h; omega
  have hinj_neg : Function.Injective fun r : ℕ ↦ -((r + 1 : ℕ) : ℤ) := fun a b h ↦ by
    dsimp only at h; omega
  have hpos0 (u : ℕ →₀ C) (m : ℤ) (hm : ∀ r : ℕ, ((r + 1 : ℕ) : ℤ) ≠ m) :
      (u.sum fun r c ↦ Finsupp.single ((r + 1 : ℕ) : ℤ) c) m = 0 :=
    finsupp_sum_single_eq_zero_of_forall_ne u _ _ hm
  have hneg0 (u : ℕ →₀ C) (m : ℤ) (hm : ∀ r : ℕ, -((r + 1 : ℕ) : ℤ) ≠ m) :
      (u.sum fun r c ↦ Finsupp.single (-((r + 1 : ℕ) : ℤ))
        (c * ⟨((exchangeProduct x E (r + 1) : Bˣ) : B), coe_exchangeProduct_mem hx hEC (r + 1)⟩))
        m = 0 :=
    finsupp_sum_single_eq_zero_of_forall_ne u _ _ hm
  have hpos_at (u : ℕ →₀ C) (s : ℕ) :
      (u.sum fun r c ↦ Finsupp.single ((r + 1 : ℕ) : ℤ) c) ((s + 1 : ℕ) : ℤ) = u s :=
    finsupp_sum_single_apply_of_injective u hinj_pos (fun _ c ↦ c) (fun _ ↦ rfl) s
  have hneg_at (u : ℕ →₀ C) (s : ℕ) :
      (u.sum fun r c ↦ Finsupp.single (-((r + 1 : ℕ) : ℤ))
        (c * ⟨((exchangeProduct x E (r + 1) : Bˣ) : B), coe_exchangeProduct_mem hx hEC (r + 1)⟩))
        (-((s + 1 : ℕ) : ℤ)) =
        u s * ⟨((exchangeProduct x E (s + 1) : Bˣ) : B), coe_exchangeProduct_mem hx hEC (s + 1)⟩ :=
    finsupp_sum_single_apply_of_injective u hinj_neg
      (fun r c ↦ c * ⟨((exchangeProduct x E (r + 1) : Bˣ) : B),
        coe_exchangeProduct_mem hx hEC (r + 1)⟩) (fun _ ↦ zero_mul _) s
  intro t₁ t₂ ht
  have hEq : normalFormToLaurent hx hEC t₁ = normalFormToLaurent hx hEC t₂ :=
    hinj <| by rw [skewLaurentSum_normalFormToLaurent, skewLaurentSum_normalFormToLaurent, ht]
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · have h0 := congrArg (fun g : ℤ →₀ C ↦ g 0) hEq
    simpa only [normalFormToLaurent, Finsupp.add_apply, Finsupp.single_eq_same,
      hpos0 _ 0 (fun _ ↦ by omega), hneg0 _ 0 (fun _ ↦ by omega), add_zero] using h0
  · ext s
    have hs := congrArg (fun g : ℤ →₀ C ↦ (g ((s + 1 : ℕ) : ℤ) : B)) hEq
    simpa only [normalFormToLaurent, Finsupp.add_apply,
      Finsupp.single_eq_of_ne (by omega : ((s + 1 : ℕ) : ℤ) ≠ 0), hpos_at,
      hneg0 _ ((s + 1 : ℕ) : ℤ) (fun _ ↦ by omega), zero_add, add_zero] using hs
  · ext s
    have hs := congrArg (fun g : ℤ →₀ C ↦ (g (-((s + 1 : ℕ) : ℤ)) : B)) hEq
    simp only [normalFormToLaurent, Finsupp.add_apply,
      Finsupp.single_eq_of_ne (by omega : -((s + 1 : ℕ) : ℤ) ≠ 0),
      hpos0 _ (-((s + 1 : ℕ) : ℤ)) (fun _ ↦ by omega), hneg_at, zero_add, Subsemiring.coe_mul] at hs
    exact (Units.mul_left_inj (exchangeProduct x E (s + 1))).mp hs

end Semiring

end Subsemiring

/-! ### Compatibility with subrings -/

namespace Subring

variable {B : Type*} [Ring B]

/-- Adjoining a subset `s` to a subring `S` as a subring has the same underlying subsemiring as
adjoining `s` to `S.toSubsemiring` as a subsemiring, because `-1 ∈ S`. -/
@[simp]
theorem toSubsemiring_sup_closure (S : Subring B) (s : Set B) :
    (S ⊔ Subring.closure s).toSubsemiring = S.toSubsemiring ⊔ Subsemiring.closure s := by
  refine le_antisymm ?_ ?_
  · let T : Subsemiring B := S.toSubsemiring ⊔ Subsemiring.closure s
    have hST : S.toSubsemiring ≤ T := le_sup_left
    have hclT : Subsemiring.closure s ≤ T := le_sup_right
    have hneg1 : (-1 : B) ∈ T := hST (S.neg_mem S.one_mem)
    let T' : Subring B :=
      { T with
        neg_mem' {a} ha := by simpa using T.mul_mem hneg1 ha }
    have hle : S ⊔ Subring.closure s ≤ T' :=
      sup_le (fun b hb ↦ hST hb)
        (Subring.closure_le.mpr fun b hb ↦ hclT (Subsemiring.subset_closure hb))
    exact hle
  · refine sup_le ?_ (Subsemiring.closure_le.mpr fun b hb ↦ ?_)
    · exact fun b hb ↦ (le_sup_left : S ≤ S ⊔ Subring.closure s) hb
    · exact (le_sup_right : Subring.closure s ≤ S ⊔ Subring.closure s) (Subring.subset_closure hb)

/-- The subring `S[x^{±1}] = S ⊔ Subring.closure {x, x⁻¹}` generated by a subring `S` and a unit
`x : Bˣ` together with its inverse. -/
def laurentAdjoin (S : Subring B) (x : Bˣ) : Subring B :=
  S ⊔ Subring.closure {(x : B), ((x⁻¹ : Bˣ) : B)}

@[simp]
theorem toSubsemiring_laurentAdjoin (S : Subring B) (x : Bˣ) :
    (S.laurentAdjoin x).toSubsemiring = S.toSubsemiring.laurentAdjoin x :=
  S.toSubsemiring_sup_closure _

end Subring

/-! ### Concrete checks -/

namespace TauCeti

section Checks

/-- **Quantum binomial check**: when `x * z = v^2 • (z * x)` for a central unit `v` and
`(E : B) = 1 + z`, the second exchange product `(exchangeProduct x E 2 : B)` equals
`(1 + z) * (1 + v⁻² • z)`, so `((E * x⁻¹)^2 : B) = (1 + z) * (1 + v⁻² • z) * x⁻²`. -/
theorem exchangeProduct_two_of_quasiComm {R B : Type*} [CommSemiring R] [Semiring B] [Algebra R B]
    {v : Rˣ} {x E : Bˣ} {z : B}
    (hxz : (x : B) * z = algebraMap R B ((v ^ 2 : Rˣ) : R) * (z * (x : B)))
    (hE : (E : B) = 1 + z) :
    ((exchangeProduct x E 2 : Bˣ) : B) =
      (1 + z) * (1 + algebraMap R B ((v ^ (-2 : ℤ) : Rˣ) : R) * z) := by
  have hconj : ((x⁻¹ : Bˣ) : B) * z * (x : B) = algebraMap R B ((v ^ (-2 : ℤ) : Rˣ) : R) * z := by
    have h1 : ((x⁻¹ : Bˣ) : B) * ((x : B) * z) = z := by
      rw [← mul_assoc, Units.inv_mul, one_mul]
    rw [hxz, ← mul_assoc ((x⁻¹ : Bˣ) : B), ← Algebra.commutes ((v ^ 2 : Rˣ) : R), mul_assoc,
      ← mul_assoc ((x⁻¹ : Bˣ) : B) z] at h1
    have h2 := congrArg (algebraMap R B ((v ^ (-2 : ℤ) : Rˣ) : R) * ·) h1
    rw [← mul_assoc, ← map_mul, ← Units.val_mul] at h2
    have hv : v ^ (-2 : ℤ) * v ^ 2 = 1 := by simp [zpow_ofNat]
    rw [hv, Units.val_one, map_one, one_mul] at h2
    exact h2
  rw [exchangeProduct_two, Units.val_mul, Units.val_mul, Units.val_mul, hE]
  congr 1
  rw [mul_add, mul_one, add_mul, Units.inv_mul, hconj]

private theorem laurentRing_intRange_skewLaurentSum_injective :
    Function.Injective
      (((algebraMap ℤ (LaurentRing ℚ Unit)).rangeS).skewLaurentSum (LaurentRing.unitX ())) := by
  let B := LaurentRing ℚ Unit
  let C : Subsemiring B := (algebraMap ℤ B).rangeS
  let x : Bˣ := LaurentRing.unitX ()
  have halg (z : ℤ) : algebraMap ℤ B z = AddMonoidAlgebra.single 0 (z : ℚ) := by
    rw [IsScalarTower.algebraMap_apply ℤ ℚ B, eq_intCast, Algebra.algebraMap_eq_smul_one,
      AddMonoidAlgebra.one_def, AddMonoidAlgebra.smul_single', mul_one]
  intro f₁ f₂ h
  ext m
  have hm := congrArg (fun p : B ↦ AddMonoidAlgebra.coeff p (Finsupp.single () m)) h
  have heval (f : ℤ →₀ C) :
      AddMonoidAlgebra.coeff (C.skewLaurentSum x f) (Finsupp.single () m) =
        AddMonoidAlgebra.coeff ((f m : C) : B) 0 := by
    rw [Subsemiring.skewLaurentSum_apply, Finsupp.sum, AddMonoidAlgebra.coeff_sum,
      ← Finsupp.lapply_apply (R := ℕ), map_sum]
    have hterm (k : ℤ) :
        AddMonoidAlgebra.coeff (((f k : C) : B) * ((x ^ k : Bˣ) : B))
            (Finsupp.single () m) =
          if k = m then AddMonoidAlgebra.coeff ((f m : C) : B) 0 else 0 := by
      obtain ⟨z, hz⟩ := (f k).2
      have hxk : ((x ^ k : Bˣ) : B) = AddMonoidAlgebra.single (Finsupp.single () k) 1 :=
        LaurentRing.val_unitX_zpow () k
      rw [← hz, halg z, hxk, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
      by_cases hkm : k = m
      · subst hkm
        rw [← hz, halg z]
        simp
      · rw [ite_eq_right_iff.mpr fun h ↦ absurd h hkm]
        simp [(Finsupp.single_injective ()).ne hkm]
    simp only [Finsupp.lapply_apply, hterm]
    by_cases hm_supp : m ∈ f.support
    · simp [hm_supp]
    · rw [Finset.sum_ite_eq', ite_eq_right_iff.mpr fun h ↦ absurd h hm_supp,
        Finsupp.notMem_support_iff.mp hm_supp]
      rfl
  rw [heval, heval] at hm
  obtain ⟨z₁, hz₁⟩ := (f₁ m).2
  obtain ⟨z₂, hz₂⟩ := (f₂ m).2
  have hz : z₁ = z₂ := by
    apply Int.cast_injective (α := ℚ)
    rw [← hz₁, ← hz₂, halg, halg] at hm
    simpa using hm
  rw [← hz₁, ← hz₂, hz]

private theorem intCast_mul_zpow_neg_mem_laurentAdjoin_two_mul_inv_iff (a : ℤ) {s : ℕ}
    (hs : 0 < s) :
    let B := LaurentRing ℚ Unit
    let C : Subsemiring B := (algebraMap ℤ B).rangeS
    let x : Bˣ := LaurentRing.unitX ()
    let E : Bˣ := Units.map (algebraMap ℚ B).toMonoidHom (Units.mk0 2 (by norm_num))
    (a : B) * ((x ^ (-(s : ℤ)) : Bˣ) : B) ∈ C.laurentAdjoin (E * x⁻¹) ↔
      ∃ z : ℤ, a = z * (2 : ℤ) ^ s := by
  intro B C x E
  have hx : ConjAct.toConjAct x • C = C := by
    ext b
    simp [Subsemiring.mem_smul_pointwise_iff_exists, ConjAct.units_smul_def, mul_comm, mul_assoc]
  have hE : ConjAct.toConjAct E • C = C := by
    ext b
    simp [Subsemiring.mem_smul_pointwise_iff_exists, ConjAct.units_smul_def, mul_comm, mul_assoc]
  have hE_val : (E : B) = 2 := map_ofNat (algebraMap ℚ B) 2
  have hEC : (E : B) ∈ C := ⟨2, by rw [map_ofNat, hE_val]⟩
  have hP (r : ℕ) : ((exchangeProduct x E r : Bˣ) : B) = (2 : B) ^ r := by
    rw [exchangeProduct_of_commute (Commute.all x E), Units.val_pow_eq_pow_val, hE_val]
  let ca : C := ⟨(a : B), a, map_intCast _ a⟩
  have hf : (a : B) * ((x ^ (-(s : ℤ)) : Bˣ) : B) =
      C.skewLaurentSum x (Finsupp.single (-(s : ℤ)) ca) := by simp [ca]
  rw [hf, Subsemiring.mem_laurentAdjoin_mul_inv_iff hx hE hEC
    laurentRing_intRange_skewLaurentSum_injective]
  constructor
  · intro hall
    obtain ⟨⟨_, z, rfl⟩, hz⟩ := hall s hs
    rw [Finsupp.single_eq_same, hP] at hz
    let ev1 : B →ₐ[ℚ] ℚ := LaurentRing.aeval fun _ ↦ 1
    have hev := congrArg ev1 hz
    dsimp only [ca] at hev
    rw [map_intCast, map_mul, eq_intCast, map_intCast, map_pow, map_ofNat] at hev
    exact ⟨z, by exact_mod_cast hev⟩
  · rintro ⟨z, rfl⟩ r _
    by_cases hrs : r = s
    · subst hrs
      refine ⟨⟨(z : B), z, map_intCast _ z⟩, ?_⟩
      rw [Finsupp.single_eq_same, hP]
      dsimp only [ca]
      push_cast
      rfl
    · have hne : -(s : ℤ) ≠ -(r : ℤ) := by omega
      exact ⟨0, by simp [Finsupp.single_eq_of_ne hne.symm]⟩

/-- **Rank-one `y = 2 / x` exchange check over `ℤ`**: inside `ℚ[x^{±1}]` with coefficient subring
`C = ℤ`, for `y = 2 * x⁻¹`, the elements `2 * x⁻¹` and `4 * x⁻²` belong to
`C[x^{±1}] ⊓ C[y^{±1}]`, whereas `x⁻¹` and `2 * x⁻²` do not belong to `C[y^{±1}]`. -/
theorem two_mul_inv_exchange_check :
    let B := LaurentRing ℚ Unit
    let C : Subsemiring B := (algebraMap ℤ B).rangeS
    let x : Bˣ := LaurentRing.unitX ()
    let E : Bˣ := Units.map (algebraMap ℚ B).toMonoidHom (Units.mk0 2 (by norm_num))
    (2 : B) * ((x⁻¹ : Bˣ) : B) ∈ C.laurentAdjoin x ⊓ C.laurentAdjoin (E * x⁻¹) ∧
      (4 : B) * ((x ^ (-2 : ℤ) : Bˣ) : B) ∈ C.laurentAdjoin x ⊓ C.laurentAdjoin (E * x⁻¹) ∧
      ((x⁻¹ : Bˣ) : B) ∉ C.laurentAdjoin (E * x⁻¹) ∧
      (2 : B) * ((x ^ (-2 : ℤ) : Bˣ) : B) ∉ C.laurentAdjoin (E * x⁻¹) := by
  intro B C x E
  have h2C : (2 : B) ∈ C := ⟨2, map_ofNat _ 2⟩
  have h4C : (4 : B) ∈ C := ⟨4, map_ofNat _ 4⟩
  refine ⟨Subsemiring.mem_inf.mpr ⟨?_, ?_⟩, Subsemiring.mem_inf.mpr ⟨?_, ?_⟩, ?_, ?_⟩
  · exact (C.laurentAdjoin x).mul_mem (C.le_laurentAdjoin x h2C) (C.coe_inv_mem_laurentAdjoin x)
  · simpa only [Int.cast_ofNat, Nat.cast_one, zpow_neg_one] using
      (intCast_mul_zpow_neg_mem_laurentAdjoin_two_mul_inv_iff 2 (s := 1) (by omega)).mpr
        ⟨1, by omega⟩
  · exact (C.laurentAdjoin x).mul_mem (C.le_laurentAdjoin x h4C)
      (C.coe_zpow_mem_laurentAdjoin x (-2))
  · simpa only [Int.cast_ofNat, Nat.cast_ofNat] using
      (intCast_mul_zpow_neg_mem_laurentAdjoin_two_mul_inv_iff 4 (s := 2) (by omega)).mpr
        ⟨1, by omega⟩
  · intro h
    have h1 : ((1 : ℤ) : B) * ((x ^ (-(1 : ℕ) : ℤ) : Bˣ) : B) ∈ C.laurentAdjoin (E * x⁻¹) := by
      simpa only [Int.cast_one, one_mul, Nat.cast_one, zpow_neg_one] using h
    obtain ⟨z, hz⟩ :=
      (intCast_mul_zpow_neg_mem_laurentAdjoin_two_mul_inv_iff 1 (s := 1) (by omega)).mp h1
    omega
  · intro h
    have h2 : ((2 : ℤ) : B) * ((x ^ (-(2 : ℕ) : ℤ) : Bˣ) : B) ∈ C.laurentAdjoin (E * x⁻¹) := by
      simpa only [Int.cast_ofNat, Nat.cast_ofNat] using h
    obtain ⟨z, hz⟩ :=
      (intCast_mul_zpow_neg_mem_laurentAdjoin_two_mul_inv_iff 2 (s := 2) (by omega)).mp h2
    omega

end Checks

end TauCeti
