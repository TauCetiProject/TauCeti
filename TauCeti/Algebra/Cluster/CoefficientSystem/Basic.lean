/-!
# Coefficient systems

A *coefficient system* over a commutative semiring `R` specifies a commutative monoid with zero
`𝕂` in which the coefficients of exchange polynomials live, a multiplicative scalar map
`φ : 𝕂 →*₀ R` (which need not be additive or injective), and a normalizer
`ν : ExchangePolynomial 𝕂 → 𝕂ˣ` satisfying two axioms:

* reversal invariance: `ν(H.reverse) = ν(H)`;
* scaling homogeneity along its own values: `ν(H.scale (ν H')) * ν(H') = ν(H)`.

Two fundamental instances arise in cluster algebra theory:

* `TauCeti.CoefficientSystem.trivial R`, the *scalar system* with `𝕂 = R`, `φ = id`, and `ν = 1`,
  whose state mutation is unnormalized polynomial mutation;
* `TauCeti.CoefficientSystem.ofSemifield φ`, the *normalized system* of a zero-sum-free semifield
  `F` (such as `ℚ≥0`, or `WithZero P` for a coefficient semifield `P`), with
  `ν(H) = (∑ l, H.coeff l)⁻¹`, whose normalized polynomials satisfy `∑ l, H.coeff l = 1`.

Because `φ` need not preserve addition or be injective, the normalizer in `ofSemifield` must be
formed in `F` before `φ` is applied.

## Main definitions

* `TauCeti.CoefficientSystem 𝕂 R`: a coefficient system with coefficients in `𝕂` over scalars `R`.
* `TauCeti.CoefficientSystem.normalize`: the normalized polynomial `N(H) = ν(H) H`.
* `TauCeti.CoefficientSystem.IsNormalized`: the predicate `ν(H) = 1`.
* `TauCeti.CoefficientSystem.normalizerSubgroup`: the subgroup `G_ν ≤ 𝕂ˣ` generated by the values
  of `ν`.
* `TauCeti.CoefficientSystem.ofTransversal`: construction of a coefficient system from a subgroup
  `G ≤ 𝕂ˣ` and a reversal-stable transversal of the `G`-scaling orbits.
* `TauCeti.CoefficientSystem.trivial`: the scalar system on `R` with trivial normalizer.
* `TauCeti.CoefficientSystem.ofSemifield`: the sum-normalized system of a semifield with trivial
  additive units.

## Main results

* `TauCeti.CoefficientSystem.normalize_normalize`: normalization `N` is idempotent.
* `TauCeti.CoefficientSystem.normalizer_scale_of_mem`: `ν` is homogeneous of degree `-1` with
  respect to the subgroup `G_ν` generated by its values.
* `TauCeti.CoefficientSystem.existsUnique_mem_normalizerSubgroup_isNormalized_scale` and
  `TauCeti.CoefficientSystem.ofTransversal_eq_self`: normalized polynomials form a reversal-stable
  orbit transversal for `G_ν`, and conversely any subgroup and reversal-stable transversal
  uniquely determine the normalizer.

## References

* S. Fomin and A. Zelevinsky, *Cluster algebras I: Foundations*, J. Amer. Math. Soc. 15 (2002),
  Definition 5.3, for semifield normalization in degree one.
* T. Nakanishi, *Structure of seeds in generalized cluster algebras*, Pacific J. Math. 277 (2015),
  (2.14), for normalization of higher-degree exchange polynomials.
-/

public section

namespace TauCeti

/-- A *coefficient system* over a commutative semiring `R`: a commutative monoid with zero `𝕂` in
which polynomial coefficients live, a multiplicative map `toScalar : 𝕂 →*₀ R` (which need not be
additive or injective), and a normalizer `normalizer : ExchangePolynomial 𝕂 → 𝕂ˣ` invariant under
reversal and homogeneous of degree `-1` for the units it produces. -/
@[ext]
structure CoefficientSystem (𝕂 : Type*) [CommMonoidWithZero 𝕂] (R : Type*) [CommSemiring R] where
  /-- Multiplicative map sending coefficients in `𝕂` to scalars in `R`. -/
  toScalar : 𝕂 →*₀ R
  /-- Normalizing unit attached to each exchange polynomial over `𝕂`. -/
  normalizer : ExchangePolynomial 𝕂 → 𝕂ˣ
  /-- Reversing an exchange polynomial leaves its normalizer unchanged. -/
  normalizer_reverse : ∀ H, normalizer H.reverse = normalizer H
  /-- Scaling by any normalizer value multiplies the normalizer by the inverse unit. -/
  normalizer_scale : ∀ H H', normalizer (H.scale (normalizer H')) * normalizer H' = normalizer H

attribute [simp] CoefficientSystem.normalizer_reverse

namespace CoefficientSystem

section General

variable {𝕂 : Type*} [CommMonoidWithZero 𝕂] {R : Type*} [CommSemiring R]
  (c : CoefficientSystem 𝕂 R)

/-- The normalized multiple `ν(H) H` of an exchange polynomial. -/
def normalize (H : ExchangePolynomial 𝕂) : ExchangePolynomial 𝕂 :=
  H.scale (c.normalizer H)

theorem normalize_def (H : ExchangePolynomial 𝕂) : c.normalize H = H.scale (c.normalizer H) :=
  (rfl)

@[simp]
theorem normalize_degree (H : ExchangePolynomial 𝕂) : (c.normalize H).degree = H.degree := by
  simp [normalize_def]

@[simp]
theorem normalize_coeff (H : ExchangePolynomial 𝕂) (l : Fin ((c.normalize H).degree + 1)) :
    (c.normalize H).coeff l =
      (c.normalizer H : 𝕂) * H.coeff (l.cast (by rw [normalize_degree])) :=
  H.scale_coeff (c.normalizer H) l

/-- An exchange polynomial is *normalized* for `c` when its normalizer is `1`. -/
def IsNormalized (H : ExchangePolynomial 𝕂) : Prop :=
  c.normalizer H = 1

theorem isNormalized_iff {H : ExchangePolynomial 𝕂} : c.IsNormalized H ↔ c.normalizer H = 1 :=
  Iff.rfl

@[simp]
theorem normalizer_normalize (H : ExchangePolynomial 𝕂) : c.normalizer (c.normalize H) = 1 :=
  (mul_left_inj (c.normalizer H)).mp (by simpa [normalize_def] using c.normalizer_scale H H)

@[simp]
theorem isNormalized_normalize (H : ExchangePolynomial 𝕂) : c.IsNormalized (c.normalize H) :=
  c.normalizer_normalize H

protected theorem IsNormalized.normalize_eq {H : ExchangePolynomial 𝕂} (h : c.IsNormalized H) :
    c.normalize H = H := by
  rw [normalize_def, h, H.scale_one]

/-- An exchange polynomial is normalized if and only if normalization fixes it. -/
theorem isNormalized_iff_normalize_eq {H : ExchangePolynomial 𝕂} :
    c.IsNormalized H ↔ c.normalize H = H :=
  ⟨fun h ↦ h.normalize_eq, fun h ↦ H.scale_eq_self_iff.mp h⟩

/-- Normalization is idempotent. -/
@[simp]
theorem normalize_normalize (H : ExchangePolynomial 𝕂) :
    c.normalize (c.normalize H) = c.normalize H :=
  (c.isNormalized_normalize H).normalize_eq

@[simp]
theorem normalize_reverse (H : ExchangePolynomial 𝕂) :
    c.normalize H.reverse = (c.normalize H).reverse := by
  simp [normalize_def]

protected theorem IsNormalized.reverse {H : ExchangePolynomial 𝕂} (h : c.IsNormalized H) :
    c.IsNormalized H.reverse := by
  simpa [IsNormalized] using h

@[simp]
theorem isNormalized_reverse_iff {H : ExchangePolynomial 𝕂} :
    c.IsNormalized H.reverse ↔ c.IsNormalized H := by
  simp [IsNormalized]

/-! ### Value subgroup and orbit transversals -/

/-- The subgroup `G_ν ≤ 𝕂ˣ` generated by all values of the normalizer. -/
def normalizerSubgroup : Subgroup 𝕂ˣ :=
  Subgroup.closure (Set.range c.normalizer)

theorem normalizerSubgroup_def : c.normalizerSubgroup = Subgroup.closure (Set.range c.normalizer) :=
  (rfl)

theorem normalizer_mem_normalizerSubgroup (H : ExchangePolynomial 𝕂) :
    c.normalizer H ∈ c.normalizerSubgroup :=
  Subgroup.subset_closure ⟨H, rfl⟩

/-- The normalizer is homogeneous of degree `-1` for the subgroup `G_ν` generated by its values. -/
theorem normalizer_scale_of_mem {u : 𝕂ˣ} (hu : u ∈ c.normalizerSubgroup)
    (H : ExchangePolynomial 𝕂) :
    c.normalizer (H.scale u) = u⁻¹ * c.normalizer H := by
  induction hu using Subgroup.closure_induction generalizing H with
  | mem x hx =>
    obtain ⟨H', rfl⟩ := hx
    exact eq_inv_mul_of_mul_eq (by rw [mul_comm, c.normalizer_scale])
  | one => simp
  | mul x y _ _ ihx ihy =>
    rw [mul_comm x y, ← H.scale_scale, ihy, ihx, mul_inv, mul_assoc]
  | inv x _ ihx =>
    have h := ihx (H.scale x⁻¹)
    rw [ExchangePolynomial.scale_scale, mul_inv_cancel, H.scale_one] at h
    rw [h, inv_inv, mul_inv_cancel_left]

/-- Normalization is invariant under scaling by any element of `G_ν`. -/
theorem normalize_scale_of_mem {u : 𝕂ˣ} (hu : u ∈ c.normalizerSubgroup)
    (H : ExchangePolynomial 𝕂) :
    c.normalize (H.scale u) = c.normalize H := by
  rw [normalize_def, normalize_def, c.normalizer_scale_of_mem hu H, ExchangePolynomial.scale_scale]
  congr 1
  rw [mul_comm _ u, mul_inv_cancel_left]

@[simp]
theorem normalize_scale_normalizer (H H' : ExchangePolynomial 𝕂) :
    c.normalize (H.scale (c.normalizer H')) = c.normalize H :=
  c.normalize_scale_of_mem (c.normalizer_mem_normalizerSubgroup H') H

/-- The normalized polynomials form a set of orbit representatives for the scaling action of `G_ν`:
every `G_ν`-orbit meets `{H | c.IsNormalized H}` in a unique element. -/
theorem existsUnique_mem_normalizerSubgroup_isNormalized_scale (H : ExchangePolynomial 𝕂) :
    ∃! u : c.normalizerSubgroup, c.IsNormalized (H.scale u.val) := by
  refine ⟨⟨c.normalizer H, c.normalizer_mem_normalizerSubgroup H⟩, c.isNormalized_normalize H, ?_⟩
  rintro ⟨u, hu⟩ hnorm
  have h1 : u⁻¹ * c.normalizer H = 1 := by
    rw [← c.normalizer_scale_of_mem hu H]
    exact hnorm
  exact Subtype.ext (inv_mul_eq_one.mp h1)

/-- Construct a coefficient system from a scalar map, a subgroup `G ≤ 𝕂ˣ`, and a reversal-stable
transversal `S` of the `G`-scaling orbits on `ExchangePolynomial 𝕂`. -/
noncomputable def ofTransversal (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂)) (hrev : ∀ ⦃H⦄, H ∈ S → H.reverse ∈ S)
    (htrans : ∀ H : ExchangePolynomial 𝕂, ∃! u : G, H.scale u.val ∈ S) :
    CoefficientSystem 𝕂 R where
  toScalar := toScalar
  normalizer H := ((htrans H).choose : 𝕂ˣ)
  normalizer_reverse H := by
    have hu : H.reverse.scale ((htrans H).choose : 𝕂ˣ) ∈ S := by
      rw [← ExchangePolynomial.reverse_scale]
      exact hrev (htrans H).choose_spec.1
    exact congrArg Subtype.val ((htrans H.reverse).choose_spec.2 _ hu).symm
  normalizer_scale H H' := by
    let u : G := (htrans H).choose
    let g : G := (htrans H').choose
    have hmem : (H.scale g.val).scale (u * g⁻¹ : G).val ∈ S := by
      have hg : (u * g⁻¹ : G).val * g.val = u.val := by simp [mul_assoc]
      rw [ExchangePolynomial.scale_scale, hg]
      exact (htrans H).choose_spec.1
    have heq : ((htrans (H.scale g.val)).choose : 𝕂ˣ) = (u * g⁻¹ : G).val :=
      congrArg Subtype.val ((htrans (H.scale g.val)).choose_spec.2 _ hmem).symm
    calc ((htrans (H.scale g.val)).choose : 𝕂ˣ) * g.val
        = (u * g⁻¹ : G).val * g.val := by rw [heq]
      _ = u.val := by simp [mul_assoc]

@[simp]
theorem ofTransversal_toScalar (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂)) (hrev : ∀ ⦃H⦄, H ∈ S → H.reverse ∈ S)
    (htrans : ∀ H : ExchangePolynomial 𝕂, ∃! u : G, H.scale u.val ∈ S) :
    (ofTransversal toScalar G S hrev htrans).toScalar = toScalar :=
  (rfl)

theorem ofTransversal_normalizer_mem (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂)) (hrev : ∀ ⦃H⦄, H ∈ S → H.reverse ∈ S)
    (htrans : ∀ H : ExchangePolynomial 𝕂, ∃! u : G, H.scale u.val ∈ S)
    (H : ExchangePolynomial 𝕂) :
    (ofTransversal toScalar G S hrev htrans).normalizer H ∈ G :=
  ((htrans H).choose).prop

@[simp]
theorem isNormalized_ofTransversal_iff (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂)) (hrev : ∀ ⦃H⦄, H ∈ S → H.reverse ∈ S)
    (htrans : ∀ H : ExchangePolynomial 𝕂, ∃! u : G, H.scale u.val ∈ S)
    {H : ExchangePolynomial 𝕂} :
    (ofTransversal toScalar G S hrev htrans).IsNormalized H ↔ H ∈ S := by
  constructor
  · intro h
    have hmem : H.scale ((htrans H).choose : 𝕂ˣ) ∈ S := (htrans H).choose_spec.1
    have heq : ((htrans H).choose : 𝕂ˣ) = 1 := h
    rw [heq, H.scale_one] at hmem
    exact hmem
  · intro hS
    have h1 : H.scale (1 : G).val ∈ S := by simpa using hS
    have hu : (1 : G) = (htrans H).choose := (htrans H).choose_spec.2 1 h1
    exact congrArg Subtype.val hu.symm

theorem normalizerSubgroup_ofTransversal_le (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂)) (hrev : ∀ ⦃H⦄, H ∈ S → H.reverse ∈ S)
    (htrans : ∀ H : ExchangePolynomial 𝕂, ∃! u : G, H.scale u.val ∈ S) :
    (ofTransversal toScalar G S hrev htrans).normalizerSubgroup ≤ G :=
  (Subgroup.closure_le G).mpr <| by
    rintro _ ⟨H, rfl⟩
    exact ofTransversal_normalizer_mem toScalar G S hrev htrans H

/-- A coefficient system is uniquely recovered from its scalar map, its normalizer subgroup, and
its set of normalized polynomials. -/
theorem ofTransversal_eq_self :
    ofTransversal c.toScalar c.normalizerSubgroup {H | c.IsNormalized H}
        (fun _ h ↦ h.reverse) c.existsUnique_mem_normalizerSubgroup_isNormalized_scale = c := by
  ext : 1
  · rfl
  · funext H
    let c' := ofTransversal c.toScalar c.normalizerSubgroup {H | c.IsNormalized H}
      (fun _ h ↦ h.reverse) c.existsUnique_mem_normalizerSubgroup_isNormalized_scale
    have hnorm : c.IsNormalized (H.scale (c'.normalizer H)) := by
      have : c'.normalize H ∈ {H | c.IsNormalized H} :=
        (isNormalized_ofTransversal_iff _ _ _ _ _).mp (c'.isNormalized_normalize H)
      simpa [normalize_def] using this
    have hmem : c'.normalizer H ∈ c.normalizerSubgroup :=
      ofTransversal_normalizer_mem _ _ _ _ _ H
    have hnorm_c : c.IsNormalized (H.scale (c.normalizer H)) := by
      simpa only [normalize_def] using c.isNormalized_normalize H
    have huniq : (⟨c'.normalizer H, hmem⟩ : c.normalizerSubgroup) =
        ⟨c.normalizer H, c.normalizer_mem_normalizerSubgroup H⟩ :=
      (c.existsUnique_mem_normalizerSubgroup_isNormalized_scale H).unique hnorm hnorm_c
    exact congrArg Subtype.val huniq

end General

/-! ### The scalar system -/

/-- The *scalar coefficient system* on `R`: polynomial coefficients live directly in `R`, the
scalar map is the identity, and the normalizer is identically `1`. Its mutation on exchange data is
unnormalized polynomial mutation. -/
def trivial (R : Type*) [CommSemiring R] : CoefficientSystem R R where
  toScalar := MonoidWithZeroHom.id R
  normalizer _ := 1
  normalizer_reverse _ := rfl
  normalizer_scale _ _ := one_mul 1

section Trivial

variable {R : Type*} [CommSemiring R]

@[simp]
theorem trivial_toScalar : (trivial R).toScalar = MonoidWithZeroHom.id R :=
  (rfl)

@[simp]
theorem trivial_normalizer (H : ExchangePolynomial R) : (trivial R).normalizer H = 1 :=
  (rfl)

@[simp]
theorem trivial_normalize (H : ExchangePolynomial R) : (trivial R).normalize H = H :=
  H.scale_one

@[simp]
theorem isNormalized_trivial (H : ExchangePolynomial R) : (trivial R).IsNormalized H :=
  trivial_normalizer H

@[simp]
theorem normalizerSubgroup_trivial : (trivial R).normalizerSubgroup = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro u hu
  exact (Subgroup.closure_le ⊥).mpr (by rintro _ ⟨H, rfl⟩; simp) hu

end Trivial

/-! ### Normalized systems from zero-sum-free semifields -/

section Semifield

variable {F : Type*} [Semifield F] [Subsingleton (AddUnits F)] {R : Type*} [CommSemiring R]

/-- In a semifield with trivial additive units, the sum of all coefficients of an exchange
polynomial is nonzero because its constant coefficient is a unit. -/
theorem sum_coeff_ne_zero (H : ExchangePolynomial F) : ∑ l, H.coeff l ≠ 0 := by
  intro hsum
  have h0 : H.coeff 0 = 0 := (Finset.sum_eq_zero_iff.mp hsum) 0 (Finset.mem_univ 0)
  exact H.coeff_zero_ne_zero h0

/-- The *normalized coefficient system* of a semifield `F` in which nonzero elements have nonzero
sums (`[Subsingleton (AddUnits F)]`), along a multiplicative map `φ : F →*₀ R`: the normalizer is
`ν(H) = (∑ l, H.coeff l)⁻¹`, formed in `F` before `φ` is applied. -/
noncomputable def ofSemifield (φ : F →*₀ R) : CoefficientSystem F R where
  toScalar := φ
  normalizer H := (Units.mk0 (∑ l, H.coeff l) (sum_coeff_ne_zero H))⁻¹
  normalizer_reverse H := by
    apply inv_inj.mpr
    ext
    exact H.sum_reverse_coeff fun x ↦ x
  normalizer_scale H H' := by
    set u := (Units.mk0 (∑ l, H'.coeff l) (sum_coeff_ne_zero H'))⁻¹
    have hscale : ∑ l, (H.scale u).coeff l = (u : F) * ∑ l, H.coeff l := by
      rw [H.sum_scale_coeff u (fun x ↦ x), ← Finset.mul_sum]
    have hmk : Units.mk0 (∑ l, (H.scale u).coeff l) (sum_coeff_ne_zero (H.scale u)) =
        u * Units.mk0 (∑ l, H.coeff l) (sum_coeff_ne_zero H) := Units.ext hscale
    rw [hmk, mul_inv, mul_comm (u⁻¹), inv_mul_cancel_right]

@[simp]
theorem ofSemifield_toScalar (φ : F →*₀ R) : (ofSemifield φ).toScalar = φ :=
  (rfl)

@[simp]
theorem val_ofSemifield_normalizer (φ : F →*₀ R) (H : ExchangePolynomial F) :
    (((ofSemifield φ).normalizer H : Fˣ) : F) = (∑ l, H.coeff l)⁻¹ := by
  simp [ofSemifield]

theorem ofSemifield_normalizer_scale (φ : F →*₀ R) (u : Fˣ) (H : ExchangePolynomial F) :
    (ofSemifield φ).normalizer (H.scale u) = u⁻¹ * (ofSemifield φ).normalizer H := by
  ext
  rw [val_ofSemifield_normalizer, Units.val_mul, Units.val_inv_eq_inv_val,
    val_ofSemifield_normalizer, H.sum_scale_coeff u (fun x ↦ x), ← Finset.mul_sum, mul_inv]

@[simp]
theorem isNormalized_ofSemifield_iff (φ : F →*₀ R) {H : ExchangePolynomial F} :
    (ofSemifield φ).IsNormalized H ↔ ∑ l, H.coeff l = 1 := by
  rw [isNormalized_iff, Units.ext_iff, val_ofSemifield_normalizer, Units.val_one, inv_eq_one]

@[simp]
theorem normalizerSubgroup_ofSemifield (φ : F →*₀ R) :
    (ofSemifield φ).normalizerSubgroup = ⊤ := by
  rw [eq_top_iff]
  intro u _
  let H₀ : ExchangePolynomial F := ExchangePolynomial.binary
  have hv₀ : (ofSemifield φ).normalizer H₀ ∈ (ofSemifield φ).normalizerSubgroup :=
    (ofSemifield φ).normalizer_mem_normalizerSubgroup H₀
  have huv₀ : u * (ofSemifield φ).normalizer H₀ ∈ (ofSemifield φ).normalizerSubgroup := by
    have h := (ofSemifield φ).normalizer_mem_normalizerSubgroup (H₀.scale u⁻¹)
    rwa [ofSemifield_normalizer_scale, inv_inv] at h
  simpa only [mul_inv_cancel_right] using
    (ofSemifield φ).normalizerSubgroup.mul_mem huv₀ ((ofSemifield φ).normalizerSubgroup.inv_mem hv₀)

theorem val_ofSemifield_normalizer_binomial (φ : F →*₀ R) (y : Fˣ) :
    (((ofSemifield φ).normalizer (ExchangePolynomial.binomial y) : Fˣ) : F) =
      (1 + (y : F))⁻¹ := by
  rw [val_ofSemifield_normalizer]
  congr 1
  let e : Fin ((ExchangePolynomial.binomial y).degree + 1) ≃ Fin 2 :=
    finCongr (by simp)
  rw [← Equiv.sum_comp e.symm, Fin.sum_univ_two]
  simp [e]

end Semifield

/-! ### Checks -/

/-- The positive-sum normalizer `ν(H) = (∑_l h_l)⁻¹` on `ℚ≥0` with scalar cast into `ℚ` forms a
coefficient system. -/
noncomputable example : CoefficientSystem ℚ≥0 ℚ :=
  ofSemifield NNRat.coeHom.toMonoidWithZeroHom

/-- Over `ℚ≥0`, normalizing by the inverse constant term `h_0⁻¹` violates reversal invariance:
`1 + 2T` has constant term `1`, whereas its reversal `2 + T` has constant term `2`. -/
example : ¬ ∀ H : ExchangePolynomial ℚ≥0,
    (H.reverse.isUnit_coeff_zero.unit)⁻¹ = (H.isUnit_coeff_zero.unit)⁻¹ := by
  intro h
  let u2 : ℚ≥0ˣ := Units.mk0 (2 : ℚ≥0) (by simp)
  have h2 := h (ExchangePolynomial.binomial u2)
  have h0 : (ExchangePolynomial.binomial u2).isUnit_coeff_zero.unit = 1 := Units.ext (by simp)
  have h1 : (ExchangePolynomial.binomial u2).isUnit_coeff_last.unit = u2 := Units.ext (by simp)
  rw [ExchangePolynomial.unit_reverse_zero, h0, h1] at h2
  have hval : (2 : ℚ≥0)⁻¹ = 1 := by simpa [u2] using congrArg Units.val h2
  have h12 : (1 : ℚ≥0) = 2 := by
    calc (1 : ℚ≥0) = 2 * 2⁻¹ := (mul_inv_cancel₀ (by simp)).symm
      _ = 2 * 1 := by rw [hval]
      _ = 2 := mul_one 2
  simp at h12

/-- Over `ℚ≥0`, the constant map `ν(H) = 2` violates the scaling axiom
`ν(ν(H') H) * ν(H') = ν(H)`. -/
example :
    let u : ℚ≥0ˣ := Units.mk0 (2 : ℚ≥0) (by simp)
    u * u ≠ u := by
  intro u h
  have hu : u = 1 := (mul_left_inj u).mp (h.trans (one_mul u).symm)
  have hval : (2 : ℚ≥0) = 1 := congrArg Units.val hu
  simp at hval

end CoefficientSystem

