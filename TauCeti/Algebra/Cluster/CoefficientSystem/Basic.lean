/-!
# Coefficient systems

A *coefficient system* over a commutative semiring `R` specifies a commutative monoid with zero `𝕂`
in which the coefficients of exchange polynomials live, a multiplicative map `toScalar : 𝕂 →*₀ R`
sending those coefficients to scalars (which need not be additive or injective), and a normalizer
`ν : ExchangePolynomial 𝕂 → 𝕂ˣ` choosing a unit multiple `N(H) = ν(H) H` of each exchange
polynomial.

The two normalizer axioms—invariance under polynomial reversal and homogeneity of degree `-1` for
the values of `ν`—are exactly what make polynomial mutation involutive on normalized exchange data.
They imply that `N` is idempotent, that reversal preserves normalized polynomials, that `ν` is
homogeneous of degree `-1` on the subgroup `G_ν ≤ 𝕂ˣ` generated by its values, and that the
normalized polynomials form a reversal-stable set of orbit representatives for the scaling action
of `G_ν`. Conversely, any subgroup `G ≤ 𝕂ˣ` together with a reversal-stable set of orbit
representatives uniquely determines a normalizer.

## Main definitions

* `TauCeti.CoefficientSystem 𝕂 R`: a coefficient system over `R` with coefficients in `𝕂`.
* `TauCeti.CoefficientSystem.normalize`: the normalized multiple `ν(H) H`.
* `TauCeti.CoefficientSystem.IsNormalized`: the predicate `ν(H) = 1`.
* `TauCeti.CoefficientSystem.normalizerSubgroup`: the subgroup `G_ν ≤ 𝕂ˣ` generated by the values
  of `ν`.
* `TauCeti.CoefficientSystem.ofSubgroup`: construct a coefficient system from a subgroup `G ≤ 𝕂ˣ`
  and a reversal-stable set of orbit representatives for scaling by `G`.
* `TauCeti.CoefficientSystem.trivial`: the scalar system with `𝕂 = R`, `toScalar = id`, and `ν = 1`.
* `TauCeti.CoefficientSystem.mapScalar`: push forward the scalar map along a semiring homomorphism.
* `TauCeti.CoefficientSystem.Hom`: maps of coefficient systems over a fixed base semiring `R`.

## Main results

* `TauCeti.CoefficientSystem.normalize_normalize`: normalization is idempotent.
* `TauCeti.CoefficientSystem.normalizer_scale_of_mem`: `ν` is homogeneous of degree `-1` on `G_ν`.
* `TauCeti.CoefficientSystem.existsUnique_scale_isNormalized`: the normalized polynomials are orbit
  representatives for the scaling action of `G_ν`.
* `TauCeti.CoefficientSystem.isNormalized_ofSubgroup_iff`,
  `TauCeti.CoefficientSystem.normalizerSubgroup_ofSubgroup`,
  `TauCeti.CoefficientSystem.ofSubgroup_normalizerSubgroup`: the bijection between normalizers and
  pairs `(G, S)` of a unit subgroup and a reversal-stable set of orbit representatives.

## References

* S. Fomin and A. Zelevinsky, *Cluster algebras I: Foundations*, J. Amer. Math. Soc. 15 (2002),
  §5, for normalized exchange coefficients.
* T. Nakanishi, *Structure of seeds in generalized cluster algebras*, Pacific J. Math. 277
  (2015), §2, for normalized generalized exchange polynomials.
-/

public section

namespace TauCeti

/-- A *coefficient system* over a commutative semiring `R`: a coefficient monoid with zero `𝕂`,
a `MonoidWithZeroHom` to `R` (not required to be additive or injective), and a normalizer assigning
a unit `ν(H) ∈ 𝕂ˣ` to every exchange polynomial `H` over `𝕂` that is invariant under reversal and
homogeneous of degree `-1` for the units it produces. -/
@[ext]
structure CoefficientSystem (𝕂 : Type*) [CommMonoidWithZero 𝕂] (R : Type*) [CommSemiring R] where
  /-- The multiplicative map sending coefficients to scalars. -/
  toScalar : 𝕂 →*₀ R
  /-- The normalizer assigning a scaling unit to each exchange polynomial. -/
  normalizer : ExchangePolynomial 𝕂 → 𝕂ˣ
  /-- The normalizer is invariant under polynomial reversal. -/
  normalizer_reverse : ∀ H, normalizer H.reverse = normalizer H
  /-- The normalizer is homogeneous of degree `-1` for the units it produces. -/
  normalizer_scale : ∀ H H', normalizer (H.scale (normalizer H')) * normalizer H' = normalizer H

namespace CoefficientSystem

variable {𝕂 𝕂₁ 𝕂₂ 𝕂₃ : Type*} [CommMonoidWithZero 𝕂] [CommMonoidWithZero 𝕂₁]
  [CommMonoidWithZero 𝕂₂] [CommMonoidWithZero 𝕂₃]
  {R S : Type*} [CommSemiring R] [CommSemiring S]

/-- The normalized multiple `ν(H) H` of an exchange polynomial `H`. -/
def normalize (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) : ExchangePolynomial 𝕂 :=
  H.scale (c.normalizer H)

theorem normalize_def (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalize H = H.scale (c.normalizer H) :=
  (rfl)

@[simp]
theorem normalize_degree (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    (c.normalize H).degree = H.degree :=
  H.scale_degree (c.normalizer H)

/-- An exchange polynomial is *normalized* when its normalizer is `1`. -/
def IsNormalized (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) : Prop :=
  c.normalizer H = 1

theorem isNormalized_iff (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.IsNormalized H ↔ c.normalizer H = 1 :=
  Iff.rfl

/-- The normalizer of a normalized polynomial is `1`. -/
@[simp]
theorem normalizer_normalize (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalizer (c.normalize H) = 1 :=
  mul_eq_right.mp (c.normalizer_scale H H)

/-- Every normalized multiple `c.normalize H` is normalized. -/
@[simp]
theorem isNormalized_normalize (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.IsNormalized (c.normalize H) :=
  c.normalizer_normalize H

/-- An exchange polynomial is fixed by `normalize` if and only if it is normalized. -/
@[simp]
theorem normalize_eq_self_iff (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalize H = H ↔ c.IsNormalized H :=
  H.scale_eq_self_iff (c.normalizer H)

/-- Normalization is idempotent. -/
@[simp]
theorem normalize_normalize (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalize (c.normalize H) = c.normalize H :=
  (c.normalize_eq_self_iff _).mpr (c.isNormalized_normalize H)

/-- Normalization commutes with polynomial reversal. -/
@[simp]
theorem normalize_reverse (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalize H.reverse = (c.normalize H).reverse := by
  simp [normalize_def, c.normalizer_reverse]

/-- Reversal preserves and reflects normalized polynomials. -/
@[simp]
theorem isNormalized_reverse_iff (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.IsNormalized H.reverse ↔ c.IsNormalized H := by
  simp [IsNormalized, c.normalizer_reverse]

/-! ### Subgroup and orbit-representative characterization -/

/-- The subgroup `G_ν ≤ 𝕂ˣ` generated by the values of the normalizer. -/
def normalizerSubgroup (c : CoefficientSystem 𝕂 R) : Subgroup 𝕂ˣ :=
  Subgroup.closure (Set.range c.normalizer)

/-- Every value of the normalizer lies in `normalizerSubgroup`. -/
theorem normalizer_mem_normalizerSubgroup (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    c.normalizer H ∈ c.normalizerSubgroup :=
  Subgroup.subset_closure ⟨H, rfl⟩

/-- The normalizer is homogeneous of degree `-1` on the subgroup `G_ν` generated by its values. -/
theorem normalizer_scale_of_mem (c : CoefficientSystem 𝕂 R) {g : 𝕂ˣ}
    (hg : g ∈ c.normalizerSubgroup) (H : ExchangePolynomial 𝕂) :
    c.normalizer (H.scale g) * g = c.normalizer H := by
  induction hg using Subgroup.closure_induction generalizing H with
  | mem x hx =>
    obtain ⟨H', rfl⟩ := hx
    exact c.normalizer_scale H H'
  | one =>
    simp
  | mul x y _ _ ihx ihy =>
    calc
      c.normalizer (H.scale (x * y)) * (x * y)
          = c.normalizer ((H.scale y).scale x) * x * y := by
              rw [ExchangePolynomial.scale_scale, mul_assoc]
      _ = c.normalizer (H.scale y) * y := by rw [ihx]
      _ = c.normalizer H := ihy H
  | inv x _ ihx =>
    have h := ihx (H.scale x⁻¹)
    rw [ExchangePolynomial.scale_scale_inv] at h
    exact mul_inv_eq_of_eq_mul h.symm

/-- Scaling by an element of `G_ν` does not change the normalized polynomial. -/
theorem normalize_scale_of_mem (c : CoefficientSystem 𝕂 R) {g : 𝕂ˣ}
    (hg : g ∈ c.normalizerSubgroup) (H : ExchangePolynomial 𝕂) :
    c.normalize (H.scale g) = c.normalize H := by
  rw [normalize_def, normalize_def, ExchangePolynomial.scale_scale,
    c.normalizer_scale_of_mem hg H]

/-- The normalized polynomials form a set of orbit representatives for the scaling action of `G_ν`:
each exchange polynomial has a unique scaling unit in `G_ν` making it normalized. -/
theorem existsUnique_scale_isNormalized (c : CoefficientSystem 𝕂 R) (H : ExchangePolynomial 𝕂) :
    ∃! g : c.normalizerSubgroup, c.IsNormalized (H.scale g.1) := by
  refine ⟨⟨c.normalizer H, c.normalizer_mem_normalizerSubgroup H⟩, c.isNormalized_normalize H, ?_⟩
  rintro ⟨g, hg⟩ hnorm
  apply Subtype.ext
  have h := c.normalizer_scale_of_mem hg H
  rw [isNormalized_iff] at hnorm
  rw [hnorm, one_mul] at h
  exact h

/-- Construct a coefficient system from a subgroup `G ≤ 𝕂ˣ` and a reversal-stable set `S` of
orbit representatives for the scaling action of `G`. -/
noncomputable def ofSubgroup (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂))
    (hrep : ∀ H : ExchangePolynomial 𝕂, ∃! g : G, H.scale g.1 ∈ S)
    (hrev : ∀ H ∈ S, H.reverse ∈ S) : CoefficientSystem 𝕂 R where
  toScalar := toScalar
  normalizer H := (hrep H).choose.1
  normalizer_reverse H := by
    have hmem : H.reverse.scale (hrep H).choose.1 ∈ S := by
      rw [← ExchangePolynomial.reverse_scale]
      exact hrev _ (hrep H).choose_spec.1
    exact congrArg Subtype.val ((hrep H.reverse).choose_spec.2 ⟨_, (hrep H).choose.2⟩ hmem).symm
  normalizer_scale H H' := by
    let g₁ : G := (hrep (H.scale (hrep H').choose.1)).choose
    let g₂ : G := (hrep H').choose
    have hmem : H.scale (g₁ * g₂ : G).1 ∈ S := by
      simpa only [Subgroup.coe_mul, ← ExchangePolynomial.scale_scale] using
        (hrep (H.scale g₂.1)).choose_spec.1
    exact congrArg Subtype.val ((hrep H).choose_spec.2 (g₁ * g₂) hmem)

/-- Every normalizer value of `ofSubgroup` belongs to the prescribed subgroup `G`. -/
theorem normalizer_ofSubgroup_mem (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂))
    (hrep : ∀ H : ExchangePolynomial 𝕂, ∃! g : G, H.scale g.1 ∈ S)
    (hrev : ∀ H ∈ S, H.reverse ∈ S) (H : ExchangePolynomial 𝕂) :
    (ofSubgroup toScalar G S hrep hrev).normalizer H ∈ G :=
  (hrep H).choose.2

/-- The normalized polynomials of `ofSubgroup` are precisely the given representatives `S`. -/
@[simp]
theorem isNormalized_ofSubgroup_iff (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂))
    (hrep : ∀ H : ExchangePolynomial 𝕂, ∃! g : G, H.scale g.1 ∈ S)
    (hrev : ∀ H ∈ S, H.reverse ∈ S) (H : ExchangePolynomial 𝕂) :
    (ofSubgroup toScalar G S hrep hrev).IsNormalized H ↔ H ∈ S := by
  constructor
  · intro hnorm
    rw [isNormalized_iff] at hnorm
    have hmem : H.scale ((ofSubgroup toScalar G S hrep hrev).normalizer H) ∈ S :=
      (hrep H).choose_spec.1
    simpa [hnorm] using hmem
  · intro hS
    have h1 : (hrep H).choose = 1 :=
      ((hrep H).choose_spec.2 1 (by simpa using hS)).symm
    exact congrArg Subtype.val h1

/-- The normalizer subgroup of `ofSubgroup` recovers the prescribed subgroup `G`. -/
@[simp]
theorem normalizerSubgroup_ofSubgroup (toScalar : 𝕂 →*₀ R) (G : Subgroup 𝕂ˣ)
    (S : Set (ExchangePolynomial 𝕂))
    (hrep : ∀ H : ExchangePolynomial 𝕂, ∃! g : G, H.scale g.1 ∈ S)
    (hrev : ∀ H ∈ S, H.reverse ∈ S) :
    (ofSubgroup toScalar G S hrep hrev).normalizerSubgroup = G := by
  apply le_antisymm
  · rw [normalizerSubgroup, Subgroup.closure_le]
    rintro _ ⟨H, rfl⟩
    exact normalizer_ofSubgroup_mem toScalar G S hrep hrev H
  · intro g hg
    let c := ofSubgroup toScalar G S hrep hrev
    let H₀ := c.normalize ExchangePolynomial.binary
    have hH₀ : H₀ ∈ S :=
      (isNormalized_ofSubgroup_iff toScalar G S hrep hrev H₀).mp (c.isNormalized_normalize _)
    have hmem : (H₀.scale g⁻¹).scale g ∈ S := by
      simpa using hH₀
    have heq : c.normalizer (H₀.scale g⁻¹) = g :=
      congrArg Subtype.val ((hrep (H₀.scale g⁻¹)).choose_spec.2 ⟨g, hg⟩ hmem).symm
    exact heq ▸ c.normalizer_mem_normalizerSubgroup (H₀.scale g⁻¹)

/-- Recovering a coefficient system from its normalizer subgroup and set of normalized polynomials
returns the original coefficient system. -/
theorem ofSubgroup_normalizerSubgroup (c : CoefficientSystem 𝕂 R) :
    ofSubgroup c.toScalar c.normalizerSubgroup {H | c.IsNormalized H}
      c.existsUnique_scale_isNormalized (fun H hH ↦ (c.isNormalized_reverse_iff H).mpr hH) = c := by
  ext : 1
  · rfl
  · funext H
    exact congrArg Subtype.val
      ((c.existsUnique_scale_isNormalized H).choose_spec.2
        ⟨c.normalizer H, c.normalizer_mem_normalizerSubgroup H⟩
        (c.isNormalized_normalize H)).symm

/-! ### The scalar system and scalar pushforward -/

/-- The *scalar coefficient system* of a commutative semiring `R`: coefficients live in `R`,
`toScalar` is the identity, and no normalization is applied (`ν = 1`). -/
def trivial (R : Type*) [CommSemiring R] : CoefficientSystem R R where
  toScalar := MonoidWithZeroHom.id R
  normalizer _ := 1
  normalizer_reverse _ := rfl
  normalizer_scale _ _ := one_mul 1

@[simp]
theorem trivial_toScalar : (trivial R).toScalar = MonoidWithZeroHom.id R :=
  (rfl)

@[simp]
theorem trivial_normalizer (H : ExchangePolynomial R) : (trivial R).normalizer H = 1 :=
  (rfl)

@[simp]
theorem trivial_normalize (H : ExchangePolynomial R) : (trivial R).normalize H = H :=
  H.scale_one

@[simp]
theorem trivial_isNormalized (H : ExchangePolynomial R) : (trivial R).IsNormalized H := by
  rw [IsNormalized, trivial_normalizer]

@[simp]
theorem trivial_normalizerSubgroup : (trivial R).normalizerSubgroup = ⊥ := by
  rw [normalizerSubgroup, eq_bot_iff, Subgroup.closure_le]
  rintro _ ⟨H, rfl⟩
  simp

/-- Push forward the scalar map of a coefficient system along a semiring homomorphism `f : R →+* S`,
keeping the coefficient monoid and normalizer unchanged. -/
def mapScalar (c : CoefficientSystem 𝕂 R) (f : R →+* S) : CoefficientSystem 𝕂 S where
  toScalar := f.toMonoidWithZeroHom.comp c.toScalar
  normalizer := c.normalizer
  normalizer_reverse := c.normalizer_reverse
  normalizer_scale := c.normalizer_scale

@[simp]
theorem mapScalar_toScalar (c : CoefficientSystem 𝕂 R) (f : R →+* S) (a : 𝕂) :
    (c.mapScalar f).toScalar a = f (c.toScalar a) :=
  (rfl)

@[simp]
theorem mapScalar_normalizer (c : CoefficientSystem 𝕂 R) (f : R →+* S) (H : ExchangePolynomial 𝕂) :
    (c.mapScalar f).normalizer H = c.normalizer H :=
  (rfl)

@[simp]
theorem mapScalar_normalize (c : CoefficientSystem 𝕂 R) (f : R →+* S) (H : ExchangePolynomial 𝕂) :
    (c.mapScalar f).normalize H = c.normalize H :=
  (rfl)

@[simp]
theorem mapScalar_isNormalized (c : CoefficientSystem 𝕂 R) (f : R →+* S)
    (H : ExchangePolynomial 𝕂) :
    (c.mapScalar f).IsNormalized H ↔ c.IsNormalized H :=
  Iff.rfl

@[simp]
theorem mapScalar_normalizerSubgroup (c : CoefficientSystem 𝕂 R) (f : R →+* S) :
    (c.mapScalar f).normalizerSubgroup = c.normalizerSubgroup :=
  (rfl)

/-! ### Homomorphisms of coefficient systems -/

/-- A homomorphism of coefficient systems over a fixed base semiring `R`: a `MonoidWithZeroHom`
compatible with the scalar maps and intertwining the normalizers. -/
structure Hom (c₁ : CoefficientSystem 𝕂₁ R) (c₂ : CoefficientSystem 𝕂₂ R) where
  /-- The underlying homomorphism of coefficient monoids with zero. -/
  toMonoidWithZeroHom : 𝕂₁ →*₀ 𝕂₂
  /-- Compatibility with the scalar maps. -/
  toScalar_comp : c₂.toScalar.comp toMonoidWithZeroHom = c₁.toScalar
  /-- Compatibility with the normalizers. -/
  map_normalizer : ∀ H : ExchangePolynomial 𝕂₁,
    c₂.normalizer (H.map toMonoidWithZeroHom) =
      Units.map toMonoidWithZeroHom.toMonoidHom (c₁.normalizer H)

namespace Hom

variable {c₁ : CoefficientSystem 𝕂₁ R} {c₂ : CoefficientSystem 𝕂₂ R}
  {c₃ : CoefficientSystem 𝕂₃ R}

instance : FunLike (Hom c₁ c₂) 𝕂₁ 𝕂₂ where
  coe f := f.toMonoidWithZeroHom
  coe_injective f g h := by
    obtain ⟨f, _, _⟩ := f
    obtain ⟨g, _, _⟩ := g
    congr
    exact DFunLike.coe_injective h

instance : MonoidWithZeroHomClass (Hom c₁ c₂) 𝕂₁ 𝕂₂ where
  map_zero f := f.toMonoidWithZeroHom.map_zero
  map_one f := f.toMonoidWithZeroHom.map_one
  map_mul f := f.toMonoidWithZeroHom.map_mul

@[ext]
theorem ext {f g : Hom c₁ c₂} (h : ∀ a, f a = g a) : f = g :=
  DFunLike.ext f g h

@[simp]
theorem coe_toMonoidWithZeroHom (f : Hom c₁ c₂) : ⇑f.toMonoidWithZeroHom = f :=
  (rfl)

@[simp]
theorem toScalar_apply (f : Hom c₁ c₂) (a : 𝕂₁) : c₂.toScalar (f a) = c₁.toScalar a :=
  DFunLike.congr_fun f.toScalar_comp a

/-- The identity homomorphism of a coefficient system. -/
protected def id (c : CoefficientSystem 𝕂 R) : Hom c c where
  toMonoidWithZeroHom := MonoidWithZeroHom.id 𝕂
  toScalar_comp := by ext a; rfl
  map_normalizer H := by
    rw [ExchangePolynomial.map_id]
    ext
    rfl

@[simp]
theorem coe_id (c : CoefficientSystem 𝕂 R) : ⇑(Hom.id c) = id :=
  (rfl)

@[simp]
theorem toMonoidWithZeroHom_id (c : CoefficientSystem 𝕂 R) :
    (Hom.id c).toMonoidWithZeroHom = MonoidWithZeroHom.id 𝕂 :=
  (rfl)

/-- Composition of homomorphisms of coefficient systems over `R`. -/
def comp (g : Hom c₂ c₃) (f : Hom c₁ c₂) : Hom c₁ c₃ where
  toMonoidWithZeroHom := g.toMonoidWithZeroHom.comp f.toMonoidWithZeroHom
  toScalar_comp := by
    ext a
    simp
  map_normalizer H := by
    rw [ExchangePolynomial.map_comp, g.map_normalizer, f.map_normalizer]
    ext
    rfl

@[simp]
theorem coe_comp (g : Hom c₂ c₃) (f : Hom c₁ c₂) : ⇑(g.comp f) = g ∘ f :=
  (rfl)

@[simp]
theorem toMonoidWithZeroHom_comp (g : Hom c₂ c₃) (f : Hom c₁ c₂) :
    (g.comp f).toMonoidWithZeroHom = g.toMonoidWithZeroHom.comp f.toMonoidWithZeroHom :=
  (rfl)

@[simp]
theorem comp_id (f : Hom c₁ c₂) : f.comp (Hom.id c₁) = f :=
  ext fun _ ↦ rfl

@[simp]
theorem id_comp (f : Hom c₁ c₂) : (Hom.id c₂).comp f = f :=
  ext fun _ ↦ rfl

theorem comp_assoc {𝕂₄ : Type*} [CommMonoidWithZero 𝕂₄] {c₄ : CoefficientSystem 𝕂₄ R}
    (h : Hom c₃ c₄) (g : Hom c₂ c₃) (f : Hom c₁ c₂) :
    (h.comp g).comp f = h.comp (g.comp f) :=
  ext fun _ ↦ rfl

/-- A homomorphism of coefficient systems commutes with polynomial normalization. -/
@[simp]
theorem map_normalize (f : Hom c₁ c₂) (H : ExchangePolynomial 𝕂₁) :
    (c₁.normalize H).map f.toMonoidWithZeroHom = c₂.normalize (H.map f.toMonoidWithZeroHom) := by
  rw [normalize_def, normalize_def, ExchangePolynomial.map_scale, f.map_normalizer]

/-- A homomorphism of coefficient systems preserves normalized polynomials. -/
theorem isNormalized_map (f : Hom c₁ c₂) {H : ExchangePolynomial 𝕂₁} (hH : c₁.IsNormalized H) :
    c₂.IsNormalized (H.map f.toMonoidWithZeroHom) := by
  rw [isNormalized_iff] at hH ⊢
  rw [f.map_normalizer, hH, map_one]

end Hom

end CoefficientSystem

end TauCeti
