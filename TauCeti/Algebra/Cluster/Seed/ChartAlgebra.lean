module

public import TauCeti.Algebra.Cluster.Seed.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Seed chart algebras with selected frozen inverses

The chart algebra is generated by every coordinate of a realized seed, the inverses of its
mutable coordinates, and the inverses of the selected frozen coordinates. A frozen index is
an index outside the image of the mutable-row embedding. The ambient algebra may be a
noncommutative semiring, so these inverses are the underlying elements of chart units.

Increasing the selected frozen set increases the chart algebra. Injective ambient transport
commutes with its formation. Inverting all frozen coordinates gives the full chart evaluation
range, rather than necessarily the whole ambient algebra: a faithful chart need not generate
its ambient algebra.
-/

public section

namespace TauCeti.Seed

variable {𝕂 R I K B C : Type*} [CommMonoidWithZero 𝕂] [CommSemiring R]
  [Fintype I] [DecidableEq I] [Semiring B] [Algebra R B]
  [Semiring C] [Algebra R C]
  {c : CoefficientSystem 𝕂 R} {row : K ↪ I} {u : Rˣ}

/-- The algebra generated by all chart coordinates, with mutable and selected frozen
coordinates inverted. -/
noncomputable def chartAlgebra (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) : Subalgebra R B :=
  Algebra.adjoin R (Set.range (fun i : I ↦ (s.chart.monomial (Finsupp.single i 1) : B)) ∪
    (fun i : I ↦ (((s.chart.monomial (Finsupp.single i 1))⁻¹ : Bˣ) : B)) ''
      (Set.range row ∪ Subtype.val '' S))

/-- The chart algebra is obtained by adjoining the chart coordinates and the specified inverses. -/
theorem chartAlgebra_def (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) :
    s.chartAlgebra S =
      Algebra.adjoin R (Set.range (fun i : I ↦ (s.chart.monomial (Finsupp.single i 1) : B)) ∪
        (fun i : I ↦ (((s.chart.monomial (Finsupp.single i 1))⁻¹ : Bˣ) : B)) ''
          (Set.range row ∪ Subtype.val '' S)) :=
  (rfl)

/-- Every coordinate belongs to the chart algebra, whether mutable or frozen. -/
theorem coordinate_mem_chartAlgebra (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) (i : I) :
    (s.chart.monomial (Finsupp.single i 1) : B) ∈ s.chartAlgebra S :=
  Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)

/-- Mutable coordinates are inverted in every chart algebra. -/
theorem inv_mutable_mem_chartAlgebra (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) (k : K) :
    (((s.chart.monomial (Finsupp.single (row k) 1))⁻¹ : Bˣ) : B) ∈ s.chartAlgebra S :=
  Algebra.subset_adjoin (Or.inr ⟨row k, Or.inl ⟨k, rfl⟩, rfl⟩)

/-- The selected frozen coordinates are inverted in the chart algebra. -/
theorem inv_frozen_mem_chartAlgebra (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) (j : {i : I // i ∉ Set.range row}) (hj : j ∈ S) :
    (((s.chart.monomial (Finsupp.single j.val 1))⁻¹ : Bˣ) : B) ∈ s.chartAlgebra S :=
  Algebra.subset_adjoin (Or.inr ⟨j.val, Or.inr ⟨j, hj, rfl⟩, rfl⟩)

/-- The generators characterize the chart algebra by its universal property. -/
theorem chartAlgebra_le_iff (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) (A : Subalgebra R B) :
    s.chartAlgebra S ≤ A ↔
      (∀ i, (s.chart.monomial (Finsupp.single i 1) : B) ∈ A) ∧
      (∀ k, (((s.chart.monomial (Finsupp.single (row k) 1))⁻¹ : Bˣ) : B) ∈ A) ∧
      ∀ j : {i : I // i ∉ Set.range row}, j ∈ S →
        (((s.chart.monomial (Finsupp.single j.val 1))⁻¹ : Bˣ) : B) ∈ A := by
  constructor
  · intro h
    exact ⟨fun i ↦ h (s.coordinate_mem_chartAlgebra S i),
      fun k ↦ h (s.inv_mutable_mem_chartAlgebra S k),
      fun j hj ↦ h (s.inv_frozen_mem_chartAlgebra S j hj)⟩
  · rintro ⟨hc, hm, hf⟩
    rw [chartAlgebra]
    apply Algebra.adjoin_le
    rintro x (⟨i, rfl⟩ | ⟨i, hi, rfl⟩)
    · exact hc i
    · rcases hi with ⟨k, rfl⟩ | ⟨j, hj, rfl⟩
      · exact hm k
      · exact hf j hj

/-- An element belongs to the chart algebra exactly when it lies in every subalgebra
containing all the coordinates, mutable inverses, and selected frozen inverses. -/
theorem mem_chartAlgebra_iff (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) {x : B} :
    x ∈ s.chartAlgebra S ↔ ∀ A : Subalgebra R B,
      (∀ i, (s.chart.monomial (Finsupp.single i 1) : B) ∈ A) →
      (∀ k, (((s.chart.monomial (Finsupp.single (row k) 1))⁻¹ : Bˣ) : B) ∈ A) →
      (∀ j : {i : I // i ∉ Set.range row}, j ∈ S →
        (((s.chart.monomial (Finsupp.single j.val 1))⁻¹ : Bˣ) : B) ∈ A) →
      x ∈ A := by
  constructor
  · intro hx A hc hm hf
    exact (s.chartAlgebra_le_iff S A).mpr ⟨hc, hm, hf⟩ hx
  · intro h
    exact h _ (s.coordinate_mem_chartAlgebra S) (s.inv_mutable_mem_chartAlgebra S)
      (s.inv_frozen_mem_chartAlgebra S)

/-- Selecting more frozen inverses enlarges the chart algebra. -/
theorem chartAlgebra_mono (s : Seed c row u B)
    {S T : Set {i : I // i ∉ Set.range row}} (hST : S ⊆ T) :
    s.chartAlgebra S ≤ s.chartAlgebra T :=
  (s.chartAlgebra_le_iff S _).mpr ⟨s.coordinate_mem_chartAlgebra T,
    s.inv_mutable_mem_chartAlgebra T, fun j hj ↦ s.inv_frozen_mem_chartAlgebra T j (hST hj)⟩

/-- Ambient transport maps precisely the generated chart algebra. -/
@[simp]
theorem chartAlgebra_map (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) (f : B →ₐ[R] C) (hf : Function.Injective f) :
    (s.map f hf).chartAlgebra S = (s.chartAlgebra S).map f := by
  simp only [chartAlgebra, AlgHom.map_adjoin, Set.image_union, ← Set.range_comp,
    Set.image_image, map_monomial, ← map_inv, Units.coe_map,
    AlgHom.coe_toMonoidHom]
  rfl

/-- Every selected chart algebra lies in the full based-chart evaluation range. -/
theorem chartAlgebra_le_range (s : Seed c row u B)
    (S : Set {i : I // i ∉ Set.range row}) : s.chartAlgebra S ≤ s.chart.eval.range := by
  apply (s.chartAlgebra_le_iff S _).mpr
  have hc (a : I →₀ ℤ) : (s.chart.monomial a : B) ∈ s.chart.eval.range :=
    ⟨QuantumTorus.monomial u s.form a, s.chart.eval_monomial a⟩
  have hi (a : I →₀ ℤ) : (((s.chart.monomial a)⁻¹ : Bˣ) : B) ∈ s.chart.eval.range := by
    rw [s.chart.monomial_inv s.isAlt]
    exact hc (-a)
  exact ⟨fun i ↦ hc _, fun k ↦ hi _, fun j _ ↦ hi _⟩

/-- With every frozen coordinate inverted, every normalized chart monomial is available. -/
theorem monomial_mem_chartAlgebra_univ (s : Seed c row u B) (a : I →₀ ℤ) :
    (s.chart.monomial a : B) ∈ s.chartAlgebra Set.univ := by
  classical
  let A := s.chartAlgebra Set.univ
  have hinv (i : I) : (((s.chart.monomial (Finsupp.single i 1))⁻¹ : Bˣ) : B) ∈ A := by
    by_cases hi : i ∈ Set.range row
    · obtain ⟨k, rfl⟩ := hi
      exact s.inv_mutable_mem_chartAlgebra Set.univ k
    · exact s.inv_frozen_mem_chartAlgebra Set.univ ⟨i, hi⟩ (Set.mem_univ _)
  have hs (i : I) (n : ℤ) : (s.chart.monomial (Finsupp.single i n) : B) ∈ A := by
    rw [← Finsupp.smul_single_one, ← s.chart.monomial_zpow s.isAlt]
    cases n with
    | ofNat n =>
      simpa only [Int.ofNat_eq_natCast, zpow_natCast, Units.val_pow_eq_pow_val] using
        A.pow_mem (s.coordinate_mem_chartAlgebra Set.univ i) n
    | negSucc n =>
      simpa only [zpow_negSucc, ← inv_pow, Units.val_pow_eq_pow_val] using
        A.pow_mem (hinv i) (n + 1)
  induction a using Finsupp.induction with
  | zero => simpa only [BasedChart.monomial_zero, Units.val_one] using A.one_mem
  | single_add i n a _ _ ih =>
    apply (A.toSubmodule.smul_mem_iff_of_isUnit (u ^ s.form (Finsupp.single i n) a).isUnit).mp
    rw [← s.chart.val_monomial_mul]
    exact A.mul_mem (hs i n) ih

/-- Full frozen inversion is exactly the full chart range, without ambient generation. -/
@[simp]
theorem chartAlgebra_univ_eq_range (s : Seed c row u B) :
    s.chartAlgebra Set.univ = s.chart.eval.range := by
  refine le_antisymm (s.chartAlgebra_le_range Set.univ) ?_
  intro x hx
  obtain ⟨p, rfl⟩ := (AlgHom.mem_range s.chart.eval).mp hx
  rw [← (QuantumTorus.basis u s.form).repr.symm_apply_apply p, s.chart.eval_repr_symm]
  exact Subalgebra.sum_mem _ fun a _ ↦
    (s.chartAlgebra Set.univ).smul_mem (s.monomial_mem_chartAlgebra_univ a) _

end TauCeti.Seed
