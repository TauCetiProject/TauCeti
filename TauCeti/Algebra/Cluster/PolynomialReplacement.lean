/-!
# Finite polynomial replacement

Let `x` and `z` be units of a ring `D` and `C` a subring which conjugation by `x⁻¹` and by `z`
maps into itself. Consider two exchanges in the direction of `z`, written with coefficients on
the right,

```
z* · z  = n₀ + ∑ₐ x ^ nₐ · cₐ,
z** · z = (x*) ^ N · m₀ + ∑ₐ (x*) ^ (N - nₐ) · dₐ,
```

related by `φ · n₀ = m₀` and `dₐ = gₐ · x⁻ⁿᵃ φ xⁿᵃ · cₐ` for every `a`, with `nₐ ≤ N`.
Then `z**` is obtained from `z*` by the explicit formula

```
z** = (x*) ^ N · φ · z* - ∑ₐ (x*) ^ (N - nₐ) · ((x*) ^ nₐ · x ^ nₐ - gₐ) · x⁻ⁿᵃ φ xⁿᵃ · cₐ · z⁻¹.
```

If moreover every defect `(x*) ^ nₐ · x ^ nₐ - gₐ` lies in `z · C[z]`, where `C[z]` is the
subring generated by `C` and `z`, then each correction term is conjugate by `z` to an element of
`C[z]`, so `z**` lies in every subring containing `C`, `x*`, `z*` and `z`. Nothing here assumes
commutativity, so this applies both to classical exchange relations in a field and to quantum
exchange relations in a skew field.

In a seed with interacting directions `i` and `j`, take `x = Xᵢ` and `z = Xⱼ`, let `x*` and `z*`
be the variables obtained from them by one mutation, and let `z**` be the variable obtained by
mutating at `j` after mutating at `i`. The exchange relations of the two seeds have the shape
above, and the membership statement shows that `z**` lies in the ring generated by the
coefficients, `x*`, `z*` and `z`. This is the local intersection step in the proofs that upper
cluster algebras are invariant under mutation. The singleton case `nₐ = N` is the binary
replacement used for binary exchange; the commutative instance with polynomial exchange relations
`x · z = P(y)` and `y · w = Q(x)` gives the corresponding membership for polynomial exchange.

## Main definitions and results

* `TauCeti.replacementCorrection`: the correction term in the formula for `z**`.
* `TauCeti.eq_sub_replacementCorrection`: the finite replacement formula.
* `TauCeti.mem_subring_of_replacement`: `z**` lies in every subring containing `C`, `x*`, `z*`
  and `z`.
* `TauCeti.eq_sub_of_binary_replacement`, `TauCeti.mem_subring_of_binary_replacement`: the
  singleton case.
* `TauCeti.mem_subring_of_polynomial_exchange`: the commutative instance for polynomial exchange
  relations, with defects given by `Polynomial.divX`.

## References

* A. Berenstein, S. Fomin and A. Zelevinsky, *Cluster algebras III: Upper bounds and double
  Bruhat cells*, Lemma 4.6.
* A. Berenstein and A. Zelevinsky, *Quantum cluster algebras*, Lemma 5.8.
-/

public section

namespace TauCeti

open Polynomial

variable {D : Type*} [Ring D] {A : Type*}

/-- The correction term of finite polynomial replacement:
`∑ₐ (x*) ^ (N - nₐ) · ((x*) ^ nₐ · x ^ nₐ - gₐ) · x⁻ⁿᵃ φ xⁿᵃ · cₐ · z⁻¹`, summed over `s`. Here
`xs` stands for `x*`. -/
def replacementCorrection (s : Finset A) (x z : Dˣ) (xs φ : D) (N : ℕ) (n : A → ℕ)
    (c g : A → D) : D :=
  ∑ a ∈ s, xs ^ (N - n a) * (xs ^ n a * (x : D) ^ n a - g a) *
    ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a * ↑z⁻¹

section Correction

variable {x z : Dˣ} {xs φ : D} {N : ℕ} {n : A → ℕ} {c g : A → D}

/-- The defining sum of the correction term. -/
theorem replacementCorrection_def (s : Finset A) :
    replacementCorrection s x z xs φ N n c g =
      ∑ a ∈ s, xs ^ (N - n a) * (xs ^ n a * (x : D) ^ n a - g a) *
        ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a * ↑z⁻¹ := (rfl)

/-- The correction over the empty index set vanishes. -/
@[simp]
theorem replacementCorrection_empty :
    replacementCorrection (∅ : Finset A) x z xs φ N n c g = 0 := by
  simp [replacementCorrection_def]

/-- The correction over a single index is its single term. -/
@[simp]
theorem replacementCorrection_singleton (a : A) :
    replacementCorrection {a} x z xs φ N n c g =
      xs ^ (N - n a) * (xs ^ n a * (x : D) ^ n a - g a) *
        ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a * ↑z⁻¹ := by
  simp [replacementCorrection_def]

/-- Adding an index to the sum adds its correction term. -/
theorem replacementCorrection_insert [DecidableEq A] {s : Finset A} {a : A} (ha : a ∉ s) :
    replacementCorrection (insert a s) x z xs φ N n c g =
      xs ^ (N - n a) * (xs ^ n a * (x : D) ^ n a - g a) *
          ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a * ↑z⁻¹ +
        replacementCorrection s x z xs φ N n c g := by
  simp [replacementCorrection_def, Finset.sum_insert ha]

/-- Terms with vanishing coefficient `cₐ` do not contribute: the correction over a larger index
set agrees with the correction over a smaller one when all the additional coefficients are zero.
-/
theorem replacementCorrection_of_subset {s t : Finset A} (hst : s ⊆ t)
    (hc : ∀ a ∈ t, a ∉ s → c a = 0) :
    replacementCorrection s x z xs φ N n c g = replacementCorrection t x z xs φ N n c g := by
  rw [replacementCorrection_def, replacementCorrection_def]
  exact Finset.sum_subset hst fun a ha has => by simp [hc a ha has]

/-- Reindexing the correction along an embedding of index types. -/
theorem replacementCorrection_map {B : Type*} (e : A ↪ B) (s : Finset A) (n : B → ℕ)
    (c g : B → D) :
    replacementCorrection (s.map e) x z xs φ N n c g =
      replacementCorrection s x z xs φ N (n ∘ e) (c ∘ e) (g ∘ e) := by
  simp [replacementCorrection_def]

end Correction

/-- **Finite polynomial replacement.** If `z* · z = n₀ + ∑ₐ x ^ nₐ · cₐ` and
`z** · z = (x*) ^ N · m₀ + ∑ₐ (x*) ^ (N - nₐ) · dₐ`, where `φ · n₀ = m₀`, `nₐ ≤ N` and
`dₐ = gₐ · x⁻ⁿᵃ φ xⁿᵃ · cₐ`, then `z** = (x*) ^ N · φ · z*` minus the correction term. Here
`xs`, `zs` and `zss` stand for `x*`, `z*` and `z**`. -/
theorem eq_sub_replacementCorrection {s : Finset A} {x z : Dˣ} {xs zs zss φ n₀ m₀ : D} {N : ℕ}
    {n : A → ℕ} {c d g : A → D} (hzs : zs * z = n₀ + ∑ a ∈ s, (x : D) ^ n a * c a)
    (hzss : zss * z = xs ^ N * m₀ + ∑ a ∈ s, xs ^ (N - n a) * d a) (hφ : φ * n₀ = m₀)
    (hn : ∀ a ∈ s, n a ≤ N)
    (hd : ∀ a ∈ s, d a = g a * ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a) :
    zss = xs ^ N * φ * zs - replacementCorrection s x z xs φ N n c g := by
  refine (Units.mul_left_inj z).1 ?_
  -- Each correction term, multiplied by `z`, is
  -- `(x*) ^ N · φ · x ^ nₐ · cₐ - (x*) ^ (N - nₐ) · dₐ`.
  have hterm : ∀ a ∈ s, xs ^ (N - n a) * (xs ^ n a * (x : D) ^ n a - g a) *
      ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a * ↑z⁻¹ * z =
      xs ^ N * φ * ((x : D) ^ n a * c a) - xs ^ (N - n a) * d a := by
    intro a ha
    have hx : (x : D) ^ n a * (↑x⁻¹ : D) ^ n a = 1 := by
      rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul, inv_pow,
        mul_inv_cancel, Units.val_one]
    have hN : xs ^ (N - n a) * xs ^ n a = xs ^ N := by rw [← pow_add, Nat.sub_add_cancel (hn a ha)]
    rw [Units.inv_mul_cancel_right, hd a ha, mul_sub, sub_mul, sub_mul]
    congr 1
    · calc
        _ = xs ^ (N - n a) * xs ^ n a * ((x : D) ^ n a * (↑x⁻¹ : D) ^ n a) * φ *
            ((x : D) ^ n a * c a) := by simp only [mul_assoc]
        _ = _ := by rw [hx, mul_one, hN]
    · simp only [mul_assoc]
  rw [sub_mul, mul_assoc _ zs, hzs, hzss, replacementCorrection_def, Finset.sum_mul,
    Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, mul_add, Finset.mul_sum, ← hφ, mul_assoc]
  abel

/-- **Finite polynomial replacement, membership.** Under the hypotheses of
`eq_sub_replacementCorrection`, suppose that conjugation by `x⁻¹` and by `z` maps a subring `C`
into itself, that `φ` and every `cₐ` lie in `C`, and that every defect
`(x*) ^ nₐ · x ^ nₐ - gₐ` lies in `z · C[z]`. Then `z**` lies in every subring `H` containing `C`,
`x*`, `z*` and `z`. -/
theorem mem_subring_of_replacement {s : Finset A} {x z : Dˣ} {xs zs zss φ n₀ m₀ : D} {N : ℕ}
    {n : A → ℕ} {c d g : A → D} (hzs : zs * z = n₀ + ∑ a ∈ s, (x : D) ^ n a * c a)
    (hzss : zss * z = xs ^ N * m₀ + ∑ a ∈ s, xs ^ (N - n a) * d a) (hφ : φ * n₀ = m₀)
    (hn : ∀ a ∈ s, n a ≤ N)
    (hd : ∀ a ∈ s, d a = g a * ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a)
    {C : Subring D} (hxC : ∀ y ∈ C, (↑x⁻¹ : D) * y * x ∈ C)
    (hzC : ∀ y ∈ C, (z : D) * y * ↑z⁻¹ ∈ C) (hφC : φ ∈ C) (hcC : ∀ a ∈ s, c a ∈ C)
    (hdef : ∀ a ∈ s, ∃ p ∈ Subring.closure (insert (z : D) (C : Set D)),
      xs ^ n a * (x : D) ^ n a - g a = z * p)
    {H : Subring D} (hCH : C ≤ H) (hxs : xs ∈ H) (hzsH : zs ∈ H) (hzH : (z : D) ∈ H) :
    zss ∈ H := by
  set Cz := Subring.closure (insert (z : D) (C : Set D))
  have hCzH : Cz ≤ H := Subring.closure_le.2 (Set.insert_subset hzH hCH)
  -- Conjugation by `x⁻ᵐ` maps `φ` into `C`.
  have hu (m : ℕ) : (↑x⁻¹ : D) ^ m * φ * (x : D) ^ m ∈ C := by
    induction m with
    | zero => simpa using hφC
    | succ m ih =>
      rw [pow_succ', pow_succ]
      simpa only [mul_assoc] using hxC _ ih
  -- Conjugation by `z` maps `C[z]` into itself, since it fixes `z` and maps `C` into `C`.
  have hconj {p : D} (hp : p ∈ Cz) : (z : D) * p * ↑z⁻¹ ∈ Cz := by
    let σ := MulSemiringAction.toRingHom (ConjAct Dˣ) D (ConjAct.toConjAct z)
    have hσ (y : D) : σ y = z * y * ↑z⁻¹ := ConjAct.units_smul_def _ _
    have hle : Cz ≤ Cz.comap σ := by
      refine Subring.closure_le.2 ?_
      rintro y (rfl | hy)
      · simp [hσ, Cz, Subring.subset_closure (Set.mem_insert _ _)]
      · rw [SetLike.mem_coe, Subring.mem_comap, hσ]
        exact Subring.subset_closure (Set.mem_insert_of_mem _ (hzC y hy))
    simpa [hσ] using hle hp
  rw [eq_sub_replacementCorrection hzs hzss hφ hn hd]
  refine H.sub_mem (H.mul_mem (H.mul_mem (H.pow_mem hxs N) (hCH hφC)) hzsH)
    (H.sum_mem fun a ha => ?_)
  -- Each correction term is `(x*) ^ (N - nₐ)` times the conjugate by `z` of an element of `C[z]`.
  obtain ⟨p, hp, hpdef⟩ := hdef a ha
  have hq : p * ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a ∈ Cz :=
    Cz.mul_mem (Cz.mul_mem hp (Subring.subset_closure (Set.mem_insert_of_mem _ (hu (n a)))))
      (Subring.subset_closure (Set.mem_insert_of_mem _ (hcC a ha)))
  rw [hpdef]
  simpa only [mul_assoc] using H.mul_mem (H.pow_mem hxs (N - n a)) (hCzH (hconj hq))

/-- The form of `mem_subring_of_replacement` for the subring `C⟨x*, z*, z⟩` generated by `C`,
`x*`, `z*` and `z`. -/
theorem mem_closure_of_replacement {s : Finset A} {x z : Dˣ} {xs zs zss φ n₀ m₀ : D} {N : ℕ}
    {n : A → ℕ} {c d g : A → D} (hzs : zs * z = n₀ + ∑ a ∈ s, (x : D) ^ n a * c a)
    (hzss : zss * z = xs ^ N * m₀ + ∑ a ∈ s, xs ^ (N - n a) * d a) (hφ : φ * n₀ = m₀)
    (hn : ∀ a ∈ s, n a ≤ N)
    (hd : ∀ a ∈ s, d a = g a * ((↑x⁻¹ : D) ^ n a * φ * (x : D) ^ n a) * c a)
    {C : Subring D} (hxC : ∀ y ∈ C, (↑x⁻¹ : D) * y * x ∈ C)
    (hzC : ∀ y ∈ C, (z : D) * y * ↑z⁻¹ ∈ C) (hφC : φ ∈ C) (hcC : ∀ a ∈ s, c a ∈ C)
    (hdef : ∀ a ∈ s, ∃ p ∈ Subring.closure (insert (z : D) (C : Set D)),
      xs ^ n a * (x : D) ^ n a - g a = z * p) :
    zss ∈ Subring.closure ((C : Set D) ∪ {xs, zs, (z : D)}) :=
  mem_subring_of_replacement hzs hzss hφ hn hd hxC hzC hφC hcC hdef
    (fun _ hy => Subring.subset_closure (Or.inl hy)) (Subring.subset_closure (by simp))
    (Subring.subset_closure (by simp)) (Subring.subset_closure (by simp))

section Binary

variable {x z : Dˣ} {xs zs zss φ c d g n₁ m₁ : D} {r : ℕ}

/-- **Binary replacement.** If `z* · z = n₁ + x ^ r · c` and `z** · z = (x*) ^ r · m₁ + d`, where
`φ · n₁ = m₁` and `d = g · x⁻ʳ φ xʳ · c`, then
`z** = (x*) ^ r · φ · z* - ((x*) ^ r · x ^ r - g) · x⁻ʳ φ xʳ · c · z⁻¹`. -/
theorem eq_sub_of_binary_replacement (hzs : zs * z = n₁ + (x : D) ^ r * c)
    (hzss : zss * z = xs ^ r * m₁ + d) (hφ : φ * n₁ = m₁)
    (hd : d = g * ((↑x⁻¹ : D) ^ r * φ * (x : D) ^ r) * c) :
    zss = xs ^ r * φ * zs -
      (xs ^ r * (x : D) ^ r - g) * ((↑x⁻¹ : D) ^ r * φ * (x : D) ^ r) * c * ↑z⁻¹ := by
  have h := eq_sub_replacementCorrection (s := {()}) (n := fun _ => r) (c := fun _ => c)
    (d := fun _ => d) (g := fun _ => g) (xs := xs) (N := r) (by simpa using hzs)
    (by simpa using hzss) hφ (by simp) (by simpa using hd)
  simpa [mul_assoc] using h

/-- **Binary replacement, membership.** Under the hypotheses of `eq_sub_of_binary_replacement`,
if conjugation by `x⁻¹` and by `z` maps a subring `C` into itself, `φ` and `c` lie in `C`, and
`(x*) ^ r · x ^ r - g` lies in `z · C[z]`, then `z**` lies in every subring containing `C`, `x*`,
`z*` and `z`. -/
theorem mem_subring_of_binary_replacement (hzs : zs * z = n₁ + (x : D) ^ r * c)
    (hzss : zss * z = xs ^ r * m₁ + d) (hφ : φ * n₁ = m₁)
    (hd : d = g * ((↑x⁻¹ : D) ^ r * φ * (x : D) ^ r) * c)
    {C : Subring D} (hxC : ∀ y ∈ C, (↑x⁻¹ : D) * y * x ∈ C)
    (hzC : ∀ y ∈ C, (z : D) * y * ↑z⁻¹ ∈ C) (hφC : φ ∈ C) (hcC : c ∈ C)
    (hdef : ∃ p ∈ Subring.closure (insert (z : D) (C : Set D)),
      xs ^ r * (x : D) ^ r - g = z * p)
    {H : Subring D} (hCH : C ≤ H) (hxs : xs ∈ H) (hzsH : zs ∈ H) (hzH : (z : D) ∈ H) :
    zss ∈ H :=
  mem_subring_of_replacement (s := {()}) (n := fun _ => r) (c := fun _ => c) (d := fun _ => d)
    (g := fun _ => g) (xs := xs) (N := r) (by simpa using hzs) (by simpa using hzss) hφ
    (by simp) (by simpa using hd) hxC hzC hφC (by simpa using hcC) (by simpa using hdef) hCH
    hxs hzsH hzH

end Binary

/-- **Commutative polynomial replacement.** Let `f : R →+* F` be a map of commutative rings,
`P, Q` polynomials over `R` and `e ≥ natDegree Q`. Let `x, y` be units of `F` and `z, w ∈ F`
satisfy the exchange relations `x · z = P(y)` and `y · w = Q(x)`, with coefficients mapped by `f`.
Then `(∑ₐ f(Qₐ) · f(P(0)) ^ a · z ^ (e - a)) / y` lies in every subring containing the image of
`f`, `y`, `z` and `w`. -/
theorem mem_subring_of_polynomial_exchange {R F : Type*} [CommRing R] [CommRing F] (f : R →+* F)
    (P Q : R[X]) {e : ℕ} (he : Q.natDegree ≤ e) {x y : Fˣ} {z w : F}
    (hxz : x * z = P.eval₂ f y) (hyw : y * w = Q.eval₂ f x) {H : Subring F}
    (hfH : f.range ≤ H) (hyH : (y : F) ∈ H) (hzH : z ∈ H) (hwH : w ∈ H) :
    (∑ a ∈ Q.support, f (Q.coeff a) * f (P.coeff 0) ^ a * z ^ (e - a)) * ↑y⁻¹ ∈ H := by
  have hfH' (r : R) : f r ∈ H := hfH ⟨r, rfl⟩
  have heval (p : R[X]) : p.eval₂ f y ∈ H := by
    rw [eval₂_eq_sum_range]
    exact H.sum_mem fun i _ => H.mul_mem (hfH' _) (H.pow_mem hyH _)
  refine mem_subring_of_replacement (s := Q.support) (x := x) (z := y) (xs := z) (zs := w)
    (φ := 1) (n₀ := 0) (m₀ := 0) (N := e) (n := id) (c := fun a => f (Q.coeff a))
    (d := fun a => f (P.coeff 0) ^ a * f (Q.coeff a)) (g := fun a => f (P.coeff 0) ^ a) (C := H)
    ?_ ?_ (by simp) (fun a ha => (le_natDegree_of_mem_supp a ha).trans he) ?_
    (fun _ hy => by rwa [mul_right_comm, Units.inv_mul, one_mul])
    (fun _ hy => by rwa [mul_right_comm, Units.mul_inv, one_mul])
    H.one_mem (fun _ _ => hfH' _) ?_ le_rfl hzH hwH hyH
  · rw [zero_add, mul_comm, hyw, eval₂_eq_sum, Polynomial.sum_def]
    exact Finset.sum_congr rfl fun a _ => mul_comm _ _
  · rw [mul_zero, zero_add, Units.inv_mul_cancel_right, Finset.sum_congr rfl]
    intro a _
    rw [id]
    ring
  · intro a _
    simp only [id, mul_one, ← mul_pow, Units.inv_mul, one_pow]
  · intro a _
    refine ⟨(divX (P ^ a)).eval₂ f y,
      Subring.subset_closure (Set.mem_insert_of_mem _ (heval _)), ?_⟩
    have h := eval₂_divX_mul_add f (y : F) (P ^ a)
    rw [eval₂_pow, ← hxz, coeff_zero_eq_eval_zero, eval_pow, ← coeff_zero_eq_eval_zero,
      map_pow] at h
    simp only [id, ← mul_pow]
    rw [mul_comm z, ← h]
    ring

/-! ### Examples -/

-- With no terms, `N = 0` and `φ = n₀ = m₀ = 1`, the correction vanishes and `z** = z*`.
example {z : Dˣ} {zs zss : D} (hzs : zs * z = 1) (hzss : zss * z = 1) : zss = zs := by
  simpa using eq_sub_replacementCorrection (s := (∅ : Finset A)) (x := z) (xs := 0) (φ := 1)
    (N := 0) (n := 0) (c := 0) (d := 0) (g := 0) (n₀ := 1) (m₀ := 1) (by simpa using hzs)
    (by simpa using hzss) (one_mul 1) (by simp) (by simp)

-- For `x* = (1 + z) / x` and `z* = (1 + x) / z`, binary replacement gives
-- `(1 + x*) / z = x* z* - 1`.
example {K : Type*} [Field K] {x z : K} (hx : x ≠ 0) (hz : z ≠ 0) :
    (1 + (1 + z) / x) / z = (1 + z) / x * ((1 + x) / z) - 1 := by
  rw [eq_sub_of_binary_replacement (x := Units.mk0 x hx) (z := Units.mk0 z hz)
    (xs := (1 + z) / x) (zs := (1 + x) / z) (zss := (1 + (1 + z) / x) / z) (φ := 1) (n₁ := 1)
    (m₁ := 1) (c := 1) (d := 1)
    (g := 1) (r := 1) (by simp only [Units.val_mk0]; field_simp)
    (by simp only [Units.val_mk0]; field_simp; ring) (one_mul 1) (by simp [hx])]
  simp only [Units.val_mk0, Units.val_inv_eq_inv_val]
  field_simp
  ring

-- For `x* = (1 + z) / x` and `z* = (1 + x + x²) / z`, finite replacement with two terms gives
-- `(1 + x* + (x*)²) / z = (x*)² z* - x* - z - 2`.
example {K : Type*} [Field K] {x z : K} (hx : x ≠ 0) (hz : z ≠ 0) :
    (1 + (1 + z) / x + ((1 + z) / x) ^ 2) / z =
      ((1 + z) / x) ^ 2 * ((1 + x + x ^ 2) / z) - (1 + z) / x - z - 2 := by
  rw [eq_sub_replacementCorrection (s := {1, 2}) (x := Units.mk0 x hx) (z := Units.mk0 z hz)
    (xs := (1 + z) / x) (zs := (1 + x + x ^ 2) / z)
    (zss := (1 + (1 + z) / x + ((1 + z) / x) ^ 2) / z) (φ := 1) (n₀ := 1) (m₀ := 1) (N := 2)
    (n := id) (c := 1) (d := 1) (g := 1) (by simp [Units.val_mk0]; field_simp; ring)
    (by simp [Units.val_mk0]; field_simp; ring) (one_mul 1) (by simp) (by simp [hx])]
  simp [replacementCorrection_def, Units.val_inv_eq_inv_val]
  field_simp
  ring

end TauCeti
