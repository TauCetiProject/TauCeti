/-!
# Universal subtraction-free rational semifields

For an arbitrary index type `K` (possibly empty or infinite), `TauCeti.QsfZero K` is the semifield
of subtraction-free rational expressions in variables indexed by `K`, defined as
`TotalQuotient (MvPolynomial K ℕ)`. Its unit group `TauCeti.Qsf K := (QsfZero K)ˣ` is the universal
coefficient semifield generated by `K` (Fomin and Zelevinsky, *Cluster algebras IV*, Definition
2.1).

Because `MvPolynomial K ℕ` is a zero-sum-free domain semiring, `QsfZero K` automatically inherits
`Semifield (QsfZero K)` and `Subsingleton (AddUnits (QsfZero K))`, and `Qsf K` automatically
inherits `CoefficientSemifield (Qsf K)`.

## Main declarations

* `TauCeti.QsfZero` and `TauCeti.Qsf`: the universal zero-sum-free semifield on `K` and its unit
  group, with coordinate generators `TauCeti.QsfZero.X` and `TauCeti.Qsf.X`.
* `TauCeti.QsfZero.toFractionRing` and `TauCeti.Qsf.toFractionRingUnits`: injective embeddings into
  `FractionRing (MvPolynomial K ℤ)` and its unit group, with bidirectional range characterizations
  `TauCeti.QsfZero.mem_range_toFractionRing_iff` and
  `TauCeti.Qsf.mem_range_toFractionRingUnits_iff` as ratios of nonzero `ℕ`-polynomials.
* `TauCeti.QsfZero.eval`, `TauCeti.QsfZero.evalEquiv`, `TauCeti.Qsf.eval`, and
  `TauCeti.Qsf.evalEquiv`: universal properties into zero-sum-free semifields and coefficient
  semifields, together with agreement lemmas `TauCeti.QsfZero.unitsMap_eval` and
  `TauCeti.Qsf.mapWithZero_eval_comp`.
* `TauCeti.QsfZero.rename`, `TauCeti.QsfZero.renameEquiv`, `TauCeti.Qsf.rename`, and
  `TauCeti.Qsf.reindex`: functoriality along `K → K'` and reindexing along `K ≃ K'`.
* `TauCeti.QsfZero.equivNNRat` and `TauCeti.Qsf.equivNNRatUnits`: identification with `ℚ≥0` and
  `ℚ≥0ˣ` when `K` is empty.

## References

* S. Fomin and A. Zelevinsky, *Cluster algebras IV: Coefficients*, Compos. Math. 143 (2007), §2.
-/

public section

namespace TauCeti

/-- The universal zero-sum-free semifield on generators `K`: the total quotient semiring of
`MvPolynomial K ℕ`. -/
abbrev QsfZero (K : Type*) : Type _ :=
  TotalQuotient (MvPolynomial K ℕ)

/-- The universal coefficient semifield on generators `K`, realized as the unit group of
`TauCeti.QsfZero K`. -/
abbrev Qsf (K : Type*) : Type _ :=
  (QsfZero K)ˣ

/-! ### Generators and ratio presentation -/

namespace QsfZero

variable {K K' K'' : Type*}

/-- The `i`-th coordinate generator in `QsfZero K`. -/
noncomputable def X (i : K) : QsfZero K :=
  algebraMap (MvPolynomial K ℕ) (QsfZero K) (MvPolynomial.X i)

theorem algebraMap_X (i : K) :
    algebraMap (MvPolynomial K ℕ) (QsfZero K) (MvPolynomial.X i) = X i :=
  (rfl)

@[simp]
theorem X_ne_zero (i : K) : X i ≠ (0 : QsfZero K) :=
  (TotalQuotient.algebraMap_eq_zero_iff (A := MvPolynomial K ℕ)).not.mpr
    (MvPolynomial.X_ne_zero i)

theorem isUnit_X (i : K) : IsUnit (X i) :=
  (X_ne_zero i).isUnit

theorem X_injective : Function.Injective (X : K → QsfZero K) :=
  (TotalQuotient.algebraMap_injective (MvPolynomial K ℕ)).comp MvPolynomial.X_injective

@[simp]
theorem X_inj {i j : K} : X i = X j ↔ i = j :=
  X_injective.eq_iff

/-- Every element of `QsfZero K` is a ratio `p / q` of `ℕ`-polynomials with `q ≠ 0`. -/
theorem exists_div (z : QsfZero K) :
    ∃ p q : MvPolynomial K ℕ, q ≠ 0 ∧
      algebraMap (MvPolynomial K ℕ) (QsfZero K) p /
        algebraMap (MvPolynomial K ℕ) (QsfZero K) q = z :=
  TotalQuotient.div_surjective z

end QsfZero

namespace Qsf

variable {K K' K'' : Type*}

/-- The `i`-th coordinate generator in the universal coefficient semifield `Qsf K`. -/
noncomputable def X (i : K) : Qsf K :=
  Units.mk0 (QsfZero.X i) (QsfZero.X_ne_zero i)

@[simp, norm_cast]
theorem val_X (i : K) : ((X i : Qsf K) : QsfZero K) = QsfZero.X i :=
  (rfl)

theorem X_injective : Function.Injective (X : K → Qsf K) := fun _ _ h =>
  QsfZero.X_injective (congrArg Units.val h)

@[simp]
theorem X_inj {i j : K} : X i = X j ↔ i = j :=
  X_injective.eq_iff

/-- Every element of `Qsf K` is represented in `QsfZero K` as a ratio `p / q` of nonzero
`ℕ`-polynomials. -/
theorem exists_div (u : Qsf K) :
    ∃ p q : MvPolynomial K ℕ, p ≠ 0 ∧ q ≠ 0 ∧
      algebraMap (MvPolynomial K ℕ) (QsfZero K) p /
        algebraMap (MvPolynomial K ℕ) (QsfZero K) q = u := by
  obtain ⟨p, q, hq, hpq⟩ := QsfZero.exists_div (u : QsfZero K)
  refine ⟨p, q, ?_, hq, hpq⟩
  rintro rfl
  exact u.ne_zero (by simpa using hpq.symm)

end Qsf

/-! ### Embedding into rational functions over `ℤ` -/

namespace QsfZero

variable {K : Type*}

private noncomputable def polyToFractionRing (K : Type*) :
    MvPolynomial K ℕ →+* FractionRing (MvPolynomial K ℤ) :=
  (algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))).comp
    (MvPolynomial.map (Nat.castRingHom ℤ))

private theorem polyToFractionRing_injective (K : Type*) :
    Function.Injective (polyToFractionRing K) :=
  (IsFractionRing.injective (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))).comp
    (MvPolynomial.map_injective (Nat.castRingHom ℤ) Nat.cast_injective)

/-- Canonical semiring embedding of `QsfZero K` into `FractionRing (MvPolynomial K ℤ)`. -/
noncomputable def toFractionRing : QsfZero K →+* FractionRing (MvPolynomial K ℤ) :=
  TotalQuotient.lift (polyToFractionRing K) fun _ hq =>
    ((map_ne_zero_iff (polyToFractionRing K) (polyToFractionRing_injective K)).mpr
      hq.ne_zero).isUnit

theorem toFractionRing_injective :
    Function.Injective (toFractionRing (K := K)) :=
  TotalQuotient.lift_injective_of_injective _ (polyToFractionRing_injective K)

@[simp]
theorem toFractionRing_algebraMap (p : MvPolynomial K ℕ) :
    toFractionRing (algebraMap (MvPolynomial K ℕ) (QsfZero K) p) =
      algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))
        (MvPolynomial.map (Nat.castRingHom ℤ) p) :=
  TotalQuotient.lift_algebraMap _ _ p

@[simp]
theorem toFractionRing_X (i : K) :
    toFractionRing (X i) =
      algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ)) (MvPolynomial.X i) := by
  simp [X]

/-- An element of `FractionRing (MvPolynomial K ℤ)` lies in the image of `QsfZero K` if and only if
it can be written as a ratio `p / q` of `ℕ`-polynomials with `q ≠ 0`. -/
theorem mem_range_toFractionRing_iff (f : FractionRing (MvPolynomial K ℤ)) :
    f ∈ Set.range (toFractionRing (K := K)) ↔
      ∃ p q : MvPolynomial K ℕ, q ≠ 0 ∧
        algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))
            (MvPolynomial.map (Nat.castRingHom ℤ) p) /
          algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))
            (MvPolynomial.map (Nat.castRingHom ℤ) q) = f := by
  constructor
  · rintro ⟨z, rfl⟩
    obtain ⟨p, q, hq, rfl⟩ := exists_div z
    exact ⟨p, q, hq, by simp⟩
  · rintro ⟨p, q, -, rfl⟩
    exact ⟨algebraMap _ _ p / algebraMap _ _ q, by simp⟩

end QsfZero

namespace Qsf

variable {K : Type*}

/-- Canonical injective group homomorphism from `Qsf K` into the unit group of
`FractionRing (MvPolynomial K ℤ)`. -/
noncomputable def toFractionRingUnits :
    Qsf K →* (FractionRing (MvPolynomial K ℤ))ˣ :=
  Units.map QsfZero.toFractionRing.toMonoidHom

theorem toFractionRingUnits_injective :
    Function.Injective (toFractionRingUnits (K := K)) :=
  Units.map_injective QsfZero.toFractionRing_injective

@[simp, norm_cast]
theorem val_toFractionRingUnits (u : Qsf K) :
    ((toFractionRingUnits u : (FractionRing (MvPolynomial K ℤ))ˣ) :
      FractionRing (MvPolynomial K ℤ)) = QsfZero.toFractionRing u :=
  (rfl)

/-- Auxiliary addition in `Qsf K` maps to ordinary addition in `FractionRing (MvPolynomial K ℤ)`
(whose sum on the image of `Qsf K` is automatically nonzero). -/
theorem val_toFractionRingUnits_add (u v : Qsf K) :
    ((toFractionRingUnits (u + v) : (FractionRing (MvPolynomial K ℤ))ˣ) :
      FractionRing (MvPolynomial K ℤ)) =
      toFractionRingUnits u + toFractionRingUnits v := by
  simp [map_add]

/-- A unit of `FractionRing (MvPolynomial K ℤ)` lies in the image of `Qsf K` if and only if its
underlying rational function is a ratio `p / q` of nonzero `ℕ`-polynomials. -/
theorem mem_range_toFractionRingUnits_iff (u : (FractionRing (MvPolynomial K ℤ))ˣ) :
    u ∈ Set.range (toFractionRingUnits (K := K)) ↔
      ∃ p q : MvPolynomial K ℕ, p ≠ 0 ∧ q ≠ 0 ∧
        algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))
            (MvPolynomial.map (Nat.castRingHom ℤ) p) /
          algebraMap (MvPolynomial K ℤ) (FractionRing (MvPolynomial K ℤ))
            (MvPolynomial.map (Nat.castRingHom ℤ) q) = u := by
  have hrange : ((u : FractionRing (MvPolynomial K ℤ)) ∈
      Set.range (QsfZero.toFractionRing (K := K))) ↔
      u ∈ Set.range (toFractionRingUnits (K := K)) :=
    mem_range_iff_exists_units_map_eq QsfZero.toFractionRing u
  rw [← hrange, QsfZero.mem_range_toFractionRing_iff]
  refine ⟨fun ⟨p, q, hq, hpq⟩ => ⟨p, q, ?_, hq, hpq⟩, fun ⟨p, q, _, hq, hpq⟩ => ⟨p, q, hq, hpq⟩⟩
  rintro rfl
  exact u.ne_zero (by simpa using hpq.symm)

end Qsf

/-! ### Universal properties and agreement of zero-adjoined and unit-level evaluations -/

namespace QsfZero

section Universal

variable {K : Type*}

/-- Two semiring homomorphisms out of `QsfZero K` into any semiring agree as soon as they agree on
the coordinate generators `QsfZero.X i`. -/
@[ext]
theorem ringHom_ext {T : Type*} [Semiring T] {F G : QsfZero K →+* T}
    (h : ∀ i : K, F (X i) = G (X i)) :
    F = G := by
  apply TotalQuotient.ringHom_ext
  have hhom : F.comp (algebraMap (MvPolynomial K ℕ) (QsfZero K)) =
      G.comp (algebraMap (MvPolynomial K ℕ) (QsfZero K)) :=
    MvPolynomial.ringHom_ext' (Subsingleton.elim _ _) fun i => h i
  exact DFunLike.congr_fun hhom

variable {S T : Type*} [Semifield S] [Subsingleton (AddUnits S)]
  [Semifield T] [Subsingleton (AddUnits T)]

/-- Evaluate subtraction-free rational expressions at any family of units `y : K → Sˣ` of a
zero-sum-free semifield `S`. -/
noncomputable def eval (y : K → Sˣ) : QsfZero K →+* S :=
  TotalQuotient.lift (MvPolynomial.eval₂Hom (Nat.castRingHom S) fun i => (y i : S)) fun q hq => by
    refine IsUnit.mk0 _ ?_
    exact (MvPolynomial.eval₂_eq_zero_iff_of_subsingleton_addUnits q
      (fun _ hm => Nat.cast_ne_zero_of_subsingleton_addUnits (MvPolynomial.mem_support_iff.mp hm))
      (fun _ _ i _ => (y i).ne_zero)).not.mpr hq.ne_zero

@[simp]
theorem eval_algebraMap (y : K → Sˣ) (p : MvPolynomial K ℕ) :
    eval y (algebraMap (MvPolynomial K ℕ) (QsfZero K) p) =
      MvPolynomial.eval₂ (Nat.castRingHom S) (fun i => (y i : S)) p :=
  TotalQuotient.lift_algebraMap _ _ p

@[simp]
theorem eval_X (y : K → Sˣ) (i : K) :
    eval y (X i) = y i := by
  simp [X]

theorem eval_unique {y : K → Sˣ} {F : QsfZero K →+* S}
    (hF : ∀ i : K, F (X i) = y i) :
    F = eval y :=
  ringHom_ext fun i => (hF i).trans (eval_X y i).symm

@[simp]
theorem eval_X_self :
    eval (Qsf.X : K → Qsf K) = RingHom.id (QsfZero K) :=
  (eval_unique fun _ => rfl).symm

theorem comp_eval (G : S →+* T) (y : K → Sˣ) :
    G.comp (eval y) = eval (CoefficientSemifieldHom.unitsMap G ∘ y) :=
  eval_unique fun i => by simp

/-- Universal property of `QsfZero K`: semiring homomorphisms `QsfZero K →+* S` into a
zero-sum-free semifield `S` correspond bijectively to families of units `K → Sˣ`. -/
noncomputable def evalEquiv : (K → Sˣ) ≃ (QsfZero K →+* S) where
  toFun := eval
  invFun F i := CoefficientSemifieldHom.unitsMap F (Qsf.X i)
  left_inv y := by
    ext i
    simp
  right_inv F := (eval_unique fun i => by simp).symm

@[simp]
theorem evalEquiv_apply (y : K → Sˣ) :
    evalEquiv y = eval y :=
  (rfl)

@[simp, norm_cast]
theorem val_evalEquiv_symm_apply (F : QsfZero K →+* S) (i : K) :
    ((evalEquiv.symm F i : Sˣ) : S) = F (X i) := by
  simp [evalEquiv]

end Universal

end QsfZero

namespace Qsf

section Universal

open CoefficientSemifield CoefficientSemifieldHom

variable {K : Type*} {P Q : Type*} [CoefficientSemifield P] [CoefficientSemifield Q]

/-- The unique coefficient-semifield homomorphism `Qsf K → P` sending each coordinate generator
`Qsf.X i` to `y i`. -/
noncomputable def eval (y : K → P) : CoefficientSemifieldHom (Qsf K) P :=
  (toUnitsWithZero P).symm.toCoefficientSemifieldHom.comp
    (unitsMap (QsfZero.eval (toUnitsWithZero P ∘ y)))

@[simp]
theorem coe_eval (y : K → P) (u : Qsf K) :
    ((eval y u : P) : WithZero P) = QsfZero.eval (toUnitsWithZero P ∘ y) u := by
  simp [eval, comp_apply]

@[simp]
theorem eval_X (y : K → P) (i : K) :
    eval y (X i) = y i := by
  apply (WithZero.coe_inj (α := P)).mp
  simp

/-- Two coefficient-semifield homomorphisms out of `Qsf K` agree as soon as they agree on the
coordinate generators `Qsf.X i`. -/
@[ext]
theorem hom_ext {f g : CoefficientSemifieldHom (Qsf K) P}
    (h : ∀ i : K, f (X i) = g (X i)) :
    f = g := by
  let F : QsfZero K →+* WithZero P :=
    (mapWithZero f).comp ((withZeroUnitsEquiv (QsfZero K)).symm : QsfZero K →+* WithZero (Qsf K))
  let G : QsfZero K →+* WithZero P :=
    (mapWithZero g).comp ((withZeroUnitsEquiv (QsfZero K)).symm : QsfZero K →+* WithZero (Qsf K))
  have hFG : F = G := by
    ext i
    simpa [F, G, ← val_X] using congrArg (WithZero.coe (α := P)) (h i)
  ext u
  apply (WithZero.coe_inj (α := P)).mp
  simpa [F, G] using DFunLike.congr_fun hFG (u : QsfZero K)

theorem eval_unique {y : K → P} {f : CoefficientSemifieldHom (Qsf K) P}
    (hf : ∀ i : K, f (X i) = y i) :
    f = eval y :=
  hom_ext fun i => (hf i).trans (eval_X y i).symm

@[simp]
theorem eval_X_self :
    eval (X : K → Qsf K) = .id (Qsf K) :=
  (eval_unique fun i => CoefficientSemifieldHom.id_apply (X i)).symm

theorem comp_eval (g : CoefficientSemifieldHom P Q) (y : K → P) :
    g.comp (eval y) = eval (g ∘ y) :=
  eval_unique fun i => by simp [comp_apply]

/-- Universal property of `Qsf K`: `Qsf K` is the free coefficient semifield on `K`. -/
noncomputable def evalEquiv : (K → P) ≃ CoefficientSemifieldHom (Qsf K) P where
  toFun := eval
  invFun f i := f (X i)
  left_inv y := funext (eval_X y)
  right_inv _ := (eval_unique fun _ => rfl).symm

@[simp]
theorem evalEquiv_apply (y : K → P) :
    evalEquiv y = eval y :=
  (rfl)

@[simp]
theorem evalEquiv_symm_apply (f : CoefficientSemifieldHom (Qsf K) P) (i : K) :
    evalEquiv.symm f i = f (X i) :=
  (rfl)

/-- Agreement of zero-adjoined and unit-level evaluations (unit direction): restricting
`QsfZero.eval y` to units gives `Qsf.eval y`. -/
@[simp]
theorem _root_.TauCeti.QsfZero.unitsMap_eval {S : Type*} [Semifield S] [Subsingleton (AddUnits S)]
    (y : K → Sˣ) :
    unitsMap (QsfZero.eval y) = eval y :=
  eval_unique fun i => Units.ext (by simp)

/-- Agreement of zero-adjoined and unit-level evaluations (`WithZero` direction): extending
`Qsf.eval y` by zero along `WithZero (Qsf K) ≃+* QsfZero K` recovers `QsfZero.eval`. -/
@[simp]
theorem mapWithZero_eval_comp (y : K → P) :
    (mapWithZero (eval y)).comp
        ((withZeroUnitsEquiv (QsfZero K)).symm : QsfZero K →+* WithZero (Qsf K)) =
      QsfZero.eval (toUnitsWithZero P ∘ y) := by
  ext i
  have hx : (withZeroUnitsEquiv (QsfZero K)).symm (QsfZero.X i) = X i :=
    withZeroUnitsEquiv_symm_coe (X i)
  simp [hx]

end Universal

end Qsf

/-! ### Functoriality and reindexing -/

namespace QsfZero

variable {K K' K'' : Type*}

/-- Functoriality of `QsfZero` along an arbitrary map `f : K → K'` of generator sets. -/
noncomputable def rename (f : K → K') : QsfZero K →+* QsfZero K' :=
  eval fun i => Qsf.X (f i)

@[simp]
theorem rename_X (f : K → K') (i : K) :
    rename f (X i) = X (f i) := by
  simp [rename]

@[simp]
theorem rename_algebraMap (f : K → K') (p : MvPolynomial K ℕ) :
    rename f (algebraMap (MvPolynomial K ℕ) (QsfZero K) p) =
      algebraMap (MvPolynomial K' ℕ) (QsfZero K') (MvPolynomial.rename f p) := by
  have hhom : (rename f).comp (algebraMap (MvPolynomial K ℕ) (QsfZero K)) =
      (algebraMap (MvPolynomial K' ℕ) (QsfZero K')).comp (MvPolynomial.rename f).toRingHom :=
    MvPolynomial.ringHom_ext' (Subsingleton.elim _ _) fun i => by simp [algebraMap_X]
  exact DFunLike.congr_fun hhom p

@[simp]
theorem rename_id : rename (id : K → K) = RingHom.id (QsfZero K) := by
  ext i
  simp

theorem rename_comp_rename (g : K' → K'') (f : K → K') :
    (rename g).comp (rename f) = rename (g ∘ f) := by
  ext i
  simp

theorem eval_comp_rename {S : Type*} [Semifield S] [Subsingleton (AddUnits S)]
    (y : K' → Sˣ) (f : K → K') :
    (eval y).comp (rename f) = eval (y ∘ f) := by
  ext i
  simp

/-- Reindexing generators along `e : K ≃ K'` induces a semiring isomorphism on `QsfZero`. -/
noncomputable def renameEquiv (e : K ≃ K') : QsfZero K ≃+* QsfZero K' :=
  RingEquiv.ofRingHom (rename e) (rename e.symm)
    (by rw [rename_comp_rename]; ext i; simp)
    (by rw [rename_comp_rename]; ext i; simp)

@[simp]
theorem renameEquiv_apply (e : K ≃ K') (z : QsfZero K) :
    renameEquiv e z = rename e z :=
  (rfl)

@[simp]
theorem renameEquiv_refl : renameEquiv (Equiv.refl K) = RingEquiv.refl (QsfZero K) := by
  apply RingEquiv.toRingHom_injective
  ext i
  simp [RingEquiv.toRingHom_eq_coe]

@[simp]
theorem renameEquiv_symm (e : K ≃ K') :
    (renameEquiv e).symm = renameEquiv e.symm :=
  (rfl)

@[simp]
theorem renameEquiv_trans (e₁ : K ≃ K') (e₂ : K' ≃ K'') :
    renameEquiv (e₁.trans e₂) = (renameEquiv e₁).trans (renameEquiv e₂) := by
  apply RingEquiv.toRingHom_injective
  ext i
  simp [RingEquiv.toRingHom_eq_coe]

/-- When `K` is empty, `QsfZero K` is canonically isomorphic to `ℚ≥0`. -/
noncomputable def equivNNRat [IsEmpty K] : QsfZero K ≃+* ℚ≥0 :=
  RingEquiv.ofRingHom
    (eval isEmptyElim)
    (IsLocalization.lift (M := nonZeroDivisors ℕ) (g := Nat.castRingHom (QsfZero K)) fun y =>
      (Nat.cast_ne_zero_of_subsingleton_addUnits
        (mem_nonZeroDivisors_iff_ne_zero.mp y.2)).isUnit)
    (by
      apply IsLocalization.ringHom_ext (nonZeroDivisors ℕ)
      ext
      simp)
    (by
      ext i
      exact isEmptyElim i)

end QsfZero

namespace Qsf

variable {K K' K'' : Type*}

/-- Functoriality of `Qsf` along an arbitrary map `f : K → K'` of generator sets. -/
noncomputable def rename (f : K → K') : CoefficientSemifieldHom (Qsf K) (Qsf K') :=
  CoefficientSemifieldHom.unitsMap (QsfZero.rename f)

@[simp, norm_cast]
theorem val_rename (f : K → K') (u : Qsf K) :
    ((rename f u : Qsf K') : QsfZero K') = QsfZero.rename f u := by
  simp [rename]

@[simp]
theorem rename_X (f : K → K') (i : K) :
    rename f (X i) = X (f i) :=
  Units.ext (by simp)

theorem rename_eq_eval (f : K → K') :
    rename f = eval fun i => X (f i) := by
  simp [rename, QsfZero.rename]

@[simp]
theorem rename_id : rename (id : K → K) = .id (Qsf K) := by
  ext i
  simp

theorem rename_comp_rename (g : K' → K'') (f : K → K') :
    (rename g).comp (rename f) = rename (g ∘ f) := by
  ext i
  simp [CoefficientSemifieldHom.comp_apply]

theorem eval_comp_rename {P : Type*} [CoefficientSemifield P]
    (y : K' → P) (f : K → K') :
    (eval y).comp (rename f) = eval (y ∘ f) := by
  ext i
  simp [CoefficientSemifieldHom.comp_apply]

/-- Reindexing generators along `e : K ≃ K'` induces a coefficient-semifield isomorphism on
`Qsf`, matching `Trop.reindex`. -/
noncomputable def reindex (e : K ≃ K') : Qsf K ≃+* Qsf K' where
  __ := Units.mapEquiv (QsfZero.renameEquiv e).toMulEquiv
  map_add' u v := Units.ext (by simp [map_add])

@[simp, norm_cast]
theorem val_reindex (e : K ≃ K') (u : Qsf K) :
    ((reindex e u : Qsf K') : QsfZero K') = QsfZero.renameEquiv e u :=
  (rfl)

@[simp]
theorem toCoefficientSemifieldHom_reindex (e : K ≃ K') :
    (reindex e).toCoefficientSemifieldHom = rename e := by
  ext i
  simp

@[simp]
theorem reindex_X (e : K ≃ K') (i : K) :
    reindex e (X i) = X (e i) :=
  Units.ext (by simp)

@[simp]
theorem reindex_refl : reindex (Equiv.refl K) = RingEquiv.refl (Qsf K) := by
  ext u
  simp [reindex]

@[simp]
theorem reindex_symm (e : K ≃ K') :
    (reindex e).symm = reindex e.symm :=
  (rfl)

@[simp]
theorem reindex_trans (e₁ : K ≃ K') (e₂ : K' ≃ K'') :
    reindex (e₁.trans e₂) = (reindex e₁).trans (reindex e₂) := by
  ext u
  simp [reindex]

/-- When `K` is empty, `Qsf K` is canonically isomorphic to `ℚ≥0ˣ`. -/
noncomputable def equivNNRatUnits [IsEmpty K] : Qsf K ≃+* ℚ≥0ˣ where
  __ := Units.mapEquiv (QsfZero.equivNNRat (K := K)).toMulEquiv
  map_add' u v := Units.ext (by simp [map_add])

end Qsf

/-! ### Checks -/

section Checks

-- The empty tropical case reproduces the Boolean semifield `WithZero PUnit`, and the empty
-- universal case reproduces `ℚ≥0` and `ℚ≥0ˣ`.
noncomputable example : WithZero (Trop Empty) ≃+* WithZero PUnit :=
  CoefficientSemifield.withZeroCongr
    { toFun := fun _ => PUnit.unit
      invFun := fun _ => 1
      left_inv := fun x => Subsingleton.elim _ x
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => Subsingleton.elim _ _
      map_add' := fun _ _ => Subsingleton.elim _ _ }

noncomputable example : QsfZero Empty ≃+* ℚ≥0 := QsfZero.equivNNRat
noncomputable example : Qsf Empty ≃+* ℚ≥0ˣ := Qsf.equivNNRatUnits

-- Subtraction-free factoring identity `(y₀² + y₀ y₁) / (y₀ + y₁) = y₀` holds in `Qsf (Fin 2)` and
-- therefore under every homomorphism into any coefficient semifield `P` (including tropical ones
-- where cancellation of `+` fails).
example {P : Type*} [CoefficientSemifield P]
    (f : CoefficientSemifieldHom (Qsf (Fin 2)) P) :
    f (((Qsf.X 0) ^ 2 + Qsf.X 0 * Qsf.X 1) / (Qsf.X 0 + Qsf.X 1)) = f (Qsf.X 0) := by
  have hfac : ((Qsf.X (0 : Fin 2)) ^ 2 + Qsf.X 0 * Qsf.X 1) / (Qsf.X 0 + Qsf.X 1) = Qsf.X 0 := by
    rw [sq, ← mul_add, mul_div_cancel_right]
  rw [hfac]

-- Evaluating `(y₀ + y₁)⁻¹` at the tropical generators in `Trop (Fin 2)` yields `1` (`min(1,0)=0`
-- in exponent coordinates, negated to `0`).
example : Qsf.eval Trop.generator ((Qsf.X (0 : Fin 2) + Qsf.X 1)⁻¹) = (1 : Trop (Fin 2)) := by
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  rw [map_inv, map_add, Qsf.eval_X, Qsf.eval_X, Trop.generator_add_generator h01, inv_one]

end Checks

end TauCeti
