/-!
# The subalgebra of a based chart on a set of exponents

Let `M` be a based chart for `(R, u, Λ)` in an `R`-algebra `B`, with exponents in `L`, and let
`N` be a set of exponents. `BasedChart.subalgebra M N` is the subalgebra generated by the
monomials with exponents in `N`; if `N` is closed under addition and contains `0`, such as an
additive submonoid or subgroup of `L`, it is their `R`-span. No hypothesis on the form `Λ` is
needed.

Conjugation by a unit that maps these monomials into the subalgebra maps all of it into itself;
in particular conjugation by any chart monomial or its inverse does, since it rescales each
monomial by a power of `u`. So does conjugation by a unit `y` commuting with these monomials up
to scalar units, and by its inverse; hence the product of `y` with a chart monomial normalizes
the subalgebra. If `N` is a subgroup and no nonzero multiple of `e` lies in `N`, the integer
powers of the monomial at `e` have unique left coefficients in the subalgebra. The passage from
independence over `R` to independence over the subalgebra uses Tau Ceti's
`LinearIndependent.of_smul_of_span_eq_top`, the converse of Mathlib's `linearIndependent_smul`.

## Main definitions

* `TauCeti.BasedChart.subalgebra`: the subalgebra generated by the chart monomials with
  exponents in `N`.

## Main results

* `TauCeti.BasedChart.toSubmodule_subalgebra`: this subalgebra is the span of its monomials.
* `TauCeti.BasedChart.mul_mul_inv_mem_subalgebra`: conjugation by a unit preserving the
  monomials preserves the subalgebra.
* `TauCeti.BasedChart.mul_monomial_mul_mul_inv_mem_subalgebra_iff`: the product of a chart
  monomial and a unit commuting with the monomials of `N` up to scalars normalizes the
  subalgebra.
* `TauCeti.BasedChart.linearIndependent_zpow_monomial`: unique left coefficients for powers of
  a monomial transverse to `N`.

## References

* A. Berenstein and A. Zelevinsky, *Quantum cluster algebras*, Advances in Mathematics
  195 (2005), §4, for toric frames.
-/

public section

namespace TauCeti

namespace BasedChart

variable {R L B : Type*} [CommSemiring R] [AddCommGroup L] [Semiring B] [Algebra R B]
  {u : Rˣ} {Λ : LinearMap.BilinForm ℤ L} {S : Type*} [SetLike S L] [AddSubmonoidClass S L]

/-- Two chart monomials commute up to the scalar `u ^ (Λ(a, b) - Λ(b, a))`. -/
private theorem val_monomial_mul_monomial_eq_smul_mul_sub (M : BasedChart u Λ B) (a b : L) :
    (M.monomial a : B) * M.monomial b =
      ((u ^ (Λ a b - Λ b a) : Rˣ) : R) • ((M.monomial b : B) * M.monomial a) := by
  rw [val_monomial_mul, val_monomial_mul, smul_smul, ← Units.val_mul, ← zpow_add,
    sub_add_cancel, add_comm]

/-- The products of two monomials with exponents in `N` are scalar multiples of a monomial with
exponent in `N`, so their span is closed under multiplication. -/
private theorem mul_mem_span_monomial (M : BasedChart u Λ B) (N : S) {c d : B}
    (hc : c ∈ Submodule.span R ((fun a ↦ (M.monomial a : B)) '' N))
    (hd : d ∈ Submodule.span R ((fun a ↦ (M.monomial a : B)) '' N)) :
    c * d ∈ Submodule.span R ((fun a ↦ (M.monomial a : B)) '' N) := by
  have h := Submodule.mul_mem_mul hc hd
  rw [Submodule.span_mul_span] at h
  refine Submodule.span_le.mpr ?_ h
  rintro _ ⟨_, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, rfl⟩
  dsimp only
  rw [SetLike.mem_coe, val_monomial_mul]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a + b, add_mem ha hb, rfl⟩)

/-- Integer powers of a chart monomial are unit multiples of monomials, for any form. -/
private theorem exists_val_monomial_zpow (M : BasedChart u Λ B) (a : L) (n : ℤ) :
    ∃ r : Rˣ, ((M.monomial a ^ n : Bˣ) : B) = (r : R) • (M.monomial (n • a) : B) := by
  induction n using Int.induction_on with
  | zero => exact ⟨1, by simp⟩
  | succ n ih =>
    obtain ⟨r, hr⟩ := ih
    refine ⟨r * u ^ Λ ((n : ℤ) • a) a, ?_⟩
    rw [zpow_add_one, Units.val_mul, hr, smul_mul_assoc, val_monomial_mul, smul_smul,
      ← Units.val_mul, add_smul, one_smul]
  | pred n ih =>
    obtain ⟨r, hr⟩ := ih
    refine ⟨r * u ^ Λ a a * u ^ Λ (-(n : ℤ) • a) (-a), ?_⟩
    rw [zpow_sub_one, Units.val_mul, hr, val_inv_monomial, smul_mul_assoc, mul_smul_comm,
      val_monomial_mul, smul_smul, smul_smul, ← Units.val_mul, ← Units.val_mul, sub_smul,
      one_smul, sub_eq_add_neg]

/-- The subalgebra generated by the chart monomials with exponents in `N`. When `N` is a
subgroup, it is the image of the based quantum torus on `N` under the chart. -/
noncomputable def subalgebra (M : BasedChart u Λ B) (N : S) : Subalgebra R B :=
  Algebra.adjoin R ((fun a ↦ (M.monomial a : B)) '' N)

omit [AddSubmonoidClass S L] in
/-- The subalgebra of `N` is the subalgebra generated by the monomials of `N`. -/
theorem subalgebra_eq_adjoin (M : BasedChart u Λ B) (N : S) :
    M.subalgebra N = Algebra.adjoin R ((fun a ↦ (M.monomial a : B)) '' N) :=
  (rfl)

/-- The underlying submodule of the subalgebra of `N` is the span of its monomials. -/
@[simp]
theorem toSubmodule_subalgebra (M : BasedChart u Λ B) (N : S) :
    Subalgebra.toSubmodule (M.subalgebra N) =
      Submodule.span R ((fun a ↦ (M.monomial a : B)) '' N) :=
  Algebra.adjoin_eq_span_of_subset R fun _ hx ↦
    Submonoid.closure_induction (fun _ h ↦ Submodule.subset_span h)
      (Submodule.subset_span ⟨0, zero_mem N, by simp⟩)
      (fun _ _ _ _ hc hd ↦ mul_mem_span_monomial M N hc hd) hx

/-- Membership in the subalgebra of `N` is membership in the `R`-span of its monomials. -/
theorem mem_subalgebra_iff (M : BasedChart u Λ B) (N : S) {c : B} :
    c ∈ M.subalgebra N ↔ c ∈ Submodule.span R ((fun a ↦ (M.monomial a : B)) '' N) := by
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_subalgebra]

omit [AddSubmonoidClass S L] in
/-- Every monomial with exponent in `N` lies in the subalgebra of `N`. -/
theorem monomial_mem_subalgebra (M : BasedChart u Λ B) {N : S} {a : L}
    (ha : a ∈ N) : (M.monomial a : B) ∈ M.subalgebra N :=
  Algebra.subset_adjoin ⟨a, ha, rfl⟩

/-- The monomials of `N`, viewed in the subalgebra of `N`, span it over `R`. -/
theorem span_range_monomial_subalgebra (M : BasedChart u Λ B) (N : S) :
    Submodule.span R (Set.range fun a : N ↦
      (⟨M.monomial a, M.monomial_mem_subalgebra a.property⟩ : M.subalgebra N)) = ⊤ :=
  (Submodule.span_range_subtype_eq_top_iff (Subalgebra.toSubmodule (M.subalgebra N))
    fun a : N ↦ M.monomial_mem_subalgebra a.property).mpr <| by
      rw [toSubmodule_subalgebra, Set.image_eq_range]
      rfl

omit [AddSubmonoidClass S L] in
/-- If conjugation by a unit maps every monomial of `N` into the subalgebra of `N`, it maps the
whole subalgebra into itself. -/
theorem mul_mul_inv_mem_subalgebra (M : BasedChart u Λ B) {N : S} {g : Bˣ}
    (hg : ∀ a ∈ N, (g : B) * M.monomial a * ↑g⁻¹ ∈ M.subalgebra N) {c : B}
    (hc : c ∈ M.subalgebra N) : (g : B) * c * ↑g⁻¹ ∈ M.subalgebra N := by
  rw [subalgebra_eq_adjoin] at hc
  induction hc using Algebra.adjoin_induction with
  | mem c hc =>
    obtain ⟨a, ha, rfl⟩ := hc
    exact hg a ha
  | algebraMap r =>
    rw [← Algebra.commutes r (g : B), mul_assoc, Units.mul_inv, mul_one]
    exact (M.subalgebra N).algebraMap_mem r
  | add c d _ _ hc hd =>
    simpa only [mul_add, add_mul] using (M.subalgebra N).add_mem hc hd
  | mul c d _ _ hc hd =>
    simpa only [mul_assoc, Units.inv_mul_cancel_left] using (M.subalgebra N).mul_mem hc hd

omit [AddSubmonoidClass S L] in
/-- Conjugation by any chart monomial maps the subalgebra of `N` into itself, since it rescales
each monomial by a power of `u`. -/
theorem monomial_mul_mul_inv_mem_subalgebra (M : BasedChart u Λ B) {N : S} (b : L)
    {c : B} (hc : c ∈ M.subalgebra N) :
    (M.monomial b : B) * c * ↑(M.monomial b)⁻¹ ∈ M.subalgebra N := by
  refine M.mul_mul_inv_mem_subalgebra (fun a ha ↦ ?_) hc
  rw [val_monomial_mul_monomial_eq_smul_mul_sub]
  simpa only [smul_mul_assoc, mul_assoc, Units.mul_inv, mul_one] using
    Subalgebra.smul_mem _ (M.monomial_mem_subalgebra ha) ((u ^ (Λ b a - Λ a b) : Rˣ) : R)

omit [AddSubmonoidClass S L] in
/-- Conjugation by the inverse of any chart monomial maps the subalgebra of `N` into itself. -/
theorem monomial_inv_mul_mul_mem_subalgebra (M : BasedChart u Λ B) {N : S} (b : L)
    {c : B} (hc : c ∈ M.subalgebra N) :
    (↑(M.monomial b)⁻¹ : B) * c * M.monomial b ∈ M.subalgebra N := by
  refine M.mul_mul_inv_mem_subalgebra (g := (M.monomial b)⁻¹) (fun a ha ↦ ?_) hc
  rw [inv_inv, mul_assoc, val_monomial_mul_monomial_eq_smul_mul_sub]
  simpa only [mul_smul_comm, ← mul_assoc, Units.inv_mul, one_mul] using
    Subalgebra.smul_mem _ (M.monomial_mem_subalgebra ha) ((u ^ (Λ a b - Λ b a) : Rˣ) : R)

omit [AddSubmonoidClass S L] in
/-- Conjugation by a unit commuting with the monomials of `N` up to scalar units maps the
subalgebra of `N` into itself. -/
private theorem mul_mul_inv_mem_subalgebra_of_forall_exists (M : BasedChart u Λ B) {N : S}
    {g : Bˣ} (hg : ∀ a ∈ N, ∃ r : Rˣ,
      g * M.monomial a = Units.map (algebraMap R B) r * (M.monomial a * g))
    {c : B} (hc : c ∈ M.subalgebra N) : (g : B) * c * ↑g⁻¹ ∈ M.subalgebra N := by
  refine M.mul_mul_inv_mem_subalgebra (fun a ha ↦ ?_) hc
  obtain ⟨r, hr⟩ := hg a ha
  have h : (g : B) * M.monomial a * ↑g⁻¹ = (r : R) • (M.monomial a : B) := by
    rw [← Units.val_mul, hr]
    simp [Algebra.smul_def, mul_assoc]
  rw [h]
  exact Subalgebra.smul_mem _ (M.monomial_mem_subalgebra ha) _

omit [AddSubmonoidClass S L] in
/-- If a unit commutes with the monomials of `N` up to scalar units, so does its inverse. -/
private theorem forall_exists_inv_mul_monomial (M : BasedChart u Λ B) {N : S} {g : Bˣ}
    (hg : ∀ a ∈ N, ∃ r : Rˣ,
      g * M.monomial a = Units.map (algebraMap R B) r * (M.monomial a * g)) :
    ∀ a ∈ N, ∃ r : Rˣ,
      g⁻¹ * M.monomial a = Units.map (algebraMap R B) r * (M.monomial a * g⁻¹) := by
  intro a ha
  obtain ⟨r, hr⟩ := hg a ha
  -- Scalar units are central, so the relation for `g` can be solved for `g⁻¹ * M(a)`.
  have hc : Commute (Units.map (algebraMap R B : R →* B) r) g⁻¹ :=
    Units.ext (Algebra.commutes (r : R) _)
  refine ⟨r⁻¹, ?_⟩
  rw [map_inv, eq_inv_mul_iff_mul_eq, ← mul_assoc, hc.eq, mul_assoc, inv_mul_eq_iff_eq_mul,
    ← mul_assoc, hr, mul_assoc, mul_inv_cancel_right]

omit [AddSubmonoidClass S L] in
/-- The product of a chart monomial `M(b)` and a unit `y` commuting with the monomials of `N` up
to scalar units normalizes the subalgebra of `N`: conjugation by `y * M(b)` maps this subalgebra
onto itself. -/
theorem mul_monomial_mul_mul_inv_mem_subalgebra_iff (M : BasedChart u Λ B) {N : S} (b : L)
    {y : Bˣ} (hy : ∀ a ∈ N, ∃ r : Rˣ,
      y * M.monomial a = Units.map (algebraMap R B) r * (M.monomial a * y))
    {c : B} :
    ((y * M.monomial b : Bˣ) : B) * c * ↑(y * M.monomial b)⁻¹ ∈ M.subalgebra N ↔
      c ∈ M.subalgebra N := by
  constructor
  · intro hc
    simpa [mul_assoc] using M.monomial_inv_mul_mul_mem_subalgebra b
      (M.mul_mul_inv_mem_subalgebra_of_forall_exists (M.forall_exists_inv_mul_monomial hy) hc)
  · intro hc
    simpa [mul_assoc] using
      M.mul_mul_inv_mem_subalgebra_of_forall_exists hy (M.monomial_mul_mul_inv_mem_subalgebra b hc)

omit [AddSubmonoidClass S L] in
/-- If no nonzero multiple of `e` lies in `N`, the integer powers of the monomial at `e` have
unique left coefficients in the subalgebra of `N`. Here `N` is closed under subtraction, as a
subgroup is. -/
theorem linearIndependent_zpow_monomial [AddSubgroupClass S L] (M : BasedChart u Λ B) {N : S}
    {e : L}
    (he : ∀ n : ℤ, n • e ∈ N → n = 0) :
    LinearIndependent (M.subalgebra N) fun n : ℤ ↦ ((M.monomial e ^ n : Bˣ) : B) := by
  refine LinearIndependent.of_smul_of_span_eq_top ?_ (M.span_range_monomial_subalgebra N)
  have hinj : Function.Injective fun p : N × ℤ ↦ (p.1 : L) + p.2 • e := by
    rintro ⟨a, n⟩ ⟨b, m⟩ h
    have hnm : n = m := by
      have h' : (n - m) • e = (b : L) - a := by
        simp only at h
        calc (n - m) • e = ((a : L) + n • e) - a - m • e := by rw [sub_smul]; abel
          _ = b - a := by rw [h]; abel
      exact sub_eq_zero.mp (he _ (h' ▸ sub_mem b.property a.property))
    subst hnm
    exact Prod.ext (Subtype.ext (add_right_cancel h)) rfl
  choose r hr using M.exists_val_monomial_zpow e
  convert (M.linearIndependent.comp _ hinj).units_smul
    (fun p : N × ℤ ↦ r p.2 * u ^ (Λ p.1 (p.2 • e))) using 1
  funext p
  rw [Subalgebra.smul_def, hr, smul_eq_mul, mul_smul_comm, val_monomial_mul, smul_smul]
  simp only [Pi.smul_apply', Function.comp_apply, Units.smul_def, Units.val_mul]

end BasedChart

