/-!
# Laurent intersection, skew-matrix updates, and skew-field invariance for based-chart exchange

Building on `BasedChart.offAlgebra` and `BasedChart.exchange` (`OneExchange/BasedChart.lean`) and
the abstract one-step Laurent intersection (`OneExchange/Intersection.lean`):

* For any integral bilinear form `Λ`, the `k`-th coordinate `M.monomial (Finsupp.single k 1)` and
  any unit `y` quasi-commuting with monomials off `k` normalize `(M.offAlgebra k).toSubsemiring`
  under `ConjAct` (`BasedChart.conjAct_coordinate_offAlgebra`,
  `BasedChart.conjAct_unit_offAlgebra`, `BasedChart.conjAct_mul_coordinate_offAlgebra`).
* Whenever `Λ (Finsupp.single k 1) (Finsupp.single k 1) = 0`, finite left Laurent sums over
  `M.offAlgebra k` in the `k`-th coordinate and in an exchanged unit `y` are injective
  (`BasedChart.skewLaurentSum_coordinate_injective`,
  `BasedChart.skewLaurentSum_exchange_injective`), and the two Laurent extensions intersect in the
  positive subsemiring generated by `M.offAlgebra k`, `M.monomial (Finsupp.single k 1)`, and `y`
  (`BasedChart.laurentAdjoin_coordinate_inf_laurentAdjoin`).
* For a matrix form `A.finsuppBilinForm`, `BasedChart.exchangeUpdateSkew` specializes
  `BasedChart.exchange` to the canonical skew-updated matrix
  `A.updateSkew k (fun j ↦ μ (Finsupp.single j 1))`.
* Over any division ring `D`, one-step exchange preserves the ambient skew-field closure
  `Subfield.closure (Set.range M.eval)` (`BasedChart.subfieldClosure_exchange`,
  `BasedChart.subfieldClosure_exchangeUpdateSkew`, `QuantumTorus.subfieldClosure_eq_of_exchange`).

## References

* A. Berenstein and A. Zelevinsky, *Quantum cluster algebras*, Adv. Math. 195 (2005), §§4–5.
* A. Berenstein, S. Fomin, and A. Zelevinsky, *Cluster algebras III*, Duke Math. J. 126 (2005), §4.
-/

public section

open scoped Pointwise

namespace TauCeti

namespace BasedChart

section Semiring

variable {R I B : Type*} [CommSemiring R] {u : Rˣ} {Λ : LinearMap.BilinForm ℤ (I →₀ ℤ)}
  [Semiring B] [Algebra R B]

private theorem linearIndependent_offAlgebra_iff
    (M : BasedChart u Λ B) (k : I) (v : ℤ → B) :
    LinearIndependent (M.offAlgebra k).toSubsemiring v ↔
      LinearIndependent R (fun a : I →₀ ℤ ↦ (M.monomial (a.erase k) : B) * v (a k)) := by
  classical
  let S := (M.offAlgebra k).toSubsemiring
  let _ : Module R S := (M.offAlgebra k).toSubmodule.module
  have _ : IsScalarTower R S B := ⟨fun r s x ↦ Algebra.smul_mul_assoc r (s : B) x⟩
  let b : Module.Basis {a : I →₀ ℤ // a k = 0} R S := M.offBasis k
  let e : (I →₀ ℤ) ≃ {a : I →₀ ℤ // a k = 0} × ℤ :=
    (Finsupp.eraseSingleEquiv k).trans (Equiv.prodComm _ _)
  have he : (fun a : I →₀ ℤ ↦ (M.monomial (a.erase k) : B) * v (a k)) =
      (fun p : {a : I →₀ ℤ // a k = 0} × ℤ ↦ b p.1 • v p.2) ∘ e := by
    funext a
    dsimp only [Function.comp_apply, e, Equiv.trans_apply, Equiv.prodComm_apply,
      Prod.fst_swap, Prod.snd_swap, b]
    rw [setLike_smul_def, smul_eq_mul, Finsupp.eraseSingleEquiv_apply_fst]
    exact congrArg (· * v (a k))
      ((M.coe_offBasis k (Finsupp.eraseSingleEquiv k a).2).trans
        (congrArg (fun x ↦ (M.monomial x : B)) (Finsupp.coe_eraseSingleEquiv_apply_snd k a))).symm
  rw [he, linearIndependent_equiv e]
  exact ⟨linearIndependent_smul b.linearIndependent, fun h ↦ h.of_smul_of_span_eq_top b.span_eq⟩

private theorem conj_mem_offAlgebra_of_monomial (M : BasedChart u Λ B) (k : I) {z : Bˣ}
    (hz : ∀ a : I →₀ ℤ, a k = 0 →
      (z : B) * (M.monomial a : B) * ((z⁻¹ : Bˣ) : B) ∈ M.offAlgebra k)
    {b : B} (hb : b ∈ M.offAlgebra k) :
    (z : B) * b * ((z⁻¹ : Bˣ) : B) ∈ M.offAlgebra k := by
  rw [M.mem_offAlgebra k] at hb
  exact Submodule.span_induction
    (p := fun b _ ↦ (z : B) * b * ((z⁻¹ : Bˣ) : B) ∈ M.offAlgebra k)
    (fun _ hx ↦ by rcases hx with ⟨a, rfl⟩; exact hz a.val a.property)
    (by simp [(M.offAlgebra k).zero_mem])
    (fun _ _ _ _ h₁ h₂ ↦ by rw [mul_add, add_mul]; exact (M.offAlgebra k).add_mem h₁ h₂)
    (fun r _ _ h ↦ by
      rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
      exact Subalgebra.smul_mem (M.offAlgebra k) h r) hb

/-- A unit `z : Bˣ` normalizes `(M.offAlgebra k).toSubsemiring` whenever conjugation by `z` and
`z⁻¹` sends every monomial `M.monomial a` with `a k = 0` back into `M.offAlgebra k`. -/
theorem conjAct_offAlgebra_of_monomial (M : BasedChart u Λ B) (k : I) {z : Bˣ}
    (hz : ∀ a : I →₀ ℤ, a k = 0 →
      (z : B) * (M.monomial a : B) * ((z⁻¹ : Bˣ) : B) ∈ M.offAlgebra k)
    (hz_inv : ∀ a : I →₀ ℤ, a k = 0 →
      ((z⁻¹ : Bˣ) : B) * (M.monomial a : B) * (z : B) ∈ M.offAlgebra k) :
    ConjAct.toConjAct z • (M.offAlgebra k).toSubsemiring = (M.offAlgebra k).toSubsemiring :=
  le_antisymm (fun _ ⟨b, hb, hEq⟩ ↦ hEq ▸ M.conj_mem_offAlgebra_of_monomial k hz hb)
    fun b hb ↦ ⟨((z⁻¹ : Bˣ) : B) * b * (z : B),
      by simpa using M.conj_mem_offAlgebra_of_monomial (z := z⁻¹) k (by simpa using hz_inv) hb,
      by simp [ConjAct.units_smul_def, mul_assoc]⟩

private theorem unitsMap_mul_monomial_mem_offAlgebra (M : BasedChart u Λ B) (k : I) (w : Rˣ)
    {a : I →₀ ℤ} (ha : a k = 0) :
    ((Units.map (algebraMap R B) w * M.monomial a : Bˣ) : B) ∈ M.offAlgebra k := by
  rw [Units.val_mul]
  exact (M.offAlgebra k).mul_mem
    (by simp [(M.offAlgebra k).algebraMap_mem]) (M.monomial_mem_offAlgebra ha)

/-- For any integral bilinear form `Λ`, the `k`-th chart coordinate normalizes `M.offAlgebra k`. -/
theorem conjAct_coordinate_offAlgebra (M : BasedChart u Λ B) (k : I) :
    ConjAct.toConjAct (M.monomial (Finsupp.single k 1)) • (M.offAlgebra k).toSubsemiring =
      (M.offAlgebra k).toSubsemiring := by
  refine M.conjAct_offAlgebra_of_monomial k (fun a ha ↦ ?_) (fun a ha ↦ ?_)
  · rw [← Units.val_mul, ← Units.val_mul, M.monomial_mul_comm (Finsupp.single k 1) a, mul_assoc,
      mul_inv_cancel_right]
    exact M.unitsMap_mul_monomial_mem_offAlgebra k _ ha
  · rw [← Units.val_mul, ← Units.val_mul, mul_assoc, M.monomial_mul_comm a (Finsupp.single k 1),
      Units.mul_map_algebraMap_mul, inv_mul_cancel_left]
    exact M.unitsMap_mul_monomial_mem_offAlgebra k _ ha

/-- When `Λ (single k 1) (single k 1) = 0`, finite left Laurent expansions in
`M.monomial (single k 1)` over `M.offAlgebra k` are unique. -/
theorem skewLaurentSum_coordinate_injective (M : BasedChart u Λ B) {k : I}
    (hkk : Λ (Finsupp.single k 1) (Finsupp.single k 1) = 0) :
    Function.Injective
      ((M.offAlgebra k).toSubsemiring.skewLaurentSum (M.monomial (Finsupp.single k 1))) := by
  rw [Subsemiring.injective_skewLaurentSum_iff_linearIndependent,
    M.linearIndependent_offAlgebra_iff k]
  let w (a : I →₀ ℤ) : R := ((u ^ Λ (a.erase k) (Finsupp.single k (a k)) : Rˣ) : R)
  have hw (a : I →₀ ℤ) : IsRightRegular (w a) :=
    (u ^ Λ (a.erase k) (Finsupp.single k (a k))).isUnit.isRegular.right
  have hfactor : (w • fun a : I →₀ ℤ ↦ (M.monomial a : B)) =
      fun a : I →₀ ℤ ↦
        (M.monomial (a.erase k) : B) * ((M.monomial (Finsupp.single k 1) ^ a k : Bˣ) : B) := by
    funext a
    rw [Pi.smul_apply', ← M.monomial_single_of_self_eq_zero hkk (a k), M.val_monomial_mul,
      Finsupp.erase_add_single k a]
  exact hfactor ▸ M.linearIndependent.smul_of_isRightRegular hw

/-- When `Λ (single k 1) (single k 1) = 0` and
`(y * M.monomial (single k 1) : B) ∈ M.offAlgebra k`, finite left Laurent expansions in `y` over
`M.offAlgebra k` are unique. -/
theorem skewLaurentSum_exchange_injective (M : BasedChart u Λ B) {k : I}
    (hkk : Λ (Finsupp.single k 1) (Finsupp.single k 1) = 0) {y : Bˣ}
    (hyx : ((y * M.monomial (Finsupp.single k 1) : Bˣ) : B) ∈ M.offAlgebra k) :
    Function.Injective ((M.offAlgebra k).toSubsemiring.skewLaurentSum y) := by
  rw [← mul_inv_cancel_right y (M.monomial (Finsupp.single k 1))]
  exact Subsemiring.skewLaurentSum_mul_inv_injective (M.conjAct_coordinate_offAlgebra k) hyx
    (M.skewLaurentSum_coordinate_injective hkk)

section QuasiComm

variable (M : BasedChart u Λ B) {k : I} {y : Bˣ} {μ : (I →₀ ℤ) →+ ℤ}
  (hy_comm : ∀ a : I →₀ ℤ, a k = 0 →
    y * M.monomial a = Units.map (algebraMap R B) (u ^ (2 * μ a)) * (M.monomial a * y))
include hy_comm

/-- Integer powers of `y` inherit `(u, 2 • μ)`-quasi-commutation against monomials off `k`. -/
theorem zpow_mul_monomial_of_quasiComm (n : ℤ) {a : I →₀ ℤ} (ha : a k = 0) :
    y ^ n * M.monomial a =
      Units.map (algebraMap R B) (u ^ (2 * n * μ a)) * (M.monomial a * y ^ n) := by
  rw [Units.zpow_mul_of_map_algebraMap_mul (hy_comm a ha) n, ← zpow_mul]
  congr 3
  ring

/-- A unit `y` quasi-commuting with monomials off `k` normalizes `M.offAlgebra k`. -/
theorem conjAct_unit_offAlgebra :
    ConjAct.toConjAct y • (M.offAlgebra k).toSubsemiring = (M.offAlgebra k).toSubsemiring := by
  refine M.conjAct_offAlgebra_of_monomial k (fun a ha ↦ ?_) (fun a ha ↦ ?_)
  · rw [← Units.val_mul, ← Units.val_mul, hy_comm a ha, mul_assoc, mul_inv_cancel_right]
    exact M.unitsMap_mul_monomial_mem_offAlgebra k _ ha
  · have hm := M.zpow_mul_monomial_of_quasiComm hy_comm (-1) ha
    rw [zpow_neg_one] at hm
    rw [← Units.val_mul, ← Units.val_mul, hm, mul_assoc, inv_mul_cancel_right]
    exact M.unitsMap_mul_monomial_mem_offAlgebra k _ ha

/-- Under quasi-commutation off `k`, the exchange factor `y * M.monomial (single k 1)` normalizes
`M.offAlgebra k`, for any integral bilinear form `Λ`. -/
theorem conjAct_mul_coordinate_offAlgebra :
    ConjAct.toConjAct (y * M.monomial (Finsupp.single k 1)) • (M.offAlgebra k).toSubsemiring =
      (M.offAlgebra k).toSubsemiring := by
  rw [map_mul, mul_smul, M.conjAct_coordinate_offAlgebra k, M.conjAct_unit_offAlgebra hy_comm]

/-- **Chart-level one-step skew Laurent intersection**: when `Λ (single k 1) (single k 1) = 0`,
`(y * M.monomial (single k 1) : B) ∈ M.offAlgebra k`, and `y` `(u, 2 • μ)`-quasi-commutes with
monomials off `k`, the Laurent extensions over `M.offAlgebra k` in `M.monomial (single k 1)` and in
`y` intersect in the positive subsemiring generated by `M.offAlgebra k` and the two coordinates. -/
theorem laurentAdjoin_coordinate_inf_laurentAdjoin
    (hkk : Λ (Finsupp.single k 1) (Finsupp.single k 1) = 0)
    (hyx : ((y * M.monomial (Finsupp.single k 1) : Bˣ) : B) ∈ M.offAlgebra k) :
    (M.offAlgebra k).toSubsemiring.laurentAdjoin (M.monomial (Finsupp.single k 1)) ⊓
        (M.offAlgebra k).toSubsemiring.laurentAdjoin y =
      (M.offAlgebra k).toSubsemiring ⊔
        Subsemiring.closure {(M.monomial (Finsupp.single k 1) : B), (y : B)} := by
  have hy_eq : y = (y * M.monomial (Finsupp.single k 1)) * (M.monomial (Finsupp.single k 1))⁻¹ := by
    rw [mul_inv_cancel_right]
  conv_lhs => rw [hy_eq]
  rw [Subsemiring.laurentAdjoin_inf_laurentAdjoin_mul_inv (M.conjAct_coordinate_offAlgebra k)
    (M.conjAct_mul_coordinate_offAlgebra hy_comm) hyx (M.skewLaurentSum_coordinate_injective hkk),
    ← hy_eq]

end QuasiComm

section UpdateSkew

variable [DecidableEq I] {A : Matrix I I ℤ} (M : BasedChart u A.finsuppBilinForm B)
  (hA : A.finsuppBilinForm.IsAlt) (k : I) (y : Bˣ) (μ : (I →₀ ℤ) →+ ℤ)
  (hyx : ((y * M.monomial (Finsupp.single k 1) : Bˣ) : B) ∈ M.offAlgebra k)
  (hy_comm : ∀ a : I →₀ ℤ, a k = 0 →
    y * M.monomial a = Units.map (algebraMap R B) (u ^ (2 * μ a)) * (M.monomial a * y))

private theorem finsuppBilinForm_updateSkew_single_one_eq (a : I →₀ ℤ) (ha : a k = 0) :
    (A.updateSkew k fun j ↦ μ (Finsupp.single j 1)).finsuppBilinForm (Finsupp.single k 1) a =
      μ a := by
  rw [Matrix.finsuppBilinForm_updateSkew_single_left A k _ 1 ha, one_mul]
  clear ha
  induction a using Finsupp.induction_linear with
  | zero => simp
  | add _ _ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
  | single j n =>
    rw [Finsupp.linearCombination_single, smul_eq_mul,
      (by simp : Finsupp.single j n = n • Finsupp.single j 1), map_zsmul, smul_eq_mul]

/-- **One-step skew exchange of a matrix-based chart** updating row and column `k` of `A` via
`A.updateSkew k (fun j ↦ μ (Finsupp.single j 1))`. -/
noncomputable def exchangeUpdateSkew :
    BasedChart u (A.updateSkew k fun j ↦ μ (Finsupp.single j 1)).finsuppBilinForm B :=
  M.exchange hA (Matrix.isAlt_finsuppBilinForm_updateSkew hA k _) k y
    (fun _ _ ha hb ↦ Matrix.finsuppBilinForm_updateSkew_of_apply_eq_zero A k _ ha hb)
    (fun a ha ↦ by
      rw [finsuppBilinForm_updateSkew_single_one_eq k μ a ha]
      simpa [Algebra.smul_def, -map_zpow] using congrArg (Units.val : Bˣ → B) (hy_comm a ha))
    (by simpa [mem_offAlgebra, Units.val_mul] using hyx)

theorem exchangeUpdateSkew_monomial (a : I →₀ ℤ) :
    (M.exchangeUpdateSkew hA k y μ hyx hy_comm).monomial a =
      Units.map (algebraMap R B) (u ^ (-(a k * μ (a.erase k)))) *
        y ^ a k * M.monomial (a.erase k) := by
  rw [exchangeUpdateSkew, exchange_monomial,
    finsuppBilinForm_updateSkew_single_one_eq k μ (a.erase k) Finsupp.erase_same]

@[simp]
theorem coordinate_exchangeUpdateSkew_same :
    (M.exchangeUpdateSkew hA k y μ hyx hy_comm).coordinate Finsupp.basisSingleOne k = y :=
  M.coordinate_exchange_same hA _ k y _ _ _

theorem coordinate_exchangeUpdateSkew_of_ne {i : I} (hik : i ≠ k) :
    (M.exchangeUpdateSkew hA k y μ hyx hy_comm).coordinate Finsupp.basisSingleOne i =
      M.coordinate Finsupp.basisSingleOne i :=
  M.coordinate_exchange_of_ne hA _ k y _ _ _ hik

/-- `BasedChart.exchangeUpdateSkew` at `k` preserves `M.offAlgebra k`. -/
@[simp]
theorem offAlgebra_exchangeUpdateSkew :
    (M.exchangeUpdateSkew hA k y μ hyx hy_comm).offAlgebra k = M.offAlgebra k :=
  M.offAlgebra_exchange hA _ k y _ _ _

end UpdateSkew

end Semiring

end BasedChart

section DivisionRing

variable {R I D : Type*} [CommSemiring R] {u : Rˣ} {Λ Λ' : LinearMap.BilinForm ℤ (I →₀ ℤ)}
  [DivisionRing D] [Algebra R D]

private theorem range_eval_subset_subfield (M : BasedChart u Λ D) {k : I}
    (hkk : Λ (Finsupp.single k 1) (Finsupp.single k 1) = 0)
    {F : Subfield D} (hoff : (M.offAlgebra k : Set D) ⊆ F)
    (hxk : (M.monomial (Finsupp.single k 1) : D) ∈ F) : Set.range M.eval ⊆ F := by
  rintro _ ⟨t, rfl⟩
  rw [← (QuantumTorus.basis u Λ).linearCombination_repr t]
  generalize (QuantumTorus.basis u Λ).repr t = g
  induction g using Finsupp.induction_linear with
  | zero => simp [F.zero_mem]
  | add _ _ h₁ h₂ => rw [map_add, map_add]; exact F.add_mem h₁ h₂
  | single a r =>
    rw [Finsupp.linearCombination_single, map_smul, QuantumTorus.basis_apply, M.eval_monomial,
      Algebra.smul_def]
    refine F.mul_mem (hoff ((M.offAlgebra k).algebraMap_mem r)) ?_
    have hinv_u : M.monomial a =
        Units.map (algebraMap R D) (u ^ (-Λ (a.erase k) (Finsupp.single k (a k)))) *
          (M.monomial (a.erase k) * M.monomial (Finsupp.single k 1) ^ a k) :=
      (Units.eq_map_algebraMap_zpow_neg_mul_iff u (Λ (a.erase k) (Finsupp.single k (a k)))
        (M.monomial a) _).mpr <| by
        rw [← M.monomial_single_of_self_eq_zero hkk (a k), M.monomial_mul,
          Finsupp.erase_add_single k a]
    have hu := congrArg (Units.val : Dˣ → D) hinv_u
    rw [Units.val_mul, Units.val_mul, Units.coe_map, MonoidHom.coe_ofClass,
      Units.val_zpow_eq_zpow_val] at hu
    exact hu ▸ F.mul_mem (hoff ((M.offAlgebra k).algebraMap_mem _))
      (F.mul_mem (hoff (M.monomial_mem_offAlgebra Finsupp.erase_same))
        (F.zpow_mem hxk (a k)))

private theorem offAlgebra_subset_subfieldClosure (M : BasedChart u Λ D) (k : I) :
    (M.offAlgebra k : Set D) ⊆ Subfield.closure (Set.range M.eval) :=
  (SetLike.coe_subset_coe.mpr (M.offAlgebra_le_range_eval k)).trans Subfield.subset_closure

/-- Over any division ring, `BasedChart.exchange` preserves
`Subfield.closure (Set.range M.eval)`. -/
theorem BasedChart.subfieldClosure_exchange (M : BasedChart u Λ D)
    (hΛ : Λ.IsAlt) (hΛ' : Λ'.IsAlt) (k : I) (y : Dˣ)
    (hoff : ∀ a b, a k = 0 → b k = 0 → Λ' a b = Λ a b)
    (hcomm : ∀ a, a k = 0 → (y : D) * M.monomial a =
      ((u ^ (2 * Λ' (Finsupp.single k 1) a) : Rˣ) : R) • ((M.monomial a : D) * y))
    (hyx : (y : D) * M.monomial (Finsupp.single k 1) ∈
      Submodule.span R (Set.range fun a : {a : I →₀ ℤ // a k = 0} ↦ (M.monomial a : D))) :
    Subfield.closure (Set.range (M.exchange hΛ hΛ' k y hoff hcomm hyx).eval) =
      Subfield.closure (Set.range M.eval) := by
  let M' := M.exchange hΛ hΛ' k y hoff hcomm hyx
  let F := Subfield.closure (Set.range M.eval)
  let F' := Subfield.closure (Set.range M'.eval)
  have hyx_off : (y : D) * M.monomial (Finsupp.single k 1) ∈ M.offAlgebra k :=
    (M.mem_offAlgebra k).mpr hyx
  have hoff_F : (M.offAlgebra k : Set D) ⊆ F := offAlgebra_subset_subfieldClosure M k
  have hoff_F' : (M.offAlgebra k : Set D) ⊆ F' :=
    M.offAlgebra_exchange hΛ hΛ' k y hoff hcomm hyx ▸ offAlgebra_subset_subfieldClosure M' k
  have hxk_F : (M.monomial (Finsupp.single k 1) : D) ∈ F :=
    Subfield.subset_closure ⟨QuantumTorus.monomial u Λ (Finsupp.single k 1),
      M.eval_monomial (Finsupp.single k 1)⟩
  have hy_F' : (y : D) ∈ F' := by
    have hck : M'.monomial (Finsupp.single k 1) = y :=
      M.exchange_monomial_single_self hΛ hΛ' k y hoff hcomm hyx
    exact hck ▸ Subfield.subset_closure ⟨QuantumTorus.monomial u Λ' (Finsupp.single k 1),
      M'.eval_monomial (Finsupp.single k 1)⟩
  have hy_F : (y : D) ∈ F :=
    (by rw [← Units.val_inv_eq_inv_val, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one,
          mul_one] :
      (y : D) = ((y : D) * M.monomial (Finsupp.single k 1)) *
        (M.monomial (Finsupp.single k 1) : D)⁻¹) ▸
      F.mul_mem (hoff_F hyx_off) (F.inv_mem hxk_F)
  have hxk_F' : (M.monomial (Finsupp.single k 1) : D) ∈ F' :=
    (by rw [← Units.val_inv_eq_inv_val, ← mul_assoc, ← Units.val_mul, inv_mul_cancel,
          Units.val_one, one_mul] :
      (M.monomial (Finsupp.single k 1) : D) = (y : D)⁻¹ *
        ((y : D) * M.monomial (Finsupp.single k 1))) ▸
      F'.mul_mem (F'.inv_mem hy_F') (hoff_F' hyx_off)
  refine le_antisymm (Subfield.closure_le.mpr ?_) (Subfield.closure_le.mpr ?_)
  · exact range_eval_subset_subfield M' (k := k) (hΛ'.self_eq_zero _)
      (by dsimp only [M']; rwa [M.offAlgebra_exchange])
      (by dsimp only [M']; rwa [M.exchange_monomial_single_self])
  · exact range_eval_subset_subfield M (hΛ.self_eq_zero _) hoff_F' hxk_F'

/-- Over any division ring, `BasedChart.exchangeUpdateSkew` preserves
`Subfield.closure (Set.range M.eval)`. -/
theorem BasedChart.subfieldClosure_exchangeUpdateSkew [DecidableEq I] {A : Matrix I I ℤ}
    (M : BasedChart u A.finsuppBilinForm D) (hA : A.finsuppBilinForm.IsAlt) (k : I) (y : Dˣ)
    (μ : (I →₀ ℤ) →+ ℤ)
    (hyx : ((y * M.monomial (Finsupp.single k 1) : Dˣ) : D) ∈ M.offAlgebra k)
    (hy_comm : ∀ a : I →₀ ℤ, a k = 0 →
      y * M.monomial a = Units.map (algebraMap R D) (u ^ (2 * μ a)) * (M.monomial a * y)) :
    Subfield.closure (Set.range (M.exchangeUpdateSkew hA k y μ hyx hy_comm).eval) =
      Subfield.closure (Set.range M.eval) :=
  M.subfieldClosure_exchange hA _ k y _ _ _

/-- Over any division ring, quantum-torus maps related by one-step exchange generate the same
subfield. -/
theorem QuantumTorus.subfieldClosure_eq_of_exchange
    (hΛ : Λ.IsAlt) (hΛ' : Λ'.IsAlt) {k : I}
    {χ : QuantumTorus R (I →₀ ℤ) u Λ →ₐ[R] D} (hχ : Function.Injective χ)
    {χ' : QuantumTorus R (I →₀ ℤ) u Λ' →ₐ[R] D}
    (h_off : ∀ i ≠ k, χ' (QuantumTorus.monomial u Λ' (Finsupp.single i 1)) =
      χ (QuantumTorus.monomial u Λ (Finsupp.single i 1)))
    (hoff : ∀ a b, a k = 0 → b k = 0 → Λ' a b = Λ a b)
    (h_exch : χ' (QuantumTorus.monomial u Λ' (Finsupp.single k 1)) *
      χ (QuantumTorus.monomial u Λ (Finsupp.single k 1)) ∈
      (BasedChart.ofInjective χ hχ).offAlgebra k) :
    Subfield.closure (Set.range χ') = Subfield.closure (Set.range χ) := by
  obtain ⟨y, hcomm, hyx, hχ'_eq⟩ :=
    QuantumTorus.exists_basedChart_of_exchange hΛ hΛ' hχ h_off hoff h_exch
  rw [← hχ'_eq]
  conv_rhs => rw [← BasedChart.eval_ofInjective χ hχ]
  exact (BasedChart.ofInjective χ hχ).subfieldClosure_exchange hΛ hΛ' k y hoff hcomm hyx

end DivisionRing

