module

public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Basic
public import TauCeti.RingTheory.Ideal.ScalarTorsion

/-!
# Scalar torsion in commutative Hopf algebras

Over a domain, scalar torsion is stable under the counit and antipode. If the tensor square of
the torsion-free quotient is torsion-free, comultiplication also descends to that quotient,
so the scalar-torsion ideal is a Hopf ideal. Over a Dedekind domain the tensor condition is
automatic: torsion-free modules are flat, and the tensor product of flat modules is flat.

This constructs the flat closure of the generic fiber of an affine group scheme over a
Dedekind domain. It also detects torsion in a subgroup generated by flat group schemes.

## References

* The Stacks Project, [Tag 0AUW](https://stacks.math.columbia.edu/tag/0AUW), for flatness
  of torsion-free modules over Dedekind domains.

The Hopf-ideal construction follows `TauCeti.HopfIdeal.reduction`, replacing nilpotence by
annihilation by a regular scalar. The module input is Mathlib's torsion-free quotient and
Dedekind-domain flatness criterion.
-/

public section

open scoped TensorProduct nonZeroDivisors

namespace TauCeti.HopfIdeal

universe u v

variable (R : Type u) [CommRing R] [IsDomain R]
variable (H : Type v) [CommRing H] [HopfAlgebra R H]

/-- The scalar-torsion ideal as a Hopf ideal, when the tensor square of its quotient is
scalar-torsion-free. Over a Dedekind domain this condition holds automatically. -/
noncomputable def scalarTorsion
    [Module.IsTorsionFree R
      ((H ⧸ scalarTorsionIdeal R H) ⊗[R] (H ⧸ scalarTorsionIdeal R H))] : HopfIdeal R H :=
  ofIdeal (scalarTorsionIdeal R H)
    (fun {x} hx ↦ by
      let q := Ideal.Quotient.mkₐ R (scalarTorsionIdeal R H)
      have hker := ker_tensorProduct_map_eq_leftTensorIdeal_sup_rightTensorIdeal q q
        (Ideal.Quotient.mkₐ_surjective R _) (Ideal.Quotient.mkₐ_surjective R _)
      simp only [AlgHom.ker_coe, q, Ideal.Quotient.mkₐ_ker] at hker
      rw [← hker, RingHom.mem_ker]
      obtain ⟨r, hr⟩ := (mem_scalarTorsionIdeal R H).mp hx
      apply (smul_eq_zero_iff_right (nonZeroDivisors.coe_ne_zero r)).mp
      simpa only [Submonoid.smul_def, map_smul, map_zero, q, AlgHom.coe_toRingHom] using
        congrArg (fun y ↦ Algebra.TensorProduct.map q q (Coalgebra.comul (R := R) y)) hr)
    (fun {x} hx ↦ by
      obtain ⟨r, hr⟩ := (mem_scalarTorsionIdeal R H).mp hx
      apply (smul_eq_zero_iff_right (nonZeroDivisors.coe_ne_zero r)).mp
      simpa only [Submonoid.smul_def, map_smul, map_zero] using
        congrArg (Coalgebra.counit (R := R) (A := H)) hr)
    (fun {x} hx ↦ by
      obtain ⟨r, hr⟩ := (mem_scalarTorsionIdeal R H).mp hx
      exact (mem_scalarTorsionIdeal R H).mpr ⟨r, by
        simpa only [Submonoid.smul_def, map_smul, map_zero] using
          congrArg (HopfAlgebra.antipode R) hr⟩)

variable [Module.IsTorsionFree R
  ((H ⧸ scalarTorsionIdeal R H) ⊗[R] (H ⧸ scalarTorsionIdeal R H))]

/-- The scalar-torsion Hopf ideal has the scalar-torsion ideal as its underlying ideal. -/
@[simp]
theorem scalarTorsion_toIdeal :
    (scalarTorsion R H).toIdeal = scalarTorsionIdeal R H :=
  (toIdeal_carrier _).trans (ofIdeal_carrier _ _ _ _)

/-- Membership in the scalar-torsion Hopf ideal is annihilation by a regular scalar. -/
@[simp]
theorem mem_scalarTorsion {x : H} :
    x ∈ scalarTorsion R H ↔ ∃ r : R⁰, r • x = 0 := by
  rw [← mem_toIdeal, scalarTorsion_toIdeal, mem_scalarTorsionIdeal]

/-- The quotient by the scalar-torsion Hopf ideal is scalar-torsion-free. -/
instance isTorsionFree_quotient_scalarTorsion :
    Module.IsTorsionFree R (H ⧸ (scalarTorsion R H).toIdeal) := by
  rw [scalarTorsion_toIdeal]
  infer_instance

end TauCeti.HopfIdeal
