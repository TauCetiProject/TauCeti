public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Comap

/-!
# Images of Hopf ideals

This file records the pushforward of a Hopf ideal along a bialgebra morphism
`f : H →ₐc[R] K`: the extension `Ideal.map f I` of a Hopf ideal `I` — the ideal of `K`
generated by the image of `I` — is again a Hopf ideal whenever that extension is two-sided.
The coideal and counit conditions transport along `f` because `f` intertwines the
comultiplications and counits. Two-sidedness extends antipode stability from the generators
to the whole ideal, since the antipode reverses multiplication.

Commutativity of the codomain supplies the two-sidedness instance automatically. Surjectivity
also suffices, using a `RingHomSurjective (f : H →+* K)` instance: the generated ideal is
then the set-theoretic image of the two-sided ideal `I`. For a general morphism of
noncommutative Hopf algebras the left ideal generated by the image need not be two-sided,
and the standard construction uses the two-sided ideal `K f(I) K` instead. The commutative
case is the one the affine group-scheme dictionary consumes.

Together with `TauCeti.HopfIdeal.comapOfSurjective`, this gives both variance directions for Hopf
ideals. The two are adjoint along surjective morphisms
(`TauCeti.HopfIdeal.map_le_iff_le_comapOfSurjective`).

The kernel of the affine group-scheme morphism induced by `f` is cut out by the image
of the augmentation ideal under `f`.

## Main declarations

* `TauCeti.HopfIdeal.map`: the image of a Hopf ideal under a bialgebra morphism, provided
  the ideal-theoretic image is two-sided.
* `TauCeti.HopfIdeal.map_toIdeal` and `TauCeti.HopfIdeal.mem_map_of_mem`: characteristic
  API, with the universal property `TauCeti.HopfIdeal.map_le_iff`.
* `TauCeti.HopfIdeal.map_bot`, `TauCeti.HopfIdeal.map_sup`, `TauCeti.HopfIdeal.map_iSup`,
  and `TauCeti.HopfIdeal.map_sSup`: the image preserves the join structure.
* `TauCeti.HopfIdeal.map_id` and `TauCeti.HopfIdeal.map_map`: identity and composition
  laws.
* `TauCeti.HopfIdeal.map_le_iff_le_comapOfSurjective`: the image is left adjoint to the inverse
  image along a surjective morphism, with the correspondence lemmas
  `TauCeti.HopfIdeal.map_comapOfSurjective`, `TauCeti.HopfIdeal.comapOfSurjective_map`,
  `TauCeti.HopfIdeal.comapOfSurjective_map_of_bijective`, and
  `TauCeti.HopfIdeal.map_eq_bot_iff_le_ker`.
* `TauCeti.HopfIdeal.comapOfSurjective_map_mkBialgHom`: pulling the image of `J` back from
  `H ⧸ I` along the quotient morphism recovers `J`, provided `I ≤ J`.

## References

The construction is the standard image of a Hopf ideal; see for instance
[Milne, *Algebraic Groups*][milne2017] around Definition 3.10, where quotients by such
images cut out closed subgroup schemes.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe u v w x

namespace HopfIdeal

section Semiring

variable {R : Type u} [CommSemiring R]

section TwoSided

variable {H : Type v} {K : Type w} [Semiring H] [Semiring K]
variable [HopfAlgebra R H] [HopfAlgebra R K]

private theorem span_image_toIdeal {A : Type*} [Semiring A] (I : HopfIdeal R H)
    (f : H →+* A) :
    Ideal.span (f '' I.toIdeal) = Ideal.map f I.toIdeal := by
  rw [← Ideal.map_span, Ideal.span_eq]

private theorem span_bialgHom_image_toIdeal (I : HopfIdeal R H) (f : H →ₐc[R] K) :
    Ideal.span (f '' I.toIdeal) = Ideal.map (f : H →+* K) I.toIdeal := by
  simpa only [RingHom.coe_coe] using span_image_toIdeal I (f : H →+* K)

/-- The image of a Hopf ideal under a bialgebra morphism, when the ideal generated by the
set-theoretic image is two-sided.

Its underlying ideal is the ideal-theoretic extension `Ideal.map`. The two-sidedness
instance is automatic for commutative codomains and for surjective ring homomorphisms. -/
def map (I : HopfIdeal R H) (f : H →ₐc[R] K)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided] : HopfIdeal R K := by
  haveI : (Ideal.span (f '' I.toIdeal)).IsTwoSided := by
    rw [span_bialgHom_image_toIdeal]
    infer_instance
  exact ofSpan (f '' I.toIdeal)
    (by
      rintro _ ⟨x, hx, rfl⟩
      have hmap : Algebra.TensorProduct.map f.toAlgHom f.toAlgHom
          (Coalgebra.comul (R := R) x) = Coalgebra.comul (R := R) (f x) :=
        CoalgHomClass.map_comp_comul_apply f x
      rw [← hmap]
      have h := Ideal.mem_map_of_mem
        (Algebra.TensorProduct.map f.toAlgHom f.toAlgHom : (H ⊗[R] H) →+* (K ⊗[R] K))
        (I.comul_mem (mem_toIdeal.mp hx))
      rw [Ideal.map_sup, AlgHom.map_tensor_leftTensorIdeal, AlgHom.map_tensor_rightTensorIdeal] at h
      simpa only [← span_image_toIdeal, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        BialgHom.coe_toAlgHom] using h)
    (by
      rintro _ ⟨x, hx, rfl⟩
      rw [CoalgHomClass.counit_comp_apply]
      exact I.counit_eq_zero (mem_toIdeal.mp hx))
    (by
      rintro _ ⟨x, hx, rfl⟩
      rw [← BialgHomClass.map_antipode]
      exact Ideal.subset_span ⟨_, mem_toIdeal.mpr (I.antipode_mem (mem_toIdeal.mp hx)), rfl⟩)

/-- The underlying ideal of `I.map f` is the ordinary ideal-theoretic image. -/
@[simp]
theorem map_toIdeal (I : HopfIdeal R H) (f : H →ₐc[R] K)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided] :
    (I.map f).toIdeal = Ideal.map (f : H →+* K) I.toIdeal := by
  rw [map, ofSpan_toIdeal]
  exact span_bialgHom_image_toIdeal I f

/-- The image of a Hopf ideal contains the image of each of its elements. -/
theorem mem_map_of_mem (f : H →ₐc[R] K) {I : HopfIdeal R H}
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided] {x : H} (hx : x ∈ I) :
    f x ∈ I.map f := by
  rw [← mem_toIdeal, map_toIdeal]
  exact Ideal.mem_map_of_mem _ (mem_toIdeal.mpr hx)

/-- Image of Hopf ideals is monotone. -/
theorem map_mono (f : H →ₐc[R] K) {I J : HopfIdeal R H}
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided]
    [(Ideal.map (f : H →+* K) J.toIdeal).IsTwoSided] (hIJ : I ≤ J) :
    I.map f ≤ J.map f := by
  rw [← toIdeal_le_toIdeal, map_toIdeal, map_toIdeal]
  exact Ideal.map_mono (toIdeal_le_toIdeal.mpr hIJ)

/-- The universal property of the image: `I.map f` is below `J` exactly when `f` sends
`I` into `J`. Membership in `I.map f` itself is characterized only along surjective
morphisms (`TauCeti.HopfIdeal.mem_map_iff_of_surjective`), since the image Hopf ideal is
generated by, and in general larger than, the set-theoretic image of `I`. -/
theorem map_le_iff {f : H →ₐc[R] K} {I : HopfIdeal R H} {J : HopfIdeal R K}
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided] :
    I.map f ≤ J ↔ ∀ ⦃x : H⦄, x ∈ I → f x ∈ J := by
  rw [← toIdeal_le_toIdeal, map_toIdeal, Ideal.map_le_iff_le_comap]
  simp only [IsConcreteLE.le_iff, Ideal.mem_comap, mem_toIdeal, RingHom.coe_coe]

/-- For a surjective morphism, membership in the image Hopf ideal means being the value
of a member. -/
@[simp]
theorem mem_map_iff_of_surjective {f : H →ₐc[R] K} (hf : Function.Surjective f)
    {I : HopfIdeal R H} {y : K} :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf⟩
    y ∈ I.map f ↔ ∃ x ∈ I, f x = y := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf⟩
  rw [← mem_toIdeal, map_toIdeal]
  simp only [Ideal.mem_map_iff_of_surjective (f : H →+* K) hf, mem_toIdeal]
  rfl

/-- The image vanishes exactly when the Hopf ideal is contained in the kernel of the
underlying ring homomorphism. For surjective morphisms the right side is the kernel Hopf
ideal (`TauCeti.HopfIdeal.map_eq_bot_iff_le_ker`). -/
theorem map_eq_bot_iff (I : HopfIdeal R H) (f : H →ₐc[R] K)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided] :
    I.map f = ⊥ ↔ I.toIdeal ≤ RingHom.ker (f : H →+* K) := by
  rw [← le_bot_iff, ← toIdeal_le_toIdeal, map_toIdeal, bot_toIdeal, le_bot_iff,
    Ideal.map_eq_bot_iff_le_ker]

/-- The ideal-theoretic image of the zero Hopf ideal is two-sided. -/
instance instIsTwoSidedMapBot (f : H →ₐc[R] K) :
    (Ideal.map (f : H →+* K) (⊥ : HopfIdeal R H).toIdeal).IsTwoSided := by
  rw [bot_toIdeal, Ideal.map_bot]
  infer_instance

/-- The image of the zero Hopf ideal is zero. -/
@[simp]
theorem map_bot (f : H →ₐc[R] K) : (⊥ : HopfIdeal R H).map f = ⊥ :=
  ext fun _ => by
    rw [← mem_toIdeal, map_toIdeal, bot_toIdeal, Ideal.map_bot]
    exact Ideal.mem_bot.trans mem_bot.symm

/-- A binary join has two-sided image when both members do. -/
instance instIsTwoSidedMapSup (I J : HopfIdeal R H) (f : H →ₐc[R] K)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided]
    [(Ideal.map (f : H →+* K) J.toIdeal).IsTwoSided] :
    (Ideal.map (f : H →+* K) (I ⊔ J).toIdeal).IsTwoSided := by
  rw [sup_toIdeal, Ideal.map_sup, ← map_toIdeal I f, ← map_toIdeal J f, ← sup_toIdeal]
  infer_instance

/-- Image of Hopf ideals preserves binary joins when both images are two-sided. -/
@[simp]
theorem map_sup (I J : HopfIdeal R H) (f : H →ₐc[R] K)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided]
    [(Ideal.map (f : H →+* K) J.toIdeal).IsTwoSided] :
    (I ⊔ J).map f = I.map f ⊔ J.map f :=
  ext fun _ => by
    rw [← mem_toIdeal, map_toIdeal, sup_toIdeal, Ideal.map_sup, ← mem_toIdeal, sup_toIdeal,
      map_toIdeal, map_toIdeal]

/-- An indexed supremum has two-sided image when each member does. -/
instance instIsTwoSidedMapISup {ι : Sort*} (I : ι → HopfIdeal R H) (f : H →ₐc[R] K)
    [∀ i, (Ideal.map (f : H →+* K) (I i).toIdeal).IsTwoSided] :
    (Ideal.map (f : H →+* K) (⨆ i, I i).toIdeal).IsTwoSided := by
  have h : (⨆ i, (I i).map f).toIdeal.IsTwoSided := inferInstance
  simpa only [iSup_toIdeal, map_toIdeal, Ideal.map_iSup] using h

/-- Image of Hopf ideals preserves indexed suprema when each image is two-sided. -/
@[simp]
theorem map_iSup {ι : Sort*} (I : ι → HopfIdeal R H) (f : H →ₐc[R] K)
    [∀ i, (Ideal.map (f : H →+* K) (I i).toIdeal).IsTwoSided] :
    (⨆ i, I i).map f = ⨆ i, (I i).map f :=
  ext fun _ => by
    rw [← mem_toIdeal, map_toIdeal, iSup_toIdeal, Ideal.map_iSup, ← mem_toIdeal, iSup_toIdeal]
    simp only [map_toIdeal]

/-- A set of Hopf ideals has two-sided supremum image when each member has two-sided image. -/
instance instIsTwoSidedMapSSup (S : Set (HopfIdeal R H)) (f : H →ₐc[R] K)
    [∀ I : S, (Ideal.map (f : H →+* K) I.val.toIdeal).IsTwoSided] :
    (Ideal.map (f : H →+* K) (sSup S).toIdeal).IsTwoSided := by
  rw [sSup_eq_iSup']
  infer_instance

/-- Image of Hopf ideals preserves suprema of sets when each member has two-sided image. -/
@[simp]
theorem map_sSup (S : Set (HopfIdeal R H)) (f : H →ₐc[R] K)
    [∀ I : S, (Ideal.map (f : H →+* K) I.val.toIdeal).IsTwoSided] :
    (sSup S).map f = sSup (Set.range fun I : S => I.val.map f) := by
  rw [sSup_range]
  ext x
  rw [← mem_toIdeal, map_toIdeal, ← mem_toIdeal, iSup_toIdeal]
  simp only [sSup_eq_iSup', iSup_toIdeal, Ideal.map_iSup, map_toIdeal]

end TwoSided

end Semiring

section Id

variable {R : Type u} [CommSemiring R]
variable {H : Type v} [Semiring H] [HopfAlgebra R H]

/-- The ideal-theoretic image under the identity is two-sided. -/
instance instIsTwoSidedMapId (I : HopfIdeal R H) :
    (Ideal.map (BialgHom.id R H : H →+* H) I.toIdeal).IsTwoSided := by
  rw [BialgHom.id_toRingHom, Ideal.map_id]
  infer_instance

/-- The image of a Hopf ideal under the identity morphism. -/
@[simp]
theorem map_id (I : HopfIdeal R H) : I.map (BialgHom.id R H) = I := by
  ext x
  simp only [← mem_toIdeal, map_toIdeal, BialgHom.id_toRingHom, Ideal.map_id]

end Id

section Comp

variable {R : Type u} [CommSemiring R]
variable {H : Type v} {K : Type w} {L : Type x}
variable [Semiring H] [Semiring K] [Semiring L]
variable [HopfAlgebra R H] [HopfAlgebra R K] [HopfAlgebra R L]

/-- A composite has two-sided image whenever the successive images are two-sided. -/
instance instIsTwoSidedMapComp (I : HopfIdeal R H) (f : H →ₐc[R] K) (g : K →ₐc[R] L)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided]
    [(Ideal.map (g : K →+* L) (I.map f).toIdeal).IsTwoSided] :
    (Ideal.map (g.comp f : H →+* L) I.toIdeal).IsTwoSided := by
  rw [BialgHom.comp_toRingHom, ← Ideal.map_map, ← map_toIdeal I f]
  infer_instance

/-- Image of Hopf ideals is functorial when the successive images are two-sided. -/
@[simp]
theorem map_map (I : HopfIdeal R H) (f : H →ₐc[R] K) (g : K →ₐc[R] L)
    [(Ideal.map (f : H →+* K) I.toIdeal).IsTwoSided]
    [(Ideal.map (g : K →+* L) (I.map f).toIdeal).IsTwoSided] :
    (I.map f).map g = I.map (g.comp f) := by
  ext x
  simp only [← mem_toIdeal, map_toIdeal, Ideal.map_map, BialgHom.comp_toRingHom]

end Comp

section Adjunction

variable {R : Type u} [CommRing R]
variable {H : Type v} {K : Type w} [Ring H] [Ring K]
variable [HopfAlgebra R H] [HopfAlgebra R K]

/-- Along a surjective morphism, the image of Hopf ideals is left adjoint to the inverse
image. -/
theorem map_le_iff_le_comapOfSurjective {f : H →ₐc[R] K} (hf : Function.Surjective f)
    {I : HopfIdeal R H} {J : HopfIdeal R K} :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf⟩
    I.map f ≤ J ↔ I ≤ J.comapOfSurjective f hf := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf⟩
  rw [map_le_iff, le_def]
  exact ⟨fun h x hx => mem_comapOfSurjective.mpr (h hx),
    fun h x hx => mem_comapOfSurjective.mp (h hx)⟩

/-- Along a surjective morphism, image after inverse image recovers the Hopf ideal. -/
@[simp]
theorem map_comapOfSurjective (J : HopfIdeal R K) (f : H →ₐc[R] K)
    (hf : Function.Surjective f) :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf⟩
    (J.comapOfSurjective f hf).map f = J := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf⟩
  ext x
  rw [← mem_toIdeal, map_toIdeal, comapOfSurjective_toIdeal,
    Ideal.map_comap_of_surjective (f : H →+* K) hf, mem_toIdeal]

/-- Along a surjective morphism, inverse image after image is the join with the kernel. -/
theorem comapOfSurjective_map (I : HopfIdeal R H) (f : H →ₐc[R] K)
    (hf : Function.Surjective f) :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf⟩
    (I.map f).comapOfSurjective f hf = I ⊔ kerOfSurjective f hf := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf⟩
  ext x
  rw [← mem_toIdeal, comapOfSurjective_toIdeal, map_toIdeal,
    Ideal.comap_map_of_surjective (f : H →+* K) hf, ← mem_toIdeal, sup_toIdeal,
    kerOfSurjective_toIdeal, RingHom.ker_eq_comap_bot]
  exact Iff.rfl

/-- Along a bijective morphism, inverse image after image recovers the Hopf ideal. -/
theorem comapOfSurjective_map_of_bijective (I : HopfIdeal R H) (f : H →ₐc[R] K)
    (hf : Function.Bijective f) :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf.surjective⟩
    (I.map f).comapOfSurjective f hf.2 = I := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf.surjective⟩
  rw [comapOfSurjective_map, (kerOfSurjective_eq_bot_iff f hf.2).2 hf.1, sup_bot_eq]

/-- The image vanishes exactly on Hopf ideals contained in the kernel Hopf ideal: the
surjective bundled form of `TauCeti.HopfIdeal.map_eq_bot_iff`. -/
theorem map_eq_bot_iff_le_ker (I : HopfIdeal R H) (f : H →ₐc[R] K)
    (hf : Function.Surjective f) :
    haveI : RingHomSurjective (f : H →+* K) := ⟨hf⟩
    I.map f = ⊥ ↔ I ≤ kerOfSurjective f hf := by
  have : RingHomSurjective (f : H →+* K) := ⟨hf⟩
  rw [map_eq_bot_iff]
  constructor
  · intro h x hx
    exact (mem_kerOfSurjective f hf).mpr (RingHom.mem_ker.mp (h (mem_toIdeal.mpr hx)))
  · intro h x hx
    exact RingHom.mem_ker.mpr ((mem_kerOfSurjective f hf).mp (h (mem_toIdeal.mp hx)))

end Adjunction

section Quotient

variable {R : Type u} [CommRing R]
variable {H : Type v} [Ring H] [HopfAlgebra R H]

/-- Pulling the image of `J` in `H ⧸ I` back along the quotient morphism recovers `J`
when `I ≤ J`. -/
@[simp]
theorem comapOfSurjective_map_mkBialgHom {I J : HopfIdeal R H} (hIJ : I ≤ J) :
    (J.map (Bialgebra.Quotient.mkBialgHom I.toIdeal)).comapOfSurjective
        (Bialgebra.Quotient.mkBialgHom I.toIdeal)
        (Bialgebra.Quotient.mkBialgHom_surjective I.toIdeal) = J := by
  rw [comapOfSurjective_map, kerOfSurjective_mkBialgHom, sup_eq_left]
  exact hIJ

end Quotient

end HopfIdeal

end TauCeti
