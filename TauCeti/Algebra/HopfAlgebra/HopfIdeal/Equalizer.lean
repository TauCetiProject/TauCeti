module

public import TauCeti.Algebra.HopfAlgebra.Basic
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Basic

/-!
# The equalizer Hopf ideal of two bialgebra morphisms

Let `f g : H →ₐc[R] K` be two bialgebra morphisms into a ring `K`. The left ideal of `K`
generated by the differences `f a - g a` needs no antipode to be formed. When `K` is commutative
and `H` and `K` are Hopf algebras, it is a Hopf ideal. The quotient `K ⧸ I` then corepresents the
subfunctor of points of `K` on which the two morphisms induce the same map.

When `H` is also commutative, `f` and `g` are contravariantly two homomorphisms of affine group
schemes `Spec K ⟶ Spec H`, and this Hopf ideal cuts out their equalizer as a closed subgroup
scheme of `Spec K`. The three closure conditions are the structural compatibilities of a bialgebra
morphism: the counit condition because `ε(f a - g a) = ε(a) - ε(a)`, the antipode condition
because a bialgebra morphism between Hopf algebras commutes with the antipodes, and the
comultiplication condition because

```text
f a₁ ⊗ f a₂ - g a₁ ⊗ g a₂ = (f a₁ - g a₁) ⊗ f a₂ + g a₁ ⊗ (f a₂ - g a₂)
```

splits a difference of pure tensors across the two summands of `I ⊗ K + K ⊗ I`.

## Main declarations

* `TauCeti.HopfIdeal.equalizerIdeal`: the underlying ideal, generated by the differences.
* `TauCeti.HopfIdeal.equalizer`: the equalizer Hopf ideal.
* `TauCeti.HopfIdeal.equalizerIdeal_le_ker_iff`: a ring homomorphism kills the ideal exactly when
  it identifies the two morphisms; on points, this is the equalizer condition.
* `TauCeti.HopfIdeal.equalizer_eq_bot_iff`: the equalizer Hopf ideal vanishes exactly when the two
  morphisms are equal, which is the separation statement used downstream.

## References

The construction is the coordinate-algebra form of the scheme-theoretic equalizer of two group
homomorphisms; see [Milne, *Algebraic Groups*][milne2017], §1.h, and Waterhouse,
*Introduction to Affine Group Schemes*, §15. The resulting equalizer ideal gives a separation
criterion for homomorphisms out of a group scheme generated by closed subgroups.
-/

public section

open scoped TensorProduct

namespace TauCeti

universe u v w

namespace HopfIdeal

section Bialgebra

variable {R : Type u} [CommSemiring R]
variable {H : Type v} {K : Type w} [Semiring H] [Ring K]
variable [Bialgebra R H] [Bialgebra R K]

/-- The left ideal of `K` generated by all differences `f a - g a` of two bialgebra morphisms
into a ring. -/
def equalizerIdeal (f g : H →ₐc[R] K) : Ideal K :=
  Ideal.span (Set.range fun a : H => f a - g a)

/-- Every difference of values of the two morphisms lies in the equalizer ideal. -/
theorem sub_mem_equalizerIdeal (f g : H →ₐc[R] K) (a : H) :
    f a - g a ∈ equalizerIdeal f g :=
  Ideal.subset_span ⟨a, rfl⟩

/-- The equalizer ideal is the smallest ideal containing all differences: its universal
property. -/
theorem equalizerIdeal_le_iff {f g : H →ₐc[R] K} {J : Ideal K} :
    equalizerIdeal f g ≤ J ↔ ∀ a, f a - g a ∈ J := by
  rw [equalizerIdeal, Ideal.span_le, Set.range_subset_iff]
  rfl

/-- A ring homomorphism out of `K` kills the equalizer ideal exactly when it identifies the two
morphisms. Applied to a point `K →ₐ[R] A`, this is the defining condition of the equalizer
subfunctor. -/
theorem equalizerIdeal_le_ker_iff {A : Type*} [Ring A] {f g : H →ₐc[R] K} (φ : K →+* A) :
    equalizerIdeal f g ≤ RingHom.ker φ ↔ ∀ a, φ (f a) = φ (g a) := by
  rw [equalizerIdeal_le_iff]
  exact forall_congr' fun a => by rw [RingHom.mem_ker, map_sub, sub_eq_zero]

/-- The equalizer ideal is symmetric in the two morphisms. -/
theorem equalizerIdeal_comm (f g : H →ₐc[R] K) :
    equalizerIdeal f g = equalizerIdeal g f := by
  refine le_antisymm (equalizerIdeal_le_iff.2 fun a => ?_)
    (equalizerIdeal_le_iff.2 fun a => ?_)
  · rw [← neg_sub]
    exact neg_mem (sub_mem_equalizerIdeal g f a)
  · rw [← neg_sub]
    exact neg_mem (sub_mem_equalizerIdeal f g a)

/-- The equalizer ideal of a morphism with itself is zero. -/
@[simp]
theorem equalizerIdeal_self (f : H →ₐc[R] K) : equalizerIdeal f f = ⊥ :=
  le_antisymm (equalizerIdeal_le_iff.2 fun a => by simp) bot_le

variable (f g : H →ₐc[R] K)

/-- The difference of the two induced maps on the tensor square lands in `I ⊗ K + K ⊗ I`. This
is the tensor-level form of the comultiplication condition. -/
private theorem map_sub_map_mem_sup (t : H ⊗[R] H) :
    TensorProduct.map (f : H →ₗ[R] K) (f : H →ₗ[R] K) t -
        TensorProduct.map (g : H →ₗ[R] K) (g : H →ₗ[R] K) t ∈
      leftTensorIdeal (R := R) (H := K) (equalizerIdeal f g) ⊔
        rightTensorIdeal (R := R) (H := K) (equalizerIdeal f g) := by
  induction t with
  | tmul a c =>
      have key : (f a) ⊗ₜ[R] (f c) - (g a) ⊗ₜ[R] (g c) =
          (f a - g a) ⊗ₜ[R] (f c) + (g a) ⊗ₜ[R] (f c - g c) := by
        rw [TensorProduct.sub_tmul, TensorProduct.tmul_sub]
        abel
      simp only [TensorProduct.map_tmul, BialgHom.coe_toLinearMap]
      rw [key]
      exact Submodule.add_mem _
        (Submodule.mem_sup_left
          (tmul_mem_leftTensorIdeal (R := R) (H := K) (sub_mem_equalizerIdeal f g a) _))
        (Submodule.mem_sup_right
          (tmul_mem_rightTensorIdeal (R := R) (H := K) _ (sub_mem_equalizerIdeal f g c)))
  | add s t hs ht =>
      rw [map_add, map_add, add_sub_add_comm]
      exact Submodule.add_mem _ hs ht

end Bialgebra

-- The counit condition evaluates a difference in the base ring.
variable {R : Type u} [CommRing R]
variable {H : Type v} {K : Type w} [Semiring H] [CommRing K]
variable [HopfAlgebra R H] [HopfAlgebra R K]

/-- The **equalizer Hopf ideal** of two bialgebra morphisms into a commutative Hopf algebra.

When `H` is commutative, the quotient by this Hopf ideal is the coordinate algebra of the closed
subgroup scheme of `Spec K` on which the two induced homomorphisms of affine group schemes agree. -/
def equalizer (f g : H →ₐc[R] K) : HopfIdeal R K :=
  ofSpan (Set.range fun a : H => f a - g a)
    (by
      rintro _ ⟨a, rfl⟩
      rw [map_sub, ← CoalgHomClass.map_comp_comul_apply f a,
        ← CoalgHomClass.map_comp_comul_apply g a]
      exact map_sub_map_mem_sup f g (Coalgebra.comul (R := R) a))
    (by rintro _ ⟨a, rfl⟩; simp)
    (by
      rintro _ ⟨a, rfl⟩
      rw [map_sub, ← BialgHomClass.map_antipode f, ← BialgHomClass.map_antipode g]
      exact sub_mem_equalizerIdeal f g _)

variable {f g : H →ₐc[R] K}

/-- The underlying ideal of the equalizer Hopf ideal is the ideal generated by the
differences. -/
@[simp]
theorem equalizer_toIdeal : (equalizer f g).toIdeal = equalizerIdeal f g := by
  rw [equalizer, ofSpan_toIdeal, equalizerIdeal]

@[simp]
theorem mem_equalizer {x : K} : x ∈ equalizer f g ↔ x ∈ equalizerIdeal f g := by
  rw [← mem_toIdeal, equalizer_toIdeal]

/-- Every difference of values of the two morphisms lies in the equalizer Hopf ideal. -/
theorem sub_mem_equalizer (a : H) : f a - g a ∈ equalizer f g :=
  mem_equalizer.2 (sub_mem_equalizerIdeal f g a)

/-- The equalizer Hopf ideal is the smallest Hopf ideal containing all differences. -/
theorem equalizer_le_iff {J : HopfIdeal R K} :
    equalizer f g ≤ J ↔ ∀ a, f a - g a ∈ J := by
  rw [← toIdeal_le_toIdeal, equalizer_toIdeal]
  exact equalizerIdeal_le_iff

/-- Composing with a ring homomorphism that kills the equalizer Hopf ideal identifies the two
morphisms, and conversely. -/
theorem equalizer_le_ker_iff {A : Type*} [Ring A] (φ : K →+* A) :
    (equalizer f g).toIdeal ≤ RingHom.ker φ ↔ ∀ a, φ (f a) = φ (g a) := by
  rw [equalizer_toIdeal]
  exact equalizerIdeal_le_ker_iff φ

/-- The equalizer of a morphism with itself is the zero Hopf ideal. -/
@[simp]
theorem equalizer_self (f : H →ₐc[R] K) : equalizer f f = ⊥ := by
  ext x
  rw [mem_equalizer, equalizerIdeal_self, mem_bot, Ideal.mem_bot]

/-- The equalizer Hopf ideal is symmetric in the two morphisms. -/
theorem equalizer_comm : equalizer f g = equalizer g f := by
  ext x
  rw [mem_equalizer, mem_equalizer, equalizerIdeal_comm]

/-- **Separation.** The equalizer Hopf ideal vanishes exactly when the two morphisms agree. This
is the form used to prove that a homomorphism out of a group generated by a family of subgroups is
determined by its restrictions. -/
@[simp]
theorem equalizer_eq_bot_iff : equalizer f g = ⊥ ↔ f = g := by
  rw [eq_bot_iff, equalizer_le_iff]
  simp only [mem_bot, sub_eq_zero, DFunLike.ext_iff]

end HopfIdeal

end TauCeti
