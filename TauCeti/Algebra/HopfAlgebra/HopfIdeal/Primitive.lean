module

public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Basic
public import Mathlib.RingTheory.HopfAlgebra.Primitive

/-!
# The Hopf ideal generated by a primitive element

Let `H` be a commutative Hopf algebra and `p : H` a primitive element, that is, a homomorphism
from the affine group scheme `Spec H` to the additive group. The ideal `(p)` is a Hopf ideal: it
cuts out the kernel of that homomorphism.

The three closure conditions hold on the generator: `Δ p = 1 ⊗ p + p ⊗ 1`, `ε p = 0` and
`S p = -p`.

## Main declarations

* `TauCeti.HopfIdeal.ofPrimitive`: the Hopf ideal `(p)`.
* `TauCeti.HopfIdeal.ofPrimitive_toIdeal`: its underlying ideal is `Ideal.span {p}`.
-/

public section

namespace TauCeti

namespace HopfIdeal

universe u v

variable {R : Type u} {H : Type v} [CommSemiring R] [CommRing H] [HopfAlgebra R H] {p : H}

/-- The Hopf ideal generated by a primitive element `p`. It cuts out the kernel of the
homomorphism to the additive group given by `p`. -/
def ofPrimitive (hp : Bialgebra.IsPrimitiveElem R p) : HopfIdeal R H :=
  ofSpan {p}
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      have hmem : x ∈ Ideal.span ({x} : Set H) := Ideal.mem_span_singleton_self _
      rw [hp.comul_eq_tmul_add_tmul]
      exact add_mem
        (Ideal.mem_sup_right (Ideal.tmul_mem_rightTensorIdeal R H 1 hmem))
        (Ideal.mem_sup_left (Ideal.tmul_mem_leftTensorIdeal R H hmem 1)))
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      exact hp.counit_eq_zero)
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      rw [hp.antipode_eq_neg]
      exact neg_mem (Ideal.mem_span_singleton_self _))

/-- The ideal underlying `ofPrimitive` is generated by `p`. -/
@[simp]
theorem ofPrimitive_toIdeal (hp : Bialgebra.IsPrimitiveElem R p) :
    (ofPrimitive hp).toIdeal = Ideal.span {p} :=
  ofSpan_toIdeal _ _ _ _

end HopfIdeal

end TauCeti
