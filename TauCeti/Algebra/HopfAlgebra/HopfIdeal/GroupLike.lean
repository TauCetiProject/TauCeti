module

public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Basic
public import Mathlib.RingTheory.HopfAlgebra.GroupLike
import Mathlib.Tactic.Abel
import Mathlib.Tactic.LinearCombination

/-!
# The Hopf ideal generated by a difference of group-like elements

Let `H` be a commutative Hopf algebra and `χ₁ χ₂ : H` group-like elements, that is, characters of
the affine group scheme `Spec H`. The ideal `(χ₁ - χ₂)` is a Hopf ideal: it cuts out the closed
subgroup scheme on which the two characters agree, the kernel of the character `χ₁ χ₂⁻¹`.

The three closure conditions hold on the generator: `ε(χ₁ - χ₂) = 1 - 1 = 0`,

```text
Δ(χ₁ - χ₂) = (χ₁ - χ₂) ⊗ χ₁ + χ₂ ⊗ (χ₁ - χ₂),
```

and `S(χ₁ - χ₂) = -(S χ₁ S χ₂)(χ₁ - χ₂)` because `S χᵢ` is inverse to `χᵢ`.

## Main declarations

* `TauCeti.HopfIdeal.ofGroupLikeSub`: the Hopf ideal `(χ₁ - χ₂)`.
* `TauCeti.HopfIdeal.ofGroupLikeSub_toIdeal`: its underlying ideal is `Ideal.span {χ₁ - χ₂}`.
* `TauCeti.HopfIdeal.sub_mem_ofGroupLikeSub` and `TauCeti.HopfIdeal.ofGroupLikeSub_le_iff`: it
  contains `χ₁ - χ₂` and is the smallest Hopf ideal doing so.
* `TauCeti.HopfIdeal.ofGroupLikeSub_le_ker_iff`: a ring homomorphism kills it exactly when it
  takes the same value on `χ₁` and `χ₂`; on points, this is the equalizer condition.

## References

* J. S. Milne, *Algebraic Groups* (2017), §§1.h and 12.c.
-/

public section

open scoped TensorProduct

namespace TauCeti

namespace HopfIdeal

universe u v

variable {R : Type u} {H : Type v} [CommSemiring R] [CommRing H] [HopfAlgebra R H]
variable {χ₁ χ₂ : H}

/-- The Hopf ideal generated by the difference `χ₁ - χ₂` of two group-like elements. It cuts out
the closed subgroup scheme on which the characters `χ₁` and `χ₂` agree. -/
def ofGroupLikeSub (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂) : HopfIdeal R H :=
  ofSpan {χ₁ - χ₂}
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      have hmem : χ₁ - χ₂ ∈ Ideal.span ({χ₁ - χ₂} : Set H) := Ideal.mem_span_singleton_self _
      -- `Δ(χ₁ - χ₂) = (χ₁ - χ₂) ⊗ χ₁ + χ₂ ⊗ (χ₁ - χ₂)`.
      have hcomul : Coalgebra.comul (R := R) (χ₁ - χ₂) =
          (χ₁ - χ₂) ⊗ₜ[R] χ₁ + χ₂ ⊗ₜ[R] (χ₁ - χ₂) := by
        rw [map_sub, hχ₁.comul_eq_tmul_self, hχ₂.comul_eq_tmul_self, TensorProduct.sub_tmul,
          TensorProduct.tmul_sub]
        abel
      rw [hcomul]
      exact add_mem
        (Ideal.mem_sup_left (Ideal.tmul_mem_leftTensorIdeal R H hmem χ₁))
        (Ideal.mem_sup_right (Ideal.tmul_mem_rightTensorIdeal R H χ₂ hmem)))
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      -- `ε` lands in the semiring `R`, where `1 - 1` is unavailable, so rewrite `1` back to `ε χ₂`.
      rw [sub_eq_add_neg, map_add, hχ₁.counit_eq_one, ← hχ₂.counit_eq_one, ← map_add,
        add_neg_cancel, map_zero])
    (fun x hx ↦ by
      obtain rfl := Set.mem_singleton_iff.mp hx
      -- `S(χ₁ - χ₂) = -(S χ₁ * S χ₂) * (χ₁ - χ₂)`, since `S χᵢ` is inverse to `χᵢ`.
      have h : HopfAlgebra.antipode R (χ₁ - χ₂) =
          -(HopfAlgebra.antipode R χ₁ * HopfAlgebra.antipode R χ₂) * (χ₁ - χ₂) := by
        linear_combination map_sub (HopfAlgebra.antipode R) χ₁ χ₂ +
          HopfAlgebra.antipode R χ₂ * hχ₁.antipode_mul_cancel -
          HopfAlgebra.antipode R χ₁ * hχ₂.antipode_mul_cancel
      rw [h]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

/-- The ideal underlying `ofGroupLikeSub` is generated by `χ₁ - χ₂`. -/
@[simp]
theorem ofGroupLikeSub_toIdeal (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂) :
    (ofGroupLikeSub hχ₁ hχ₂).toIdeal = Ideal.span {χ₁ - χ₂} :=
  ofSpan_toIdeal _ _ _ _

/-- An element lies in `ofGroupLikeSub` exactly when it is a multiple of `χ₁ - χ₂`. -/
@[simp]
theorem mem_ofGroupLikeSub (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂) {x : H} :
    x ∈ ofGroupLikeSub hχ₁ hχ₂ ↔ x ∈ Ideal.span {χ₁ - χ₂} := by
  rw [← mem_toIdeal, ofGroupLikeSub_toIdeal]

/-- The generator `χ₁ - χ₂` lies in `ofGroupLikeSub`. -/
theorem sub_mem_ofGroupLikeSub (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂) :
    χ₁ - χ₂ ∈ ofGroupLikeSub hχ₁ hχ₂ :=
  (mem_ofGroupLikeSub hχ₁ hχ₂).2 (Ideal.mem_span_singleton_self _)

/-- `ofGroupLikeSub` is the smallest Hopf ideal containing `χ₁ - χ₂`: its universal property. -/
theorem ofGroupLikeSub_le_iff (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂)
    {J : HopfIdeal R H} : ofGroupLikeSub hχ₁ hχ₂ ≤ J ↔ χ₁ - χ₂ ∈ J := by
  rw [← toIdeal_le_toIdeal, ofGroupLikeSub_toIdeal, Ideal.span_singleton_le_iff_mem,
    mem_toIdeal]

/-- **Points of the equalizer of two characters.** A ring homomorphism kills the Hopf ideal
`(χ₁ - χ₂)` exactly when it takes the same value on `χ₁` and `χ₂`. -/
theorem ofGroupLikeSub_le_ker_iff (hχ₁ : IsGroupLikeElem R χ₁) (hχ₂ : IsGroupLikeElem R χ₂)
    {A F : Type*} [Ring A] [FunLike F H A] [RingHomClass F H A] (g : F) :
    (ofGroupLikeSub hχ₁ hχ₂).toIdeal ≤ RingHom.ker g ↔ g χ₁ = g χ₂ := by
  rw [ofGroupLikeSub_toIdeal, Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_sub,
    sub_eq_zero]

end HopfIdeal

end TauCeti
