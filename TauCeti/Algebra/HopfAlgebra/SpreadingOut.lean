module

public import Mathlib.RingTheory.DedekindDomain.SInteger
public import TauCeti.Algebra.HopfAlgebra.Form
import TauCeti.Algebra.Algebra.Subalgebra.Adjoin
import TauCeti.RingTheory.DedekindDomain.SInteger.FiniteSupport

/-!
# Spreading out the Hopf operations over the `S`-integers

Let `R` be a Dedekind domain with fraction field `K` and `H` a finitely generated Hopf algebra over
`K`, not necessarily commutative. Choose generators `s` of `H` over `K` and write the
comultiplication, counit and antipode of each generator in terms of `s`. Only finitely many
elements of `K` occur as coefficients, and each lies in the `S`-integers `S.integer K` once `S`
contains the finitely many places where it is not integral. Then the `S.integer K`-subalgebra
generated by `s` is stable under the Hopf operations of `H` (`Subalgebra.IsStableUnderHopfOps`).

## Main declarations

* `TauCeti.HopfAlgebra.exists_finset_isStableUnderHopfOps_adjoin_of_adjoin_eq_top`: for given
  generators `s` of `H`, a finite set `S₀` of places such that the subalgebra generated by `s` over
  `S.integer K` is stable under the Hopf operations for every `S ⊇ S₀`.
* `TauCeti.HopfAlgebra.exists_finset_isStableUnderHopfOps_adjoin`: generators `s` of `H` and a
  finite set `S₀` of places such that the subalgebra generated by `s` over `S.integer K` is stable
  under the Hopf operations for every `S ⊇ S₀`.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Theorem 3.4(1) and Remark 3.5.
-/

public section

open scoped TensorProduct

open IsDedekindDomain

universe u v w

namespace TauCeti.HopfAlgebra

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type u} [Field K] [Algebra R K]
  [IsFractionRing R K]

variable {H : Type v} [Semiring H] [HopfAlgebra K H]

/-- **Spreading out the Hopf structure, for given generators.** For generators `s` of a Hopf
algebra `H` over `K`, there is a finite set `S₀` of places of `K` such that, for every set
`S ⊇ S₀`, the `S`-integral subalgebra generated by `s` is stable under the Hopf operations of
`H`. -/
theorem exists_finset_isStableUnderHopfOps_adjoin_of_adjoin_eq_top (s : Finset H)
    (hs : Algebra.adjoin K (s : Set H) = ⊤) :
    ∃ S₀ : Finset (HeightOneSpectrum R), ∀ S : Set (HeightOneSpectrum R), (S₀ : Set _) ⊆ S →
      (Algebra.adjoin (S.integer K) (s : Set H)).IsStableUnderHopfOps K := by
  classical
  -- A representation of the comultiplication of each element as a sum of pure tensors.
  choose P hP using fun x : H ↦ TensorProduct.exists_finset (R := K) (Coalgebra.comul x)
  -- The elements of `H` to be made `S`-integral, and their coefficients over `s`.
  let T : Finset H := s.image (HopfAlgebra.antipode K) ∪
    s.biUnion fun x ↦ (P x).image Prod.fst ∪ (P x).image Prod.snd
  have hmem (y : H) : y ∈ Algebra.adjoin K (s : Set H) := hs ▸ Algebra.mem_top
  choose F hF using fun y : H ↦ TauCeti.Algebra.exists_finset_forall_mem_adjoin.{u, v, u} (hmem y)
  obtain ⟨S₀, hS₀⟩ := Finset.exists_finset_forall_subset_integer (R := R)
    (T.biUnion F ∪ s.image (Coalgebra.counit (R := K)))
  refine ⟨S₀, fun S hS ↦ ?_⟩
  have hint := hS₀ S hS
  have hT {y : H} (hy : y ∈ T) : y ∈ Algebra.adjoin (S.integer K) (s : Set H) :=
    hF y (S.integer K) fun f hf ↦
      ⟨⟨f, hint (Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨y, hy, hf⟩))⟩, rfl⟩
  refine Subalgebra.IsStableUnderHopfOps.adjoin (fun x hx ↦ ?_) (fun x hx ↦ ?_) (fun x hx ↦ ?_)
  · rw [hP x]
    refine Subalgebra.sum_mem _ fun i hi ↦ ?_
    have h₁ : i.1 ∈ Algebra.adjoin (S.integer K) (s : Set H) :=
      hT (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨x, hx, Finset.mem_union_left _ (Finset.mem_image_of_mem _ hi)⟩))
    have h₂ : i.2 ∈ Algebra.adjoin (S.integer K) (s : Set H) :=
      hT (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨x, hx, Finset.mem_union_right _ (Finset.mem_image_of_mem _ hi)⟩))
    exact ⟨⟨i.1, h₁⟩ ⊗ₜ ⟨i.2, h₂⟩, Subalgebra.tensorSquareMap_tmul _ _ _⟩
  · rw [Algebra.mem_bot]
    exact ⟨⟨_, hint (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hx))⟩, rfl⟩
  · exact hT (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hx))

/-- **Spreading out the Hopf structure.** For a finitely generated Hopf algebra `H`
over `K`, there are generators `s` of `H` and a finite set `S₀` of places of `K` such that, for
every set `S ⊇ S₀`, the `S`-integral subalgebra generated by `s` is stable under the Hopf
operations of `H`. -/
theorem exists_finset_isStableUnderHopfOps_adjoin [Algebra.FiniteType K H] :
    ∃ (s : Finset H) (S₀ : Finset (HeightOneSpectrum R)),
      Algebra.adjoin K (s : Set H) = ⊤ ∧ ∀ S : Set (HeightOneSpectrum R), (S₀ : Set _) ⊆ S →
        (Algebra.adjoin (S.integer K) (s : Set H)).IsStableUnderHopfOps K := by
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := K) (A := H)
  obtain ⟨S₀, hS₀⟩ := exists_finset_isStableUnderHopfOps_adjoin_of_adjoin_eq_top (R := R) s hs
  exact ⟨s, S₀, hs, hS₀⟩

end TauCeti.HopfAlgebra
