module

public import Mathlib.RingTheory.Bialgebra.TensorProduct
public import Mathlib.RingTheory.HopfAlgebra.Basic
public import TauCeti.Algebra.TensorProduct.Subalgebra
import Mathlib.Algebra.Algebra.Subalgebra.MulOpposite
import Mathlib.RingTheory.HopfAlgebra.Convolution
import TauCeti.Algebra.Algebra.Subalgebra.Lattice

/-!
# Forms of a Hopf algebra over a subring

Let `K` be an `R`-algebra, for instance a localization of a domain `R` such as its fraction field,
and `H` a Hopf algebra over `K`. An `R`-subalgebra `A` of `H` is **stable under the Hopf
operations** when the comultiplication of `H` maps `A` into the image of `A ⊗[R] A` in
`H ⊗[K] H`, the counit maps `A` into `R`, and the antipode maps `A` into itself. Each operation
restricts to `A` under the hypotheses it needs: the antipode always, the counit when
`algebraMap R K` is injective, and the comultiplication when `A` is flat over the domain `R` and
`K`-balanced and `R`-balanced tensors agree, so that `A ⊗[R] A → H ⊗[K] H` is injective
(`Subalgebra.tensorSquareMap_injective`). Then the operations of `H` restrict to a Hopf algebra
structure on `A` over `R`, and all Hopf identities hold over `R`. When `K` is a localization of `R`
and `A` spans `H` over `K`, it is a **Hopf form** of `H`: `K ⊗[R] A ≃ H` as bialgebras.

This is the passage from a group scheme over `K` to a model over `R`: for an affine group over a
number field, a finitely generated flat `A` over the `S`-integers, stable under the Hopf
operations and spanning `H` over `K`, is an integral model away from `S`
(`Subalgebra.IsStableUnderHopfOps.baseChangeBialgEquiv`). Unlike `Subalgebra.IsHopfSubalgebra`,
the base ring changes from `K` to `R`, and the counit condition is not automatic.

## Main declarations

* `Subalgebra.IsStableUnderHopfOps`: an `R`-subalgebra stable under the comultiplication, counit
  and antipode.
* `Subalgebra.IsStableUnderHopfOps.comulAlgHom`, `Subalgebra.IsStableUnderHopfOps.counitAlgHom`
  and `Subalgebra.IsStableUnderHopfOps.antipode`: the restricted operations, each under the
  hypotheses it needs.
* `Subalgebra.IsStableUnderHopfOps.hopfAlgebra`: the restricted Hopf algebra structure over `R`,
  for flat `A`, with `Subalgebra.IsStableUnderHopfOps.tensorSquareMap_comul`,
  `Subalgebra.IsStableUnderHopfOps.algebraMap_counit` and
  `Subalgebra.IsStableUnderHopfOps.coe_antipode` identifying its operations with those of `H`.
* `Subalgebra.IsStableUnderHopfOps.baseChangeBialgEquiv`: the isomorphism of bialgebras
  `K ⊗[R] A ≃ H` for flat `A` which spans `H` over a localization `K` of `R`.
* `Subalgebra.IsStableUnderHopfOps.adjoin`: the subalgebra generated by a set is stable under the
  Hopf operations as soon as the three conditions hold on the generators.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Theorem 3.4 and Remark 3.5.
-/

public section

open scoped TensorProduct

namespace Subalgebra

variable {R K H : Type*} [CommSemiring R] [CommSemiring K] [Algebra R K] [Semiring H]
  [HopfAlgebra K H] [Algebra R H] [IsScalarTower R K H]

variable (K) in
/-- An `R`-subalgebra `A` of a Hopf algebra `H` over `K` is **stable under the Hopf operations**
of `H` when the comultiplication maps `A` into the image of `A ⊗[R] A`, the counit maps `A` into the
image of `R`, and the antipode maps `A` into itself. Such an `A` spanning `H` over a localization
`K` of `R` is a Hopf form of `H` (`baseChangeBialgEquiv`). -/
structure IsStableUnderHopfOps (A : Subalgebra R H) : Prop where
  /-- The comultiplication of an element of `A` lies in the image of `A ⊗[R] A`. -/
  comul_mem ⦃x : H⦄ : x ∈ A → Coalgebra.comul (R := K) x ∈ (tensorSquareMap K A).range
  /-- The counit of an element of `A` lies in the image of `R`. -/
  counit_mem ⦃x : H⦄ : x ∈ A → Coalgebra.counit (R := K) x ∈ (⊥ : Subalgebra R K)
  /-- The antipode maps `A` into itself. -/
  antipode_mem ⦃x : H⦄ : x ∈ A → HopfAlgebra.antipode K x ∈ A

end Subalgebra

namespace Subalgebra.IsStableUnderHopfOps

section Semiring

variable {R K H : Type*} [CommSemiring R] [CommSemiring K] [Algebra R K] [Semiring H]
  [HopfAlgebra K H] [Algebra R H] [IsScalarTower R K H] {A : Subalgebra R H}
  (hA : A.IsStableUnderHopfOps K)
include hA

/-- The restriction of the antipode of `H` to an `R`-subalgebra stable under the Hopf
operations. -/
noncomputable def antipode : A →ₗ[R] A :=
  ((HopfAlgebra.antipode K (A := H)).restrictScalars R).restrict (p := toSubmodule A)
    (q := toSubmodule A) fun _ hx ↦ hA.antipode_mem hx

/-- The restricted antipode has the same values as the antipode of `H`. -/
@[simp]
theorem coe_antipode_apply (x : A) : (hA.antipode x : H) = HopfAlgebra.antipode K (x : H) :=
  (rfl)

private theorem coe_mul_rTensor (t : A ⊗[R] A) :
    (LinearMap.mul' R A (hA.antipode.rTensor A t) : H) =
      LinearMap.mul' K H ((HopfAlgebra.antipode K (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y => simp

private theorem coe_mul_lTensor (t : A ⊗[R] A) :
    (LinearMap.mul' R A (hA.antipode.lTensor A t) : H) =
      LinearMap.mul' K H ((HopfAlgebra.antipode K (A := H)).lTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y => simp

variable [FaithfulSMul R K]

/-- The restriction of the counit of `H` to an `R`-subalgebra stable under the Hopf operations,
for injective `algebraMap R K`: the unique preimage in `R` of the counit of `H`. -/
noncomputable def counitAlgHom : A →ₐ[R] R :=
  (Algebra.botEquivOfInjective (FaithfulSMul.algebraMap_injective R K)).toAlgHom.comp
    ((((Bialgebra.counitAlgHom K H).restrictScalars R).comp A.val).codRestrict _
      fun x ↦ hA.counit_mem x.property)

/-- The restricted counit is the restriction of that of `H`. -/
@[simp]
theorem algebraMap_counitAlgHom (x : A) :
    algebraMap R K (hA.counitAlgHom x) = Coalgebra.counit (R := K) (x : H) := by
  simp only [counitAlgHom, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    Algebra.algebraMap_botEquivOfInjective]
  exact AlgHom.coe_codRestrict _ _ _ x

private theorem coe_lid_rTensor (t : A ⊗[R] A) :
    ((Algebra.TensorProduct.lid R A (Algebra.TensorProduct.map hA.counitAlgHom (.id R A) t) :
      A) : H) =
      TensorProduct.lid K H
        ((Coalgebra.counit (R := K) (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y =>
    simp [← algebraMap_smul (A := K), algebraMap_counitAlgHom]

private theorem coe_rid_lTensor (t : A ⊗[R] A) :
    ((Algebra.TensorProduct.rid R R A (Algebra.TensorProduct.map (.id R A) hA.counitAlgHom t) :
      A) : H) =
      TensorProduct.rid K H
        ((Coalgebra.counit (R := K) (A := H)).lTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y =>
    simp [← algebraMap_smul (A := K), algebraMap_counitAlgHom]

/-- The scalar side of the antipode identities: the counit of `A`, viewed in `A ⊆ H`, is the
counit of `H` viewed in `H`. -/
private theorem coe_algebraMap_counitAlgHom (x : A) :
    ((algebraMap R A (hA.counitAlgHom x) : A) : H) =
      algebraMap K H (Coalgebra.counit (R := K) (x : H)) := by
  rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply R K H, algebraMap_counitAlgHom]

end Semiring

section Ring

variable {R K H : Type*} [CommRing R] [IsDomain R] [CommRing K] [Algebra R K] [Ring H]
  [HopfAlgebra K H] [Algebra R H] [IsScalarTower R K H] [TensorProduct.CompatibleSMul R K H H]
  {A : Subalgebra R H} [Module.Flat R A] (hA : A.IsStableUnderHopfOps K)
include hA

omit hA in
/-- The inverse of `A ⊗[R] A ≃ (tensorSquareMap K A).range`, for flat `A`, followed by
`tensorSquareMap`, is the inclusion of the range. -/
private theorem tensorSquareMap_ofInjective_symm (y : (tensorSquareMap K A).range) :
    tensorSquareMap K A ((AlgEquiv.ofInjective _ (tensorSquareMap_injective A)).symm y) = y :=
  (AlgEquiv.ofInjective_apply _ (tensorSquareMap_injective A) _).symm.trans
    (congrArg Subtype.val (AlgEquiv.apply_symm_apply _ y))

/-- The restriction of the comultiplication of `H` to a flat `R`-subalgebra stable under the
Hopf operations: the unique preimage of the comultiplication of `H` under the injective map
`A ⊗[R] A → H ⊗[K] H`. -/
noncomputable def comulAlgHom : A →ₐ[R] A ⊗[R] A :=
  (AlgEquiv.ofInjective _ (tensorSquareMap_injective A)).symm.toAlgHom.comp
    ((((Bialgebra.comulAlgHom K H).restrictScalars R).comp A.val).codRestrict _
      fun x ↦ hA.comul_mem x.property)

/-- The restricted comultiplication is the restriction of that of `H`. -/
@[simp]
theorem tensorSquareMap_comulAlgHom (x : A) :
    tensorSquareMap K A (hA.comulAlgHom x) = Coalgebra.comul (R := K) (x : H) := by
  rw [comulAlgHom, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, tensorSquareMap_ofInjective_symm]
  exact AlgHom.coe_codRestrict _ _ _ x

/-! ### Reflecting identities into `H` -/

variable [TensorProduct.CompatibleSMul R K H (H ⊗[K] H)]

private theorem tensorCubeMap_assoc_rTensor (t : A ⊗[R] A) :
    tensorCubeMap K A (Algebra.TensorProduct.assoc R R R A A A
        (Algebra.TensorProduct.map hA.comulAlgHom (.id R A) t)) =
      TensorProduct.assoc K H H H
        ((Coalgebra.comul (R := K) (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, hs, ht]
  | tmul x y => simp [tensorCubeMap_assoc_tmul]

private theorem tensorCubeMap_lTensor (t : A ⊗[R] A) :
    tensorCubeMap K A (Algebra.TensorProduct.map (.id R A) hA.comulAlgHom t) =
      (Coalgebra.comul (R := K) (A := H)).lTensor H (tensorSquareMap K A t) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, hs, ht]
  | tmul x y => simp

variable [FaithfulSMul R K]

/-- The bialgebra structure on a flat `R`-subalgebra stable under the Hopf operations, restricted
from `H`. This is not an instance because it depends on the proof `hA`. -/
@[expose, instance_reducible]
noncomputable def bialgebra : Bialgebra R A :=
  Bialgebra.ofAlgHom hA.comulAlgHom hA.counitAlgHom
    (by
      ext a
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      apply tensorCubeMap_injective (K := K) A
      rw [hA.tensorCubeMap_assoc_rTensor, hA.tensorCubeMap_lTensor, hA.tensorSquareMap_comulAlgHom]
      exact Coalgebra.coassoc_apply (R := K) (a : H))
    (by
      ext a
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      apply (Algebra.TensorProduct.lid R A).injective
      apply Subtype.val_injective
      rw [AlgEquiv.apply_symm_apply, hA.coe_lid_rTensor, hA.tensorSquareMap_comulAlgHom,
        Coalgebra.rTensor_counit_comul, TensorProduct.lid_tmul, one_smul])
    (by
      ext a
      simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
      apply (Algebra.TensorProduct.rid R R A).injective
      apply Subtype.val_injective
      rw [AlgEquiv.apply_symm_apply, hA.coe_rid_lTensor, hA.tensorSquareMap_comulAlgHom,
        Coalgebra.lTensor_counit_comul, TensorProduct.rid_tmul, one_smul])

/-- The comultiplication of the restricted bialgebra structure is `comulAlgHom`. -/
@[simp]
theorem comul_bialgebra (x : A) :
    letI := hA.bialgebra
    Coalgebra.comul (R := R) x = hA.comulAlgHom x :=
  rfl

/-- The counit of the restricted bialgebra structure is `counitAlgHom`. -/
@[simp]
theorem counit_bialgebra (x : A) :
    letI := hA.bialgebra
    Coalgebra.counit (R := R) x = hA.counitAlgHom x :=
  rfl

/-- The Hopf algebra structure over `R` on a flat `R`-subalgebra of `H` stable under the Hopf
operations: comultiplication, counit and antipode are restricted from `H`. This is not an instance
because it depends on the proof `hA`. -/
@[expose, instance_reducible]
noncomputable def hopfAlgebra : HopfAlgebra R A :=
  letI := hA.bialgebra
  { antipode := hA.antipode
    mul_antipode_rTensor_comul := by
      ext a
      simp only [LinearMap.comp_apply, hA.comul_bialgebra, hA.counit_bialgebra,
        Algebra.linearMap_apply, hA.coe_mul_rTensor, hA.tensorSquareMap_comulAlgHom,
        HopfAlgebra.mul_antipode_rTensor_comul_apply, hA.coe_algebraMap_counitAlgHom]
    mul_antipode_lTensor_comul := by
      ext a
      simp only [LinearMap.comp_apply, hA.comul_bialgebra, hA.counit_bialgebra,
        Algebra.linearMap_apply, hA.coe_mul_lTensor, hA.tensorSquareMap_comulAlgHom,
        HopfAlgebra.mul_antipode_lTensor_comul_apply, hA.coe_algebraMap_counitAlgHom] }

/-- The antipode of the restricted Hopf algebra structure is `antipode`. -/
@[simp]
theorem antipode_hopfAlgebra (x : A) :
    letI := hA.hopfAlgebra
    HopfAlgebra.antipode R x = hA.antipode x :=
  rfl

/-- The comultiplication of a flat subalgebra stable under the Hopf operations maps to that of
`H`. -/
theorem tensorSquareMap_comul (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    tensorSquareMap K A (Coalgebra.comul (R := R) x) = Coalgebra.comul (R := K) (x : H) :=
  hA.tensorSquareMap_comulAlgHom x

/-- The counit of a flat subalgebra stable under the Hopf operations maps to that of `H`. -/
theorem algebraMap_counit (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    algebraMap R K (Coalgebra.counit (R := R) x) = Coalgebra.counit (R := K) (x : H) :=
  hA.algebraMap_counitAlgHom x

/-- The antipode of a flat subalgebra stable under the Hopf operations is the antipode of `H`. -/
theorem coe_antipode (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    ((HopfAlgebra.antipode R x : A) : H) = HopfAlgebra.antipode K (x : H) :=
  hA.coe_antipode_apply x

/-! ### Base change to `K` -/

/-- **Base change of a flat Hopf form.** If a flat `R`-subalgebra `A` of `H` stable under the Hopf
operations spans `H` over a localization `K` of `R`, so that `A` is a Hopf form of `H`, then
`k ⊗ a ↦ k • a` is an isomorphism of bialgebras `K ⊗[R] A ≃ H` over `K`. -/
noncomputable def baseChangeBialgEquiv (M : Submonoid R) [IsLocalization M K]
    (hspan : Submodule.span K (A : Set H) = ⊤) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    K ⊗[R] A ≃ₐc[K] H :=
  letI : HopfAlgebra R A := hA.hopfAlgebra
  BialgEquiv.ofAlgEquiv (A.isBaseChange_val M hspan).algEquiv
    (by
      apply Algebra.TensorProduct.ext (by ext) ?_
      ext a
      simp)
    (by
      apply Algebra.TensorProduct.ext (by ext) ?_
      ext a
      simpa using (A.map_algEquiv_tensorTensorTensorComm_one_tmul M hspan
        _).trans (hA.tensorSquareMap_comul a))

/-- The base-change isomorphism of a spanning flat Hopf form sends `k ⊗ a` to `k • a`. -/
@[simp]
theorem baseChangeBialgEquiv_tmul (M : Submonoid R) [IsLocalization M K]
    (hspan : Submodule.span K (A : Set H) = ⊤) (k : K) (a : A) :
    hA.baseChangeBialgEquiv M hspan (k ⊗ₜ a) = k • (a : H) :=
  IsBaseChange.algEquiv_tmul _ k a

end Ring

end Subalgebra.IsStableUnderHopfOps

namespace Subalgebra

variable {R K : Type*} [CommSemiring R] [CommSemiring K] [Algebra R K]

/-- **Stability from generators.** The `R`-subalgebra generated by a set `s` of a Hopf algebra
`H` over `K` is stable under the Hopf operations as soon as the comultiplication, counit and
antipode of each element of `s` satisfy the defining conditions. -/
-- The three conditions define `R`-subalgebras, as preimages of subalgebras under algebra maps;
-- for the antipode, an algebra map to the opposite algebra.
theorem IsStableUnderHopfOps.adjoin {H : Type*} [Semiring H] [HopfAlgebra K H] [Algebra R H]
    [IsScalarTower R K H] {s : Set H}
    (hcomul : ∀ x ∈ s, Coalgebra.comul (R := K) x ∈
      (tensorSquareMap K (Algebra.adjoin R s)).range)
    (hcounit : ∀ x ∈ s, Coalgebra.counit (R := K) x ∈ (⊥ : Subalgebra R K))
    (hantipode : ∀ x ∈ s, HopfAlgebra.antipode K x ∈ Algebra.adjoin R s) :
    (Algebra.adjoin R s).IsStableUnderHopfOps K where
  comul_mem := Algebra.adjoin_le (S := (tensorSquareMap K (Algebra.adjoin R s)).range.comap
    ((Bialgebra.comulAlgHom K H).restrictScalars R)) hcomul
  counit_mem := Algebra.adjoin_le (S := (⊥ : Subalgebra R K).comap
    ((Bialgebra.counitAlgHom K H).restrictScalars R)) hcounit
  antipode_mem x hx := by
    -- The antipode is an algebra map to the opposite algebra, so the condition defines an
    -- `R`-subalgebra.
    have := Algebra.adjoin_le (S := Subalgebra.comap
      ((HopfAlgebra.antipodeAlgHomOp K H).restrictScalars R) (Algebra.adjoin R s).op)
      (fun y hy ↦ by simpa [Subalgebra.mem_op] using hantipode y hy) hx
    simpa [Subalgebra.mem_op] using this

end Subalgebra
