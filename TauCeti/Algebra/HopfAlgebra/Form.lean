/-!
# Forms of a Hopf algebra over a subring

Let `K` be the fraction field of a domain `R` and `H` a Hopf algebra over `K`. An `R`-subalgebra
`A` of `H` is a **Hopf form** of `H` over `R` when the comultiplication of `H` maps `A` into the
image of `A ⊗[R] A` in `H ⊗[K] H`, the counit maps `A` into `R`, and the antipode maps `A` into
itself. When `A` is flat over `R`, the map `A ⊗[R] A → H ⊗[K] H` is injective, so the operations
of `H` restrict to a Hopf algebra structure on `A` over `R`, and all Hopf identities hold over `R`.

This is the passage from a group scheme over `K` to a model over `R`: for an affine group over a
number field, a finitely generated Hopf form over the `S`-integers is an integral model away from
`S`. Unlike `Subalgebra.IsHopfSubalgebra`, the base ring changes from `K` to `R`, and the counit
condition is not automatic.

## Main declarations

* `Subalgebra.tensorSquareMap`: the canonical map `A ⊗[R] A → H ⊗[K] H`, injective when `A` is
  flat over `R` (`Subalgebra.tensorSquareMap_injective`).
* `Subalgebra.IsHopfForm`: an `R`-subalgebra stable under the comultiplication, counit and
  antipode.
* `Subalgebra.IsHopfForm.hopfAlgebra`: the restricted Hopf algebra structure over `R`, for a flat
  Hopf form, with `Subalgebra.IsHopfForm.tensorSquareMap_comul`,
  `Subalgebra.IsHopfForm.algebraMap_counit` and `Subalgebra.IsHopfForm.coe_antipode` identifying its
  operations with those of `H`.
* `Subalgebra.IsHopfForm.baseChangeBialgEquiv`: the isomorphism of bialgebras `K ⊗[R] A ≃ H` for a
  flat Hopf form `A` which spans `H` over `K`.
* `Subalgebra.IsHopfForm.adjoin`: the subalgebra generated by a set is a Hopf form as soon as the
  three conditions hold on the generators.

## References

* B. Conrad, *Weil and Grothendieck approaches to adelic points*, Enseign. Math. (2) 58 (2012),
  Theorem 3.4 and Remark 3.5.
-/

public section

open scoped TensorProduct

namespace Subalgebra

variable {R K H : Type*} [CommRing R] [CommRing K] [Algebra R K] [Ring H] [Algebra K H]
  [Algebra R H] [IsScalarTower R K H]

variable (K) in
/-- The canonical map from the tensor square over `R` of an `R`-subalgebra `A` of a `K`-algebra
`H` to the tensor square of `H` over `K`. On pure tensors it applies the inclusion of `A` in both
factors. -/
noncomputable def tensorSquareMap (A : Subalgebra R H) : A ⊗[R] A →ₐ[R] H ⊗[K] H :=
  Algebra.TensorProduct.lift
    ((Algebra.TensorProduct.includeLeft : H →ₐ[K] H ⊗[K] H).restrictScalars R |>.comp A.val)
    ((Algebra.TensorProduct.includeRight : H →ₐ[K] H ⊗[K] H).restrictScalars R |>.comp A.val)
    fun x y ↦ by
      simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply,
        Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply]
      exact (Commute.one_right _).tmul (Commute.one_left _)

/-- The canonical map `A ⊗[R] A → H ⊗[K] H` sends `x ⊗ y` to `x ⊗ y`. -/
@[simp]
theorem tensorSquareMap_tmul (A : Subalgebra R H) (x y : A) :
    tensorSquareMap K A (x ⊗ₜ y) = (x : H) ⊗ₜ[K] (y : H) := by
  rw [tensorSquareMap, Algebra.TensorProduct.lift_tmul]
  simp

end Subalgebra

namespace Subalgebra

variable {R K H : Type*} [CommRing R] [Field K] [Algebra R K] [Ring H] [Algebra K H]
  [Algebra R H] [IsScalarTower R K H]

/-- For a flat `R`-subalgebra `A` of an algebra over the fraction field `K` of `R`, the canonical
map `A ⊗[R] A → H ⊗[K] H` is injective. -/
-- Composed with the isomorphism `H ⊗[K] H ≅ H ⊗[R] H` of a localization, it is the tensor square
-- of the inclusion of `A`, which is injective since `A` is flat over the domain `R`.
theorem tensorSquareMap_injective [IsFractionRing R K] (A : Subalgebra R H)
    [Module.Flat R A] : Function.Injective (tensorSquareMap K A) := by
  have : IsDomain R := Function.Injective.isDomain _ (IsFractionRing.injective R K)
  have : TensorProduct.CompatibleSMul R K H H :=
    IsLocalization.tensorProduct_compatibleSMul (nonZeroDivisors R) K H H
  have hcomp : (TensorProduct.mapOfCompatibleSMul R K R H H : H ⊗[K] H →ₗ[R] H ⊗[R] H) ∘ₗ
      (tensorSquareMap K A).toLinearMap =
        TensorProduct.map A.val.toLinearMap A.val.toLinearMap :=
    TensorProduct.ext' fun x y ↦ by simp
  refine .of_comp (f := TensorProduct.mapOfCompatibleSMul R K R H H) ?_
  rw [← AlgHom.coe_toLinearMap, ← LinearMap.coe_comp, hcomp]
  exact TensorProduct.map_injective_of_flat_flat_of_isDomain _ _
    Subtype.val_injective Subtype.val_injective

end Subalgebra

namespace Subalgebra

variable {R K H : Type*} [CommRing R] [CommRing K] [Algebra R K] [Ring H] [HopfAlgebra K H]
  [Algebra R H] [IsScalarTower R K H]

variable (K) in
/-- An `R`-subalgebra `A` of a Hopf algebra `H` over `K` is a **Hopf form** of `H` over `R` when
the comultiplication maps `A` into the image of `A ⊗[R] A`, the counit maps `A` into the image of
`R`, and the antipode maps `A` into itself. -/
structure IsHopfForm (A : Subalgebra R H) : Prop where
  /-- The comultiplication of an element of `A` lies in the image of `A ⊗[R] A`. -/
  comul_mem ⦃x : H⦄ : x ∈ A → Coalgebra.comul (R := K) x ∈ (tensorSquareMap K A).range
  /-- The counit of an element of `A` lies in the image of `R`. -/
  counit_mem ⦃x : H⦄ : x ∈ A → Coalgebra.counit (R := K) x ∈ (⊥ : Subalgebra R K)
  /-- The antipode maps `A` into itself. -/
  antipode_mem ⦃x : H⦄ : x ∈ A → HopfAlgebra.antipode K x ∈ A

end Subalgebra

namespace Subalgebra.IsHopfForm

variable {R K H : Type*} [CommRing R] [Field K] [Algebra R K] [Ring H] [HopfAlgebra K H]
  [Algebra R H] [IsScalarTower R K H]

variable [IsFractionRing R K] {A : Subalgebra R H} [Module.Flat R A]
variable (hA : A.IsHopfForm K)
include hA

/-- The comultiplication of a flat Hopf form: the unique preimage of the comultiplication of `H`
under the injective map `A ⊗[R] A → H ⊗[K] H`. -/
noncomputable def comulAlgHom : A →ₐ[R] A ⊗[R] A :=
  (AlgEquiv.ofInjective _ (tensorSquareMap_injective A)).symm.toAlgHom.comp
    ((((Bialgebra.comulAlgHom K H).restrictScalars R).comp A.val).codRestrict _
      fun x ↦ hA.comul_mem x.property)

/-- The comultiplication of a flat Hopf form is the restriction of that of `H`. -/
@[simp]
theorem tensorSquareMap_comulAlgHom (x : A) :
    tensorSquareMap K A (hA.comulAlgHom x) = Coalgebra.comul (R := K) (x : H) := by
  set e := AlgEquiv.ofInjective _ (tensorSquareMap_injective (K := K) A)
  set y := (((Bialgebra.comulAlgHom K H).restrictScalars R).comp A.val).codRestrict _
    (fun x ↦ hA.comul_mem x.property) x
  have h := AlgEquiv.ofInjective_apply _ (tensorSquareMap_injective (K := K) A) (e.symm y)
  rw [AlgEquiv.apply_symm_apply] at h
  exact h.symm

/-- The counit of a flat Hopf form: the unique preimage in `R` of the counit of `H`. -/
noncomputable def counitAlgHom : A →ₐ[R] R :=
  (Algebra.botEquivOfInjective (IsFractionRing.injective R K)).toAlgHom.comp
    ((((Bialgebra.counitAlgHom K H).restrictScalars R).comp A.val).codRestrict _
      fun x ↦ hA.counit_mem x.property)

omit [Module.Flat R A] in
/-- The counit of a flat Hopf form is the restriction of that of `H`. -/
@[simp]
theorem algebraMap_counitAlgHom (x : A) :
    algebraMap R K (hA.counitAlgHom x) = Coalgebra.counit (R := K) (x : H) := by
  set e := Algebra.botEquivOfInjective (IsFractionRing.injective R K)
  set y := (((Bialgebra.counitAlgHom K H).restrictScalars R).comp A.val).codRestrict _
    (fun x ↦ hA.counit_mem x.property) x
  change ((e.symm (e y) : (⊥ : Subalgebra R K)) : K) = _
  rw [e.symm_apply_apply]
  rfl

/-- The restriction of the antipode of `H` to a Hopf form. -/
noncomputable def antipode : A →ₗ[R] A :=
  ((HopfAlgebra.antipode K (A := H)).restrictScalars R).restrict (p := toSubmodule A)
    (q := toSubmodule A) fun _ hx ↦ hA.antipode_mem hx

omit [IsFractionRing R K] [Module.Flat R A] in
/-- The restricted antipode has the same values as the antipode of `H`. -/
@[simp]
theorem coe_antipode_apply (x : A) : (hA.antipode x : H) = HopfAlgebra.antipode K (x : H) :=
  (rfl)

/-! ### Reflecting identities into `H` -/

omit hA in
/-- The canonical map `A ⊗[R] (A ⊗[R] A) → H ⊗[K] (H ⊗[K] H)`. -/
private noncomputable def tripleMap : A ⊗[R] (A ⊗[R] A) →ₗ[R] H ⊗[K] (H ⊗[K] H) :=
  have : TensorProduct.CompatibleSMul R K H (H ⊗[K] H) :=
    IsLocalization.tensorProduct_compatibleSMul (nonZeroDivisors R) K H (H ⊗[K] H)
  (TensorProduct.equivOfCompatibleSMul R K R H (H ⊗[K] H)).symm.toLinearMap ∘ₗ
    TensorProduct.map A.val.toLinearMap (tensorSquareMap K A).toLinearMap

omit hA [Module.Flat R A] in
private theorem tripleMap_tmul (x : A) (t : A ⊗[R] A) :
    tripleMap (K := K) (A := A) (x ⊗ₜ t) = (x : H) ⊗ₜ[K] tensorSquareMap K A t :=
  rfl

omit hA in
private theorem tripleMap_injective : Function.Injective (tripleMap (K := K) (A := A)) := by
  have : TensorProduct.CompatibleSMul R K H (H ⊗[K] H) :=
    IsLocalization.tensorProduct_compatibleSMul (nonZeroDivisors R) K H (H ⊗[K] H)
  have : IsDomain R := Function.Injective.isDomain _ (IsFractionRing.injective R K)
  refine (TensorProduct.equivOfCompatibleSMul R K R H (H ⊗[K] H)).symm.injective.comp ?_
  exact TensorProduct.map_injective_of_flat_flat_of_isDomain _ _
    Subtype.val_injective (tensorSquareMap_injective A)

omit hA [Module.Flat R A] in
private theorem tripleMap_assoc_tmul (t : A ⊗[R] A) (z : A) :
    tripleMap (K := K) (A := A) (TensorProduct.assoc R A A A (t ⊗ₜ z)) =
      TensorProduct.assoc K H H H (tensorSquareMap K A t ⊗ₜ (z : H)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [TensorProduct.add_tmul, map_add, hs, ht]
  | tmul x y => simp [tripleMap_tmul]

private theorem tripleMap_assoc_rTensor (t : A ⊗[R] A) :
    tripleMap (K := K) (A := A)
        (TensorProduct.assoc R A A A (hA.comulAlgHom.toLinearMap.rTensor A t)) =
      TensorProduct.assoc K H H H
        ((Coalgebra.comul (R := K) (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, hs, ht]
  | tmul x y => simp [tripleMap_assoc_tmul]

private theorem tripleMap_lTensor (t : A ⊗[R] A) :
    tripleMap (K := K) (A := A) (hA.comulAlgHom.toLinearMap.lTensor A t) =
      (Coalgebra.comul (R := K) (A := H)).lTensor H (tensorSquareMap K A t) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, hs, ht]
  | tmul x y => simp [tripleMap_tmul]

omit [Module.Flat R A] in
private theorem coe_lid_rTensor (t : A ⊗[R] A) :
    ((TensorProduct.lid R A (hA.counitAlgHom.toLinearMap.rTensor A t) : A) : H) =
      TensorProduct.lid K H
        ((Coalgebra.counit (R := K) (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y =>
    simp [← algebraMap_smul (A := K), algebraMap_counitAlgHom]

omit [Module.Flat R A] in
private theorem coe_rid_lTensor (t : A ⊗[R] A) :
    ((TensorProduct.rid R A (hA.counitAlgHom.toLinearMap.lTensor A t) : A) : H) =
      TensorProduct.rid K H
        ((Coalgebra.counit (R := K) (A := H)).lTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y =>
    simp [← algebraMap_smul (A := K), algebraMap_counitAlgHom]

omit [IsFractionRing R K] [Module.Flat R A] in
private theorem coe_mul_rTensor (t : A ⊗[R] A) :
    (LinearMap.mul' R A (hA.antipode.rTensor A t) : H) =
      LinearMap.mul' K H ((HopfAlgebra.antipode K (A := H)).rTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y => simp

omit [IsFractionRing R K] [Module.Flat R A] in
private theorem coe_mul_lTensor (t : A ⊗[R] A) :
    (LinearMap.mul' R A (hA.antipode.lTensor A t) : H) =
      LinearMap.mul' K H ((HopfAlgebra.antipode K (A := H)).lTensor H (tensorSquareMap K A t)) := by
  induction t using TensorProduct.inductionOn with
  | add s t hs ht => simp only [map_add, Subalgebra.coe_add, hs, ht]
  | tmul x y => simp

/-- The bialgebra structure on a flat Hopf form, restricted from `H`. This is not an instance
because it depends on the proof `hA`. -/
@[expose, instance_reducible]
noncomputable def bialgebra : Bialgebra R A :=
  Bialgebra.ofAlgHom hA.comulAlgHom hA.counitAlgHom
    (by
      ext a
      change TensorProduct.assoc R A A A (hA.comulAlgHom.toLinearMap.rTensor A
          (hA.comulAlgHom a)) = hA.comulAlgHom.toLinearMap.lTensor A (hA.comulAlgHom a)
      apply tripleMap_injective (K := K)
      rw [hA.tripleMap_assoc_rTensor, hA.tripleMap_lTensor, hA.tensorSquareMap_comulAlgHom]
      exact Coalgebra.coassoc_apply (R := K) (a : H))
    (by
      ext a
      change hA.counitAlgHom.toLinearMap.rTensor A (hA.comulAlgHom a) =
        (TensorProduct.lid R A).symm a
      apply (TensorProduct.lid R A).injective
      apply Subtype.val_injective
      rw [LinearEquiv.apply_symm_apply, hA.coe_lid_rTensor, hA.tensorSquareMap_comulAlgHom,
        Coalgebra.rTensor_counit_comul, TensorProduct.lid_tmul, one_smul])
    (by
      ext a
      change hA.counitAlgHom.toLinearMap.lTensor A (hA.comulAlgHom a) =
        (TensorProduct.rid R A).symm a
      apply (TensorProduct.rid R A).injective
      apply Subtype.val_injective
      rw [LinearEquiv.apply_symm_apply, hA.coe_rid_lTensor, hA.tensorSquareMap_comulAlgHom,
        Coalgebra.lTensor_counit_comul, TensorProduct.rid_tmul, one_smul])

/-- The Hopf algebra structure over `R` on a flat Hopf form of `H`: comultiplication, counit and
antipode are restricted from `H`. This is not an instance because it depends on the proof `hA`. -/
@[expose, instance_reducible]
noncomputable def hopfAlgebra : HopfAlgebra R A :=
  letI := hA.bialgebra
  { antipode := hA.antipode
    mul_antipode_rTensor_comul := by
      ext a
      change (LinearMap.mul' R A (hA.antipode.rTensor A (hA.comulAlgHom a)) : H) =
        (algebraMap R A (hA.counitAlgHom a) : H)
      rw [hA.coe_mul_rTensor, hA.tensorSquareMap_comulAlgHom,
        HopfAlgebra.mul_antipode_rTensor_comul_apply, Subalgebra.coe_algebraMap,
        IsScalarTower.algebraMap_apply R K H, algebraMap_counitAlgHom]
    mul_antipode_lTensor_comul := by
      ext a
      change (LinearMap.mul' R A (hA.antipode.lTensor A (hA.comulAlgHom a)) : H) =
        (algebraMap R A (hA.counitAlgHom a) : H)
      rw [hA.coe_mul_lTensor, hA.tensorSquareMap_comulAlgHom,
        HopfAlgebra.mul_antipode_lTensor_comul_apply, Subalgebra.coe_algebraMap,
        IsScalarTower.algebraMap_apply R K H, algebraMap_counitAlgHom] }

/-- The comultiplication of a flat Hopf form maps to that of `H`. -/
@[simp]
theorem tensorSquareMap_comul (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    tensorSquareMap K A (Coalgebra.comul (R := R) x) = Coalgebra.comul (R := K) (x : H) :=
  hA.tensorSquareMap_comulAlgHom x

/-- The counit of a flat Hopf form maps to that of `H`. -/
@[simp]
theorem algebraMap_counit (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    algebraMap R K (Coalgebra.counit (R := R) x) = Coalgebra.counit (R := K) (x : H) :=
  hA.algebraMap_counitAlgHom x

/-- The antipode of a flat Hopf form is the antipode of `H`. -/
@[simp]
theorem coe_antipode (x : A) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    ((HopfAlgebra.antipode R x : A) : H) = HopfAlgebra.antipode K (x : H) :=
  hA.coe_antipode_apply x

/-! ### Base change to `K` -/

omit [Module.Flat R A] hA in
/-- An `R`-subalgebra `A` of an algebra `H` over the fraction field `K` of `R` which spans `H`
over `K` is a localization of `H`: the inclusion `A → H` is the base change of `A` to `K`. -/
theorem isBaseChange_val (hspan : Submodule.span K (A : Set H) = ⊤) :
    IsBaseChange K (A.val.toLinearMap : A →ₗ[R] H) := by
  refine (isLocalizedModule_iff_isBaseChange (nonZeroDivisors R) K _).mp
    { map_units := fun s ↦ by
        rw [← (Algebra.lsmul R (A := K) R H).commutes]
        exact (IsLocalization.map_units K s).map _
      surj := fun y ↦ ?_
      exists_of_eq := fun h ↦ ⟨1, congrArg _ (Subtype.val_injective h)⟩ }
  have hy : y ∈ Submodule.span K (A : Set H) := hspan ▸ Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem x hx => exact ⟨(⟨x, hx⟩, 1), by simp⟩
  | zero => exact ⟨(0, 1), by simp⟩
  | add x z _ _ hx hz =>
    obtain ⟨⟨a, s⟩, hs⟩ := hx
    obtain ⟨⟨b, t⟩, ht⟩ := hz
    refine ⟨((t : R) • a + (s : R) • b, s * t), ?_⟩
    simp only [AlgHom.toLinearMap_apply, Subalgebra.coe_val] at hs ht ⊢
    rw [smul_add, mul_comm, mul_smul, hs, mul_comm, mul_smul, ht]
    rfl
  | smul k x _ hx =>
    obtain ⟨⟨a, s⟩, hs⟩ := hx
    obtain ⟨⟨r, t⟩, hk⟩ := IsLocalization.surj (nonZeroDivisors R) k
    have hk' : k * algebraMap R K t = algebraMap R K r := hk
    have hs' : (s : R) • x = a := hs
    refine ⟨(r • a, t * s), ?_⟩
    have h : ((t : R) * s) • (k • x) = (k * algebraMap R K t) • ((s : R) • x) := by
      rw [← algebraMap_smul K ((t : R) * s), ← algebraMap_smul K (s : R), smul_smul, smul_smul,
        map_mul]
      congr 1
      ring
    simp only [AlgHom.toLinearMap_apply, Subalgebra.coe_val, Submonoid.smul_def,
      Submonoid.coe_mul]
    rw [h, hk', hs', algebraMap_smul]
    rfl

/-- The algebra map `K ⊗[R] A → H`, `k ⊗ a ↦ k • a`. -/
private noncomputable def baseChangeAlgHom : K ⊗[R] A →ₐ[K] H :=
  Algebra.TensorProduct.lift (Algebra.ofId K H) (A.val.restrictScalars R) fun k a ↦ by
    simp only [Algebra.ofId_apply, AlgHom.restrictScalars_apply, Subalgebra.coe_val]
    exact Algebra.commutes k (a : H)

omit [IsFractionRing R K] [Module.Flat R A] hA in
private theorem baseChangeAlgHom_tmul (k : K) (a : A) :
    baseChangeAlgHom (K := K) (A := A) (k ⊗ₜ a) = k • (a : H) := by
  rw [baseChangeAlgHom, Algebra.TensorProduct.lift_tmul, Algebra.smul_def]
  rfl

/-- **Base change of a flat Hopf form.** If a flat Hopf form `A` of `H` over `R` spans `H` over
the fraction field `K` of `R`, then `k ⊗ a ↦ k • a` is an isomorphism of bialgebras
`K ⊗[R] A ≃ H` over `K`. -/
noncomputable def baseChangeBialgEquiv (hspan : Submodule.span K (A : Set H) = ⊤) :
    letI : HopfAlgebra R A := hA.hopfAlgebra
    K ⊗[R] A ≃ₐc[K] H :=
  letI : HopfAlgebra R A := hA.hopfAlgebra
  have hbij : Function.Bijective (baseChangeAlgHom (K := K) (A := A)) := by
    have hφ : (baseChangeAlgHom (K := K) (A := A)).toLinearMap =
        (isBaseChange_val (K := K) hspan).equiv.toLinearMap :=
      TensorProduct.AlgebraTensorModule.ext fun k a ↦ by
        simp [baseChangeAlgHom_tmul, IsBaseChange.equiv_tmul]
    rw [← AlgHom.coe_toLinearMap, hφ]
    exact (isBaseChange_val (K := K) hspan).equiv.bijective
  BialgEquiv.ofAlgEquiv (AlgEquiv.ofBijective _ hbij)
    (by
      apply Algebra.TensorProduct.ext (by ext) ?_
      ext a
      simp [baseChangeAlgHom_tmul, hA.algebraMap_counit])
    (by
      apply Algebra.TensorProduct.ext (by ext) ?_
      ext a
      have h (t : A ⊗[R] A) :
          (Algebra.TensorProduct.map baseChangeAlgHom baseChangeAlgHom :
              (K ⊗[R] A) ⊗[K] (K ⊗[R] A) →ₐ[K] H ⊗[K] H)
            (TensorProduct.AlgebraTensorModule.tensorTensorTensorComm R K R K K K A A
              (((1 : K) ⊗ₜ[K] (1 : K)) ⊗ₜ[R] t)) = tensorSquareMap K A t := by
        induction t using TensorProduct.inductionOn with
        | add s t hs ht => simp only [TensorProduct.tmul_add, map_add, hs, ht]
        | tmul x y => simp [baseChangeAlgHom_tmul]
      simpa [baseChangeAlgHom_tmul] using (h _).trans (hA.tensorSquareMap_comul a))

/-- The base-change isomorphism of a flat Hopf form sends `k ⊗ a` to `k • a`. -/
@[simp]
theorem baseChangeBialgEquiv_tmul (hspan : Submodule.span K (A : Set H) = ⊤) (k : K) (a : A) :
    hA.baseChangeBialgEquiv hspan (k ⊗ₜ a) = k • (a : H) :=
  baseChangeAlgHom_tmul k a

end Subalgebra.IsHopfForm

namespace Subalgebra

variable {R K : Type*} [CommRing R] [CommRing K] [Algebra R K]

/-- **Hopf forms from generators.** The `R`-subalgebra generated by a set `s` of a Hopf algebra
`H` over `K` is a Hopf form as soon as the comultiplication, counit and antipode of each element of
`s` satisfy the defining conditions. -/
-- The comultiplication and counit conditions define `R`-subalgebras, as preimages of subalgebras
-- under algebra maps; the antipode condition is closed under products since the antipode is
-- antimultiplicative.
theorem IsHopfForm.adjoin {H : Type*} [Ring H] [HopfAlgebra K H] [Algebra R H]
    [IsScalarTower R K H] {s : Set H}
    (hcomul : ∀ x ∈ s, Coalgebra.comul (R := K) x ∈
      (tensorSquareMap K (Algebra.adjoin R s)).range)
    (hcounit : ∀ x ∈ s, Coalgebra.counit (R := K) x ∈ (⊥ : Subalgebra R K))
    (hantipode : ∀ x ∈ s, HopfAlgebra.antipode K x ∈ Algebra.adjoin R s) :
    (Algebra.adjoin R s).IsHopfForm K where
  comul_mem := Algebra.adjoin_le (S := (tensorSquareMap K (Algebra.adjoin R s)).range.comap
    ((Bialgebra.comulAlgHom K H).restrictScalars R)) hcomul
  counit_mem := Algebra.adjoin_le (S := (⊥ : Subalgebra R K).comap
    ((Bialgebra.counitAlgHom K H).restrictScalars R)) hcounit
  antipode_mem x hx := by
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact hantipode x hx
    | algebraMap r =>
      rw [IsScalarTower.algebraMap_apply R K H, ← mul_one (algebraMap K H _), ← Algebra.smul_def,
        map_smul, HopfAlgebra.antipode_one, Algebra.smul_def, mul_one,
        ← IsScalarTower.algebraMap_apply]
      exact Subalgebra.algebraMap_mem _ r
    | add x y _ _ hx hy => simpa only [map_add] using add_mem hx hy
    | mul x y _ _ hx hy =>
      simpa only [HopfAlgebra.antipode_mul_antidistrib] using mul_mem hy hx

end Subalgebra
