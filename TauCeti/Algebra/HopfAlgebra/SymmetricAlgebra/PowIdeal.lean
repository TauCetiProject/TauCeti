module

public import Mathlib.Algebra.CharP.Basic
public import TauCeti.Algebra.HopfAlgebra.HopfIdeal.Basic
public import TauCeti.Algebra.HopfAlgebra.SymmetricAlgebra.Basic
import Mathlib.Data.Nat.Choose.Dvd
import Mathlib.Data.Nat.Multiplicity
import TauCeti.Algebra.Bialgebra.Primitive

/-!
# Power Hopf ideals of a symmetric algebra

For a commutative ring `R`, an `R`-module `M`, `m : M`, and `n > 0` whose intermediate binomial
coefficients `(n.choose i : R)` (`0 < i < n`) vanish, `Ideal.span {(SymmetricAlgebra.ι R M m) ^ n}`
is a Hopf ideal of `SymmetricAlgebra R M`.

## Main declarations

* `TauCeti.SymmetricAlgebra.spanPowHopfIdeal`: the `HopfIdeal` generated by `(ι m) ^ n`.
* `TauCeti.SymmetricAlgebra.isHopfIdeal_span_pow_of_choose_eq_zero`: Mathlib's `Ideal.IsHopfIdeal`
  predicate for `Ideal.span {(ι m) ^ n}`.
* `TauCeti.SymmetricAlgebra.instIsHopfIdealSpanPowPrimePow`,
  `TauCeti.SymmetricAlgebra.instIsHopfIdealSpanPowPrime`: `Ideal.IsHopfIdeal` instances in prime
  characteristic `p` for `(ι m) ^ (p ^ r)` and `(ι m) ^ p`.
-/

public section

open scoped TensorProduct

namespace TauCeti.SymmetricAlgebra

universe u v

variable {R : Type u} [CommRing R] {M : Type v} [AddCommMonoid M] [Module R M]

/-- For `m : M`, `0 < n`, and vanishing intermediate binomial coefficients `(n.choose i : R) = 0`
(`0 < i < n`), the principal ideal generated by `(SymmetricAlgebra.ι R M m) ^ n` is a Hopf ideal
of `SymmetricAlgebra R M`. -/
@[expose] noncomputable def spanPowHopfIdeal (m : M) {n : ℕ} (hn : 0 < n)
    (hchoose : ∀ ⦃i : ℕ⦄, 0 < i → i < n → (n.choose i : R) = 0) :
    HopfIdeal R (_root_.SymmetricAlgebra R M) :=
  HopfIdeal.ofIdeal (Ideal.span {(_root_.SymmetricAlgebra.ι R M m) ^ n})
    (fun _ hy ↦ by
      obtain ⟨_, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [Bialgebra.comul_mul]
      refine Ideal.mul_mem_left _ _ ?_
      rw [TauCeti.Bialgebra.comul_pow_of_primitive_of_choose_eq_zero
        (_root_.SymmetricAlgebra.ι R M m) (_root_.SymmetricAlgebra.comul_ι R M m) hn hchoose]
      exact Ideal.add_mem _
        (Ideal.mem_sup_left
          (Ideal.tmul_mem_leftTensorIdeal R _ (Ideal.mem_span_singleton_self _) 1))
        (Ideal.mem_sup_right
          (Ideal.tmul_mem_rightTensorIdeal R _ 1 (Ideal.mem_span_singleton_self _))))
    (fun _ hy ↦ by
      obtain ⟨_, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [Bialgebra.counit_mul, Bialgebra.counit_pow, _root_.SymmetricAlgebra.counit_ι,
        zero_pow hn.ne', mul_zero])
    (fun _ hy ↦ by
      obtain ⟨_, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [HopfAlgebra.antipode_mul_distrib]
      refine Ideal.mul_mem_left _ _ ?_
      rw [← _root_.HopfAlgebra.antipodeAlgHom_apply, map_pow,
        _root_.HopfAlgebra.antipodeAlgHom_apply, _root_.SymmetricAlgebra.antipode_ι, neg_pow]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

/-- The underlying ideal of `spanPowHopfIdeal` is the principal ideal generated by `(ι m) ^ n`. -/
@[simp]
theorem spanPowHopfIdeal_toIdeal (m : M) {n : ℕ} (hn : 0 < n)
    (hchoose : ∀ ⦃i : ℕ⦄, 0 < i → i < n → (n.choose i : R) = 0) :
    (spanPowHopfIdeal (R := R) m hn hchoose).toIdeal =
      Ideal.span {(_root_.SymmetricAlgebra.ι R M m) ^ n} := rfl

/-- Mathlib's `Ideal.IsHopfIdeal` predicate for `Ideal.span {(ι m) ^ n}` when `0 < n` and all
intermediate binomial coefficients vanish in `R`. -/
theorem isHopfIdeal_span_pow_of_choose_eq_zero (m : M) {n : ℕ} (hn : 0 < n)
    (hchoose : ∀ ⦃i : ℕ⦄, 0 < i → i < n → (n.choose i : R) = 0) :
    (Ideal.span {(_root_.SymmetricAlgebra.ι R M m) ^ n}).IsHopfIdeal R :=
  HopfIdeal.instIsHopfIdeal (spanPowHopfIdeal (R := R) m hn hchoose)

/-- Over a commutative ring of prime characteristic `p`, the ideal generated by `(ι m) ^ (p ^ r)`
is a Hopf ideal of `SymmetricAlgebra R M`. -/
instance instIsHopfIdealSpanPowPrimePow (m : M) (p r : ℕ) [Fact p.Prime] [CharP R p] :
    (Ideal.span {(_root_.SymmetricAlgebra.ι R M m) ^ (p ^ r)}).IsHopfIdeal R :=
  isHopfIdeal_span_pow_of_choose_eq_zero (R := R) m
    (pow_pos (Fact.out : p.Prime).pos r) fun _ hi₀ hi ↦
      (CharP.cast_eq_zero_iff R p _).mpr ((Fact.out : p.Prime).dvd_choose_pow hi₀.ne' hi.ne)

/-- Over a commutative ring of prime characteristic `p`, the ideal generated by `(ι m) ^ p` is a
Hopf ideal of `SymmetricAlgebra R M`. -/
instance instIsHopfIdealSpanPowPrime (m : M) (p : ℕ) [Fact p.Prime] [CharP R p] :
    (Ideal.span {(_root_.SymmetricAlgebra.ι R M m) ^ p}).IsHopfIdeal R :=
  isHopfIdeal_span_pow_of_choose_eq_zero (R := R) m (Fact.out : p.Prime).pos fun _ hi₀ hi ↦
    (CharP.cast_eq_zero_iff R p _).mpr ((Fact.out : p.Prime).dvd_choose_self hi₀.ne' hi)

end TauCeti.SymmetricAlgebra
