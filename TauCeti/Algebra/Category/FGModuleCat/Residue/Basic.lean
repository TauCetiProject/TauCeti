import TauCeti.Algebra.Category.FGModuleCat.End

/-!
# The residue sequence of a local ring with principal square-zero maximal ideal

If the maximal ideal of a commutative local ring `R` is principal and generated by a nonzero
element `ε` of square zero (so that `R` is Noetherian), the sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0`,
whose first map is multiplication by `ε`, is almost split in `FGModuleCat R`. The proof uses the
extension-class criterion `TauCeti.ExactStructure.Extension.isAlmostSplit_iff_ext1_pushout`.

## Main definitions

* `TauCeti.residueFG`: the residue field as a finitely generated module.
* `TauCeti.residueMul`: multiplication by `ε` as a linear map `R/𝔪 → R`.
* `TauCeti.residueSequence`: the short complex `R/𝔪 ⟶ R ⟶ R/𝔪`.
* `TauCeti.residueExtension`: the residue sequence as a Yoneda extension for the abelian exact
  structure, with middle term, inflation and deflation computed by `residueExtension_obj`,
  `residueExtension_f` and `residueExtension_g`.

## Main results

* `TauCeti.exists_eq_smul_residueSequence_f`: every morphism `R/𝔪 ⟶ R` is a multiple of
  multiplication by `ε`.
* `TauCeti.isAlmostSplit_residueSequence`: the residue sequence is almost split.

Concrete instances for `ℤ/p²ℤ` and the dual numbers are in
`TauCeti/Examples/CategoryTheory/Exact/AlmostSplit.lean`.
-/

public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace TauCeti

section Residue

variable {R : Type u} [CommRing R] [IsLocalRing R]

variable {ε : R}

/-- Multiplication by a generator `ε` of the maximal ideal with `ε * ε = 0`, as a map from the
residue field to the ring. -/
noncomputable def residueMul (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    (R ⧸ maximalIdeal R) →ₗ[R] R :=
  (maximalIdeal R).liftQ (LinearMap.toSpanSingleton R R ε) fun x hx ↦ by
    rw [hm, Ideal.mem_span_singleton] at hx
    obtain ⟨y, rfl⟩ := hx
    simp [mul_comm ε y, mul_assoc, hε]

/-- `residueMul` sends the class of `y` to `y * ε`. -/
@[simp]
theorem residueMul_mk (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (y : R) :
    residueMul hm hε (Ideal.Quotient.mk _ y) = y * ε :=
  Submodule.liftQ_apply _ (LinearMap.toSpanSingleton R R ε) y

/-- `residueMul` sends `1` to `ε`. -/
@[simp]
theorem residueMul_one (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    residueMul hm hε 1 = ε :=
  (residueMul_mk hm hε 1).trans (one_mul ε)

private theorem residueMul_injective (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) : Function.Injective (residueMul hm hε) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [residueMul_mk] at hx
  refine Ideal.Quotient.eq_zero_iff_mem.mpr ((mem_maximalIdeal y).mpr fun hy ↦ hε₀ ?_)
  exact (hy.mul_right_eq_zero).mp hx

/-- Multiplication by `ε` and the quotient map form an exact pair, since `𝔪 = (ε)`. -/
theorem exact_residueMul (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    Function.Exact (residueMul hm hε) (Submodule.mkQ (maximalIdeal R)) := by
  intro x
  have hx : x ∈ maximalIdeal R ↔ ∃ y, y * ε = x := by rw [hm, Ideal.mem_span_singleton']
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hx]
  refine ⟨fun ⟨y, hy⟩ ↦ ⟨Ideal.Quotient.mk _ y, by rw [residueMul_mk, hy]⟩, ?_⟩
  rintro ⟨y, rfl⟩
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨y, (residueMul_mk hm hε y).symm⟩

/-- The residue field of a commutative local ring, as a finitely generated module. -/
abbrev residueFG (R : Type u) [CommRing R] [IsLocalRing R] : FGModuleCat.{u} R :=
  FGModuleCat.of R (R ⧸ maximalIdeal R)

instance : IsLocalRing (End (residueFG R)) := by
  have : IsSimpleModule R (R ⧸ maximalIdeal R) :=
    isSimpleModule_iff_isCoatom.mpr Ideal.IsMaximal.out
  have : IsLocalRing (Module.End R (R ⧸ maximalIdeal R)) :=
    .of_isUnit_or_isUnit_one_sub_self fun a ↦ (LinearMap.bijective_or_eq_zero a).elim
      (fun h ↦ .inl ((Module.End.isUnit_iff a).mpr h)) fun h ↦ .inr (by simp [h])
  -- `(residueFG R).obj` is `ModuleCat.of R (R ⧸ maximalIdeal R)`, whose carrier is
  -- `R ⧸ maximalIdeal R` by definition.
  exact FGModuleCat.isLocalRing_end_iff.mpr ‹IsLocalRing (Module.End R (R ⧸ maximalIdeal R))›

/-- The sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` of finitely generated modules, whose first map is
multiplication by a generator `ε` of the maximal ideal with `ε * ε = 0` and whose second map is the
quotient map. -/
noncomputable abbrev residueSequence (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) :
    ShortComplex (FGModuleCat.{u} R) :=
  .mk (X₁ := residueFG R) (X₂ := FGModuleCat.of R R) (X₃ := residueFG R)
    (FGModuleCat.ofHom (residueMul hm hε)) (FGModuleCat.ofHom (Submodule.mkQ (maximalIdeal R)))
    (FGModuleCat.hom_ext (LinearMap.ext (exact_residueMul hm hε).apply_apply_eq_zero))

/-- **Every morphism `R/𝔪 ⟶ R` is a multiple of multiplication by `ε`** when the maximal ideal
`𝔪` is generated by a nonzero element `ε` with `ε * ε = 0`. -/
theorem exists_eq_smul_residueSequence_f (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) (u : residueFG R ⟶ FGModuleCat.of R R) :
    ∃ y : R, u = y • (residueSequence hm hε).f := by
  -- `u` sends `1` to an element killed by `ε`, which is not a unit since `ε ≠ 0`, so it lies in
  -- `𝔪 = (ε)`.
  have hkill : ε • (1 : R ⧸ maximalIdeal R) = 0 := by
    rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem,
      hm]
    exact Ideal.mem_span_singleton_self ε
  have hx : ε * u.hom.hom 1 = 0 := by rw [← smul_eq_mul, ← map_smul, hkill, map_zero]
  have hmem : u.hom.hom 1 ∈ maximalIdeal R :=
    (mem_maximalIdeal _).2 fun hu => hε₀ (hu.mul_left_eq_zero.1 hx)
  obtain ⟨y, hy⟩ : ∃ y, y * ε = u.hom.hom 1 :=
    Ideal.mem_span_singleton'.1 (by rw [← hm]; exact hmem)
  refine ⟨y, FGModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext_ring ?_))⟩
  simpa [FGModuleCat.hom_hom_smul] using hy.symm

private theorem shortExact_residueSequence [IsNoetherianRing R] (hm : maximalIdeal R = .span {ε})
    (hε : ε * ε = 0) (hε₀ : ε ≠ 0) : (residueSequence hm hε).ShortExact := by
  refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
  · rw [← ShortComplex.exact_map_iff_of_faithful _ (forget₂ (FGModuleCat.{u} R) (ModuleCat.{u} R)),
      ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    exact exact_residueMul hm hε
  · exact ConcreteCategory.mono_of_injective _ (residueMul_injective hm hε hε₀)
  · exact ConcreteCategory.epi_of_surjective _ (Submodule.mkQ_surjective _)

/-- The residue sequence of a local ring with nonzero principal square-zero maximal ideal,
viewed as a Yoneda extension. Such a ring is Noetherian by
`TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent`, which supplies the abelian structure. -/
noncomputable def residueExtension (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (ExactStructure.abelian (FGModuleCat.{u} R)).Extension (residueFG R) (residueFG R) :=
  letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  ⟨_, (residueSequence hm hε).f, (residueSequence hm hε).g, (residueSequence hm hε).zero,
    (ExactStructure.abelian_conflation _).mpr (shortExact_residueSequence hm hε hε₀)⟩

/-- The underlying short complex of the residue extension is the residue sequence. -/
@[simp]
theorem residueExtension_shortComplex (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (residueExtension hm hε hε₀).shortComplex = residueSequence hm hε :=
  (rfl)

/-- The middle term of the residue extension is the ring itself. -/
@[simp]
theorem residueExtension_obj (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (residueExtension hm hε hε₀).obj = FGModuleCat.of R R :=
  congrArg ShortComplex.X₂ (residueExtension_shortComplex hm hε hε₀)

/-- The inflation of the residue extension is multiplication by `ε`, after transport along
`residueExtension_obj`. -/
theorem residueExtension_f (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (residueExtension hm hε hε₀).f ≫ eqToHom (residueExtension_obj hm hε hε₀) =
      (residueSequence hm hε).f := by
  simp only [residueExtension]
  exact Category.comp_id _

/-- The deflation of the residue extension is the quotient map, after transport along
`residueExtension_obj`. -/
theorem residueExtension_g (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    eqToHom (residueExtension_obj hm hε hε₀).symm ≫ (residueExtension hm hε hε₀).g =
      (residueSequence hm hε).g := by
  simp only [residueExtension]
  exact Category.id_comp _

/-- **The sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` is almost split in `FGModuleCat R`** when `𝔪` is
generated by a nonzero element `ε` with `ε * ε = 0`. -/
theorem isAlmostSplit_residueSequence (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0)
    (hε₀ : ε ≠ 0) : (residueSequence hm hε).IsAlmostSplit := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  let e := residueExtension hm hε hε₀
  have hf := residueExtension_f hm hε hε₀
  rw [← residueExtension_shortComplex hm hε hε₀]
  refine e.isAlmostSplit_iff_ext1_pushout.mpr ⟨fun h ↦ ?_, fun W v hv ↦
    (ExactStructure.Ext1.mk_pushout_eq_zero_iff e v).mpr ?_⟩
  · -- A retraction of multiplication by `ε` would send `ε ∈ 𝔪` to `1`, but `𝔪` kills `R/𝔪`.
    have := (ExactStructure.Ext1.mk_eq_zero_iff_isSplitMono e).mp h
    have : IsSplitMono (residueSequence hm hε).f := hf ▸ inferInstance
    let r : R →ₗ[R] R ⧸ maximalIdeal R := (retraction (residueSequence hm hε).f).hom.hom
    have hr : r (residueMul hm hε 1) = 1 :=
      congr($(IsSplitMono.id (residueSequence hm hε).f).hom.hom 1)
    have hkill : ε ∈ Module.annihilator R (R ⧸ maximalIdeal R) := by
      rw [Ideal.annihilator_quotient, hm]
      exact Ideal.mem_span_singleton_self ε
    rw [residueMul_one, ← mul_one ε, ← smul_eq_mul, map_smul, Module.mem_annihilator.mp hkill] at hr
    have := Ideal.Quotient.nontrivial_iff.mpr (maximalIdeal.isMaximal R).ne_top
    exact zero_ne_one hr
  · -- If `v 1 ∉ 𝔪 W`, a linear map to the residue field retracts `v`.
    have hn : v.hom.hom 1 ∈ Ideal.span {ε} • (⊤ : Submodule R W.obj) := by
      by_contra hn
      rw [← hm] at hn
      obtain ⟨r, hr⟩ := IsLocalRing.exists_linearMap_quotient_eq_one hn
      exact hv (IsSplitMono.mk' ⟨FGModuleCat.ofHom r, FGModuleCat.hom_ext
        (Submodule.linearMap_qext _ (LinearMap.ext_ring hr))⟩)
    rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists] at hn
    obtain ⟨n, -, hn⟩ := hn
    refine ⟨eqToHom (residueExtension_obj hm hε hε₀) ≫
      FGModuleCat.ofHom (LinearMap.toSpanSingleton R W n), ?_⟩
    rw [← Category.assoc, hf]
    refine FGModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext_ring ?_))
    -- Composition in `FGModuleCat` is composition of the underlying linear maps.
    have h : LinearMap.toSpanSingleton R W n (residueMul hm hε 1) = v.hom.hom 1 := by
      rw [residueMul_one, LinearMap.toSpanSingleton_apply, hn]
    exact h

end Residue

end TauCeti
