module

public import TauCeti.Algebra.Category.FGModuleCat.Residue.Basic
public import TauCeti.CategoryTheory.Exact.YonedaExt.BaerSum
import TauCeti.Algebra.Category.FGModuleCat.Projective
import TauCeti.CategoryTheory.Exact.YonedaExt.Projective

/-!
# Self-extensions over local rings with principal square-zero maximal ideal

If the maximal ideal of a commutative local ring `R` is generated by a nonzero square-zero
element `ε`, then the residue sequence `0 ⟶ R/𝔪 ⟶ R ⟶ R/𝔪 ⟶ 0` generates the Yoneda extension
module `Ext¹_R(R/𝔪, R/𝔪)`. Sending `1` to this sequence gives an `R`-linear equivalence from
`R/𝔪`.

## Main definitions and results

* `TauCeti.residueExt1Equiv`: the equivalence `R/𝔪 ≃ₗ[R] Ext¹_R(R/𝔪, R/𝔪)`.
* `TauCeti.residueExt1Equiv_mk`, `TauCeti.residueExt1Equiv_one`: it sends the class of `r` to
  `r` times the class of the residue sequence.
* `TauCeti.smul_mk_residueExtension_eq_zero_iff`: `r` kills the class of the residue sequence
  exactly when `r ∈ 𝔪`.

## Proof overview

The connecting map `Hom(R/𝔪, R/𝔪) → Ext¹_R(R/𝔪, R/𝔪)` is cobase change of the residue sequence.
Since the middle term `R` is free, `Extension.homQuotientEquivExt1OfIsProjective` identifies
`Ext¹` with the cokernel of `Hom(R, R/𝔪) → Hom(R/𝔪, R/𝔪)`, restriction along multiplication by
`ε`; its surjectivity half is `Extension.exists_mk_pushout_eq_of_isProjective`. The restriction
map is zero because `ε` kills `R/𝔪`, and evaluation at `1` identifies `Hom(R/𝔪, R/𝔪)` with
`R/𝔪`. In particular the class of the residue sequence is nonzero with annihilator `𝔪`; that
the residue sequence does not split is also part of `isAlmostSplit_residueSequence`.

The connecting map comes from the Hom–Ext exact sequence of Iyama, Nakaoka and Palu,
*Auslander–Reiten theory in extriangulated categories*, Fact 1.20(1), applied to the abelian
exact structure on finitely generated modules.
-/

public section

namespace TauCeti

open CategoryTheory ExactStructure _root_.IsLocalRing

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R]

variable (R) in
/-- Evaluation at `1` identifies the endomorphisms of the residue field with the residue field. -/
private noncomputable def residueEndEquiv :
    (residueFG R ⟶ residueFG R) ≃ₗ[R] (R ⧸ maximalIdeal R) :=
  InducedCategory.homLinearEquiv ≪≫ₗ ModuleCat.homLinearEquiv ≪≫ₗ
    LinearMap.extendScalarsOfSurjectiveEquiv Ideal.Quotient.mk_surjective ≪≫ₗ
    LinearMap.ringLmapEquivSelf (R ⧸ maximalIdeal R) R (R ⧸ maximalIdeal R)

private theorem residueEndEquiv_apply (v : residueFG R ⟶ residueFG R) :
    residueEndEquiv R v = v.hom.hom 1 :=
  rfl

variable {ε : R} (hm : maximalIdeal R = .span {ε}) (hε : ε * ε = 0) (hε₀ : ε ≠ 0)

/-- Every morphism `R ⟶ R/𝔪` vanishes on `ε`, so restriction along the inflation of the residue
extension is zero. -/
private theorem range_leftComp_residueExtension_f :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    LinearMap.range (Linear.leftComp R (residueFG R) (residueExtension hm hε hε₀).f) = ⊥ := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  have hobj := residueExtension_obj hm hε hε₀
  refine LinearMap.range_eq_bot.mpr (LinearMap.ext fun t ↦ ?_)
  have ht : (residueExtension hm hε hε₀).f ≫ t =
      ((residueExtension hm hε hε₀).f ≫ eqToHom hobj) ≫ eqToHom hobj.symm ≫ t := by
    simp
  rw [Linear.leftComp_apply, LinearMap.zero_apply, ht, residueExtension_f]
  refine FGModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext_ring ?_))
  let g : R →ₗ[R] R ⧸ maximalIdeal R := (eqToHom hobj.symm ≫ t).hom.hom
  have hkill : ε ∈ Module.annihilator R (R ⧸ maximalIdeal R) := by
    rw [Ideal.annihilator_quotient, hm]
    exact Ideal.mem_span_singleton_self ε
  have hg : g (residueMul hm hε 1) = 0 := by
    rw [residueMul_one, ← mul_one ε, ← smul_eq_mul, map_smul, Module.mem_annihilator.mp hkill]
  exact hg

private theorem isProjective_residueExtension_obj :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (ExactStructure.abelian _).isProjective (residueExtension hm hε hε₀).obj := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  rw [residueExtension_obj]
  exact (abelian_isProjective_iff _).mpr (FGModuleCat.projective_of_free R _)

/-- Multiples of the residue sequence identify the residue field with its Yoneda
self-extension module over a local ring with nonzero principal square-zero maximal ideal.
The ring is Noetherian by `TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent`. -/
noncomputable def residueExt1Equiv :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    (R ⧸ maximalIdeal R) ≃ₗ[R]
      (ExactStructure.abelian (FGModuleCat.{u} R)).Ext1 (residueFG R) (residueFG R) :=
  letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  (residueEndEquiv R).symm ≪≫ₗ
    (Submodule.quotEquivOfEqBot _ (range_leftComp_residueExtension_f hm hε hε₀)).symm ≪≫ₗ
    (residueExtension hm hε hε₀).homQuotientEquivExt1OfIsProjective
      (isProjective_residueExtension_obj hm hε hε₀) R (residueFG R)

/-- The residue sequence corresponds to `1` in the residue field. -/
@[simp]
theorem residueExt1Equiv_one :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    residueExt1Equiv hm hε hε₀ 1 = Ext1.mk (residueExtension hm hε hε₀) := by
  have := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
  have h1 : (residueEndEquiv R).symm 1 = 𝟙 (residueFG R) := by
    rw [LinearEquiv.symm_apply_eq, residueEndEquiv_apply, FGModuleCat.hom_hom_id,
      LinearMap.id_apply]
  rw [residueExt1Equiv, LinearEquiv.trans_apply, LinearEquiv.trans_apply, h1,
    Submodule.quotEquivOfEqBot_symm_apply, Extension.homQuotientEquivExt1OfIsProjective_mk,
    Ext1.pushout_id]

/-- The class of a scalar is sent to the corresponding multiple of the residue extension. -/
@[simp]
theorem residueExt1Equiv_mk (r : R) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    residueExt1Equiv hm hε hε₀ (Ideal.Quotient.mk _ r) =
      r • Ext1.mk (residueExtension hm hε hε₀) := by
  have hr : Ideal.Quotient.mk (maximalIdeal R) r = r • (1 : R ⧸ maximalIdeal R) := by
    rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq]
  rw [hr, map_smul, residueExt1Equiv_one]

/-- A scalar kills the class of the residue sequence exactly when it lies in the maximal
ideal. -/
@[simp]
theorem smul_mk_residueExtension_eq_zero_iff (r : R) :
    letI := TauCeti.IsLocalRing.isNoetherianRing_of_isNilpotent hm ⟨2, (sq ε).trans hε⟩
    r • Ext1.mk (residueExtension hm hε hε₀) = 0 ↔ r ∈ maximalIdeal R := by
  rw [← residueExt1Equiv_mk, LinearEquiv.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]

end TauCeti
