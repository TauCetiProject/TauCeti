/-!
# Loops of cyclic modules in the stable module category

Let `A` be a ring and let `a, b : A`. If the right annihilator of `a` is the right ideal `bA`,
then left multiplication by `a` and the quotient map form a short exact sequence of right
`A`-modules

```text
0 ⟶ A ⧸ bA --a·--> A ⟶ A ⧸ aA ⟶ 0
```

whose middle term is free. Hence the loop (syzygy) of `A ⧸ aA` in the stable module category
`stmod-A` is `A ⧸ bA`. When also the right annihilator of `b` is `aA` (for instance when `a, b` are
an *exact pair of zero-divisors*), the loop functor exchanges `A ⧸ aA` and `A ⧸ bA`, and both
modules are fixed by `Ω²`. This is the stable shadow of the two-periodic free resolution
`⋯ ⟶ A --b·--> A --a·--> A ⟶ A ⧸ aA`.

The basic example is the truncated polynomial ring `A = R[x] ⧸ (xⁿ)` over a commutative
Noetherian ring `R`, where for `i + j = n` the right annihilators of `xⁱ` and `xʲ` are generated by
`xʲ` and `xⁱ` (`AdjoinRoot.root_pow_mul_eq_zero_iff`); for `0 < i, j` and `R` nontrivial they are an
exact pair of zero-divisors. For the modules `Mᵢ = A ⧸ (xⁱ)` with `i ≤ n` this gives
`ΩMᵢ ≅ Mₙ₋ᵢ` and `Ω²Mᵢ ≅ Mᵢ` in `stmod-A`, while `Mₙ = A` is projective and so is zero there. Over a
field `k`, `k[x] ⧸ (xⁿ)` is a symmetric Frobenius algebra
(`AdjoinRoot.isSymmetricFrobeniusFunctional_lastCoeff_X_pow`), so `stmod-A` is triangulated by
Happel's theorem, with suspension quasi-inverse to `Ω`.

Right `A`-modules are left `Aᵐᵒᵖ`-modules. The regular right module `A` is the regular left module
`Aᵐᵒᵖ`, and the right ideal `aA` is the cyclic submodule of `Aᵐᵒᵖ` generated by `op a`.

## Main definitions

* `TauCeti.FGModuleCat.stableModuleLoop A`: the loop (syzygy) endofunctor `Ω` of `stmod-A`.
* `TauCeti.FGModuleCat.quotSpanSingleton a`: the cyclic right module `A ⧸ aA`.
* `TauCeti.FGModuleCat.quotSpanSingletonPresentation`: the projective presentation
  `A ⧸ bA ⟶ A ⟶ A ⧸ aA` when the right annihilator of `a` is `bA`.
* `TauCeti.FGModuleCat.stableModuleLoopQuotSpanSingletonIso`: `Ω(A ⧸ aA) ≅ A ⧸ bA`.
* `TauCeti.FGModuleCat.stableModuleLoopLoopQuotSpanSingletonIso`: `Ω²(A ⧸ aA) ≅ A ⧸ aA` when the
  right annihilators of `a` and `b` are `bA` and `aA`.
* `TauCeti.FGModuleCat.stableModuleLoopQuotSpanSingletonRootPowIso` and
  `TauCeti.FGModuleCat.stableModuleLoopLoopQuotSpanSingletonRootPowIso`: `ΩMᵢ ≅ Mₙ₋ᵢ` and
  `Ω²Mᵢ ≅ Mᵢ` over `R[x] ⧸ (xⁿ)`.

## Main results

* `TauCeti.FGModuleCat.isZero_stableModuleFunctor_obj_quotSpanSingleton_zero`: `A ⧸ 0A ≅ A` is
  zero in the stable module category; in particular so is `Mₙ` over `R[x] ⧸ (xⁿ)`
  (`TauCeti.FGModuleCat.isZero_stableModuleFunctor_obj_quotSpanSingleton_root_pow_self`).

## References

* Dieter Happel, *Triangulated Categories in the Representation Theory of Finite Dimensional
  Algebras*, Chapter I, Section 2, for the loop functor on a stable category.
* Ragnar-Olaf Buchweitz, *Maximal Cohen–Macaulay Modules and Tate Cohomology*, Section 4.
* I. B. Henriques and L. M. Sega, *Free resolutions over short Gorenstein local rings*,
  Mathematische Zeitschrift **267** (2011), 645–663, for exact pairs of zero-divisors and their
  periodic resolutions.
-/

public section

namespace TauCeti

open CategoryTheory MulOpposite Polynomial

universe u

namespace FGModuleCat

variable {A : Type u} [Ring A]

/-- The cyclic right `A`-module `A ⧸ aA`. As a left `Aᵐᵒᵖ`-module it is the quotient of the regular
module `Aᵐᵒᵖ` by the cyclic submodule generated by `op a`, whose elements are the `op (a * t)`. -/
noncomputable abbrev quotSpanSingleton (a : A) : FGModuleCat.{u} Aᵐᵒᵖ :=
  FGModuleCat.of Aᵐᵒᵖ (Aᵐᵒᵖ ⧸ Submodule.span Aᵐᵒᵖ {op a})

variable [IsNoetherianRing Aᵐᵒᵖ] {a b : A}

variable (A) in
/-- The **loop functor** `Ω` on the stable module category of finitely generated right `A`-modules.
It sends the class of `M` to the class of the kernel of a surjection onto `M` from a finitely
generated projective module. This kernel is well defined up to canonical isomorphism in the stable
category, and any choice of such a surjection represents it
(`ExactStructure.EnoughProjectives.projectiveStableIsoLoopObj`). -/
noncomputable abbrev stableModuleLoop : stableModuleCategory A ⥤ stableModuleCategory A :=
  (ExactStructure.abelian_enoughProjectives (A := FGModuleCat.{u} Aᵐᵒᵖ)).stableLoop

/-- When the right annihilator of `a` is the right ideal `bA`, left multiplication by `a` and the
quotient map form a projective presentation `A ⧸ bA ⟶ A ⟶ A ⧸ aA` of the cyclic right module
`A ⧸ aA`, whose middle term is the free module `A`. -/
@[expose]
noncomputable def quotSpanSingletonPresentation (hra : ∀ s : A, a * s = 0 ↔ ∃ t, b * t = s) :
    (ExactStructure.abelian (FGModuleCat.{u} Aᵐᵒᵖ)).ProjectivePresentation
      (quotSpanSingleton a) :=
  -- Under `op`, left multiplication by `a` on `A` is right multiplication by `op a` on `Aᵐᵒᵖ`,
  -- whose kernel is the right annihilator `bA` of `a` and whose range is `aA`.
  let μ : Aᵐᵒᵖ →ₗ[Aᵐᵒᵖ] Aᵐᵒᵖ := LinearMap.toSpanSingleton Aᵐᵒᵖ Aᵐᵒᵖ (op a)
  have hker : Submodule.span Aᵐᵒᵖ {op b} = LinearMap.ker μ :=
    span_singleton_op_eq_ker_toSpanSingleton_iff.mpr hra
  let i := (Submodule.span Aᵐᵒᵖ {op b}).liftQ μ hker.le
  let p := (Submodule.span Aᵐᵒᵖ {op a}).mkQ
  have hexact : Function.Exact i p := LinearMap.exact_iff.mpr <| by
    rw [Submodule.ker_mkQ, Submodule.range_liftQ, LinearMap.range_toSpanSingleton]
  { K := quotSpanSingleton b
    P := FGModuleCat.of Aᵐᵒᵖ Aᵐᵒᵖ
    i := FGModuleCat.ofHom i
    p := FGModuleCat.ofHom p
    zero := FGModuleCat.hom_ext hexact.linearMap_comp_eq_zero
    conflation := by
      rw [ExactStructure.abelian_conflation]
      exact
        { exact := (ShortComplex.exact_map_iff_of_faithful _
            (forget₂ (FGModuleCat.{u} Aᵐᵒᵖ) (ModuleCat.{u} Aᵐᵒᵖ))).mp
              ((ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mpr hexact)
          mono_f := ConcreteCategory.mono_of_injective _
            (LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot' _ μ hker))
          epi_g := ConcreteCategory.epi_of_surjective _ (Submodule.mkQ_surjective _) }
    isProjective := by
      rw [ExactStructure.abelian_isProjective_iff]
      exact FGModuleCat.projective_of_free Aᵐᵒᵖ (FGModuleCat.of Aᵐᵒᵖ Aᵐᵒᵖ) }

variable (hra : ∀ s : A, a * s = 0 ↔ ∃ t, b * t = s)

/-- The kernel term of `quotSpanSingletonPresentation` is `A ⧸ bA`. -/
@[simp]
theorem quotSpanSingletonPresentation_K :
    (quotSpanSingletonPresentation hra).K = quotSpanSingleton b :=
  (rfl)

/-- The projective term of `quotSpanSingletonPresentation` is the free module `A`. -/
@[simp]
theorem quotSpanSingletonPresentation_P :
    (quotSpanSingletonPresentation hra).P = FGModuleCat.of Aᵐᵒᵖ Aᵐᵒᵖ :=
  (rfl)

/-- The inflation of `quotSpanSingletonPresentation` is left multiplication by `a`: it sends the
class of `t` in `A ⧸ bA` to `a * t`. -/
@[simp]
theorem quotSpanSingletonPresentation_i_apply (t : A) :
    (quotSpanSingletonPresentation hra).i (Submodule.Quotient.mk (op t)) = op (a * t) :=
  -- The categorical hom `FGModuleCat.ofHom (liftQ ..)` is applied as the underlying linear map,
  -- which by definition sends `op t` to `op t • op a = op (a * t)`.
  (Submodule.liftQ_apply _ _ (op t)).trans <|
    (LinearMap.toSpanSingleton_apply Aᵐᵒᵖ Aᵐᵒᵖ (op a) (op t)).trans (op_mul a t).symm

/-- The deflation of `quotSpanSingletonPresentation` is the quotient map `A ⟶ A ⧸ aA`. -/
@[simp]
theorem quotSpanSingletonPresentation_p_apply (r : Aᵐᵒᵖ) :
    (quotSpanSingletonPresentation hra).p r = Submodule.Quotient.mk r :=
  Submodule.mkQ_apply _ r

/-- **The loop of a cyclic module.** When the right annihilator of `a` is the right ideal `bA`, the
loop of `A ⧸ aA` in the stable module category is `A ⧸ bA`. -/
noncomputable def stableModuleLoopQuotSpanSingletonIso :
    (stableModuleLoop A).obj ((stableModuleFunctor A).obj (quotSpanSingleton a)) ≅
      (stableModuleFunctor A).obj (quotSpanSingleton b) :=
  eqToIso (ExactStructure.EnoughProjectives.stableLoop_obj_projectiveStableFunctor_obj _ _) ≪≫
    (ExactStructure.EnoughProjectives.projectiveStableIsoLoopObj _
      (quotSpanSingletonPresentation hra)).symm

/-- The comparison `Ω(A ⧸ aA) ⟶ A ⧸ bA` is induced by the identity of `A ⧸ aA`, as the map from the
kernel of the chosen presentation to the kernel `A ⧸ bA` of `quotSpanSingletonPresentation`. -/
@[simp]
theorem stableModuleLoopQuotSpanSingletonIso_hom :
    (stableModuleLoopQuotSpanSingletonIso hra).hom =
      eqToHom (ExactStructure.EnoughProjectives.stableLoop_obj_projectiveStableFunctor_obj _ _) ≫
        (stableModuleFunctor A).map
          ((ExactStructure.abelian_enoughProjectives.projectivePresentation
            (quotSpanSingleton a)).kernelMap (quotSpanSingletonPresentation hra) (𝟙 _)) :=
  congrArg (eqToHom _ ≫ ·) (ExactStructure.EnoughProjectives.projectiveStableIsoLoopObj_inv _ _)

/-- The comparison `A ⧸ bA ⟶ Ω(A ⧸ aA)` is induced by the identity of `A ⧸ aA`, as the map from the
kernel `A ⧸ bA` of `quotSpanSingletonPresentation` to the kernel of the chosen presentation. -/
@[simp]
theorem stableModuleLoopQuotSpanSingletonIso_inv :
    (stableModuleLoopQuotSpanSingletonIso hra).inv =
      (stableModuleFunctor A).map
          ((quotSpanSingletonPresentation hra).kernelMap
            (ExactStructure.abelian_enoughProjectives.projectivePresentation
              (quotSpanSingleton a)) (𝟙 _)) ≫
        eqToHom (ExactStructure.EnoughProjectives.stableLoop_obj_projectiveStableFunctor_obj
          _ _).symm :=
  congrArg (· ≫ eqToHom _) (ExactStructure.EnoughProjectives.projectiveStableIsoLoopObj_hom _ _)

/-- **Two-periodicity of the loops of a cyclic module.** When the right annihilators of `a` and `b`
are `bA` and `aA` (for instance for an exact pair of zero-divisors `a, b`), the module `A ⧸ aA` is
isomorphic to its second loop `Ω²(A ⧸ aA)` in the stable module category. -/
noncomputable def stableModuleLoopLoopQuotSpanSingletonIso
    (hrb : ∀ s : A, b * s = 0 ↔ ∃ t, a * t = s) :
    (stableModuleLoop A).obj
        ((stableModuleLoop A).obj ((stableModuleFunctor A).obj (quotSpanSingleton a))) ≅
      (stableModuleFunctor A).obj (quotSpanSingleton a) :=
  (stableModuleLoop A).mapIso (stableModuleLoopQuotSpanSingletonIso hra) ≪≫
    stableModuleLoopQuotSpanSingletonIso hrb

/-- `Ω²(A ⧸ aA) ≅ A ⧸ aA` is `Ω` of the comparison `Ω(A ⧸ aA) ≅ A ⧸ bA` followed by the comparison
`Ω(A ⧸ bA) ≅ A ⧸ aA`. -/
@[simp]
theorem stableModuleLoopLoopQuotSpanSingletonIso_def
    (hrb : ∀ s : A, b * s = 0 ↔ ∃ t, a * t = s) :
    stableModuleLoopLoopQuotSpanSingletonIso hra hrb =
      (stableModuleLoop A).mapIso (stableModuleLoopQuotSpanSingletonIso hra) ≪≫
        stableModuleLoopQuotSpanSingletonIso hrb :=
  (rfl)

variable (A) in
/-- The module `A ⧸ 0A`, which is isomorphic to the free module `A`, is zero in the stable module
category. -/
theorem isZero_stableModuleFunctor_obj_quotSpanSingleton_zero :
    Limits.IsZero ((stableModuleFunctor A).obj (quotSpanSingleton (0 : A))) := by
  rw [FGModuleCat.isZero_stableModuleFunctor_obj_iff]
  have : Module.Free Aᵐᵒᵖ (quotSpanSingleton (0 : A)) := .of_equiv
    (Submodule.quotEquivOfEqBot _ (by rw [op_zero, Submodule.span_singleton_eq_bot])).symm
  exact FGModuleCat.projective_of_free Aᵐᵒᵖ _

section RootPow

variable {R : Type u} [CommRing R] [IsNoetherianRing R] {n i j : ℕ}

/-- **Loops over the truncated polynomial ring.** Over `A = R[x] ⧸ (xⁿ)`, for `i + j = n` the loop
of the cyclic module `A ⧸ (xⁱ)` in `stmod-A` is `A ⧸ (xʲ)`. -/
noncomputable def stableModuleLoopQuotSpanSingletonRootPowIso (h : i + j = n) :
    (stableModuleLoop (AdjoinRoot (X ^ n : R[X]))).obj
        ((stableModuleFunctor _).obj (quotSpanSingleton (AdjoinRoot.root (X ^ n : R[X]) ^ i))) ≅
      (stableModuleFunctor _).obj (quotSpanSingleton (AdjoinRoot.root (X ^ n : R[X]) ^ j)) :=
  stableModuleLoopQuotSpanSingletonIso (AdjoinRoot.root_pow_mul_eq_zero_iff h)

/-- `ΩMᵢ ≅ Mₙ₋ᵢ` is the comparison `stableModuleLoopQuotSpanSingletonIso` for `xⁱ` and `xʲ`. -/
@[simp]
theorem stableModuleLoopQuotSpanSingletonRootPowIso_def (h : i + j = n) :
    stableModuleLoopQuotSpanSingletonRootPowIso (R := R) h =
      stableModuleLoopQuotSpanSingletonIso (A := AdjoinRoot (X ^ n : R[X]))
        (AdjoinRoot.root_pow_mul_eq_zero_iff h) :=
  (rfl)

/-- **Two-periodicity over the truncated polynomial ring.** Over `A = R[x] ⧸ (xⁿ)`, for `i ≤ n` the
cyclic module `A ⧸ (xⁱ)` is isomorphic in `stmod-A` to its second loop. -/
noncomputable def stableModuleLoopLoopQuotSpanSingletonRootPowIso (hi : i ≤ n) :
    (stableModuleLoop (AdjoinRoot (X ^ n : R[X]))).obj ((stableModuleLoop _).obj
        ((stableModuleFunctor _).obj (quotSpanSingleton (AdjoinRoot.root (X ^ n : R[X]) ^ i)))) ≅
      (stableModuleFunctor _).obj (quotSpanSingleton (AdjoinRoot.root (X ^ n : R[X]) ^ i)) :=
  stableModuleLoopLoopQuotSpanSingletonIso
    (AdjoinRoot.root_pow_mul_eq_zero_iff (Nat.add_sub_cancel' hi))
    (AdjoinRoot.root_pow_mul_eq_zero_iff (Nat.sub_add_cancel hi))

/-- `Ω²Mᵢ ≅ Mᵢ` is the two-periodicity isomorphism `stableModuleLoopLoopQuotSpanSingletonIso` for
`xⁱ` and `xⁿ⁻ⁱ`. -/
@[simp]
theorem stableModuleLoopLoopQuotSpanSingletonRootPowIso_def (hi : i ≤ n) :
    stableModuleLoopLoopQuotSpanSingletonRootPowIso (R := R) hi =
      stableModuleLoopLoopQuotSpanSingletonIso (A := AdjoinRoot (X ^ n : R[X]))
        (AdjoinRoot.root_pow_mul_eq_zero_iff (Nat.add_sub_cancel' hi))
        (AdjoinRoot.root_pow_mul_eq_zero_iff (Nat.sub_add_cancel hi)) :=
  (rfl)

variable (R n) in
/-- Over `A = R[x] ⧸ (xⁿ)`, the cyclic module `A ⧸ (xⁿ) = A` is zero in `stmod-A`. -/
theorem isZero_stableModuleFunctor_obj_quotSpanSingleton_root_pow_self :
    Limits.IsZero ((stableModuleFunctor _).obj
      (quotSpanSingleton (AdjoinRoot.root (X ^ n : R[X]) ^ n))) := by
  rw [← AdjoinRoot.mk_X, ← map_pow, AdjoinRoot.mk_self]
  exact isZero_stableModuleFunctor_obj_quotSpanSingleton_zero _

end RootPow

end FGModuleCat

end TauCeti
