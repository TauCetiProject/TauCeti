module

public import TauCeti.Algebra.Category.FGModuleCat.Generator
public import TauCeti.Algebra.Category.FGModuleCat.Projective
public import TauCeti.Algebra.Module.Generator
public import TauCeti.CategoryTheory.Adjunction.Additive
public import TauCeti.CategoryTheory.Functor.RingEquivEnd

/-!
# The regular module under an equivalence of finitely generated modules

An equivalence `e : FGModuleCat A ≌ FGModuleCat B` carries the regular module `A` to a progenerator
of `B`: it is finitely generated by construction, projective by
`CategoryTheory.Equivalence.moduleProjective_functor_obj_regular`, and a generator by the result
below. If `e` is `R`-linear, the endomorphism algebra of the regular module is also carried along,
so `A` is recovered as the opposite endomorphism algebra of the image.

## Main definitions

* `CategoryTheory.Equivalence.moduleEndRegularAlgEquiv`: the identification of the endomorphism
  algebra of the regular module with that of its image.
* `CategoryTheory.Equivalence.algEquivMulOppositeModuleEndRegular`: `A` is the opposite endomorphism
  algebra of the image of its regular module.

## Main results

* `CategoryTheory.Equivalence.isGenerator_functor_obj_regular`: the image of the regular module is a
  generator.

## References

* F. W. Anderson, K. R. Fuller, *Rings and Categories of Modules*, 2nd ed., GTM 13, Springer (1992),
  §22.
* M. Auslander, I. Reiten, S. O. Smalø, *Representation Theory of Artin Algebras*, Cambridge Studies
  in Advanced Mathematics 36 (1995), §II.2.
-/

public section

open CategoryTheory
open scoped ModuleCat.Algebra

universe u

namespace CategoryTheory.Equivalence

open TauCeti

variable {A B : Type u} [Ring A] [Ring B] (e : FGModuleCat.{u} A ≌ FGModuleCat.{u} B)

/-- An equivalence between the categories of finitely generated modules carries the regular module
to a generator. -/
theorem isGenerator_functor_obj_regular :
    Module.IsGenerator B (e.functor.obj (FGModuleCat.of A A)) := by
  -- A proper trace ideal `T` would make `B ⟶ B ⧸ T` a nonzero morphism killed by every map out of
  -- the image of the regular module, which is a separator because the regular module is one.
  rw [Module.isGenerator_iff_iSup_range_eq_top]
  set P := e.functor.obj (FGModuleCat.of A A)
  set T : Submodule B B := ⨆ φ : P →ₗ[B] B, LinearMap.range φ
  let π : FGModuleCat.of B B ⟶ FGModuleCat.of B (B ⧸ T) := FGModuleCat.ofHom T.mkQ
  have hπ : ∀ ψ : P ⟶ FGModuleCat.of B B, ψ ≫ π = 0 := fun ψ ↦ by
    ext x
    refine (Submodule.Quotient.mk_eq_zero T).mpr ?_
    exact Submodule.mem_iSup_of_mem ψ.hom.hom ⟨x, rfl⟩
  have hπ₀ : π = 0 :=
    (Preadditive.isSeparator_iff _).mp ((FGModuleCat.isSeparator A).of_equivalence e) π hπ
  have hmk : T.mkQ = 0 := by simpa [π] using congr(($hπ₀).hom.hom)
  rw [← Submodule.ker_mkQ T, hmk, LinearMap.ker_zero]

variable (R : Type*) [CommSemiring R] [Algebra R A] [Algebra R B] [e.functor.Linear R]

/-- An `R`-linear equivalence between the categories of finitely generated modules identifies the
endomorphism algebra of the regular module with that of its image. -/
noncomputable def moduleEndRegularAlgEquiv :
    Module.End A A ≃ₐ[R] Module.End B (e.functor.obj (FGModuleCat.of A A)) :=
  -- Transport along `ModuleCat.endRingEquiv`, the inclusion of `FGModuleCat` and `e` itself.
  AlgEquiv.ofRingEquiv (f := (ModuleCat.endRingEquiv (ModuleCat.of A A)).symm.trans
    ((((ObjectProperty.fullyFaithfulι _).ringEquivEnd (FGModuleCat.of A A)).symm.trans
      (e.fullyFaithfulFunctor.ringEquivEnd (FGModuleCat.of A A))).trans
    (((ObjectProperty.fullyFaithfulι _).ringEquivEnd _).trans (ModuleCat.endRingEquiv _))))
    fun r ↦ by
      have h : FGModuleCat.ofHom (algebraMap R (Module.End A A) r) =
          r • 𝟙 (FGModuleCat.of A A) := by
        ext
        exact (Module.algebraMap_end_apply R A A r 1).trans (algebraMap_smul A r (1 : A)).symm
      simp only [RingEquiv.trans_apply, ModuleCat.endRingEquiv_apply,
        Functor.FullyFaithful.ringEquivEnd_apply_asHom]
      rw [Functor.FullyFaithful.ringEquivEnd_symm_apply_asHom]
      -- The preimage under the inclusion of `FGModuleCat` is `FGModuleCat.ofHom` by definition.
      change (e.functor.map (FGModuleCat.ofHom (algebraMap R (Module.End A A) r))).hom.hom = _
      rw [h, Functor.map_smul, e.functor.map_id]
      ext x
      exact (Module.algebraMap_end_apply R B _ r x).symm

@[simp]
theorem moduleEndRegularAlgEquiv_apply (f : Module.End A A) :
    e.moduleEndRegularAlgEquiv R f = (e.functor.map (FGModuleCat.ofHom f)).hom.hom := by
  simp only [moduleEndRegularAlgEquiv, AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply,
    ModuleCat.endRingEquiv_apply, Functor.FullyFaithful.ringEquivEnd_apply_asHom]
  rw [Functor.FullyFaithful.ringEquivEnd_symm_apply_asHom]
  rfl

@[simp]
theorem moduleEndRegularAlgEquiv_symm_apply
    (g : Module.End B (e.functor.obj (FGModuleCat.of A A))) :
    (e.moduleEndRegularAlgEquiv R).symm g = (e.functor.preimage (FGModuleCat.ofHom g)).hom.hom := by
  rw [AlgEquiv.symm_apply_eq, moduleEndRegularAlgEquiv_apply]
  exact congrArg (fun φ : e.functor.obj (FGModuleCat.of A A) ⟶ _ ↦ φ.hom.hom)
    (e.functor.map_preimage (FGModuleCat.ofHom g)).symm

/-- An `R`-linear equivalence between the categories of finitely generated modules exhibits `A` as
the opposite endomorphism algebra of the image of its regular module. -/
noncomputable def algEquivMulOppositeModuleEndRegular :
    A ≃ₐ[R] (Module.End B (e.functor.obj (FGModuleCat.of A A)))ᵐᵒᵖ :=
  (AlgEquiv.opOp R A).trans (AlgEquiv.op ((AlgEquiv.moduleEndSelf R).trans
    (e.moduleEndRegularAlgEquiv R)))

@[simp]
theorem unop_algEquivMulOppositeModuleEndRegular_apply (a : A) :
    MulOpposite.unop (e.algEquivMulOppositeModuleEndRegular R a) =
      e.moduleEndRegularAlgEquiv R (AlgEquiv.moduleEndSelf R (MulOpposite.op a)) :=
  (rfl)

@[simp]
theorem algEquivMulOppositeModuleEndRegular_symm_apply
    (g : (Module.End B (e.functor.obj (FGModuleCat.of A A)))ᵐᵒᵖ) :
    (e.algEquivMulOppositeModuleEndRegular R).symm g =
      (e.moduleEndRegularAlgEquiv R).symm (MulOpposite.unop g) 1 :=
  (rfl)

end CategoryTheory.Equivalence
