module

public import Mathlib.Algebra.Category.ModuleCat.Monoidal.Symmetric
public import Mathlib.CategoryTheory.Monoidal.Preadditive
public import Mathlib.RingTheory.GradedAlgebra.Basic
public import Mathlib.CategoryTheory.Monoidal.Transport
public import TauCeti.Algebra.Category.GradedModuleCat.Basic
public import TauCeti.Algebra.Module.GradedModule.TensorProduct.GradedBase

/-!
# The symmetric monoidal category of graded modules over a graded commutative ring

Let `A` be a commutative `k`-algebra graded by `𝒜 : ℤ → Submodule k A`. Graded `𝒜`-modules
form a symmetric monoidal category under the tensor product over `A`, with unit the regular
module `A`. The tensor product `M ⊗[A] N` carries the total-degree grading
`InternalGrading.tensorProductOver`, generated by the pure tensors `m ⊗ₜ n` of homogeneous
elements, with `|m ⊗ₜ n| = |m| + |n|`. The associator, unitors and symmetry are those of
`ModuleCat A`; each preserves degree.

The symmetry sends `m ⊗ₜ n` to `n ⊗ₜ m` with no Koszul sign, whatever the degrees of `m` and
`n`. This is the convention for gradings that record a quantum or internal degree rather than a
cohomological one, such as the grading of a ring of symmetric polynomials and of the state spaces
and hom-modules built over it.

The coherence laws are inherited from `ModuleCat A` along the faithful forgetful functor
`GradedModuleCat.toModuleCat`, using Mathlib's `CategoryTheory.Monoidal.induced` and
`CategoryTheory.BraidedCategory.ofFaithful` as for `CoalgCat`. The forgetful functor is therefore
a braided monoidal functor, whose tensor comparison is the identity of `M ⊗[A] N`. No finiteness,
flatness or field hypothesis is imposed.

## Main definitions

* The `MonoidalCategory`, `BraidedCategory` and `SymmetricCategory` instances on
  `TauCeti.GradedModuleCat 𝒜`.
* `TauCeti.GradedModuleCat.tensorLift`: the morphism out of `M ⊗ N` induced by a bilinear map.
* `TauCeti.GradedModuleCat.tensorShiftIso`: the comparison `M{a} ⊗ N{b} ≅ (M ⊗ N){a + b}`.

## Main results

* `TauCeti.GradedModuleCat.tensorObj_grading`: the grading of `M ⊗ N` is the total-degree grading.
* `TauCeti.GradedModuleCat.braiding_hom_tmul`: the symmetry is the unsigned swap.
* `TauCeti.GradedModuleCat.tensorLift` and `TauCeti.GradedModuleCat.eq_tensorLift`: morphisms out
  of `M ⊗ N` are the bilinear maps adding degrees on homogeneous elements.
* `TauCeti.GradedModuleCat.tensorShiftIso`: the natural comparison `M{a} ⊗ N{b} ≅ (M ⊗ N){a + b}`.
* `TauCeti.GradedModuleCat.toModuleCat_μ` and `TauCeti.GradedModuleCat.toModuleCat_ε`: the
  forgetful functor to `ModuleCat A` is strictly monoidal on underlying modules.

## References

* C. Năstăsescu and F. Van Oystaeyen, *Methods of Graded Rings*, Lecture Notes in Mathematics
  1836, Chapter 2.
-/

public section

universe uk u

open CategoryTheory MonoidalCategory TensorProduct

namespace TauCeti.GradedModuleCat

variable {k : Type uk} {A : Type u} [CommRing k] [CommRing A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜]

section Struct

/-- The tensor product over `A`, with the total-degree grading, together with the regular module
as unit and the associator and unitors of `ModuleCat A`. -/
noncomputable instance instMonoidalCategoryStruct :
    MonoidalCategoryStruct (GradedModuleCat.{u} 𝒜) where
  tensorObj M N :=
    { carrier := M ⊗[A] N
      grading := M.grading.tensorProductOver 𝒜 N.grading }
  whiskerLeft M _ _ f := ofHom (f.hom.lTensor M) <|
    (LinearMap.isHomogeneous_id M.grading.piece).tensorProductOver_zero 𝒜 f.isHomogeneous
  whiskerRight f N := ofHom (f.hom.rTensor N) <|
    f.isHomogeneous.tensorProductOver_zero 𝒜 (LinearMap.isHomogeneous_id N.grading.piece)
  tensorHom f g := ofHom (TensorProduct.map f.hom g.hom) <|
    f.isHomogeneous.tensorProductOver_zero 𝒜 g.isHomogeneous
  tensorUnit := regular
  associator M N P := isoMk (TensorProduct.assoc A M N P) fun p x ↦
    (LinearMap.IsHomogeneous.linearEquiv_mem_piece_iff
      (M.grading.isHomogeneous_assoc_tensorProductOver 𝒜 N.grading P.grading) p x).symm
  leftUnitor M := isoMk (TensorProduct.lid A M) fun p x ↦
    (LinearMap.IsHomogeneous.linearEquiv_mem_piece_iff
      (M.grading.isHomogeneous_lid_tensorProductOver 𝒜) p x).symm
  rightUnitor M := isoMk (TensorProduct.rid A M) fun p x ↦
    (LinearMap.IsHomogeneous.linearEquiv_mem_piece_iff
      (M.grading.isHomogeneous_rid_tensorProductOver 𝒜) p x).symm

variable (M N P : GradedModuleCat.{u} 𝒜)

/-- The grading of `M ⊗ N` is the total-degree grading of the tensor product over `A`. -/
@[simp]
theorem tensorObj_grading :
    (M ⊗ N).grading = M.grading.tensorProductOver 𝒜 N.grading :=
  (rfl)

/-- The tensor unit is the regular graded module. -/
theorem tensorUnit_eq : 𝟙_ (GradedModuleCat.{u} 𝒜) = regular :=
  (rfl)

variable {M N P} {M' N' : GradedModuleCat.{u} 𝒜}

/-- The underlying map of `f ⊗ₘ g` is the tensor product of the underlying maps. -/
theorem tensorHom_hom (f : M ⟶ M') (g : N ⟶ N') :
    (f ⊗ₘ g).hom = TensorProduct.map f.hom g.hom :=
  (rfl)

theorem whiskerLeft_hom (f : N ⟶ N') : (M ◁ f).hom = f.hom.lTensor M :=
  (rfl)

theorem whiskerRight_hom (f : M ⟶ M') : (f ▷ N).hom = f.hom.rTensor N :=
  (rfl)

/-- The underlying map of the associator is `TensorProduct.assoc`. -/
theorem associator_hom_hom :
    (α_ M N P).hom.hom = (TensorProduct.assoc A M N P).toLinearMap :=
  (rfl)

theorem associator_inv_hom :
    (α_ M N P).inv.hom = (TensorProduct.assoc A M N P).symm.toLinearMap :=
  (rfl)

/-- The underlying map of the left unitor is `TensorProduct.lid`. -/
theorem leftUnitor_hom_hom : (λ_ M).hom.hom = (TensorProduct.lid A M).toLinearMap :=
  (rfl)

theorem leftUnitor_inv_hom : (λ_ M).inv.hom = (TensorProduct.lid A M).symm.toLinearMap :=
  (rfl)

/-- The underlying map of the right unitor is `TensorProduct.rid`. -/
theorem rightUnitor_hom_hom : (ρ_ M).hom.hom = (TensorProduct.rid A M).toLinearMap :=
  (rfl)

theorem rightUnitor_inv_hom : (ρ_ M).inv.hom = (TensorProduct.rid A M).symm.toLinearMap :=
  (rfl)

@[simp]
theorem tensorHom_tmul (f : M ⟶ M') (g : N ⟶ N') (m : M) (n : N) :
    (f ⊗ₘ g).hom (m ⊗ₜ[A] n) = f.hom m ⊗ₜ g.hom n :=
  (rfl)

@[simp]
theorem whiskerLeft_tmul (f : N ⟶ N') (m : M) (n : N) :
    (M ◁ f).hom (m ⊗ₜ[A] n) = m ⊗ₜ f.hom n :=
  (rfl)

@[simp]
theorem whiskerRight_tmul (f : M ⟶ M') (m : M) (n : N) :
    (f ▷ N).hom (m ⊗ₜ[A] n) = f.hom m ⊗ₜ n :=
  (rfl)

@[simp]
theorem associator_hom_tmul (m : M) (n : N) (p : P) :
    (α_ M N P).hom.hom ((m ⊗ₜ[A] n) ⊗ₜ[A] p) = m ⊗ₜ (n ⊗ₜ p) :=
  (rfl)

@[simp]
theorem associator_inv_tmul (m : M) (n : N) (p : P) :
    (α_ M N P).inv.hom (m ⊗ₜ[A] (n ⊗ₜ[A] p)) = (m ⊗ₜ n) ⊗ₜ p :=
  (rfl)

@[simp]
theorem leftUnitor_hom_tmul (a : A) (m : M) :
    (λ_ M).hom.hom (a ⊗ₜ[A] m) = a • m :=
  (rfl)

@[simp]
theorem leftUnitor_inv_apply (m : M) : (λ_ M).inv.hom m = (1 : A) ⊗ₜ[A] m :=
  (rfl)

@[simp]
theorem rightUnitor_hom_tmul (m : M) (a : A) :
    (ρ_ M).hom.hom (m ⊗ₜ[A] a) = a • m :=
  (rfl)

@[simp]
theorem rightUnitor_inv_apply (m : M) : (ρ_ M).inv.hom m = m ⊗ₜ[A] (1 : A) :=
  (rfl)

end Struct

/-- The data inducing the monoidal structure along the forgetful functor to `ModuleCat A`: on
underlying modules every operation is the corresponding one of `ModuleCat A`, so both
comparison isomorphisms are identities. -/
noncomputable def inducingFunctorData :
    Monoidal.InducingFunctorData (toModuleCat (𝒜 := 𝒜)) where
  μIso _ _ := Iso.refl _
  whiskerLeft_eq _ _ _ _ := by ext; rfl
  whiskerRight_eq _ _ := by ext; rfl
  tensorHom_eq _ _ := by ext; rfl
  εIso := Iso.refl _
  associator_eq _ _ _ :=
    ModuleCat.hom_ext <| TensorProduct.ext <| TensorProduct.ext <| by ext; rfl
  leftUnitor_eq _ := ModuleCat.hom_ext <| TensorProduct.ext <| by ext; rfl
  rightUnitor_eq _ := ModuleCat.hom_ext <| TensorProduct.ext <| by ext; rfl

/-- Graded `𝒜`-modules form a monoidal category under the tensor product over `A`, with the
total-degree grading. -/
noncomputable instance instMonoidalCategory : MonoidalCategory (GradedModuleCat.{u} 𝒜) :=
  Monoidal.induced toModuleCat inducingFunctorData

/-- The forgetful functor to `ModuleCat A` is monoidal. -/
noncomputable instance : (toModuleCat (𝒜 := 𝒜)).Monoidal :=
  Monoidal.fromInducedMonoidal toModuleCat inducingFunctorData

/-- The tensor comparison of the forgetful functor is the identity of `M ⊗[A] N`. -/
@[simp]
theorem toModuleCat_μ (M N : GradedModuleCat.{u} 𝒜) :
    Functor.LaxMonoidal.μ (toModuleCat (𝒜 := 𝒜)) M N = 𝟙 (ModuleCat.of A (M ⊗[A] N)) :=
  (rfl)

/-- The unit comparison of the forgetful functor is the identity of `A`. -/
@[simp]
theorem toModuleCat_ε :
    Functor.LaxMonoidal.ε (toModuleCat (𝒜 := 𝒜)) = 𝟙 (ModuleCat.of A A) :=
  (rfl)

/-- The tensor product of graded modules is additive in each variable. -/
instance : MonoidalPreadditive (GradedModuleCat.{u} 𝒜) :=
  monoidalPreadditive_of_faithful toModuleCat

section Braided

/-- The symmetry of graded modules: the unsigned swap `m ⊗ₜ n ↦ n ⊗ₜ m`. -/
noncomputable instance instBraidedCategory : BraidedCategory (GradedModuleCat.{u} 𝒜) :=
  .ofFaithful toModuleCat fun M N ↦ isoMk (TensorProduct.comm A M N) fun p x ↦
    (LinearMap.IsHomogeneous.linearEquiv_mem_piece_iff
      (M.grading.isHomogeneous_comm_tensorProductOver 𝒜 N.grading) p x).symm

variable (M N : GradedModuleCat.{u} 𝒜)

/-- The underlying map of the symmetry is `TensorProduct.comm`. -/
theorem braiding_hom_hom : (β_ M N).hom.hom = (TensorProduct.comm A M N).toLinearMap :=
  (rfl)

theorem braiding_inv_hom : (β_ M N).inv.hom = (TensorProduct.comm A M N).symm.toLinearMap :=
  (rfl)

/-- The symmetry exchanges the factors of a pure tensor with no sign, whatever their degrees. -/
@[simp]
theorem braiding_hom_tmul (m : M) (n : N) :
    (β_ M N).hom.hom (m ⊗ₜ[A] n) = n ⊗ₜ[A] m :=
  (rfl)

@[simp]
theorem braiding_inv_tmul (m : M) (n : N) :
    (β_ M N).inv.hom (n ⊗ₜ[A] m) = m ⊗ₜ[A] n :=
  (rfl)

/-- The forgetful functor to `ModuleCat A` is braided. -/
noncomputable instance : (toModuleCat (𝒜 := 𝒜)).Braided where
  braided _ _ := by ext; rfl

/-- Graded `𝒜`-modules form a symmetric monoidal category under the tensor product over `A`, with
the unsigned symmetry. -/
noncomputable instance instSymmetricCategory : SymmetricCategory (GradedModuleCat.{u} 𝒜) :=
  .ofFaithful toModuleCat

end Braided

section Lift

variable {M N P : GradedModuleCat.{u} 𝒜}

/-- Morphisms out of `M ⊗ N` are determined by their values on pure tensors. -/
theorem tensor_ext {f g : M ⊗ N ⟶ P} (h : ∀ (m : M) (n : N), f.hom (m ⊗ₜ n) = g.hom (m ⊗ₜ n)) :
    f = g :=
  hom_ext (TensorProduct.ext' h)

/-- The universal property of the graded tensor product: an `A`-bilinear map sending homogeneous
elements of degrees `p` and `q` to degree `p + q` induces a morphism out of `M ⊗ N`. -/
noncomputable def tensorLift (f : M →ₗ[A] N →ₗ[A] P)
    (hf : ∀ {p q : ℤ} {m : M} {n : N}, m ∈ M.grading.piece p → n ∈ N.grading.piece q →
      f m n ∈ P.grading.piece (p + q)) :
    M ⊗ N ⟶ P :=
  ofHom (TensorProduct.lift f) <|
    M.grading.isHomogeneous_of_tmul_mem_tensorProductOver 𝒜 N.grading _ _ _ fun hm hn ↦ by
      simpa only [lift.tmul, add_zero] using hf hm hn

@[simp]
theorem tensorLift_tmul (f : M →ₗ[A] N →ₗ[A] P)
    (hf : ∀ {p q : ℤ} {m : M} {n : N}, m ∈ M.grading.piece p → n ∈ N.grading.piece q →
      f m n ∈ P.grading.piece (p + q)) (m : M) (n : N) :
    (tensorLift f hf).hom (m ⊗ₜ n) = f m n :=
  lift.tmul m n

/-- `tensorLift f hf` is the only morphism out of `M ⊗ N` restricting to `f` on pure tensors. -/
theorem eq_tensorLift (f : M →ₗ[A] N →ₗ[A] P)
    (hf : ∀ {p q : ℤ} {m : M} {n : N}, m ∈ M.grading.piece p → n ∈ N.grading.piece q →
      f m n ∈ P.grading.piece (p + q))
    (g : M ⊗ N ⟶ P) (hg : ∀ (m : M) (n : N), g.hom (m ⊗ₜ n) = f m n) :
    g = tensorLift f hf :=
  tensor_ext fun m n ↦ by rw [hg, tensorLift_tmul]

end Lift

section Shift

variable (M N : GradedModuleCat.{u} 𝒜) (a b : ℤ)

/-- Shifting the factors of a tensor product by `a` and `b` shifts the total degree by
`a + b`. -/
theorem mem_tensorObj_shiftObj_piece_iff {p : ℤ} {x : M ⊗[A] N} :
    x ∈ (M.shiftObj a ⊗ N.shiftObj b).grading.piece p ↔
      x ∈ ((M ⊗ N).shiftObj (a + b)).grading.piece p := by
  -- Instance search does not see through the reducible `shiftObj` to its `gradedSMul` field.
  have := (M.shiftObj a).gradedSMul
  have := (N.shiftObj b).gradedSMul
  rw [mem_shiftObj_piece_iff, tensorObj_grading, tensorObj_grading]
  constructor
  · refine fun hx ↦ (M.shiftObj a).grading.tensorProductOver_piece_le_of_add_eq 𝒜
      (N.shiftObj b).grading
      (C := (M.grading.tensorProductOver 𝒜 N.grading).piece (p - (a + b)))
      (fun p₁ p₂ hp m hm n hn ↦ ?_) hx
    rw [mem_shiftObj_piece_iff] at hm hn
    convert M.grading.tmul_mem_tensorProductOver 𝒜 N.grading hm hn using 2
    omega
  · refine fun hx ↦ M.grading.tensorProductOver_piece_le_of_add_eq 𝒜 N.grading
      (C := ((M.shiftObj a).grading.tensorProductOver 𝒜 (N.shiftObj b).grading).piece p)
      (fun p₁ p₂ hp m hm n hn ↦ ?_) hx
    have hm' : m ∈ (M.shiftObj a).grading.piece (p₁ + a) := by
      rwa [mem_shiftObj_piece_iff, add_sub_cancel_right]
    have hn' : n ∈ (N.shiftObj b).grading.piece (p₂ + b) := by
      rwa [mem_shiftObj_piece_iff, add_sub_cancel_right]
    convert (M.shiftObj a).grading.tmul_mem_tensorProductOver 𝒜 (N.shiftObj b).grading hm' hn'
      using 2
    omega

/-- The comparison `M{a} ⊗ N{b} ≅ (M ⊗ N){a + b}`, the identity on underlying modules. Moving the
shifts out of the factors introduces no sign. -/
noncomputable def tensorShiftIso :
    M.shiftObj a ⊗ N.shiftObj b ≅ (M ⊗ N).shiftObj (a + b) :=
  isoMk (LinearEquiv.refl A (M ⊗[A] N)) fun _ _ ↦ mem_tensorObj_shiftObj_piece_iff M N a b

theorem tensorShiftIso_hom_hom : (tensorShiftIso M N a b).hom.hom = LinearMap.id :=
  (rfl)

theorem tensorShiftIso_inv_hom : (tensorShiftIso M N a b).inv.hom = LinearMap.id :=
  (rfl)

/-- The comparison `M{a} ⊗ N{b} ≅ (M ⊗ N){a + b}` fixes pure tensors. -/
@[simp]
theorem tensorShiftIso_hom_tmul (m : M) (n : N) :
    (tensorShiftIso M N a b).hom.hom (m ⊗ₜ[A] n) = m ⊗ₜ[A] n :=
  (rfl)

@[simp]
theorem tensorShiftIso_inv_tmul (m : M) (n : N) :
    (tensorShiftIso M N a b).inv.hom (m ⊗ₜ[A] n) = m ⊗ₜ[A] n :=
  (rfl)

variable {M N} {M' N' : GradedModuleCat.{u} 𝒜}

/-- The comparison `M{a} ⊗ N{b} ≅ (M ⊗ N){a + b}` is natural in `M` and `N`. -/
@[reassoc]
theorem tensorShiftIso_hom_naturality (f : M ⟶ M') (g : N ⟶ N') :
    ((shiftFunctor a).map f ⊗ₘ (shiftFunctor b).map g) ≫ (tensorShiftIso M' N' a b).hom =
      (tensorShiftIso M N a b).hom ≫ (shiftFunctor (a + b)).map (f ⊗ₘ g) :=
  (rfl)

end Shift

end TauCeti.GradedModuleCat
