/-!
# Minimal graded projective surjections and resolutions

Let `A` be a nonnegatively graded algebra whose degree-zero part `A₀ = 𝒜 0` is a semisimple ring,
as for the path-length grading of a path algebra of a finite acyclic quiver, of a zigzag algebra,
or of any Koszul algebra in the sense of Beilinson--Ginzburg--Soergel. Write `A₊` for the sum of
the pieces of `A` of positive degree.

A graded module `M` vanishing below some degree is the target of a **minimal projective
surjection**: a degree-zero surjection `P ⟶ M` from a direct sum `P` of shifted projectives `A f`,
with `f` idempotents of degree zero, whose kernel lies in `A₊ P`, minimal in the sense of
`TauCeti.GradedProjectiveResolution.IsMinimal`. Its generators lift a decomposition of each
homogeneous piece of `M / A₊ M` into simple `A₀`-modules. Over the semisimple ring `A₀` every
simple summand, generated by any nonzero element `v`, is isomorphic to `A₀ f` for an idempotent
`f` fixing `v` (`TauCeti.IsSemisimpleRing.exists_isIdempotentElem_smul_eq_zero_iff`). Graded
Nakayama makes the lifted generators generate, and because the degree-zero part of `A f` is
`A₀ f`, the kernel lies in `A₊ P`.

Iterating along successive kernels gives a minimal graded projective resolution, with
finite-dimensional terms when `A` and `M` are finite-dimensional. With the diagonal Ext criterion
for minimal resolutions this gives the elementary characterisation of linearity: `M` has a linear
graded projective resolution exactly when `Extⁿ(M, N)` vanishes for every graded module `N`
concentrated in a single degree `p ≠ n`. In the finite-dimensional case it suffices to test
finite-dimensional simple modules `N`; for `M` a graded simple this is the diagonal vanishing of
the bigraded `Ext` between graded simples.

## Main results

* `TauCeti.GradedModuleCat.exists_minimal_projective_surjection`: minimal projective
  surjections onto bounded-below graded modules.
* `TauCeti.GradedModuleCat.exists_minimal_projective_surjection_of_finite`: finite-dimensional
  sources for finite-dimensional graded modules over a finite-dimensional algebra.
* `TauCeti.GradedProjectiveResolution.exists_isMinimal`: minimal graded projective resolutions
  of bounded-below graded modules.
* `TauCeti.GradedProjectiveResolution.exists_isMinimal_of_finite`: minimal resolutions with
  finite-dimensional terms.
* `TauCeti.GradedProjectiveResolution.exists_isLinear_iff_subsingleton_ext`: a bounded-below
  graded module has a linear resolution exactly when Ext against concentrated modules vanishes
  off the diagonal.
* `TauCeti.GradedProjectiveResolution.exists_isLinear_iff_subsingleton_ext_simple`: the same
  criterion for finite-dimensional modules, tested against simple modules.

## References

* C. Năstăsescu and F. Van Oystaeyen, *Methods of Graded Rings*, Section 2.3, for graded
  projective modules and graded Nakayama.
* I. Assem, D. Simson, A. Skowroński, *Elements of the Representation Theory of Associative
  Algebras, Vol. 1*, Section I.5, for projective covers built from idempotents.
* A. Beilinson, V. Ginzburg and W. Soergel, *Koszul duality patterns in representation theory*,
  Section 1.2, for minimal and linear resolutions over a positively graded ring with semisimple
  degree-zero part, and the diagonal Ext criterion.
-/

public section

noncomputable section

namespace TauCeti.GradedModuleCat

open CategoryTheory _root_.DirectSum
open scoped Pointwise

universe uk uA v w

section Cover

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] {J : Type w} {e : J → A}
  (he₀ : ∀ j, e j ∈ 𝒜 0) (d : J → ℤ)

/-- The graded projective `⨁ⱼ (A eⱼ){d j}`. -/
private abbrev coverObj : GradedModuleCat.{max w uA} 𝒜 :=
  directSumObj fun j =>
    (ofIdeal 𝒜 (Ideal.span {e j})
      (Ideal.isHomogeneous_span_singleton 𝒜 ⟨0, he₀ j⟩)).shiftObj (d j)

private theorem mem_coverObj_piece_iff (p : ℤ) (x : coverObj he₀ d) :
    x ∈ (coverObj he₀ d).grading.piece p ↔
      ∀ j, ((x j : Ideal.span {e j}) : A) ∈ 𝒜 (p - d j) := by
  rw [InternalGrading.directSum_piece, InternalGrading.mem_directSumPiece_iff]
  exact forall_congr' fun j => (mem_shiftObj_piece_iff _ _ _ _).trans (mem_ofIdeal_piece_iff _)

/-- The generator `eⱼ` of the `j`-th summand. -/
private def coverGen (j : J) : coverObj he₀ d := by
  classical
  exact DirectSum.lof A J (fun j => (Ideal.span {e j} : Ideal A)) j
    (spanSingletonGenerator (e j))

/-- The map `⨁ⱼ (A eⱼ){d j} ⟶ M` sending `a` in the `j`-th summand to `a • m j`. -/
private def coverLift {M : GradedModuleCat.{max w uA} 𝒜} (m : J → M)
    (hm : ∀ j, m j ∈ M.grading.piece (d j)) : coverObj he₀ d ⟶ M := by
  classical
  refine ofHom (DirectSum.toModule A J M fun j =>
    (LinearMap.toSpanSingleton A M (m j)).comp (Ideal.span {e j}).subtype)
    (TauCeti.LinearMap.isHomogeneous_def.mpr fun p y hy => ?_)
  refine InternalGrading.toModule_mem_of_mem_directSumPiece _ M.grading.piece _
    (fun j z hz => ?_) (by simpa only [InternalGrading.directSum_piece] using hy)
  simpa using SetLike.GradedSMul.smul_mem
    (((mem_shiftObj_piece_iff _ _ _ _).trans (mem_ofIdeal_piece_iff _)).1 hz) (hm j)

private theorem coverLift_coverGen {M : GradedModuleCat.{max w uA} 𝒜} (m : J → M)
    (hm : ∀ j, m j ∈ M.grading.piece (d j)) (j : J) :
    (coverLift he₀ d m hm).hom (coverGen he₀ d j) = e j • m j := by
  classical
  simp [coverLift, coverGen]

private theorem lof_eq_smul_coverGen (hidem : ∀ j, IsIdempotentElem (e j)) [hJ : DecidableEq J]
    (j : J) (y : (Ideal.span {e j} : Ideal A)) :
    DirectSum.lof A J (fun j => (Ideal.span {e j} : Ideal A)) j y =
      (y : A) • coverGen he₀ d j := by
  cases Subsingleton.elim hJ (Classical.decEq J)
  rw [coverGen, ← map_smul, smul_spanSingletonGenerator (hidem j)]

private theorem smul_coverGen (hidem : ∀ j, IsIdempotentElem (e j)) (j : J) :
    e j • coverGen he₀ d j = coverGen he₀ d j := by
  classical
  have h := lof_eq_smul_coverGen he₀ d hidem j (spanSingletonGenerator (e j))
  rw [coe_spanSingletonGenerator] at h
  rw [← h, coverGen]

private theorem projective_coverObj (hidem : ∀ j, IsIdempotentElem (e j)) :
    Module.Projective A (coverObj he₀ d) :=
  Module.Projective.directSum_iff.mpr fun j => (hidem j).projective_span_singleton

end Cover

section Minimal

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] {J : Type w} {e : J → A}
  (hneg : ∀ p < 0, 𝒜 p = ⊥) (he : ∀ j, IsIdempotentElem (e j)) (he₀ : ∀ j, e j ∈ 𝒜 0)
  (d : J → ℤ)

include hneg in
/-- Modulo the positive-degree action, every multiple of a generator of the cover is a
degree-zero multiple of that generator. -/
private theorem exists_smul_coverGen_sub_mem (j : J) (a : A) :
    ∃ c : SetLike.GradeZero.subalgebra 𝒜, a • coverGen he₀ d j - c • coverGen he₀ d j ∈
      (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k (coverObj he₀ d)) := by
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => exact ⟨0, by simp⟩
  | add a b ha hb =>
    obtain ⟨c, hc⟩ := ha
    obtain ⟨c', hc'⟩ := hb
    exact ⟨c + c', by simpa [add_smul, sub_add_sub_comm] using add_mem hc hc'⟩
  | @homogeneous r a =>
    obtain ⟨a, ha⟩ := a
    rcases lt_trichotomy r 0 with hr | rfl | hr
    · rw [hneg r hr, Submodule.mem_bot] at ha
      exact ⟨0, by simp [ha]⟩
    · exact ⟨⟨a, ha⟩, by simp [Subalgebra.smul_def]⟩
    · have hmem : a ∈ ⨆ (i : ℤ) (_ : 0 < i), 𝒜 i :=
        Submodule.mem_iSup_of_mem r (Submodule.mem_iSup_of_mem (i := hr) ha)
      have h := Submodule.smul_mem_smul hmem (Submodule.mem_top (R := k) (x := coverGen he₀ d j))
      exact ⟨0, by simpa using h⟩

include hneg he in
/-- Modulo the positive-degree action, every element of the cover is a combination of its
generators with degree-zero coefficients. -/
private theorem exists_sub_linearCombination_mem (x : coverObj he₀ d) :
    ∃ c : J →₀ SetLike.GradeZero.subalgebra 𝒜,
      x - Finsupp.linearCombination (SetLike.GradeZero.subalgebra 𝒜) (coverGen he₀ d) c ∈
        (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k (coverObj he₀ d)) := by
  classical
  induction x using DirectSum.induction_on with
  | zero => exact ⟨0, by simp⟩
  | of j y =>
    obtain ⟨c, hc⟩ := exists_smul_coverGen_sub_mem hneg he₀ d j y
    refine ⟨Finsupp.single j c, ?_⟩
    rwa [Finsupp.linearCombination_single, ← DirectSum.lof_eq_of A,
      lof_eq_smul_coverGen he₀ d he]
  | add x y hx hy =>
    obtain ⟨c, hc⟩ := hx
    obtain ⟨c', hc'⟩ := hy
    exact ⟨c + c', by simpa [map_add, sub_add_sub_comm] using add_mem hc hc'⟩

include hneg he in
/-- If the images of the generators are independent modulo `A₊ M`, in the sense that a
degree-zero combination of them lies in `A₊ M` only when every coefficient kills the corresponding
idempotent, then the kernel of the cover lies in `A₊` times the cover. -/
private theorem mem_positive_smul_top_of_coverLift_eq_zero {M : GradedModuleCat.{max w uA} 𝒜}
    (m : J → M) (hm : ∀ j, m j ∈ M.grading.piece (d j)) (hme : ∀ j, e j • m j = m j)
    (hind : ∀ c : J →₀ SetLike.GradeZero.subalgebra 𝒜,
      Finsupp.linearCombination (SetLike.GradeZero.subalgebra 𝒜) m c ∈
        (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) → ∀ j, (c j : A) * e j = 0)
    {x : coverObj he₀ d} (hx : (coverLift he₀ d m hm).hom x = 0) :
    x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k (coverObj he₀ d)) := by
  obtain ⟨c, hc⟩ := exists_sub_linearCombination_mem hneg he he₀ d x
  set π := (coverLift he₀ d m hm).hom.restrictScalars (SetLike.GradeZero.subalgebra 𝒜)
  have hmap : π (x - Finsupp.linearCombination _ (coverGen he₀ d) c) ∈
      (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) := by
    refine Submodule.smul_induction_on hc (fun a ha y _ => ?_) (fun y z hy hz => ?_)
    · simpa [π] using Submodule.smul_mem_smul ha (Submodule.mem_top (R := k) (x := π y))
    · simpa only [map_add] using add_mem hy hz
  have hlc : π (Finsupp.linearCombination _ (coverGen he₀ d) c) =
      Finsupp.linearCombination _ m c := by
    rw [Finsupp.apply_linearCombination]
    congr 2
    funext j
    exact (coverLift_coverGen he₀ d m hm j).trans (hme j)
  rw [map_sub, LinearMap.restrictScalars_apply, hx, zero_sub, hlc, neg_mem_iff] at hmap
  -- Every coefficient kills its idempotent, so the combination of generators vanishes.
  have hzero : Finsupp.linearCombination _ (coverGen he₀ d) c = 0 := by
    rw [Finsupp.linearCombination_apply]
    refine Finset.sum_eq_zero fun j _ => ?_
    beta_reduce
    rw [Subalgebra.smul_def, ← smul_coverGen he₀ d he j, smul_smul, hind c hmap j, zero_smul]
  rwa [hzero, sub_zero] at hc

include hneg in
/-- The cover vanishes below the lowest degree of its generators. -/
private theorem coverObj_piece_eq_bot {b : ℤ} (hd : ∀ j, b ≤ d j) {p : ℤ} (hp : p < b) :
    (coverObj he₀ d).grading.piece p = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x hx
  ext j : 1
  have h := (mem_coverObj_piece_iff he₀ d p x).mp hx j
  rw [hneg _ (by linarith [hd j]), Submodule.mem_bot] at h
  exact Subtype.ext (by simpa using h)

/-- **Graded Nakayama for the cover.** If `M` is bounded below and the degree-zero multiples of
the generator images span every homogeneous piece of `M` modulo `A₊ M`, then the cover is
surjective. -/
private theorem coverLift_surjective {M : GradedModuleCat.{max w uA} 𝒜}
    (m : J → M) (hm : ∀ j, m j ∈ M.grading.piece (d j)) (hme : ∀ j, e j • m j = m j)
    (b : ℤ) (hb : ∀ p < b, M.grading.piece p = ⊥)
    (hgen : ∀ p, M.grading.piece p ≤
      (Submodule.span (SetLike.GradeZero.subalgebra 𝒜) (Set.range m)).restrictScalars k ⊔
        (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M)) :
    Function.Surjective (coverLift he₀ d m hm).hom := by
  rw [← LinearMap.range_eq_top]
  refine InternalGrading.eq_top_of_piece_le_sup_positive_smul_top 𝒜 _
    (TauCeti.LinearMap.IsHomogeneous.isHomogeneous_range (coverLift he₀ d m hm).isHomogeneous)
    b hb fun p => (hgen p).trans (sup_le_sup_right ?_ _)
  intro x hx
  refine (Submodule.span_le (p := (LinearMap.range (coverLift he₀ d m hm).hom).restrictScalars
    (SetLike.GradeZero.subalgebra 𝒜))).mpr ?_ hx
  rintro _ ⟨j, rfl⟩
  exact ⟨coverGen he₀ d j, by rw [coverLift_coverGen, hme]⟩

end Minimal

section Generators

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜]

/-- The homogeneous piece `Mₚ`, as a module over the degree-zero subalgebra. -/
private def pieceSubmodule (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    Submodule (SetLike.GradeZero.subalgebra 𝒜) M where
  __ := M.grading.piece p
  smul_mem' c x hx := by
    have hx : x ∈ M.grading.piece p := hx
    rw [Subalgebra.smul_def]
    simpa using SetLike.GradedSMul.smul_mem (A := 𝒜) c.2 hx

private theorem mem_pieceSubmodule {M : GradedModuleCat.{v} 𝒜} {p : ℤ} {x : M} :
    x ∈ pieceSubmodule M p ↔ x ∈ M.grading.piece p :=
  Iff.rfl

/-- The positive-degree action `A₊ M`, as a module over the degree-zero subalgebra. -/
private def positiveSubmodule (M : GradedModuleCat.{v} 𝒜) :
    Submodule (SetLike.GradeZero.subalgebra 𝒜) M where
  __ := (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M)
  smul_mem' c x hx := by
    rw [Subalgebra.smul_def]
    exact InternalGrading.smul_mem_positive_smul_top c.2 hx

private theorem mem_positiveSubmodule {M : GradedModuleCat.{v} 𝒜} {x : M} :
    x ∈ positiveSubmodule M ↔ x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) :=
  Iff.rfl

/-- The homogeneous piece `(M / A₊ M)ₚ`, as a module over the degree-zero subalgebra. -/
private abbrev PieceQuotient (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :=
  pieceSubmodule M p ⧸ (positiveSubmodule M).comap (pieceSubmodule M p).subtype

/-- Projection to the degree-`p` piece of `M / A₊ M`. -/
private def pieceQuotientMap (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    M →ₗ[SetLike.GradeZero.subalgebra 𝒜] PieceQuotient M p :=
  Submodule.mkQ _ ∘ₗ
    { toFun x := ⟨decompose M.grading.piece x p, (decompose M.grading.piece x p).2⟩
      map_add' x y := by ext; simp
      map_smul' c x := by
        ext
        -- Multiplication by a degree-zero scalar is homogeneous of degree zero.
        have hf : TauCeti.LinearMap.IsHomogeneous (Algebra.lsmul k k M (c : A))
            M.grading.piece M.grading.piece 0 :=
          TauCeti.LinearMap.isHomogeneous_def.mpr fun q z hz => by
            simpa [add_comm] using SetLike.GradedSMul.smul_mem (A := 𝒜) c.2 hz
        have h := hf.map_decompose p x
        rw [add_zero] at h
        simpa [Subalgebra.smul_def] using h.symm }

private theorem pieceQuotientMap_of_mem {M : GradedModuleCat.{v} 𝒜} {p : ℤ} {x : M}
    (hx : x ∈ M.grading.piece p) :
    pieceQuotientMap M p x = Submodule.Quotient.mk ⟨x, mem_pieceSubmodule.mpr hx⟩ := by
  simp [pieceQuotientMap, decompose_of_mem_same _ hx]

private theorem pieceQuotientMap_of_mem_ne {M : GradedModuleCat.{v} 𝒜} {p q : ℤ} {x : M}
    (hx : x ∈ M.grading.piece q) (hqp : q ≠ p) : pieceQuotientMap M p x = 0 := by
  simp [pieceQuotientMap, decompose_of_mem_ne _ hx hqp]

private theorem pieceQuotientMap_eq_zero {M : GradedModuleCat.{v} 𝒜} {p : ℤ} {x : M}
    (hx : x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M)) :
    pieceQuotientMap M p x = 0 := by
  simp only [pieceQuotientMap, LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
  exact InternalGrading.isHomogeneous_positive_smul_top 𝒜 p hx

variable [IsSemisimpleRing (𝒜 0)]

/-- Homogeneous generators of `M`, each fixed by an idempotent of degree zero, whose images
decompose `M / A₊ M` into the cyclic modules `A₀ eⱼ`. -/
private theorem exists_generators (M : GradedModuleCat.{v} 𝒜) :
    ∃ (J : Type v) (e : J → A) (d : J → ℤ) (m : J → M),
      (∀ j, IsIdempotentElem (e j)) ∧ (∀ j, e j ∈ 𝒜 0) ∧
      (∀ j, m j ∈ M.grading.piece (d j)) ∧ (∀ j, e j • m j = m j) ∧ (∀ j, m j ≠ 0) ∧
      (∀ c : J →₀ SetLike.GradeZero.subalgebra 𝒜,
        Finsupp.linearCombination (SetLike.GradeZero.subalgebra 𝒜) m c ∈
          (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) → ∀ j, (c j : A) * e j = 0) ∧
      ∀ p, M.grading.piece p ≤
        (Submodule.span (SetLike.GradeZero.subalgebra 𝒜) (Set.range m)).restrictScalars k ⊔
          (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) := by
  -- Mathlib's ring structure on `𝒜 0` is that of the degree-zero subring, which has the same
  -- carrier and operations as the degree-zero subalgebra acting on `M`.
  have : IsSemisimpleRing (SetLike.GradeZero.subalgebra 𝒜) := ‹IsSemisimpleRing (𝒜 0)›
  -- Decompose each homogeneous piece of `M / A₊ M` into simple submodules, choose a nonzero
  -- element `q` of each, an idempotent `f` with `A₀ f ≅ A₀ q`, and a homogeneous lift of `q`.
  choose s hs using fun p => IsSemisimpleModule.exists_sSupIndep_sSup_simples_eq_top
    (SetLike.GradeZero.subalgebra 𝒜) (PieceQuotient M p)
  have hne (p : ℤ) (S : s p) :
      (S : Submodule (SetLike.GradeZero.subalgebra 𝒜) (PieceQuotient M p)) ≠ ⊥ :=
    (isSimpleModule_iff_isAtom.mp ((hs p).2.2 S S.2)).1
  choose q hqS hq0 using fun p (S : s p) => Submodule.exists_mem_ne_zero_of_ne_bot (hne p S)
  -- Each simple summand is spanned by its chosen nonzero element.
  have hspanq (p : ℤ) (S : s p) : Submodule.span (SetLike.GradeZero.subalgebra 𝒜) {q p S} = S :=
    ((isSimpleModule_iff_isAtom.mp ((hs p).2.2 S S.2)).le_iff.mp
      ((Submodule.span_singleton_le_iff_mem _ _).mpr (hqS p S))).resolve_left
      (Submodule.span_singleton_eq_bot.not.mpr (hq0 p S))
  choose f hf hfq hfann using fun p (S : s p) =>
    IsSemisimpleRing.exists_isIdempotentElem_smul_eq_zero_iff
      (R := SetLike.GradeZero.subalgebra 𝒜) (q p S)
  choose y hy using fun p (S : s p) => Submodule.Quotient.mk_surjective _ (q p S)
  let m : (Σ p, s p) → M := fun j => ((f j.1 j.2 • y j.1 j.2 : pieceSubmodule M j.1) : M)
  have hmq (p : ℤ) (S : s p) : pieceQuotientMap M p (m ⟨p, S⟩) = q p S := by
    rw [pieceQuotientMap_of_mem (f p S • y p S).2]
    simp only [Subtype.coe_eta, Submodule.Quotient.mk_smul, hy, hfq]
  have hmq_ne {p p' : ℤ} (S : s p') (h : p' ≠ p) : pieceQuotientMap M p (m ⟨p', S⟩) = 0 :=
    pieceQuotientMap_of_mem_ne (f p' S • y p' S).2 h
  refine ⟨Σ p, s p, fun j => (f j.1 j.2 : A), fun j => j.1, m,
    fun j => (hf j.1 j.2).map (SetLike.GradeZero.subalgebra 𝒜).val, fun j => (f j.1 j.2).2,
    fun j => (f j.1 j.2 • y j.1 j.2).2, fun j => ?_, fun ⟨p, S⟩ h => hq0 p S ?_, ?_, ?_⟩
  · simp only [m, ← Subalgebra.smul_def, ← Submodule.coe_smul, smul_smul, (hf j.1 j.2).eq]
  · rw [← hmq, h, map_zero]
  · -- Independence: project to the degree-`p` piece of `M / A₊ M`, where the summands are
    -- independent simple submodules.
    rintro c hc ⟨p, S⟩
    by_cases hcS : (⟨p, S⟩ : Σ p, s p) ∈ c.support
    swap
    · rw [Finsupp.notMem_support_iff.mp hcS, ZeroMemClass.coe_zero, zero_mul]
    let F : (Σ p, s p) → Submodule (SetLike.GradeZero.subalgebra 𝒜) (PieceQuotient M p) :=
      fun j => Submodule.span _ {pieceQuotientMap M p (m j)}
    have hF : iSupIndep F := by
      refine iSupIndep_def.mpr fun ⟨p', S'⟩ => ?_
      by_cases hp : p' = p
      · subst hp
        have hS' : F ⟨p', S'⟩ = S' := by simp only [F, hmq, hspanq]
        rw [hS']
        refine ((hs p').1 S'.2).mono_right (iSup₂_le fun ⟨p'', S''⟩ hne' => ?_)
        by_cases hp'' : p'' = p'
        · subst hp''
          refine le_sSup_of_le ⟨S''.2, fun h => hne' ?_⟩ ?_
          · exact Sigma.ext rfl (heq_of_eq (Subtype.ext h))
          · simp only [F, hmq, hspanq, le_refl]
        · simp [F, hmq_ne S'' hp'']
      · simp [F, hmq_ne S' hp]
    have hsum : ∑ j ∈ c.support, c j • pieceQuotientMap M p (m j) = 0 := by
      rw [← pieceQuotientMap_eq_zero (p := p) hc, Finsupp.linearCombination_apply, map_finsuppSum,
        Finsupp.sum]
      simp only [map_smul]
    have h := (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero F).mp hF c.support _
      (fun j _ => Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)) hsum _ hcS
    rw [hmq] at h
    simpa using congrArg Subtype.val ((hfann p S _).mp h)
  · -- Generation: `Mₚ / A₊ Mₚ` is the sum of the simple summands, each spanned by its element.
    intro p x hx
    have hq : Submodule.Quotient.mk ⟨x, mem_pieceSubmodule.mpr hx⟩ ∈
        Submodule.span (SetLike.GradeZero.subalgebra 𝒜) (Set.range (q p)) := by
      refine (sSup_le fun S hS => ?_ : sSup (s p) ≤ _) ((hs p).2.1 ▸ Submodule.mem_top)
      exact (hspanq p ⟨S, hS⟩).ge.trans
        (Submodule.span_mono (Set.singleton_subset_iff.mpr ⟨⟨S, hS⟩, rfl⟩))
    have hrange : Set.range (q p) =
        Submodule.mkQ _ '' Set.range fun S : s p => f p S • y p S := by
      rw [← Set.range_comp]
      congr 1
      funext S
      simp [hy, hfq]
    have hq' : (⟨x, mem_pieceSubmodule.mpr hx⟩ : pieceSubmodule M p) ∈
        (positiveSubmodule M).comap (pieceSubmodule M p).subtype ⊔
          Submodule.span (SetLike.GradeZero.subalgebra 𝒜)
            (Set.range fun S : s p => f p S • y p S) := by
      rw [← Submodule.comap_map_mkQ, Submodule.mem_comap, Submodule.map_span, ← hrange]
      exact hq
    obtain ⟨u, hu, z, hz, huz⟩ := Submodule.mem_sup.mp hq'
    have hz' : (z : M) ∈ Submodule.span (SetLike.GradeZero.subalgebra 𝒜) (Set.range m) := by
      refine Submodule.span_mono ?_ (Submodule.apply_mem_span_image_of_mem_span
        (pieceSubmodule M p).subtype hz)
      rintro _ ⟨_, ⟨S, rfl⟩, rfl⟩
      exact ⟨⟨p, S⟩, rfl⟩
    have hu' : (u : M) ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) :=
      mem_positiveSubmodule.mp (Submodule.mem_comap.mp hu)
    have hzu : (z : M) + u = x := by
      rw [add_comm]
      exact congrArg Subtype.val huz
    exact Submodule.mem_sup.mpr ⟨z, (Submodule.restrictScalars_mem k _ _).mpr hz', u, hu', hzu⟩

end Generators

section ProjectiveSurjection

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] [IsSemisimpleRing (𝒜 0)]
  (hneg : ∀ p < 0, 𝒜 p = ⊥)

include hneg in
/-- **Minimal projective surjections.** Let `A` be a nonnegatively graded algebra whose degree-zero
part is a semisimple ring. Every graded module `M` vanishing below degree `b` is the image of a
projective graded module `P` under a degree-zero surjection whose kernel lies in `A₊ P`. The source
`P` also vanishes below degree `b`. -/
theorem exists_minimal_projective_surjection (M : GradedModuleCat.{max uA v} 𝒜) (b : ℤ)
    (hb : ∀ p < b, M.grading.piece p = ⊥) :
    ∃ (P : GradedModuleCat.{max uA v} 𝒜) (π : P ⟶ M), Module.Projective A P ∧
      Function.Surjective π.hom ∧
      (∀ x, π.hom x = 0 → x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k P)) ∧
      ∀ p < b, P.grading.piece p = ⊥ := by
  obtain ⟨J, e, d, m, he, he₀, hm, hme, hm0, hind, hgen⟩ := exists_generators M
  have hd (j : J) : b ≤ d j := by
    by_contra h
    exact hm0 j (by simpa [hb _ (not_le.mp h)] using hm j)
  exact ⟨coverObj he₀ d, coverLift he₀ d m hm, projective_coverObj he₀ d he,
    coverLift_surjective he₀ d m hm hme b hb hgen,
    fun x hx => mem_positive_smul_top_of_coverLift_eq_zero hneg he he₀ d m hm hme hind hx,
    fun p hp => coverObj_piece_eq_bot hneg he₀ d hd hp⟩

end ProjectiveSurjection

section FiniteProjectiveSurjection

variable {k : Type uk} [Field k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] [IsSemisimpleRing (𝒜 0)]
  (hneg : ∀ p < 0, 𝒜 p = ⊥)

include hneg in
/-- **Minimal projective surjections onto finite-dimensional modules.** Over a finite-dimensional
algebra as in `TauCeti.GradedModuleCat.exists_minimal_projective_surjection`, a finite-dimensional
graded module is the target of a minimal projective surjection from a finite-dimensional graded
module. -/
theorem exists_minimal_projective_surjection_of_finite [Module.Finite k A]
    (M : GradedModuleCat.{max uA v} 𝒜) [Module.Finite k M] :
    ∃ (P : GradedModuleCat.{max uA v} 𝒜) (π : P ⟶ M), Module.Projective A P ∧
      Function.Surjective π.hom ∧
      (∀ x, π.hom x = 0 → x ∈ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k P)) ∧
      Module.Finite k P := by
  obtain ⟨b, hb⟩ := M.grading.finite_piece_ne_bot.bddBelow
  have hbelow (p : ℤ) (hp : p < b) : M.grading.piece p = ⊥ := by
    by_contra hne
    exact absurd (hb hne) (not_le.mpr hp)
  obtain ⟨J, e, d, m, he, he₀, hm, hme, hm0, hind, hgen⟩ := exists_generators M
  -- The generators are linearly independent over `k`, hence finitely many: a scalar `c` with
  -- `c • eⱼ = 0` vanishes, since `eⱼ • mⱼ = mⱼ ≠ 0`.
  have hli : LinearIndependent k m := by
    refine linearIndependent_iff.mpr fun c hc => Finsupp.ext fun j => ?_
    have hc' : Finsupp.linearCombination (SetLike.GradeZero.subalgebra 𝒜) m
        (c.mapRange (algebraMap k _) (map_zero _)) = 0 := by
      rw [Finsupp.linearCombination_apply,
        Finsupp.sum_mapRange_index (h := fun j a => a • m j) fun _ => zero_smul _ _]
      simp only [algebraMap_smul]
      rw [← Finsupp.linearCombination_apply, hc]
    have h := hind _ (hc' ▸ zero_mem _) j
    rw [Finsupp.mapRange_apply, Subalgebra.coe_algebraMap, ← Algebra.smul_def] at h
    rw [Finsupp.coe_zero, Pi.zero_apply]
    by_contra hcj
    exact hm0 j (by rw [← hme j, (smul_eq_zero.mp h).resolve_left hcj, zero_smul])
  have : Finite J := hli.finite_of_isNoetherian
  have (j : J) : Module.Finite k (Ideal.span {e j} : Ideal A) :=
    Module.Finite.of_injective ((Ideal.span {e j} : Ideal A).subtype.restrictScalars k)
      Subtype.val_injective
  have hd (j : J) : b ≤ d j := by
    by_contra h
    exact hm0 j (by simpa [hbelow _ (not_le.mp h)] using hm j)
  exact ⟨coverObj he₀ d, coverLift he₀ d m hm, projective_coverObj he₀ d he,
    coverLift_surjective he₀ d m hm hme b hbelow hgen,
    fun x hx => mem_positive_smul_top_of_coverLift_eq_zero hneg he he₀ d m hm hme hind hx,
    Module.Finite.instDirectSum _⟩

end FiniteProjectiveSurjection

end TauCeti.GradedModuleCat

namespace TauCeti.GradedProjectiveResolution

open CategoryTheory CategoryTheory.Abelian GradedModuleCat

universe w uk uA v

section Exists

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] [IsSemisimpleRing (𝒜 0)]
  (hneg : ∀ p < 0, 𝒜 p = ⊥)

include hneg in
/-- **Minimal graded projective resolutions exist.** Let `A` be a nonnegatively graded algebra
whose degree-zero part is a semisimple ring. Every graded module vanishing below degree `b` has a
minimal graded projective resolution all of whose terms vanish below degree `b`. -/
theorem exists_isMinimal (M : GradedModuleCat.{max uA v} 𝒜) (b : ℤ)
    (hb : ∀ p < b, M.grading.piece p = ⊥) :
    ∃ r : GradedProjectiveResolution.{uk, uA, max uA v, max uA v} 𝒜 M.grading,
      r.IsMinimal ∧ ∀ n p, p < b → (r.grading n).piece p = ⊥ :=
  exists_isMinimal_of_forall_cover (fun N => ∀ p < b, N.grading.piece p = ⊥)
    (fun N => ∀ p < b, N.grading.piece p = ⊥) (fun N hN => by
      obtain ⟨P, π, hP, hπ, hmin, hPb⟩ := exists_minimal_projective_surjection hneg N b hN
      refine ⟨P, π, hP, hπ, hmin, hPb, fun p hp => ?_⟩
      rw [Submodule.eq_bot_iff]
      intro z hz
      rw [InternalGrading.mem_ker_piece, hPb p hp, Submodule.mem_bot] at hz
      exact Subtype.ext hz) M hb

variable [HasExt.{w} (GradedModuleCat.{max uA v} 𝒜)]

include hneg in
/-- **Diagonal Ext detects the existence of a linear resolution.** Over an algebra as in
`TauCeti.GradedProjectiveResolution.exists_isMinimal`, a bounded-below graded module has a linear
graded projective resolution exactly when `Extⁿ(M, N)` vanishes for every graded module `N`
concentrated in a single degree `p ≠ n`. -/
theorem exists_isLinear_iff_subsingleton_ext (M : GradedModuleCat.{max uA v} 𝒜) (b : ℤ)
    (hb : ∀ p < b, M.grading.piece p = ⊥) :
    (∃ r : GradedProjectiveResolution.{uk, uA, max uA v, max uA v} 𝒜 M.grading, r.IsLinear) ↔
      ∀ (n : ℕ) (p : ℤ), (n : ℤ) ≠ p → ∀ N : GradedModuleCat.{max uA v} 𝒜,
        (∀ q, q ≠ p → N.grading.piece q = ⊥) → Subsingleton (Ext.{w} M N n) := by
  constructor
  · rintro ⟨r, hr⟩ n p hnp N hN
    exact hr.subsingleton_ext_of_ne p hN n hnp
  · intro hExt
    obtain ⟨r, hr, hbelow⟩ := exists_isMinimal hneg M b hb
    exact ⟨r, (hr.isLinear_iff_subsingleton_ext hneg (fun _ => b) hbelow).mpr hExt⟩

end Exists

section Finite

variable {k : Type uk} [Field k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜] [IsSemisimpleRing (𝒜 0)] [Module.Finite k A]
  (hneg : ∀ p < 0, 𝒜 p = ⊥)

include hneg in
/-- **Finite-dimensional minimal graded projective resolutions exist** over a finite-dimensional
algebra as in `TauCeti.GradedProjectiveResolution.exists_isMinimal`: a finite-dimensional graded
module has a minimal graded projective resolution with finite-dimensional terms. -/
theorem exists_isMinimal_of_finite (M : GradedModuleCat.{max uA v} 𝒜) [Module.Finite k M] :
    ∃ r : GradedProjectiveResolution.{uk, uA, max uA v, max uA v} 𝒜 M.grading,
      r.IsMinimal ∧ ∀ n, Module.Finite k (r.X n) :=
  exists_isMinimal_of_forall_cover (fun N => Module.Finite k N) (fun N => Module.Finite k N)
    (fun N hN => by
      obtain ⟨P, π, hP, hπ, hmin, hPf⟩ := exists_minimal_projective_surjection_of_finite hneg N
      exact ⟨P, π, hP, hπ, hmin, hPf, Module.Finite.of_injective
        ((LinearMap.ker π.hom).subtype.restrictScalars k) Subtype.val_injective⟩) M inferInstance

variable [HasExt.{w} (GradedModuleCat.{max uA v} 𝒜)]

include hneg in
/-- **Diagonal Ext against simple modules detects the existence of a linear resolution.** Over a
finite-dimensional algebra as in `TauCeti.GradedProjectiveResolution.exists_isMinimal`, a
finite-dimensional graded module `M` has a linear graded projective resolution exactly when
`Extⁿ(M, S)` vanishes for every finite-dimensional simple graded module `S` concentrated in a
degree `p ≠ n`. -/
theorem exists_isLinear_iff_subsingleton_ext_simple (M : GradedModuleCat.{max uA v} 𝒜)
    [Module.Finite k M] :
    (∃ r : GradedProjectiveResolution.{uk, uA, max uA v, max uA v} 𝒜 M.grading, r.IsLinear) ↔
      ∀ (n : ℕ) (p : ℤ), (n : ℤ) ≠ p → ∀ N : GradedModuleCat.{max uA v} 𝒜,
        Module.Finite k N → Simple N → (∀ q, q ≠ p → N.grading.piece q = ⊥) →
          Subsingleton (Ext.{w} M N n) := by
  constructor
  · rintro ⟨r, hr⟩ n p hnp N - - hN
    exact hr.subsingleton_ext_of_ne p hN n hnp
  · intro hExt
    obtain ⟨r, hr, hfin⟩ := exists_isMinimal_of_finite hneg M
    have := hfin
    exact ⟨r, (hr.isLinear_iff_subsingleton_ext_simple hneg).mpr hExt⟩

end Finite

end TauCeti.GradedProjectiveResolution
