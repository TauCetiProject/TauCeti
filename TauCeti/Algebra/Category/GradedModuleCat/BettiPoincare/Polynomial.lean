module

public import Mathlib.Algebra.MonoidAlgebra.Grading
public import TauCeti.Algebra.Category.GradedModuleCat.BettiPoincare.Linearity

/-!
# Worked check: `k[X] / (X²)` over the graded polynomial algebra `k[X]`

Equip the univariate polynomial algebra `A = AddMonoidAlgebra k ℕ` (`k[X]` with `X = single 1 1`
in internal degree `1`) with Mathlib's standard `ℤ`-grading
`AddMonoidAlgebra.gradeBy k (Nat.castAddMonoidHom ℤ)`. This algebra is nonnegatively graded, its
degree-zero piece is `k · 1`, and it is infinite-dimensional over `k` — exercising the
finite-dimensionality-free projective decomposition and linearity theorems of
`TauCeti.Algebra.Category.GradedModuleCat.CartanMap.Idempotent.Projective.Decomposition` and
`TauCeti.Algebra.Category.GradedModuleCat.BettiPoincare.Linearity`.

For the cyclic graded quotient `M = A ⧸ Ideal.span {X²}`, multiplication by `X² = single 2 1` fits
into a short exact sequence of graded `A`-modules

`0 ⟶ A{2} ⟶ A ⟶ A ⧸ (X²) ⟶ 0`.

This yields a minimal graded projective resolution `polyModXSqResolution k` of `M` whose Betti
Poincaré series in the rank-one basis `[A]` of `K₀^gr(proj A)` is

`B_M(q, t) = 1 + q² t` (`1 + PowerSeries.C (T 2) * PowerSeries.X`).

Because the `t¹`-coefficient is `q²` (internal degree `p = 2 ≠ 1`), the diagonal-support criterion
`TauCeti.GradedProjectiveResolution.isLinear_iff_diagonal_bettiPoincareSeries` certifies that this
minimal resolution is **not linear**.

## Main definitions

* `TauCeti.polyGrade`: the standard `ℤ`-grading on `AddMonoidAlgebra k ℕ` with `deg X = 1`.
* `TauCeti.polyProjectiveBasis`: the `ℤ[q,q⁻¹]`-basis of `K₀^gr(proj k[X])` indexed by `Unit`.
* `TauCeti.polyModXSq`: the graded quotient module `k[X] ⧸ (X²)`.
* `TauCeti.polyModXSqResolution`: the minimal resolution `0 ⟶ k[X]{2} ⟶ k[X] ⟶ k[X] ⧸ (X²) ⟶ 0`.

## Main results

* `TauCeti.bettiPoincareSeries_polyModXSqResolution`: `B_M(q, t) = 1 + C (T 2) * X`.
* `TauCeti.isMinimal_polyModXSqResolution`: `polyModXSqResolution k` is minimal.
* `TauCeti.not_isLinear_polyModXSqResolution`: `polyModXSqResolution k` is not linear.
-/

public section

noncomputable section

namespace TauCeti

open CategoryTheory LaurentPolynomial

universe u

variable (k : Type u) [Field k]

/-- The standard `ℤ`-grading on the polynomial algebra `AddMonoidAlgebra k ℕ` (`k[X]`), placing the
monomial `single m 1` (`Xᵐ`) in degree `(m : ℤ)`. -/
abbrev polyGrade : ℤ → Submodule k (AddMonoidAlgebra k ℕ) :=
  AddMonoidAlgebra.gradeBy k (Nat.castAddMonoidHom ℤ)

/-- `polyGrade k` vanishes in negative degrees. -/
theorem polyGrade_eq_bot_of_neg {p : ℤ} (hp : p < 0) : polyGrade k p = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro a ha
  ext m
  by_contra hm
  have hmem : m ∈ a.coeff.support := Finsupp.mem_support_iff.mpr hm
  have heq : (m : ℤ) = p := ha m hmem
  omega

/-- Degree zero of `polyGrade k` is spanned over `k` by `1`. -/
theorem polyGrade_zero_le_span_one :
    polyGrade k 0 ≤
      Submodule.span k (Set.range fun _ : Unit => (1 : AddMonoidAlgebra k ℕ)) := by
  intro a ha
  have ha_eq : a = a.coeff 0 • (1 : AddMonoidAlgebra k ℕ) := by
    ext m
    cases m with
    | zero => simp [AddMonoidAlgebra.one_def]
    | succ n =>
        have hnot : n + 1 ∉ a.coeff.support := fun hm => by
          have h0 : ((n + 1 : ℕ) : ℤ) = 0 := ha (n + 1) hm
          omega
        rw [Finsupp.notMem_support_iff.mp hnot]
        simp [AddMonoidAlgebra.one_def]
  rw [ha_eq]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(), rfl⟩)

/-- The unit ideal `Ideal.span {1}` is homogeneous in `polyGrade k`. -/
theorem isHomogeneous_span_one_polyGrade :
    (Ideal.span {(1 : AddMonoidAlgebra k ℕ)} : Ideal (AddMonoidAlgebra k ℕ)).IsHomogeneous
      (polyGrade k) :=
  Ideal.isHomogeneous_span_singleton (polyGrade k) ⟨0, SetLike.GradedOne.one_mem⟩

private theorem completeOrthogonalIdempotents_unit_one {R : Type*} [Semiring R] :
    CompleteOrthogonalIdempotents (fun _ : Unit => (1 : R)) :=
  ⟨⟨fun _ => IsIdempotentElem.one, fun _ _ h => absurd (Subsingleton.elim _ _) h⟩, by simp⟩

/-- The `ℤ[q,q⁻¹]`-basis of `K₀^gr(proj k[X])` indexed by `Unit`, generated by the free rank-one
graded module `k[X]`. -/
def polyProjectiveBasis :
    Module.Basis Unit (LaurentPolynomial ℤ)
      (LaurentK0.{u} (gradedFiniteProjectiveModulesExactStructure (polyGrade k))) :=
  gradedSplitProjectiveBasis
    completeOrthogonalIdempotents_unit_one
    (fun _ => isHomogeneous_span_one_polyGrade k)
    (fun _ => polyGrade_eq_bot_of_neg k)
    (polyGrade_zero_le_span_one k)
    (fun _ => one_ne_zero)

/-- The free rank-one graded `k[X]`-module `Ideal.span {1} ≅ k[X]`. -/
abbrev polyFreeModule : GradedModuleCat.{u} (polyGrade k) :=
  GradedModuleCat.ofIdeal (polyGrade k) (Ideal.span {(1 : AddMonoidAlgebra k ℕ)})
    (isHomogeneous_span_one_polyGrade k)

/-- Multiplication by `X² = single 2 1` as a graded morphism `k[X]{2} ⟶ k[X]`. -/
def mulXSqHom : (polyFreeModule k).shiftObj 2 ⟶ polyFreeModule k :=
  GradedModuleCat.ofHom
    { toFun := fun x =>
        ⟨(x : AddMonoidAlgebra k ℕ) * AddMonoidAlgebra.single 2 (1 : k),
          Ideal.mem_span_singleton.mpr (one_dvd _)⟩
      map_add' := fun _ _ => Subtype.ext (add_mul _ _ _)
      map_smul' := fun a x => Subtype.ext (mul_assoc a x.1 _) } <|
    LinearMap.isHomogeneous_def.2 fun p x hx => by
      rw [GradedModuleCat.mem_shiftObj_piece_iff,
        GradedModuleCat.mem_ofIdeal_piece_iff (isHomogeneous_span_one_polyGrade k)] at hx
      rw [add_zero, GradedModuleCat.mem_ofIdeal_piece_iff (isHomogeneous_span_one_polyGrade k)]
      have hX2 : AddMonoidAlgebra.single (2 : ℕ) (1 : k) ∈ polyGrade k 2 :=
        AddMonoidAlgebra.single_mem_gradeBy _ 2 1
      have hmul := SetLike.GradedMul.mul_mem hx hX2
      rwa [sub_add_cancel] at hmul

private theorem mono_mulXSqHom : Mono (mulXSqHom k) := by
  refine (GradedModuleCat.mono_iff_injective (mulXSqHom k)).mpr fun x y hxy => ?_
  apply Subtype.ext
  ext m
  have hm := congrArg (fun z : polyFreeModule k => (z : AddMonoidAlgebra k ℕ).coeff (m + 2)) hxy
  simpa [mulXSqHom] using hm

/-- **The graded quotient module `k[X] ⧸ (X²)`**, realized as the cokernel of multiplication by
`X² = single 2 1` on the free graded module `polyFreeModule k`. -/
abbrev polyModXSq : GradedModuleCat.{u} (polyGrade k) :=
  GradedModuleCat.cokernelObj (mulXSqHom k)

/-- The short exact sequence `0 ⟶ k[X]{2} ⟶ k[X] ⟶ k[X] ⧸ (X²) ⟶ 0` in `GradedModuleCat`. -/
abbrev polyModXSqShortComplex : ShortComplex (GradedModuleCat.{u} (polyGrade k)) :=
  ShortComplex.mk (mulXSqHom k) (GradedModuleCat.cokernelπ (mulXSqHom k))
    (GradedModuleCat.comp_cokernelπ (mulXSqHom k))

/-- `polyModXSqShortComplex k` is short exact. -/
theorem shortExact_polyModXSqShortComplex : (polyModXSqShortComplex k).ShortExact := by
  have hmono : Mono (mulXSqHom k) := mono_mulXSqHom k
  have hepi : Epi (GradedModuleCat.cokernelπ (mulXSqHom k)) :=
    (GradedModuleCat.epi_iff_surjective _).mpr (Submodule.mkQ_surjective _)
  refine ShortComplex.ShortExact.mk' (GradedModuleCat.exact_iff.mpr fun x => ?_) hmono hepi
  exact Submodule.Quotient.mk_eq_zero _

instance moduleProjective_polyFreeModule :
    Module.Projective (AddMonoidAlgebra k ℕ) (polyFreeModule k) :=
  IsIdempotentElem.one.projective_span_singleton

instance moduleFinite_polyFreeModule :
    Module.Finite (AddMonoidAlgebra k ℕ) (polyFreeModule k) :=
  Module.Finite.iff_fg.mpr (Submodule.fg_span_singleton 1)

/-- **The minimal graded projective resolution `0 ⟶ k[X]{2} ⟶ k[X] ⟶ k[X] ⧸ (X²) ⟶ 0`.** -/
def polyModXSqResolution :
    GradedProjectiveResolution.{u, u, u, u} (polyGrade k) (polyModXSq k).grading :=
  GradedProjectiveResolution.ofShortExact (shortExact_polyModXSqShortComplex k)

instance moduleFinite_polyModXSqResolution (n : ℕ) :
    Module.Finite (AddMonoidAlgebra k ℕ) ((polyModXSqResolution k).X n) :=
  GradedProjectiveResolution.moduleFinite_ofShortExact (shortExact_polyModXSqShortComplex k) n

/-- **Worked check (`k[X] ⧸ (X²)`)**: the Betti Poincaré series of `polyModXSqResolution k` is
`1 + C (T 2) * X` (`1 + q² t`). -/
theorem bettiPoincareSeries_polyModXSqResolution :
    bettiPoincareSeries (polyProjectiveBasis k) (polyModXSqResolution k) () =
      1 + PowerSeries.C (T 2) * PowerSeries.X := by
  have hP₀ : gradedFiniteProjectiveModules (polyGrade k) (polyFreeModule k) :=
    gradedFiniteProjectiveModules_ofIdeal_span_singleton IsIdempotentElem.one
      (isHomogeneous_span_one_polyGrade k)
  have hP₁ : gradedFiniteProjectiveModules (polyGrade k) ((polyFreeModule k).shiftObj 2) :=
    gradedFiniteProjectiveModules_shiftObj hP₀ 2
  unfold polyModXSqResolution
  rw [GradedProjectiveResolution.bettiPoincareSeries_ofShortExact (polyProjectiveBasis k)
    (shortExact_polyModXSqShortComplex k) hP₁ hP₀ ()]
  let P₀ : (gradedFiniteProjectiveModules (polyGrade k)).FullSubcategory := ⟨polyFreeModule k, hP₀⟩
  have h0 : LaurentK0.of.{u} (gradedFiniteProjectiveModulesExactStructure (polyGrade k)) P₀ =
      polyProjectiveBasis k () := by
    symm
    unfold polyProjectiveBasis
    exact gradedSplitProjectiveBasis_apply _ _ _ _ _ ()
  have h1 : LaurentK0.of.{u} (gradedFiniteProjectiveModulesExactStructure (polyGrade k))
      ⟨P₀.obj.shiftObj 2, gradedFiniteProjectiveModules_shiftObj P₀.property 2⟩ =
      (T 2 : LaurentPolynomial ℤ) • polyProjectiveBasis k () := by
    rw [laurentK0_projective_of_shiftObj P₀ 2, h0]
  dsimp only [P₀] at h0 h1
  rw [h0, h1, (polyProjectiveBasis k).repr.map_smul, Finsupp.smul_apply,
    Module.Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one, map_one]

/-- **`polyModXSqResolution k` is minimal**: multiplication by `X²` lands in `k[X]₊ · k[X]`. -/
theorem isMinimal_polyModXSqResolution : (polyModXSqResolution k).IsMinimal := by
  unfold polyModXSqResolution
  rw [GradedProjectiveResolution.isMinimal_ofShortExact_iff]
  intro x
  have hX2 : AddMonoidAlgebra.single (2 : ℕ) (1 : k) ∈ polyGrade k 2 :=
    AddMonoidAlgebra.single_mem_gradeBy _ 2 1
  have hpos : AddMonoidAlgebra.single (2 : ℕ) (1 : k) ∈
      ⨆ (i : ℤ) (_ : 0 < i), polyGrade k i :=
    Submodule.mem_iSup_of_mem (2 : ℤ) (Submodule.mem_iSup_of_mem (by omega) hX2)
  have hsmul : (mulXSqHom k).hom x =
      AddMonoidAlgebra.single (2 : ℕ) (1 : k) •
        (⟨(x : AddMonoidAlgebra k ℕ), x.2⟩ : polyFreeModule k) :=
    Subtype.ext (mul_comm _ _)
  rw [hsmul]
  exact Submodule.smul_mem_smul hpos Submodule.mem_top

/-- **`polyModXSqResolution k` is NOT linear**: its `t¹`-term sits in internal degree `2 ≠ 1`. -/
theorem not_isLinear_polyModXSqResolution : ¬ (polyModXSqResolution k).IsLinear := by
  rw [(polyModXSqResolution k).isLinear_iff_diagonal_bettiPoincareSeries
    completeOrthogonalIdempotents_unit_one
    (fun _ => isHomogeneous_span_one_polyGrade k)
    (fun _ => polyGrade_eq_bot_of_neg k)
    (polyGrade_zero_le_span_one k)
    (fun _ => one_ne_zero)
    (polyProjectiveBasis k)
    (fun i => by unfold polyProjectiveBasis; exact gradedSplitProjectiveBasis_apply _ _ _ _ _ i)]
  intro hdiag
  have h := hdiag () 1 2 (by omega)
  rw [bettiPoincareSeries_polyModXSqResolution, map_add, PowerSeries.coeff_one,
    PowerSeries.coeff_C_mul] at h
  simp only [one_ne_zero, ↓reduceIte, zero_add, PowerSeries.coeff_X, mul_one] at h
  rw [T, AddMonoidAlgebra.coeff_single, Finsupp.single_eq_same] at h
  exact one_ne_zero h

end TauCeti
