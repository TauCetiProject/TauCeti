module

public import TauCeti.Algebra.Category.GradedModuleCat.BettiPoincare.Linearity
public import TauCeti.Algebra.DualNumber.Grading

/-!
# Worked check: the periodic linear resolution over `k[ε] / (ε²)`

Give `DualNumber k` (`k[ε] / (ε²)`) its degree-one grading `TauCeti.dualNumberDegOneIntegerGrade k`
with `deg ε = 1`. Over a field `k`, the unique degree-zero simple module is the residue field
`S = A / A₊` (`TauCeti.dualNumberResidueSimple k`). Multiplication by `ε = DualNumber.eps` gives an
infinite periodic minimal linear resolution

`⋯ ⟶ A{2} ⟶ A{1} ⟶ A ⟶ k ⟶ 0`

(`TauCeti.dualNumberResidueResolution k`), since `ker(· * ε) = k · ε = im(· * ε)` on `DualNumber k`.
In the rank-one basis `[A]` of `K₀^gr(proj A)`:

* its Betti Poincaré series is `∑_{n ≥ 0} qⁿ tⁿ` (`PowerSeries.mk fun n => T n`), satisfying the
  rational identity `(1 - q t) · B_k(q, t) = 1`;
* every entry is supported on the diagonal `p = n`, so the resolution is linear and minimal;
* because minimal resolutions retract out of any projective resolution, **every** graded projective
  resolution of `k` has nontrivial terms in every homological degree `n : ℕ` — `k` admits no finite
  graded projective resolution, while `B_k(q, t) ∈ ℤ[q,q⁻¹]⟦t⟧` remains well-defined without any
  finite global dimension hypothesis.

## Main definitions

* `TauCeti.dualNumberDegOneProjectiveBasis`: the `ℤ[q,q⁻¹]`-basis `[A]` of `K₀^gr(proj k[ε]/(ε²))`.
* `TauCeti.dualNumberResidueSimple`: the graded residue simple `k = A / A₊`.
* `TauCeti.dualNumberResidueResolution`: the periodic resolution `⋯ ⟶ A{2} ⟶ A{1} ⟶ A ⟶ k ⟶ 0`.

## Main results

* `TauCeti.bettiPoincareSeries_dualNumberResidueResolution`: `B_k(q, t) = ∑_{n ≥ 0} qⁿ tⁿ`.
* `TauCeti.one_sub_C_T_mul_X_mul_bettiPoincareSeries_dualNumberResidueResolution`:
  `(1 - C (T 1) * X) * B_k(q, t) = 1`.
* `TauCeti.isLinear_dualNumberResidueResolution` and
  `TauCeti.isMinimal_dualNumberResidueResolution`: the periodic resolution is linear and minimal.
* `TauCeti.nontrivial_gradedProjectiveResolution_dualNumberResidueSimple` and
  `TauCeti.not_exists_subsingleton_gradedProjectiveResolution_dualNumberResidueSimple`: no graded
  projective resolution of `k` over `k[ε]/(ε²)` terminates in finite homological degree.
-/

public section

noncomputable section

namespace TauCeti

open CategoryTheory LaurentPolynomial

universe u

variable (k : Type u) [Field k]

/-- The unit ideal `Ideal.span {1}` of `DualNumber k` is homogeneous in the degree-one grading. -/
theorem isHomogeneous_span_one_dualNumberDegOne :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    (Ideal.span {(1 : DualNumber k)} : Ideal (DualNumber k)).IsHomogeneous
      (dualNumberDegOneIntegerGrade k) :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  Ideal.isHomogeneous_span_singleton (dualNumberDegOneIntegerGrade k)
    ⟨0, one_mem_dualNumberDegOneIntegerGrade_zero k⟩

private theorem completeOrthogonalIdempotents_unit_one_dual :
    CompleteOrthogonalIdempotents (fun _ : Unit => (1 : DualNumber k)) :=
  ⟨⟨fun _ => IsIdempotentElem.one, fun _ _ h => absurd (Subsingleton.elim _ _) h⟩, by simp⟩

private theorem dualNumberDegOneIntegerGrade_zero_le_span_one :
    dualNumberDegOneIntegerGrade k 0 ≤
      Submodule.span k (Set.range fun _ : Unit => (1 : DualNumber k)) := by
  rw [dualNumberDegOneIntegerGrade_zero_eq_span_one k]
  refine Submodule.span_mono ?_
  rintro _ ⟨rfl⟩
  exact ⟨(), rfl⟩

/-- The `ℤ[q,q⁻¹]`-basis of `K₀^gr(proj k[ε]/(ε²))` indexed by `Unit`, generated by `[A]`. -/
def dualNumberDegOneProjectiveBasis :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    Module.Basis Unit (LaurentPolynomial ℤ)
      (LaurentK0.{u}
        (gradedFiniteProjectiveModulesExactStructure (dualNumberDegOneIntegerGrade k))) :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  gradedSplitProjectiveBasis
    (completeOrthogonalIdempotents_unit_one_dual k)
    (fun _ => isHomogeneous_span_one_dualNumberDegOne k)
    (fun _ => dualNumberDegOneIntegerGrade_eq_bot_of_neg k)
    (dualNumberDegOneIntegerGrade_zero_le_span_one k)
    (fun _ => one_ne_zero)

/-- The free rank-one graded `DualNumber k`-module `Ideal.span {1}`. -/
abbrev dualNumberFreeModule :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    GradedModuleCat.{u} (dualNumberDegOneIntegerGrade k) :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  GradedModuleCat.ofIdeal (dualNumberDegOneIntegerGrade k)
    (Ideal.span {(1 : DualNumber k)}) (isHomogeneous_span_one_dualNumberDegOne k)

/-- **The graded residue simple `k = A / A₊` over `DualNumber k`** in degree zero. -/
abbrev dualNumberResidueSimple :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    GradedModuleCat.{u} (dualNumberDegOneIntegerGrade k) :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  gradedPositiveMulQuotient (dualNumberDegOneIntegerGrade k)
    (one_mem_dualNumberDegOneIntegerGrade_zero k)

private theorem mem_gradedPositiveMulIdeal_one_iff (x : DualNumber k) :
    x ∈ gradedPositiveMulIdeal (dualNumberDegOneIntegerGrade k) (1 : DualNumber k) ↔
      x.fst = 0 := by
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · have hle : gradedPositiveMulIdeal (dualNumberDegOneIntegerGrade k) (1 : DualNumber k) ≤
        RingHom.ker (TrivSqZeroExt.fstHom k k k) := by
      refine (gradedPositiveMulIdeal_le_iff _).mpr fun p hp y hy => ?_
      lift p to ℕ using hp.le
      rw [dualNumberDegOneIntegerGrade_ofNat] at hy
      rcases eq_or_ne p 1 with rfl | hp1
      · rw [mem_dualNumberDegOneGrade_one] at hy
        simp [RingHom.mem_ker, hy]
      · have hp0 : p ≠ 0 := by omega
        have hy0 : y = 0 := by simpa [dualNumberDegOneGrade_eq_bot k hp0 hp1] using hy
        simp [hy0]
    exact hle hx
  · have hx1 : x ∈ dualNumberDegOneIntegerGrade k 1 := by
      rw [← Nat.cast_one, dualNumberDegOneIntegerGrade_ofNat, mem_dualNumberDegOneGrade_one]
      exact hx
    simpa only [mul_one] using mul_mem_gradedPositiveMulIdeal
      (dualNumberDegOneIntegerGrade k) (e := (1 : DualNumber k)) (by omega : (0 : ℤ) < 1) hx1

private def mulEpsLinearMap :
    (Ideal.span {(1 : DualNumber k)} : Ideal (DualNumber k)) →ₗ[DualNumber k]
      (Ideal.span {(1 : DualNumber k)} : Ideal (DualNumber k)) where
  toFun x := ⟨(x : DualNumber k) * DualNumber.eps, Ideal.mem_span_singleton.mpr (one_dvd _)⟩
  map_add' _ _ := Subtype.ext (add_mul _ _ _)
  map_smul' a x := Subtype.ext (mul_assoc a x.1 _)

private theorem fst_eq_zero_iff_exists_mulEps
    (x : (Ideal.span {(1 : DualNumber k)} : Ideal (DualNumber k))) :
    (x : DualNumber k).fst = 0 ↔ ∃ y, mulEpsLinearMap k y = x := by
  refine ⟨fun hx => ?_, ?_⟩
  · refine ⟨⟨TrivSqZeroExt.inl (x : DualNumber k).snd,
      Ideal.mem_span_singleton.mpr (one_dvd _)⟩, Subtype.ext ?_⟩
    apply TrivSqZeroExt.ext
    · simp [mulEpsLinearMap, hx]
    · simp [mulEpsLinearMap]
  · rintro ⟨y, rfl⟩
    simp [mulEpsLinearMap]

/-- **The infinite periodic graded projective resolution `⋯ ⟶ A{2} ⟶ A{1} ⟶ A ⟶ k ⟶ 0`** of the
residue simple over `DualNumber k` with `deg ε = 1`. -/
def dualNumberResidueResolution :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    GradedProjectiveResolution.{u, u, u, u} (dualNumberDegOneIntegerGrade k)
      (dualNumberResidueSimple k).grading :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  { X := fun n => ((dualNumberFreeModule k).shiftObj n).carrier
    addCommGroup := fun n => ((dualNumberFreeModule k).shiftObj n).isAddCommGroup
    module := fun n => ((dualNumberFreeModule k).shiftObj n).isModule
    moduleBase := fun n => ((dualNumberFreeModule k).shiftObj n).isModuleBase
    isScalarTower := fun n => ((dualNumberFreeModule k).shiftObj n).isScalarTower
    grading := fun n => ((dualNumberFreeModule k).shiftObj n).grading
    gradedSMul := fun n => ((dualNumberFreeModule k).shiftObj n).gradedSMul
    projective := fun _ => IsIdempotentElem.one.projective_span_singleton
    d := fun _ => mulEpsLinearMap k
    π := gradedPositiveMulQuotientMk (one_mem_dualNumberDegOneIntegerGrade_zero k)
    isHomogeneous_d := fun n => LinearMap.isHomogeneous_def.2 fun p x hx => by
      rw [GradedModuleCat.mem_shiftObj_piece_iff,
        GradedModuleCat.mem_ofIdeal_piece_iff (isHomogeneous_span_one_dualNumberDegOne k)] at hx
      rw [add_zero, GradedModuleCat.mem_shiftObj_piece_iff,
        GradedModuleCat.mem_ofIdeal_piece_iff (isHomogeneous_span_one_dualNumberDegOne k)]
      have hmul := SetLike.GradedMul.mul_mem hx (eps_mem_dualNumberDegOneIntegerGrade_one k)
      have hp : p - ((n + 1 : ℕ) : ℤ) + 1 = p - (n : ℤ) := by omega
      rwa [hp] at hmul
    isHomogeneous_π := LinearMap.isHomogeneous_def.2 fun p x hx => by
      rw [GradedModuleCat.mem_shiftObj_piece_iff, Nat.cast_zero, sub_zero,
        GradedModuleCat.mem_ofIdeal_piece_iff (isHomogeneous_span_one_dualNumberDegOne k)] at hx
      -- `dualNumberResidueSimple k` is an `abbrev` for `gradedPositiveMulQuotient`.
      change gradedPositiveMulQuotientMk (one_mem_dualNumberDegOneIntegerGrade_zero k) x ∈
        (gradedPositiveMulQuotient (dualNumberDegOneIntegerGrade k)
          (one_mem_dualNumberDegOneIntegerGrade_zero k)).grading.piece (p + 0)
      rw [add_zero, mem_gradedPositiveMulQuotient_piece_iff]
      exact ⟨x, hx, rfl⟩
    surjective_π := gradedPositiveMulQuotientMk_surjective _
    exact_d_π := fun x => by
      -- The `0`-shift carrier is definitionally `Ideal.span {1}`.
      change gradedPositiveMulQuotientMk (one_mem_dualNumberDegOneIntegerGrade_zero k) x = 0 ↔
        ∃ y, mulEpsLinearMap k y = x
      rw [gradedPositiveMulQuotientMk_eq_zero_iff, mem_gradedPositiveMulIdeal_one_iff]
      exact fst_eq_zero_iff_exists_mulEps k x
    exact_d_d := fun _ x => by
      have hker : mulEpsLinearMap k x = 0 ↔ (x : DualNumber k).fst = 0 := by
        rw [Subtype.ext_iff]
        refine ⟨fun h => ?_, fun hx => TrivSqZeroExt.ext (by simp [mulEpsLinearMap])
          (by simp [mulEpsLinearMap, hx])⟩
        simpa [mulEpsLinearMap] using congrArg TrivSqZeroExt.snd h
      rw [hker]
      exact fst_eq_zero_iff_exists_mulEps k x }

instance moduleFinite_dualNumberResidueResolution (n : ℕ) :
    Module.Finite (DualNumber k) ((dualNumberResidueResolution k).X n) :=
  Module.Finite.iff_fg.mpr (Submodule.fg_span_singleton 1)

/-- **Worked check (`k[ε] / (ε²)`)**: the Betti Poincaré series of the residue simple `k` is
`∑_{n ≥ 0} qⁿ tⁿ` (`PowerSeries.mk fun n => T n`). -/
theorem bettiPoincareSeries_dualNumberResidueResolution :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    bettiPoincareSeries (dualNumberDegOneProjectiveBasis k) (dualNumberResidueResolution k) () =
      PowerSeries.mk fun n => T (n : ℤ) := by
  dsimp only
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  refine PowerSeries.ext fun n => ?_
  rw [coeff_bettiPoincareSeries, PowerSeries.coeff_mk]
  have hP₀ : gradedFiniteProjectiveModules (dualNumberDegOneIntegerGrade k)
      (dualNumberFreeModule k) :=
    gradedFiniteProjectiveModules_ofIdeal_span_singleton IsIdempotentElem.one
      (isHomogeneous_span_one_dualNumberDegOne k)
  let P₀ : (gradedFiniteProjectiveModules (dualNumberDegOneIntegerGrade k)).FullSubcategory :=
    ⟨dualNumberFreeModule k, hP₀⟩
  let Q : (gradedFiniteProjectiveModules (dualNumberDegOneIntegerGrade k)).FullSubcategory :=
    ⟨P₀.obj.shiftObj n, gradedFiniteProjectiveModules_shiftObj P₀.property n⟩
  have hiso : ((dualNumberResidueResolution k).finiteProjectiveTerm n).obj ≅ Q.obj :=
    eqToIso (((dualNumberResidueResolution k).finiteProjectiveTerm_obj n))
  have h0 : LaurentK0.of.{u}
      (gradedFiniteProjectiveModulesExactStructure (dualNumberDegOneIntegerGrade k)) P₀ =
      dualNumberDegOneProjectiveBasis k () := by
    symm
    unfold dualNumberDegOneProjectiveBasis
    exact gradedSplitProjectiveBasis_apply _ _ _ _ _ ()
  rw [LaurentK0.of_congr.{u} _ (ObjectProperty.isoMk
      (gradedFiniteProjectiveModules (dualNumberDegOneIntegerGrade k))
      (X := (dualNumberResidueResolution k).finiteProjectiveTerm n) (Y := Q) hiso)]
  dsimp only [Q]
  rw [laurentK0_projective_of_shiftObj P₀ n, h0,
    (dualNumberDegOneProjectiveBasis k).repr.map_smul, Finsupp.smul_apply,
    Module.Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one]

/-- **Rational closed form**: `(1 - q t) · B_k(q, t) = 1` in `ℤ[q,q⁻¹]⟦t⟧`. -/
theorem one_sub_C_T_mul_X_mul_bettiPoincareSeries_dualNumberResidueResolution :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    (1 - PowerSeries.C (T 1) * PowerSeries.X) *
      bettiPoincareSeries (dualNumberDegOneProjectiveBasis k)
        (dualNumberResidueResolution k) () = 1 := by
  dsimp only
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  rw [bettiPoincareSeries_dualNumberResidueResolution, sub_mul, one_mul]
  refine PowerSeries.ext fun n => ?_
  cases n with
  | zero => simp [T_zero]
  | succ m =>
      rw [map_sub, PowerSeries.coeff_mk, mul_assoc, PowerSeries.coeff_C_mul,
        PowerSeries.coeff_succ_X_mul, PowerSeries.coeff_mk, ← T_add, PowerSeries.coeff_one]
      have hcast : (1 : ℤ) + (m : ℤ) = ((m + 1 : ℕ) : ℤ) := by omega
      simp [hcast]

/-- **The periodic resolution of `k` over `k[ε] / (ε²)` is linear.** -/
theorem isLinear_dualNumberResidueResolution :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    (dualNumberResidueResolution k).IsLinear := by
  dsimp only
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  refine ((dualNumberResidueResolution k).isLinear_iff_diagonal_bettiPoincareSeries
    (completeOrthogonalIdempotents_unit_one_dual k)
    (fun _ => isHomogeneous_span_one_dualNumberDegOne k)
    (fun _ => dualNumberDegOneIntegerGrade_eq_bot_of_neg k)
    (dualNumberDegOneIntegerGrade_zero_le_span_one k)
    (fun _ => one_ne_zero)
    (dualNumberDegOneProjectiveBasis k)
    (fun i => by
      unfold dualNumberDegOneProjectiveBasis
      exact gradedSplitProjectiveBasis_apply _ _ _ _ _ i)).mpr fun _ n p hpn => ?_
  rw [bettiPoincareSeries_dualNumberResidueResolution, PowerSeries.coeff_mk, T,
    AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  have hnp : (n : ℤ) ≠ p := Ne.symm hpn
  simp [hnp]

/-- **The periodic resolution of `k` over `k[ε] / (ε²)` is minimal.** -/
theorem isMinimal_dualNumberResidueResolution :
    let _ := dualNumberDegOneIntegerGradedAlgebra k
    (dualNumberResidueResolution k).IsMinimal :=
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  (isLinear_dualNumberResidueResolution k).isMinimal
    (fun _ => dualNumberDegOneIntegerGrade_eq_bot_of_neg k)

/-- **Infinite projective dimension of the residue field over `k[ε] / (ε²)`.** Every graded
projective resolution `r'` of `dualNumberResidueSimple k` (minimal or not, finitely generated or
not) has a nontrivial term in every homological degree `n : ℕ`. -/
theorem nontrivial_gradedProjectiveResolution_dualNumberResidueSimple
    (r' : let _ := dualNumberDegOneIntegerGradedAlgebra k
      GradedProjectiveResolution.{u, u, u, u} (dualNumberDegOneIntegerGrade k)
        (dualNumberResidueSimple k).grading)
    (n : ℕ) : Nontrivial (r'.X n) := by
  let _ := dualNumberDegOneIntegerGradedAlgebra k
  let r := dualNumberResidueResolution k
  have hr : r.IsMinimal := isMinimal_dualNumberResidueResolution k
  have hbelow : ∀ m, ∃ b : ℤ, ∀ p < b, (r.grading m).piece p = ⊥ := fun m =>
    (r.grading m).exists_piece_eq_bot_of_lt (dualNumberDegOneIntegerGrade k)
      (fun _ => dualNumberDegOneIntegerGrade_eq_bot_of_neg k)
  let P := r.toProjectiveResolution
  let Q := r'.toProjectiveResolution
  let f : P.complex ⟶ Q.complex := ProjectiveResolution.lift (𝟙 (dualNumberResidueSimple k)) P Q
  let g : Q.complex ⟶ P.complex := ProjectiveResolution.lift (𝟙 (dualNumberResidueSimple k)) Q P
  have hfg : IsIso (f ≫ g) := hr.isIso_of_homotopy_id hbelow
    (ProjectiveResolution.liftHomotopy (𝟙 _) (f ≫ g) (𝟙 P.complex) (by simp [f, g]) (by simp))
  let u : r.termObj n ⟶ r'.termObj n :=
    (r.toProjectiveResolutionXIso n).inv ≫ f.f n ≫ (r'.toProjectiveResolutionXIso n).hom
  let v : r'.termObj n ⟶ r.termObj n :=
    (r'.toProjectiveResolutionXIso n).inv ≫ g.f n ≫ (r.toProjectiveResolutionXIso n).hom
  have huv_eq : u ≫ v =
      (r.toProjectiveResolutionXIso n).inv ≫ (f ≫ g).f n ≫
        (r.toProjectiveResolutionXIso n).hom := by
    simp [u, v]
  have : IsIso ((HomologicalComplex.eval _ _ n).map (f ≫ g)) := inferInstance
  have huv : IsIso (u ≫ v) := by
    rw [huv_eq]
    exact inferInstanceAs (IsIso ((r.toProjectiveResolutionXIso n).inv ≫
      (HomologicalComplex.eval _ _ n).map (f ≫ g) ≫ (r.toProjectiveResolutionXIso n).hom))
  have hinj : Function.Injective u.hom :=
    Function.Injective.of_comp (f := v.hom)
      ((GradedModuleCat.isIso_iff_bijective (u ≫ v)).mp huv).1
  exact ⟨u.hom ⟨1, Ideal.subset_span rfl⟩, u.hom 0,
    fun h => one_ne_zero (congrArg Subtype.val (hinj h))⟩

/-- **No graded projective resolution of `k` over `k[ε] / (ε²)` is finite.** -/
theorem not_exists_subsingleton_gradedProjectiveResolution_dualNumberResidueSimple
    (r' : let _ := dualNumberDegOneIntegerGradedAlgebra k
      GradedProjectiveResolution.{u, u, u, u} (dualNumberDegOneIntegerGrade k)
        (dualNumberResidueSimple k).grading) :
    ¬ ∃ N : ℕ, ∀ n ≥ N, Subsingleton (r'.X n) := by
  rintro ⟨N, hN⟩
  obtain ⟨x, y, hxy⟩ := nontrivial_gradedProjectiveResolution_dualNumberResidueSimple k r' N
  exact hxy ((hN N le_rfl).elim x y)

end TauCeti
