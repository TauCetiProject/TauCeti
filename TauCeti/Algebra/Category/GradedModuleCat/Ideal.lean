module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import TauCeti.Algebra.Category.GradedModuleCat.IdempotentGradedDimension
public import TauCeti.Algebra.Category.GradedModuleCat.Projective
public import TauCeti.Algebra.Module.GradedModule.Quotient
public import TauCeti.RingTheory.Idempotents.Corner
public import TauCeti.RingTheory.Idempotents.Projective

/-!
# Homogeneous left ideals as graded modules

Let `A` be a `k`-algebra graded by `𝒜 : ℤ → Submodule k A`. A homogeneous left ideal `I` of `A`
is a graded `A`-module whose degree-`p` piece is `I ∩ 𝒜 p`. This file records it as an object
`TauCeti.GradedModuleCat.ofIdeal 𝒜 I hI` of the category of graded modules.

The main example is the left ideal `Af` generated by an idempotent `f`, which is homogeneous as
soon as `f` is (`Ideal.homogeneous_span`; a nonzero homogeneous idempotent has degree zero). For
idempotent `f` the module `Af` is projective, being a direct summand of `A`, and so it is a
projective object of the graded category. Examples are the vertex projectives of a path algebra
or of a zigzag algebra graded by path length, generated by the vertex idempotents.

For an idempotent `e` of degree zero, the subspaces `e • (Af)ₚ` read off by the idempotent graded
dimension `TauCeti.GradedModuleCat.smulGradedDimension` are the graded pieces `eAf ∩ 𝒜 p` of the
corner `eAf`. Hence the graded dimension of `e • Af` is `∑ₚ dim_k(eAf ∩ 𝒜 p) qᵖ`: this is the
formula for the graded Cartan matrix in idempotent coordinates.

## Main definitions

* `TauCeti.GradedModuleCat.ofIdeal 𝒜 I hI`: a homogeneous left ideal as a graded module.

## Main results

* `TauCeti.GradedModuleCat.projective_ofIdeal_span_singleton`: `Af` is a projective graded module
  for an idempotent `f`.
* `TauCeti.GradedModuleCat.map_subtype_smul_ofIdeal_span_singleton_piece`: `e • (Af)ₚ`, viewed
  inside `A`, is the graded piece `eAf ∩ 𝒜 p` of the corner.
* `TauCeti.GradedModuleCat.coeff_smulGradedDimension_ofIdeal_span_singleton`: the coefficient of
  `qᵖ` in the graded dimension of `e • Af` is `dim_k(eAf ∩ 𝒜 p)`.

## References

* C. Năstăsescu and F. Van Oystaeyen, *Methods of Graded Rings*, Section 2.3, for graded modules
  and projectivity in the graded category.
* I. Assem, D. Simson, A. Skowroński, *Elements of the Representation Theory of Associative
  Algebras, Vol. 1*, Sections I.4 and III.3, for the projectives `Af` and the corners `eAf` as
  Cartan-matrix entries.
-/

public section

noncomputable section

namespace TauCeti.GradedModuleCat

open CategoryTheory
open scoped Pointwise

universe uk uA

section CommRing

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  (𝒜 : ℤ → Submodule k A) [GradedAlgebra 𝒜]

/-! ### Homogeneous left ideals -/

/-- A **homogeneous left ideal** `I` of a graded algebra, as a graded module: its degree-`p` piece
consists of the elements of `I` of degree `p` in `A`. -/
abbrev ofIdeal (I : Ideal A) (hI : I.IsHomogeneous 𝒜) : GradedModuleCat.{uA} 𝒜 where
  carrier := I
  isAddCommGroup := Submodule.addCommGroup _
  isModule := Submodule.module _
  isModuleBase := Submodule.module' _
  grading := (InternalGrading.ofDecomposition 𝒜).submodule (I.restrictScalars k)
    ((InternalGrading.isHomogeneous_ofDecomposition_piece_iff 𝒜 _).2 fun p _ hx ↦ hI p hx)
  gradedSMul := ⟨fun {_ _} _ _ ha hx ↦ by
    simp only [InternalGrading.submodule_piece, InternalGrading.ofDecomposition_piece] at hx ⊢
    exact SetLike.GradedMul.mul_mem ha hx⟩

variable {𝒜}

/-- An element of a homogeneous left ideal has degree `p` exactly when it has degree `p` in the
algebra. -/
theorem mem_ofIdeal_piece_iff {I : Ideal A} (hI : I.IsHomogeneous 𝒜) {p : ℤ} {x : I} :
    x ∈ (ofIdeal 𝒜 I hI).grading.piece p ↔ (x : A) ∈ 𝒜 p := by
  simp only [InternalGrading.submodule_piece, InternalGrading.ofDecomposition_piece]
  exact Iff.rfl

/-! ### The left ideal generated by an idempotent -/

/-- **The left ideal generated by an idempotent is a projective graded module**: its underlying
module is a direct summand of `A`. -/
theorem projective_ofIdeal_span_singleton {f : A} (hf : IsIdempotentElem f)
    (hI : (Ideal.span {f} : Ideal A).IsHomogeneous 𝒜) :
    Projective (ofIdeal 𝒜 (Ideal.span {f}) hI) :=
  have := hf.projective_span_singleton
  projective_of_module_projective _

/-- **The idempotent pieces of `Af` are graded corners.** For idempotents `e` of degree zero and
`f`, the subspace `e • (Af)ₚ`, viewed inside `A`, is the degree-`p` part `eAf ∩ 𝒜 p` of the corner
`eAf`. -/
theorem map_subtype_smul_ofIdeal_span_singleton_piece {e f : A} (he : IsIdempotentElem e)
    (he₀ : e ∈ 𝒜 0) (hf : IsIdempotentElem f) (hI : (Ideal.span {f} : Ideal A).IsHomogeneous 𝒜)
    (p : ℤ) :
    (e • (ofIdeal 𝒜 (Ideal.span {f}) hI).grading.piece p).map
        ((Ideal.span {f} : Ideal A).subtype.restrictScalars k) =
      cornerSubmodule k e f ⊓ 𝒜 p := by
  ext y
  rw [Submodule.mem_map, Submodule.mem_inf, mem_cornerSubmodule_iff k he hf]
  constructor
  · rintro ⟨_, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hz
    have hxf := (mem_span_singleton_iff_mul_eq_self hf).1 x.2
    rw [LinearMap.restrictScalars_apply, Submodule.subtype_apply, Submodule.coe_smul,
      smul_eq_mul]
    refine ⟨by rw [mul_assoc, mul_assoc, hxf, ← mul_assoc, he.eq], ?_⟩
    simpa only [zero_add] using SetLike.GradedMul.mul_mem he₀ ((mem_ofIdeal_piece_iff hI).1 hx)
  · rintro ⟨hc, hy⟩
    have hyf : y ∈ (Ideal.span {f} : Ideal A) :=
      (mem_span_singleton_iff_mul_eq_self hf).2 (by rw [← hc, mul_assoc, hf.eq])
    have hey : e * y = y := by rw [← hc, ← mul_assoc, ← mul_assoc, he.eq]
    refine ⟨⟨y, hyf⟩, (Submodule.mem_smul_pointwise_iff_exists _ _ _).2
      ⟨⟨y, hyf⟩, (mem_ofIdeal_piece_iff hI).2 hy, Subtype.ext ?_⟩, rfl⟩
    rw [Submodule.coe_smul, smul_eq_mul, hey]

end CommRing

section Field

variable {k : Type uk} [Field k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜]

/-- **The graded dimension of `e • Af` is the graded dimension of the corner `eAf`**: the
coefficient of `qᵖ` is `dim_k(eAf ∩ 𝒜 p)`. -/
theorem coeff_smulGradedDimension_ofIdeal_span_singleton {e f : A} (he : IsIdempotentElem e)
    (he₀ : e ∈ 𝒜 0) (hf : IsIdempotentElem f) (hI : (Ideal.span {f} : Ideal A).IsHomogeneous 𝒜)
    [Module.Finite k (ofIdeal 𝒜 (Ideal.span {f}) hI)] (p : ℤ) :
    ((ofIdeal 𝒜 (Ideal.span {f}) hI).smulGradedDimension e).coeff p =
      Module.finrank k ↥(cornerSubmodule k e f ⊓ 𝒜 p) := by
  rw [coeff_smulGradedDimension,
    ← map_subtype_smul_ofIdeal_span_singleton_piece he he₀ hf hI p]
  exact congrArg _ (Submodule.equivMapOfInjective _ Subtype.val_injective _).finrank_eq

end Field

end TauCeti.GradedModuleCat
