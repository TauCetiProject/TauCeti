public import TauCeti.Algebra.Category.GradedModuleCat.Abelian
public import TauCeti.Algebra.Module.GradedModule.Generated

/-!
# Quotients concentrated in one internal degree

The degree quotient of a graded module kills the submodule generated by all pieces outside a
specified degree. It is the universal quotient concentrated in that degree. For a nonnegatively
graded algebra, it is annihilated by positive-degree scalars, and its surviving piece detects the
corresponding piece of the module modulo the positive-degree action.

Consequently, maps to modules concentrated in degree `p` detect whether the source's degree-`p`
piece lies in `A₊ M`. Combined with graded Nakayama, this detects generating degrees of minimal
projective resolution terms from their graded Hom groups.

## References

* C. Năstăsescu and F. Van Oystaeyen, *Methods of Graded Rings*, Section 2.3.
* A. Beilinson, V. Ginzburg and W. Soergel, *Koszul duality patterns in representation theory*,
  Section 1.2, for detection of generating degrees in minimal resolutions.
-/

public section

noncomputable section

namespace TauCeti.GradedModuleCat

open CategoryTheory _root_.DirectSum

universe uk uA v

variable {k : Type uk} [CommRing k] {A : Type uA} [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} [GradedAlgebra 𝒜]

/-- The submodule generated by all homogeneous pieces outside degree `p`. -/
def offDegreeSpan (M : GradedModuleCat.{v} 𝒜) (p : ℤ) : Submodule A M :=
  Submodule.span A {x | ∃ q : ℤ, q ≠ p ∧ x ∈ M.grading.piece q}

omit [GradedAlgebra 𝒜] in
/-- The off-degree span is contained in a submodule exactly when every off-degree piece is. -/
theorem offDegreeSpan_le_iff (M : GradedModuleCat.{v} 𝒜) (p : ℤ) (U : Submodule A M) :
    M.offDegreeSpan p ≤ U ↔
      ∀ q, q ≠ p → M.grading.piece q ≤ U.restrictScalars k := by
  rw [offDegreeSpan, Submodule.span_le]
  constructor
  · intro h q hq x hx
    exact h ⟨q, hq, hx⟩
  · rintro h x ⟨q, hq, hx⟩
    exact h q hq hx

omit [GradedAlgebra 𝒜] in
/-- A piece outside degree `p` lies in the submodule killed by the degree quotient. -/
theorem piece_le_offDegreeSpan (M : GradedModuleCat.{v} 𝒜) {p q : ℤ} (hq : q ≠ p) :
    M.grading.piece q ≤ (M.offDegreeSpan p).restrictScalars k :=
  fun _ hx ↦ Submodule.subset_span ⟨q, hq, hx⟩

/-- The submodule generated by the off-degree pieces is homogeneous. -/
theorem isHomogeneous_offDegreeSpan (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    SetLike.IsHomogeneous M.grading.piece ((M.offDegreeSpan p).restrictScalars k) := by
  classical
  intro q x hx
  rw [offDegreeSpan] at hx
  obtain ⟨n, c, g, rfl⟩ := Submodule.mem_span_set'.mp hx
  rw [decompose_sum, DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  obtain ⟨d, hd, hg⟩ := (g i).property
  have h := DirectSum.coe_decompose_smul_add_of_right_mem 𝒜 M.grading.piece hg
    (a := c i) (i := q - d)
  rw [sub_add_cancel] at h
  rw [h]
  exact (M.offDegreeSpan p).smul_mem _ (Submodule.subset_span ⟨d, hd, hg⟩)

/-- The homogeneous submodule generated by the off-degree pieces, as a graded module. -/
abbrev offDegreeObj (M : GradedModuleCat.{v} 𝒜) (p : ℤ) : GradedModuleCat.{v} 𝒜 where
  carrier := M.offDegreeSpan p
  isAddCommGroup := Submodule.addCommGroup _
  isModule := Submodule.module _
  isModuleBase := Submodule.module' _
  grading := M.grading.submodule ((M.offDegreeSpan p).restrictScalars k)
    (M.isHomogeneous_offDegreeSpan p) |>.map
      (((M.offDegreeSpan p).restrictScalarsEquiv k).restrictScalars k)
  gradedSMul := ⟨fun {_ _} _ _ ha hx ↦ by
    simp only [InternalGrading.mem_map_piece_iff, InternalGrading.mem_submodule_piece,
      LinearEquiv.restrictScalars] at hx ⊢
    exact SetLike.GradedSMul.smul_mem (B := M.grading.piece) ha hx⟩

/-- Membership in a homogeneous piece of the off-degree submodule is ambient membership. -/
theorem mem_offDegreeObj_piece_iff (M : GradedModuleCat.{v} 𝒜) (p q : ℤ)
    (x : M.offDegreeObj p) :
    x ∈ (M.offDegreeObj p).grading.piece q ↔ (x : M) ∈ M.grading.piece q := by
  rw [InternalGrading.mem_map_piece_iff, InternalGrading.mem_submodule_piece]
  -- Restricting scalars changes the module structure, and the transport has identity carrier map.
  rfl

/-- The inclusion of the submodule killed by the degree quotient. -/
def offDegreeι (M : GradedModuleCat.{v} 𝒜) (p : ℤ) : M.offDegreeObj p ⟶ M :=
  ofHom (M.offDegreeSpan p).subtype <|
    LinearMap.isHomogeneous_def.mpr fun q x hx ↦ by
      simpa only [add_zero, Submodule.subtype_apply] using
        (M.mem_offDegreeObj_piece_iff p q x).mp hx

/-- The off-degree inclusion has the underlying submodule inclusion as its linear map. -/
@[simp]
theorem hom_offDegreeι (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    (M.offDegreeι p).hom = (M.offDegreeSpan p).subtype :=
  (rfl)

/-- The universal quotient of `M` concentrated in internal degree `p`. -/
abbrev degreeQuotient (M : GradedModuleCat.{v} 𝒜) (p : ℤ) : GradedModuleCat.{v} 𝒜 :=
  cokernelObj (M.offDegreeι p)

/-- The projection onto the universal quotient concentrated in degree `p`. -/
def degreeQuotientπ (M : GradedModuleCat.{v} 𝒜) (p : ℤ) : M ⟶ M.degreeQuotient p :=
  cokernelπ (M.offDegreeι p)

/-- The underlying quotient projection is the usual projection by the inclusion's range. -/
theorem hom_degreeQuotientπ (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    (M.degreeQuotientπ p).hom = (LinearMap.range (M.offDegreeι p).hom).mkQ :=
  (rfl)

/-- The kernel of the degree quotient projection is the span of the off-degree pieces. -/
@[simp]
theorem degreeQuotientπ_eq_zero_iff (M : GradedModuleCat.{v} 𝒜) (p : ℤ) (x : M) :
    (M.degreeQuotientπ p).hom x = 0 ↔ x ∈ M.offDegreeSpan p := by
  rw [hom_degreeQuotientπ, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  simp only [hom_offDegreeι, Submodule.range_subtype]

/-- The quotient projection is surjective. -/
theorem degreeQuotientπ_surjective (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    Function.Surjective (M.degreeQuotientπ p).hom :=
  Submodule.mkQ_surjective _

/-- The degree-`q` piece of the degree quotient consists of classes of degree-`q` elements. -/
theorem mem_degreeQuotient_piece_iff (M : GradedModuleCat.{v} 𝒜) (p q : ℤ)
    (y : M.degreeQuotient p) :
    y ∈ (M.degreeQuotient p).grading.piece q ↔
      ∃ x ∈ M.grading.piece q, (M.degreeQuotientπ p).hom x = y :=
  mem_cokernelGrading_piece_iff _

/-- The degree quotient vanishes outside its specified degree. -/
@[simp]
theorem degreeQuotient_piece_eq_bot (M : GradedModuleCat.{v} 𝒜) {p q : ℤ} (hq : q ≠ p) :
    (M.degreeQuotient p).grading.piece q = ⊥ := by
  apply (Submodule.eq_bot_iff _).mpr
  intro y hy
  obtain ⟨x, hx, rfl⟩ := (M.mem_degreeQuotient_piece_iff p q y).mp hy
  exact (M.degreeQuotientπ_eq_zero_iff p x).mpr (M.piece_le_offDegreeSpan hq hx)

omit [GradedAlgebra 𝒜] in
/-- A graded map to a module concentrated in degree `p` kills the off-degree span. -/
theorem offDegreeSpan_le_ker {M N : GradedModuleCat.{v} 𝒜} (p : ℤ)
    (hN : ∀ q, q ≠ p → N.grading.piece q = ⊥) (f : M ⟶ N) :
    M.offDegreeSpan p ≤ LinearMap.ker f.hom := by
  apply (M.offDegreeSpan_le_iff p _).mpr
  intro q hq x hx
  have := map_mem f hx
  exact LinearMap.mem_ker.mpr (by simpa only [hN q hq, Submodule.mem_bot] using this)

/-- The canonical factorization of a graded map to a module concentrated in degree `p`
through the universal degree quotient. -/
def degreeQuotientLift {M N : GradedModuleCat.{v} 𝒜} (p : ℤ)
    (hN : ∀ q, q ≠ p → N.grading.piece q = ⊥) (f : M ⟶ N) :
    M.degreeQuotient p ⟶ N := by
  have hf : M.offDegreeι p ≫ f = 0 := by
    apply hom_ext
    ext x
    exact M.offDegreeSpan_le_ker p hN f x.property
  exact (Limits.CokernelCofork.IsColimit.desc'
    (cokernelIsColimit (M.offDegreeι p)) f hf).1

/-- Composing the canonical lift with the quotient projection recovers the original map. -/
@[reassoc (attr := simp)]
theorem degreeQuotientπ_degreeQuotientLift {M N : GradedModuleCat.{v} 𝒜} (p : ℤ)
    (hN : ∀ q, q ≠ p → N.grading.piece q = ⊥) (f : M ⟶ N) :
    M.degreeQuotientπ p ≫ degreeQuotientLift p hN f = f :=
  Limits.Cofork.IsColimit.π_desc (cokernelIsColimit (M.offDegreeι p))

/-- A map out of the degree quotient is uniquely determined by its composite with the
quotient projection. -/
theorem degreeQuotientLift_unique {M N : GradedModuleCat.{v} 𝒜} (p : ℤ)
    (hN : ∀ q, q ≠ p → N.grading.piece q = ⊥) (f : M ⟶ N)
    (g : M.degreeQuotient p ⟶ N) (hg : M.degreeQuotientπ p ≫ g = f) :
    g = degreeQuotientLift p hN f :=
  Limits.Cofork.IsColimit.hom_ext (cokernelIsColimit (M.offDegreeι p))
    (hg.trans (degreeQuotientπ_degreeQuotientLift p hN f).symm)

/-- Every graded map to a module concentrated in degree `p` factors uniquely through the
universal degree quotient. -/
theorem existsUnique_degreeQuotient_lift {M N : GradedModuleCat.{v} 𝒜} (p : ℤ)
    (hN : ∀ q, q ≠ p → N.grading.piece q = ⊥) (f : M ⟶ N) :
    ∃! g : M.degreeQuotient p ⟶ N, M.degreeQuotientπ p ≫ g = f :=
  ⟨degreeQuotientLift p hN f, degreeQuotientπ_degreeQuotientLift p hN f,
    fun g hg ↦ degreeQuotientLift_unique p hN f g hg⟩

variable (hneg : ∀ i < 0, 𝒜 i = ⊥)

include hneg in
/-- In the retained degree, the off-degree span contributes only positive-degree action. -/
theorem piece_inf_offDegreeSpan_le_positive_smul_top (M : GradedModuleCat.{v} 𝒜) (p : ℤ) :
    M.grading.piece p ⊓ (M.offDegreeSpan p).restrictScalars k ≤
      (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) := by
  classical
  rintro x ⟨hx, hu⟩
  obtain ⟨n, c, g, hg⟩ := Submodule.mem_span_set'.mp hu
  rw [← decompose_of_mem_same M.grading.piece hx, ← hg, decompose_sum,
    DFinsupp.finsetSum_apply, AddSubmonoidClass.coe_finsetSum]
  refine Submodule.sum_mem _ fun t _ ↦ ?_
  obtain ⟨q, hq, ht⟩ := (g t).property
  have h := DirectSum.coe_decompose_smul_add_of_right_mem 𝒜 M.grading.piece ht
    (a := c t) (i := p - q)
  rw [sub_add_cancel] at h
  rw [h]
  by_cases hpq : p - q < 0
  · have hz : (decompose 𝒜 (c t) (p - q) : A) = 0 := by
      simpa only [hneg _ hpq, Submodule.mem_bot] using (decompose 𝒜 (c t) (p - q)).property
    simp [hz]
  · exact Submodule.smul_mem_smul
      (Submodule.mem_iSup_of_mem (p - q)
        (Submodule.mem_iSup_of_mem (by omega : 0 < p - q)
          (decompose 𝒜 (c t) (p - q)).property)) Submodule.mem_top

include hneg in
/-- Vanishing of maps to the universal degree quotient detects a homogeneous piece modulo
positive-degree action. -/
theorem piece_le_positive_smul_top_of_subsingleton_hom (M : GradedModuleCat.{v} 𝒜) (p : ℤ)
    (h : Subsingleton (M ⟶ M.degreeQuotient p)) :
    M.grading.piece p ≤ (⨆ (i : ℤ) (_ : 0 < i), 𝒜 i) • (⊤ : Submodule k M) := by
  have hz : M.degreeQuotientπ p = 0 := h.elim _ _
  intro x hx
  apply M.piece_inf_offDegreeSpan_le_positive_smul_top hneg p
  refine ⟨hx, (M.degreeQuotientπ_eq_zero_iff p x).mp ?_⟩
  simp [hz]

end TauCeti.GradedModuleCat
