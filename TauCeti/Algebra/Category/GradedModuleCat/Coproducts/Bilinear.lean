module

public import TauCeti.Algebra.Category.GradedModuleCat.Coproducts.Basic

/-!
# Bilinear maps out of graded coproducts

A family of bilinear maps extends uniquely across a coproduct in its first variable.
Componentwise equivariance and total internal degree pass to this extension. If objects
generated by these bilinear maps admit the corresponding homogeneous lifts, the induced
cofan is a coproduct as well.

The cofan criterion expresses the coproduct universal property for bilinearly generated
objects. It applies, for example, to the coproduct interchange of tensor bifunctors used
in totalizations of cochain complexes.
-/

/- The direct-sum argument is adapted from
TauCeti.Algebra.Category.GradedModuleCat.BimoduleTensor.Coproducts,
contributed by the Tau Ceti contributors in PR #14604. -/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits
open scoped DirectSum

namespace TauCeti.GradedModuleCat

universe w v

variable {k A : Type*} [CommRing k] [Ring A] [Algebra k A]
  {𝒜 : ℤ → Submodule k A} {J : Type w}
  (M : J → GradedModuleCat.{max w v} 𝒜)

section Bilinear

variable {N P : Type*} [AddCommMonoid N] [AddCommMonoid P] [Module k N] [Module k P]

/-- Extend a family of bilinear maps across the coproduct in the first variable. -/
abbrev coproductBilinear (f : ∀ j, M j →ₗ[k] N →ₗ[k] P) :
    (coproductCofan M).pt →ₗ[k] N →ₗ[k] P := by
  classical
  exact DirectSum.toModule k J (N →ₗ[k] P) f

/-- The bilinear extension agrees with its prescribed map on each summand. -/
@[simp]
theorem coproductBilinear_of [DecidableEq J] (f : ∀ j, M j →ₗ[k] N →ₗ[k] P)
    (j : J) (m : M j) (n : N) :
    coproductBilinear M f (DirectSum.of (fun j ↦ M j) j m) n = f j m n := by
  cases Subsingleton.elim (inferInstance : DecidableEq J) (Classical.decEq J)
  classical
  rw [coproductBilinear, ← DirectSum.lof_eq_of k, DirectSum.toModule_lof]

/-- The bilinear extension agrees with its prescribed map on each coproduct injection. -/
@[simp]
theorem coproductBilinear_apply_inj (f : ∀ j, M j →ₗ[k] N →ₗ[k] P)
    (j : J) (m : M j) (n : N) :
    coproductBilinear M f (((coproductCofan M).inj j).hom m) n = f j m n := by
  classical
  rw [hom_coproductCofan_inj, DirectSum.lof_eq_of, coproductBilinear_of]

/-- Bilinear maps on a coproduct are determined by their restrictions to its summands. -/
theorem coproductBilinear_ext
    {f g : (coproductCofan M).pt →ₗ[k] N →ₗ[k] P}
    (h : ∀ j m n, f (((coproductCofan M).inj j).hom m) n =
      g (((coproductCofan M).inj j).hom m) n) : f = g := by
  classical
  apply DirectSum.linearMap_ext
  intro j
  apply LinearMap.ext
  intro m
  apply LinearMap.ext
  intro n
  have h' := h j m n
  rw [hom_coproductCofan_inj, DirectSum.lof_eq_of] at h'
  simpa only [LinearMap.comp_apply, DirectSum.lof_eq_of] using h'

/-- An equivariance equation on each summand passes to the bilinear extension.
The three linear maps allow balancing and either outer action to use the same statement. -/
theorem coproductBilinear_equivariant (f : ∀ j, M j →ₗ[k] N →ₗ[k] P)
    (a : A) (u w : N →ₗ[k] N) (v : P →ₗ[k] P)
    (h : ∀ j m n, f j (a • m) (u n) = v (f j m (w n)))
    (m : (coproductCofan M).pt) (n : N) :
    coproductBilinear M f (a • m) (u n) = v (coproductBilinear M f m (w n)) := by
  classical
  induction m using DirectSum.induction_on with
  | zero => simp only [smul_zero, map_zero, LinearMap.zero_apply]
  | of j m =>
    rw [← DirectSum.of_smul (R := A), coproductBilinear_of, coproductBilinear_of]
    exact h j m n
  | add x y hx hy =>
    simp only [smul_add, map_add, LinearMap.add_apply, hx, hy]

end Bilinear

section Grading

variable {B C : Type*} [Ring B] [Ring C] [Algebra k B] [Algebra k C]
  {ℬ : ℤ → Submodule k B} {𝒞 : ℤ → Submodule k C}
  {N : GradedModuleCat ℬ} {P : GradedModuleCat 𝒞}

/-- The bilinear extension preserves the sum of internal degrees when each component does. -/
theorem coproductBilinear_mem (f : ∀ j, M j →ₗ[k] N →ₗ[k] P)
    (h : ∀ j {p q : ℤ} {m : M j} {n : N},
      m ∈ (M j).grading.piece p → n ∈ N.grading.piece q →
        f j m n ∈ P.grading.piece (p + q))
    {p q : ℤ} {m : (coproductCofan M).pt} {n : N}
    (hm : m ∈ (coproductCofan M).pt.grading.piece p) (hn : n ∈ N.grading.piece q) :
    coproductBilinear M f m n ∈ P.grading.piece (p + q) := by
  classical
  have hm' := (mem_coproductCofan_pt_piece_iff M).1 hm
  rw [← DFinsupp.sum_single (f := m), DFinsupp.sum, map_sum, LinearMap.sum_apply]
  refine (P.grading.piece (p + q)).sum_mem fun j _ ↦ ?_
  rw [DirectSum.single_eq_lof k, DirectSum.lof_eq_of, coproductBilinear_of]
  exact h j (hm' j) hn

end Grading

end TauCeti.GradedModuleCat

namespace CategoryTheory.Limits.Cofan

open TauCeti TauCeti.GradedModuleCat

universe w v

variable {k A C : Type*} [CommRing k] [Ring A] [Ring C] [Algebra k A] [Algebra k C]
  {𝒜 : ℤ → Submodule k A} {𝒞 : ℤ → Submodule k C} {J : Type w}
  {N : Type*} [AddCommMonoid N] [Module k N]
  {T : J → GradedModuleCat.{max w v} 𝒞}

/-- A cofan generated by bilinear maps is a coproduct if the componentwise bilinear
extension has a homogeneous lift. The generation hypotheses give uniqueness of that lift. -/
def bilinearIsColimit (c : Cofan T)
    (M : J → GradedModuleCat.{max w v} 𝒜)
    (t : ∀ j, M j →ₗ[k] N →ₗ[k] T j)
    (tSum : (coproductCofan M).pt →ₗ[k] N →ₗ[k] c.pt)
    (hinj : ∀ j m n, (c.inj j).hom (t j m n) =
      tSum (((coproductCofan M).inj j).hom m) n)
    (hext : ∀ j {P : GradedModuleCat.{max w v} 𝒞} {f g : T j ⟶ P},
      (∀ m n, f.hom (t j m n) = g.hom (t j m n)) → f = g)
    (hextSum : ∀ {P : GradedModuleCat.{max w v} 𝒞} {f g : c.pt ⟶ P},
      (∀ m n, f.hom (tSum m n) = g.hom (tSum m n)) → f = g)
    (lift : ∀ s : Cofan T, c.pt ⟶ s.pt)
    (hlift : ∀ s m n, (lift s).hom (tSum m n) =
      coproductBilinear M (fun j ↦ (t j).compr₂ ((s.inj j).hom.restrictScalars k)) m n) :
    IsColimit c := by
  refine Cofan.IsColimit.mk _ lift ?_ ?_
  · intro s j
    apply hext j
    intro m n
    rw [GradedModuleCat.hom_comp, LinearMap.comp_apply, hinj, hlift, coproductBilinear_apply_inj]
    rfl
  · intro s f hf
    apply hextSum
    have h : tSum.compr₂ (f.hom.restrictScalars k) =
        tSum.compr₂ ((lift s).hom.restrictScalars k) := by
      apply coproductBilinear_ext M
      intro j m n
      simp only [LinearMap.compr₂_apply, LinearMap.restrictScalars_apply]
      rw [hlift, coproductBilinear_apply_inj, ← hinj]
      simpa only [GradedModuleCat.hom_comp, LinearMap.comp_apply, LinearMap.compr₂_apply,
        LinearMap.restrictScalars_apply] using
        LinearMap.congr_fun (congrArg GradedModuleCat.Hom.hom (hf j)) (t j m n)
    intro m n
    exact LinearMap.congr_fun (LinearMap.congr_fun h m) n

end CategoryTheory.Limits.Cofan
