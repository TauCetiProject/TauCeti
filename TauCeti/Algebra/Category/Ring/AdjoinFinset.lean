module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.Category.Ring.FilteredColimits

/-!
# A ring as the filtered colimit of its finitely generated subalgebras

For an `R`-algebra `A`, the subalgebras `R[s]` generated by the finite subsets `s` of `A` form a
diagram indexed by the directed poset `Finset A`, and `A` is its colimit in `CommRingCat`: every
element of `A` lies in some `R[s]`, and the transition maps are injective. Over `R = ℤ` the
stages are the finitely generated subrings of `A`, which are of finite presentation over `ℤ`
because `ℤ` is Noetherian. This is the algebraic input of the affine case of absolute
Noetherian approximation (Stacks, Proposition 32.5.4 (01ZA)).

The same construction applies to any monotone directed family of subalgebras whose union
covers the ambient algebra. The finite-adjoin presentation is its specialization to `Finset A`.

## Main declarations

* `TauCeti.CommRingCat.isColimitMonotoneSubalgebraCocone`: a covering directed family of
  subalgebras presents the ambient algebra as a colimit.
* `TauCeti.CommRingCat.adjoinFinsetDiagram`: the diagram `s ↦ R[s]` of finitely generated
  `R`-subalgebras of `A`, indexed by the finite subsets of `A`.
* `TauCeti.CommRingCat.adjoinFinsetCocone`: the cocone of inclusions `R[s] → A`.
* `TauCeti.CommRingCat.isColimitAdjoinFinsetCocone`: `A` is the colimit of this diagram.
-/

public section

universe u

open CategoryTheory Limits

namespace TauCeti.CommRingCat

variable (R : Type*) [CommRing R] (A : Type u) [CommRing A] [Algebra R A]

variable {ι : Type u} [Preorder ι]

section MonotoneSubalgebra

variable (S : ι → Subalgebra R A) (hS : Monotone S)

/-- The diagram of a monotone family of subalgebras of an `R`-algebra. -/
@[expose]
noncomputable def monotoneSubalgebraDiagram : ι ⥤ CommRingCat.{u} where
  obj i := .of (S i)
  map {i j} h := CommRingCat.ofHom (Subalgebra.inclusion (hS h.le)).toRingHom

/-- A stage is the specified subalgebra. -/
@[simp]
lemma monotoneSubalgebraDiagram_obj (i : ι) :
    (monotoneSubalgebraDiagram R A S hS).obj i = .of (S i) := (rfl)

/-- A transition map is the subalgebra inclusion. -/
@[simp]
lemma monotoneSubalgebraDiagram_map {i j : ι} (h : i ⟶ j) :
    (monotoneSubalgebraDiagram R A S hS).map h =
      CommRingCat.ofHom (Subalgebra.inclusion (hS h.le)).toRingHom := (rfl)

/-- The inclusion cocone for a monotone family of subalgebras. -/
@[expose]
noncomputable def monotoneSubalgebraCocone : Cocone (monotoneSubalgebraDiagram R A S hS) where
  pt := .of A
  ι.app i := CommRingCat.ofHom (S i).val.toRingHom

/-- The point of the inclusion cocone is the ambient algebra. -/
@[simp]
lemma monotoneSubalgebraCocone_pt :
    (monotoneSubalgebraCocone R A S hS).pt = .of A := (rfl)

/-- Each leg is the inclusion of its subalgebra into the ambient algebra. -/
@[simp]
lemma monotoneSubalgebraCocone_ι_app (i : ι) :
    (monotoneSubalgebraCocone R A S hS).ι.app i = CommRingCat.ofHom (S i).val.toRingHom := (rfl)

/-- Forgetting a cocone leg evaluates it as the subtype inclusion. -/
lemma monotoneSubalgebraCocone_forget_ι_app (i : ι) (x : S i) :
    ((forget CommRingCat).mapCocone (monotoneSubalgebraCocone R A S hS)).ι.app i x = (x : A) := by
  erw [Functor.mapCocone_ι_app, monotoneSubalgebraCocone_ι_app,
    CommRingCat.forget_map_apply]
  rfl

/-- A monotone family whose union covers `A` presents `A` as a filtered colimit. -/
noncomputable def isColimitMonotoneSubalgebraCocone [IsDirected ι (· ≤ ·)]
    (hcover : ∀ x : A, ∃ i, x ∈ S i) :
    IsColimit (monotoneSubalgebraCocone R A S hS) := by
  have : Nonempty ι := ⟨(hcover 0).choose⟩
  refine isColimitOfReflects (forget _) (Types.FilteredColimit.isColimitOf' _
    ((forget CommRingCat.{u}).mapCocone (monotoneSubalgebraCocone R A S hS)) ?_ ?_)
  · intro x
    obtain ⟨i, hi⟩ := hcover x
    exact ⟨i, ⟨x, hi⟩,
      (monotoneSubalgebraCocone_forget_ι_app R A S hS i ⟨x, hi⟩).symm⟩
  · intro i x y h
    let hx : S i := x
    let hy : S i := y
    have hxy : (hx : A) = (hy : A) :=
      (monotoneSubalgebraCocone_forget_ι_app R A S hS i hx).symm.trans
        (h.trans (monotoneSubalgebraCocone_forget_ι_app R A S hS i hy))
    refine ⟨i, 𝟙 i, ?_⟩
    simp only [CategoryTheory.Functor.map_id, types_id_apply]
    exact Subtype.ext hxy

end MonotoneSubalgebra

/-- The finitely generated `R`-subalgebras `R[s]` of `A`, for `s` a finite subset of `A`, with
the inclusions between them. -/
@[expose]
noncomputable def adjoinFinsetDiagram : Finset A ⥤ CommRingCat.{u} :=
  monotoneSubalgebraDiagram R A (fun s : Finset A ↦ Algebra.adjoin R (s : Set A))
    (fun _ _ h ↦ Algebra.adjoin_mono (Finset.coe_subset.mpr h))

/-- The stage indexed by `s` is the subalgebra generated by `s`. -/
@[simp]
lemma adjoinFinsetDiagram_obj (s : Finset A) :
    (adjoinFinsetDiagram R A).obj s = .of (Algebra.adjoin R (s : Set A)) := (rfl)

/-- The transition map is the inclusion of the generated subalgebras. -/
@[simp]
lemma adjoinFinsetDiagram_map {s t : Finset A} (h : s ⟶ t) :
    (adjoinFinsetDiagram R A).map h = CommRingCat.ofHom
      (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h.le))).toRingHom := (rfl)

/-- The cocone on `adjoinFinsetDiagram R A` with point `A`, given by the inclusions
`R[s] → A`. -/
@[expose]
noncomputable def adjoinFinsetCocone : Cocone (adjoinFinsetDiagram R A) :=
  monotoneSubalgebraCocone R A (fun s : Finset A ↦ Algebra.adjoin R (s : Set A))
    (fun _ _ h ↦ Algebra.adjoin_mono (Finset.coe_subset.mpr h))

/-- The apex of the cocone is the ambient ring. -/
@[simp]
lemma adjoinFinsetCocone_pt : (adjoinFinsetCocone R A).pt = .of A := (rfl)

/-- Each cocone leg is the inclusion into the ambient ring. -/
@[simp]
lemma adjoinFinsetCocone_ι_app (s : Finset A) :
    (adjoinFinsetCocone R A).ι.app s =
      CommRingCat.ofHom (Algebra.adjoin R (s : Set A)).val.toRingHom := (rfl)

/-- A ring `A` is the filtered colimit of its finitely generated `R`-subalgebras. -/
noncomputable def isColimitAdjoinFinsetCocone : IsColimit (adjoinFinsetCocone R A) := by
  apply isColimitMonotoneSubalgebraCocone
  · intro x
    exact ⟨{x}, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self x))⟩

end TauCeti.CommRingCat
