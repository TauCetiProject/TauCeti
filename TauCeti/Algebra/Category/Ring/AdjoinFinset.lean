module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Algebra.Category.Ring.FilteredColimits

/-!
# A ring as the filtered colimit of its finitely generated subalgebras

For an `R`-algebra `A`, the subalgebras `R[s]` generated by the finite subsets `s` of `A` form a
diagram indexed by the directed poset `Finset A`, and `A` is its colimit in `CommRingCat`: every
element of `A` lies in some `R[s]`, and the transition maps are injective. Over `R = ℤ` the
stages are the finitely generated subrings of `A`, which are of finite presentation over `ℤ`
because `ℤ` is Noetherian. This is the algebraic input of the affine case of absolute
Noetherian approximation (Stacks, Proposition 32.5.4 (01ZA)).

## Main declarations

* `TauCeti.CommRingCat.adjoinFinsetDiagram`: the diagram `s ↦ R[s]` of finitely generated
  `R`-subalgebras of `A`, indexed by the finite subsets of `A`.
* `TauCeti.CommRingCat.adjoinFinsetCocone`: the cocone of inclusions `R[s] → A`.
* `TauCeti.CommRingCat.isColimitAdjoinFinsetCocone`: `A` is the colimit of this diagram.
-/

public section

universe u

open CategoryTheory Limits

namespace TauCeti.CommRingCat

variable (R : Type*) [CommRing R] (A : Type u) [CommRing A] [Algebra R A]

/-- The finitely generated `R`-subalgebras `R[s]` of `A`, for `s` a finite subset of `A`, with
the inclusions between them. -/
@[expose]
noncomputable def adjoinFinsetDiagram : Finset A ⥤ CommRingCat.{u} where
  obj s := .of (Algebra.adjoin R (s : Set A))
  map {s t} h := CommRingCat.ofHom
    (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h.le))).toRingHom

/-- The stage indexed by `s` is the subalgebra generated by `s`. -/
@[simp]
lemma adjoinFinsetDiagram_obj (s : Finset A) :
    (adjoinFinsetDiagram R A).obj s = .of (Algebra.adjoin R (s : Set A)) := (rfl)

/-- The transition map is the inclusion of the generated subalgebras. -/
@[simp]
lemma adjoinFinsetDiagram_map {s t : Finset A} (h : s ⟶ t) :
    (adjoinFinsetDiagram R A).map h = CommRingCat.ofHom
      (Subalgebra.inclusion (Algebra.adjoin_mono (Finset.coe_subset.mpr h.le))).toRingHom := (rfl)

/-- The cocone on `adjoinFinsetDiagram R A` with point `A`, given by the inclusions
`R[s] → A`. -/
@[expose]
noncomputable def adjoinFinsetCocone : Cocone (adjoinFinsetDiagram R A) where
  pt := .of A
  ι.app s := CommRingCat.ofHom (Algebra.adjoin R (s : Set A)).val.toRingHom

/-- The apex of the cocone is the ambient ring. -/
@[simp]
lemma adjoinFinsetCocone_pt : (adjoinFinsetCocone R A).pt = .of A := (rfl)

/-- Each cocone leg is the inclusion into the ambient ring. -/
@[simp]
lemma adjoinFinsetCocone_ι_app (s : Finset A) :
    (adjoinFinsetCocone R A).ι.app s =
      CommRingCat.ofHom (Algebra.adjoin R (s : Set A)).val.toRingHom := (rfl)

/-- A ring `A` is the filtered colimit of its finitely generated `R`-subalgebras. -/
noncomputable def isColimitAdjoinFinsetCocone : IsColimit (adjoinFinsetCocone R A) := by
  refine isColimitOfReflects (forget _) (Types.FilteredColimit.isColimitOf' _
    ((forget CommRingCat.{u}).mapCocone (adjoinFinsetCocone R A)) ?_ ?_)
  · intro x
    exact ⟨{x}, ⟨x, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_singleton_self x))⟩, rfl⟩
  · intro s x y h
    refine ⟨s, 𝟙 s, ?_⟩
    simp only [CategoryTheory.Functor.map_id, types_id_apply]
    exact Subtype.ext h

end TauCeti.CommRingCat
