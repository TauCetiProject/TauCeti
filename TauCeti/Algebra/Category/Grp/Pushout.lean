module

public import Mathlib.Algebra.Category.Grp.Basic
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Defs
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# Pushouts of groups along surjections

Consider a pushout square of groups
```
K --f--> G₁
|        |
g        i
v        v
G₂ --j-> P
```
in which both maps `f` and `g` out of the corner are surjective. Then `P` is a quotient of the
corner: the diagonal map `K → P` is surjective
(`CategoryTheory.IsPushout.surjective_comp_of_surjective`), and its kernel is the subgroup
generated by the kernels of `f` and `g` (`CategoryTheory.IsPushout.ker_comp_eq_sup_of_surjective`),
which is normal since both kernels are. So `P ≅ K ⧸ (ker f ⊔ ker g)`.

For the Seifert–van Kampen theorem this is the case where the fundamental group of the overlap
surjects onto the fundamental groups of both pieces, as for the Heegaard surface of a Heegaard
splitting: the fundamental group of the whole space is then the fundamental group of the overlap
modulo the loops that become trivial in either piece.

The proof compares `P` with `Q = K ⧸ (ker f ⊔ ker g)`. Since `f` and `g` are surjective, the
quotient map `K → Q` descends along both of them, compatibly with the square, so the universal
property gives `ψ : P → Q` with `ψ (i (f k)) = [k]`. In the other direction, `i ∘ f` kills both
kernels and descends to `θ : Q → P`, and `θ ∘ ψ = id` by the uniqueness half of the universal
property. Hence every `p = θ (ψ p)` lies in the image of `i ∘ f`, and `i (f k) = 1` forces
`[k] = ψ (i (f k)) = 1`.
-/

public section

namespace CategoryTheory.IsPushout

open Function

universe u

variable {K G₁ G₂ P : GrpCat.{u}} {f : K ⟶ G₁} {g : K ⟶ G₂} {i : G₁ ⟶ P} {j : G₂ ⟶ P}

/-- The quotient of the corner of a square of groups by the subgroup generated by the kernels of
the two maps out of it. -/
private abbrev kerSupQuotient (f : K ⟶ G₁) (g : K ⟶ G₂) : GrpCat.{u} :=
  GrpCat.of (K ⧸ (f.hom.ker ⊔ g.hom.ker))

/-- The quotient map `K → K ⧸ (ker f ⊔ ker g)`, descended along a surjection `f`. -/
private noncomputable def descLeft (hf : Surjective f) : G₁ ⟶ kerSupQuotient f g :=
  GrpCat.ofHom <| f.hom.liftOfRightInverse (surjInv hf) (rightInverse_surjInv hf)
    ⟨QuotientGroup.mk' _, fun _ hk ↦ (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_sup_left hk)⟩

private theorem descLeft_apply (hf : Surjective f) (k : K) :
    descLeft (g := g) hf (f k) = (k : K ⧸ (f.hom.ker ⊔ g.hom.ker)) :=
  f.hom.liftOfRightInverse_comp_apply _ _ _ k

/-- The quotient map `K → K ⧸ (ker f ⊔ ker g)`, descended along a surjection `g`. -/
private noncomputable def descRight (hg : Surjective g) : G₂ ⟶ kerSupQuotient f g :=
  GrpCat.ofHom <| g.hom.liftOfRightInverse (surjInv hg) (rightInverse_surjInv hg)
    ⟨QuotientGroup.mk' _, fun _ hk ↦ (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_sup_right hk)⟩

private theorem descRight_apply (hg : Surjective g) (k : K) :
    descRight (f := f) hg (g k) = (k : K ⧸ (f.hom.ker ⊔ g.hom.ker)) :=
  g.hom.liftOfRightInverse_comp_apply _ _ _ k

/-- The square commutes pointwise. -/
private theorem w_apply (h : IsPushout f g i j) (k : K) : i (f k) = j (g k) := by
  simpa using ConcreteCategory.congr_hom h.w k

private theorem descLeft_comm (hf : Surjective f) (hg : Surjective g) :
    f ≫ descLeft hf = g ≫ descRight hg :=
  GrpCat.ext fun k ↦ by
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, descLeft_apply, descRight_apply]

/-- The comparison map `P → K ⧸ (ker f ⊔ ker g)` given by the universal property, sending
`i (f k)` to the class of `k`. -/
private noncomputable def toKerSupQuotient (h : IsPushout f g i j) (hf : Surjective f)
    (hg : Surjective g) : P ⟶ kerSupQuotient f g :=
  h.desc (descLeft hf) (descRight hg) (descLeft_comm hf hg)

private theorem toKerSupQuotient_apply (h : IsPushout f g i j) (hf : Surjective f)
    (hg : Surjective g) (k : K) :
    h.toKerSupQuotient hf hg (i (f k)) = (k : K ⧸ (f.hom.ker ⊔ g.hom.ker)) := by
  have := ConcreteCategory.congr_hom
    (h.inl_desc (descLeft hf) (descRight hg) (descLeft_comm hf hg)) (f k)
  rw [ConcreteCategory.comp_apply] at this
  exact this.trans (descLeft_apply hf k)

/-- Both kernels lie in the kernel of the diagonal of a commutative square. -/
private theorem sup_ker_le (h : IsPushout f g i j) :
    f.hom.ker ⊔ g.hom.ker ≤ (i.hom.comp f.hom).ker :=
  sup_le (fun k hk ↦ by simp [MonoidHom.mem_ker.1 hk]) fun k hk ↦ by
    simp [MonoidHom.mem_ker, h.w_apply k, MonoidHom.mem_ker.1 hk]

/-- The map `K ⧸ (ker f ⊔ ker g) → P` induced by the diagonal of the square. -/
private noncomputable def ofKerSupQuotient (h : IsPushout f g i j) : kerSupQuotient f g ⟶ P :=
  GrpCat.ofHom <| QuotientGroup.lift _ (i.hom.comp f.hom) h.sup_ker_le

private theorem ofKerSupQuotient_apply (h : IsPushout f g i j) (k : K) :
    h.ofKerSupQuotient (k : K ⧸ (f.hom.ker ⊔ g.hom.ker)) = i (f k) :=
  rfl

/-- The comparison `P → K ⧸ (ker f ⊔ ker g) → P` is the identity. -/
private theorem ofKerSupQuotient_toKerSupQuotient (h : IsPushout f g i j) (hf : Surjective f)
    (hg : Surjective g) (p : P) : h.ofKerSupQuotient (h.toKerSupQuotient hf hg p) = p := by
  suffices h.toKerSupQuotient hf hg ≫ h.ofKerSupQuotient = 𝟙 P by
    simpa using ConcreteCategory.congr_hom this p
  refine h.hom_ext (GrpCat.ext fun y ↦ ?_) (GrpCat.ext fun y ↦ ?_) <;>
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply,
      ConcreteCategory.id_apply]
  · obtain ⟨k, rfl⟩ := hf y
    rw [toKerSupQuotient_apply, ofKerSupQuotient_apply]
  · obtain ⟨k, rfl⟩ := hg y
    rw [← h.w_apply k, toKerSupQuotient_apply, ofKerSupQuotient_apply]

/-- **A pushout of groups along surjections is a quotient of the corner.** In a pushout square
of groups whose two maps `f : K → G₁` and `g : K → G₂` out of the corner are surjective, the
diagonal map `i ∘ f : K → P` is surjective. -/
theorem surjective_comp_of_surjective (h : IsPushout f g i j) (hf : Surjective f)
    (hg : Surjective g) : Surjective (i.hom.comp f.hom) := fun p ↦ by
  obtain ⟨k, hk⟩ := QuotientGroup.mk_surjective (s := f.hom.ker ⊔ g.hom.ker)
    (h.toKerSupQuotient hf hg p)
  refine ⟨k, ?_⟩
  rw [← h.ofKerSupQuotient_toKerSupQuotient hf hg p, ← hk, ofKerSupQuotient_apply,
    MonoidHom.comp_apply]

/-- **The kernel of the diagonal of a pushout of groups along surjections.** In a pushout square
of groups whose two maps `f : K → G₁` and `g : K → G₂` out of the corner are surjective, the
kernel of the diagonal map `i ∘ f : K → P` is the subgroup generated by the kernels of `f` and of
`g`. -/
theorem ker_comp_eq_sup_of_surjective (h : IsPushout f g i j) (hf : Surjective f)
    (hg : Surjective g) : (i.hom.comp f.hom).ker = f.hom.ker ⊔ g.hom.ker := by
  refine le_antisymm (fun k hk ↦ ?_) h.sup_ker_le
  rw [MonoidHom.mem_ker, MonoidHom.comp_apply] at hk
  rw [← QuotientGroup.eq_one_iff, ← h.toKerSupQuotient_apply hf hg]
  simp [hk]

end CategoryTheory.IsPushout
