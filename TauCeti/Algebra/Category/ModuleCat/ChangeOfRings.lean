/-!
# Change of rings

The counit of restriction of scalars along a ring equivalence, and its inverse, act as the
identity on the underlying elements.
Restriction of scalars along an isomorphism of `R`-algebras keeps the endomorphism algebra of a
module (`ModuleCat.moduleEndRestrictScalarsAlgEquiv`).

It also records three facts about Mathlib's extension of scalars `ModuleCat.extendScalars`.

* Extension of scalars is additive.
* Extension of scalars carries multiplication by a scalar to multiplication by its image
  (`ModuleCat.extendScalars_map_smul_id`). This transports the curvature equations of a
  matrix factorization when its components are extended along a ring map, so the resulting
  factorization has the image potential.
* Extension of scalars to a localization `T⁻¹R` is localization: for an `R`-module `M`,
  `T⁻¹R ⊗_R M` is isomorphic to the localized module `T⁻¹M` as a `T⁻¹R`-module, by
  `s ⊗ m ↦ s • m / 1` (`ModuleCat.extendScalarsLocalizationIso`). This identifies the
  restriction of the quasi-coherent sheaf `M~` on `Spec R` to a basic open `D(r)` with the sheaf
  associated with `M_r` on `Spec R_r`.

Along the structure map `algebraMap R S` of an `R`-algebra, extension of scalars is the tensor
product `S ⊗[R] M` taken with the algebra module structure of `S`
(`ModuleCat.extendScalarsAlgebraMapIso`), naturally in `M`
(`ModuleCat.extendScalarsAlgebraMapIso_inv_naturality`,
`ModuleCat.extendScalarsAlgebraMapIso_hom_naturality`). Through it, extension of scalars along
any ring homomorphism preserves finitely generated modules and projective modules
(`ModuleCat.finite_extendScalars_obj`, `ModuleCat.projective_extendScalars_obj`). When `S` is
flat over `R`, this extension of scalars is exact and so preserves finite limits
(`ModuleCat.preservesFiniteLimits_extendScalars_algebraMap`). Along any ring map, extension of
scalars carries flat (faithfully flat) modules to flat (faithfully flat) modules
(`ModuleCat.flat_extendScalars`, `ModuleCat.faithfullyFlat_extendScalars`). An `R`-linear map
`f : M → N` to an `S`-module exhibits `N` as the base change of `M` (`IsBaseChange S f`) exactly
when its adjoint `S ⊗[R] M → N` is bijective; in that case the adjoint morphism of modules is an
isomorphism
(`ModuleCat.isIso_extendRestrictScalarsAdj_homEquiv_symm_of_isBaseChange`).

Extension of scalars along `f : R →+* S` of the free module `ι →₀ R` is the free module
`ι →₀ S`, by `s ⊗ c ↦ s • f(c)` (`ModuleCat.extendScalarsFinsuppIso`).

The extension of scalars of a module generated by `m₀` is generated by `1 ⊗ m₀`
(`ModuleCat.ExtendScalars.span_singleton_one_tmul_eq_top`).

Morphisms `S ⊗_{R,f} M ⟶ N` out of an extension of scalars are the `f`-semilinear maps
`M → N`, by restriction to `1 ⊗ M` (`ModuleCat.extendScalarsHomEquivSemilinearMap`). This
describes a linearization `S ⊗_{S,σ} M ≅ M` of a Frobenius module by its semilinear Frobenius.
-/

public section

universe u v w

namespace ModuleCat

open CategoryTheory
open scoped ChangeOfRings

section RestrictScalars

-- Mathlib's `ModuleCat` and its scalar-restriction equivalence require rings.
variable {R S : Type*} [Ring R] [Ring S]

-- Simplify before Mathlib expands the counit into scalar-restriction comparison maps.
-- The component simp lemmas alone leave their bundled linear-map composite unreduced.
/-- The counit of restriction of scalars along a ring equivalence keeps each element. -/
@[simp↓]
theorem restrictScalarsEquivalenceOfRingEquiv_counitIso_hom_app_apply (e : R ≃+* S)
    (M : ModuleCat.{v} R) (x : M) :
    (restrictScalarsEquivalenceOfRingEquiv e).counitIso.hom.app M x = x := (rfl)

/-- The inverse counit of restriction of scalars along a ring equivalence keeps each element. -/
@[simp↓]
theorem restrictScalarsEquivalenceOfRingEquiv_counitIso_inv_app_apply (e : R ≃+* S)
    (M : ModuleCat.{v} R) (x : M) :
    (restrictScalarsEquivalenceOfRingEquiv e).counitIso.inv.app M x = x := (rfl)

end RestrictScalars

section ModuleEnd

open scoped ModuleCat.Algebra

variable (R : Type*) [CommSemiring R] {Γ Γ' : Type*} [Ring Γ] [Ring Γ'] [Algebra R Γ]
  [Algebra R Γ'] (σ : Γ ≃ₐ[R] Γ') (W : Type v) [AddCommGroup W] [Module Γ' W] [Module R W]
  [IsScalarTower R Γ' W]

/-- **Endomorphisms after restriction of scalars along an isomorphism.** Restricting the scalars of
a `Γ'`-module `W` along an isomorphism of `R`-algebras `σ : Γ ≃ Γ'` does not change its
endomorphism algebra. -/
noncomputable def moduleEndRestrictScalarsAlgEquiv :
    Module.End Γ ((restrictScalarsEquivalenceOfRingEquiv σ.toRingEquiv).functor.obj
      (ModuleCat.of Γ' W)) ≃ₐ[R] Module.End Γ' W where
  -- The restricted module has carrier `W` and action `γ • w = σ γ • w`, by definition.
  toFun φ :=
    { toFun w := φ w
      map_add' := φ.map_add
      map_smul' γ w := by
        obtain ⟨γ, rfl⟩ := σ.surjective γ
        exact φ.map_smul γ w }
  -- The same definitional carrier and action, read in the other direction.
  invFun ψ :=
    { toFun w := ψ w
      map_add' := ψ.map_add
      map_smul' γ w := ψ.map_smul (σ γ) w }
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' r := LinearMap.ext fun w ↦
    -- `smul_def` unfolds the action on the restricted module, whose carrier is `W`.
    (restrictScalars.smul_def (M := ModuleCat.of Γ' W) σ.toRingEquiv.toRingHom
      (algebraMap R Γ r) w).trans <| by
        rw [Module.algebraMap_end_apply, ← algebraMap_smul Γ' r w]
        exact congrArg (· • w) (σ.commutes r)

/-- `ModuleCat.moduleEndRestrictScalarsAlgEquiv` keeps the underlying function. -/
@[simp]
theorem moduleEndRestrictScalarsAlgEquiv_apply
    (φ : Module.End Γ ((restrictScalarsEquivalenceOfRingEquiv σ.toRingEquiv).functor.obj
      (ModuleCat.of Γ' W))) (w : W) :
    moduleEndRestrictScalarsAlgEquiv R σ W φ w = φ w :=
  (rfl)

/-- The inverse of `ModuleCat.moduleEndRestrictScalarsAlgEquiv` keeps the underlying function. -/
@[simp]
theorem moduleEndRestrictScalarsAlgEquiv_symm_apply (ψ : Module.End Γ' W) (w : W) :
    (moduleEndRestrictScalarsAlgEquiv R σ W).symm ψ w = ψ w :=
  (rfl)

end ModuleEnd

section Additive

variable {S : Type u} {T : Type v} [CommRing S] [CommRing T]

/-- Extension of scalars is additive. -/
instance (f : S →+* T) : (extendScalars f).Additive where
  map_add := by
    intro M N g h
    let _ : Algebra S T := f.toAlgebra
    apply hom_ext
    exact LinearMap.baseChange_add _ _

end Additive

section SMul

variable {S : Type u} {T : Type v} [CommRing S] [CommRing T] {w : S}

/-- Scalar extension sends multiplication by a scalar to multiplication by its image. -/
@[simp] theorem extendScalars_map_smul_id (f : S →+* T) (M : ModuleCat.{u} S) :
    (extendScalars f).map (w • 𝟙 M) = f w • 𝟙 _ := by
  let _ : Algebra S T := f.toAlgebra
  apply hom_ext
  -- Expose the underlying base-changed linear map after forgetting the category wrapper.
  change (w • (LinearMap.id : M →ₗ[S] M)).baseChange T =
    (f w) • (LinearMap.id : TensorProduct S T M →ₗ[T] TensorProduct S T M)
  rw [LinearMap.baseChange_smul, LinearMap.baseChange_id]
  rfl

end SMul

section Localization

variable {R : Type u} [CommRing R] (M : ModuleCat.{v} R) (T : Submonoid R)

/-- Extension of scalars to the localization `T⁻¹R` is localization: `T⁻¹R ⊗_R M` is isomorphic
to the localized module `T⁻¹M`, by `s ⊗ m ↦ s • m / 1`.

This transports `LocalizedModule.equivTensorProduct` across the `Module.compHom` structure
used by `ModuleCat.extendScalars`. -/
noncomputable def extendScalarsLocalizationIso :
    (extendScalars (algebraMap R (Localization T))).obj M ≅
      of (Localization T) (LocalizedModule T M) := by
  let φ := algebraMap R (Localization T)
  let A := Localization T
  let E := (restrictScalars φ).obj (of A A)
  have : IsScalarTower R A E := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let c : E ≃ₗ[A] A := LinearEquiv.refl A A
  let b := TensorProduct.AlgebraTensorModule.congr c (LinearEquiv.refl R M)
  let e := b.trans (LocalizedModule.equivTensorProduct T M).symm
  exact
    { hom := ofHom e.toLinearMap
      inv := ofHom e.symm.toLinearMap
      hom_inv_id := by
        apply hom_ext
        apply LinearMap.ext
        intro x
        exact e.symm_apply_apply x
      inv_hom_id := by
        apply hom_ext
        apply LinearMap.ext
        intro x
        exact e.apply_symm_apply x }

/-- `extendScalarsLocalizationIso` sends `1 ⊗ m` to `m / 1`. -/
@[simp]
theorem extendScalarsLocalizationIso_hom_one_tmul (m : M) :
    (M.extendScalarsLocalizationIso T).hom
      ((1 : Localization T) ⊗ₜ[R,algebraMap R (Localization T)] m) = LocalizedModule.mk m 1 :=
  by
    -- `ModuleCat.extendScalars` uses `Module.compHom`; the tensor-product equivalence uses
    -- the algebra module structure. The congruence map identifies these presentations.
    change (LocalizedModule.equivTensorProduct T M).symm
      ((TensorProduct.AlgebraTensorModule.congr
        (LinearEquiv.refl (Localization T) (Localization T))
        (LinearEquiv.refl R M)) (1 ⊗ₜ[R] m)) = _
    simp

/-- The inverse of `extendScalarsLocalizationIso` sends `m / 1` to `1 ⊗ m`. -/
@[simp]
theorem extendScalarsLocalizationIso_inv_mk_one (m : M) :
    (M.extendScalarsLocalizationIso T).inv (LocalizedModule.mk m 1) =
      (1 : Localization T) ⊗ₜ[R,algebraMap R (Localization T)] m :=
  by
    let i := M.extendScalarsLocalizationIso T
    -- Name the isomorphism to apply its categorical inverse identity.
    change i.inv (LocalizedModule.mk m 1) = _
    rw [← extendScalarsLocalizationIso_hom_one_tmul]
    -- Evaluation of a `ModuleCat` composite is evaluation of its underlying maps.
    change (i.hom ≫ i.inv)
      ((1 : Localization T) ⊗ₜ[R,algebraMap R (Localization T)] m) = _
    erw [i.hom_inv_id, id_apply]
    rfl

/-- `extendScalarsLocalizationIso` sends a pure tensor to the scalar multiple of `m / 1`. -/
@[simp]
theorem extendScalarsLocalizationIso_hom_tmul (s : Localization T) (m : M) :
    (M.extendScalarsLocalizationIso T).hom
      (s ⊗ₜ[R,algebraMap R (Localization T)] m) =
      s • LocalizedModule.mk m 1 := by
  have ht := (ExtendScalars.smul_tmul
    (algebraMap R (Localization T)) (M := M) s 1 m)
  rw [mul_one] at ht
  -- `erw` identifies the scalar actions through `extendScalars`'s `Module.compHom` presentation.
  exact (congrArg (fun x ↦ (M.extendScalarsLocalizationIso T).hom x) ht.symm).trans
    (by erw [map_smul, extendScalarsLocalizationIso_hom_one_tmul])

/-- The inverse of `extendScalarsLocalizationIso` sends `m / t` to `t⁻¹ ⊗ m`. -/
@[simp]
theorem extendScalarsLocalizationIso_inv_mk (m : M) (t : T) :
    (M.extendScalarsLocalizationIso T).inv (LocalizedModule.mk m t) =
      Localization.mk 1 t ⊗ₜ[R,algebraMap R (Localization T)] m := by
  have h : Localization.mk 1 t • LocalizedModule.mk m 1 = LocalizedModule.mk m t := by
    simpa using LocalizedModule.mk_smul_mk 1 m t 1
  rw [← h, map_smul, extendScalarsLocalizationIso_inv_mk_one]
  exact (ExtendScalars.smul_tmul
    (algebraMap R (Localization T)) (M := M) (Localization.mk 1 t) 1 m).trans
      (by rw [mul_one])

end Localization

section AlgebraMap

open scoped TensorProduct

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]

/-- Extension of scalars along `algebraMap R S` is the tensor product `S ⊗[R] M` with the algebra
module structure of `S`. `ModuleCat.extendScalars` uses the `Module.compHom` structure of `S`;
the two tensor products are identified by the identity of `S`. -/
noncomputable def extendScalarsAlgebraMapIso (M : ModuleCat.{w} R) :
    (extendScalars (algebraMap R S)).obj M ≅ of S (S ⊗[R] M) :=
  let E := (restrictScalars (algebraMap R S)).obj (of S S)
  have : IsScalarTower R S E := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let c : E ≃ₗ[S] S := LinearEquiv.refl S S
  let e := TensorProduct.AlgebraTensorModule.congr c (LinearEquiv.refl R M)
  { hom := ofHom e.toLinearMap
    inv := ofHom e.symm.toLinearMap
    hom_inv_id := hom_ext (LinearMap.ext e.symm_apply_apply)
    inv_hom_id := hom_ext (LinearMap.ext e.apply_symm_apply) }

/-- `extendScalarsAlgebraMapIso` sends `s ⊗ m` to `s ⊗ m`. -/
@[simp]
theorem extendScalarsAlgebraMapIso_hom_tmul (M : ModuleCat.{w} R) (s : S) (m : M) :
    (extendScalarsAlgebraMapIso M).hom (s ⊗ₜ[R, algebraMap R S] m) =
      s ⊗ₜ[R] m := by
  unfold extendScalarsAlgebraMapIso
  rfl

/-- The inverse of `extendScalarsAlgebraMapIso` sends `s ⊗ m` to `s ⊗ m`. -/
@[simp]
theorem extendScalarsAlgebraMapIso_inv_tmul (M : ModuleCat.{w} R) (s : S) (m : M) :
    (extendScalarsAlgebraMapIso M).inv (s ⊗ₜ[R] m) =
      s ⊗ₜ[R, algebraMap R S] m := by
  unfold extendScalarsAlgebraMapIso
  rfl

/-- `extendScalarsAlgebraMapIso` is natural in the module: it identifies the base change
`S ⊗[R] g` of an `R`-linear map `g` with the extension of scalars of `g`. -/
@[reassoc]
theorem extendScalarsAlgebraMapIso_inv_naturality {M N : ModuleCat.{w} R} (g : M ⟶ N) :
    ofHom (g.hom.baseChange S) ≫ (extendScalarsAlgebraMapIso N).inv =
      (extendScalarsAlgebraMapIso M).inv ≫ (extendScalars (algebraMap R S)).map g := by
  refine hom_ext (LinearMap.ext fun t ↦ ?_)
  induction t using TensorProduct.inductionOn with
  | tmul s x =>
    simp only [hom_comp, LinearMap.comp_apply, hom_ofHom, LinearMap.baseChange_tmul]
    -- `simp` leaves the two inverse comparisons unreduced, so they are rewritten explicitly.
    rw [extendScalarsAlgebraMapIso_inv_tmul, extendScalarsAlgebraMapIso_inv_tmul]
    exact (ExtendScalars.map_tmul (algebraMap R S) g s x).symm
  | add x y hx hy => simp_all

/-- `extendScalarsAlgebraMapIso` is natural: it carries the extension of scalars of an `R`-linear
map `φ` to its base change `S ⊗[R] φ`. -/
@[reassoc]
theorem extendScalarsAlgebraMapIso_hom_naturality {M N : ModuleCat.{w} R} (φ : M ⟶ N) :
    (extendScalars (algebraMap R S)).map φ ≫ (extendScalarsAlgebraMapIso N).hom =
      (extendScalarsAlgebraMapIso M).hom ≫ ofHom (φ.hom.baseChange S) := by
  rw [← Iso.inv_comp_eq, ← extendScalarsAlgebraMapIso_inv_naturality_assoc, Iso.inv_hom_id,
    Category.comp_id]

end AlgebraMap

section Finsupp

open scoped TensorProduct

variable {R : Type u} {S : Type (max u v)} [CommRing R] [CommRing S] (f : R →+* S)
  (ι : Type w) [DecidableEq ι]

/-- Extension of scalars along `f : R →+* S` of the free `R`-module on `ι` is the free `S`-module
on `ι`, by `s ⊗ c ↦ s • f(c)` (`ModuleCat.extendScalarsFinsuppIso_hom_tmul`). The ring `S` may be
in any universe above that of `R`, so for `R = ℤ` it may be any commutative ring. -/
noncomputable def extendScalarsFinsuppIso :
    (extendScalars f).obj (of R (ι →₀ R)) ≅ of S (ι →₀ S) :=
  letI := f.toAlgebra
  extendScalarsAlgebraMapIso (of R (ι →₀ R)) ≪≫
    (TensorProduct.finsuppScalarRight R S S ι).toModuleIso

variable {ι}

/-- `extendScalarsFinsuppIso` sends `s ⊗ c` to `s • f(c)`, where `f(c)` applies `f` to the
coefficients of `c`. -/
@[simp]
theorem extendScalarsFinsuppIso_hom_tmul (s : S) (c : ι →₀ R) :
    (extendScalarsFinsuppIso f ι).hom (s ⊗ₜ[R,f] c) = s • Finsupp.mapRange f (map_zero f) c := by
  let := f.toAlgebra
  ext i
  -- `f.toAlgebra` makes `algebraMap R S` unfold to `f`, so `s ⊗ₜ[R,f] c` is the tensor
  -- `s ⊗ₜ[R, algebraMap R S] c` on which `extendScalarsAlgebraMapIso_hom_tmul` acts.
  erw [Iso.trans_hom, ModuleCat.comp_apply, extendScalarsAlgebraMapIso_hom_tmul]
  simp [TensorProduct.finsuppScalarRight_apply_tmul_apply, Algebra.smul_def, mul_comm,
    RingHom.algebraMap_toAlgebra]

/-- `extendScalarsFinsuppIso` sends `1 ⊗ c` to `f(c)`. -/
theorem extendScalarsFinsuppIso_hom_one_tmul (c : ι →₀ R) :
    (extendScalarsFinsuppIso f ι).hom ((1 : S) ⊗ₜ[R,f] c) = Finsupp.mapRange f (map_zero f) c := by
  rw [extendScalarsFinsuppIso_hom_tmul, one_smul]

/-- The inverse of `extendScalarsFinsuppIso` sends the basis chain `single i s` to
`s ⊗ single i 1`. -/
@[simp]
theorem extendScalarsFinsuppIso_inv_single (i : ι) (s : S) :
    (extendScalarsFinsuppIso f ι).inv (Finsupp.single i s) = s ⊗ₜ[R,f] Finsupp.single i 1 := by
  have h : (extendScalarsFinsuppIso f ι).hom (s ⊗ₜ[R,f] Finsupp.single i 1) =
      Finsupp.single i s := by
    rw [extendScalarsFinsuppIso_hom_tmul, Finsupp.mapRange_single, map_one, Finsupp.smul_single,
      smul_eq_mul, mul_one]
  rw [← h]
  exact Iso.hom_inv_id_apply _ _

/-- `extendScalarsFinsuppIso` is natural: it carries the extension of scalars of an `R`-linear map
`φ` of free modules to an `S`-linear map `ψ` that agrees with `φ` after applying `f` to the
coefficients. -/
theorem extendScalarsFinsuppIso_hom_naturality {κ : Type w} [DecidableEq κ]
    {φ : (ι →₀ R) →ₗ[R] (κ →₀ R)} {ψ : (ι →₀ S) →ₗ[S] (κ →₀ S)}
    (h : ∀ c, Finsupp.mapRange f (map_zero f) (φ c) = ψ (Finsupp.mapRange f (map_zero f) c)) :
    (extendScalars f).map (ofHom φ) ≫ (extendScalarsFinsuppIso f κ).hom =
      (extendScalarsFinsuppIso f ι).hom ≫ ofHom ψ :=
  ExtendScalars.hom_ext fun c ↦ by
    -- `ExtendScalars.hom_ext` states the goal on `1 ⊗ₜ[R] c` with `S`, not
    -- `(restrictScalars f).obj S`, as the left factor, so `ModuleCat.comp_apply` does not rewrite
    -- it. The goal is restated with the composites evaluated and `ExtendScalars.map_tmul`
    -- applied, all of which hold by definition.
    change (extendScalarsFinsuppIso f κ).hom ((1 : S) ⊗ₜ[R,f] φ c) =
      ψ ((extendScalarsFinsuppIso f ι).hom ((1 : S) ⊗ₜ[R,f] c))
    rw [extendScalarsFinsuppIso_hom_one_tmul, extendScalarsFinsuppIso_hom_one_tmul, h]

end Finsupp

section FiniteProjective

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] (f : R →+* S)

-- With the algebra structure `f.toAlgebra`, `algebraMap R S` is `f` by definition, so
-- `extendScalarsAlgebraMapIso` identifies `(extendScalars f).obj M` with `S ⊗[R] M`, where
-- Mathlib's `Module.Finite.base_change` and `Module.Projective.tensorProduct` apply.

/-- Extension of scalars `S ⊗_{R,f} M` of a finitely generated module is finitely generated. -/
instance finite_extendScalars_obj (M : ModuleCat.{w} R) [Module.Finite R M] :
    Module.Finite S ((extendScalars f).obj M) := by
  let _ : Algebra R S := f.toAlgebra
  exact Module.Finite.equiv (extendScalarsAlgebraMapIso (R := R) (S := S) M).symm.toLinearEquiv

/-- Extension of scalars `S ⊗_{R,f} M` of a projective module is projective. -/
instance projective_extendScalars_obj (M : ModuleCat.{w} R) [Module.Projective R M] :
    Module.Projective S ((extendScalars f).obj M) := by
  let _ : Algebra R S := f.toAlgebra
  exact Module.Projective.of_equiv
    (extendScalarsAlgebraMapIso (R := R) (S := S) M).symm.toLinearEquiv

end FiniteProjective

section Flat

/-- Extension of scalars along a flat algebra is exact, so it preserves finite limits. -/
instance preservesFiniteLimits_extendScalars_algebraMap {R S : Type u} [CommRing R] [CommRing S]
    [Algebra R S] [Module.Flat R S] :
    Limits.PreservesFiniteLimits (extendScalars.{u, u, u} (algebraMap R S)) :=
  preservesFiniteLimits_extendScalars_of_flat (RingHom.flat_algebraMap_iff.2 inferInstance)

open scoped TensorProduct in
/-- Extension of scalars along any ring map `f : R →+* S` carries flat `R`-modules to flat
`S`-modules. The `S`-module `(extendScalars f).obj M` is by definition `S ⊗[R] M` with the algebra
structure `f.toAlgebra`, so this is Mathlib's `Module.Flat.baseChange`. -/
instance flat_extendScalars {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (M : ModuleCat R) [Module.Flat R M] : Module.Flat S ((extendScalars f).obj M) :=
  letI := f.toAlgebra
  inferInstanceAs (Module.Flat S (S ⊗[R] M))

open scoped TensorProduct in
/-- Extension of scalars along any ring map `f : R →+* S` carries faithfully flat `R`-modules to
faithfully flat `S`-modules. As for `ModuleCat.flat_extendScalars`, `(extendScalars f).obj M` is
by definition `S ⊗[R] M` with the algebra structure `f.toAlgebra`, so this is Mathlib's base
change of faithful flatness. -/
instance faithfullyFlat_extendScalars {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (M : ModuleCat R) [Module.FaithfullyFlat R M] :
    Module.FaithfullyFlat S ((extendScalars f).obj M) :=
  letI := f.toAlgebra
  inferInstanceAs (Module.FaithfullyFlat S (S ⊗[R] M))

end Flat

section BaseChange

open scoped TensorProduct

-- Mathlib's `ModuleCat.extendRestrictScalarsAdj` relates modules in one universe.
variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- **Base change and extension of scalars.** If an `R`-linear map `f : M → N` to an `S`-module
exhibits `N` as the base change of `M` along `R → S`, then its adjoint `S ⊗[R] M → N`,
`s ⊗ m ↦ s • f m`, is an isomorphism of `S`-modules. -/
theorem isIso_extendRestrictScalarsAdj_homEquiv_symm_of_isBaseChange
    {M N : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module S N]
    [IsScalarTower R S N] {f : M →ₗ[R] N} (hf : IsBaseChange S f) :
    IsIso (((extendRestrictScalarsAdj (algebraMap R S)).homEquiv (of R M) (of S N)).symm
      (ofHom f ≫ (restrictScalarsAlgebraMapIso N).inv)) := by
  have key : (extendScalarsAlgebraMapIso (of R M)).inv ≫
      ((extendRestrictScalarsAdj (algebraMap R S)).homEquiv (of R M) (of S N)).symm
        (ofHom f ≫ (restrictScalarsAlgebraMapIso N).inv) =
      ofHom hf.equiv.toLinearMap := by
    refine hom_ext (LinearMap.ext fun z ↦ ?_)
    induction z using TensorProduct.inductionOn with
    | tmul s m =>
      rw [hom_ofHom, LinearEquiv.coe_coe, IsBaseChange.equiv_tmul, hom_comp,
        LinearMap.comp_apply, extendScalarsAlgebraMapIso_inv_tmul]
      -- The adjoint of a morphism into a restriction of scalars is Mathlib's
      -- `fromExtendScalars`, which sends `s ⊗ m` to `s • f m`.
      change (ExtendRestrictScalarsAdj.HomEquiv.fromExtendScalars
        (algebraMap R S) (Y := of S N) (ofHom f ≫
          (restrictScalarsAlgebraMapIso N).inv)).hom
            (s ⊗ₜ[R, algebraMap R S] m) = s • f m
      erw [ExtendRestrictScalarsAdj.HomEquiv.fromExtendScalars_hom_apply]
      exact congrArg (fun x : N ↦ s • x)
        (restrictScalarsAlgebraMapIso_inv_apply (R := R) (S := S) N (f m))
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have : IsIso ((extendScalarsAlgebraMapIso (of R M)).inv ≫
      ((extendRestrictScalarsAdj (algebraMap R S)).homEquiv (of R M) (of S N)).symm
        (ofHom f ≫ (restrictScalarsAlgebraMapIso N).inv)) := by
    rw [key]
    exact hf.equiv.toModuleIso.isIso_hom
  exact IsIso.of_isIso_comp_left (extendScalarsAlgebraMapIso _).inv _

end BaseChange

section Cyclic

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] (f : R →+* S)

/-- The extension of scalars of a module generated by `m₀` is generated by `1 ⊗ m₀`. -/
theorem ExtendScalars.span_singleton_one_tmul_eq_top
    {M : ModuleCat.{v} R} {m₀ : M} (h : Submodule.span R {m₀} = ⊤) :
    Submodule.span S ({(1 : S) ⊗ₜ[R,f] m₀} : Set ((extendScalars f).obj M)) = ⊤ := by
  -- `s • (1 ⊗ m₀) = s ⊗ m₀`, stated for `s : S` rather than for the restriction of scalars of `S`.
  have key (s : S) := (ExtendScalars.smul_tmul f (M := M) s 1 m₀).trans
    (congrArg (· ⊗ₜ[R,f] m₀) (mul_one s))
  refine eq_top_iff.mpr fun x _ ↦ Submodule.mem_span_singleton.mpr ?_
  obtain ⟨s, rfl⟩ := TensorProduct.exists_eq_tmul_of_span_singleton_eq_top h x
  exact ⟨s, key s⟩

end Cyclic

section Semilinear

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] (f : R →+* S)

/-- **Morphisms out of an extension of scalars are semilinear maps.** An `S`-linear map
`φ : S ⊗_{R,f} M → N` corresponds to the `f`-semilinear map `m ↦ φ (1 ⊗ m)`; conversely an
`f`-semilinear map `g : M → N` linearizes to `s ⊗ m ↦ s • g m`. This combines the adjunction
`ModuleCat.extendRestrictScalarsAdj f` with `ModuleCat.semilinearMapAddEquiv f`. -/
noncomputable def extendScalarsHomEquivSemilinearMap (M : ModuleCat.{max w v} R)
    (N : ModuleCat.{max w v} S) : ((extendScalars f).obj M ⟶ N) ≃ (M →ₛₗ[f] N) :=
  ((extendRestrictScalarsAdj f).homEquiv M N).trans (semilinearMapAddEquiv f M N).symm.toEquiv

@[simp]
theorem extendScalarsHomEquivSemilinearMap_apply {M : ModuleCat.{max w v} R}
    {N : ModuleCat.{max w v} S} (φ : (extendScalars f).obj M ⟶ N) (m : M) :
    extendScalarsHomEquivSemilinearMap f M N φ m = φ ((1 : S) ⊗ₜ[R,f] m) :=
  (rfl)

@[simp]
theorem extendScalarsHomEquivSemilinearMap_symm_apply_tmul {M : ModuleCat.{max w v} R}
    {N : ModuleCat.{max w v} S} (g : M →ₛₗ[f] N) (s : S) (m : M) :
    (extendScalarsHomEquivSemilinearMap f M N).symm g (s ⊗ₜ[R,f] m) = s • g m := by
  -- `s • (1 ⊗ m) = s ⊗ m`, stated for `s : S` rather than for the restriction of scalars of `S`.
  have h := (ExtendScalars.smul_tmul f (M := M) s 1 m).trans
    (congrArg (· ⊗ₜ[R,f] m) (mul_one s))
  refine (congrArg _ h.symm).trans
    ((((extendScalarsHomEquivSemilinearMap f M N).symm g).hom.map_smul s _).trans ?_)
  exact congrArg (s • ·) (congrFun (congrArg DFunLike.coe
    ((extendScalarsHomEquivSemilinearMap f M N).apply_symm_apply g)) m)

end Semilinear

end ModuleCat

namespace RingHom

open CategoryTheory ModuleCat
open scoped TensorProduct ChangeOfRings

/-- Scalar extension of a finite relation cokernel agrees with the cokernel of its
coefficientwise image under a ring homomorphism. -/
theorem nonempty_extendScalars_cokernel_pi_iso
    {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (n m : ℕ)
    (r : (Fin m → S) →ₗ[S] (Fin n → S))
    (rᵢ : (Fin m → R) →ₗ[R] (Fin n → R))
    (hcoeff : ∀ (row : Fin n) (col : Fin m),
      φ (rᵢ (Pi.single col 1) row) = r (Pi.single col 1) row) :
    Nonempty ((extendScalars φ).obj
        (ModuleCat.of R (ULift.{v} ((Fin n → R) ⧸ LinearMap.range rᵢ))) ≅
        ModuleCat.of S
          (ULift.{v} ((Fin n → S) ⧸ LinearMap.range r))) := by
  classical
  let := φ.toAlgebra
  have hmatrix : (LinearMap.toMatrix' rᵢ).map (algebraMap R S) =
      LinearMap.toMatrix' r := by
    ext row col
    exact hcoeff row col
  have hsource : (LinearMap.toMatrix' rᵢ).mulVecLin = rᵢ := Matrix.toLin'_toMatrix' rᵢ
  have htarget : ((LinearMap.toMatrix' rᵢ).map (algebraMap R S)).mulVecLin = r := by
    rw [hmatrix]
    exact Matrix.toLin'_toMatrix' r
  let eQ : S ⊗[R] ((Fin n → R) ⧸ LinearMap.range rᵢ) ≃ₗ[S]
      (Fin n → S) ⧸ LinearMap.range r := by
    have comparison := (LinearMap.toMatrix' rᵢ).cokernelBaseChangeEquiv (S := S)
    rw [hsource, htarget] at comparison
    exact comparison
  let eU := (ULift.moduleEquiv : ULift.{v} ((Fin n → R) ⧸ LinearMap.range rᵢ) ≃ₗ[R]
    ((Fin n → R) ⧸ LinearMap.range rᵢ)).baseChange R S _ _
  let e := eU.trans (eQ.trans ULift.moduleEquiv.symm)
  exact ⟨e.toModuleIso⟩

end RingHom
