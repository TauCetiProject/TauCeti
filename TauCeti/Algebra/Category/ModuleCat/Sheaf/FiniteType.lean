module

public import TauCeti.Algebra.Category.ModuleCat.Sheaf.LocallyFree

/-!
# Finite type of sheaves of modules is local

A sheaf of modules is of finite type if it is locally generated by finitely many sections. This
file shows that finite type is invariant under isomorphism, that it can be checked on a covering
family, and that it is preserved by pushforward along a continuous and cocontinuous left adjoint
inducing an isomorphism of structure sheaves. The last statement is the finite-type analogue of
Mathlib's `SheafOfModules.isQuasicoherent_pushforward_of_isLeftAdjoint`, and local generators are
carried along the functor the way `SheafOfModules.QuasicoherentData.pushforward` carries
presentations. On schemes these give that finite type can be checked on an open cover
(`TauCeti.AlgebraicGeometry.isFiniteType_of_isFiniteType_restrict`).

## Main declarations

* `SheafOfModules.LocalGeneratorsData.isFiniteType`: finite-type local generators, indexed in any
  universe, make a sheaf of modules of finite type.
* `SheafOfModules.isFiniteType`: finite type as an `ObjectProperty`; it is closed under
  isomorphisms.
* `SheafOfModules.IsFiniteType.of_coversTop`: finite type can be checked on a covering family.
* `SheafOfModules.LocalGeneratorsData.pushforward`: local generators carried along a continuous
  and cocontinuous functor.
* `SheafOfModules.isFiniteType_pushforward_of_isLeftAdjoint`: pushforward along a left adjoint
  continuous functor, with an isomorphism of structure sheaves, preserves finite type.
-/

public section

open CategoryTheory Limits

universe w u v₁ v₂ u₁ u₂

namespace TauCeti

namespace SheafOfModules

section LocalGeneratorsData

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [∀ X, HasWeakSheafify (J.over X) AddCommGrpCat.{u}]
  [∀ X, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- Shrinking the index type of finite-type local generators keeps the selected generating
families, so the shrunk data is of finite type. -/
instance _root_.SheafOfModules.LocalGeneratorsData.isFiniteType_shrink
    {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData) [q.IsFiniteType] :
    q.shrink.IsFiniteType where
  isFiniteType i :=
    let _ := _root_.SheafOfModules.LocalGeneratorsData.IsFiniteType.isFiniteType
      (p := q) i.2.choose
    inferInstanceAs (q.generators i.2.choose).IsFiniteType

/-- A sheaf of modules with finite-type local generators, indexed in any universe, is of finite
type. -/
theorem _root_.SheafOfModules.LocalGeneratorsData.isFiniteType {M : SheafOfModules.{u} R}
    (q : M.LocalGeneratorsData) [q.IsFiniteType] : M.IsFiniteType :=
  ⟨q.shrink, inferInstance⟩

variable (R) in
/-- Finite type of sheaves of modules, as a property of objects. -/
abbrev _root_.SheafOfModules.isFiniteType : ObjectProperty (SheafOfModules.{u} R) :=
  _root_.SheafOfModules.IsFiniteType

/-- Finite type is invariant under isomorphism. -/
instance : (_root_.SheafOfModules.isFiniteType R).IsClosedUnderIsomorphisms where
  of_iso {M _} e (_ : M.IsFiniteType) := by
    obtain ⟨q, _⟩ := _root_.SheafOfModules.IsFiniteType.exists_localGeneratorsData M
    exact (q.ofIsIso e.hom).isFiniteType

end LocalGeneratorsData

section Locality

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [∀ X, HasSheafify (J.over X) AddCommGrpCat.{u}]
  [∀ X, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ X Y, HasWeakSheafify ((J.over X).over Y) AddCommGrpCat.{u}]
  [∀ X Y, ((J.over X).over Y).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- If a sheaf of modules is of finite type after restriction to every member of a covering
family, then it is of finite type: the local generators on the members combine by
`SheafOfModules.LocalGeneratorsData.bind`. -/
theorem _root_.SheafOfModules.IsFiniteType.of_coversTop {M : SheafOfModules.{u} R} {I : Type*}
    (X : I → C) (hX : J.CoversTop X) [∀ i, (M.over (X i)).IsFiniteType] : M.IsFiniteType := by
  have h : ∀ i, ∃ D : (M.over (X i)).LocalGeneratorsData, D.IsFiniteType := fun i ↦
    _root_.SheafOfModules.IsFiniteType.exists_localGeneratorsData (M.over (X i))
  choose D hD using h
  exact (_root_.SheafOfModules.LocalGeneratorsData.bind X hX D).isFiniteType

end Locality

section map

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  {D : Type u₂} [Category.{v₂} D] {K : GrothendieckTopology D}
  {S : Sheaf K RingCat.{u}} [∀ (X : D), (K.over X).WEqualsLocallyBijective AddCommGrpCat]
  [∀ X, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ (X : C), HasSheafify (J.over X) AddCommGrpCat.{u}]
  [∀ (X : D), HasSheafify (K.over X) AddCommGrpCat.{u}]
  (G : D ⥤ C) [G.IsContinuous K J] [G.IsCocontinuous K J]
  (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u} K J).obj R)

/-- Local generators of `M`, carried along a continuous and cocontinuous functor `G` to local
generators of the pushforward of `M`: the cover is formed by the objects of `D` whose image maps
to a member of the original cover, and the generators are carried as in
`SheafOfModules.QuasicoherentData.pushforward`. -/
@[expose] noncomputable def _root_.SheafOfModules.LocalGeneratorsData.pushforward
    (η : (_root_.SheafOfModules.pushforward φ).obj (_root_.SheafOfModules.unit R) ≅
      _root_.SheafOfModules.unit S)
    [∀ (X : D), (Over.post G).IsContinuous (K.over X) (J.over _)]
    (h : ∀ (X : D) (Y : C) (f : G.obj X ⟶ Y),
      PreservesColimitsOfSize.{u, u} <|
      _root_.SheafOfModules.pushforward.{u} (R := (R.over Y))
        (F := Over.post (X := X) G ⋙ Over.map f)
        (((Over.forget X).sheafPushforwardContinuous RingCat.{u} (K.over X) K).map φ))
    {M : SheafOfModules.{u} R} (P : _root_.SheafOfModules.LocalGeneratorsData.{w} M) :
    _root_.SheafOfModules.LocalGeneratorsData.{max u₂ v₁ w}
      ((_root_.SheafOfModules.pushforward φ).obj M) where
  I := Σ (X : D) (i : P.I), G.obj X ⟶ P.X i
  X i := i.1
  coversTop Y := by
    refine K.superset_covering ?_ <| G.cover_lift K _ (P.coversTop (G.obj Y))
    intro Z g ⟨i, ⟨v⟩⟩
    exact ⟨⟨Z, i, v⟩, ⟨𝟙 _⟩⟩
  generators i := by
    letI overS : SheafOfModules.{u} S ⥤ SheafOfModules.{u} (S.over i.1) :=
      _root_.SheafOfModules.pushforward (𝟙 _)
    letI G' := Over.post (X := i.1) G ⋙ Over.map i.2.2
    letI ψ : S.over i.1 ⟶
        (G'.sheafPushforwardContinuous RingCat.{u} (K.over i.1) (J.over (P.X i.2.1))).obj
          (R.over (P.X i.2.1)) :=
      ((Over.forget i.1).sheafPushforwardContinuous RingCat.{u} (K.over i.1) K).map φ
    letI e : (_root_.SheafOfModules.pushforward ψ).obj
        (_root_.SheafOfModules.unit (R.over (P.X i.snd.fst))) ≅
      _root_.SheafOfModules.unit (S.over i.fst) := overS.mapIso η
    haveI : PreservesColimitsOfSize.{u, u, _} (_root_.SheafOfModules.pushforward ψ) := h _ _ _
    exact (P.generators i.2.1).map (_root_.SheafOfModules.pushforward ψ) e.symm

section pushforward

variable (η : (_root_.SheafOfModules.pushforward φ).obj (_root_.SheafOfModules.unit R) ≅
      _root_.SheafOfModules.unit S)
    [∀ (X : D), (Over.post G).IsContinuous (K.over X) (J.over _)]
    (h : ∀ (X : D) (Y : C) (f : G.obj X ⟶ Y),
      PreservesColimitsOfSize.{u, u} <|
      _root_.SheafOfModules.pushforward.{u} (R := (R.over Y))
        (F := Over.post (X := X) G ⋙ Over.map f)
        (((Over.forget X).sheafPushforwardContinuous RingCat.{u} (K.over X) K).map φ))
    {M : SheafOfModules.{u} R} (P : _root_.SheafOfModules.LocalGeneratorsData.{w} M)

/-- The covering family of the pushforward of local generators is indexed by the objects of `D`
together with a member of the original cover and a map from the image to that member. -/
@[simp]
lemma _root_.SheafOfModules.LocalGeneratorsData.pushforward_I :
    (P.pushforward G φ η h).I = Σ (X : D) (i : P.I), G.obj X ⟶ P.X i :=
  rfl

/-- The covering object of the pushforward of local generators at an index `⟨X, i, f⟩` is `X`. -/
@[simp]
lemma _root_.SheafOfModules.LocalGeneratorsData.pushforward_X
    (i : Σ (X : D) (i : P.I), G.obj X ⟶ P.X i) :
    (P.pushforward G φ η h).X i = i.1 :=
  rfl

/-- The generating sections of the pushforward of local generators at an index `⟨X, i, f⟩`
are the generating sections of `P` at `i`, carried along the pushforward over `X`. -/
lemma _root_.SheafOfModules.LocalGeneratorsData.pushforward_generators
    (i : Σ (X : D) (i : P.I), G.obj X ⟶ P.X i) :
    (P.pushforward G φ η h).generators i =
      haveI := h i.1 _ i.2.2
      (P.generators i.2.1).map
        (_root_.SheafOfModules.pushforward (show S.over i.1 ⟶
            ((Over.post (X := i.1) G ⋙ Over.map i.2.2).sheafPushforwardContinuous RingCat.{u}
              (K.over i.1) (J.over (P.X i.2.1))).obj (R.over (P.X i.2.1)) from
          ((Over.forget i.1).sheafPushforwardContinuous RingCat.{u} (K.over i.1) K).map φ))
        ((_root_.SheafOfModules.pushforward (𝟙 (S.over i.1))).mapIso η).symm :=
  rfl

/-- The generating sections of the pushforward of local generators at an index `⟨X, i, f⟩` are
indexed like the generating sections of `P` at `i`. -/
@[simp]
lemma _root_.SheafOfModules.LocalGeneratorsData.pushforward_generators_I
    (i : Σ (X : D) (i : P.I), G.obj X ⟶ P.X i) :
    ((P.pushforward G φ η h).generators i).I = (P.generators i.2.1).I :=
  rfl

end pushforward

/-- Carrying local generators along a continuous and cocontinuous functor preserves finiteness. -/
instance _root_.SheafOfModules.LocalGeneratorsData.isFiniteType_pushforward
    (η : (_root_.SheafOfModules.pushforward φ).obj (_root_.SheafOfModules.unit R) ≅
      _root_.SheafOfModules.unit S)
    [∀ (X : D), (Over.post G).IsContinuous (K.over X) (J.over _)]
    (h : ∀ (X : D) (Y : C) (f : G.obj X ⟶ Y),
      PreservesColimitsOfSize.{u, u} <|
      _root_.SheafOfModules.pushforward.{u} (R := (R.over Y))
        (F := Over.post (X := X) G ⋙ Over.map f)
        (((Over.forget X).sheafPushforwardContinuous RingCat.{u} (K.over X) K).map φ))
    {M : SheafOfModules.{u} R} (P : _root_.SheafOfModules.LocalGeneratorsData.{w} M)
    [P.IsFiniteType] : (P.pushforward G φ η h).IsFiniteType where
  isFiniteType i :=
    let _ := _root_.SheafOfModules.LocalGeneratorsData.IsFiniteType.isFiniteType (p := P) i.2.1
    ⟨_root_.SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := P.generators i.2.1)⟩

/-- The pushforward of a module of finite type along a left adjoint continuous functor, with an
isomorphism of structure sheaves, is of finite type. -/
theorem _root_.SheafOfModules.isFiniteType_pushforward_of_isLeftAdjoint
    (η : (_root_.SheafOfModules.pushforward φ).obj (_root_.SheafOfModules.unit R) ≅
      _root_.SheafOfModules.unit S)
    [G.IsLeftAdjoint] [hφ : IsIso φ]
    [hG : ∀ X, Functor.IsContinuous (Over.post (X := X) G) (K.over _) (J.over _)]
    [HasPullbacks C] [HasPullbacks D]
    {M : SheafOfModules.{u} R} [hM : M.IsFiniteType] :
    ((_root_.SheafOfModules.pushforward φ).obj M).IsFiniteType := by
  obtain ⟨P, _⟩ := _root_.SheafOfModules.IsFiniteType.exists_localGeneratorsData M
  refine (P.pushforward G φ η fun X Y f ↦ ?_).isFiniteType
  let G' := Over.post (X := X) G ⋙ Over.map f
  have : G'.IsContinuous (K.over X) (J.over Y) := Functor.isContinuous_comp _ _ _ (J.over _) _
  have : G'.IsCocontinuous (K.over X) (J.over Y) := isCocontinuous_comp _ _ _ (J.over _)
  let a : S.over X ⟶
      (G'.sheafPushforwardContinuous RingCat.{u} (K.over X) (J.over Y)).obj (R.over Y) :=
    ((Over.forget X).sheafPushforwardContinuous RingCat.{u} (K.over X) K).map φ
  have : IsIso a := Functor.map_isIso _ φ
  have : (_root_.SheafOfModules.pushforward.{u} a).IsLeftAdjoint :=
    _root_.SheafOfModules.isLeftAdjoint_pushforward_of_isIso a
  infer_instance

end map

end SheafOfModules

end TauCeti
