module

public import TauCeti.Algebra.Category.ModuleCat.Sheaf.ExteriorPower.Pullback
public import TauCeti.Algebra.Category.ModuleCat.Sheaf.ExteriorPower.Stalk
public import TauCeti.Algebra.Category.ModuleCat.Sheaf.Pullback.Stalk
public import TauCeti.LinearAlgebra.ExteriorPower.BaseChange
public import TauCeti.LinearAlgebra.ExteriorPower.Basic

/-!
# Pullback commutes with exterior powers on ringed spaces

On each stalk, the canonical exterior-power pullback comparison is the scalar-extension
equivalence for exterior powers along the map of ring stalks. Thus the comparison is an
isomorphism in every degree for every sheaf of modules. The identification uses
`SheafOfModules.exteriorPowerStalkEquiv` and `TauCeti.SheafOfModules.pullbackStalkEquiv`.

## References

* [The Stacks Project, Lemma 17.21.3](https://stacks.math.columbia.edu/tag/01CI).
-/

public section

open CategoryTheory Opposite TopologicalSpace TopCat.Presheaf
open TauCeti.SheafOfModules (ringCatSheaf stalkAlgebra pullbackStalkEquiv
  pullbackStalkEquiv_tmul_germ)
open scoped TensorProduct

universe u

noncomputable section

namespace SheafOfModules

variable {X Y : TopCat.{u}} {R : Sheaf (Opens.grothendieckTopology X) CommRingCat.{u}}
  {S : Sheaf (Opens.grothendieckTopology Y) CommRingCat.{u}} {f : Y ⟶ X}
  (φ : ringCatSheaf R ⟶
    ((Opens.map f).sheafPushforwardContinuous RingCat.{u} _ _).obj (ringCatSheaf S))
  [(pushforward.{u} φ).IsRightAdjoint]
  (M : SheafOfModules.{u} (ringCatSheaf R)) (n : ℕ)

/-- The stalk map of the exterior-power pullback comparison, on a wedge of germs with
representatives on one open, sends that wedge to the wedge of the pulled-back germs. -/
private theorem pullbackExteriorPowerComparison_stalk_one_tmul_germ (y : Y)
    (U : Opens X) (hy : f y ∈ U) (m : Fin n → M.val.obj (op U)) :
    letI := stalkAlgebra φ y
    let v := fun i ↦ germ M.val.presheaf U (f y) hy (m i)
    ((pullback φ).obj M).exteriorPowerStalkEquiv y n
      (PresheafOfModules.stalkMapCommRing (S := S.obj) y
        ((pullbackExteriorPowerComparison (pullbackPushforwardAdjunction φ) n).app M).val
        (pullbackStalkEquiv φ ((exteriorPower R n).obj M) y
          (1 ⊗ₜ (M.exteriorPowerStalkEquiv (f y) n).symm
            (exteriorPower.ιMulti ↑(stalk R.obj (f y)) n v)))) =
      exteriorPower.ιMulti ↑(stalk S.obj y) n
        (fun i ↦ pullbackStalkEquiv φ M y (1 ⊗ₜ v i)) := by
  let := stalkAlgebra φ y
  dsimp only
  -- The germ formulas use additive-presheaf carriers for the module sections.
  erw [exteriorPowerStalkEquiv_symm_ιMulti_germ, pullbackStalkEquiv_tmul_germ, one_smul,
    PresheafOfModules.stalkMapCommRing_germ (S := S.obj)]
  let G := (exteriorPower S n).obj ((pullback φ).obj M)
  let V := (Opens.map f).obj U
  let germToWedge (z : G.val.obj (op V)) :=
    ((pullback φ).obj M).exteriorPowerStalkEquiv y n (germ G.val.presheaf V y hy z)
  have hs := pullbackExteriorPowerComparison_app_val_app_unit_mk
    (pullbackPushforwardAdjunction φ) n M (op U) m
  refine (congrArg germToWedge hs).trans ?_
  dsimp only [germToWedge, G, V]
  erw [exteriorPowerStalkEquiv_germ_mk]
  congr 1
  funext i
  erw [pullbackStalkEquiv_tmul_germ, one_smul]

/-- Under the canonical stalk identifications, the exterior-power pullback comparison is
the scalar-extension equivalence for exterior powers along the map of ring stalks. -/
theorem pullbackExteriorPowerComparison_stalk (y : Y) :
    letI := stalkAlgebra φ y
    (((pullback φ).obj M).exteriorPowerStalkEquiv y n).toLinearMap ∘ₗ
      PresheafOfModules.stalkMapCommRing (S := S.obj) y
        ((pullbackExteriorPowerComparison (pullbackPushforwardAdjunction φ) n).app M).val ∘ₗ
      ((M.exteriorPowerStalkEquiv (f y) n).symm.baseChange _ _ ≪≫ₗ
        pullbackStalkEquiv φ ((exteriorPower R n).obj M) y).toLinearMap =
      ((TauCeti.exteriorPower.equivBaseChange ↑(stalk S.obj y) n).symm ≪≫ₗ
        (pullbackStalkEquiv φ M y).exteriorPower n).toLinearMap := by
  let := stalkAlgebra φ y
  let A : Type u := ↑(stalk R.obj (f y))
  let B : Type u := ↑(stalk S.obj y)
  let T : Type u := ⋀[B]^n ↑(stalk ((pullback φ).obj M).val.presheaf y)
  let : Module A T := Module.compHom T (algebraMap A B)
  let : IsScalarTower A B T := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  -- Scalar extension is generated by tensors with coefficient one. On the exterior
  -- power factor it suffices to test wedges of germs with a common representative open.
  apply (LinearMap.liftBaseChangeEquiv B).symm.injective
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro v
  obtain ⟨U, _, hy, m, hm⟩ :=
    TopCat.Presheaf.exists_le_germ_eq_family M.val.presheaf v (V := ⊤) (by trivial)
  rw [← funext hm]
  let germs := fun i ↦ germ M.val.presheaf U (f y) hy (m i)
  let w := exteriorPower.ιMulti A n germs
  let e := M.exteriorPowerStalkEquiv (f y) n
  let d := PresheafOfModules.stalkMapCommRing (S := S.obj) y
    ((pullbackExteriorPowerComparison (pullbackPushforwardAdjunction φ) n).app M).val
  -- Evaluate the composite maps on the generating tensor before applying the comparison
  -- formulas. Rewriting inside the composites would have to match different stalk instances.
  change ((pullback φ).obj M).exteriorPowerStalkEquiv y n
      (d (pullbackStalkEquiv φ ((exteriorPower R n).obj M) y
        (e.symm.baseChange A B _ _ (1 ⊗ₜ w)))) =
    (pullbackStalkEquiv φ M y).exteriorPower n
      ((TauCeti.exteriorPower.equivBaseChange B n).symm (1 ⊗ₜ w))
  rw [LinearEquiv.baseChange_tmul]
  refine (pullbackExteriorPowerComparison_stalk_one_tmul_germ φ M n y U hy m).trans ?_
  -- Apply the base-change formula directly to the tensor. A rewrite of the whole goal
  -- would have to match the sheaf and underlying presheaf module structures on its stalk.
  have hw := TauCeti.exteriorPower.equivBaseChange_symm_tmul_ιMulti (R := A) B (1 : B) germs
  let E := pullbackStalkEquiv φ M y
  symm
  exact (congrArg (E.exteriorPower n) (hw.trans (one_smul B _))).trans
    (E.exteriorPower_apply_ιMulti n (fun i ↦ 1 ⊗ₜ[A] germs i))

/-- Pullback of sheaves of modules along a morphism of ringed spaces commutes with exterior
powers in every degree. -/
instance isIso_pullbackExteriorPowerComparison_app :
    IsIso ((pullbackExteriorPowerComparison (pullbackPushforwardAdjunction φ) n).app M) := by
  let c := (pullbackExteriorPowerComparison (pullbackPushforwardAdjunction φ) n).app M
  suffices IsIso ((toSheaf (ringCatSheaf S)).map c) from
    isIso_of_reflects_iso c (toSheaf (ringCatSheaf S))
  rw [TopCat.Presheaf.isIso_iff_stalkFunctor_map_iso]
  intro y
  apply (PresheafOfModules.bijective_stalkMapCommRing_iff_isIso (S := S.obj) y c.val).mp
  let := stalkAlgebra φ y
  let e := (M.exteriorPowerStalkEquiv (f y) n).symm.baseChange _ _ ≪≫ₗ
    pullbackStalkEquiv φ ((exteriorPower R n).obj M) y
  let e' := ((pullback φ).obj M).exteriorPowerStalkEquiv y n
  let b := (TauCeti.exteriorPower.equivBaseChange ↑(stalk S.obj y) n).symm ≪≫ₗ
    (pullbackStalkEquiv φ M y).exteriorPower n
  have h : ⇑e' ∘ ⇑(PresheafOfModules.stalkMapCommRing (S := S.obj) y c.val) ∘ ⇑e = ⇑b :=
    funext (LinearMap.congr_fun (pullbackExteriorPowerComparison_stalk φ M n y))
  exact (EquivLike.comp_bijective _ e').mp
    ((EquivLike.bijective_comp e _).mp (h.symm ▸ b.bijective))

end SheafOfModules
