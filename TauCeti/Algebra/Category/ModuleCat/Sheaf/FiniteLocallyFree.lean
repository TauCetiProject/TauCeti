/-!
# Finite locally free sheaves have finite local bases

Let `R` be a sheaf of commutative rings on a small site with pullbacks. A sheaf of `R`-modules
is finite locally free if it is locally free and finitely presented
(`SheafOfModules.isFiniteLocallyFree`). Local freeness alone provides local bases whose index
types may be infinite and vary from chart to chart; finite type provides finitely many local
generators on possibly different charts. This file shows that a locally free sheaf of finite type
admits locally free data with finite local bases
(`SheafOfModules.IsLocallyFree.exists_isLocallyFreeData_isFiniteType`), so that finite local
freeness is equivalent to the existence of such data
(`SheafOfModules.isFiniteLocallyFree_iff_exists_isLocallyFreeData_isFiniteType`), the form in
which it is used to reduce statements about finite locally free sheaves to finite free sheaves.

The proof passes to a common refinement of the two covers, on which the sheaf is at once free
on some index type `I` and generated by finitely many sections. If `I` is finite there is nothing
to do. Otherwise the free sheaf on `I` receives an epimorphism from a finite free sheaf, and the
degenerate case is that the sheaf of rings vanishes: an epimorphism `free J ⟶ free K` between
finite free sheaves with `|J| < |K|` dualizes to a monomorphism `free K ⟶ free J`, whose sections
over each object `W` give an injective `R(W)`-linear map `R(W)^K → R(W)^J`, so that `R(W)` is the
zero ring by the strong rank condition
(`TauCeti.SheafOfModules.subsingleton_of_epi_free_of_card_lt`). All sheaves of modules over a
vanishing sheaf of rings are zero (`TauCeti.SheafOfModules.isZero_of_forall_subsingleton`), and
the zero sheaf is free on the empty type.

## Main declarations

* `TauCeti.SheafOfModules.subsingleton_of_epi_free_of_card_lt`: an epimorphism `free J ⟶ free K`
  with `|J| < |K|` forces the sheaf of rings to vanish;
* `TauCeti.SheafOfModules.natCard_eq_of_iso_free`: consequently, isomorphic finite free sheaves
  over a sheaf of rings with a nonzero ring of sections have index types of the same cardinality,
  which makes the rank of a finite locally free sheaf well defined;
* `SheafOfModules.GeneratingSections.exists_isIso_π_isFiniteType`: a sheaf of modules that is
  free and of finite type is free on a finite type;
* `SheafOfModules.IsLocallyFree.exists_isLocallyFreeData_isFiniteType` and
  `SheafOfModules.isFiniteLocallyFree_iff_exists_isLocallyFreeData_isFiniteType`: the
  characterization of finite locally free sheaves by finite local bases.

## References

* [The Stacks Project, Tag 01C6](https://stacks.math.columbia.edu/tag/01C6)
-/

public section

open CategoryTheory Limits MonoidalCategory

namespace TauCeti

universe u

noncomputable section

namespace SheafOfModules

open _root_.SheafOfModules

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable {R : Sheaf J CommRingCat.{u}}

section Free

/-- If there is an epimorphism `free J ⟶ free K` between free sheaves of modules on finite types
with `|J| < |K|`, then the sheaf of rings vanishes: all its rings of sections are trivial. -/
theorem subsingleton_of_epi_free_of_card_lt {I K : Type u} [Finite I] [Finite K]
    (f : free (R := ringCatSheaf R) I ⟶ free K) [Epi f] (h : Nat.card I < Nat.card K)
    (W : Cᵒᵖ) : Subsingleton ((ringCatSheaf R).obj.obj W) := by
  by_contra hW
  rw [not_subsingleton_iff_nontrivial] at hW
  -- `ringCatSheaf` forgets commutativity, so the commutative ring structure on the sections of
  -- `R` over `W` is recovered from `R` itself; the strong rank condition needs it.
  let : CommRing ((ringCatSheaf R).obj.obj W) := inferInstanceAs (CommRing (R.obj.obj W))
  have := Fintype.ofFinite I
  have := Fintype.ofFinite K
  let g : free (R := ringCatSheaf R) K ⟶ free I :=
    (dualFreeIso (R := R) K).inv ≫ (MonoidalClosed.pre f).app (𝟙_ _) ≫ (dualFreeIso (R := R) I).hom
  have hg : Mono g := inferInstance
  have hg' : Mono ((evaluation (ringCatSheaf R) W).map g) := inferInstance
  let φ := (evaluationFreeIso (R := R) K W).inv ≫ (evaluation (ringCatSheaf R) W).map g ≫
    (evaluationFreeIso (R := R) I W).hom
  have hφ : Function.Injective φ.hom := (ModuleCat.mono_iff_injective φ).1 inferInstance
  have hle := LinearMap.finrank_le_finrank_of_injective hφ
  rw [Module.finrank_fintype_fun_eq_card, Module.finrank_fintype_fun_eq_card] at hle
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card] at h
  omega

/-- Isomorphic free sheaves of modules on finite types have index types of the same cardinality,
as soon as the sheaf of rings has one nonzero ring of sections. -/
theorem natCard_eq_of_iso_free {I K : Type u} [Finite I] [Finite K]
    (e : free (R := ringCatSheaf R) I ≅ free K) (W : Cᵒᵖ)
    [Nontrivial ((ringCatSheaf R).obj.obj W)] : Nat.card I = Nat.card K := by
  by_contra h
  rcases Nat.lt_or_gt_of_ne h with h | h
  · exact not_subsingleton _ (subsingleton_of_epi_free_of_card_lt e.hom h W)
  · exact not_subsingleton _ (subsingleton_of_epi_free_of_card_lt e.inv h W)

/-- If there is an epimorphism from a free sheaf of modules on a finite type to the free sheaf of
modules on an infinite type, then the sheaf of rings vanishes. -/
theorem subsingleton_of_epi_free_of_infinite {I K : Type u} [Finite I] [Infinite K]
    (f : free (R := ringCatSheaf R) I ⟶ free K) [Epi f] (W : Cᵒᵖ) :
    Subsingleton ((ringCatSheaf R).obj.obj W) := by
  classical
  obtain ⟨s, hs⟩ := Infinite.exists_subset_card_eq K (Nat.card I + 1)
  -- The projection of `free K` onto the summands indexed by `s`, a retraction of `freeMap`.
  let r : free (R := ringCatSheaf R) K ⟶ free (R := ringCatSheaf R) s :=
    (freeHomEquiv _).symm fun k ↦
      if hk : k ∈ s then freeSection ⟨k, hk⟩ else (free s).unitHomEquiv 0
  have hr : freeMap (R := ringCatSheaf R) (Subtype.val : s → K) ≫ r = 𝟙 _ := by
    apply (freeHomEquiv _).injective
    funext j
    simp only [r, freeHomEquiv_comp_apply, freeHomEquiv_freeMap, Function.comp_apply,
      sectionsMap_freeHomEquiv_symm_freeSection, dite_eq_left j.2, Subtype.coe_eta]
  have : IsSplitEpi r := ⟨⟨⟨freeMap Subtype.val, hr⟩⟩⟩
  refine subsingleton_of_epi_free_of_card_lt (f ≫ r) ?_ W
  rw [Nat.card_eq_finsetCard, hs]
  exact Nat.lt_succ_self _

end Free

section GeneratingSections

variable {N : SheafOfModules.{u} (ringCatSheaf R)}

/-- A sheaf of modules which is free, on a possibly infinite index type, and generated by finitely
many sections is free on a finite type. If the given basis is infinite, the sheaf of rings
vanishes and the sheaf is free on the empty type. -/
theorem _root_.SheafOfModules.GeneratingSections.exists_isIso_π_isFiniteType
    (σ τ : N.GeneratingSections) [hσ : IsIso σ.π] [hτ : τ.IsFiniteType] :
    ∃ ρ : N.GeneratingSections, IsIso ρ.π ∧ ρ.IsFiniteType := by
  by_cases hI : Finite σ.I
  · exact ⟨σ, inferInstance, ⟨hI⟩⟩
  rw [not_finite_iff_infinite] at hI
  have hN : IsZero N :=
    isZero_of_forall_subsingleton (subsingleton_of_epi_free_of_infinite (τ.π ≫ inv σ.π)) N
  have hfree : IsZero (free (R := ringCatSheaf R) PEmpty.{u + 1}) := isZero_free PEmpty
  let ρ : N.GeneratingSections := ⟨PEmpty, fun x ↦ x.elim, ⟨fun g h _ ↦ hN.eq_of_src g h⟩⟩
  refine ⟨ρ, ?_, ⟨inferInstanceAs (Finite PEmpty)⟩⟩
  rw [hfree.eq_of_src ρ.π (hfree.iso hN).hom]
  infer_instance

end GeneratingSections

section LocallyFree

omit [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

variable [HasPullbacks C]
  [∀ X, (J.over X).HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
  [∀ X, HasSheafify (J.over X) AddCommGrpCat.{u}]
  [∀ X, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  (M : SheafOfModules.{u} (ringCatSheaf R))

/-- A locally free sheaf of modules of finite type admits locally free data with finite local
bases. -/
theorem _root_.SheafOfModules.IsLocallyFree.exists_isLocallyFreeData_isFiniteType
    [M.IsLocallyFree] [M.IsFiniteType] :
    ∃ q : M.LocalGeneratorsData.{u}, q.IsLocallyFreeData ∧ q.IsFiniteType := by
  obtain ⟨q, hq⟩ := IsLocallyFree.exists_isLocallyFreeData (M := M)
  obtain ⟨p, hp⟩ : ∃ p : M.LocalGeneratorsData.{u}, p.IsFiniteType :=
    IsFiniteType.exists_localGeneratorsData M
  let r := GrothendieckTopology.CoversTop.commonRefinement q.coversTop p.coversTop
  have h : ∀ i : r.I, ∃ ρ : (M.over (r.X i)).GeneratingSections,
      IsIso ρ.π ∧ ρ.IsFiniteType := fun i ↦
    have h₁ : (q.ofRefinement r.X r.coversTop r.leftIndex r.left).IsLocallyFreeData :=
      inferInstance
    have h₂ : (p.ofRefinement r.X r.coversTop r.rightIndex r.right).IsFiniteType :=
      inferInstance
    -- The slice's sheaf of rings is `ringCatSheaf (R.over _)` only up to unfolding, so the
    -- instances are passed explicitly.
    GeneratingSections.exists_isIso_π_isFiniteType (R := R.over (r.X i))
      ((q.ofRefinement r.X r.coversTop r.leftIndex r.left).generators i)
      ((p.ofRefinement r.X r.coversTop r.rightIndex r.right).generators i)
      (hσ := h₁.isIso i) (hτ := h₂.isFiniteType i)
  choose ρ hρ using h
  exact ⟨{ I := r.I, X := r.X, coversTop := r.coversTop, generators := ρ },
    ⟨fun i ↦ (hρ i).1⟩, ⟨fun i ↦ (hρ i).2⟩⟩

/-- A sheaf of modules is finite locally free, that is, locally free and finitely presented, if
and only if it admits locally free data with finite local bases. -/
theorem _root_.SheafOfModules.isFiniteLocallyFree_iff_exists_isLocallyFreeData_isFiniteType :
    isFiniteLocallyFree (ringCatSheaf R) M ↔
      ∃ q : M.LocalGeneratorsData.{u}, q.IsLocallyFreeData ∧ q.IsFiniteType :=
  ⟨fun ⟨_, _⟩ ↦ IsLocallyFree.exists_isLocallyFreeData_isFiniteType M,
    fun ⟨q, hq, hq'⟩ ↦ ⟨q.isLocallyFree, hq.isFinitePresentation hq'⟩⟩

end LocallyFree

end SheafOfModules

end

