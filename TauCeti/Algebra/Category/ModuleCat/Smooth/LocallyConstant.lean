/-!
# Smooth and complete modules over locally constant functions

Let `T` be a Hausdorff space (typically a locally profinite set) and `Λ` a commutative ring, and
write `C(T, Λ) = LocallyConstant T Λ`. Every compact open `U ⊆ T` gives an idempotent
`1_U = U.charFn Λ` of `C(T, Λ)`, and these idempotents multiply like the sets intersect. For a
`C(T, Λ)`-module `M`, multiplication by `1_U` projects `M` onto `1_U·M`, the part of `M` supported
on `U`.

* `M` is *smooth* when every vector is fixed by some `1_U`. These are the smooth modules
  (`TauCeti.smoothModules`) for the family of ideals `TauCeti.compactOpenIdeal T Λ U` of functions
  vanishing on `U` (`TauCeti.smoothModules_compactOpenIdeal_iff`), so the general theory of smooth
  modules applies; in particular the smooth part `M^s = ⋃_U 1_U·M` is `TauCeti.smoothPart`.
  Equivalently, `M^s = C_c(T, Λ) • M` for the ideal `C_c(T, Λ)` of compactly supported functions
  (`TauCeti.smoothPart_compactOpenIdeal_eq_smul_top`), and the multiplication map
  `C_c(T, Λ) ⊗ M → M` is injective with image `M^s`
  (`TauCeti.compactlySupportedTensorEquivSmoothPart`). So `M` is smooth exactly when
  `C_c(T, Λ) ⊗ M → M` is bijective (`TauCeti.smoothModules_compactOpenIdeal_iff_bijective`).
* `M` is *complete* (`TauCeti.completeModules`) when the canonical map `M → M^c` is bijective,
  where `M^c = lim_U 1_U·M` (`TauCeti.completePart`) is the limit over the compact opens, with
  transition maps multiplication by `1_V` for `V ⊆ U`.

The two constructions are projectors: `M^s` is smooth and `M^c` is complete
(`TauCeti.completeModules_completePart`). They exchange the two notions without loss:
`(M^c)^s` is the image of `M^s` in `M^c` (`TauCeti.smoothPart_completePart`), so `M ≅ (M^c)^s` for
smooth `M`, and `(M^s)^c ≅ M^c` for every `M` (`TauCeti.completePartSmoothPartEquiv`). Hence
`M ↦ M^c` and `N ↦ N^s` are mutually inverse equivalences between the categories of smooth and of
complete `C(T, Λ)`-modules (`TauCeti.smoothCompleteEquivalence`). If `T` is compact, every
module is both smooth and complete, while for nontrivial `Λ` the regular module `C(T, Λ)` is
smooth only when `T` is compact.

These categories matter because, for a locally profinite set `T`, both are equivalent to the
category of sheaves of `Λ`-modules on `T`, through compactly supported and through global sections
respectively (Hansen–Kaletha–Weinstein, Lemma B.2.5, not proved here). In this way smooth
`C(T, Λ)`-modules describe étale sheaves on the constant diamond attached to `T` over a geometric
point.

## Main definitions

* `TauCeti.compactOpenIdeal T Λ U`: the ideal of `C(T, Λ)` of functions vanishing on `U`.
* `TauCeti.completePart T Λ M`: the module `M^c = lim_U 1_U·M`.
* `TauCeti.compactlySupportedTensorEquivSmoothPart T Λ M`: the isomorphism
  `C_c(T, Λ) ⊗ M ≅ M^s`, `f ⊗ m ↦ f • m`.
* `TauCeti.toCompletePart T Λ M`: the canonical map `M → M^c`, `m ↦ (1_U • m)_U`.
* `TauCeti.completeModules T Λ`: the modules `M` for which `M → M^c` is bijective.
* `TauCeti.smoothCompleteEquivalence T Λ`: the equivalence between smooth and complete modules.

## References

* David Hansen, Tasho Kaletha and Jared Weinstein, *On the Kottwitz conjecture for local shtuka
  spaces*, Forum of Mathematics, Pi 10 (2022), Appendix B.2, Definition B.2.1 and
  Lemmas B.2.2–B.2.3.
-/

public section

namespace TauCeti

open CategoryTheory TopologicalSpace

universe u v w

variable (T : Type u) [TopologicalSpace T] (Λ : Type w) [CommRing Λ]

/-! ### The ideals of functions vanishing on a compact open set -/

/-- For a compact open subset `U` of `T`, the ideal of `C(T, Λ)` of the locally constant functions
vanishing on `U`. It is generated by `1 - 1_U` (`TauCeti.compactOpenIdeal_eq_span`), and a
`C(T, Λ)`-module is smooth for this family of ideals when each vector is fixed by `1_U` for some
compact open `U` (`TauCeti.smoothModules_compactOpenIdeal_iff`). -/
def compactOpenIdeal (U : CompactOpens T) : Ideal (LocallyConstant T Λ) where
  carrier := {f | ∀ x ∈ U, f x = 0}
  add_mem' hf hg x hx := by simp [hf x hx, hg x hx]
  zero_mem' _ _ := rfl
  smul_mem' c f hf x hx := by simp [hf x hx]

variable {T Λ}

@[simp]
theorem mem_compactOpenIdeal {U : CompactOpens T} {f : LocallyConstant T Λ} :
    f ∈ compactOpenIdeal T Λ U ↔ ∀ x ∈ U, f x = 0 :=
  Iff.rfl

theorem antitone_compactOpenIdeal : Antitone (compactOpenIdeal T Λ) :=
  fun _ _ h _ hf x hx => hf x (h hx)

theorem directed_compactOpenIdeal : Directed (· ≥ ·) (compactOpenIdeal T Λ) :=
  antitone_compactOpenIdeal.directed_ge

variable [T2Space T]

theorem one_sub_charFn_mem_compactOpenIdeal (U : CompactOpens T) :
    1 - U.charFn Λ ∈ compactOpenIdeal T Λ U := fun x hx => by
  simp [LocallyConstant.sub_apply, CompactOpens.charFn_apply_of_mem hx]

/-- A function vanishing on `U` is unchanged by multiplication with `1 - 1_U`. -/
theorem mul_one_sub_charFn_of_mem_compactOpenIdeal {U : CompactOpens T}
    {f : LocallyConstant T Λ} (hf : f ∈ compactOpenIdeal T Λ U) : f * (1 - U.charFn Λ) = f :=
  LocallyConstant.ext fun x => by
    by_cases hx : x ∈ U
    · simp [hf x hx]
    · simp [LocallyConstant.mul_apply, LocallyConstant.sub_apply,
        CompactOpens.charFn_apply_of_notMem hx]

/-- The ideal of functions vanishing on `U` is generated by `1 - 1_U`. -/
theorem compactOpenIdeal_eq_span (U : CompactOpens T) :
    compactOpenIdeal T Λ U = Ideal.span {1 - U.charFn Λ} := by
  refine le_antisymm (fun f hf => Ideal.mem_span_singleton'.2
    ⟨f, mul_one_sub_charFn_of_mem_compactOpenIdeal hf⟩) ?_
  rw [Ideal.span_le, Set.singleton_subset_iff]
  exact one_sub_charFn_mem_compactOpenIdeal U

/-- A vector is killed by the functions vanishing on `U` exactly when `1_U` fixes it. -/
theorem forall_mem_compactOpenIdeal_smul_eq_zero_iff {M : Type*} [AddCommGroup M]
    [Module (LocallyConstant T Λ) M] {U : CompactOpens T} {m : M} :
    (∀ a ∈ compactOpenIdeal T Λ U, a • m = 0) ↔ U.charFn Λ • m = m := by
  refine ⟨fun h => ?_, fun h a ha => ?_⟩
  · have := h _ (one_sub_charFn_mem_compactOpenIdeal U)
    rwa [sub_smul, one_smul, sub_eq_zero, eq_comm] at this
  · rw [← mul_one_sub_charFn_of_mem_compactOpenIdeal ha, mul_smul, sub_smul, one_smul, h,
      sub_self, smul_zero]

/-! ### Smooth modules -/

section Smooth

/-- A `C(T, Λ)`-module is smooth exactly when every vector is fixed by `1_U` for some compact
open `U`. -/
theorem smoothModules_compactOpenIdeal_iff {M : ModuleCat.{v} (LocallyConstant T Λ)} :
    smoothModules (compactOpenIdeal T Λ) M ↔ ∀ m : M, ∃ U : CompactOpens T, U.charFn Λ • m = m := by
  simp only [smoothModules_iff, forall_mem_compactOpenIdeal_smul_eq_zero_iff]

variable {M : Type v} [AddCommGroup M] [Module (LocallyConstant T Λ) M]

/-- A vector lies in the smooth part `M^s` exactly when it is fixed by `1_U` for some compact
open `U`. -/
theorem mem_smoothPart_compactOpenIdeal_iff {m : M} :
    m ∈ smoothPart (compactOpenIdeal T Λ) M ↔ ∃ U : CompactOpens T, U.charFn Λ • m = m := by
  rw [mem_smoothPart_iff_of_mul_mem directed_compactOpenIdeal
    fun b U => ⟨U, fun a ha => Ideal.mul_mem_right b _ ha⟩]
  simp only [forall_mem_compactOpenIdeal_smul_eq_zero_iff]

/-- Every `1_U • m` lies in the smooth part: `1_U·M ⊆ M^s`. -/
theorem charFn_smul_mem_smoothPart (U : CompactOpens T) (m : M) :
    U.charFn Λ • m ∈ smoothPart (compactOpenIdeal T Λ) M :=
  mem_smoothPart_compactOpenIdeal_iff.2 ⟨U, by rw [← mul_smul, (U.isIdempotentElem_charFn Λ).eq]⟩

/-- If `T` is compact, every `C(T, Λ)`-module is smooth. -/
theorem smoothModules_compactOpenIdeal_of_compactSpace [CompactSpace T]
    (M : ModuleCat.{v} (LocallyConstant T Λ)) : smoothModules (compactOpenIdeal T Λ) M :=
  smoothModules_compactOpenIdeal_iff.2 fun _ => ⟨⊤, by simp⟩

/-- For a nontrivial ring `Λ`, the regular module `C(T, Λ)` is smooth exactly when `T` is
compact: `1` is fixed by `1_U` only for `U = T`. -/
theorem smoothModules_compactOpenIdeal_self_iff [Nontrivial Λ] :
    smoothModules (compactOpenIdeal T Λ)
        (ModuleCat.of (LocallyConstant T Λ) (LocallyConstant T Λ)) ↔ CompactSpace T := by
  refine ⟨fun h => ?_, fun _ => smoothModules_compactOpenIdeal_of_compactSpace _⟩
  obtain ⟨U, hU⟩ := smoothModules_compactOpenIdeal_iff.1 h (1 : LocallyConstant T Λ)
  rw [smul_eq_mul, mul_one, CompactOpens.charFn_eq_one_iff] at hU
  exact isCompact_univ_iff.1 (hU ▸ U.isCompact)

end Smooth

/-! ### Smooth modules and compactly supported functions -/

section CompactlySupported

open LocallyConstant TensorProduct

variable {M : Type v} [AddCommGroup M] [Module (LocallyConstant T Λ) M]

/-- The smooth part of a module `M` is `C_c(T, Λ) • M`, the submodule spanned by the `f • m` with
`f` a compactly supported locally constant function. -/
theorem smoothPart_compactOpenIdeal_eq_smul_top :
    smoothPart (compactOpenIdeal T Λ) M = compactlySupportedIdeal T Λ • ⊤ := by
  refine le_antisymm (fun m hm => ?_) (Submodule.smul_le.2 fun f hf m _ => ?_)
  · obtain ⟨U, hU⟩ := mem_smoothPart_compactOpenIdeal_iff.1 hm
    rw [← hU]
    exact Submodule.smul_mem_smul U.charFn_mem_compactlySupportedIdeal Submodule.mem_top
  · obtain ⟨U, hU⟩ := exists_charFn_mul_eq_of_mem_compactlySupportedIdeal hf
    exact mem_smoothPart_compactOpenIdeal_iff.2 ⟨U, by rw [← mul_smul, hU]⟩

variable (T Λ M) in
/-- The isomorphism `C_c(T, Λ) ⊗ M ≅ M^s`, `f ⊗ m ↦ f • m`, between the tensor product of a
`C(T, Λ)`-module `M` with the ideal `C_c(T, Λ)` of compactly supported functions and the smooth
part of `M`. The multiplication map `C_c(T, Λ) ⊗ M → M` is injective for every `M`, since the
ideal `C_c(T, Λ)` is pure, and its image is `M^s`. -/
noncomputable def compactlySupportedTensorEquivSmoothPart :
    compactlySupportedIdeal T Λ ⊗[LocallyConstant T Λ] M ≃ₗ[LocallyConstant T Λ]
      smoothPart (compactOpenIdeal T Λ) M :=
  (LinearEquiv.ofInjective
    ((TensorProduct.lid _ M).toLinearMap ∘ₗ (compactlySupportedIdeal T Λ).subtype.rTensor M)
    ((TensorProduct.lid _ M).injective.comp
      (Ideal.subtype_rTensor_injective_of_pure _ M))).trans
    (LinearEquiv.ofEq _ _ (by
      rw [Ideal.subtype_rTensor_range, smoothPart_compactOpenIdeal_eq_smul_top]))

@[simp]
theorem compactlySupportedTensorEquivSmoothPart_tmul_coe (f : compactlySupportedIdeal T Λ)
    (m : M) :
    (compactlySupportedTensorEquivSmoothPart T Λ M (f ⊗ₜ m) : M) =
      (f : LocallyConstant T Λ) • m := by
  simp [compactlySupportedTensorEquivSmoothPart]

/-- A `C(T, Λ)`-module `M` is smooth exactly when the multiplication map
`C_c(T, Λ) ⊗ M → M`, `f ⊗ m ↦ f • m`, is bijective. -/
theorem smoothModules_compactOpenIdeal_iff_bijective {M : ModuleCat.{v} (LocallyConstant T Λ)} :
    smoothModules (compactOpenIdeal T Λ) M ↔ Function.Bijective
      ((TensorProduct.lid _ M).toLinearMap ∘ₗ (compactlySupportedIdeal T Λ).subtype.rTensor M) := by
  rw [smoothModules_compactOpenIdeal_iff, Function.Bijective, ← LinearMap.range_eq_top,
    Ideal.subtype_rTensor_range, ← smoothPart_compactOpenIdeal_eq_smul_top, Submodule.eq_top_iff']
  simp only [mem_smoothPart_compactOpenIdeal_iff, iff_and_self]
  exact fun _ =>
    (TensorProduct.lid _ M).injective.comp (Ideal.subtype_rTensor_injective_of_pure _ M)

end CompactlySupported

/-! ### The complete part -/

section CompletePart

variable (T Λ) (M : Type v) [AddCommGroup M] [Module (LocallyConstant T Λ) M]
  {N : Type*} [AddCommGroup N] [Module (LocallyConstant T Λ) N]

/-- The *complete part* `M^c = lim_U 1_U·M` of a `C(T, Λ)`-module `M`: the limit, over the compact
opens `U` of `T`, of the modules `1_U·M`, with transition maps multiplication by `1_V` for
`V ⊆ U`. It is the submodule of families `x : CompactOpens T → M` with `1_V • x U = x (U ⊓ V)` for
all `U` and `V`: for `V = U` this says that `x U` lies in `1_U·M`, and for `V ⊆ U` it is the
compatibility of the family with the transition maps. -/
def completePart : Submodule (LocallyConstant T Λ) (CompactOpens T → M) where
  carrier := {x | ∀ U V, V.charFn Λ • x U = x (U ⊓ V)}
  add_mem' hx hy U V := by simp [hx U V, hy U V]
  zero_mem' U V := by simp
  smul_mem' c x hx U V := by
    simp only [Pi.smul_apply]
    rw [← hx U V, ← mul_smul, mul_comm, mul_smul]

variable {T Λ M}

@[simp]
theorem mem_completePart_iff {x : CompactOpens T → M} :
    x ∈ completePart T Λ M ↔ ∀ U V, V.charFn Λ • x U = x (U ⊓ V) :=
  Iff.rfl

/-- Two points of `M^c` are equal when all their coordinates are. -/
@[ext]
theorem completePart.ext {x y : completePart T Λ M}
    (h : ∀ U, (x : CompactOpens T → M) U = (y : CompactOpens T → M) U) : x = y :=
  Subtype.ext (funext h)

/-- The `U`-th coordinate of a point of `M^c` lies in `1_U·M`. -/
theorem charFn_smul_apply_self_of_mem_completePart {x : CompactOpens T → M}
    (hx : x ∈ completePart T Λ M) (U : CompactOpens T) : U.charFn Λ • x U = x U := by
  rw [hx U U, inf_idem]

/-- The coordinates of a point of `M^c` are compatible with the transition maps. -/
theorem charFn_smul_apply_of_le_of_mem_completePart {x : CompactOpens T → M}
    (hx : x ∈ completePart T Λ M) {U V : CompactOpens T} (h : V ≤ U) :
    V.charFn Λ • x U = x V := by
  rw [hx U V, inf_eq_right.2 h]

/-- The coordinates of a point of `M^c` lie in the smooth part `M^s`. -/
theorem apply_mem_smoothPart_of_mem_completePart {x : CompactOpens T → M}
    (hx : x ∈ completePart T Λ M) (U : CompactOpens T) :
    x U ∈ smoothPart (compactOpenIdeal T Λ) M := by
  rw [← charFn_smul_apply_self_of_mem_completePart hx U]
  exact charFn_smul_mem_smoothPart U _

variable (T Λ M)

/-- The canonical map `M → M^c = lim_U 1_U·M`, `m ↦ (1_U • m)_U`. -/
noncomputable def toCompletePart : M →ₗ[LocallyConstant T Λ] completePart T Λ M :=
  LinearMap.codRestrict (completePart T Λ M)
    (LinearMap.pi fun U => LinearMap.lsmul (LocallyConstant T Λ) M (U.charFn Λ)) fun m U V => by
      simp only [LinearMap.pi_apply, LinearMap.lsmul_apply, ← mul_smul, CompactOpens.charFn_inf,
        mul_comm]

variable {T Λ M}

@[simp]
theorem toCompletePart_apply_coe (m : M) (U : CompactOpens T) :
    (toCompletePart T Λ M m : CompactOpens T → M) U = U.charFn Λ • m :=
  (rfl)

/-- In `M^c`, the `1_U`-part of a point `x` is the image of its `U`-th coordinate:
`1_U • x = (1_V • x U)_V`. -/
theorem charFn_smul_eq_toCompletePart (x : completePart T Λ M) (U : CompactOpens T) :
    U.charFn Λ • x = toCompletePart T Λ M ((x : CompactOpens T → M) U) := by
  ext V
  rw [toCompletePart_apply_coe, x.property U V, inf_comm]
  exact x.property V U

/-- A point of `M^c` fixed by `1_U` is the image of its `U`-th coordinate. -/
theorem eq_toCompletePart_of_charFn_smul_eq {x : completePart T Λ M} {U : CompactOpens T}
    (hx : U.charFn Λ • x = x) : x = toCompletePart T Λ M ((x : CompactOpens T → M) U) := by
  rw [← charFn_smul_eq_toCompletePart, hx]

/-- A point of `M^c` fixed by `1_W` has the same coordinates at `W` and at every `U ⊇ W`. -/
theorem apply_eq_apply_of_charFn_smul_eq {x : completePart T Λ M} {U W : CompactOpens T}
    (hx : W.charFn Λ • x = x) (h : W ≤ U) :
    (x : CompactOpens T → M) U = (x : CompactOpens T → M) W := by
  have := congr_fun (congrArg Subtype.val hx) U
  rw [← this, Submodule.coe_smul, Pi.smul_apply, x.property U W, inf_eq_right.2 h]

/-- The map `M → M^c` is injective on the smooth part `M^s`. -/
theorem injective_toCompletePart_comp_subtype :
    Function.Injective
      (toCompletePart T Λ M ∘ₗ (smoothPart (compactOpenIdeal T Λ) M).subtype) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  rintro ⟨m, hm⟩ h
  obtain ⟨U, hU⟩ := mem_smoothPart_compactOpenIdeal_iff.1 hm
  have := completePart.ext_iff.1 h U
  simp only [LinearMap.comp_apply, Submodule.subtype_apply, toCompletePart_apply_coe, hU] at this
  exact Subtype.ext this

/-- For a smooth module `M`, the map `M → M^c` is injective. -/
theorem injective_toCompletePart_of_smoothModules
    (hM : smoothModules (compactOpenIdeal T Λ) (ModuleCat.of (LocallyConstant T Λ) M)) :
    Function.Injective (toCompletePart T Λ M) := fun m n h =>
  congrArg Subtype.val <| show (⟨m, mem_smoothPart_of_smoothModules hM m⟩ :
      smoothPart (compactOpenIdeal T Λ) M) = ⟨n, mem_smoothPart_of_smoothModules hM n⟩ from
    injective_toCompletePart_comp_subtype h

/-- The smooth part of `M^c` is the image of the smooth part of `M`: `(M^c)^s = M^s`. -/
theorem smoothPart_completePart :
    smoothPart (compactOpenIdeal T Λ) (completePart T Λ M) =
      (smoothPart (compactOpenIdeal T Λ) M).map (toCompletePart T Λ M) := by
  refine le_antisymm (fun x hx => ?_) (map_smoothPart_le _)
  obtain ⟨U, hU⟩ := mem_smoothPart_compactOpenIdeal_iff.1 hx
  exact ⟨(x : CompactOpens T → M) U, apply_mem_smoothPart_of_mem_completePart x.property U,
    (eq_toCompletePart_of_charFn_smul_eq hU).symm⟩

/-- For a smooth module `M`, the map `M → M^c` identifies `M` with the smooth part of `M^c`. -/
noncomputable def smoothPartCompletePartEquiv
    (hM : smoothModules (compactOpenIdeal T Λ) (ModuleCat.of (LocallyConstant T Λ) M)) :
    M ≃ₗ[LocallyConstant T Λ] smoothPart (compactOpenIdeal T Λ) (completePart T Λ M) :=
  LinearEquiv.ofBijective
    (LinearMap.codRestrict _ (toCompletePart T Λ M) fun m => by
      rw [smoothPart_completePart]
      exact Submodule.mem_map_of_mem (mem_smoothPart_of_smoothModules hM m))
    ⟨fun _ _ h => injective_toCompletePart_of_smoothModules hM (congrArg Subtype.val h),
    fun x => by
      obtain ⟨m, -, hm⟩ := (smoothPart_completePart (T := T) (Λ := Λ) (M := M)).le x.property
      exact ⟨m, Subtype.ext hm⟩⟩

@[simp]
theorem smoothPartCompletePartEquiv_apply_coe
    (hM : smoothModules (compactOpenIdeal T Λ) (ModuleCat.of (LocallyConstant T Λ) M)) (m : M) :
    (smoothPartCompletePartEquiv hM m : completePart T Λ M) = toCompletePart T Λ M m :=
  (rfl)

variable (T Λ) in
/-- A linear map `f : M → N` induces `M^c → N^c`, applying `f` coordinatewise. -/
def completePartMap (f : M →ₗ[LocallyConstant T Λ] N) :
    completePart T Λ M →ₗ[LocallyConstant T Λ] completePart T Λ N :=
  LinearMap.restrict (LinearMap.compLeft f (CompactOpens T)) fun x hx U V => by
    simp only [LinearMap.compLeft_apply, Function.comp_apply, ← map_smul, hx U V]

@[simp]
theorem completePartMap_apply_coe (f : M →ₗ[LocallyConstant T Λ] N) (x : completePart T Λ M)
    (U : CompactOpens T) :
    (completePartMap T Λ f x : CompactOpens T → N) U = f ((x : CompactOpens T → M) U) :=
  (rfl)

@[simp]
theorem completePartMap_id : completePartMap T Λ (LinearMap.id : M →ₗ[LocallyConstant T Λ] M) =
    LinearMap.id :=
  (rfl)

theorem completePartMap_comp {P : Type*} [AddCommGroup P] [Module (LocallyConstant T Λ) P]
    (g : N →ₗ[LocallyConstant T Λ] P) (f : M →ₗ[LocallyConstant T Λ] N) :
    completePartMap T Λ (g ∘ₗ f) = completePartMap T Λ g ∘ₗ completePartMap T Λ f :=
  (rfl)

/-- The map `M → M^c` is natural in `M`. -/
theorem completePartMap_comp_toCompletePart (f : M →ₗ[LocallyConstant T Λ] N) :
    completePartMap T Λ f ∘ₗ toCompletePart T Λ M = toCompletePart T Λ N ∘ₗ f := by
  ext m U
  simp

/-- The inclusion of the smooth part induces a bijection `(M^s)^c → M^c`: every coordinate of a
point of `M^c` already lies in `M^s`. -/
theorem bijective_completePartMap_subtype_smoothPart :
    Function.Bijective
      (completePartMap T Λ (smoothPart (compactOpenIdeal T Λ) M).subtype) := by
  refine ⟨fun x y h => completePart.ext fun U => Subtype.ext (completePart.ext_iff.1 h U),
    fun x => ⟨⟨fun U => ⟨(x : CompactOpens T → M) U, ?_⟩, fun U V => Subtype.ext (x.property U V)⟩,
      completePart.ext fun U => by simp⟩⟩
  exact apply_mem_smoothPart_of_mem_completePart x.property U

variable (T Λ M) in
/-- The complete part of the smooth part is the complete part: `(M^s)^c ≅ M^c`. -/
noncomputable def completePartSmoothPartEquiv :
    completePart T Λ (smoothPart (compactOpenIdeal T Λ) M) ≃ₗ[LocallyConstant T Λ]
      completePart T Λ M :=
  LinearEquiv.ofBijective _ bijective_completePartMap_subtype_smoothPart

@[simp]
theorem completePartSmoothPartEquiv_apply_coe
    (x : completePart T Λ (smoothPart (compactOpenIdeal T Λ) M)) (U : CompactOpens T) :
    (completePartSmoothPartEquiv T Λ M x : CompactOpens T → M) U =
      ((x : CompactOpens T → smoothPart (compactOpenIdeal T Λ) M) U : M) :=
  (rfl)

end CompletePart

/-! ### Complete modules -/

section Complete

variable (T Λ)

/-- The *complete* `C(T, Λ)`-modules: those `M` for which the canonical map `M → M^c` to the limit
`M^c = lim_U 1_U·M` is bijective. -/
@[expose]
def completeModules : ObjectProperty (ModuleCat.{v} (LocallyConstant T Λ)) :=
  fun M => Function.Bijective (toCompletePart T Λ M)

variable {T Λ}

theorem completeModules_iff {M : ModuleCat.{v} (LocallyConstant T Λ)} :
    completeModules T Λ M ↔ Function.Bijective (toCompletePart T Λ M) :=
  Iff.rfl

variable {M : Type v} [AddCommGroup M] [Module (LocallyConstant T Λ) M]

/-- The map `M^c → (M^c)^c` is bijective. -/
theorem bijective_toCompletePart_completePart :
    Function.Bijective (toCompletePart T Λ (completePart T Λ M)) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun x h => completePart.ext fun U => ?_, fun y => ?_⟩
  · have := completePart.ext_iff.1 (completePart.ext_iff.1 h U) U
    simpa [charFn_smul_apply_self_of_mem_completePart x.property] using this
  -- The preimage `x` of `y` has as `U`-th coordinate the `U`-th coordinate of `y U`, and each
  -- `y U` is the image of that coordinate in `M^c`.
  let x : CompactOpens T → M := fun U =>
    (((y : CompactOpens T → completePart T Λ M) U : completePart T Λ M) : CompactOpens T → M) U
  have hx_def (U : CompactOpens T) : x U =
      (((y : CompactOpens T → completePart T Λ M) U : completePart T Λ M) : CompactOpens T → M) U :=
    rfl
  have hy (U : CompactOpens T) :
      (y : CompactOpens T → completePart T Λ M) U = toCompletePart T Λ M (x U) := by
    rw [hx_def]
    exact eq_toCompletePart_of_charFn_smul_eq
      (charFn_smul_apply_self_of_mem_completePart y.property U)
  have hxU (U : CompactOpens T) : U.charFn Λ • x U = x U := by
    rw [hx_def]
    exact charFn_smul_apply_self_of_mem_completePart
      ((y : CompactOpens T → completePart T Λ M) U).property U
  have hx : x ∈ completePart T Λ M := fun U V => by
    have h := completePart.ext_iff.1 (y.property U V) U
    simp only [Submodule.coe_smul, Pi.smul_apply] at h
    rw [hx_def U, h, hy (U ⊓ V), toCompletePart_apply_coe]
    calc U.charFn Λ • x (U ⊓ V) = U.charFn Λ • (U ⊓ V).charFn Λ • x (U ⊓ V) := by rw [hxU]
      _ = x (U ⊓ V) := by
        rw [← mul_smul, CompactOpens.charFn_mul_charFn_of_ge Λ inf_le_left, hxU]
  refine ⟨⟨x, hx⟩, completePart.ext fun U => ?_⟩
  rw [toCompletePart_apply_coe, charFn_smul_eq_toCompletePart, hy U]

/-- The complete part `M^c` is complete: `(M^c)^c ≅ M^c`. -/
theorem completeModules_completePart :
    completeModules T Λ (ModuleCat.of (LocallyConstant T Λ) (completePart T Λ M)) :=
  bijective_toCompletePart_completePart

/-- If `T` is compact, every `C(T, Λ)`-module is complete: `M^c ≅ M` through the coordinate at
`T` itself. -/
theorem completeModules_of_compactSpace [CompactSpace T]
    (M : ModuleCat.{v} (LocallyConstant T Λ)) : completeModules T Λ M := by
  refine ⟨fun m n h => ?_, fun x => ⟨(x : CompactOpens T → M) ⊤, ?_⟩⟩
  · simpa using completePart.ext_iff.1 h ⊤
  · rw [← charFn_smul_eq_toCompletePart, CompactOpens.charFn_top, one_smul]

end Complete

/-! ### The equivalence between smooth and complete modules -/

section Equivalence

variable (T Λ)

/-- The complete part `M ↦ M^c` as an endofunctor of `C(T, Λ)`-modules. -/
@[expose]
noncomputable def completePartFunctor :
    ModuleCat.{max u v} (LocallyConstant T Λ) ⥤ ModuleCat.{max u v} (LocallyConstant T Λ) where
  obj M := ModuleCat.of _ (completePart T Λ M)
  map f := ModuleCat.ofHom (completePartMap T Λ f.hom)

@[simp]
theorem completePartFunctor_obj (M : ModuleCat.{max u v} (LocallyConstant T Λ)) :
    (completePartFunctor T Λ).obj M = ModuleCat.of _ (completePart T Λ M) :=
  rfl

@[simp]
theorem completePartFunctor_map_hom {M N : ModuleCat.{max u v} (LocallyConstant T Λ)}
    (f : M ⟶ N) : ((completePartFunctor T Λ).map f).hom = completePartMap T Λ f.hom :=
  rfl

/-- The complete part as a functor from smooth to complete `C(T, Λ)`-modules. -/
@[expose]
noncomputable def smoothToComplete :
    (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory ⥤
    (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory :=
  (completeModules T Λ).lift ((smoothModules _).ι ⋙ completePartFunctor T Λ) fun _ =>
    completeModules_completePart

@[simp]
theorem smoothToComplete_obj_obj
    (M : (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory) :
    ((smoothToComplete T Λ).obj M).obj = ModuleCat.of _ (completePart T Λ M.obj) :=
  (rfl)

@[simp]
theorem smoothToComplete_map_hom_hom
    {M M' : (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory} (f : M ⟶ M') :
    ((smoothToComplete T Λ).map f).hom.hom = completePartMap T Λ f.hom.hom :=
  (rfl)

/-- The smooth part as a functor from complete to smooth `C(T, Λ)`-modules. -/
@[expose]
noncomputable def completeToSmooth :
    (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory ⥤
    (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory :=
  (completeModules T Λ).ι ⋙ smoothPartFunctor directed_compactOpenIdeal

@[simp]
theorem completeToSmooth_obj_obj
    (N : (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory) :
    ((completeToSmooth T Λ).obj N).obj =
      ModuleCat.of _ (smoothPart (compactOpenIdeal T Λ) N.obj) :=
  (rfl)

@[simp]
theorem completeToSmooth_map_hom_hom
    {N N' : (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory} (f : N ⟶ N') :
    ((completeToSmooth T Λ).map f).hom.hom = f.hom.hom.restrict fun _ hm =>
      map_smoothPart_le f.hom.hom (Submodule.mem_map_of_mem hm) :=
  (rfl)

/-- The complete part `M ↦ M^c` and the smooth part `N ↦ N^s` are mutually inverse equivalences
between the categories of smooth and of complete `C(T, Λ)`-modules. The unit is the map
`M → (M^c)^s` induced by `M → M^c`, and the counit is `(N^s)^c ≅ N^c ≅ N`. -/
@[expose]
noncomputable def smoothCompleteEquivalence :
    (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory ≌
    (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory :=
  CategoryTheory.Equivalence.mk' (smoothToComplete T Λ) (completeToSmooth T Λ)
    (NatIso.ofComponents (fun M => ObjectProperty.isoMk _
      (smoothPartCompletePartEquiv M.property).toModuleIso) fun {M M'} f => by
        ext m : 3
        -- The full subcategory morphisms and isomorphisms are linear maps on the nose, so the
        -- `U`-th coordinates of the two sides are `1_U • f m` and `f (1_U • m)` by definition
        -- (see `toCompletePart_apply_coe` and `completePartMap_apply_coe`).
        exact Subtype.ext (Subtype.ext (funext fun U => (map_smul f.hom.hom _ m).symm)))
    (NatIso.ofComponents (fun N => ObjectProperty.isoMk _
      ((completePartSmoothPartEquiv T Λ N.obj).trans
        (LinearEquiv.ofBijective _ N.property).symm).toModuleIso) fun {N N'} f => by
        ext x : 3
        apply (LinearEquiv.ofBijective _ N'.property).injective
        have h := LinearEquiv.apply_symm_apply (LinearEquiv.ofBijective _ N.property)
          (completePartSmoothPartEquiv T Λ N.obj x)
        -- As for the unit, the `U`-th coordinates of the two sides are by definition `f (x U)`
        -- and `1_U • f y`, where `h` says that `1_U • y = x U`.
        refine (LinearEquiv.apply_symm_apply _ _).trans (Subtype.ext (funext fun U => ?_))
        exact (congrArg f.hom.hom (congr_fun (congrArg Subtype.val h) U)).symm.trans
          (map_smul f.hom.hom _ _))
    fun M => by
      ext x : 3
      -- The unit sends `x ∈ M^c` to the point with coordinates `toCompletePart (x U) = 1_U • x`,
      -- which is the image of `x` under `M^c → (M^c)^c`; the counit inverts that map.
      exact (LinearEquiv.ofBijective _ bijective_toCompletePart_completePart).symm_apply_eq.2
        (completePart.ext fun U => (charFn_smul_eq_toCompletePart x U).symm)

@[simp]
theorem smoothCompleteEquivalence_functor :
    (smoothCompleteEquivalence.{u, v} T Λ).functor = smoothToComplete T Λ :=
  (rfl)

@[simp]
theorem smoothCompleteEquivalence_inverse :
    (smoothCompleteEquivalence.{u, v} T Λ).inverse = completeToSmooth T Λ :=
  (rfl)

/-- The unit `M → (M^c)^s` of the equivalence is induced by `M → M^c`. -/
@[simp]
theorem smoothCompleteEquivalence_unitIso_hom_app_hom_hom
    (M : (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory) :
    ((smoothCompleteEquivalence.{u, v} T Λ).unitIso.hom.app M).hom.hom =
      (smoothPartCompletePartEquiv M.property).toLinearMap :=
  (rfl)

@[simp]
theorem smoothCompleteEquivalence_unitIso_inv_app_hom_hom
    (M : (smoothModules (compactOpenIdeal T Λ) :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory) :
    ((smoothCompleteEquivalence.{u, v} T Λ).unitIso.inv.app M).hom.hom =
      (smoothPartCompletePartEquiv M.property).symm.toLinearMap :=
  (rfl)

/-- The counit `(N^s)^c → N` sends `x` to the vector whose image in `N^c` has the same coordinates
as `x`. -/
theorem toCompletePart_smoothCompleteEquivalence_counitIso_hom_app
    (N : (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory)
    (x : completePart T Λ (smoothPart (compactOpenIdeal T Λ) N.obj)) :
    toCompletePart T Λ N.obj
        (((smoothCompleteEquivalence.{u, v} T Λ).counitIso.hom.app N).hom.hom x) =
      completePartSmoothPartEquiv T Λ N.obj x :=
  (LinearEquiv.ofBijective _ N.property).apply_symm_apply _

/-- The inverse of the counit sends `y : N` to the point of `(N^s)^c` with coordinates `1_U • y`. -/
theorem completePartSmoothPartEquiv_smoothCompleteEquivalence_counitIso_inv_app
    (N : (completeModules T Λ :
      ObjectProperty (ModuleCat.{max u v} (LocallyConstant T Λ))).FullSubcategory) (y : N.obj) :
    completePartSmoothPartEquiv T Λ N.obj
        (((smoothCompleteEquivalence.{u, v} T Λ).counitIso.inv.app N).hom.hom y) =
      toCompletePart T Λ N.obj y :=
  (completePartSmoothPartEquiv T Λ N.obj).apply_symm_apply _

end Equivalence

end TauCeti
