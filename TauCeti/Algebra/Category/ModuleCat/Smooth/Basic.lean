/-!
# Smooth modules and discrete modules

Let `A` be a ring and `J : ι → Submodule A A` a family of left ideals of `A`. An `A`-module `M` is
*smooth* for `J` when every vector is killed by one of the `J i`, that is
`∀ m : M, ∃ i, ∀ a ∈ J i, a • m = 0`. For the enveloping algebra of an affine Lie algebra `𝔤̂` and
the left ideals `J N` generated by `𝔤 ⊗ tᴺ ℂ[[t]]`, these are the smooth `𝔤̂`-modules of the
representation theory of affine Lie algebras. When `A` carries a topology,
`M` is a *discrete module* when every orbit map `a ↦ a • m` is continuous for the discrete topology
on `M`, as for the discrete modules of a profinite group in Galois cohomology.

Both notions are properties of objects of `ModuleCat A`, and their full subcategories are the
categories of smooth and of discrete `A`-modules. This file proves:

* both properties are closed under subobjects and quotients, hence under isomorphisms, kernels,
  cokernels and images, and contain the zero module (for smoothness, when `ι` is nonempty);
* when the family `J` is directed downwards, smoothness is closed under all colimits (in particular
  arbitrary direct sums) and under finite limits (in particular finite products), so the smooth
  modules form an abelian category;
* for an arbitrary topology on `A`, the discrete modules are closed under all colimits and under
  finite limits, so they form an abelian category;
* when addition by a constant is continuous on `A`, the discrete modules are the smooth modules for
  the family of all open left ideals;
* when the `J i` form a basis of neighborhoods of `0`, smoothness for `J` and discreteness coincide;
* restriction of scalars along a ring homomorphism preserves smoothness when the pulled-back
  ideals dominate the given family, and preserves discreteness along a continuous one.

## Main definitions

* `TauCeti.smoothModules J`: the modules every vector of which is killed by some `J i`.
* `TauCeti.discreteModules A`: the modules all of whose orbit maps are continuous for the discrete
  topology on the module.

## Main results

* `TauCeti.isClosedUnderColimitsOfShape_smoothModules`,
  `TauCeti.isClosedUnderFiniteLimits_smoothModules`: closure of smoothness for a directed family
  under colimits and finite limits.
* `TauCeti.smoothModules_directSum`: a direct sum of smooth modules is smooth.
* `TauCeti.discreteModules_iff_isOpen`: a module is discrete if and only if every set
  `{a | a • m = x}` is open.
* `TauCeti.discreteModules_of_iSup_range_eq_top`: a module spanned by the images of linear maps out
  of discrete modules is discrete; hence discreteness is closed under colimits.
* `TauCeti.discreteModules_eq_smoothModules`: discrete modules are the smooth modules for the
  family of open left ideals.
* `TauCeti.smoothModules_eq_discreteModules`: if the `J i` form a basis of neighborhoods of `0`,
  smoothness for `J` is discreteness.
* `TauCeti.smoothModules_restrictScalars`, `TauCeti.discreteModules_restrictScalars`: restriction
  of scalars preserves both properties.

## References

* Edward Frenkel, *Langlands Correspondence for Loop Groups*, Cambridge Studies in Advanced
  Mathematics 103, Cambridge University Press, 2007, Section 2.1, for smooth modules over the
  completed enveloping algebra of an affine Lie algebra.
* Jean-Pierre Serre, *Galois Cohomology*, Springer, 1997, Chapter I, Section 2.1, for discrete
  modules over a profinite group.
-/

public section

namespace TauCeti

open CategoryTheory Limits Topology Filter

universe v v' u u' w

variable {A : Type u} [Ring A] {ι : Type*}

/-! ### Smooth modules -/

section Smooth

variable (J : ι → Submodule A A)

/-- The modules that are *smooth* for a family `J` of left ideals of `A`: every vector is killed by
one of the `J i`. -/
def smoothModules : ObjectProperty (ModuleCat.{v} A) :=
  fun M => ∀ m : M, ∃ i, ∀ a ∈ J i, a • m = 0

variable {J}

/-- A module is smooth for `J` when every vector is killed by one of the `J i`. -/
theorem smoothModules_iff {M : ModuleCat.{v} A} :
    smoothModules J M ↔ ∀ m : M, ∃ i, ∀ a ∈ J i, a • m = 0 :=
  Iff.rfl

/-- Smoothness for `J` implies smoothness for `J'` when every `J i` contains some `J' i'`. -/
theorem smoothModules_le_of_forall_exists_le {ι' : Type*} {J' : ι' → Submodule A A}
    (h : ∀ i, ∃ i', J' i' ≤ J i) : smoothModules.{v} J ≤ smoothModules J' := fun _ hM m => by
  obtain ⟨i, hi⟩ := hM m
  obtain ⟨i', hi'⟩ := h i
  exact ⟨i', fun a ha => hi a (hi' ha)⟩

/-- Smoothness passes to the source of an injective linear map. -/
instance : (smoothModules.{v} J).IsClosedUnderSubobjects where
  prop_of_mono {_ N} f hf hN m := by
    obtain ⟨i, hi⟩ := hN (f m)
    refine ⟨i, fun a ha => (ModuleCat.mono_iff_injective f).1 hf ?_⟩
    rw [map_smul, hi a ha, map_zero]

/-- Smoothness passes to the target of a surjective linear map. -/
instance : (smoothModules.{v} J).IsClosedUnderQuotients where
  prop_of_epi {_ _} f hf hM n := by
    obtain ⟨m, rfl⟩ := (ModuleCat.epi_iff_surjective f).1 hf n
    obtain ⟨i, hi⟩ := hM m
    exact ⟨i, fun a ha => by rw [← map_smul, hi a ha, map_zero]⟩

/-- The zero module is smooth as soon as the family `J` is nonempty. -/
instance [Nonempty ι] : (smoothModules.{v} J).ContainsZero where
  exists_zero := ⟨ModuleCat.of A PUnit, ModuleCat.isZero_of_subsingleton _,
    fun _ => ⟨Classical.arbitrary ι, fun _ _ => Subsingleton.elim _ _⟩⟩

/-- A submodule of a smooth module is smooth. -/
theorem smoothModules_submodule {M : ModuleCat.{v} A} (hM : smoothModules J M)
    (p : Submodule A M) : smoothModules J (ModuleCat.of A p) :=
  have : Mono (ModuleCat.ofHom p.subtype) :=
    (ModuleCat.mono_iff_injective _).2 p.injective_subtype
  (smoothModules J).prop_of_mono (ModuleCat.ofHom p.subtype) hM

/-- A quotient of a smooth module is smooth. -/
theorem smoothModules_quotient {M : ModuleCat.{v} A} (hM : smoothModules J M)
    (p : Submodule A M) : smoothModules J (ModuleCat.of A (M ⧸ p)) :=
  have : Epi (ModuleCat.ofHom p.mkQ) := (ModuleCat.epi_iff_surjective _).2 p.mkQ_surjective
  (smoothModules J).prop_of_epi (ModuleCat.ofHom p.mkQ) hM

/-- The image of a linear map out of a smooth module is smooth. -/
theorem smoothModules_range {M N : ModuleCat.{v} A} (f : M ⟶ N) (hM : smoothModules J M) :
    smoothModules J (ModuleCat.of A (LinearMap.range f.hom)) :=
  have : Epi (ModuleCat.ofHom f.hom.rangeRestrict) :=
    (ModuleCat.epi_iff_surjective _).2 f.hom.surjective_rangeRestrict
  (smoothModules J).prop_of_epi (ModuleCat.ofHom f.hom.rangeRestrict) hM

/-- For a directed family `J`, a module spanned by the images of linear maps out of smooth modules
is smooth. -/
theorem smoothModules_of_iSup_range_eq_top [Nonempty ι] (hJ : Directed (· ≥ ·) J) {κ : Type*}
    {M : κ → ModuleCat.{v'} A} {N : ModuleCat.{v} A} (f : ∀ k, M k →ₗ[A] N)
    (hf : ⨆ k, LinearMap.range (f k) = ⊤) (hM : ∀ k, smoothModules J (M k)) :
    smoothModules J N := fun n => by
  refine Submodule.iSup_induction _ (motive := fun n => ∃ i, ∀ a ∈ J i, a • n = 0)
    (hf ▸ Submodule.mem_top) ?_ ⟨Classical.arbitrary ι, fun a _ => smul_zero a⟩ ?_
  · rintro k _ ⟨m, rfl⟩
    obtain ⟨i, hi⟩ := hM k m
    exact ⟨i, fun a ha => by rw [← map_smul, hi a ha, map_zero]⟩
  · rintro x y ⟨i, hi⟩ ⟨j, hj⟩
    obtain ⟨k, hik, hjk⟩ := hJ i j
    exact ⟨k, fun a ha => by rw [smul_add, hi a (hik ha), hj a (hjk ha), add_zero]⟩

/-- For a directed family `J`, smoothness is closed under colimits of any shape. -/
theorem isClosedUnderColimitsOfShape_smoothModules [Nonempty ι] (hJ : Directed (· ≥ ·) J)
    (K : Type*) [Category* K] : (smoothModules.{v} J).IsClosedUnderColimitsOfShape K where
  colimitsOfShape_le := by
    rintro _ ⟨p⟩
    exact smoothModules_of_iSup_range_eq_top hJ (fun k => (p.ι.app k).hom)
      (ModuleCat.iSup_range_eq_top_of_isColimit p.isColimit) p.prop_diag_obj

/-- For a directed family `J`, smoothness is closed under finite limits. -/
theorem isClosedUnderFiniteLimits_smoothModules [Nonempty ι] (hJ : Directed (· ≥ ·) J) :
    (smoothModules.{v} J).IsClosedUnderFiniteLimits where
  isClosedUnderLimitsOfShape K _ _ := ⟨by
    classical
    rintro _ ⟨p⟩ m
    choose i hi using fun k => p.prop_diag_obj k (p.π.app k m)
    obtain ⟨i₀, hi₀⟩ := hJ.finset_le (Finset.univ.image i)
    refine ⟨i₀, fun a ha => Concrete.isLimit_ext _ p.isLimit _ _ fun k => ?_⟩
    have := hi k a (hi₀ (i k) (Finset.mem_image_of_mem i (Finset.mem_univ k)) ha)
    simpa using this⟩

/-- For a directed family `J`, a direct sum of smooth modules is smooth. -/
theorem smoothModules_directSum [Nonempty ι] (hJ : Directed (· ≥ ·) J) {κ : Type w}
    (M : κ → ModuleCat.{v'} A) (hM : ∀ k, smoothModules J (M k)) :
    smoothModules J (ModuleCat.of A (DirectSum κ fun k => M k)) := by
  classical
  exact smoothModules_of_iSup_range_eq_top hJ (DirectSum.lof A κ (fun k => M k))
    (eq_top_iff.2 fun x _ => DirectSum.induction_on x (zero_mem _)
      (fun k y => Submodule.mem_iSup_of_mem k ⟨y, DirectSum.lof_eq_of A κ (fun k => M k) k y⟩)
      fun _ _ => add_mem) hM

/-- For a directed family `J`, the smooth modules form an abelian category. -/
example [Nonempty ι] (hJ : Directed (· ≥ ·) J) : Abelian (smoothModules.{v} J).FullSubcategory :=
  have : (smoothModules.{v} J).IsClosedUnderFiniteLimits :=
    isClosedUnderFiniteLimits_smoothModules hJ
  inferInstance

/-- Restriction of scalars along `f : B →+* A` sends modules smooth for `J` to modules smooth for
`J'` when every pulled-back ideal `f⁻¹(J i)` contains some `J' i'`. -/
theorem smoothModules_restrictScalars {B : Type u'} [Ring B] (f : B →+* A) {ι' : Type*}
    {J' : ι' → Submodule B B} (h : ∀ i, ∃ i', J' i' ≤ Ideal.comap f (J i)) {M : ModuleCat.{v} A}
    (hM : smoothModules J M) : smoothModules J' ((ModuleCat.restrictScalars f).obj M) := fun m => by
  obtain ⟨i, hi⟩ := hM m
  obtain ⟨i', hi'⟩ := h i
  exact ⟨i', fun b hb => (ModuleCat.restrictScalars.smul_def f b m).trans
    (hi (f b) (Ideal.mem_comap.1 (hi' hb)))⟩

end Smooth

/-! ### Discrete modules -/

section Discrete

variable (A) [TopologicalSpace A]

/-- The *discrete* `A`-modules: every orbit map `a ↦ a • m` is continuous for the discrete topology
on the module. -/
def discreteModules : ObjectProperty (ModuleCat.{v} A) :=
  fun M => ∀ m : M, letI : TopologicalSpace M := ⊥; Continuous fun a : A => a • m

variable {A}

/-- A module is discrete when every orbit map is continuous for the discrete topology on the
module. -/
theorem discreteModules_iff {M : ModuleCat.{v} A} :
    discreteModules A M ↔
      ∀ m : M, letI : TopologicalSpace M := ⊥; Continuous fun a : A => a • m :=
  Iff.rfl

/-- A module is discrete if and only if every set `{a | a • m = x}` is open. -/
theorem discreteModules_iff_isOpen {M : ModuleCat.{v} A} :
    discreteModules A M ↔ ∀ m x : M, IsOpen {a : A | a • m = x} := by
  refine forall_congr' fun m => ?_
  let : TopologicalSpace M := ⊥
  have : DiscreteTopology M := ⟨rfl⟩
  exact continuous_discrete_rng

/-- Discreteness passes to the source of an injective linear map. -/
instance : (discreteModules.{v} A).IsClosedUnderSubobjects where
  prop_of_mono {M N} f hf hN := by
    rw [discreteModules_iff_isOpen] at hN ⊢
    intro m x
    have : {a : A | a • m = x} = {a | a • f m = f x} := by
      ext a
      rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, ← map_smul,
        ((ModuleCat.mono_iff_injective f).1 hf).eq_iff]
    exact this ▸ hN (f m) (f x)

/-- The zero module is discrete. -/
instance : (discreteModules.{v} A).ContainsZero where
  exists_zero := ⟨ModuleCat.of A PUnit, ModuleCat.isZero_of_subsingleton _,
    discreteModules_iff_isOpen.2 fun m x => by
      have : {a : A | a • m = x} = Set.univ := Set.eq_univ_of_forall fun _ => Subsingleton.elim _ _
      exact this ▸ isOpen_univ⟩

/-- A module spanned by the images of linear maps out of discrete modules is discrete. -/
theorem discreteModules_of_iSup_range_eq_top {κ : Type*} {M : κ → ModuleCat.{v'} A}
    {N : ModuleCat.{v} A} (f : ∀ k, M k →ₗ[A] N) (hf : ⨆ k, LinearMap.range (f k) = ⊤)
    (hM : ∀ k, discreteModules A (M k)) : discreteModules A N := by
  simp only [discreteModules_iff_isOpen] at hM ⊢
  intro n
  refine Submodule.iSup_induction _ (motive := fun n => ∀ x : N, IsOpen {a : A | a • n = x})
    (hf ▸ Submodule.mem_top) ?_ (fun x => by simp) ?_
  · rintro k _ ⟨m, rfl⟩ y
    -- `{a | a • f m = y}` is the union of the open sets `{a | a • m = x}` over `x ∈ f⁻¹(y)`.
    have : {a : A | a • f k m = y} = ⋃ x ∈ f k ⁻¹' {y}, {a | a • m = x} := by
      ext a
      simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_preimage, Set.mem_singleton_iff,
        exists_prop, ← map_smul]
      exact ⟨fun h => ⟨_, h, rfl⟩, by rintro ⟨x, hx, rfl⟩; exact hx⟩
    exact this ▸ isOpen_biUnion fun x _ => hM k m x
  · intro m n hm hn x
    -- `{a | a • (m + n) = x}` is the union over `y` of `{a | a • m = y} ∩ {a | a • n = x - y}`.
    have : {a : A | a • (m + n) = x} = ⋃ y, {a | a • m = y} ∩ {a | a • n = x - y} := by
      ext a
      simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, smul_add]
      exact ⟨fun h => ⟨_, rfl, eq_sub_of_add_eq' h⟩, by
        rintro ⟨y, rfl, h⟩
        rw [h, add_sub_cancel]⟩
    exact this ▸ isOpen_iUnion fun y => (hm y).inter (hn (x - y))

/-- Discreteness passes to the target of a surjective linear map. -/
instance : (discreteModules.{v} A).IsClosedUnderQuotients where
  prop_of_epi {M _} f hf hM :=
    discreteModules_of_iSup_range_eq_top (M := fun _ : Unit => M) (fun _ => f.hom)
      (by simpa using LinearMap.range_eq_top.2 ((ModuleCat.epi_iff_surjective f).1 hf))
      fun _ => hM

/-- Discreteness is closed under colimits of any shape. -/
instance (K : Type*) [Category* K] : (discreteModules.{v} A).IsClosedUnderColimitsOfShape K where
  colimitsOfShape_le := by
    rintro _ ⟨p⟩
    exact discreteModules_of_iSup_range_eq_top (fun k => (p.ι.app k).hom)
      (ModuleCat.iSup_range_eq_top_of_isColimit p.isColimit) p.prop_diag_obj

/-- Discreteness is closed under finite limits. -/
instance : (discreteModules.{v} A).IsClosedUnderFiniteLimits where
  isClosedUnderLimitsOfShape K _ _ := ⟨by
    rintro _ ⟨p⟩
    rw [discreteModules_iff_isOpen]
    intro m x
    -- `{a | a • m = x}` is the intersection of the sets `{a | a • π k m = π k x}`.
    have : {a : A | a • m = x} = ⋂ k, {a | a • p.π.app k m = p.π.app k x} := by
      ext a
      simp only [Set.mem_ofPred_eq, Set.mem_iInter, ← map_smul]
      exact ⟨fun h k => h ▸ rfl, fun h => Concrete.isLimit_ext _ p.isLimit (a • m) x h⟩
    exact this ▸ isOpen_iInter_of_finite fun k =>
      discreteModules_iff_isOpen.1 (p.prop_diag_obj k) _ _⟩

/-- The discrete modules form an abelian category. -/
example : Abelian (discreteModules.{v} A).FullSubcategory :=
  inferInstance

/-- When addition by a constant is continuous on `A`, the discrete modules are the smooth modules
for the family of open left ideals of `A`. -/
theorem discreteModules_eq_smoothModules [SeparatelyContinuousAdd A] :
    discreteModules.{v} A =
      smoothModules (Subtype.val : {I : Submodule A A // IsOpen (I : Set A)} → Submodule A A) := by
  ext M
  rw [discreteModules_iff_isOpen, smoothModules_iff]
  refine forall_congr' fun m => ⟨fun h => ?_, ?_⟩
  · refine ⟨⟨LinearMap.ker (LinearMap.toSpanSingleton A M m), ?_⟩, fun a ha => ?_⟩
    · have : (LinearMap.ker (LinearMap.toSpanSingleton A M m) : Set A) = {a | a • m = 0} := by
        ext a
        simp
      exact this ▸ h 0
    · simpa using ha
  · rintro ⟨⟨I, hI⟩, hIm⟩ x
    refine isOpen_iff_mem_nhds.2 fun a₀ (ha₀ : a₀ • m = x) => ?_
    -- The translate `a₀ + I` is an open neighborhood of `a₀` inside `{a | a • m = x}`.
    refine mem_of_superset (((hI.preimage (continuous_add_const (-a₀))).mem_nhds
      (by simp))) fun a ha => ?_
    have := hIm _ ha
    simp only [add_smul, neg_smul, add_neg_eq_zero] at this
    exact this.trans ha₀

variable {J : ι → Submodule A A}

/-- If every `J i` is a neighborhood of `0` and addition by a constant is continuous, modules
smooth for `J` are discrete. -/
theorem smoothModules_le_discreteModules [SeparatelyContinuousAdd A]
    (hJ : ∀ i, (J i : Set A) ∈ 𝓝 0) : smoothModules.{v} J ≤ discreteModules A := by
  rw [discreteModules_eq_smoothModules]
  exact smoothModules_le_of_forall_exists_le fun i =>
    ⟨⟨J i, (J i).toAddSubgroup.isOpen_of_mem_nhds (hJ i)⟩, le_rfl⟩

/-- If every neighborhood of `0` contains some `J i`, discrete modules are smooth for `J`. -/
theorem discreteModules_le_smoothModules (hJ : ∀ s ∈ 𝓝 (0 : A), ∃ i, (J i : Set A) ⊆ s) :
    discreteModules.{v} A ≤ smoothModules J := fun _ hM m => by
  obtain ⟨i, hi⟩ := hJ _ ((discreteModules_iff_isOpen.1 hM m 0).mem_nhds (zero_smul A m))
  exact ⟨i, fun a ha => hi ha⟩

/-- If the `J i` form a basis of neighborhoods of `0` and addition by a constant is continuous,
smoothness for `J` is discreteness. -/
theorem smoothModules_eq_discreteModules [SeparatelyContinuousAdd A]
    (hJ : (𝓝 (0 : A)).HasBasis (fun _ => True) fun i => (J i : Set A)) :
    smoothModules.{v} J = discreteModules A :=
  le_antisymm (smoothModules_le_discreteModules fun _ => hJ.mem_of_mem trivial)
    (discreteModules_le_smoothModules fun _ hs => (hJ.mem_iff.1 hs).imp fun _ => And.right)

/-- Restriction of scalars along a continuous ring homomorphism preserves discreteness. -/
theorem discreteModules_restrictScalars {B : Type u'} [Ring B] [TopologicalSpace B]
    {f : B →+* A} (hf : Continuous f) {M : ModuleCat.{v} A} (hM : discreteModules A M) :
    discreteModules B ((ModuleCat.restrictScalars f).obj M) := by
  rw [discreteModules_iff_isOpen] at hM ⊢
  intro m x
  -- The action of `b` on the restriction is the action of `f b`, by definition
  -- (`ModuleCat.restrictScalars.smul_def`), so the set in question is a preimage under `f`.
  exact (hM m x).preimage hf

end Discrete

end TauCeti
