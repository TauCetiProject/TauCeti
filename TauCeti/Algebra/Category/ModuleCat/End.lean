module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Group.Units.Opposite
public import Mathlib.Algebra.Module.Equiv.Basic
public import Mathlib.CategoryTheory.ConcreteCategory.EpiMono
public import Mathlib.Data.ZMod.QuotientRing

/-!
# Endomorphisms of the rank-one free module

An automorphism of a ring as a module over itself sends one to a unit. Consequently,
the scalar comparing the images of one under two isomorphisms is a unit as well.

A natural number `e` kills a module `M` exactly when the endomorphism `e • 𝟙 M` vanishes
(`ModuleCat.nsmul_id_eq_zero_iff`).

Over a commutative ring `R`, an endomorphism of `R` is multiplication by its value at one
(`ModuleCat.eq_apply_one_smul_id`), and multiplication by `c` has image the ideal generated by `c`
(`ModuleCat.range_hom_smul_id_eq_span`). Multiplication by a scalar that is regular on `M` is a
monomorphism of `M` (`ModuleCat.mono_smul_id`); in particular, multiplication by a nonzero scalar
on a torsion-free module over a ring without zero divisors is a monomorphism
(`ModuleCat.mono_smul_id_of_neZero`). An endomorphism of `ℤ` whose cokernel is in
bijection with `ℤ/n` is multiplication by `n` or by `-n`
(`ModuleCat.eq_natCast_smul_id_or_eq_neg_natCast_smul_id`).
-/

public noncomputable section

open CategoryTheory

namespace ModuleCat

universe u

section Ring

variable {R : Type u} [Ring R]

/-- An automorphism of the rank-one free module sends one to a unit. -/
theorem isUnit_apply_one_of_isIso (f : ModuleCat.of R R ⟶ ModuleCat.of R R) [IsIso f] :
    IsUnit (f 1) :=
  (((Module.End.isUnit_iff _).2 (ConcreteCategory.bijective_of_isIso f)).map
    (RingEquiv.moduleEndSelf R).symm).unop

/-- The scalar comparing the images of one under two module isomorphisms is a unit. -/
theorem isUnit_of_apply_one_eq_smul {M : ModuleCat R}
    (f g : ModuleCat.of R R ⟶ M) [IsIso f] [IsIso g] {a : R}
    (h : g 1 = a • f 1) : IsUnit a := by
  have hu := isUnit_apply_one_of_isIso (g ≫ inv f)
  simpa only [CategoryTheory.comp_apply, h, map_smul, IsIso.hom_inv_id_apply,
    smul_eq_mul, mul_one] using hu

/-- A natural number `e` kills a module `M`, in the sense that `e • 𝟙 M = 0`, exactly when
`e • x = 0` for every element `x` of `M`. -/
theorem nsmul_id_eq_zero_iff {M : ModuleCat R} {e : ℕ} : e • 𝟙 M = 0 ↔ ∀ x : M, e • x = 0 :=
  ⟨fun h x ↦ by simpa using congr($h x), fun h ↦ by ext x; simpa using h x⟩

end Ring

section CommRing

variable {R : Type u} [CommRing R]

/-- An endomorphism of a commutative ring as a module over itself is multiplication by its value
at one. -/
theorem eq_apply_one_smul_id (g : ModuleCat.of R R ⟶ ModuleCat.of R R) : g = g 1 • 𝟙 _ := by
  ext
  simp

/-- Multiplication by `c` on a commutative ring has image the ideal generated by `c`. -/
theorem range_hom_smul_id_eq_span (c : R) :
    LinearMap.range (c • 𝟙 (ModuleCat.of R R)).hom = Ideal.span {c} := by
  ext y
  simp [Ideal.mem_span_singleton', mul_comm]

/-- Multiplication by a scalar `c` that is regular on `M` is a monomorphism of `M`. -/
theorem mono_smul_id {M : ModuleCat R} {c : R} (hc : IsSMulRegular M c) : Mono (c • 𝟙 M) :=
  ConcreteCategory.mono_of_injective _ fun x y hxy ↦ hc (by simpa using hxy)

/-- Multiplication by a nonzero scalar on a torsion-free module over a ring without zero divisors
is a monomorphism. -/
instance mono_smul_id_of_neZero [IsCancelMulZero R] {M : ModuleCat R} [Module.IsTorsionFree R M]
    (c : R) [NeZero c] : Mono (c • 𝟙 M) :=
  mono_smul_id (IsSMulRegular.of_ne_zero (NeZero.ne c))

end CommRing

/-- An endomorphism of `ℤ` whose cokernel is in bijection with `ℤ/n` is multiplication by `n` or
by `-n`: it is multiplication by `m = g 1`, and `ℤ/m` has as many elements as `ℤ/n` only if
`|m| = n`. -/
theorem eq_natCast_smul_id_or_eq_neg_natCast_smul_id (g : ModuleCat.of ℤ ℤ ⟶ ModuleCat.of ℤ ℤ)
    {n : ℕ} (q : (ℤ ⧸ LinearMap.range g.hom) ≃ ZMod n) :
    g = (n : ℤ) • 𝟙 _ ∨ g = -(n : ℤ) • 𝟙 _ := by
  have h := Nat.card_congr q
  rw [eq_apply_one_smul_id g, range_hom_smul_id_eq_span,
    Nat.card_congr (Int.quotientSpanEquivZMod _).toEquiv, Nat.card_zmod, Nat.card_zmod] at h
  rw [eq_apply_one_smul_id g]
  rcases Int.natAbs_eq (g 1) with h' | h' <;> rw [h] at h'
  · exact Or.inl (by rw [h'])
  · exact Or.inr (by rw [h'])

end ModuleCat
