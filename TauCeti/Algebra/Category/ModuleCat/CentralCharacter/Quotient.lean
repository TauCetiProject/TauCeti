module

public import TauCeti.Algebra.Category.ModuleCat.CentralCharacter.Action
public import TauCeti.Algebra.Category.ModuleCat.Smooth.Quotient

/-!
# Closed central quotients and strict character fibers

A central ideal generates a two-sided ideal of an algebra. Its closure imposes
the same relations on discrete continuous modules, because their action
annihilators are closed. Thus modules killed by a central ideal have a quotient
presentation even when the algebraic generated ideal is not closed.

For the kernel of a central character, the annihilation condition is exactly
the strict scalar-action equation. The resulting comparison uses the quotient
topology and the actual closed two-sided ideal, without assuming that algebraic
extensions retain the character.

Continuous algebra automorphisms with continuous inverses that preserve the character preserve
this closed ideal (`MonoidHom.map_closedCentralIdeal_ker`). The quotient presentation is then
equivariant: its functor and inverse are left-linear for the twisting action on discrete modules
over the closed central quotient and the coherent twisting action
`MonoidHom.discreteCentralCharacterMonoidalLeftAction` on the strict character fiber, and the
lineators of the functor are identity maps of the underlying modules.

## References

* Edward Frenkel, *Langlands Correspondence for Loop Groups* (2007), §3.2 and §4.3,
  for central quotients of completed enveloping algebras and their module categories.
-/

public section

universe v u

open CategoryTheory

namespace Ideal

open TauCeti

variable {R : Type*} [CommRing R] {A : Type u} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A]

/-- A discrete module kills the closed generated ideal exactly when it kills the
original central relations. Closed action kernels supply the closure step. -/
theorem discreteAnnihilatedModules_closedCentralIdeal_iff
    (L : Ideal (Subalgebra.center R A)) (M : ModuleCat.{v} A) :
    discreteAnnihilatedModules (closedCentralIdeal L).asIdeal M ↔
      discreteModules A M ∧ ∀ z ∈ L, ∀ m : M, (z : A) • m = 0 := by
  rw [discreteAnnihilatedModules_iff]
  constructor
  · rintro ⟨hM, hL⟩
    exact ⟨hM, fun z hz m => hL (a := ⟨z, mem_closedCentralIdeal L hz⟩)⟩
  · rintro ⟨hM, hL⟩
    refine ⟨hM, (Module.isTorsionBySet_iff_subset_annihilator A M).mpr ?_⟩
    have hclosed := M.isClosed_annihilator_of_discreteModules hM
    have hle : closedCentralIdeal L ≤ (Module.annihilator A M).toTwoSided := by
      apply (closedCentralIdeal_le_iff L _ (by simpa using hclosed)).mpr
      intro z hz
      simpa using Module.mem_annihilator.mpr (hL z hz)
    intro a ha
    simpa using hle ha

end Ideal

namespace AlgHom

open TauCeti Ideal

variable {R : Type*} [CommRing R] {A : Type u} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A]

/-- The strict discrete character fiber is precisely the category of discrete
modules annihilated by the closed ideal generated by the character kernel. -/
theorem discreteAnnihilatedModules_closedCentralIdeal_ker
    (χ : Subalgebra.center R A →ₐ[R] R) :
    discreteAnnihilatedModules.{v} (closedCentralIdeal (RingHom.ker χ)).asIdeal =
      discreteCentralCharacterModules χ := by
  ext M
  rw [discreteAnnihilatedModules_closedCentralIdeal_iff,
    discreteCentralCharacterModules_iff, centralCharacterModules_iff_ker_smul_eq_zero]

/-- The quotient presentation of a strict discrete central-character fiber. -/
-- Exposed so that the underlying modules are available in the lineator formulas below.
@[expose]
noncomputable def discreteCentralCharacterQuotientEquivalence
    (χ : Subalgebra.center R A →ₐ[R] R) :
    (discreteModules.{v} (A ⧸ (closedCentralIdeal (RingHom.ker χ)).asIdeal)).FullSubcategory ≌
      (discreteCentralCharacterModules.{v} χ).FullSubcategory :=
  (discreteQuotientEquivalence _).trans
    (ObjectProperty.fullSubcategoryCongr (discreteAnnihilatedModules_closedCentralIdeal_ker χ))

/-- The quotient presentation forgets to native restriction along the quotient map,
including its action on morphisms. -/
@[simp]
theorem discreteCentralCharacterQuotientEquivalence_functor_comp_ι
    (χ : Subalgebra.center R A →ₐ[R] R) :
    χ.discreteCentralCharacterQuotientEquivalence.functor ⋙
        (discreteCentralCharacterModules.{v} χ).ι =
      (discreteModules (A ⧸ (closedCentralIdeal (RingHom.ker χ)).asIdeal)).ι ⋙
        ModuleCat.restrictScalars (Ideal.Quotient.mk _) := by
  simp only [discreteCentralCharacterQuotientEquivalence, Equivalence.trans_functor,
    ObjectProperty.fullSubcategoryCongr_functor, discreteQuotientEquivalence_functor]
  rw [Functor.assoc]
  exact discreteQuotientRestriction_comp_ι _

/-- The inverse quotient presentation keeps the underlying abelian groups and maps. -/
@[simp]
theorem discreteCentralCharacterQuotientEquivalence_inverse_comp_forget
    (χ : Subalgebra.center R A →ₐ[R] R) :
    χ.discreteCentralCharacterQuotientEquivalence.inverse ⋙
        (discreteModules.{v} (A ⧸ (closedCentralIdeal (RingHom.ker χ)).asIdeal)).ι ⋙
          forget₂ (ModuleCat _) AddCommGrpCat =
      (discreteCentralCharacterModules χ).ι ⋙ forget₂ (ModuleCat A) AddCommGrpCat := by
  simp only [discreteCentralCharacterQuotientEquivalence, Equivalence.trans_inverse,
    ObjectProperty.fullSubcategoryCongr_inverse, discreteQuotientEquivalence_inverse]
  rw [Functor.assoc, discreteQuotientDescent_comp_forget]
  rfl

end AlgHom

namespace AlgEquiv

open TauCeti Ideal

variable {R : Type*} [CommRing R] {A : Type u} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A] {B : Type*} [Ring B] [Algebra R B]
  [TopologicalSpace B] [IsTopologicalRing B]

/-- A continuous algebra equivalence carrying the central character `χ` to `χ'` maps the closed
ideal generated by the kernel of `χ` into that generated by the kernel of `χ'`. -/
theorem apply_mem_closedCentralIdeal_ker (e : A ≃ₐ[R] B) (he : Continuous e)
    {χ : Subalgebra.center R A →ₐ[R] R} {χ' : Subalgebra.center R B →ₐ[R] R}
    (hχ : χ'.comp (centerCongr e).toAlgHom = χ) {x : A}
    (hx : x ∈ closedCentralIdeal (RingHom.ker χ)) :
    e x ∈ closedCentralIdeal (RingHom.ker χ') := by
  have hcomap : (TwoSidedIdeal.comap e (closedCentralIdeal (RingHom.ker χ')) : Set A) =
      e ⁻¹' closedCentralIdeal (RingHom.ker χ') :=
    Set.ext fun _ => TwoSidedIdeal.mem_comap e
  have hclosed : IsClosed
      (TwoSidedIdeal.comap e (closedCentralIdeal (RingHom.ker χ')) : Set A) := by
    rw [hcomap]
    exact (isClosed_closedCentralIdeal _).preimage he
  refine (TwoSidedIdeal.mem_comap e).mp
    (((closedCentralIdeal_le_iff _ _ hclosed).mpr fun z hz => ?_) hx)
  rw [TwoSidedIdeal.mem_comap, ← centerCongr_apply_coe]
  refine mem_closedCentralIdeal _ ?_
  rw [RingHom.mem_ker] at hz ⊢
  exact (congrArg (fun φ => φ z) hχ).trans hz

end AlgEquiv

namespace MonoidHom

open TauCeti Ideal

variable {H : Type*} [Monoid H] {R : Type*} [CommRing R] {A : Type u} [Ring A] [Algebra R A]
  [TopologicalSpace A] [IsTopologicalRing A] (a : H →* (A ≃ₐ[R] A))
  (χ : Subalgebra.center R A →ₐ[R] R) (ha : ∀ h, Continuous (a h).symm)
  (ha' : ∀ h, Continuous (a h)) (hχ : ∀ h, χ.comp (centerCongr (a h)).symm.toAlgHom = χ)

include ha ha' hχ in
/-- Continuous automorphisms with continuous inverses that preserve a central character preserve
the closed ideal generated by its kernel. -/
theorem map_closedCentralIdeal_ker (h : H) :
    (closedCentralIdeal (RingHom.ker χ)).asIdeal.map
        ((MulSemiringAction.toRingEquiv (A ≃ₐ[R] A) A).comp a h : A →+* A) =
      (closedCentralIdeal (RingHom.ker χ)).asIdeal := by
  rw [Ideal.map_comap_of_equiv]
  ext x
  rw [Ideal.mem_comap, TwoSidedIdeal.mem_asIdeal, TwoSidedIdeal.mem_asIdeal]
  constructor
  · intro hx
    have := (a h).apply_mem_closedCentralIdeal_ker (ha' h) (χ := χ) (χ' := χ) ?_ hx
    · simpa using this
    · ext z
      simpa using (congrArg (fun φ => φ (centerCongr (a h) z)) (hχ h)).symm
  · intro hx
    refine (a h).symm.apply_mem_closedCentralIdeal_ker (ha h) (χ := χ) (χ' := χ) ?_ hx
    ext z
    have hz : centerCongr (a h).symm z = (centerCongr (a h)).symm z := Subtype.ext (by simp)
    simpa [hz] using congrArg (fun φ => φ z) (hχ h)

/-- The quotient presentation of a strict discrete character fiber is equivariant. The source
carries the twisting action through the automorphisms of the closed central quotient induced by
`a`, the target carries `discreteCentralCharacterMonoidalLeftAction`, and the lineators are the
identity maps of `discreteQuotientEquivalence`. -/
-- Exposed so that the lineators compute to identity maps of the underlying modules.
@[expose, instance_reducible]
noncomputable def leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor :
    letI := (closedCentralIdeal (RingHom.ker χ)).asIdeal.discreteQuotientMonoidalLeftAction.{v}
      _ (a.map_closedCentralIdeal_ker χ ha ha' hχ) ha
    letI := a.discreteCentralCharacterMonoidalLeftAction.{v} χ ha hχ
    χ.discreteCentralCharacterQuotientEquivalence.functor.LeftLinear (Discrete H) :=
  have hI := a.map_closedCentralIdeal_ker χ ha ha' hχ
  letI := MonoidHom.restrictScalarsMonoidalLeftAction.{v}
    ((MulSemiringAction.toRingEquiv (A ≃ₐ[R] A) A).comp a)
  letI := discreteQuotientMonoidalLeftAction.{v} _ _ hI ha
  letI := isStableUnderLeftAction_discreteAnnihilatedModules.{v} _ _ hI ha
  letI := a.isStableUnderLeftAction_discreteCentralCharacterModules.{v} χ ha hχ
  letI := leftLinearDiscreteQuotientEquivalenceFunctor.{v} _ _ hI ha
  inferInstanceAs (((discreteQuotientEquivalence _).functor ⋙
    ObjectProperty.ιOfLE χ.discreteAnnihilatedModules_closedCentralIdeal_ker.le).LeftLinear
      (Discrete H))

open Functor.LaxLeftLinear Functor.OplaxLeftLinear in
/-- The lineators of the quotient presentation of a strict discrete character fiber are identity
maps of the underlying modules. -/
lemma leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor_μₗ_hom_apply (c : Discrete H)
    (M : (discreteModules.{v} (A ⧸ (closedCentralIdeal (RingHom.ker χ)).asIdeal)).FullSubcategory)
    (x : M.obj) :
    letI := (closedCentralIdeal (RingHom.ker χ)).asIdeal.discreteQuotientMonoidalLeftAction.{v}
      _ (a.map_closedCentralIdeal_ker χ ha ha' hχ) ha
    letI := a.discreteCentralCharacterMonoidalLeftAction.{v} χ ha hχ
    letI := a.leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor.{v} χ ha ha' hχ
    (μₗ χ.discreteCentralCharacterQuotientEquivalence.functor c M).hom x = x :=
  (rfl)

open Functor.LaxLeftLinear Functor.OplaxLeftLinear in
/-- The inverse lineators of the quotient presentation of a strict discrete character fiber are
identity maps of the underlying modules. -/
lemma leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor_δₗ_hom_apply (c : Discrete H)
    (M : (discreteModules.{v} (A ⧸ (closedCentralIdeal (RingHom.ker χ)).asIdeal)).FullSubcategory)
    (x : M.obj) :
    letI := (closedCentralIdeal (RingHom.ker χ)).asIdeal.discreteQuotientMonoidalLeftAction.{v}
      _ (a.map_closedCentralIdeal_ker χ ha ha' hχ) ha
    letI := a.discreteCentralCharacterMonoidalLeftAction.{v} χ ha hχ
    letI := a.leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor.{v} χ ha ha' hχ
    (δₗ χ.discreteCentralCharacterQuotientEquivalence.functor c M).hom x = x :=
  (rfl)

/-- The inverse of the quotient presentation of a strict discrete character fiber is equivariant,
as the inverse of an equivariant equivalence. -/
@[instance_reducible]
noncomputable def leftLinearDiscreteCentralCharacterQuotientEquivalenceInverse :
    letI := (closedCentralIdeal (RingHom.ker χ)).asIdeal.discreteQuotientMonoidalLeftAction.{v}
      _ (a.map_closedCentralIdeal_ker χ ha ha' hχ) ha
    letI := a.discreteCentralCharacterMonoidalLeftAction.{v} χ ha hχ
    χ.discreteCentralCharacterQuotientEquivalence.inverse.LeftLinear (Discrete H) :=
  letI := (closedCentralIdeal (RingHom.ker χ)).asIdeal.discreteQuotientMonoidalLeftAction.{v}
    _ (a.map_closedCentralIdeal_ker χ ha ha' hχ) ha
  letI := a.discreteCentralCharacterMonoidalLeftAction.{v} χ ha hχ
  letI := a.leftLinearDiscreteCentralCharacterQuotientEquivalenceFunctor.{v} χ ha ha' hχ
  χ.discreteCentralCharacterQuotientEquivalence.inverseLeftLinear (Discrete H)

end MonoidHom
