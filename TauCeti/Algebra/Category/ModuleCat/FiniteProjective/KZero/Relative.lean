module

public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.KZero.Map
public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.StableEquivalent
public import TauCeti.CategoryTheory.GrothendieckGroup.Relative.Exact

/-!
# The kernel of `K₀(R) → K₀(S)` and the relative group of a ring homomorphism

Let `f : R →+* S` be a homomorphism of possibly noncommutative rings. Extension of scalars
`T_f : P ↦ S ⊗_R P` on finitely generated projective modules is summand-dense: every finitely
generated projective `S`-module `Q` has a complement `N` with `Q ⊕ N ≅ Sⁿ`, and `Sⁿ ≅ S ⊗_R Rⁿ` is
the extension of a free module. Hence the relative Grothendieck group `K₀(T_f)` of this functor
(`TauCeti.RelativeK0`, Weibel's relative group of the ring homomorphism `f`), generated by triples
`(P, α, Q)` with `α : P ⊗_R S ≅ Q ⊗_R S`, fits into a sequence

```text
K₀(T_f) ──[P, α, Q] ↦ [P] - [Q]──▶ K₀(R) ──K₀(f)──▶ K₀(S)
```

of projective `K₀`-groups of right modules that is exact at `K₀(R)`. In other words, an element
of `K₀(R)` dies in `K₀(S)` exactly when it is a difference `[P] - [Q]` of two finitely generated
projective right `R`-modules that become isomorphic after extending scalars to `S`. For the
quotient map `R → R/I` by a two-sided ideal this is the `K₀(R)` term of the exact sequence
`K₁(R) → K₁(R/I) → K₀(R, I) → K₀(R) → K₀(R/I)`.

## Main results

* `RingHom.isSummandDense_finiteProjectiveModulesExtendScalars`: extension of scalars along a
  ring homomorphism is summand-dense on finitely generated projective modules.
* `TauCeti.KZero.exact_toSplitK0_map`: the sequence `K₀(T_f) → K₀(R) → K₀(S)` is exact at
  `K₀(R)`.

## References

* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II,
  Definition 2.10 and (2.10.2) (the relative group of a ring homomorphism and its exact
  sequence), and Exercise 2.17.
-/

public section

open CategoryTheory CategoryTheory.Limits TauCeti

universe u

variable {R S : Type u} [Ring R] [Ring S]

namespace RingHom

/-- **Extension of scalars is summand-dense** on finitely generated projective modules: every
finitely generated projective `S`-module `Q` is a direct summand of a free module `Sⁿ`, which is
the extension of scalars of `Rⁿ`. -/
instance isSummandDense_finiteProjectiveModulesExtendScalars (f : R →+* S) :
    f.finiteProjectiveModulesExtendScalars.IsSummandDense where
  exists_biprod_mem_essImage Q := by
    obtain ⟨N, _, _, _, _, n, ⟨e⟩⟩ := Module.Projective.exists_prod_linearEquiv_fin S Q.obj
    let N' : (finiteProjectiveModules S).FullSubcategory :=
      ⟨ModuleCat.of S N, finiteProjectiveModules_iff.2 ⟨‹_›, ‹_›⟩⟩
    let F : (finiteProjectiveModules R).FullSubcategory :=
      ⟨ModuleCat.of R (Fin n → R), finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩
    -- `S ⊗_R Rⁿ ≅ Sⁿ ≅ Q × N ≅ Q ⊞ N`.
    exact ⟨N', F, ⟨ObjectProperty.isoMk _
      (eqToIso (f.finiteProjectiveModulesExtendScalars_obj_obj F) ≪≫
        ((BalancedExtension.piScalarRight f (Fin n)).trans
          (e.symm.trans (FiniteProjectiveModules.biprodLinearEquiv Q N').symm)).toModuleIso)⟩⟩

end RingHom

namespace TauCeti.KZero

/-- **Exactness of `K₀(T_f) → K₀(R) → K₀(S)` at `K₀(R)`.** For a ring homomorphism `f : R →+* S`,
an element of `K₀(R)` lies in the kernel of `K₀(f)` exactly when it is the difference `[P] - [Q]`
of the ends of a triple `(P, α, Q)` of the relative group of extension of scalars, that is, of
finitely generated projective right `R`-modules with `α : P ⊗_R S ≅ Q ⊗_R S`. -/
theorem exact_toSplitK0_map (f : R →+* S) :
    Function.Exact (RelativeK0.toSplitK0.{u} (RingHom.op f).finiteProjectiveModulesExtendScalars)
      (map f) := by
  have h : map f = SplitK0.map.{u, u} (RingHom.op f).finiteProjectiveModulesExtendScalars :=
    SplitK0.hom_ext fun P ↦ by rw [map_of, SplitK0.map_of]
  rw [h]
  exact RelativeK0.exact_toSplitK0_splitK0Map _

end TauCeti.KZero
