module

public import TauCeti.Algebra.Category.ModuleCat.CartanMap.Basic
public import TauCeti.CategoryTheory.GrothendieckGroup.Split

/-!
# The projective `K₀` of a ring

Following the right-module convention of algebraic `K`-theory, `K₀(R)` is the split Grothendieck
group of finitely generated projective right `R`-modules, encoded as left `Rᵐᵒᵖ`-modules.

## Main definitions

* `TauCeti.FiniteProjectiveRight R`: finitely generated projective right `R`-modules.
* `TauCeti.KZero R`: the projective `K₀` of `R`, the split Grothendieck group of
  `TauCeti.FiniteProjectiveRight R`.
-/

public section

namespace TauCeti

universe u

/-- Finitely generated projective right `R`-modules, encoded as left modules over `Rᵐᵒᵖ`: the full
subcategory `TauCeti.finiteProjectiveModules Rᵐᵒᵖ` of `ModuleCat Rᵐᵒᵖ`. -/
abbrev FiniteProjectiveRight (R : Type u) [Ring R] : Type (u + 1) :=
  (finiteProjectiveModules Rᵐᵒᵖ).FullSubcategory

/-- The projective `K₀` of a ring `R`: the split Grothendieck group of finitely generated
projective right `R`-modules. It is generated by the classes `[P]`, subject to
`[P ⊕ Q] = [P] + [Q]`. -/
abbrev KZero (R : Type u) [Ring R] : Type u :=
  SplitK0.{u} (FiniteProjectiveRight R)

end TauCeti
