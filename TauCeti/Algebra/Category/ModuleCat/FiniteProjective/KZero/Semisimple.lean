module

public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.KZero.Matrix
public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.KZero.Pi
public import TauCeti.Algebra.GroupWithZero.Pi
import TauCeti.RingTheory.Idempotents.Matrix

/-!
# Projective `K₀` of a finite product of matrix rings over division rings

Let `A = Π j, Matrix (n j) (n j) (D j)` be a finite product of matrix rings over division rings
`D j`, with each `n j` finite and nonempty; by the Artin–Wedderburn theorem every semisimple ring
is of this form. Then

```text
K₀(A) ≃ ℤ^J,
```

where the coordinate at `j` of a class is the multiplicity of the simple module of the `j`-th
block, not a free rank. The simple right modules of `A` are the rows `D jⁿʲ` of the blocks, on
which the other blocks act by zero. Each is the principal right ideal generated by a diagonal
matrix unit `Eₖₖ` placed in the block `j`, and it goes to the basis vector at `j`. The regular
module, the free module of rank one, goes to the family `(card (n j))ⱼ` of block sizes: the free
classes do not span `K₀(A)` as soon as a block is not `1 × 1`.

The isomorphism is the product formula for `K₀` of a finite product
(`TauCeti.KZero.piEquiv`) followed, in each factor, by the matrix Morita isomorphism
(`TauCeti.KZero.matrixEquiv`) and the rank isomorphism of a division ring
(`TauCeti.FiniteProjectiveModules.rankEquiv`). When the index type and the rings live in one
universe, the coordinate at `j` is the rank of the projection of a class to the `j`-th block,
transported to `D j` by Morita.

## Main definitions

* `TauCeti.KZero.piMatrixRankEquiv D n`: the isomorphism
  `K₀(Π j, Matrix (n j) (n j) (D j)) ≃+ (J → ℤ)`.

## Main results

* `TauCeti.KZero.piMatrixRankEquiv_of_principalRightIdeal`: the simple module of the block `j`
  goes to the basis vector at `j`.
* `TauCeti.KZero.piMatrixRankEquiv_of_finiteProjectiveModulesRegular`: the regular module goes to
  the family of block sizes.
* `TauCeti.KZero.piMatrixRankEquiv_apply_eq_rankEquiv_map`: the coordinate at `j` is computed
  from the projection to the `j`-th block.

## References

* C. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II, §2, Examples
  2.1.2–2.1.4, p. 69: Morita invariance of `K₀` for matrix rings and `K₀` of a finite product of
  rings, which together compute `K₀` of a semisimple ring.
-/

public section

noncomputable section

namespace TauCeti

open _root_.Matrix

universe u w

namespace KZero

section

variable {J : Type w} [Finite J] (D : J → Type u) [∀ j, DivisionRing (D j)] (n : J → Type)
  [∀ j, Fintype (n j)] [∀ j, DecidableEq (n j)] [∀ j, Nonempty (n j)]

/-- **`K₀` of a finite product of matrix rings over division rings.**
`K₀(Π j, Matrix (n j) (n j) (D j)) ≃+ (J → ℤ)`: the coordinate at `j` is the multiplicity of the
simple module of the `j`-th block, so the simple modules go to the standard basis
(`TauCeti.KZero.piMatrixRankEquiv_of_principalRightIdeal`), and the regular module goes to the
block sizes (`TauCeti.KZero.piMatrixRankEquiv_of_finiteProjectiveModulesRegular`). -/
def piMatrixRankEquiv : KZero (∀ j, Matrix (n j) (n j) (D j)) ≃+ (J → ℤ) :=
  (piEquiv _).trans <| AddEquiv.piCongrRight fun j ↦
    (matrixEquiv (D j) (n j)).symm.trans
      (FiniteProjectiveModules.rankEquiv (D j)ᵐᵒᵖ fun _ ↦ inferInstance)

/-- The coordinate at `j` of `TauCeti.KZero.piMatrixRankEquiv` is the rank, over `D j`, of the
Morita transport of the `j`-th component of `TauCeti.KZero.piEquiv`. -/
theorem piMatrixRankEquiv_apply (x : KZero (∀ j, Matrix (n j) (n j) (D j))) (j : J) :
    piMatrixRankEquiv D n x j = FiniteProjectiveModules.rankEquiv (D j)ᵐᵒᵖ (fun _ ↦ inferInstance)
      ((matrixEquiv (D j) (n j)).symm (piEquiv _ x j)) :=
  (rfl)

variable {D n}

/-- **The simple modules go to the standard basis.** The principal right ideal of
`Π j, Matrix (n j) (n j) (D j)` generated by a diagonal matrix unit `Eₖₖ` placed in the block `j`,
the simple module of that block, goes to the basis vector at `j`. -/
theorem piMatrixRankEquiv_of_principalRightIdeal [DecidableEq J] (j : J) (k : n j) :
    piMatrixRankEquiv D n (SplitK0.of.{max w u}
      (principalRightIdeal (e := Pi.single j (single k k (1 : D j)))
        ((isIdempotentElem_single_one (α := D j) k).piSingle j))) =
      Pi.single j 1 := by
  have hk := isIdempotentElem_single_one (α := D j) k
  -- The principal right ideal is the class of the `1 × 1` matrix `(Eₖₖ)` in the block `j`, which
  -- `piEquiv` places at `j`.
  rw [← IdempotentMonoid.toKZero_mk_of_unique (m := Unit)]
  have hcls : IdempotentMonoid.toKZero _ (IdempotentMonoid.mk ((uniqueRingEquiv (m := Unit)).symm
      (Pi.single (M := fun j ↦ Matrix (n j) (n j) (D j)) j (single k k (1 : D j))))
      ((hk.piSingle j).map uniqueRingEquiv.symm)) =
      (piEquiv _).symm (Pi.single j (SplitK0.of.{u} (principalRightIdeal hk))) := by
    rw [← IdempotentMonoid.toKZero_mk_of_unique (m := Unit), piEquiv_symm_single_toKZero,
      IdempotentMonoid.piEquiv_symm_single_mk]
    exact congrArg _ (IdempotentMonoid.mk_congr_matrix _ _ (by ext; simp))
  ext i
  rw [hcls, piMatrixRankEquiv_apply, AddEquiv.apply_symm_apply]
  rcases eq_or_ne i j with rfl | hij
  -- In the block `j`, the principal right ideal of `Eₖₖ` is the corner
  -- `TauCeti.KZero.matrixCorner`, which Morita sends to the free module of rank one.
  · rw [Pi.single_eq_same, Pi.single_eq_same, ← matrixCorner_eq_principalRightIdeal,
      ← of_matrixRow_eq_of_matrixCorner,
      matrixEquiv_symm_of_matrixRow,
      FiniteProjectiveModules.rankEquiv_of_finiteProjectiveModulesRegular]
  · rw [Pi.single_eq_of_ne hij, Pi.single_eq_of_ne hij, map_zero, map_zero]

/-- **The regular module goes to the block sizes.** The free right module of rank one over
`Π j, Matrix (n j) (n j) (D j)` goes to the family `(card (n j))ⱼ`. -/
theorem piMatrixRankEquiv_of_finiteProjectiveModulesRegular :
    piMatrixRankEquiv D n (SplitK0.of.{max w u}
      (finiteProjectiveModulesRegular (∀ j, Matrix (n j) (n j) (D j))ᵐᵒᵖ)) =
      fun j ↦ (Fintype.card (n j) : ℤ) := by
  ext j
  rw [piMatrixRankEquiv_apply, piEquiv_of_finiteProjectiveModulesRegular,
    matrixEquiv_symm_of_finiteProjectiveModulesRegular, map_nsmul,
    FiniteProjectiveModules.rankEquiv_of_finiteProjectiveModulesRegular, nsmul_one]

end

section Components

/-- **Projection recovers each coordinate.** When the index type and the division rings live in
one universe, the coordinate at `j` of `TauCeti.KZero.piMatrixRankEquiv` is the rank over `D j` of
the Morita transport of the projection to the `j`-th block, extension of scalars along the
evaluation `Π j, Matrix (n j) (n j) (D j) → Matrix (n j) (n j) (D j)`. -/
theorem piMatrixRankEquiv_apply_eq_rankEquiv_map {J : Type u} [Finite J] {D : J → Type u}
    [∀ j, DivisionRing (D j)] {n : J → Type} [∀ j, Fintype (n j)] [∀ j, DecidableEq (n j)]
    [∀ j, Nonempty (n j)] (x : KZero (∀ j, Matrix (n j) (n j) (D j))) (j : J) :
    piMatrixRankEquiv D n x j = FiniteProjectiveModules.rankEquiv (D j)ᵐᵒᵖ (fun _ ↦ inferInstance)
      ((matrixEquiv (D j) (n j)).symm (map (Pi.evalRingHom _ j) x)) := by
  rw [piMatrixRankEquiv_apply, piEquiv_apply]

end Components

end KZero

end TauCeti
