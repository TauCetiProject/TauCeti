module

public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.RingTheory.Morita.Matrix
public import TauCeti.Algebra.Category.ModuleCat.CartanMap.Morita
public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.KZero.Rank
import TauCeti.RingTheory.Semisimple.MatrixDivisionRing

/-!
# Projective `K₀` of a matrix ring

For a ring `R` and a finite nonempty index type `ι`, Mathlib's matrix Morita equivalence
`ModuleCat.matrixEquivalence` sends a left `R`-module `M` to the column module `M^ι` over
`Mₙ(R) = Matrix ι ι R`. On the split Grothendieck groups of finitely generated projective left
modules it induces the Morita isomorphism

```text
K₀(R) ≃ K₀(Mₙ(R)),   [M] ↦ [M^ι],
```

which sends `[R]` to the class of the column module `R^ι`, not to the class of the regular
module. The regular `Mₙ(R)`-module is the direct sum of its `n` columns, so its class is `n`
times the column class, and the inverse isomorphism sends it to `n[R]`.

When `R` has invariant basis number and its finitely generated projective modules are stably
free (division rings, commutative local rings, principal ideal domains), `K₀(R) ≃ ℤ` with
`[R] ↦ 1`. Composing gives `K₀(Mₙ(R)) ≃ ℤ`, normalized by the column module: the column class
goes to `1` and the regular class to `n`. Consequently the free classes `m[Mₙ(R)]` form the
subgroup of index `n`. Invariant basis number alone already shows that for `n ≥ 2` the column
module is not stably free, so in particular it is not free.

## Main definitions

* `TauCeti.FiniteProjectiveModules.matrixColumn R ι`: the column module `R^ι` over
  `Matrix ι ι R`, as a finitely generated projective module.
* `TauCeti.FiniteProjectiveModules.matrixK0Equiv R ι`: the Morita isomorphism
  `K₀(R) ≃+ K₀(Matrix ι ι R)` induced by `ModuleCat.matrixEquivalence`.
* `TauCeti.FiniteProjectiveModules.matrixRankEquiv R ι h`: the isomorphism
  `K₀(Matrix ι ι R) ≃+ ℤ` normalized by the column module, when `R` has invariant basis number
  and its finitely generated projective modules are stably free.

## Main results

* `TauCeti.FiniteProjectiveModules.of_finiteProjectiveModulesRegular_matrix`: in
  `K₀(Matrix ι ι R)` the regular class is `card ι` times the column class.
* `TauCeti.FiniteProjectiveModules.matrixK0Equiv_of_finiteProjectiveModulesRegular` and
  `TauCeti.FiniteProjectiveModules.matrixK0Equiv_symm_of_finiteProjectiveModulesRegular`: the
  Morita isomorphism sends `[R]` to the column class, and its inverse sends the regular class of
  `Matrix ι ι R` to `card ι • [R]`.
* `TauCeti.FiniteProjectiveModules.matrixRankEquiv_of_matrixColumn` and
  `TauCeti.FiniteProjectiveModules.matrixRankEquiv_of_finiteProjectiveModulesRegular`: the
  normalized isomorphism with `ℤ` sends the column class to `1` and the regular class to `card ι`.
* `TauCeti.FiniteProjectiveModules.index_zmultiples_of_finiteProjectiveModulesRegular_matrix`:
  the subgroup generated by the regular class has index `card ι`.
* `TauCeti.FiniteProjectiveModules.not_isStablyFree_matrixColumn`: over a ring with invariant
  basis number and for `card ι ≥ 2`, the column module is not stably free.

## References

* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II, §2,
  Example 2.1.2 (Morita invariance of `K₀` and `K₀(Mₙ(R)) ≅ K₀(R)`), p. 69.
* T. Y. Lam, *Lectures on Modules and Rings*, GTM 189 (1999), §17B, for the matrix Morita
  equivalence.
-/

public section

namespace TauCeti

open CategoryTheory _root_.Module
open scoped Matrix.Module

universe u

namespace FiniteProjectiveModules

variable (R : Type u) [Ring R] (ι : Type) [Fintype ι] [DecidableEq ι]

/-! ### The column module -/

/-- The column module `R^ι` over the matrix ring `Matrix ι ι R`, with matrices acting by
`(A • v) i = ∑ j, A i j * v j`, as a finitely generated projective module. It is the image of the
regular `R`-module under the matrix Morita equivalence. -/
@[expose] def matrixColumn : (finiteProjectiveModules (Matrix ι ι R)).FullSubcategory :=
  ⟨ModuleCat.of (Matrix ι ι R) (ι → R), by
    rw [finiteProjectiveModules_iff]
    cases isEmpty_or_nonempty ι with
    | inl _ => exact ⟨inferInstance, inferInstance⟩
    | inr _ =>
      let e := ModuleCat.matrixEquivalence R (Classical.arbitrary ι)
      exact ⟨(e.finite_functor_obj_iff (ModuleCat.of R R)).2 inferInstance,
        (e.projective_functor_obj_iff (ModuleCat.of R R)).2 inferInstance⟩⟩

/-- The underlying module of `TauCeti.FiniteProjectiveModules.matrixColumn R ι` is `R^ι` with
the column action of `Matrix ι ι R`. -/
@[simp]
theorem matrixColumn_obj : (matrixColumn R ι).obj = ModuleCat.of (Matrix ι ι R) (ι → R) :=
  (rfl)

/-- **The regular module of a matrix ring is a sum of columns.** In the split `K₀` of
`Matrix ι ι R`, the class of the regular module is `card ι` times the class of the column
module. -/
theorem of_finiteProjectiveModulesRegular_matrix :
    SplitK0.of.{u} (finiteProjectiveModulesRegular (Matrix ι ι R)) =
      Fintype.card ι • SplitK0.of.{u} (matrixColumn R ι) := by
  rw [SplitK0.of_eq_sum_of_linearEquiv_pi (fun _ ↦ matrixColumn R ι) (Matrix.linearEquivPi ι R),
    Finset.sum_const, Finset.card_univ]

/-! ### The Morita isomorphism -/

variable [Nonempty ι]

/-- **Morita invariance of `K₀` for matrix rings.** The isomorphism
`K₀(R) ≃+ K₀(Matrix ι ι R)` induced by the matrix Morita equivalence
`ModuleCat.matrixEquivalence`. It sends the class of `M` to the class of the column module `M^ι`
(`TauCeti.FiniteProjectiveModules.matrixK0Equiv_of`); this does not depend on the corner used to
build the inverse equivalence. -/
noncomputable def matrixK0Equiv :
    SplitK0.{u} (finiteProjectiveModules R).FullSubcategory ≃+
      SplitK0.{u} (finiteProjectiveModules (Matrix ι ι R)).FullSubcategory :=
  SplitK0.mapEquiv
    (ModuleCat.matrixEquivalence R (Classical.arbitrary ι)).finiteProjectiveModulesEquivalence

/-- The Morita isomorphism sends the class of `M` to the class of any finitely generated
projective `Matrix ι ι R`-module isomorphic to the column module `M^ι`. -/
theorem matrixK0Equiv_of (M : (finiteProjectiveModules R).FullSubcategory)
    (N : (finiteProjectiveModules (Matrix ι ι R)).FullSubcategory)
    (e : (ι → M.obj) ≃ₗ[Matrix ι ι R] N.obj) :
    matrixK0Equiv R ι (SplitK0.of.{u} M) = SplitK0.of.{u} N := by
  rw [matrixK0Equiv, SplitK0.mapEquiv_of]
  exact SplitK0.of_congr ((finiteProjectiveModules (Matrix ι ι R)).fullyFaithfulι.preimageIso
    (eqToIso (Equivalence.finiteProjectiveModulesEquivalence_functor_obj_obj _ M) ≪≫
      e.toModuleIso))

/-- The Morita isomorphism sends `[R]` to the class of the column module `R^ι`. -/
@[simp]
theorem matrixK0Equiv_of_finiteProjectiveModulesRegular :
    matrixK0Equiv R ι (SplitK0.of.{u} (finiteProjectiveModulesRegular R)) =
      SplitK0.of.{u} (matrixColumn R ι) :=
  matrixK0Equiv_of R ι _ _ (.refl _ _)

/-- The inverse Morita isomorphism sends the class of the column module to `[R]`. -/
@[simp]
theorem matrixK0Equiv_symm_of_matrixColumn :
    (matrixK0Equiv R ι).symm (SplitK0.of.{u} (matrixColumn R ι)) =
      SplitK0.of.{u} (finiteProjectiveModulesRegular R) := by
  rw [AddEquiv.symm_apply_eq, matrixK0Equiv_of_finiteProjectiveModulesRegular]

/-- The inverse Morita isomorphism sends the class of the regular `Matrix ι ι R`-module to
`card ι • [R]`. -/
@[simp]
theorem matrixK0Equiv_symm_of_finiteProjectiveModulesRegular :
    (matrixK0Equiv R ι).symm (SplitK0.of.{u} (finiteProjectiveModulesRegular (Matrix ι ι R))) =
      Fintype.card ι • SplitK0.of.{u} (finiteProjectiveModulesRegular R) := by
  rw [of_finiteProjectiveModulesRegular_matrix, map_nsmul, matrixK0Equiv_symm_of_matrixColumn]

omit [Nonempty ι] in
/-- **The column module is not stably free.** If `R` has invariant basis number and
`card ι ≥ 2`, the column module `R^ι` over `Matrix ι ι R` is not stably free, and in particular not
free. -/
theorem not_isStablyFree_matrixColumn [InvariantBasisNumber R] (hι : 1 < Fintype.card ι) :
    ¬ IsStablyFree (Matrix ι ι R) (matrixColumn R ι).obj := by
  have : Nonempty ι := Fintype.card_pos_iff.1 (by omega)
  intro _
  obtain ⟨z, hz⟩ := exists_zsmul_eq_of_isStablyFree (Matrix ι ι R) (matrixColumn R ι)
  have h := congrArg (matrixK0Equiv R ι).symm hz
  rw [map_zsmul, matrixK0Equiv_symm_of_finiteProjectiveModulesRegular,
    matrixK0Equiv_symm_of_matrixColumn, ← natCast_zsmul, smul_smul] at h
  have h1 : z * Fintype.card ι = 1 :=
    zsmul_of_finiteProjectiveModulesRegular_injective R (h.trans (one_zsmul _).symm)
  have := Int.eq_one_of_dvd_one (by positivity) (Dvd.intro_left z h1)
  omega

/-! ### The normalization by the column module -/

section RankEquiv

variable [InvariantBasisNumber R]
  (h : ∀ P : (finiteProjectiveModules R).FullSubcategory, IsStablyFree R P.obj)

/-- **`K₀` of a matrix ring is `ℤ`, normalized by the column module.** If `R` has invariant basis
number and every finitely generated projective `R`-module is stably free (for instance a division
ring), then `K₀(Matrix ι ι R) ≃+ ℤ` by the inverse Morita isomorphism followed by
`TauCeti.FiniteProjectiveModules.rankEquiv`. The column module goes to `1` and the regular module
to `card ι`. -/
noncomputable def matrixRankEquiv :
    SplitK0.{u} (finiteProjectiveModules (Matrix ι ι R)).FullSubcategory ≃+ ℤ :=
  (matrixK0Equiv R ι).symm.trans (rankEquiv R h)

/-- The inverse of `TauCeti.FiniteProjectiveModules.matrixRankEquiv` sends `z` to `z` times the
column class. -/
@[simp]
theorem matrixRankEquiv_symm_apply (z : ℤ) :
    (matrixRankEquiv R ι h).symm z = z • SplitK0.of.{u} (matrixColumn R ι) := by
  simp [matrixRankEquiv, map_zsmul]

/-- `TauCeti.FiniteProjectiveModules.matrixRankEquiv` sends the column class to `1`. -/
@[simp]
theorem matrixRankEquiv_of_matrixColumn :
    matrixRankEquiv R ι h (SplitK0.of.{u} (matrixColumn R ι)) = 1 := by
  simp [matrixRankEquiv]

/-- `TauCeti.FiniteProjectiveModules.matrixRankEquiv` sends the regular class of `Matrix ι ι R`
to `card ι`. -/
@[simp]
theorem matrixRankEquiv_of_finiteProjectiveModulesRegular :
    matrixRankEquiv R ι h (SplitK0.of.{u} (finiteProjectiveModulesRegular (Matrix ι ι R))) =
      Fintype.card ι := by
  simp [matrixRankEquiv, ← natCast_zsmul, rankEquiv_zsmul_of_finiteProjectiveModulesRegular]

include h in
/-- **The free classes have index `card ι`.** In `K₀(Matrix ι ι R)`, the subgroup generated by
the class of the regular module has index `card ι`. -/
theorem index_zmultiples_of_finiteProjectiveModulesRegular_matrix :
    (AddSubgroup.zmultiples
      (SplitK0.of.{u} (finiteProjectiveModulesRegular (Matrix ι ι R)))).index =
      Fintype.card ι := by
  rw [← AddSubgroup.index_map_equiv _ (matrixRankEquiv R ι h), AddMonoidHom.map_zmultiples]
  simp

end RankEquiv

end FiniteProjectiveModules

/-- Over a division ring `D`, the projective `K₀` of `Matrix ι ι D` is `ℤ`, normalized by the
column module. -/
example (D : Type u) [DivisionRing D] (ι : Type) [Fintype ι] [DecidableEq ι] [Nonempty ι] :
    FiniteProjectiveModules.matrixRankEquiv D ι (fun _ ↦ inferInstance)
      (SplitK0.of (finiteProjectiveModulesRegular (Matrix ι ι D))) = Fintype.card ι :=
  FiniteProjectiveModules.matrixRankEquiv_of_finiteProjectiveModulesRegular D ι _

end TauCeti
