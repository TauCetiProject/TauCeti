module

public import TauCeti.Algebra.Category.ModuleCat.FiniteProjective.StableEquivalent

/-!
# The free-class map `ℤ → K₀(R)`

For a ring `R`, not necessarily commutative, let `K₀(R)` be the split Grothendieck group of the
full subcategory of finitely generated projective left `R`-modules. The *free-class map*
`η : ℤ →+ K₀(R)` sends `m` to `m [R]`; its image is the subgroup generated by the classes of
finite free modules. This file determines when `η` is injective, surjective or bijective:

* `η` is injective exactly when `R` has invariant basis number. Equality `[Rⁿ] = [Rᵐ]` in `K₀(R)`
  is stable equivalence `Rⁿ⁺ᵏ ≃ Rᵐ⁺ᵏ`, which invariant basis number turns into `n = m`.
  Conversely, `Rⁿ ≃ Rᵐ` gives `n [R] = m [R]`. In particular `η` is never injective over the zero
  ring.
* `η` is surjective exactly when every finitely generated projective `R`-module is stably free.
  The class of a single module `P` lies in the image of `η` exactly when `P` is stably free, and
  every element of `K₀(R)` has the form `[P] - n [R]`.

Hence `η` is an isomorphism exactly when `R` has invariant basis number and every finitely
generated projective module is stably free; `freeClassEquiv` is the resulting identification
`ℤ ≃+ K₀(R)`, normalized by `1 ↦ [R]`. This is the case for division rings, and the
identification computes `K₀` of any ring over which finitely generated projective modules are
free and ranks are well defined. Mere existence of some abstract isomorphism `K₀(R) ≃ ℤ` is weaker
than this statement about the displayed map.

## Main definitions

* `TauCeti.FiniteProjectiveModules.freeClass R : ℤ →+ K₀(R)`: the free-class map `m ↦ m [R]`.
* `TauCeti.FiniteProjectiveModules.freeProjective R n`: the finite free module `Rⁿ` as an object
  of the category of finitely generated projective modules; its class is `η n`
  (`TauCeti.FiniteProjectiveModules.of_freeProjective`).
* `TauCeti.FiniteProjectiveModules.freeClassEquiv`: the free-class map as an isomorphism
  `ℤ ≃+ K₀(R)`, when `R` has invariant basis number and every finitely generated projective
  module is stably free.

## Main results

* `TauCeti.FiniteProjectiveModules.of_eq_freeClass`: a module isomorphic to `Rⁿ` has class
  `η n = n [R]`.
* `TauCeti.FiniteProjectiveModules.exists_eq_of_sub_freeClass`: every element of `K₀(R)` is
  `[P] - n [R]` for a finitely generated projective `P` and some `n : ℕ`.
* `TauCeti.FiniteProjectiveModules.of_mem_range_freeClass_iff`: the class of `P` is an integer
  multiple of `[R]` exactly when `P` is stably free.
* `TauCeti.FiniteProjectiveModules.freeClass_injective_iff`: `η` is injective exactly when `R` has
  invariant basis number.
* `TauCeti.FiniteProjectiveModules.freeClass_surjective_iff`: `η` is surjective exactly when every
  finitely generated projective `R`-module is stably free.
* `TauCeti.FiniteProjectiveModules.freeClass_bijective_iff`: the conjunction of the two.

## References

* Charles A. Weibel, *The K-book: An Introduction to Algebraic K-theory*, Chapter II, §2,
  Lemma 2.1.
-/

public section

namespace TauCeti

open CategoryTheory CategoryTheory.Limits Module

universe u

namespace FiniteProjectiveModules

variable (R : Type u) [Ring R]

/-- The *free-class map* `η : ℤ →+ K₀(R)`, `m ↦ m [R]`, into the split `K₀` of finitely generated
projective `R`-modules. Its value at a natural number `n` is the class of `Rⁿ`
(`TauCeti.FiniteProjectiveModules.of_eq_freeClass`). -/
noncomputable def freeClass : ℤ →+ SplitK0.{u} (finiteProjectiveModules R).FullSubcategory :=
  zmultiplesHom _ <| SplitK0.of.{u}
    ⟨ModuleCat.of R R, finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩

/-- The free-class map sends `m` to `m [R]`. -/
@[simp]
theorem freeClass_apply (m : ℤ) :
    freeClass R m = m • SplitK0.of.{u}
      ⟨ModuleCat.of R R, finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩ :=
  (rfl)

/-- The finite free module `Rⁿ`, including `R⁰ = 0`, as a finitely generated projective
`R`-module. -/
abbrev freeProjective (n : ℕ) : (finiteProjectiveModules R).FullSubcategory :=
  ⟨ModuleCat.of R (Fin n → R), finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩

variable {R}

/-- The class of a finitely generated projective module isomorphic to `Rⁿ` is `η n = n [R]`. -/
theorem of_eq_freeClass {X : (finiteProjectiveModules R).FullSubcategory} {n : ℕ}
    (e : X.obj ≃ₗ[R] (Fin n → R)) : SplitK0.of.{u} X = freeClass R n := by
  rw [freeClass_apply, natCast_zsmul]
  exact SplitK0.of_eq_nsmul_of_linearEquiv_fin e (.refl _ _)

variable (R) in
/-- The class of `Rⁿ` is `η n = n [R]`. -/
@[simp]
theorem of_freeProjective (n : ℕ) : SplitK0.of.{u} (freeProjective R n) = freeClass R n :=
  of_eq_freeClass (.refl _ _)

/-- The class `[M] - n [R]` of `TauCeti.FiniteProjectiveModules.classOf` is `[M] - η n`. -/
theorem classOf_eq_sub_freeClass (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] (n : ℕ) :
    classOf R M n = SplitK0.of.{u}
      ⟨ModuleCat.of R M, finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩ -
        freeClass R n := by
  rw [classOf_def, freeClass_apply, natCast_zsmul]

/-- **Normal form in projective `K₀`.** Every element of `K₀(R)` is `[P] - n [R]` for a finitely
generated projective module `P` and a natural number `n`. -/
theorem exists_eq_of_sub_freeClass (x : SplitK0.{u} (finiteProjectiveModules R).FullSubcategory) :
    ∃ (P : (finiteProjectiveModules R).FullSubcategory) (n : ℕ),
      x = SplitK0.of.{u} P - freeClass R n := by
  obtain ⟨X, Y, rfl⟩ := SplitK0.exists_eq_sub x
  -- Add a complement `N` of `Y` with `Y × N ≃ Rⁿ` to both terms.
  obtain ⟨N, _, _, _, _, n, ⟨e⟩⟩ := Module.Projective.exists_prod_linearEquiv_fin R Y.obj
  let N' : (finiteProjectiveModules R).FullSubcategory :=
    ⟨ModuleCat.of R N, finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩
  refine ⟨X ⊞ N', n, ?_⟩
  rw [SplitK0.of_biprod, ← of_eq_freeClass ((biprodLinearEquiv Y N').trans e),
    SplitK0.of_biprod]
  abel

/-- **Stably free classes.** The class of a finitely generated projective module `P` is an integer
multiple of `[R]` exactly when `P` is stably free. -/
theorem of_mem_range_freeClass_iff {P : (finiteProjectiveModules R).FullSubcategory} :
    SplitK0.of.{u} P ∈ (freeClass R).range ↔ IsStablyFree R P.obj := by
  constructor
  · rintro ⟨m, hm⟩
    obtain ⟨a, b, rfl⟩ : ∃ a b : ℕ, m = a - b := ⟨m.toNat, (-m).toNat, by omega⟩
    -- `[P] = a [R] - b [R]` says that `P × Rᵇ` and `Rᵃ` have the same class.
    have h : SplitK0.of.{u} (P ⊞ freeProjective R b) = SplitK0.of.{u} (freeProjective R a) := by
      rw [SplitK0.of_biprod, of_freeProjective, of_freeProjective, ← hm, map_sub, sub_add_cancel]
    obtain ⟨k, ⟨e⟩⟩ := (SplitK0.of_eq_of_iff_exists_prod_linearEquiv_fin (.refl _ _)).1 h
    -- So `P × (Rᵇ × Rᵏ) ≃ Rᵃ⁺ᵏ` is free.
    have : Module.Free R (P.obj × ((Fin b → R) × (Fin k → R))) :=
      .of_equiv ((LinearEquiv.prodAssoc R P.obj _ _).symm.trans
        (((biprodLinearEquiv P (freeProjective R b)).symm.prodCongr (.refl R _)).trans e)).symm
    exact IsStablyFree.of_free_prod R P.obj ((Fin b → R) × (Fin k → R))
  · intro _
    obtain ⟨N, _, _, _, _, _⟩ := IsStablyFree.exist_free_prod R P.obj
    let N' : (finiteProjectiveModules R).FullSubcategory :=
      ⟨ModuleCat.of R N, finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩
    -- Both `N` and `P × N` are finite free, so their classes lie in the image of `η`.
    refine ⟨Fintype.card (Free.ChooseBasisIndex R (P.obj × N)) -
      Fintype.card (Free.ChooseBasisIndex R N), ?_⟩
    rw [map_sub, ← of_eq_freeClass (X := N')
        ((Free.chooseBasis R N).reindex (Fintype.equivFin _)).equivFun,
      ← of_eq_freeClass (X := P ⊞ N') ((biprodLinearEquiv P N').trans
        ((Free.chooseBasis R (P.obj × N)).reindex (Fintype.equivFin _)).equivFun),
      SplitK0.of_biprod, add_sub_cancel_right]

variable (R) in
/-- **The free-class map and invariant basis number.** The map `η : ℤ →+ K₀(R)`, `m ↦ m [R]`, is
injective exactly when `R` has invariant basis number. -/
theorem freeClass_injective_iff :
    Function.Injective (freeClass R) ↔ InvariantBasisNumber R := by
  constructor
  · -- `Rⁿ ≃ Rᵐ` gives `η n = [Rⁿ] = η m`.
    refine fun h => ⟨fun {n m} e => ?_⟩
    exact_mod_cast h ((of_freeProjective R n).symm.trans (of_eq_freeClass e))
  · intro _
    -- `η n = 0 = η 0` makes `Rⁿ` stably equivalent to `R⁰`, so `n = 0`.
    have key (n : ℕ) (hn : freeClass R n = 0) : n = 0 := by
      have h : SplitK0.of.{u} (freeProjective R n) = SplitK0.of.{u} (freeProjective R 0) := by
        rw [of_freeProjective, of_freeProjective, hn, Nat.cast_zero, map_zero]
      exact stableEquivalent_fin_fun_fin_fun_iff.1 (SplitK0.of_eq_of_iff_stableEquivalent.1 h)
    refine (injective_iff_map_eq_zero _).2 fun m hm => ?_
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg m
    · exact_mod_cast key n hm
    · rw [map_neg, neg_eq_zero] at hm
      simp [key n hm]

variable (R) in
/-- **The free-class map and stably free modules.** The map `η : ℤ →+ K₀(R)`, `m ↦ m [R]`, is
surjective exactly when every finitely generated projective `R`-module is stably free. -/
theorem freeClass_surjective_iff :
    Function.Surjective (freeClass R) ↔
      ∀ (P : Type u) [AddCommGroup P] [Module R P] [Module.Finite R P] [Module.Projective R P],
        IsStablyFree R P := by
  refine ⟨fun h P _ _ _ _ => ?_, fun h x => ?_⟩
  · exact (of_mem_range_freeClass_iff (P := ⟨ModuleCat.of R P,
      finiteProjectiveModules_iff.2 ⟨inferInstance, inferInstance⟩⟩)).1 (h _)
  · obtain ⟨P, n, rfl⟩ := exists_eq_of_sub_freeClass x
    obtain ⟨m, hm⟩ := of_mem_range_freeClass_iff.2 (h P.obj)
    exact ⟨m - n, by rw [map_sub, hm]⟩

variable (R) in
/-- The free-class map `η : ℤ →+ K₀(R)`, `m ↦ m [R]`, is bijective exactly when `R` has invariant
basis number and every finitely generated projective `R`-module is stably free. -/
theorem freeClass_bijective_iff :
    Function.Bijective (freeClass R) ↔ InvariantBasisNumber R ∧
      ∀ (P : Type u) [AddCommGroup P] [Module R P] [Module.Finite R P] [Module.Projective R P],
        IsStablyFree R P :=
  and_congr (freeClass_injective_iff R) (freeClass_surjective_iff R)

variable (R) in
/-- The free-class map as an isomorphism `ℤ ≃+ K₀(R)`, `m ↦ m [R]`, over a ring with invariant
basis number all of whose finitely generated projective modules are stably free. -/
noncomputable def freeClassEquiv [InvariantBasisNumber R]
    (h : ∀ (P : Type u) [AddCommGroup P] [Module R P] [Module.Finite R P]
      [Module.Projective R P], IsStablyFree R P) :
    ℤ ≃+ SplitK0.{u} (finiteProjectiveModules R).FullSubcategory :=
  AddEquiv.ofBijective (freeClass R) ((freeClass_bijective_iff R).2 ⟨inferInstance, h⟩)

section FreeClassEquiv

variable [InvariantBasisNumber R]
  {h : ∀ (P : Type u) [AddCommGroup P] [Module R P] [Module.Finite R P]
    [Module.Projective R P], IsStablyFree R P}

/-- `freeClassEquiv` is the free-class map `m ↦ m [R]`. -/
@[simp]
theorem freeClassEquiv_apply (m : ℤ) : freeClassEquiv R h m = freeClass R m :=
  (rfl)

/-- The inverse of `freeClassEquiv` sends the class of a module isomorphic to `Rⁿ` to `n`. -/
theorem freeClassEquiv_symm_of {X : (finiteProjectiveModules R).FullSubcategory} {n : ℕ}
    (e : X.obj ≃ₗ[R] (Fin n → R)) : (freeClassEquiv R h).symm (SplitK0.of.{u} X) = n := by
  rw [AddEquiv.symm_apply_eq, freeClassEquiv_apply, of_eq_freeClass e]

end FreeClassEquiv

/-- Over a division ring every finitely generated module is free, and ranks are well defined, so
the free-class map identifies `K₀` with `ℤ`. -/
example (D : Type u) [DivisionRing D] : Function.Bijective (freeClass D) :=
  (freeClass_bijective_iff D).2 ⟨inferInstance, fun _ _ _ _ _ => inferInstance⟩

/-- Over the zero ring `R⁰ ≃ R¹`, so the free-class map is not injective. -/
example [Subsingleton R] : ¬ Function.Injective (freeClass R) := fun h =>
  haveI := (freeClass_injective_iff R).1 h
  not_nontrivial R inferInstance

end FiniteProjectiveModules

end TauCeti
