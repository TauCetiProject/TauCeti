module

public import TauCeti.Algebra.Category.ModuleCat.Smooth.Basic
public import TauCeti.Algebra.Category.ModuleCat.Tower.Quotient

/-!
# The completion of a ring along left ideals

Let `A` be a ring, which need not be commutative, and `J₀ ⊇ J₁ ⊇ J₂ ⊇ ⋯` a decreasing family of
left ideals of `A`. The completion `Â = lim A ⧸ Jₙ` (`TauCeti.ModuleTower.quotients`) is a left
`A`-module, and the quotients `A ⧸ Jₙ` are only modules, not rings. This file constructs the ring
structure of `Â` by extending the action of `A` on smooth modules to `Â`.

**The action on smooth modules.** Let `M` be an `A`-module which is smooth for `J`, that is every
vector `m` is killed by some `Jₙ` (`TauCeti.smoothModules`). Then `a • m` only depends on the class
of `a` in `A ⧸ Jₙ`, so a point `x` of `Â` acts on `m` by `x • m = b • m` for any `b ∈ A` whose class
modulo `Jₙ` is the `n`-th coordinate of `x` (`TauCeti.ModuleTower.limSmul`,
`TauCeti.ModuleTower.limSmul_eq_smul`). This does not depend on the cutoff `n`, it extends the
action of `A`, it commutes with linear maps between smooth modules, and it is the only extension of
the action of `A` whose orbit maps `x ↦ x • m` are locally constant
(`TauCeti.ModuleTower.eq_limSmul_of_isLocallyConstant`).

**The multiplication.** Suppose that the family satisfies the right-shift estimate
`∀ b n, ∃ m, Jₘ b ⊆ Jₙ`. Then each quotient `A ⧸ Jₙ` is a smooth module, and the product of `x` and
`y` in `Â` is defined coordinatewise by `(x y)ₙ = x • yₙ` (`TauCeti.ModuleTower.limMul`). Its ring
laws come from the compatibility `(x y) • m = x • (y • m)` of the action on smooth modules
(`TauCeti.ModuleTower.limSmul_limMul`), and the canonical map `A → Â` is multiplicative. The
kernels of the projections `Â → A ⧸ Jₙ` are left ideals of `Â` and satisfy the right-shift estimate
again, so multiplication is jointly continuous for the inverse limit topology
(`TauCeti.ModuleTower.continuous_limMul`). The ring structure is
`TauCeti.ModuleTower.limRing`; it is not an instance, since it depends on the right-shift estimate.

Mathlib's `UniformSpace.Completion.ring` completes a topological ring abstractly. Here the
completion is the explicit inverse limit of modules `lim A ⧸ Jₙ`, and the action on smooth modules
built on the way is needed in its own right. Only a basis of left ideals is used, never two-sided
ideals: for the completed enveloping algebras of affine Lie algebras, the left ideals generated by
the currents of high order are not two-sided.

## Main definitions

* `TauCeti.ModuleTower.limSmul`: the action of `lim A ⧸ Jₙ` on a smooth `A`-module.
* `TauCeti.ModuleTower.limMul`: the multiplication of `lim A ⧸ Jₙ`.
* `TauCeti.ModuleTower.limRing`: the ring structure of `lim A ⧸ Jₙ`.

## Main results

* `TauCeti.ModuleTower.limSmul_eq_smul`: the action is computed by any representative of a
  coordinate at a cutoff of the vector.
* `TauCeti.ModuleTower.eq_limSmul_of_isLocallyConstant`: the action is the unique extension of the
  action of `A` with locally constant orbit maps.
* `TauCeti.ModuleTower.limSmul_limMul`: the action of a product is the composite of the actions.
* `TauCeti.ModuleTower.limπ_limMul_eq_zero`,
  `TauCeti.ModuleTower.exists_forall_limπ_limMul_eq_zero`: the kernels of the projections are left
  ideals satisfying the right-shift estimate.
* `TauCeti.ModuleTower.continuous_limMul`: multiplication is continuous.

## References

* E. Frenkel, *Langlands Correspondence for Loop Groups*, §2.1.2 and §3.2.1, for the completion
  of an enveloping algebra along left ideals and its action on smooth modules.
-/

public section

noncomputable section

namespace TauCeti.ModuleTower

open CategoryTheory Opposite Filter Topology

universe u w

variable {A : Type u} [Ring A] {J : ℕ → Submodule A A} {hJ : Antitone J}

/-! ### The action on smooth modules -/

section Smul

variable {M : ModuleCat.{w} A}

/-- Elements of `A` with the same class modulo `Jₙ` act in the same way on a vector killed by
`Jₙ`. -/
private theorem smul_eq_smul_of_quotientsπ_eq {N : Type*} [AddCommGroup N] [Module A N] {m : N}
    {n : ℕ} (hm : ∀ c ∈ J n, c • m = 0) {b b' : A}
    (h : quotientsπ J hJ n b = quotientsπ J hJ n b') :
    b • m = b' • m := by
  rw [← sub_eq_zero, ← map_sub, quotientsπ_eq_zero_iff] at h
  rw [← sub_eq_zero, ← sub_smul, hm _ h]

/-- A representative of the `k`-th coordinate of a point of `lim A ⧸ Jₙ` also represents its
`n`-th coordinate for `n ≤ k`. -/
private theorem quotientsπ_eq_limπ_of_le {x : (quotients J hJ).lim} {n k : ℕ} (h : n ≤ k) {b : A}
    (hb : quotientsπ J hJ k b = (quotients J hJ).limπ k x) :
    quotientsπ J hJ n b = (quotients J hJ).limπ n x := by
  rw [← transitionOfLE_quotientsπ J hJ h, hb, ← LinearMap.comp_apply, transitionOfLE_comp_limπ]

/-- **The action of the completion `lim A ⧸ Jₙ` on a smooth module.** A point `x` acts on a vector
`m` killed by `Jₙ` as any element of `A` whose class modulo `Jₙ` is the `n`-th coordinate of `x`
(`TauCeti.ModuleTower.limSmul_eq_smul`). -/
def limSmul (hM : smoothModules J M) (x : (quotients J hJ).lim) (m : M) : M :=
  (quotientsπ_surjective J hJ _
    ((quotients J hJ).limπ (smoothModules_iff.1 hM m).choose x)).choose • m

variable (hM : smoothModules J M)

/-- **The action of the completion is computed at any cutoff.** If `Jₙ` kills `m` and the class of
`b` modulo `Jₙ` is the `n`-th coordinate of `x`, then `x` acts on `m` as `b`. -/
theorem limSmul_eq_smul (x : (quotients J hJ).lim) {m : M} {n : ℕ} (hm : ∀ c ∈ J n, c • m = 0)
    {b : A} (hb : quotientsπ J hJ n b = (quotients J hJ).limπ n x) : limSmul hM x m = b • m := by
  set n₀ := (smoothModules_iff.1 hM m).choose
  have hm₀ : ∀ c ∈ J n₀, c • m = 0 := (smoothModules_iff.1 hM m).choose_spec
  have hb₀ := (quotientsπ_surjective J hJ _ ((quotients J hJ).limπ n₀ x)).choose_spec
  -- A representative at the common refinement `max n n₀` represents both coordinates.
  obtain ⟨b', hb'⟩ := quotientsπ_surjective J hJ _ ((quotients J hJ).limπ (max n n₀) x)
  rw [limSmul, smul_eq_smul_of_quotientsπ_eq hm₀
    (hb₀.trans (quotientsπ_eq_limπ_of_le (le_max_right n n₀) hb').symm)]
  exact smul_eq_smul_of_quotientsπ_eq hm
    ((quotientsπ_eq_limπ_of_le (le_max_left n n₀) hb').trans hb.symm)

/-- The completion acts on a vector through any coordinate at which the vector is killed. -/
theorem exists_limSmul_eq_smul (x : (quotients J hJ).lim) (m : M) :
    ∃ n, ∃ b : A, (∀ c ∈ J n, c • m = 0) ∧ quotientsπ J hJ n b = (quotients J hJ).limπ n x ∧
      limSmul hM x m = b • m := by
  obtain ⟨n, hn⟩ := smoothModules_iff.1 hM m
  obtain ⟨b, hb⟩ := quotientsπ_surjective J hJ n ((quotients J hJ).limπ n x)
  exact ⟨n, b, hn, hb, limSmul_eq_smul hM x hn hb⟩

/-- **The action of the completion extends the action of `A`.** -/
@[simp]
theorem limSmul_toLimQuotients (a : A) (m : M) :
    limSmul hM (toLimQuotients J hJ a) m = a • m :=
  limSmul_eq_smul hM _ (smoothModules_iff.1 hM m).choose_spec
    (by rw [← limπ_comp_toLimQuotients, LinearMap.comp_apply])

@[simp]
theorem limSmul_add (x : (quotients J hJ).lim) (m m' : M) :
    limSmul hM x (m + m') = limSmul hM x m + limSmul hM x m' := by
  obtain ⟨n, hn⟩ := smoothModules_iff.1 hM m
  obtain ⟨n', hn'⟩ := smoothModules_iff.1 hM m'
  obtain ⟨b, hb⟩ := quotientsπ_surjective J hJ (max n n') ((quotients J hJ).limπ (max n n') x)
  have hm : ∀ c ∈ J (max n n'), c • m = 0 := fun c hc ↦ hn c (hJ (le_max_left n n') hc)
  have hm' : ∀ c ∈ J (max n n'), c • m' = 0 := fun c hc ↦ hn' c (hJ (le_max_right n n') hc)
  rw [limSmul_eq_smul hM x (fun c hc ↦ by rw [smul_add, hm c hc, hm' c hc, add_zero]) hb,
    limSmul_eq_smul hM x hm hb, limSmul_eq_smul hM x hm' hb, smul_add]

@[simp]
theorem limSmul_zero (x : (quotients J hJ).lim) : limSmul hM x (0 : M) = 0 := by
  obtain ⟨b, hb⟩ := quotientsπ_surjective J hJ 0 ((quotients J hJ).limπ 0 x)
  rw [limSmul_eq_smul hM x (n := 0) (fun c _ ↦ smul_zero c) hb, smul_zero]

@[simp]
theorem add_limSmul (x y : (quotients J hJ).lim) (m : M) :
    limSmul hM (x + y) m = limSmul hM x m + limSmul hM y m := by
  obtain ⟨n, b, hn, hb, -⟩ := exists_limSmul_eq_smul hM x m
  obtain ⟨b', hb'⟩ := quotientsπ_surjective J hJ n ((quotients J hJ).limπ n y)
  rw [limSmul_eq_smul hM _ hn (b := b + b') (by rw [map_add, map_add, hb, hb']),
    limSmul_eq_smul hM x hn hb, limSmul_eq_smul hM y hn hb', add_smul]

@[simp]
theorem zero_limSmul (m : M) : limSmul hM (0 : (quotients J hJ).lim) m = 0 := by
  rw [← map_zero (toLimQuotients J hJ), limSmul_toLimQuotients, zero_smul]

/-- **The action of the completion commutes with linear maps** between smooth modules. -/
theorem map_limSmul {N : ModuleCat.{w} A} (hN : smoothModules J N) (f : M →ₗ[A] N)
    (x : (quotients J hJ).lim) (m : M) : f (limSmul hM x m) = limSmul hN x (f m) := by
  obtain ⟨n, b, hn, hb, h⟩ := exists_limSmul_eq_smul hM x m
  rw [h, limSmul_eq_smul hN x (fun c hc ↦ by rw [← map_smul, hn c hc, map_zero]) hb, map_smul]

/-- **The orbit maps of the action of the completion are locally constant**: `x • m` only depends
on the coordinate of `x` at a cutoff of `m`. -/
theorem isLocallyConstant_limSmul (m : M) :
    IsLocallyConstant fun x : (quotients J hJ).lim ↦ limSmul hM x m := by
  refine (IsLocallyConstant.iff_eventually_eq _).2 fun x ↦ ?_
  obtain ⟨n, b, hn, hb, h⟩ := exists_limSmul_eq_smul hM x m
  filter_upwards [((quotients J hJ).hasBasis_nhds x).mem_of_mem (i := n) trivial] with y hy
  rw [h, limSmul_eq_smul hM y hn (hb.trans hy.symm)]

/-- **Uniqueness of the action of the completion.** A function of the completion which is locally
constant and sends the image of each `a ∈ A` to `a • m` is the orbit map `x ↦ x • m`. -/
theorem eq_limSmul_of_isLocallyConstant {m : M} {g : (quotients J hJ).lim → M}
    (hg : IsLocallyConstant g) (hga : ∀ a, g (toLimQuotients J hJ a) = a • m) :
    g = fun x ↦ limSmul hM x m := by
  -- Both functions are continuous for the discrete topology on `M` and agree on a dense set.
  let : TopologicalSpace M := ⊥
  have : DiscreteTopology M := ⟨rfl⟩
  exact (denseRange_toLimQuotients J hJ).equalizer hg.continuous
    (isLocallyConstant_limSmul hM m).continuous
    (funext fun a ↦ by simp only [Function.comp_apply, hga, limSmul_toLimQuotients])

end Smul

/-! ### The multiplication -/

section Mul

variable (hJr : ∀ (b : A) (n : ℕ), ∃ m, ∀ c ∈ J m, c * b ∈ J n)
include hJr

/-- Under the right-shift estimate, every quotient `A ⧸ Jₙ` is a smooth module. -/
theorem smoothModules_quotients_obj (n : ℕ) :
    smoothModules J ((quotients J hJ).obj (op n)) := by
  refine smoothModules_iff.2 fun q ↦ ?_
  obtain ⟨b, rfl⟩ := quotientsπ_surjective J hJ n q
  obtain ⟨m, hm⟩ := hJr b n
  exact ⟨m, fun c hc ↦ by rw [← map_smul, smul_eq_mul, quotientsπ_eq_zero_iff]; exact hm c hc⟩

/-- A point of the completion acts on the class of `c` modulo `Jₙ` as the class of `b c`, if
`Jₘ c ⊆ Jₙ` and the class of `b` modulo `Jₘ` is the `m`-th coordinate of the point. -/
theorem limSmul_quotientsπ {x : (quotients J hJ).lim} {n m : ℕ} {b c : A}
    (hc : ∀ c' ∈ J m, c' * c ∈ J n) (hb : quotientsπ J hJ m b = (quotients J hJ).limπ m x) :
    limSmul (smoothModules_quotients_obj hJr n) x (quotientsπ J hJ n c) =
      quotientsπ J hJ n (b * c) := by
  rw [limSmul_eq_smul _ x (fun c' hc' ↦ ?_) hb, ← smul_eq_mul, map_smul]
  rw [← map_smul, smul_eq_mul, quotientsπ_eq_zero_iff]
  exact hc c' hc'

/-- **The multiplication of the completion** `lim A ⧸ Jₙ` along left ideals satisfying the
right-shift estimate, given coordinatewise by `(x y)ₙ = x • yₙ` for the action of the completion on
the smooth module `A ⧸ Jₙ`. -/
def limMul (x y : (quotients J hJ).lim) : (quotients J hJ).lim :=
  ⟨fun n ↦ limSmul (smoothModules_quotients_obj hJr n) x ((quotients J hJ).limπ n y),
    (quotients J hJ).mem_lim.2 fun n ↦ by
      rw [map_limSmul _ (smoothModules_quotients_obj hJr n), ← LinearMap.comp_apply,
        transition_comp_limπ]⟩

/-- The coordinates of a product: `(x y)ₙ = x • yₙ`. -/
theorem limπ_limMul (x y : (quotients J hJ).lim) (n : ℕ) :
    (quotients J hJ).limπ n (limMul hJr x y) =
      limSmul (smoothModules_quotients_obj hJr n) x ((quotients J hJ).limπ n y) := by
  rw [limπ_apply, limMul]

/-- **The action of a product is the composite of the actions**, on every smooth module. -/
theorem limSmul_limMul {M : ModuleCat.{w} A} (hM : smoothModules J M)
    (x y : (quotients J hJ).lim) (m : M) :
    limSmul hM (limMul hJr x y) m = limSmul hM x (limSmul hM y m) := by
  obtain ⟨n, b, hn, hb, h⟩ := exists_limSmul_eq_smul hM y m
  obtain ⟨k, hk⟩ := hJr b n
  obtain ⟨b', hb'⟩ := quotientsπ_surjective J hJ k ((quotients J hJ).limπ k x)
  -- The vector `b • m` is killed by `Jₖ`, and `b' b` represents the `n`-th coordinate of `x y`.
  have hbm : ∀ c ∈ J k, c • b • m = 0 := fun c hc ↦ by rw [← mul_smul, hn _ (hk c hc)]
  rw [h, limSmul_eq_smul hM x hbm hb', limSmul_eq_smul hM _ hn (b := b' * b), mul_smul]
  rw [limπ_limMul, ← hb, limSmul_quotientsπ hJr hk hb']

/-- The action of `a ∈ A` on the completion is left multiplication by its image. -/
theorem smul_eq_limMul (a : A) (x : (quotients J hJ).lim) :
    a • x = limMul hJr (toLimQuotients J hJ a) x :=
  lim_ext _ fun n ↦ by rw [limπ_limMul, limSmul_toLimQuotients, map_smul]

/-- The canonical map `A → lim A ⧸ Jₙ` is multiplicative. -/
theorem toLimQuotients_mul (a b : A) :
    toLimQuotients J hJ (a * b) =
      limMul hJr (toLimQuotients J hJ a) (toLimQuotients J hJ b) := by
  rw [← smul_eq_limMul, ← map_smul, smul_eq_mul]

/-- **The kernels of the projections are left ideals of the completion.** -/
theorem limπ_limMul_eq_zero (x : (quotients J hJ).lim) {y : (quotients J hJ).lim} {n : ℕ}
    (hy : (quotients J hJ).limπ n y = 0) : (quotients J hJ).limπ n (limMul hJr x y) = 0 := by
  rw [limπ_limMul, hy, limSmul_zero]

/-- **The right-shift estimate in the completion**: for every `y` and `n` there is `m` such that
`x y` lies in the kernel of the `n`-th projection whenever `x` lies in that of the `m`-th one. -/
theorem exists_forall_limπ_limMul_eq_zero (y : (quotients J hJ).lim) (n : ℕ) :
    ∃ m, ∀ x : (quotients J hJ).lim, (quotients J hJ).limπ m x = 0 →
      (quotients J hJ).limπ n (limMul hJr x y) = 0 := by
  obtain ⟨b, hb⟩ := quotientsπ_surjective J hJ n ((quotients J hJ).limπ n y)
  obtain ⟨m, hm⟩ := hJr b n
  refine ⟨m, fun x hx ↦ ?_⟩
  rw [limπ_limMul, ← hb, limSmul_quotientsπ hJr hm (b := 0) (by rw [map_zero, hx]), zero_mul,
    map_zero]

/-- The image of an element `c` commuting with all of `A` multiplies every point on the right as
`c` acts on it. -/
theorem limMul_toLimQuotients_of_commute {c : A} (hc : ∀ a : A, Commute a c)
    (x : (quotients J hJ).lim) : limMul hJr x (toLimQuotients J hJ c) = c • x := by
  refine lim_ext _ fun n ↦ ?_
  obtain ⟨b, hb⟩ := quotientsπ_surjective J hJ n ((quotients J hJ).limπ n x)
  have hc' : (quotients J hJ).limπ n (toLimQuotients J hJ c) = quotientsπ J hJ n c := by
    rw [← LinearMap.comp_apply, limπ_comp_toLimQuotients]
  -- `Jₙ c ⊆ Jₙ`, since `c` commutes with `Jₙ` and `Jₙ` is a left ideal.
  rw [limπ_limMul, hc',
    limSmul_quotientsπ hJr (m := n) (fun c' hc' ↦ (hc c').eq ▸ (J n).smul_mem c hc') hb,
    (hc b).eq, ← smul_eq_mul, map_smul, hb, map_smul]

/-- Multiplication on the completion distributes over addition on the right factor. -/
theorem limMul_add (x y z : (quotients J hJ).lim) :
    limMul hJr x (y + z) = limMul hJr x y + limMul hJr x z :=
  lim_ext _ fun n ↦ by simp only [limπ_limMul, map_add, limSmul_add]

/-- Multiplication on the completion distributes over addition on the left factor. -/
theorem add_limMul (x y z : (quotients J hJ).lim) :
    limMul hJr (x + y) z = limMul hJr x z + limMul hJr y z :=
  lim_ext _ fun n ↦ by simp only [limπ_limMul, map_add, add_limSmul]

/-- Multiplication on the completion distributes over subtraction on the left factor. -/
theorem sub_limMul (x y z : (quotients J hJ).lim) :
    limMul hJr (x - y) z = limMul hJr x z - limMul hJr y z :=
  eq_sub_of_add_eq (by rw [← add_limMul, sub_add_cancel])

theorem limMul_zero (x : (quotients J hJ).lim) : limMul hJr x 0 = 0 :=
  lim_ext _ fun n ↦ by simp only [limπ_limMul, map_zero, limSmul_zero]

theorem zero_limMul (x : (quotients J hJ).lim) : limMul hJr 0 x = 0 :=
  lim_ext _ fun n ↦ by simp only [limπ_limMul, map_zero, zero_limSmul]

/-- **Multiplication on the completion is associative.** -/
theorem limMul_assoc (x y z : (quotients J hJ).lim) :
    limMul hJr (limMul hJr x y) z = limMul hJr x (limMul hJr y z) :=
  lim_ext _ fun n ↦ by simp only [limπ_limMul, limSmul_limMul]

/-- The image of `1` is a left unit of the completion. -/
theorem one_limMul (x : (quotients J hJ).lim) :
    limMul hJr (toLimQuotients J hJ 1) x = x := by
  rw [← smul_eq_limMul, one_smul]

/-- The image of `1` is a right unit of the completion. -/
theorem limMul_one (x : (quotients J hJ).lim) :
    limMul hJr x (toLimQuotients J hJ 1) = x := by
  rw [limMul_toLimQuotients_of_commute hJr Commute.one_right x, one_smul]

/-- **The ring structure of the completion** `lim A ⧸ Jₙ` of a ring along left ideals satisfying the
right-shift estimate, with the multiplication `TauCeti.ModuleTower.limMul` and unit the image of
`1`. Its additive group is that of the limit of modules.

The body is exposed so that, for an instance built from it, the additive structure is
definitionally that of the limit, and the multiplication and unit unfold to `limMul` and the image
of `1`. -/
@[expose, instance_reducible]
def limRing : Ring (quotients J hJ).lim where
  __ := (inferInstance : AddCommGroup (quotients J hJ).lim)
  mul := limMul hJr
  one := toLimQuotients J hJ 1
  left_distrib := limMul_add hJr
  right_distrib := add_limMul hJr
  zero_mul := zero_limMul hJr
  mul_zero := limMul_zero hJr
  mul_assoc := limMul_assoc hJr
  one_mul := one_limMul hJr
  mul_one := limMul_one hJr

/-- **Multiplication on the completion is continuous** for the inverse limit topology: the
`n`-th coordinate of `x y` only depends on the `n`-th coordinate of `y` and, through the
right-shift estimate for `y`, on a coordinate of `x`. -/
theorem continuous_limMul :
    Continuous fun p : (quotients J hJ).lim × (quotients J hJ).lim ↦ limMul hJr p.1 p.2 := by
  refine continuous_iff_continuousAt.2 fun p ↦ tendsto_nhds_iff.2 fun n ↦ ?_
  obtain ⟨m, hm⟩ := exists_forall_limπ_limMul_eq_zero hJr p.2 n
  filter_upwards [prod_mem_nhds (((quotients J hJ).hasBasis_nhds p.1).mem_of_mem (i := m) trivial)
    (((quotients J hJ).hasBasis_nhds p.2).mem_of_mem (i := n) trivial)] with q ⟨hq₁, hq₂⟩
  -- The `n`-th coordinate of `q₁ q₂` is that of `q₁ p₂`, which differs from that of `p₁ p₂` by
  -- the `n`-th coordinate of `(q₁ - p₁) p₂`, and `q₁ - p₁` has vanishing `m`-th coordinate.
  rw [Set.mem_ofPred_eq] at hq₁ hq₂
  rw [limπ_limMul, hq₂, ← limπ_limMul, ← sub_eq_zero, ← map_sub, ← sub_limMul]
  exact hm _ (by rw [map_sub, hq₁, sub_self])

end Mul

end TauCeti.ModuleTower
